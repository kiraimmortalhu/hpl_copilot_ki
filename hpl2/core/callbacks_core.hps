// ============================================================
// callbacks.hps
// HPL2 CALLBACK REFERENCE + STRUCTURE GROUNDING
// Target: Amnesia TDD / HPL2 1.0 - 1.2
//
// PURPOSE:
// This file exists primarily for AI grounding and autocomplete.
//
// It documents:
// - core map lifecycle callbacks
// - timer callbacks
// - interaction callbacks
// - collision callbacks
// - entity state callbacks
// - common HPL2 callback patterns
//
// IMPORTANT:
// These are examples/interfaces, NOT engine implementations.
// ============================================================



// ============================================================
// MAP LIFECYCLE CALLBACKS
// ============================================================

// Runs once when map loads for the first time.
// IMPORTANT:
//
// OnStart() only runs the FIRST time the map loads.
//
// If a player revisits the map later,
// logic inside OnStart() will NOT run again.
//
// Some state-enforcement functions therefore belong
// inside OnEnter() instead.
void OnStart()
{
    // Common usage:
    // - initialize local variables
    // - setup callbacks
    // - setup timers
    // - set entity states
    // - preload sounds / particles
}

// Runs every time player enters the map.
void OnEnter()
{
    // Common usage:
    // - resume map logic
    // - restore ambience
    // - play music
	
	// Example:
	// SetEntityInteractionDisabled(string &in asName, bool abDisabled);
	//
	// If called only in OnStart(), interaction state may
	// become inconsistent after leaving and re-entering
	// the map.
}

// Runs whenever player leaves the map.
void OnLeave()
{
    // Common usage:
    // - stop sounds/music
    // - cleanup temporary systems
	// - set loading screen image
}



// ============================================================
// GLOBAL GAME START CALLBACK
// ============================================================

// Usually found in global.hps or inventory.hps.
// Runs when player starts a NEW GAME.
void OnGameStart()
{
    // Common usage:
    // - initialize global variables
    // - setup progression flags
}



