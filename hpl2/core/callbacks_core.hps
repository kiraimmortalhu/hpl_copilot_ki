// ============================================================
// CONNECTION CALLBACKS
// ============================================================

// Connects two entities together so that changing the state
// of the main entity changes the state of the connected entity.
void ConnectEntities(
    string &in asName,
    string &in asMainEntity,
    string &in asConnectEntity,
    bool abInvertStateSent,
    int alStatesUsed,
    string &in asCallbackFunc);

// asName - the name of the connection
// asMainEntity - the entity that causes the change
// asConnectEntity - the entity that is affected by the change
// abInvertStateSent - invert state sent to connected entity
// alStatesUsed - the state to use
// asCallbackFunc - the name of the connection callback


// Callback syntax
void ConnectionXwithYCallback(
    string &in asConnectionName,
    string &in asMainEntity,
    string &in asConnectEntity,
    int alState)
{
    // Common usage:
    // - machinery systems
    // - bridge controls
    // - puzzle chains
}

// alState:
// -1 = off/min
// 1 = on/max

