// ============================================================
// COLLISION CALLBACKS
// ============================================================

// Calls a function when two entities collide.
void AddEntityCollideCallback(
    string &in asParentName,
    string &in asChildName,
    string &in asFunction,
    bool abDeleteOnCollide,
    int alStates);
	
// asParentName - internal name of main object
// asChildName - internal name of object that collides with main object
// asFunction - function to call
// abDeleteOnCollide - determines whether the callback is removed after being called
// alStates - 1 = only enter, -1 = only leave, 0 = both

// Callback syntax
void CollideXwithYCallback(
    string &in asParent,
    string &in asChild,
    int alState)
{
    // Common usage:
    // - area triggers
    // - chase triggers
    // - scripted sequences
}

// alState:
// 1 = enter
// -1 = leave


// Removes an EntityCollideCallback.
void RemoveEntityCollideCallback(
    string &in asParentName,
    string &in asChildName);


// Checks whether two entities collide. This function does NOT support asterix (*) or "Player"!
bool GetEntitiesCollide(string &in asEntityA, string &in asEntityB);

