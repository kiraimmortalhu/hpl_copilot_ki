// ============================================================
// ENTITY EVENT CALLBACKS
// ============================================================


// Calls a function when certain events occur with an entity.
void SetEntityCallbackFunc(string &in asName, string &in asCallback);

// asName - internal name
// asCallback - function to call


// Callback syntax
void EntityXCallback(string &in asEntity, string &in asType)
{
    // Example:
    if(asType == "OnPickup")
    {
        // Trigger progression.
    }
}

// asType values depend on entity type.

	// Object:
    // "Break"

    // Lamp:
    // "OnIgnite"

    // Item:
    // "OnPickup"

    // Enemy:
    // "OnDeath"

    // Enemy_Grunt / Enemy_Manpig:
    // "OnAutoDisabled"

