// ============================================================
// CHECKPOINT CALLBACKS
// ============================================================

// Sets a checkpoint at which the player will respawn in case he dies.
// IMPORTANT - not the same as AutoSave() - which actually creates a save file!
void CheckPoint(
    string &in asName,
    string &in asStartPos,
    string &in asCallback,
    string &in asDeathHintCat,
    string &in asDeathHintEntry);

// asName - the internal name
// asStartPos - the name of the StartPos in the editor
// asCallback - the function to call when the player dies/respawns
// asDeathHintCat - the category of the death hint message to be used in the .lang file
// asDeathHintEntry - the entry in the .lang file


// Callback syntax
void CheckpointXCallback(
    string &in asName,
    int alCount)
{
    // Common usage:
    // - restore progression and enemy encounters
    // - alter encounters
    // - reset scripted events
}

// alCount:
// 0 = first checkpoint load
// 1+ = subsequent checkpoint loads

