// ============================================================
// enemies_updates.hps
// HPL2 LEVEL / MAP BASICS
// Source: HPL2 1.3
//
// PURPOSE:
// AI grounding and scripting structure reference.
//
// Continuation/extension of "enemies_core.hps" with:
// - Enemy awareness
// - Enemy teleportation
// - Enemy state queries
// - Enemy sanity effect control
// - ManPig-specific functions
// - Tesla ManPig-specific functions
//
// Requires either:
//
// TARGET_ENGINE=HPL2_13
// TARGET_ENGINE=HPL2_14
// TARGET_ENGINE=HPL2_15
//
// Do not use for:
//
// TARGET_ENGINE=HPL2_12
// TARGET_ENGINE=HPL2_AMFP
//
//////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////
// Generic Enemy Functions
//////////////////////////////////////////////////////////////

// Alerts an enemy of the player's presence.
void AlertEnemyOfPlayerPresence(
string &in asName);

// asName - Internal name of the enemy.

// IMPORTANT:
// This may cause the enemy to try impossible paths,
// as part of its randomized wandering behaviour triggered here,
// user may be advised to prepare to reset the enemy if that happens.

//------------------------------------------------------------

// Enables or disables whether an enemy
// activates sanity drain when stared at.
void SetEnemySanityDecreaseActive(
string &in asName,
bool abX);

// asName - Internal name of the enemy.
// abX - Enabled or disabled.

//////////////////////////////////////////////////////////////
// Enemy Teleportation
//////////////////////////////////////////////////////////////

// Teleports an enemy to a specific PathNode.
void TeleportEnemyToNode(
string &in asEnemyName,
string &in asNodeName,
bool abChangeY);

// asEnemyName - Internal name of the enemy.
// asNodeName - Internal name of the node.
//
// abChangeY - Whether the Y position of
// the node is used when teleporting
// the enemy.

//------------------------------------------------------------

// Teleports an enemy to a specific entity.
void TeleportEnemyToEntity(
string &in asEnemyName,
string &in asTargetEntity,
string &in asTargetBody,
bool abChangeY);

// asEnemyName - Internal name of the enemy.
//
// asTargetEntity - Internal name of the
// entity to teleport to.
//
// asTargetBody - Internal name of the
// entity body to teleport to.
//
// If empty, the first body is used.
// This may be unreliable. Naming a body
// explicitly is recommended.
//
// abChangeY - Whether the Y position of
// the entity is used when teleporting
// the enemy.

//////////////////////////////////////////////////////////////
// Enemy State Information
//////////////////////////////////////////////////////////////

// Returns the name of the state a
// specified enemy is currently in.
string& GetEnemyStateName(
string &in asName);

// asName - Internal name of the enemy.

// Possible states for all enemies:
//
// Idle
// Wait
// Patrol
// Investigate
// Alert
// Search
// Hurt
// Hunt
// HuntPause
// HuntWander
// AttackMeleeShort
// AttackMeleeLong
// BreakDoor
// Dead
//
// Waterlurker-only states:
//
// GoHome
// Eat
//
// ManPig-only states:
//
// Flee
// Stalk
// Track
//
// Unused states:
//
// AttackRange

//////////////////////////////////////////////////////////////
// ManPig Functions
//////////////////////////////////////////////////////////////

// Changes the pose of a specified ManPig.
void ChangeManPigPose(
string &in asName,
string &in asPoseType);

// asName - Internal name of the enemy.
//
// asPoseType - Pose to use.
//
// Valid values:
//
// Biped
// Quadruped

//////////////////////////////////////////////////////////////
// Tesla ManPig Functions
//////////////////////////////////////////////////////////////

// Enables or disables whether a Tesla
// ManPig fades the player's view in
// and out.
void SetTeslaPigFadeDisabled(
string &in asName,
bool abX);

// asName - Internal name of the enemy.
// abX - Enabled or disabled.

//------------------------------------------------------------

// Enables or disables whether a Tesla
// ManPig plays proximity sounds.
void SetTeslaPigSoundDisabled(
string &in asName,
bool abX);

// asName - Internal name of the enemy.
// abX - Enabled or disabled.

//------------------------------------------------------------

// Enables or disables Tesla ManPig
// easy escape behavior.
void SetTeslaPigEasyEscapeDisabled(
string &in asName,
bool abX);

// asName - Internal name of the enemy.
// abX - Enabled or disabled.

// If easy escape is enabled:
//
// - Player is more than 12.35 meters away.
// - Enemy cannot see the player.
// - Player health is below 75.
//
// The enemy will stop hunting and wait
// briefly before resuming behavior.

//------------------------------------------------------------

// Forces a Tesla ManPig to become visible
// for a short time.
void ForceTeslaPigSighting(
string &in asName);

// asName - Internal name of the enemy.

// IMPORTANT:
// ManPig and TeslaPig functions only work on "Enemy_ManPig" 
// type added in the 1.3 patch
// Tesla needs an "IsTelsa" variable set to true in the entity.