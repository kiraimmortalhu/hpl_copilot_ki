void LurkerSplashHigh(string &in asArea, float afTime)
{
	AddTimer(asArea, afTime, "TimerLurkerSplashHigh");
}

void TimerLurkerSplashHigh(string &in asArea)
{
	CreateParticleSystemAtEntity("Splash", "waterlurker_sewer_walk_splash.ps", asArea, false);
	PlaySoundAtEntity("Splash", "watermonster_movement_high", asArea, 0, false);
	PlaySoundAtEntity("Splashelec", "cellar_light_flicker_louder.snt", asArea, 0, false);
	//*InsertSoundHere*: Low, subtle lurker glow.
}

//-------------------------------------------

void LurkerSplashLow(string &in asArea, float afTime)
{
	AddTimer(asArea, afTime, "TimerLurkerSplashLow");
}

void TimerLurkerSplashLow(string &in asArea)
{
	CreateParticleSystemAtEntity("Splash", "waterlurker_sewer_walk_splash.ps", asArea, false);
	PlaySoundAtEntity("Splash", "watermonster_movement", asArea, 0, false);
	PlaySoundAtEntity("Splashelec", "cellar_light_flicker_louder.snt", asArea, 0, false);
}

