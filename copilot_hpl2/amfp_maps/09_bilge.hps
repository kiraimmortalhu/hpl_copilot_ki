	}
	
	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);	
	}
	
	//PRELOAD PARTICLES//
	{
		PreloadParticleSystem("ps_dust_impact_gate.ps");
		PreloadParticleSystem("waterlurker_sewer_walk_splash.ps");
	}
	
	//PARTICLE SYSTEM STATES//
	{
		if (GetLocalVarInt("DynamoStarted") == 1)
		{
			SetParticleSystemActive("DynamoWheelSteam_*", true);
		}
		if (GetLocalVarInt("PumpDynamoStarted") == 1)
		{
			SetParticleSystemActive("PumpDynamoSteam_*", true);
		}
	}
	
