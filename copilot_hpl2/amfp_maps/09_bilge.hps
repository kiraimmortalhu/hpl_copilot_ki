	{
		AddDebugMessage("Dynamo Loop Triggered", false);
		AddTimer("DynamoIdleStandardLoop", 11.12f, "DynamoIdleLoops");
		PlaySoundAtEntity("DynamoEngineLoop", "dynamo_engine_idle_loop_3D.snt", "DynamoEngineSource", 0.0f, true);
		PlaySoundAtEntity("DynamoLoop", "dynamo_idle_loop_3D.snt", "Dynamo", 0.0f, true);
		PlaySoundAtEntity("Dynamo2D", "dynamo_idle_2D.snt", "DynamoEngineSource", 0.0f, true);
		PlayPropAnimation("Dynamo", "loop", 0.0f, true, "");
		return;
	}
	else if (asTimer == "DynamoIdleStandardLoop")
	{
		AddDebugMessage("Dynamo Loop Triggered", false);
		PlaySoundAtEntity("Dynamo2D", "dynamo_idle_2D.snt", "DynamoEngineSource", 3.0f, true);
		return;
	}
}

