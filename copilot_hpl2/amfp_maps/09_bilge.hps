// Dynamo Luker Handler//
void EntDynamoLurker(string &in asParent, string &in asChild, int alState)
{
	if (asChild == "dynamo_lurker_trigger")
		{	
		SetMoveObjectState("gate4",0.0f);
		PlaySoundAtEntity("Drag", "afx_bilge_gate_steel_close", "gate4", 0.0f, false);
		PlaySoundAtEntity("Drag", "afx_bilge_gate_steel_close_2D", "gate4", 0.0f, false);
		PlayPropAnimation("Dynamo_11", "static", 0.0f, true, "");	
		PlayPropAnimation("Dynamo_12", "static", 0.0f, true, "");		
		PlayPropAnimation("Dynamo_13", "static", 0.0f, true, "");		
		PlayPropAnimation("Dynamo_14", "static", 0.0f, true, "");		
		PlayPropAnimation("Dynamo_15", "static", 0.0f, true, "");		
		PlayPropAnimation("Dynamo_16", "static", 0.0f, true, "");
		AddTimer("DynamoKillTimer", 3.0f, "KillDynamos");
		}

}

void ActivateDynamoLurker()
{
	AddDebugMessage("Dynamo Luker Event Fired", false);
	SetEntityActive("waterlurker_2", true);	
	StartLampFlickerBurst("sewer_wall_lamp_40", 4);
	StartLampFlickerBurst("sewer_wall_lamp_30", 4);
	StartLampFlickerBurst("sewer_wall_lamp_39", 4);
	StartLampFlickerBurst("sewer_wall_lamp_41", 4);
}

void KillDynamos (string &in asTimer)
{
	if (asTimer == "DynamoKillTimer")
	{
	StopSound("DynamoOn", 1.0f);
	StopSound("DynamoRoomStartup", 1.0f);
		return;
	}
}
//End Dynamo Luker Handler//

//Dynamo Switch Handler//
//Switch One//
void DynamoSwitchHandler(string &in asEntity, int alState)
{
	if (alState != 1) return;
	
	if (asEntity == "DynamoSwitch1")
		{
			AddDebugMessage("Switch 1 Activated", false);
			PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "DynamoSwitch1", 0.0f, false);
			PlaySoundAtEntity("BulkheadDown2D", "afx_bilge_gate_steel_close", "dynamo_gate_2", 0.0f, false);
			SetLampLit("dynamo_light_1", true, false);
			SetLeverInteractionDisablesStuck("DynamoSwitch1", false);
			SetMoveObjectState("dynamo_gate_2",0.0f);
			SetLeverStuckState("DynamoSwitch1", 1, false);
			AddLocalVarInt("DynamoSwitches", 1);
			DynamoSolved();
		}
//Switch Two//
	else if (asEntity == "DynamoSwitch2")
		{
			AddDebugMessage("Switch 2 Activated", false);
			PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "DynamoSwitch2", 0.0f, false);
			PlaySoundAtEntity("BulkheadDown2D", "afx_bilge_gate_steel_close", "dynamo_gate_1", 0.0f, false);
			SetLampLit("dynamo_light_2", true, false);
			SetMoveObjectState("dynamo_gate_1",0.0f);
			SetLeverInteractionDisablesStuck("DynamoSwitch2", false);
			SetLeverStuckState("DynamoSwitch2", 1, false);
			AddLocalVarInt("DynamoSwitches", 1);
			DynamoSolved();
		}
//Switch Three//
	else if (asEntity == "DynamoSwitch3")
		{
			AddDebugMessage("Switch 3 Activated", false);
			PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "DynamoSwitch3", 0.0f, false);
			PlaySoundAtEntity("BulkheadDown2D", "afx_bilge_gate_steel_close", "dynamo_gate_3", 0.0f, false);
			SetLampLit("dynamo_light_3", true, false);
			SetLeverInteractionDisablesStuck("DynamoSwitch3", false);
			SetMoveObjectState("dynamo_gate_3",0.0f);
			SetLeverStuckState("DynamoSwitch3", 1, false);
			AddLocalVarInt("DynamoSwitches", 1);
			DynamoSolved();
		}
//Switch Four//
	else if (asEntity == "DynamoSwitch4")
		{
			AddDebugMessage("Switch 4 Activated", false);
			PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "DynamoSwitch4", 0.0f, false);
			PlaySoundAtEntity("BulkheadDown2D", "afx_bilge_gate_steel_close", "dynamo_gate_4", 0.0f, false);
			SetLampLit("dynamo_light_4", true, false);
			SetLeverInteractionDisablesStuck("DynamoSwitch4", false);
			SetMoveObjectState("dynamo_gate_4",0.0f);
			SetLeverStuckState("DynamoSwitch4", 1, false);
			AddLocalVarInt("DynamoSwitches", 1);
			DynamoSolved();
		}
//Switch Five//
	else if (asEntity == "DynamoSwitch5")
		{
			AddDebugMessage("Switch 5 Activated", false);
			PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "DynamoSwitch5", 0.0f, false);
			PlaySoundAtEntity("BulkheadDown2D", "afx_bilge_gate_steel_close", "dynamo_gate_5", 0.0f, false);
			SetLampLit("dynamo_light_5", true, false);
			SetLeverInteractionDisablesStuck("DynamoSwitch5", false);
			SetMoveObjectState("dynamo_gate_5",0.0f);
			SetLeverStuckState("DynamoSwitch5", 1, false);
			AddLocalVarInt("DynamoSwitches", 1);
			DynamoSolved();
		}
		
	if (GetLocalVarInt("DynamoSwitches") == 2)
	{
		ActivateDynamoLurker();
	}
}
//On all switches triggered, make door switch come online//
	
void DynamoSolved()
{	
	if(GetLocalVarInt("DynamoSwitches") == 5)
		{
		AddDebugMessage("All Switches Activated", false);
		SetMoveObjectState("fuse_box_glass_1",-1.0f);
		SetLampLit("dynamo_light_6", true, false);
		SetLampLit("dynamo_light_7", true, false);
		SetLampLit("dynamo_light_8", true, false);
		SetLampLit("dynamo_light_9", true, false);
		SetLampLit("dynamo_light_10", true, false);
		SetLampLit("dynamo_light_11", true, false);
		SetLampLit("dynamo_light_12", true, false);
		SetLampLit("dynamo_light_13", true, false);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		PlayMusic("music_bilge_dynamo.ogg", false, 0.45f, 0.0f, 6, false);
		}

}
//End Dynamo Switch Handler//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("React_Scared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("React_Breath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("React_Quick", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

void InteractExitDoor(string &in asEntity)
{
	StopMusic(1, 6);
	PlayMusic("music_transition_09bilge_10reactor.ogg", false, 1.0f, 1.0f, 0, false);
	FadeOut(1);
	AddTimer("", 1.0, "TimerSwitchLevel");
}

void TimerSwitchLevel(string &in asTimer)
{
	ChangeMap("10_reactor.map", "MainStart", "afx_events_leveltransition_tesladoor_enter.snt", "afx_events_leveltransition_tesladoor_exit.snt");
}
