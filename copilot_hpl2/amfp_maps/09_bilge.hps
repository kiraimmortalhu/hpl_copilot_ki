// DYNAMO WRETCH SCARE
void DynamoWretchScare (string &in asParent, string &in asChild, int alState)
{
	return;
	if (asChild == "dynamo_wretch_spawn")
	{
		SetEntityActive("dynamo_child_1", true);
		AddEnemyPatrolNode("dynamo_child_1", "PathNodeArea_11", 0.0f, "", false);
		SetEntityActive("dynamo_child_2", true);
		AddEnemyPatrolNode("dynamo_child_2", "PathNodeArea_11", 0.0f, "", false);
		return;
	}
	else if (asChild == "dynamo_wretch_killer")
	{
		ClearEnemyPatrolNodes("dynamo_child_1");
		SetEntityActive("dynamo_child_1", false);
		ClearEnemyPatrolNodes("dynamo_child_2");
		SetEntityActive("dynamo_child_2", false);
		return;
	}
}

//LEVEL CHILD EVENT HANDLER//
void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Child1RunTrigger")
	{
		SetEntityActive("Child1", true);
		AddEnemyPatrolNode("Child1", "PathNodeArea_21", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_22", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_23", 0.0f, "", false);
		return;
	}
	
	else if (asChild == "Child1KillTrigger")
	{
		ClearEnemyPatrolNodes("Child1");
		SetEntityActive("Child1", false);
		return;
	}	
	
	else if (asChild == "child2spawntrigger")
	{
		SetEntityActive("child_2", true);
		
		LanternFlicker(5);
		
		AddEnemyPatrolNode("child_2", "PathNodeArea_2", 0.0f, "", false);
		AddEnemyPatrolNode("child_2", "PathNodeArea_3", 0.0f, "", false);
		return;
	}
	
	else if (asChild == "child2killtrigger")
	{
		ClearEnemyPatrolNodes("child_2");
		SetEntityActive("child_2", false);
		return;
	}	
	
	else if (asChild == "child3spawntrigger")
	{
		SetEntityActive("child_3", true);
		AddEnemyPatrolNode("child_3", "PathNodeArea_1", 0.0f, "IdleBiped01", false);
		return;
	}
	
	else if (asChild == "child3killtrigger")
	{
		FadeEnemyToSmoke("child_3", true);
		//SetLanternFlickerActive(false);
		AddTimer("Child3SpookTimer1", 0.2f, "Child3SpookSound");
		AddTimer("Child3SpookTimer2", 0.9f, "Child3SpookSound");
		return;
	}	
	
	else if (asChild == "child4spawntrigger")
	{
		SetEntityActive("child_4", true);
		AddEnemyPatrolNode("child_4", "PathNodeArea_4", 0.0f, "", false);
		AddEnemyPatrolNode("child_4", "PathNodeArea_5", 0.0f, "", false);
		AddEnemyPatrolNode("child_4", "PathNodeArea_6", 0.0f, "", false);
		AddEnemyPatrolNode("child_4", "PathNodeArea_7", 0.0f, "", false);
		AddEnemyPatrolNode("child_4", "PathNodeArea_8", 0.0f, "", false);
		AddEnemyPatrolNode("child_4", "PathNodeArea_9", 0.0f, "", false);
		return;
	}
	
	else if (asChild == "child4killtrigger")
	{
		ClearEnemyPatrolNodes("child_4");
		SetEntityActive("child_4", false);
		return;
	}	
	
}

void Child3SpookSound (string &in asTimer)
{
	if (asTimer == "Child3SpookTimer1")
	{
		PlaySoundAtEntity("", "afx_spooky_hightone_whoosh.snt", "Child3SpookySource", 0.0f, false);
