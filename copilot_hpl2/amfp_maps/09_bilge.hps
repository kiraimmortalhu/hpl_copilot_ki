void TempTest (string &in asTimer)
{
	SetPropStaticPhysics("WaterPlaneHigh", false);
	AddTimer("RestoreWaterPhysics", 5.0f, "RestorePhysics");
}
void OnStart()
 
{
	StopMusic(8, 0);
	
	//Map Preamble
	{
		SetMapDisplayNameEntry("Bilge");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Debugging
		if(ScriptDebugOn()) 
		{
			GiveItemFromFile("lantern", "lantern.ent");
			//SetEntityActive("WaterPlaneHigh", false);
		}
		
	// Setup Local Variables
		{
			//SINGLE-MAP VARIABLES//
			SetLocalVarInt("PumpDynamoStarted", 0);
			SetLocalVarInt("CogsPlaced", 0);
			SetLocalVarString("SmallCogToDespawn", "Void");
			SetLocalVarString("LargeCogToDespawn", "Void");
			SetLocalVarInt("DynamoStarted", 0);
			SetLocalVarInt("SpraylockReady", 0);
			SetLocalVarInt("LadderHits", 0);
			SetLocalVarInt("WretchRemovedPermanently", 0);
			SetLocalVarInt("LargeCogFound", 0);
			SetLocalVarInt("DynamoSwitches", 0);
		}
		
	//AutoRun Event Timers
		{	
			
		}
		
	//Setup Initial Entity Callbacks
		{
			//COLLISION CALLBACKS//
			AddEntityCollideCallback("Player", "EntryStingerTrigger", "EntryStingerTrigger", true, 1);
			AddEntityCollideCallback("Player", "Child1RunTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Child1", "Child1KillTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "child2spawntrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("child_2", "child2killtrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "child3spawntrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "child4spawntrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "child3killtrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("child_4", "child4killtrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "OfficeHidingArea", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "HidingArea_2", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "WaterNoCrouchArea", "NoCrouchAreaHandler", false, 0);
			AddEntityCollideCallback("Player", "DistantChildOffTrigger", "DistantChildHandler", false, 1);
			AddEntityCollideCallback("Player", "DistantChildOnTrigger", "DistantChildHandler", false, 1);
			AddEntityCollideCallback("Player", "OfficeLightTrigger", "OfficeLightHandler", true, 1);
			AddEntityCollideCallback("Player", "Wretch2Trigger", "Wretch2Handler", true, 1);
			AddEntityCollideCallback("stone_small01_*", "LadderCollisionArea", "HittingLadder", false, 1);
			AddEntityCollideCallback("Player", "AreaSteamBlock_2", "CollideSteamBlock", false, 0);
			
			AddEntityCollideCallback("Player", "AreaLurkerStart", "EnterLurkerStart", false, 0);
			AddEntityCollideCallback("Player", "AreaLurkerStop", "LeaveLurker", false, 1);
			AddEntityCollideCallback("Player", "AreaFakeLurk_1", "EnterFakeLurk1", true, 1);
			AddEntityCollideCallback("Player", "AreaFakeLurk_2", "EnterFakeLurk2", true, 1);
			AddEntityCollideCallback("Player", "AreaFakeLurk_3", "EnterFakeLurk3", true, 1);
			AddEntityCollideCallback("Player", "AreaFakeLurk_4", "EnterFakeLurk4", true, 1);
			
			AddEntityCollideCallback("Player", "dynamo_lurker_trigger", "EntDynamoLurker", true, 1);
			
			AddEntityCollideCallback("Player", "AreaCheckPlayerInPit", "CollideCheckPlayerInPit", true, 1);
			AddEntityCollideCallback("Player", "TrapFallArea", "BeginTrapFall", false, 1);
			AddEntityCollideCallback("Player", "TrapStopFallArea", "StopTrapFall", false, 1);
			AddEntityCollideCallback("Player", "TrapSlideArea", "CollisionTrapSlide", false, 0);
			
			//STATE CHANGE CALLBACKS//
			SetEntityConnectionStateChangeCallback("BilgeMachinePowerWheel", "BilgeMachine1PowerUp");
			SetEntityConnectionStateChangeCallback("BilgeMachine1Valve", "BilgeMachine1ActivationSequence");
			SetEntityConnectionStateChangeCallback("BilgeMachine2Valve", "BilgeMachine2ActivationSequence");
			SetEntityConnectionStateChangeCallback("OfficePowerSwitch", "SpraylockPowerUpSequence");
			SetEntityConnectionStateChangeCallback("DynamoWheel", "DynamoHandler");

			
			//INTERACTION CALLBACKS//
			SetEntityPlayerInteractCallback("LadderChildArea", "LadderChildEvent", true);
			SetEntityPlayerInteractCallback("LargeCog_*", "LargeCogFound", true);
			
			

			//Spraylock Callbacks
			SetEntityConnectionStateChangeCallback("spraylock_valve_outside_1", "SpraylockDoorHandler");
			SetEntityConnectionStateChangeCallback("spraylock_valve_inside_1", "SpraylockDoorHandler");
			SetEntityConnectionStateChangeCallback("spraylock_valve_outside_2", "SpraylockDoorHandler");
			SetEntityConnectionStateChangeCallback("spraylock_valve_inside_2", "SpraylockDoorHandler");
			SetEntityConnectionStateChangeCallback("spraylock_power_switch", "SpraylockSequence");
			SetEntityConnectionStateChangeCallback("spraylock_spray_switch", "SpraylockSequence");
			AddEntityCollideCallback("Player", "spraylock_power_interaction_area", "CheckPowerSwitchProximity", false, 0);		
		
	
	//Dynamo Area Set-Up
		
			SetMoveObjectState("gate3", 0.0f);
			SetEntityConnectionStateChangeCallback("FuseBoxLever", "FuseBoxLeverHandler");
			SetEntityConnectionStateChangeCallback("FuseBoxLever_1", "FuseBoxLever_1Handler");
			SetEntityConnectionStateChangeCallback("FuseBoxLever_2", "FuseBoxLever_2Handler");
			SetEntityConnectionStateChangeCallback("DynamoSwitch1", "DynamoSwitchHandler");
			SetEntityConnectionStateChangeCallback("DynamoSwitch2", "DynamoSwitchHandler");
			SetEntityConnectionStateChangeCallback("DynamoSwitch3", "DynamoSwitchHandler");
			SetEntityConnectionStateChangeCallback("DynamoSwitch4", "DynamoSwitchHandler");
			SetEntityConnectionStateChangeCallback("DynamoSwitch5", "DynamoSwitchHandler");
			SetEntityActive("waterlurker_2", false);
			SetEntityActive("waterlurker_3", false);
			PlayPropAnimation("Dynamo_11", "static", 0.0f, true, "");	
			PlayPropAnimation("Dynamo_12", "static", 0.0f, true, "");		
			PlayPropAnimation("Dynamo_13", "static", 0.0f, true, "");		
			PlayPropAnimation("Dynamo_14", "static", 0.0f, true, "");		
			PlayPropAnimation("Dynamo_15", "static", 0.0f, true, "");		
			PlayPropAnimation("Dynamo_16", "static", 0.0f, true, "");
			AddEntityCollideCallback("Player", "Activate_Dynamo_On_Trigger", "ActivateDynamoOnHandler", false, 0);	
			SetMoveObjectState("dynamo_gate_5", 1.0f);
			SetMoveObjectState("dynamo_gate_4", 1.0f);
			SetMoveObjectState("dynamo_gate_3", 1.0f);
			SetMoveObjectState("dynamo_gate_2", 1.0f);
			SetMoveObjectState("dynamo_gate_1", 1.0f);
			SetMoveObjectState("DynamoGate", 0.65f);
			
		}
		
		//Entity Collide CAllbacks
		{
		AddEntityCollideCallback("Player", "door_trigger", "DoorSlamsShut_1", true, 0);
		AddEntityCollideCallback("Player", "door_trigger_2", "DoorSlamsShut_2", true, 0);
		AddEntityCollideCallback("Player", "dynamo_wretch_spawn", "DynamoWretchScare", true, 0);
		AddEntityCollideCallback("Player", "dynamo_wretch_spawn_1", "DynamoWretchScare", true, 0);
		AddEntityCollideCallback("dynamo_child_1", "dynamo_wretch_killer", "DynamoWretchScare", true, 1);
		AddEntityCollideCallback("dynamo_child_2", "dynamo_wretch_killer", "DynamoWretchScare", true, 1);
		AddEntityCollideCallback("dynamo_child_1", "*", "TESTER", false, 0);
		
		AddEntityCollideCallback("Player", "AreaCloseDynamoSection", "ColliderCloseDynamoSection", true, 1);
		
		AddEntityCollideCallback("Player", "AreaBreakBridge", "CollideBreakBridge", true, 1);
		
		AddEntityCollideCallback("Player", "AreaDisableEnemy", "CollideDisablePig", true, 1);
		}
		
	//End Dynamo Area Set Up
	
	//Setup Initial Object States
		{				
			//WATER PLANE STATES//
			SetPropStaticPhysics("WaterPlane1", true);
			
			//INTERACTION//
			SetEntityInteractionDisabled("level_cistern_1", true);
			SetWheelInteractionDisablesStuck("spraylock_valve_outside_1", false);
			
			SetEntityInteractionDisabled("bilge_catwalk_break_1", true);
			SetEntityInteractionDisabled("bilge_catwalk_break_2", true);
			SetSwingDoorLocked("bilge_catwalk_break_1", true, false);
			SetSwingDoorLocked("bilge_catwalk_break_2", true, false);
			
			SetEntityInteractionDisabled("sliding_ladder_1", true);
			
			SetEntityInteractionDisabled("bilge_catwalk_railing_break_1", true);
			SetEntityInteractionDisabled("bilge_catwalk_railing_break_2", true);
			SetSwingDoorLocked("bilge_catwalk_railing_break_1", true, false);
			SetSwingDoorLocked("bilge_catwalk_railing_break_2", true, false);
			
		}
		
	//Setup Ambience Callbacks
		{
			//AddEntityCollideCallback("Player", "AMBAreaTemp", "MapAmbienceAreas", false, 0);
			//AddEntityCollideCallback("Player", "AMBAreaEngine", "MapAmbienceAreas", false, 0);
			
			AddEntityCollideCallback("Player", "AMB_Drip_Area", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_AreaStartArea_1", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_AreaStartArea_Tight", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_AreaHall1", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_Hall2", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_BridgeSpace", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_TightSpaceDynamo", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_PreOfficeWetSpace", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_DeathPit", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_TightSpace", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_TightSpace_1", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_MachineRoom", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_EndRoom", "MapAmbienceAreas", false, 0);
		}
	//Setup Single Shot Scare Trigger Callback

		{
			AddEntityCollideCallback("Player", "PostFlushStingerTrigger", "FlushTriggerHandler", false, 0);
			
		}
		
	//Setup Music Callbacks
		{
			AddEntityCollideCallback("Player", "Bilge_Ambience_01_Trigger", "MusicPlayer", true, 0);
			AddEntityCollideCallback("Player", "flashmusic", "MusicPlayer", true, 0);
			AddEntityCollideCallback("Player", "Bilge_Ambience_02_Trigger", "MusicPlayer", true, 0);
		}
		
	//Setup Initial VO Callbacks
		{
			AddEntityCollideCallback("Player", "VOFlashback_1", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "childVO_1", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "childVO_2", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "childVO_3", "VOPlayer", true, 0);
		}
	//Setup Phonoautograph Callbacks
		{
			SetEntityConnectionStateChangeCallback("Phonautograph1", "PhonautographHandler"); 			//Arguments Required: ("Name of the Phonoautograph entity", "Name of the function to call on interaction" < this will always be the same)
		}
		

					

} 

