//----------------------------
//WATER LURKER//
//----------------------------

//-------------------------------------------

void EnterLurkerStart(string &in asParent, string &in asChild, int alState)
{
	if (GetEntityActive("waterlurker_1")) return;
	
	SetEntityActive("waterlurker_amb_3", false);
	SetEntityActive("waterlurker_1", true);
	
	CheckPoint("LurkerCheckPoint", "CheckpointStart_2", "CheckpointLurker", "", "", false);
	
	StartLampFlickerBurst("hanging_lantern_wall_9", 4);
}

//-------------------------------------------

void CheckpointLurker(string &in asName, int alCount)
{
	LeaveLurker("", "", 1);
	//AddEntityCollideCallback("Player", "AreaLurkerStart", "EnterLurkerStart", true, 1);
}

//-------------------------------------------

void LeaveLurker (string &in asParent, string &in asChild, int alState)
{
	TeleportEnemyToNode("waterlurker_1", "PathNodeArea_82", false);
	SetEntityActive("waterlurker_1", false);
	SetEntityActive("waterlurker_amb_3", true);
}

