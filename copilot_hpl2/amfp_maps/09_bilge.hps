//SOUND OPTIMISATION//
void SoundOptimiser (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "StartOfficeSounds_1")
	{	
	
	//Office SOUNDS
	//AddTimer("InitBilgeGateAreaSoundCues", 8.0f, "BilgeGateAreaSoundCues");
	AddTimer("InitBilgeGateMonsterAreaSoundCues", 2.0f, "BilgeGateMonsterAreaSoundCues");
	AddTimer("InitOfficeAreaSoundCues", 9.0f, "OfficeAreaSoundCues");
	AddTimer("InitBodyCorridorSoundCues", 8.0f, "BodyCorridorSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "StartOfficeSounds_1");
	AddEntityCollideCallback("Player", "StopOfficeSounds_1", "SoundOptimiser", true, 1);
	
	AddDebugMessage("Office Sounds START!", true);
	return;
	}
	
	else if (asChild == "StopOfficeSounds_1")
	{
	//REMOVE Office SOUNDS
	RemoveTimer("Sound_RandOfficeArea_1");
	RemoveTimer("RandSound_OfficeArea_2"); 
	RemoveTimer("RandSound_OfficeArea_3");
	RemoveTimer("RandSound_OfficeArea_4");
	RemoveTimer("RandSound_OfficeArea_5");
	RemoveTimer("RandSound_OfficeArea_6");
	RemoveTimer("RandSound_OfficeArea_7");
/*	RemoveTimer("Sound_RandGateArea_1"); 
	RemoveTimer("Sound_RandGateArea_2"); 
	RemoveTimer("Sound_RandGateArea_3");
	RemoveTimer("Sound_RandGateArea_4");
	RemoveTimer("Sound_RandGateArea_5");
	RemoveTimer("Sound_RandGateArea_6");
	RemoveTimer("Sound_RandGateArea_7");
	RemoveTimer("Sound_RandGateArea_8");
	RemoveTimer("InitBilgeGateAreaSoundCues");
	RemoveTimer("BilgeGateAreaSoundCues");*/
	RemoveTimer("InitBilgeGateMonsterAreaSoundCues");
	RemoveTimer("BilgeGateMonsterAreaSoundCues");
	RemoveTimer("InitOfficeAreaSoundCues");
	RemoveTimer("OfficeAreaSoundCues");
	RemoveTimer("InitBodyCorridorSoundCues");
	RemoveTimer("BodyCorridorSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "StopOfficeSounds_1");
	AddEntityCollideCallback("Player", "StartOfficeSounds_1", "SoundOptimiser", true, 1);
			
	AddDebugMessage("Office Area Sounds STOP!", true);
	return;
	}	
	
	if (asChild == "RandSoundArea2_Start_1"|| asChild == "RandSoundArea2_Start_2")
	{	
	
	//Area 2 SOUNDS
	AddTimer("InitCryingSoundCues", 8.0f, "CryingSoundCues");
	AddTimer("InitMonsterSoundCues", 7.0f, "MonsterSoundCues");
	AddTimer("InitScreamSoundCues", 6.0f, "ScreamSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_1");
	RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_2");
	AddEntityCollideCallback("Player", "RandSoundArea2_Stop_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "RandSoundArea2_Stop_2", "SoundOptimiser", true, 1);
	
	AddDebugMessage("Area 2 Sounds START!", true);
	return;
	}
	
	else if (asChild == "RandSoundArea2_Stop_1"|| asChild == "RandSoundArea2_Stop_2")
	{
	//REMOVE AREA 2 SOUNDS
	RemoveTimer("afx_bilgearea2_1");
	RemoveTimer("afx_bilgearea2_2");
	RemoveTimer("afx_bilgearea2_3");
	RemoveTimer("afx_bilgearea2_4");
	RemoveTimer("afx_bilgearea2_5");
	RemoveTimer("afx_bilgearea2_6");
	RemoveTimer("afx_bilgearea2_7");
	RemoveTimer("afx_bilgearea2_8");
	RemoveTimer("InitCryingSoundCues");
	RemoveTimer("CryingSoundCues");
	RemoveTimer("InitMonsterSoundCues");
	RemoveTimer("MonsterSoundCues");
	RemoveTimer("InitScreamSoundCues");
	RemoveTimer("ScreamSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_1");
	RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_2");
	AddEntityCollideCallback("Player", "RandSoundArea2_Start_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "RandSoundArea2_Start_2", "SoundOptimiser", true, 1);
	AddDebugMessage("Area 2 Sounds STOP!", true);
	return;
	}
}

void soundopt (string &in asParent, string &in asChild, int alState)
{
//BILGE MACHINE QUIETER
	if (asChild == "soundopt_quietermachdrone_start")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_quietermachdrone_start");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_quietermachdrone_stop", "soundopt", true, 1);
	
	//Stop Loud Drone
	StopSound("MachineDrone", 4.0f);
	
	//Start Quieter Sound
	PlaySoundAtEntity("MachineDroneQuieter", "amb_bilge_machine_drone_quieter.snt", "Player", 3.5f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Quieter Machine Drone", true);
	}
//BREAK
	if (asChild == "soundopt_quietermachdrone_stop")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_quietermachdrone_stop");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_quietermachdrone_start", "soundopt", true, 1);
	
	//Stop Quieter Drone
	StopSound("MachineDroneQuieter", 4.0f);
	
	//Start Louder Drone
	PlaySoundAtEntity("MachineDrone", "amb_bilge_machine_drone.snt", "Player", 3.5f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Quieter Machine Drone", true);
	}
//BREAK
//ENTER BACK AREA
	if (asChild == "soundopt_enterbackroom_1"|| asChild == "soundopt_enterbackroom_2")
	{
	//REMOVE ENTER TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_enterbackroom_1");
	RemoveEntityCollideCallback("Player", "soundopt_enterbackroom_2");
	
	//ADD EXIT TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_exitbackroom_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_exitbackroom_2", "soundopt", true, 1);
	
	//STOP QUIETER DRONE
	StopSound("MachineDroneQuieter", 4.0f);
	
	//REMOVE OFFICE SOUNDS
	RemoveTimer("Sound_RandOfficeArea_1");
	RemoveTimer("RandSound_OfficeArea_2"); 
	RemoveTimer("RandSound_OfficeArea_3");
	RemoveTimer("RandSound_OfficeArea_4");
	RemoveTimer("RandSound_OfficeArea_5");
	RemoveTimer("RandSound_OfficeArea_6");
	RemoveTimer("RandSound_OfficeArea_7");
/*	RemoveTimer("Sound_RandGateArea_1"); 
	RemoveTimer("Sound_RandGateArea_2"); 
	RemoveTimer("Sound_RandGateArea_3");
	RemoveTimer("Sound_RandGateArea_4");
	RemoveTimer("Sound_RandGateArea_5");
	RemoveTimer("Sound_RandGateArea_6");
	RemoveTimer("Sound_RandGateArea_7");
	RemoveTimer("Sound_RandGateArea_8");
	RemoveTimer("InitBilgeGateAreaSoundCues");
	RemoveTimer("BilgeGateAreaSoundCues");*/
	RemoveTimer("InitBilgeGateMonsterAreaSoundCues");
	RemoveTimer("BilgeGateMonsterAreaSoundCues");
	RemoveTimer("InitOfficeAreaSoundCues");
	RemoveTimer("OfficeAreaSoundCues");
	RemoveTimer("InitBodyCorridorSoundCues");
	RemoveTimer("BodyCorridorSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("ENTER BACK AREA", true);
	}
//BREAK
	if (asChild == "soundopt_exitbackroom_1"|| asChild == "soundopt_exitbackroom_2")
	{
	//REMOVE EXIT TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_exitbackroom_1");
	RemoveEntityCollideCallback("Player", "soundopt_exitbackroom_2");
	
	//ADD ENTER TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_enterbackroom_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_enterbackroom_2", "soundopt", true, 1);
	
	//START OFFICE SOUNDS
/*	AddTimer("InitBilgeGateAreaSoundCues", 8.0f, "BilgeGateAreaSoundCues");*/
	AddTimer("InitBilgeGateMonsterAreaSoundCues", 2.0f, "BilgeGateMonsterAreaSoundCues");
	AddTimer("InitOfficeAreaSoundCues", 9.0f, "OfficeAreaSoundCues");
	AddTimer("InitBodyCorridorSoundCues", 8.0f, "BodyCorridorSoundCues");
	
	//START QUIETER DRONE
	PlaySoundAtEntity("MachineDroneQuieter", "amb_bilge_machine_drone_quieter.snt", "Player", 3.5f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("EXIT BACK AREA", true);
	}
//BREAK
//TUNNEL OPT
	if (asChild == "soundopt_tunnel_start_1")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_tunnel_start_1");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_tunnel_stop_1", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitTunnelGroanSoundCues", 3.0f, "TunnelGroanSoundCues");
	AddTimer("InitTunnelDustSoundCues", 4.0f, "TunnelDustSoundCues");
	AddTimer("InitTunnelWhisperSoundCues", 5.0f, "TunnelWhisperSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Tunnels Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_tunnel_stop_1")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_tunnel_stop_1");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_tunnel_start_1", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("InitTunnelGroanSoundCues");
	RemoveTimer("InitTunnelDustSoundCues");
	RemoveTimer("InitTunnelWhisperSoundCues");	
	RemoveTimer("TunnelGroanSoundCues");
	RemoveTimer("AFX_Tunnels_1_1");
	RemoveTimer("AFX_Tunnels_1_2");
	RemoveTimer("AFX_Tunnels_1_6");
	RemoveTimer("AFX_Tunnels_1_4");
	RemoveTimer("TunnelDustSoundCues");
	RemoveTimer("AFX_Tunnels_1_1");
	RemoveTimer("AFX_Tunnels_1_2");
	RemoveTimer("AFX_Tunnels_1_6");
	RemoveTimer("AFX_Tunnels_1_4");
	RemoveTimer("TunnelWhisperSoundCues");
	RemoveTimer("AFX_Tunnels_1_1");
	RemoveTimer("AFX_Tunnels_1_2");
	RemoveTimer("AFX_Tunnels_1_6");
	RemoveTimer("AFX_Tunnels_1_4");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Tunnels Sounds", true);
	}
//BREAK
}
