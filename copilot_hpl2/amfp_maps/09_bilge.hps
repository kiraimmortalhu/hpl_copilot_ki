//COG MACHINE HANDLER//
void AttachCogs (string &in asArea, string &in asBody)
{
	PlaySoundAtEntity("", "bilge_cog_attach.snt", asArea, 0.0f, false);
	AddDebugMessage("asArea = "+asArea, false);
	if (asArea == "SmallStickyArea")
	{
		string sLocalSmallCogToDespawn = StringSub(asBody, 0, 10);
		AddLocalVarInt("CogsPlaced", 1);
		AddDebugMessage("CogsPlaced + 1", false);
		AddDebugMessage("BodyName = "+sLocalSmallCogToDespawn, false);
		SetLocalVarString("SmallCogToDespawn", sLocalSmallCogToDespawn);
		
		if (GetLocalVarInt("LargeCogFound") == 0)
		{
			//AddHint("Bilge3", ""); //The hint no longer matches what actually happens here.
		}
	}
	else if (asArea == "LargeStickyArea")
	{
		string sLocalLargeCogToDespawn = StringSub(asBody, 0, 10);
		AddLocalVarInt("CogsPlaced", 1);
		AddDebugMessage("CogsPlaced + 1", false);
		AddDebugMessage("BodyName = "+sLocalLargeCogToDespawn, false);
		SetLocalVarString("LargeCogToDespawn", sLocalLargeCogToDespawn);
	}
	if (GetLocalVarInt("CogsPlaced") == 2)
	{
		AddDebugMessage("Wheel Unstuck", false);
		SetWheelInteractionDisablesStuck("DynamoWheel", true);
	}
}

void LargeCogFound (string &in asEntity)
{
	SetLocalVarInt("LargeCogFound", 1);
}
//END COG MACHINE HANDLER//

