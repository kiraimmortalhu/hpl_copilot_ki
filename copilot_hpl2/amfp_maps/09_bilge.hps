//DEATH HANDLER//
void DeathHandler (string &in asName, int alCount)
{
	if (alCount == 0)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		SetPlayerCrouching(true);
		SetPlayerActive(false);
		AddTimer("Death1Timer1", 2.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer2", 5.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer3", 6.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer4", 8.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer5", 9.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer6", 12.5f, "DeathTimer1Sequence");
		return;
	}
	else if (alCount >= 1)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		AddTimer("Death2Timer1", 2.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer2", 5.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer3", 6.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer4", 8.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer5", 9.0f, "DeathTimer2Sequence");
		AddTimer("Death2Timer6", 10.5f, "DeathTimer2Sequence");
		AddTimer("Death2Timer7", 13.0f, "DeathTimer2Sequence");
		return;
	}
	else
	{
		ReleasePlayerFromLimbo();
		return;
	}
}

void DeathTimer1Sequence (string &in asTimer)
{
	if (asTimer == "Death1Timer1")
	{
		PlaySoundAtEntity("", "afx_spooky_hifrequencymoan_2D.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death1Timer2" || asTimer == "Death1Timer3" || asTimer == "Death1Timer4")
	{
		PlaySoundAtEntity("", "afx_spooky_monster_noises_tight_2D.snt", "Player", 0.0f, false);
	}
	else if (asTimer == "Death1Timer5")
	{
		PlaySoundAtEntity("", "00_intro_falling.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death1Timer6")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		return;
	}
}

void DeathTimer2Sequence (string &in asTimer)
{
	if (asTimer == "Death2Timer1")
	{
	}
	else if (asTimer == "Death2Timer2" || asTimer == "Death2Timer3" || asTimer == "Death2Timer4")
	{
	}
	else if (asTimer == "Death2Timer5")
	{
	}
	else if (asTimer == "Death2Timer6")
	{
	}
	else if (asTimer == "Death2Timer7")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		SetEntityActive("Wretch2", false);
		SetLocalVarInt("WretchRemovedPermanently", 1);
		return;
	}
}
//END DEATH HANDLER//

//FALL INTO PIT HANDLER//
void BeginTrapFall(string &in asParent, string &in asChild, int alState)
{
	MandusReactionPlayer("Quick", 0.1);
	SetPlayerCrouching(true);
	SetPlayerCrouchDisabled(true);
	SetPlayerJumpDisabled(true);
	SetPlayerMoveSpeedMul(0.3);
	SetEntityActive("TrapStopFallArea", true);
}

void StopTrapFall(string &in asParent, string &in asChild, int alState)
{
	SetPlayerCrouching(false);
	SetPlayerCrouchDisabled(false);
	SetPlayerJumpDisabled(false);
	SetPlayerMoveSpeedMul(1);
	FadeImageTrailTo(0, 0.1);
	MandusReactionPlayer("Breath", 1.25);
	SetEntityActive("TrapStopFallArea", false);
}

void CollisionTrapSlide(string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		PlaySoundAtEntity("TrapSlide", "joint_dumb_waiter_door_move_endoflevel.snt", "Player", 0.1, false);
		StartScreenShake(0.03, 0.4, 0.1, 0.1);
		FadeImageTrailTo(1.2, 6);
		TrapSlideLoop("");
	}
	else
	{
		StopSound("TrapSlide", 0.1);
		RemoveTimer("TrapSlideLoop");
	}
}

void TrapSlideLoop(string &in asTimer)
{
	if (GetPlayerSpeed() < 10)
	{
		AddPlayerBodyForce(4000,-5000, 0, false);
	}
	AddTimer("TrapSlideLoop", 0.05, "TrapSlideLoop");
}

//END FALL INTO PIT HANDLER//

//HITTING LADDER EVENT HANDLER//
void HittingLadder (string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("soundbump", "impact_metal_med.snt", "LadderEffect", 0, false);
	CreateParticleSystemAtEntity("psbump", "ps_dust_impact_gate.ps", "LadderEffect", false);
	RemoveTimer("ThrowHint");
	
	if (GetLocalVarInt("LadderHits") == 0)
	{
		PlaySoundAtEntity("slidedown", "afx_event_factory_gate_close.snt", "LadderEffect", 0.5, false);
		AddPropForce("sliding_ladder_1", 0, 10, 0, "World");
		SetEntityActive("LadderBlockerA", false);
		AddLocalVarInt("LadderHits", 1);
		RemoveTimer("help_player1");
		AddTimer("help_player2", 20, "AutoCompleteLadder");
		HittingLadder("","", 1);	//add so only need one hit
		return;
	}
	else if (GetLocalVarInt("LadderHits") == 1)
	{
		AddPropForce("sliding_ladder_1", 0, 10, 0, "World");
		SetEntityActive("LadderBlockerB", false);
		SetEntityActive("PitLadderAreaFull", true);
		SetEntityActive("PitLadderAreaShort", false);
		RemoveTimer("help_player2");
		return;
	}
}

void CollideCheckPlayerInPit(string &in asParent, string &in asChild, int alState)
{
	AddTimer("help_player2", 46, "AutoCompleteLadder");
	AddTimer("help_player1", 45, "AutoCompleteLadder");
	
	AddTimer("ThrowHint", 10, "TimerShowHint");
}

void TimerShowHint(string &in asTimer)
{
	GiveHint("ThrowHint", "Hints", "ThrowHint", -1);
}

void AutoCompleteLadder(string &in asTimer)
{
	if(asTimer == "help_player1")
	{
		StartScreenShake(0.02, 0.5, 0.5, 1);
		PlaySoundAtEntity("wez_shakes", "afx_church_pens_vo_shake_1", "Player",1, false);
	}
	
	if(asTimer == "help_player2")
	{
		HittingLadder("","", 1);
		HittingLadder("","", 1);
		StopSound("wez_shakes", 2);
	}
}

//END HITTING LADDER//

//RESTORE TO NORMAL//
void RestoreToNormal (string &in asTimer)
{
//RETURN TO NORMAL VISION
	if (asTimer == "ReturnToNormalVision")
	{
		FadeRadialBlurTo(0.0f, 4.0f);
		FadeImageTrailTo(0.0f, 4.0f);
		return;
	}

//RETURN TO NORMAL ALL//
	else if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		StopPlayerLookAt();
		return;
	}
	
//END VISUAL EFFECT FOR SCREAM//
	else if (asTimer == "EndVisEffect")
	{
		FadeImageTrailTo(0.0f, 0.5f);
		FadeSepiaColorTo(0.0f, 0.5f);
		return;
	}
}
//END RESTORE TO NORMAL//

//SPRAYLOCK SWITCH PROXIMITY CHECKER//
void CheckPowerSwitchProximity (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("spraylocksequenced") == 0)
	{
		if (alState == 1)
		{
			AddDebugMessage("Power Switch CAN Be Interacted With", false);
			SetEntityInteractionDisabled("spraylock_power_switch", false);
			AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
			return;
		}
		else if (alState == -1)
		{
			AddDebugMessage("Power Switch CANNOT Be Interacted With", false);
			SetEntityInteractionDisabled("spraylock_power_switch", true);
			RemoveTimer("MovementPreventionTimer");
			return;
		}
	}
}
//END PROXIMITY CHECKER//	

//STOP MOVEMENT ON POWER SWITCH INTERACT//
void MovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("spraylock_power_switch") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
}
//END STOP MOVEMENT//									

//SPRAYLOCK SEQUENCER//
void SpraylockSequence (string &in asEntity, int alState)
{
	if (asEntity == "spraylock_power_switch" && alState == 1 && GetLocalVarInt("spraylocksequenced") == 0)
	{
		AddDebugMessage("Spraylock Power Switch Activated", false);
		PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "spraylock_power_switch", 0.0f, false);
		//PLAY SPARKS//
		SetParticleSystemActive("spraylock_sparks_1", true);
		SetParticleSystemActive("spraylock_sparks_2", true);
		SetLightVisible("spraylock_spark_light", true);
		AddTimer("SpraylockPowerSwitchSparkLightTimer", 0.4, "SpraylockTimedEvents");
		//STICK POWER SWITCH//
		SetLeverInteractionDisablesStuck("spraylock_power_switch", false);
		SetLeverStuckState("spraylock_power_switch", 1, false);
		//UNSTICK INTERIOR VALVE 1//
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_1", true);
		PlaySoundAtEntity("sl_hiss_2", "spraylock_gauge_hiss_2.snt", "spraylock_hiss_inside_1", 0.0f, false);
		//ACTIVATE CONTAINING RAILS//
		PlayPropAnimation("spraylock_railing", "offtoon", 0.0f, false, "");
		PlaySoundAtEntity("sl_railing_up", "spraylock_railing_up.snt", "spraylock_railing", 0.0f, false);
		SetEntityActive("spraylock_railing_collision", true);
		AddTimer("SpraylockRailingActivationAnimationTimer", 1.5f, "SpraylockTimedEvents");
		//REMOVE PROXIMITY CHECKER//
		RemoveEntityCollideCallback("Player", "spraylock_power_interaction_area");
		SetEntityInteractionDisabled("spraylock_power_switch", false);
		//PLAY SEQUENCE OUT
		PlaySoundAtEntity("sl_turbinestart", "spraylock_turbine_start.snt", "spraylock_center_sound", 0.0f, false);
		PlaySoundAtEntity("sl_enginestart", "spraylock_engine_start.snt", "spraylock_center_sound", 0.0f, false);
		PlaySoundAtEntity("sl_turbinestart_rattle", "spraylock_turbine_start_RATTLE.snt", "spraylock_rattlesound", 0.0f, false);
		SetLampLit("spraylock_red_light", false, false);
		SetLampLit("spraylock_green_light", true, false);
		AddTimer("SpraylockInitLoopTimer", 3.0f, "SpraylockTimedEvents");
		AddTimer("SpraylockEngineOnAnimationBuffer", 1.9f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_engines", "on", 0.0f, false, "");
		AddTimer("SpraylockCabinetGauge1AnimationTimer", 3.2f, "SpraylockTimedEvents");
		AddTimer("SpraylockCabinetGauge2AnimationTimer", 2.0f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_power_gauges", "offtoon", 0.0f, false, "");
		PlayPropAnimation("spraylock_spray_switch_gauges", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_spray_switch_gauges_1", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_1", "on", 0.0f, true, "");
		AddTimer("SpraylockPowerGaugesOffToOnTimer", 0.3, "SpraylockTimedEvents");
		return;
	}
	else if (asEntity == "spraylock_power_switch" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 1)
	{
		//STICK POWER SWITCH//
		SetLeverInteractionDisablesStuck("spraylock_power_switch", false);
		SetLeverStuckState("spraylock_power_switch", -1, false);
		//SWITCH LIGHTS//
		SetLampLit("spraylock_red_light", true, false);
		SetLampLit("spraylock_green_light", false, false);
		//DEACTIVATE CONTAINING RAILS//
		PlayPropAnimation("spraylock_railing", "ontooff", 0.0f, false, "");
		PlaySoundAtEntity("sl_railing_down", "spraylock_railing_down.snt", "spraylock_railing", 0.0f, false);
		SetEntityActive("spraylock_railing_collision", true);
		AddTimer("SpraylockRailingDeactivationAnimationTimer", 1.5f, "SpraylockTimedEvents");		
		//PLAY SEQUENCE OUT//
		PlaySoundAtEntity("sl_turbine_end", "spraylock_turbine_end.snt", "spraylock_center_sound", 1.0f, false);
		PlaySoundAtEntity("sl_turbine_end_rattle", "spraylock_turbine_end_rattle.snt", "spraylock_rattlesound", 1.0f, false);
		PlaySoundAtEntity("sl_engine_end", "spraylock_engine_end.snt", "spraylock_center_sound", 1.0f, false);
		StopSound("sl_turbine_loop", 1.0f);
		StopSound("sl_engine_loop", 1.0f);
		PlayPropAnimation("spraylock_engines", "ontooff", 0.0f, false, "");
		PlayPropAnimation("spraylock_power_gauges", "ontooff", 1.0f, false, "");
		return;
	}
	else if (asEntity == "spraylock_spray_switch" && alState == 1)
	{
		AddDebugMessage("Spraylock Spray Switch Activated", false);
		AddTimer("SpraylockGaugesStartUpPadding", 0.4f, "SpraylockTimedEvents");
		AddTimer("SpraylockSprayGaugesAnimationPadding", 0.6f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_spray_switch_gauges", "ontooff", 7.0f, false, "");
		PlayPropAnimation("spraylock_spray_switch_gauges_1", "ontooff", 7.0f, false, "");
		PlaySoundAtEntity("", "spraylock_switch_confirm.snt", "spraylock_spray_switch", 0, false);
		//STICK SPRAY SWITCH
		SetLeverInteractionDisablesStuck("spraylock_spray_switch", false);
		SetLeverStuckState("spraylock_spray_switch", 1, false);
		AddTimer("SpraylockSprayPadding", 0.3f, "SpraylockTimedEvents");
		AddTimer("SpraylockSprayToEndTimer", 8.0f, "SpraylockTimedEvents");
		return;
	}
}
//END SEQUENCER//

//SPRAYLOCK DOOR SEQUENCER//
void SpraylockDoorHandler (string &in asEntity, int alState)
{
	if (asEntity == "spraylock_valve_outside_1" && alState == -1) //Office Valve Opens Door 1//
	{
		AddDebugMessage("Opening Spraylock Door 1", false);
		StopSound("sl_hiss_1", 0.5f);
		PlayPropAnimation("spraylock_door_1", "opening", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_OUTSIDE.snt", "spraylock_door1source", 0.0f, false);
		PlayPropAnimation("spraylock_gauge_outside_1", "ontooff", 4.0f, false, "");
		AddTimer("SpraylockDoor1AnimationPadding", 2.2f, "SpraylockTimedEvents");
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_outside_1", false);
		SetWheelStuckState("spraylock_valve_outside_1", -1, false);
		return;
	}
	
	else if (asEntity == "spraylock_valve_inside_1" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 0) //Left Interior Valve Closes Door 1//
	{
		AddDebugMessage("Closing Spraylock Door 1", false);
		StopSound("sl_hiss_2", 0.5f);
		AddTimer("SpraylockDoor1ClosingAnimationPadding", 3.0f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_gauge_inside_1", "ontooff", 4.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_close_INSIDE.snt", "spraylock_door2source", 0.0f, false);
		PlaySoundAtEntity("", "spraylock_valve_lock_inside.snt", "spraylock_valve_inside_1", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_1", 0, 3.0f, true);
		//UNSTICK SPRAY SWITCH
		SetLeverInteractionDisablesStuck("spraylock_spray_switch", true);
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_1", false);
		SetWheelStuckState("spraylock_valve_inside_1", -1, false);
		//STOPPING EXTERIOR MACHINE SOUNDS
		StopSound("PistonWheel", 1.0f);
		StopSound("BilgeEngineLoop3", 1.0f);
		StopSound("DynamoLoop2", 1.0f);
		StopSound("DynamoLoop", 1.0f);
		StopSound("Dynamo2D2", 1.0f);
		StopSound("Dynamo2D", 1.0f);
		StopSound("DynamoStartup2", 1.0f);
		StopSound("DynamoStartup", 1.0f);
		StopSound("MachineDrone", 1.0f);
		StopSound("MachineDroneQuieter", 1.0f);
		StopSound("DynamoEngineStartup", 3.0f);
		StopSound("DynamoStartup", 3.0f);
		StopSound("DynamoStartup2D", 3.0f);
		StopSound("BilgeEngine33D", 3.0f);
		StopSound("BilgeEngine32D", 3.0f);
		StopSound("BilgeEngine23D", 3.0f);
		StopSound("BilgeEngine22D", 3.0f);
		StopSound("BilgeEngine13D", 3.0f);
		StopSound("BilgeEngine12D", 3.0f);
		StopSound("DynamoEngineLoop", 3.0f);
		StopSound("DynamoLoop", 3.0f);
		StopSound("Dynamo2D", 3.0f);
		StopSound("Dynamo", 3.0f);
		RemoveTimer("afx_bilgearea2_1");
		RemoveTimer("afx_bilgearea2_2");
		RemoveTimer("afx_bilgearea2_3");
		RemoveTimer("afx_bilgearea2_4");
		RemoveTimer("afx_bilgearea2_5");
		RemoveTimer("afx_bilgearea2_6");
		RemoveTimer("afx_bilgearea2_7");
		RemoveTimer("afx_bilgearea2_8");
		RemoveTimer("InitCryingSoundCues");
		RemoveTimer("CryingSoundCues");
		RemoveTimer("InitMonsterSoundCues");
		RemoveTimer("MonsterSoundCues");
		RemoveTimer("InitScreamSoundCues");
		RemoveTimer("ScreamSoundCues");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_1");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_2");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_1");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_2");
		RemoveTimer("Sound_RandOfficeArea_1");
		RemoveTimer("RandSound_OfficeArea_2"); 
		RemoveTimer("RandSound_OfficeArea_3");
		RemoveTimer("RandSound_OfficeArea_4");
		RemoveTimer("RandSound_OfficeArea_5");
		RemoveTimer("RandSound_OfficeArea_6");
		RemoveTimer("RandSound_OfficeArea_7");
/*		RemoveTimer("Sound_RandGateArea_1"); 
		RemoveTimer("Sound_RandGateArea_2"); 
		RemoveTimer("Sound_RandGateArea_3");
		RemoveTimer("Sound_RandGateArea_4");
		RemoveTimer("Sound_RandGateArea_5");
		RemoveTimer("Sound_RandGateArea_6");
		RemoveTimer("Sound_RandGateArea_7");
		RemoveTimer("Sound_RandGateArea_8");
		RemoveTimer("InitBilgeGateAreaSoundCues");
		RemoveTimer("BilgeGateAreaSoundCues");*/
		RemoveTimer("InitBilgeGateMonsterAreaSoundCues");
		RemoveTimer("BilgeGateMonsterAreaSoundCues");
		RemoveTimer("InitOfficeAreaSoundCues");
		RemoveTimer("OfficeAreaSoundCues");
		RemoveTimer("InitBodyCorridorSoundCues");
		RemoveTimer("BodyCorridorSoundCues");
		RemoveEntityCollideCallback("Player", "StartOfficeSounds_1");
		RemoveEntityCollideCallback("Player", "StopOfficeSounds_1");
		RemoveTimer("AFX_Bilge_Oneshot_1");
		RemoveTimer("AFX_Bilge_Oneshot_2");
		RemoveTimer("AFX_Bilge_Oneshot_3");
		RemoveTimer("AFX_Bilge_Oneshot_4");
		RemoveTimer("AFX_Bilge_Oneshot_5");
		RemoveTimer("AFX_Bilge_Oneshot_6");
		RemoveTimer("AFX_Bilge_Oneshot_7");
		RemoveTimer("AFX_Bilge_Oneshot_8");
		RemoveTimer("AFX_Bilge_Oneshot_9");
		RemoveTimer("AFX_Bilge_Oneshot_10");
		RemoveTimer("AFX_Bilge_Oneshot_11");
		RemoveTimer("AFX_Bilge_Oneshot_12");
		RemoveTimer("AFX_Start_1");
		RemoveTimer("AFX_Start_2");
		RemoveTimer("AFX_Start_3");
		RemoveTimer("StartAreaSoundCues");
		RemoveTimer("InitStartAreaSoundCues");
		return;
	}
	
	else if (asEntity == "spraylock_valve_outside_2" && alState == -1) //Annex Valve Closes Door 2//
	{/*
		PlayPropAnimation("spraylock_door_1", "door", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_open.snt", "spraylock_door2source", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_2", 0, 3.0f, false);
		return;
	*/
	}
	
	else if (asEntity == "spraylock_valve_inside_2" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 1) //Right Interior Valve Opens Door 2//
	{
		AddDebugMessage("Opening Spraylock Door 2", false);
		StopSound("sl_hiss_3", 0.5f);
		PlayPropAnimation("spraylock_gauge_inside_2", "ontooff", 4.0f, false, "");
		PlayPropAnimation("spraylock_door_2", "opening", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_INSIDE.snt", "spraylock_door1source", 0.0f, false);
		AddTimer("SpraylockDoor2AnimationPadding", 2.0f, "SpraylockTimedEvents");
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_2", false);
		SetWheelStuckState("spraylock_valve_inside_2", -1, false);
		//UNSTICK POWER SWITCH FOR SECOND USE
		SetLeverInteractionDisablesStuck("spraylock_power_switch", true);
		return;		
	}
}
