//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "VOFlashback_1")
	{
		AddDebugMessage("Flashback Activated", false);
		AddEffectVoice2("vo_bilge_flashback_mandus", "", "Voice", "vo_bilge_flashback_mandus", 0.0f, "vo_bilge_flashback_mandus_1", 8.6f, false, "", 0.0f, 0.0f);
		PlayMusic("music_bilge_flashback.ogg", false, 0.50f, 0.0f, 6, false);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 15.0f, "RestoreToNormal");
		return;
	}
	else if (asChild == "childVO_1")
	{
		AddEffectVoice("vo_bilge_child_01.ogg", "", "Voice", "vo_bilge_child_01", false, "", 0.0f, 0.0f);
	}
	else if (asChild == "childVO_2")
	{
		AddEffectVoice("vo_bilge_child_02.ogg", "", "Voice", "vo_bilge_child_02", false, "", 0.0f, 0.0f);
	}
	else if (asChild == "childVO_3")
	{
		AddEffectVoice("vo_bilge_child_03.ogg", "", "Voice", "vo_bilge_child_03", false, "", 0.0f, 0.0f);
	}
	
}
//END TRIGGERED VO PLAYER//

//PHONAUTOGRAPH HANDLER//
void PhonautographHandler (string &in asEntity, int alState)																//This function must be present for all maps containing Phonautograph entities.
{
	if (alState == 1)																										//DO NOT EDIT
	{																														///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////////////////////////////
		if (asEntity == "Phonautograph1")																					
		{
			SetEntityInteractionDisabled(asEntity, true);																	//DO NOT EDIT
			PlayPropAnimation("Phonautograph1", "Play", 1.0f, true, "");													//Starts Animation. The name of the Phonautograph entity will need changing for other instances.
			AddEffectVoice7("vo_bilge_phono.ogg", "", "Voice", "vo_bilge_phono_prof_1", 0.0f, "vo_bilge_phono_mandus_1", 4.0f, "vo_bilge_phono_mandus_1_2", 12.17f, "vo_bilge_phono_mandus_1_3", 17.38f, "vo_bilge_phono_prof_2", 23.0f, "vo_bilge_phono_mandus_2", 27.0f, "vo_bilge_phono_mandus_2_2", 32.4f, false, "", 0.0f, 0.0f);	    		//Plays voice. The .ogg file being called, and the entry name from the .lang file will need changing for other instances.
			AddTimer("Phono1Timer", 39.5f, "PhonautographDeactivateHandler");	
		}																													
	}																														//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES///////////////	
}

void PhonautographDeactivateHandler (string &in asTimer)																	//This function must be present for all maps containing Phonautograph entities.
{																															///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////
	if (asTimer == "Phono1Timer")																							//This if statement must be updated for each different phonautograph instance.
	{
		PlayPropAnimation("Phonautograph1", "Stop", 1.0f, true, "");														//Stops Animation. The name of the Phonautograph entity will need changing for other instances.
	}
}																															//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES/////////////
//END PHONAUTOGRAPH HANDLER//

//RANDOM SOUND PLAYER//
void BilgeRandSoundCues(string &in asTimer)
{
	string[] sCueSources = {"AFX_Bilge_Oneshot_1", "AFX_Bilge_Oneshot_2", "AFX_Bilge_Oneshot_3", "AFX_Bilge_Oneshot_4", "AFX_Bilge_Oneshot_5", "AFX_Bilge_Oneshot_6", "AFX_Bilge_Oneshot_7", "AFX_Bilge_Oneshot_8", "AFX_Bilge_Oneshot_9", "AFX_Bilge_Oneshot_10", "AFX_Bilge_Oneshot_11"};
	asTimer = sCueSources[RandInt(0, 11)];
	PlaySoundAtEntity(asTimer, "afx_spooky_eerie_monster.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected BILGE SPOOKY Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(6.0f, 16.0f), "BilgeRandSoundCues");
}

void BilgeRandBodypitSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Sound_BodyPitRand"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_spooky_scream_type1.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Bodypit: "+asTimer, false);
	AddTimer(asTimer, RandFloat(15.0f, 20.0f), "BilgeRandBodypitSoundCues");
}

void BilgeGateAreaSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Sound_RandGateArea_1", "Sound_RandGateArea_2", "Sound_RandGateArea_3", "Sound_RandGateArea_4", "Sound_RandGateArea_5", "Sound_RandGateArea_6", "Sound_RandGateArea_7", "Sound_RandGateArea_8"};
