		PlaySoundAtEntity("sound_steam6_3D", "afx_cellar_post_collapse_steam_1_quieter.snt", "sound_steamsource_6", 0.0f, true);	
		
		//OTHER
		PlaySoundAtEntity("fansource_1", "amb_mansion_ceiling_fan_wider.snt", "FanSource_1", 0.0f, true);
		PlaySoundAtEntity("sound_flies_1", "amb_church_pens_flies_loop.snt", "sound_fliessource_1", 0.0f, true);
		PlaySoundAtEntity("sound_flies_2", "amb_church_pens_flies_loop.snt", "sound_fliessource_2", 0.0f, true);
		PlaySoundAtEntity("sound_flies_3", "amb_church_pens_flies_loop.snt", "sound_fliessource_3", 0.0f, true);
		PlaySoundAtEntity("sound_EntranceFliesSource", "amb_church_pens_flies_loop.snt", "sound_EntranceFliesSource", 0.0f, true);
	}
	
	//ANIMATION STATES//
	{
		if (GetLocalVarInt("PumpDynamoStarted") == 0)
		{
			SetEntityActive("bilge_engine_1_animated", false);
			SetEntityActive("bilge_engine_2_animated", false);
			SetEntityActive("bilge_engine_1_static", true);
			SetEntityActive("bilge_engine_2_static", true);
		}                               
		else
		{
			SetEntityActive("bilge_engine_1_animated", true);
			SetEntityActive("bilge_engine_2_animated", true);
			SetEntityActive("bilge_engine_1_static", false);
			SetEntityActive("bilge_engine_2_static", false);
		}
		
		if (GetLocalVarInt("DynamoStarted") == 0)
		{
			SetEntityActive("bilge_engine_3_animated", false);
			SetEntityActive("bilge_engine_3_static", true);
			PlayPropAnimation("Dynamo", "static", 0.0f, true, "");
			PlayPropAnimation("CogsAnimated", "static", 0.0f, true, "");
		}
		else
		{
			SetEntityActive("bilge_engine_3_animated", true);
			SetEntityActive("bilge_engine_3_static", false);
			PlayPropAnimation("Dynamo", "loop", 0.0f, true, "");
			PlayPropAnimation("CogsAnimated", "animation", 0.0f, true, "");
		}
		PlayPropAnimation("Phonautograph1", "Stop", 0.0f, true, "");							//Initialises Phonautograph to non-animated.
	}
	
	//MOVE OBJECT STATES//
	{
		if (GetLocalVarInt("PumpDynamoStarted") == 0)
		{
			SetMoveObjectState("reactor_door_1", 0);
		}
		else
		{
			SetMoveObjectState("reactor_door_1", 1);
		}
	}
	
	//ENTITY STATES//
	{
		if (GetLocalVarInt("PumpDynamoStarted") == 1)
		{
			SetEntityActive("Mask1", true);
		}
		else
		{
			SetEntityActive("Mask1", false);
		}
		
		if (GetLocalVarInt("DynamoStarted") == 1)
		{
			SetEntityActive("WaterPlaneHigh", false);
			SetEntityActive("waterlurker_1", false);
		}
		
	}
	
	//WATER AREA CONNECTIONS//
	{
		SetPropStaticPhysics("WaterPlaneHigh", true);
		AttachAreaToProp("WaterNoCrouchAreaLiquid", "WaterPlaneHigh", 0);
		AttachAreaToProp("WaterNoCrouchArea", "WaterPlaneHigh", 0);
	}
	//ENEMY STATES//
	{
		SetManPigType("Child1", "Freddy");
		SetEnemyMoveType("Child1", "ChargeBiped");
		SetManPigType("child_2", "Freddy");
		SetEnemyMoveType("child_2", "RunBiped");
		SetManPigType("child_3", "Freddy");
		SetEnemyMoveType("child_3", "ChargeBiped");
		SetManPigType("child_4", "Freddy");
		SetEnemyMoveType("child_4", "RunBiped");
	}
	
	//SPRAYLOCK INITIALISATION//
	{
		//SPRAYLOCK LIGHT STATES//
		SetLampLit("spraylock_green_light", false, false);
		SetLightVisible("spraylock_spark_light", false);
		
		//SPRAYLOCK ENTITY INTERACTION// 
		SetEntityInteractionDisabled("spraylock_engines", true);
		SetEntityInteractionDisabled("spraylock_power_switch", true);
		
		//SOUND INITIALISATION//
		PlaySoundAtEntity("sl_hiss_1", "spraylock_gauge_hiss_1.snt", "spraylock_hiss_outside_1", 0.0f, true);
		
		//SPRAYLOCK PARTICLE SYSTEM STATES//
		SetParticleSystemActive("spraylock_sparks_1", false);
		SetParticleSystemActive("spraylock_sparks_2", false);
		SetParticleSystemActive("spraylock_spray1", false);
		SetParticleSystemActive("spraylock_spray2", false);
		SetParticleSystemActive("spraylock_spray3", false);
		SetParticleSystemActive("spraylock_spray4", false);
		SetParticleSystemActive("spraylock_spray5", false);
		SetParticleSystemActive("spraylock_spray6", false);
		SetParticleSystemActive("spraylock_risingmist", false);
		
		//SPRAYLOCK SPECIFIC STATES//
		if (GetLocalVarInt("SpraylockReady") == 1)
		{
			PlayPropAnimation("spraylock_gauge_outside_1", "on", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("spraylock_gauge_outside_1", "off", 0.0f, true, "");
		}
		PlayPropAnimation("spraylock_gauge_inside_1", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_2", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_engines", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_railing", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_electric_cabin", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_steam_gauges", "on", 0.0f, true, "");
		SetSwingDoorDisableAutoClose("spraylock_door_1", true);
		SetEntityInteractionDisabled("spraylock_door_1", true);
		SetSwingDoorClosed("spraylock_door_1", false, false);
		SetSwingDoorDisableAutoClose("spraylock_door_2", true);
		SetEntityInteractionDisabled("spraylock_door_2", true);
	}
	
	//AUTOSAVE//
	{
		//AutoSave();
	}
}

void OnLeave()
{
	SetupLoadScreen("LoadingText", "Reactor_", 3, "game_loading_reactor.jpg");
}

