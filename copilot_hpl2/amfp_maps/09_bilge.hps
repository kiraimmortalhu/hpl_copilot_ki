	{
		AddTimer("InitRandomScreamSoundCuePlayer", 1.0f, "BilgeRandSoundCues");
		AddTimer("InitRandomBodypitSoundCuePlayer", 1.0f, "BilgeRandBodypitSoundCues");
		AddTimer("InitWaterAreaSoundCues", 10.0f, "WaterAreaSoundCues");
		AddTimer("InitStartAreaSoundCues", 4.0f, "StartAreaSoundCues");
		AddTimer("InitEnvCreakAreaSoundCues", 5.0f, "EnvCreakAreaSoundCues");

		
