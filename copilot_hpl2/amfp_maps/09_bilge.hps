//BILGE MACHINE 1 POWER UP SEQUENCE//
void BilgeMachine1PowerUp (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		//DYNAMO SOUNDSET
		PlaySoundAtEntity("DynamoLoop", "dynamo_idle_loop_3D.snt", "PumpDynamoSource", 3.5f, true);
		PlaySoundAtEntity("Dynamo2D", "dynamo_idle_2D.snt", "PumpDynamoSource", 3.5f, true);
		PlaySoundAtEntity("DynamoStartup", "dynamo_startup_3D", "PumpDynamoSource", 0.0f, true);
		//END DYNAMO SOUNDSET
		
		//STEAM SOUND//
		PlaySoundAtEntity("Steam", "amb_bilge_steam02_3D.snt", "pumpdynamosteamsource", 3.5f, true);
		
		//BILGE SOUNDS
		PlaySoundAtEntity("BilgeEngineLoop2", "bilge_engine_loop.snt", "bilge_engine_2_animated", 4.0f, true);
		PlaySoundAtEntity("BilgeEngineLoop1", "bilge_engine_loop.snt", "bilge_engine_1_animated", 4.0f, true);
		AddTimer("MachineDroneSound", 1.0f, "machinedronesound");
		
		//ANIMATION
		PlayPropAnimation("PumpCogsAnimated", "animation", 0.0f, true, "");
		PlayPropAnimation("PumpDynamo", "loop", 0.0f, true, "");
		SetMoveObjectState("reactor_door_1", 1);
		
		//STATES
		SetEntityActive("waterlurker_amb_1", false);
		SetEntityActive("waterlurker_amb_2", false);
		SetEntityActive("waterlurker_amb_3", true);
		SetLocalVarInt("PumpDynamoStarted", 1);
		SetEntityActive("bilge_engine_1_animated", true);
		SetEntityActive("bilge_engine_2_animated", true);
		SetEntityActive("bilge_engine_1_static", false);
		SetEntityActive("bilge_engine_2_static", false);		
		SetEntityActive("Mask1", true);
		SetLeverStuckState("BilgeMachinePowerWheel", -1, false);
		SetEntityInteractionDisabled("BilgeMachinePowerWheel", true);
		SetWheelInteractionDisablesStuck("BilgeMachine1Valve", true);
		AddDebugMessage("Bilge Machine 1 Powered Up", false);
		
		//PARTICLE FX
		SetParticleSystemActive("PumpWheelSteam_5", true);
		SetParticleSystemActive("PumpWheelSteam_6", true);
		SetParticleSystemActive("PumpWheelSteam_7", true);
		SetParticleSystemActive("PumpWheelSteam_8", true);
		SetParticleSystemActive("PumpDynamoWheelSteam_*", true);
		
		//STEAM BLOCK
		PlaySoundAtEntity("BlockingSteamSound", "afx_enginerooms_controlroomsteamblock.snt", "SoundSteamBlock", 7.0f, true);
		SetEntityActive("SteamBlock", true);
		SetParticleSystemActive("PSSteamBlock", true);
		SetEntityActive("AreaSteamBlock", true);
		AddEntityCollideCallback("Player", "AreaSteamBlock", "CollideSteamBlock", false, 0);
		
		//REMOVE RANDOM SOUNDS
		RemoveTimer("TunnelGroanSoundCues");
		RemoveTimer("InitTunnelGroanSoundCues");
		RemoveTimer("AFX_Tunnels_1_1"); 
		RemoveTimer("AFX_Tunnels_1_2"); 
		RemoveTimer("AFX_Tunnels_1_6");
		RemoveTimer("AFX_Tunnels_1_4");
		RemoveTimer("AFX_Tunnels_1_3");
		RemoveTimer("TunnelDustSoundCues");
		RemoveTimer("TunnelWhisperSoundCues");
		RemoveTimer("InitTunnelDustSoundCues");
		RemoveTimer("InitTunnelWhisperSoundCues");
		RemoveTimer("WaterAreaSoundCues");
		RemoveTimer("InitWaterAreaSoundCues");
		RemoveTimer("InitEnvCreakAreaSoundCues");
		RemoveTimer("EnvCreakAreaSoundCues");
		RemoveTimer("AFX_Water_1");
		RemoveTimer("AFX_Water_2");
		RemoveTimer("AFX_Water_3");
		RemoveTimer("AFX_Water_4");
		RemoveTimer("AFX_Water_5"); 
		RemoveTimer("AFX_Water_6");
		RemoveTimer("AFX_Water_7");
		RemoveTimer("AFX_Water_8");
		RemoveTimer("AFX_Bilge_Oneshot_1");
		RemoveTimer("AFX_Bilge_Oneshot_2"); 
		RemoveTimer("AFX_Bilge_Oneshot_3");
		RemoveTimer("AFX_Bilge_Oneshot_4");
		RemoveTimer("AFX_Bilge_Oneshot_5");
		RemoveTimer("AFX_Bilge_Oneshot_6");
		RemoveTimer("AFX_Bilge_Oneshot_7");
		RemoveTimer("AFX_Bilge_Oneshot_8");
		RemoveTimer("AFX_Bilge_Oneshot_9");
		RemoveTimer("AFX_Bilge_Oneshot_10"); 
		RemoveTimer("AFX_Bilge_Oneshot_11");
		RemoveTimer("BilgeRandSoundCues");
		RemoveTimer("InitBilgeRandSoundCues");
	}
}

void PumpDynamoIdleLoops (string &in asTimer)
{
	if (asTimer == "DynamoIdleFirstLoop")
	{
		AddDebugMessage("Pump Dynamo Loop Triggered", false);
		AddTimer("DynamoIdleStandardLoop", 11.12f, "PumpDynamoIdleLoops");
		PlaySoundAtEntity("Dynamo2D", "dynamo_idle_2D.snt", "PumpDynamoEngineSource", 0.0f, true);
		
		return;
	}
	else if (asTimer == "DynamoIdleStandardLoop")
	{
		AddDebugMessage("Dynamo Loop Triggered", false);
		PlaySoundAtEntity("Dynamo2D", "dynamo_idle_2D.snt", "PumpDynamoEngineSource", 3.0f, true);
		return;
	}
}

void CollideSteamBlock(string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		FadeImageTrailTo(2.0f, 2);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerJumpDisabled(true);
		MandusReactionPlayer("Cough", 0.0f);
		AddTimer("InSteamLoop", RandFloat(1.75f, 2.25f), "SteamCoughing");

		return;
	}
	else if (alState == -1)
	{
		RemoveTimer("InSteamLoop");
		FadeImageTrailTo(0.0f, 3.5f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerJumpDisabled(false);
		return;
	}
}

void SteamCoughing (string &in asTimer)
{
	MandusReactionPlayer("Cough", RandFloat(0.15f, 0.3f));
	StartScreenShake(0.03, 0.3, 0.2, 0.5);
	AddTimer("InSteamLoop", RandFloat(1.75f, 2.25f), "SteamCoughing");
}
//END BILGE MACHINE 1 POWER UP SEQUENCE//

//BILGE MACHINE 1 ACTIVATION SEQUENCE//
void BilgeMachine1ActivationSequence (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		AddDebugMessage("Bilge Machine 1 Activated", false);
		SetEntityActive("WaterPlane1", false);
		SetEntityActive("FloodInfectionArea", false);
		PlaySoundAtEntity("Bilge_1_Ignition", "afx_sewer_pump_engine_ignition", "Bilge_1_SoundArea", 1.0f, false);
		PlaySoundAtEntity("Drain_1_Loop", "afx_sewer_drain_loop", "Drain_1_SoundArea", 1.0f, true);
		PlaySoundAtEntity("Drain_1_Loop", "afx_sewer_drain_on", "Drain_1_SoundArea", 1.0f, true);
		SetWheelInteractionDisablesStuck("BilgeMachine1Valve", false);
		SetWheelStuckState("BilgeMachine1Valve", -1, false);
	}
}

//SLUICE GATE HANDLER//
void SluiceGateHandler (string &in asParent, string &in asChild, int alState)
{
	AddTimer("Sluice2StartBuffer", 1.5f, "SluiceTimers");
	AddTimer("Sluice3StartBuffer", 3.5f, "SluiceTimers");
}

void SluiceTimers (string &in asTimer)
{
	if (asTimer == "Sluice2StartBuffer")
	{
		PlayPropAnimation("Sluice2", "gate_opening", 0.0f, false, "");
		SetParticleSystemActive("Sluice2Particles_*", true);
		AddTimer("Sluice2ParticleTimer", 0.8f, "SluiceParticlesTimedEvent");
		return;
	}
	else if (asTimer == "Sluice3StartBuffer")
	{
		PlayPropAnimation("Sluice3", "gate_opening", 0.0f, false, "");
		SetParticleSystemActive("Sluice3Particles_*", true);
		AddTimer("Sluice3ParticleTimer", 0.8f, "SluiceParticlesTimedEvent");
		return;
	}
}
void SluiceParticlesTimedEvent (string &in asTimer)
{
	if (asTimer == "Sluice2ParticleTimer")
	{
		DestroyParticleSystem("Sluice2Particles_1");
		DestroyParticleSystem("Sluice2Particles_2");
		DestroyParticleSystem("Sluice2Particles_3");
		DestroyParticleSystem("Sluice2Particles_4");
		return;
	}
	else if (asTimer == "Sluice3ParticleTimer")
	{
		DestroyParticleSystem("Sluice3Particles_1");
		DestroyParticleSystem("Sluice3Particles_2");
		DestroyParticleSystem("Sluice3Particles_3");
		DestroyParticleSystem("Sluice3Particles_4");
		return;
	}
}
//END SLUICE GATE HANDLER//


