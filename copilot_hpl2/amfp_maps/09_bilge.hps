//LADDER CHILD EVENT//
void LadderChildEvent (string &in asEntity)
{
	AddTimer("ChildLadderTimer1", 0.35f, "ChildLadderTimedEvents");
	AddTimer("ChildLadderTimer2", 0.45f, "ChildLadderTimedEvents");
	AddTimer("ChildLadderTimer3", 4.5f, "ChildLadderTimedEvents");
	PlaySoundAtEntity("", "afx_bilge_stinger.snt", "Player", 0.0f, false);
}

void ChildLadderTimedEvents (string &in asTimer)
{
	if (asTimer == "ChildLadderTimer1")
	{
		SetEntityActive("LadderChild", true);
		SetEntityActive("ChildMask", true);
		return;
	}
	else if (asTimer == "ChildLadderTimer2")
	{
		SetEntityActive("LadderChild", false);
		SetEntityActive("ChildMask", false);
		return;
	}
	else if (asTimer == "ChildLadderTimer3")
	{
		PlaySoundAtEntity("", "afx_spooky_child_laugh_semi_distant.snt", "ChildLadderSoundSource", 0.0f, false);
		return;
	}
}
//END LADDER CHILD EVENT//

//DYNAMO HANDLER//
void DynamoHandler (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		string sLocalSmallCogToDespawn = (GetLocalVarString("SmallCogToDespawn"));
		string sLocalLargeCogToDespawn = (GetLocalVarString("LargeCogToDespawn"));
		AddDebugMessage("Dynamo Startup Triggered", false);
		
		//DYNAMO 2 SOUNDSET
		PlaySoundAtEntity("DynamoLoop2", "dynamo_idle_loop_3D_2.snt", "DynamoSource", 3.5f, true);
		PlaySoundAtEntity("Dynamo2D2", "dynamo_idle_2D_2.snt", "DynamoSource", 3.5f, true);
		PlaySoundAtEntity("DynamoStartup2", "dynamo_startup_3D_2.snt", "DynamoSource", 0.0f, true);
		
		//PISTON WHEEL SOUND
		PlaySoundAtEntity("PistonWheel", "factory_piston_wheel2_pers_3D.snt", "PistonWheelSource", 0.0f, true);
		
		PlaySoundAtEntity("Steam022D", "amb_bilge_steam02_3D.snt", "dynamosteamsource", 1.0f, true);
		PlaySoundAtEntity("Steam023D", "amb_bilge_steam02_2D.snt", "dynamosteamsource", 1.0f, true);
		
		//BILGE ENGINE SOUND
		PlaySoundAtEntity("BilgeEngineLoop3", "bilge_engine_loop.snt", "bilge_engine_3_animated", 4.0f, true);
		
		//REMOVE BACK AREA TRIGGERS
		RemoveEntityCollideCallback("Player", "soundopt_enterbackroom_1");
		RemoveEntityCollideCallback("Player", "soundopt_enterbackroom_2");
		RemoveEntityCollideCallback("Player", "soundopt_exitbackroom_1");
		RemoveEntityCollideCallback("Player", "soundopt_exitbackroom_2");
		
		
		//START ANIMATIONS	
		SetMoveObjectState("DynamoGate", 0.65f);
	
		PlayPropAnimation("Dynamo", "loop", 0.0f, true, "");
		PlayPropAnimation("factory_pistons_1", "on", 0.0f, true, "");
		PlayPropAnimation("factory_pistons_2", "on", 0.0f, true, "");
		SetEntityActive("bilge_engine_3_animated", true);
		SetEntityActive("bilge_engine_3_static", false);
		PlayPropAnimation("Sluice1", "gate_opening", 0.0f, false, "");
		
		SetEntityActive("CogsStatic", false);
		SetEntityActive(sLocalSmallCogToDespawn, false);
		SetEntityActive(sLocalLargeCogToDespawn, false);
		SetEntityActive("CogsAnimated", true);

		PlayPropAnimation("CogsAnimated", "animation", 0.0f, true, "");

		SetLocalVarInt("DynamoStarted", 1);
		SetParticleSystemActive("DynamoWheelSteam_*", true);
		SetEntityActive("PostFlushStingerTrigger", true);
		SetPropStaticPhysics("WaterPlaneHigh", false);
		AddTimer("RestoreWaterPhysics", 5.0f, "RestorePhysics");
		SetEntityActive("WaterNoCrouchArea", false);
		
		SetWheelInteractionDisablesStuck("spraylock_valve_outside_1", true);
		AddEntityCollideCallback("Player", "SluiceGateTrigger", "SluiceGateHandler", true, 1);
		AddEntityCollideCallback("Player", "FloodDrainedHintTrigger", "HintHandler", true, 1);
		SetLocalVarInt("SpraylockReady", 0);
		SetLocalVarInt("BreakBridgeButNoLurky", 1);
		
		SetEntityActive("map_bilge_3", true);
		SetEntityActive("map_bilge_2", false);
		SetEntityActive("SignArea_3", true);
		SetEntityActive("SignArea_2", false);
		
		//ENEMY
		SetEntityActive("waterlurker_1", false);
		SetEntityActive("waterlurker_amb_3", true);
		RemoveEntityCollideCallback("Player", "AreaLurkerStart");
		SetEntityActive("AreaFakeLurk_3", true);
		SetEntityActive("AreaFakeLurk_4", true);
		
		//REMOVE SOUNDS
		RemoveTimer("afx_bilgearea2_1");
		RemoveTimer("afx_bilgearea2_2");
		RemoveTimer("afx_bilgearea2_3");
		RemoveTimer("afx_bilgearea2_4");
		RemoveTimer("afx_bilgearea2_5");
		RemoveTimer("afx_bilgearea2_6");
		RemoveTimer("afx_bilgearea2_7");
		RemoveTimer("afx_bilgearea2_8");
		RemoveTimer("InitCryingSoundCues");
		RemoveTimer("CryingSoundCues");
		RemoveTimer("InitMonsterSoundCues");
		RemoveTimer("MonsterSoundCues");
		RemoveTimer("InitScreamSoundCues");
		RemoveTimer("ScreamSoundCues");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_1");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Stop_2");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_1");
		RemoveEntityCollideCallback("Player", "RandSoundArea2_Start_2");
		RemoveTimer("Sound_RandOfficeArea_1");
		RemoveTimer("RandSound_OfficeArea_2"); 
		RemoveTimer("RandSound_OfficeArea_3");
		RemoveTimer("RandSound_OfficeArea_4");
		RemoveTimer("RandSound_OfficeArea_5");
		RemoveTimer("RandSound_OfficeArea_6");
		RemoveTimer("RandSound_OfficeArea_7");
/*		RemoveTimer("Sound_RandGateArea_1"); 
		RemoveTimer("Sound_RandGateArea_2"); 
		RemoveTimer("Sound_RandGateArea_3");
		RemoveTimer("Sound_RandGateArea_4");
		RemoveTimer("Sound_RandGateArea_5");
		RemoveTimer("Sound_RandGateArea_6");
		RemoveTimer("Sound_RandGateArea_7");
		RemoveTimer("Sound_RandGateArea_8");
		RemoveTimer("InitBilgeGateAreaSoundCues");
		RemoveTimer("BilgeGateAreaSoundCues");*/
		RemoveTimer("InitBilgeGateMonsterAreaSoundCues");
		RemoveTimer("BilgeGateMonsterAreaSoundCues");
		RemoveTimer("InitOfficeAreaSoundCues");
		RemoveTimer("OfficeAreaSoundCues");
		RemoveTimer("InitBodyCorridorSoundCues");
		RemoveTimer("BodyCorridorSoundCues");
		RemoveEntityCollideCallback("Player", "StartOfficeSounds_1");
		RemoveEntityCollideCallback("Player", "StopOfficeSounds_1");
		RemoveTimer("AFX_Bilge_Oneshot_1");
		RemoveTimer("AFX_Bilge_Oneshot_2");
		RemoveTimer("AFX_Bilge_Oneshot_3");
		RemoveTimer("AFX_Bilge_Oneshot_4");
		RemoveTimer("AFX_Bilge_Oneshot_5");
		RemoveTimer("AFX_Bilge_Oneshot_6");
		RemoveTimer("AFX_Bilge_Oneshot_7");
		RemoveTimer("AFX_Bilge_Oneshot_8");
		RemoveTimer("AFX_Bilge_Oneshot_9");
		RemoveTimer("AFX_Bilge_Oneshot_10");
		RemoveTimer("AFX_Bilge_Oneshot_11");
		RemoveTimer("AFX_Bilge_Oneshot_12");
		RemoveTimer("AFX_Start_1");
		RemoveTimer("AFX_Start_2");
		RemoveTimer("AFX_Start_3");
		RemoveTimer("StartAreaSoundCues");
		RemoveTimer("InitStartAreaSoundCues");
	}
}


