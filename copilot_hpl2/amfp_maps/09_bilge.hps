// -------------------------------------------------------------
// BREAK BRIDGE
// -------------------------------------------------------------

void CollideBreakBridge(string &in asParent, string &in asChild, int alState)
{
	// ------------------------------
	// SETUP 
	// ---------------------------
	CheckPoint("BreakBridge", "AboveLurkerLadder", "SetLookAtLadder", "", "", false); //boring but to show player ladder location.
	
	//Limit player movement
	SetPlayerRunSpeedMul(0);
	SetPlayerMoveSpeedMul(0.1);
	SetPlayerJumpDisabled(true);
	SetPlayerLookSpeedMul(0.5);
	
	//Remove entities keeping stuff solid
	SetEntityActive("waterlurker_amb_3", false);
	SetEntityActive("AreaDisableEnemy", false);
	SetEntityActive("BridgeBlock_2", true);
	SetEntityActive("BridgeBlock_3", true);
	SetEntityActive("BridgeBlock", false);
	SetEntityActive("BridgeBlock_1", false);
	SetEntityActive("AreaLurkerStart", false);
	SetEntityActive("AreaBridgeLurkerEnd", true);
	AddEntityCollideCallback("Player", "AreaBridgeLurkerEnd", "CollideBridgeLurkerEnd", true, 1);
	
	//Push down on bridge pieces that on bend a bit
	AddPropImpulse("bilge_catwalk_break_1", 0, -1, 0, "World");
	AddPropImpulse("bilge_catwalk_railing_break_1", 0, -1, 0, "World");
	
	//Disable locked on bridge pieces that should fall down
	SetSwingDoorLocked("bilge_catwalk_railing_break_2", false, false);
	SetSwingDoorClosed("bilge_catwalk_railing_break_2", false, false);
	SetSwingDoorDisableAutoClose("bilge_catwalk_railing_break_2", true);
	
	SetSwingDoorLocked("bilge_catwalk_break_2", false, false);
	SetSwingDoorClosed("bilge_catwalk_break_2", false, false);
	SetSwingDoorDisableAutoClose("bilge_catwalk_break_2", true);
	
	//Push bordhe pieces fallign down
	AddTimer("bilge_catwalk_railing_break_2", 0, "TimerPushBridge");
	AddTimer("bilge_catwalk_break_2", 0, "TimerPushBridge");
	
	// ----------------------------
	// BRIDGE BREAK EVENT
	// --------------------------
	StartScreenShake(0.3, 1, 0.05, 0.5);
	FadeImageTrailTo(2, 1);
	PlaySoundAtEntity("bridge_break2", "afx_bilge_catwalk_break.snt", "Player", 0, false);
	PlayGuiSound("afx_event_factory_metal_strain05.ogg", 1);
	
	AddTimer("TimerEventSteps", 0.1, "TimerEventSteps");
	
	// ------------------
	// AFTER EVENT BLOCK
	// ------------------
	
	//Enable a steam burst to block trying to pass this way again
	AddTimer("steam_on", 4, "TimerSteamExplosion");
}								

// -------------------------------------------------------------

void SetLookAtLadder(string &in asName, int alCount)
{
	StartPlayerLookAt("LookAtLadder", 10, 10, "");
	AddTimer("stoplookat", 0.5, "TimerStopLookAtLadder");
}

// -------------------------------------------------------------

void TimerStopLookAtLadder(string &in asTimer)
{
	StopPlayerLookAt();
}

// -------------------------------------------------------------

void TimerEventSteps(string &in asTimer)
{
	AddLocalVarInt("BBEvent", 1);
	SetLocalVarInt("BBEventContinue", 1);
	SetLocalVarFloat("BBEventStepTime", 0.2);
	
	AddDebugMessage("Seq: "+GetLocalVarInt("BBEvent"), false);
	
	switch(GetLocalVarInt("BBEvent"))
	{
		case 1:
			if(GetLocalVarInt("BreakBridgeButNoLurky") != 1) PlayMusic("music_church_threat_sting.ogg", false, 1, 0.5, 10, false);
			StartPlayerLookAt("LookAt_1", 8, 8, "");
		break;
		
		case 2:
			MandusReactionPlayer("Scared", 0);
			FadePlayerRollTo(45, 12, 12);
		break;
		
		case 3:
			StartPlayerLookAt("LookAt_2", 8, 8, "");
		break;
		
		case 4:
			StartPlayerLookAt("LookAt_3", 8, 8, "");
			FadePlayerRollTo(0, 6, 6);
			if(GetLocalVarInt("BreakBridgeButNoLurky") != 1) PlayGuiSound("water_impact_high_2.wav", 1);
			SetLocalVarFloat("BBEventStepTime", 0.6);
		break;
		
		case 5:
			StopPlayerLookAt();
			SetLocalVarFloat("BBEventStepTime", 0.4);
		break;
		
		case 6:
			MandusReactionPlayer("Scared", 0.5);
			SetEntityActive("BridgeBlock_3", false);
			if(GetLocalVarInt("BreakBridgeButNoLurky") != 1) SetEntityActive("WaterLurkerX_1", true);
			if(GetLocalVarInt("BreakBridgeButNoLurky") != 1) AddEntityCollideCallback("Player", "AreaSecondLurker", "CollideSecondLurker", true, 1);
		break;
	
		case 7:
			
			SetPlayerRunSpeedMul(1);
			SetPlayerMoveSpeedMul(1);
			SetPlayerJumpDisabled(false);
			SetPlayerLookSpeedMul(1);
			
			FadeImageTrailTo(0, 0.5f);
			SetLocalVarInt("BBEventContinue", 0);
		break;
	}
	
	if(GetLocalVarInt("BBEventContinue") == 1)
		AddTimer("TimerEventSteps", GetLocalVarFloat("BBEventStepTime"), "TimerEventSteps");
}

// -------------------------------------------------------------

void CollideSecondLurker(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("WaterLurkerX_2", true);
} 

// -------------------------------------------------------------

void CollideBridgeLurkerEnd(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("AreaLurkerStart", true);
	SetEntityActive("AreaBridgeLurkerEnd", false);
	
	SetEntityActive("WaterLurkerX_2", false);
	
	AddTimer("lurkxer", 4, "TimerRemoveLurkerX1");
} 

// -------------------------------------------------------------

void TimerRemoveLurkerX1(string &in asTimer)
{
	SetEntityActive("WaterLurkerX_1", false);
}

// -------------------------------------------------------------

void TimerPushBridge(string &in asTimer)
{
	//Push bridge pieces down to assure they fall
	AddPropForce(asTimer, 0, -1000, 0, "World");
	
	AddLocalVarInt("BridgePushCount", 1);
	
	//Push Player forward and down, then back and down
	if(GetLocalVarInt("BridgePushCount") <= 15)
		AddPlayerBodyForce(0,-2000,-4000, false);
	else if(GetLocalVarInt("BridgePushCount") > 15)
		AddPlayerBodyForce(0,-2000,2000, false);
	
	if(GetLocalVarInt("BridgePushCount") <= 30)
		AddTimer(asTimer, 0.05, "TimerPushBridge");
}

// -------------------------------------------------------------

void TimerSteamExplosion(string &in asTimer)
{
	PlaySoundAtEntity("BlockingSteamSound_1", "afx_enginerooms_controlroomsteamblock.snt", "SoundSteamBlock_1", 0.1, true);
	SetEntityActive("SteamBlock_1", true);
	SetParticleSystemActive("PSSteamBlock_1", true);
	SetParticleSystemActive("PSSteamBlock_2", true);
	SetEntityActive("AreaSteamBlock_1", true);
	AddEntityCollideCallback("Player", "AreaSteamBlock_1", "CollideSteamBlock", false, 0);
}

