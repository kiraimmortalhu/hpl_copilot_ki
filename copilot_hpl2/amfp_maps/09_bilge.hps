void DynamoOnHandler (string &in asParent, string &in asChild, int alState)
{	 
	 AddDebugMessage("DynamoOnHandlerFired", false);
	 PlayPropAnimation("Dynamo_11", "loop", 0.0f, true, "");
	 PlayPropAnimation("Dynamo_12", "loop", 0.0f, true, "");
	 PlayPropAnimation("Dynamo_13", "loop", 0.0f, true, "");
	 PlayPropAnimation("Dynamo_16", "loop", 0.0f, true, "");
	 PlayPropAnimation("Dynamo_15", "loop", 0.0f, true, "");
	 PlayPropAnimation("Dynamo_14", "loop", 0.0f, true, "");
	 PlaySoundAtEntity("DynamoOn", "dynamo_idle_loop_3D.snt", "DynamoSource_21", 0.0f, true);
