//WRETCH 2 HANDLER//
void Wretch2Handler (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("WretchRemovedPermanently") == 0)
	{
		if (asChild == "Wretch2Trigger")
		{
			SetEntityActive("Wretch2", true);
			PlaySoundAtEntity("", "afx_church_factory_bigscream.snt", "Wretch2", 0.0f, false);
			return;
		}
		else if (asChild == "Wretch2TempDespawn" && GetEnemyStateName("Wretch2") == "Patrol")
		{
			ClearEnemyPatrolNodes("Wretch2");
			SetEntityActive("Wretch2", false);

		}
		else if (asChild == "Wretch2LoopTrigger2" && GetEnemyStateName("Wretch2") == "Patrol")
		{
			ClearEnemyPatrolNodes("Wretch2");

		}
	}
}
