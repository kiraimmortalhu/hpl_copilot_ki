//GLASS SMASH HANDLER//
void GlassSmashes (string &in asEntity, string &in asType)
{
	if (asType == "Break")
	{
		PlaySoundAtEntity("", "afx_enginerooms_glasssmash.snt", "GlassSmashSource", 0.0f, false);
		PlaySoundAtEntity("", "afx_enginerooms_glasssmash_steam.snt", "GlassSmashSource", 0.5f, false);
		PlaySoundAtEntity("alarmbell", "afx_enginerooms_alarmbell", "Player", 0.0f, false);
		SetParticleSystemActive("GlassShatter_*", true);
		SetParticleSystemActive("GlassExternalSteam_*", true);
		DestroyParticleSystem("GlassInternalSteam_1");
		DestroyParticleSystem("GlassInternalSteam_8");
		DestroyParticleSystem("GlassInternalSteam_4");
		DestroyParticleSystem("GlassInternalSteam_7");
		SetLocalVarInt("GlassSmashed", 1);
		
		PipePieceHandler("", "NewGlassSmash", 1);
		
		PlaySoundAtEntity("KlaxonHall", "amb_enginerooms_klaxon.snt", "Player", 5.0f, false);

		
		AddEntityCollideCallback("Player", "enterpipes_1", "PipeSoundController", true, 0);
		AddEntityCollideCallback("Player", "enterpipes_2", "PipeSoundController", true, 0);
		
		/////////////////////////////
		// Activate Enemies
		StartPigs();
	}
}

void InteractBreakGlass(string &in asEntity)
{
	PlaySoundAtEntity("hitsound", "impact_glass_window_high.snt", asEntity, 0, false);
	CreateParticleSystemAtEntity("hitpart", "ps_glass_shatter_3.ps", asEntity, false);
	AddLocalVarInt("hit_count", 1);
	
	if(GetLocalVarInt("hit_count") == 1)
		AddTimer("reset_break", 1, "TimerBreakGlass");
		
	if(GetLocalVarInt("hit_count") >= 3)
	{
		SetEntityPlayerInteractCallback(asEntity, "", false);
		SetPropHealth(asEntity, 0);
		PlaySoundAtEntity("hitsound", "impact_glass_window_high.snt", "GlassSmashSource", 0, false);
	}
}

void TimerBreakGlass(string &in asTimer)
