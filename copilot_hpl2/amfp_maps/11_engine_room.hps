//TIMED PIPE STEAM//
void TimedPipeSteam (string &in asTimer)
{
	if (asTimer == "TimedPipeInsertSteam1")
	{
		SetParticleSystemActive("PipeInsertSteam_2", true);
		PlaySoundAtEntity("", "afx_tunnels_steam_burst_pop_02.snt", "PipeInsertSteamSource_2", 0.0f, false);
		return;
	}
	else if (asTimer == "TimedPipeInsertSteam2")
	{
		SetParticleSystemActive("PipeInsertSteam_3", true);
		PlaySoundAtEntity("", "afx_tunnels_steam_burst_pop_03.snt", "PipeInsertSteamSource_3", 0.0f, false);
		return;
	}
	else if (asTimer == "TimedPipeInsertSteam3")
	{
		SetParticleSystemActive("PipeInsertSteam_4", true);
		PlaySoundAtEntity("", "afx_tunnels_steam_burst_pop_01.snt", "PipeInsertSteamSource_4", 0.0f, false);
		return;
	}
	else if (asTimer == "TimedPipeInsertSteam4")
	{
		SetParticleSystemActive("PipeInsertSteam_5", true);
		PlaySoundAtEntity("", "afx_tunnels_steam_burst_pop_04.snt", "PipeInsertSteamSource_5", 0.0f, false);
		PlaySoundAtEntity("", "afx_cellar_steam_loop_2.snt", "PipeInsertCollider", 0.0f, true);
		return;
	}
}
