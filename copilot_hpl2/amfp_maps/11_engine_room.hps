	PlaySoundAtEntity("CrawlPipeSteam2", "amb_engine_rooms_pipe_steam1.snt", "Sound_CrawlPipe_SteamSource_2", 0.0f, true);
	PlaySoundAtEntity("CrawlPipeSteam3", "amb_church_pens_steam_loop_quieter.snt", "Sound_CrawlPipe_SteamSource_3", 0.0f, true);
	PlaySoundAtEntity("CrawlPipeSteam4", "afx_cellar_steam_loop_2.snt", "Sound_CrawlPipe_SteamSource_4", 0.0f, true);
	PlaySoundAtEntity("CrawlPipeSteam5", "amb_engine_rooms_pipe_steam1.snt", "Sound_CrawlPipe_SteamSource_5", 0.0f, true);
