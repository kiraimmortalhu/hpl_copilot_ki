//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
		if (asChild == "AMBStart_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMBStart_1", "amb_engine_rooms_base_drone_start.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBStart_1", 1.0f);
				return;
			}
		}
		if (asChild == "AMBMain")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMBMain", "amb_engine_rooms_base_drone.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBMain", 1.0f);
				return;
			}
		}
			if (asChild == "AMB_Pipes")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Pipes", "amb_sewers_pipe_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Pipes", 1.0f);
				return;
			}
		}
			if (asChild == "AMB_Pipes_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Pipes_1", "amb_sewers_pipe_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Pipes_1", 1.0f);
				return;
			}
		}
			if (asChild == "AMB_Pipes_2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Pipes_2", "amb_sewers_pipe_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Pipes_2", 1.0f);
				return;
			}
		}
			if (asChild == "AMB_Pipes_3")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Pipes_3", "amb_sewers_pipe_loop.snt", "Player", 1.0f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Pipes_3", 1.0f);
				return;
			}
		}
}
