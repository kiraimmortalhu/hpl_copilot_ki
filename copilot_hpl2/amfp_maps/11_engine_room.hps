//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "VOFlashback_1")
	{
		SetEntityActive("cot", true);
		SetEntityActive("cot_1", true);
		SetEntityActive("medical_lamp_1", true);
		
		AddEffectVoice5("vo_engine_flashback_1.ogg", "", "Voice", "vo_engine_flashback_1_mandus_1", 0.0f, "vo_engine_flashback_1_machine_1", 3.2f, "vo_engine_flashback_1_machine_1_2", 10.4f, "vo_engine_flashback_1_machine_1_3", 17.4f, "vo_engine_flashback_1_mandus_2", 23.6f, false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);		
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerLookSpeedMul(0.5f);
		SetEntityActive("pig_mask_*", true);
		StopSound("Alarm3D", 5.0f);
		StopSound("Alarm2D", 5.0f);
		PlaySoundAtEntity("horriblesound", "amb_enginerooms_horrible.snt", "horriblesoundsource", 5.0f, false);
		SetLanternDisabled(true);		
		return;
	}
	
	else if (asChild == "VOFlashback_intro")
	{
		AddEffectVoice3("vo_engine_intro_flashback.ogg", "", "Voice", "vo_engine_intro_flashback", 0.0f, "vo_engine_intro_flashback_1", 8.56f, "vo_engine_intro_flashback_2", 18.0f, false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		return;
	}
	
	
	else if (asChild == "VO_MandusMachine_1")
	{
		AddEffectVoice2("vo_engine_mandus_machine_1.ogg", "", "Voice", "vo_engine_mandus_machine_1_mandus_1", 0.0f, "vo_engine_mandus_machine_1_machine_1", 4.50f, false, "", 0.0f, 0.0f);
		//PlaySoundAtEntity("EngineSoundSource1", "afx_grinding_machine_engine.snt", "EngineSoundSource_1", 1.0f, false);

	}
	
	else if (asChild == "VO_MandusMachine_2")
	{
		AddEffectVoice2("vo_engine_mandus_machine_2.ogg", "", "Voice", "vo_engine_mandus_machine_2_machine_1", 0.0f, "vo_engine_mandus_machine_2_mandus_1", 6.5f, false, "", 0.0f, 0.0f);
	}
	
	else if (asChild == "VO_MandusMachine_3")
	{
		SetEntityActive("LadderArea_4", false);
		RemoveTimer("NextQuakeTimer");
		AddTimer("NextQuakeTimer", 19.0f, "RandQuakes");
		AddEffectVoice3("vo_engine_mandus_machine_3.ogg", "", "Voice", "vo_engine_mandus_machine_3_machine_1", 0.0f ,"vo_engine_mandus_machine_3_mandus_1", 5.0f, "vo_engine_mandus_machine_3_machine_2", 8.0f, false, "", 0.0f, 0.0f);
	}
	else if (asChild == "VO_child_1")
	{
		AddEffectVoice("vo_engine_child_whisper_1.ogg", "", "Voice", "vo_engine_child_1", false, "", 0.0f, 0.0f);
	}
	else if (asChild == "VO_child_2")
	{
		AddEffectVoice("vo_engine_child_whisper_2.ogg", "", "Voice", "vo_engine_child_2", false, "", 0.0f, 0.0f);
	}
	else if (asChild == "VO_child_3")
	{
		AddEffectVoice("vo_engine_child_whisper_3.ogg", "", "Voice", "vo_engine_child_3", false, "", 0.0f, 0.0f);
	}
	else if (asChild == "VO_child_4")
	{
		AddEffectVoice("vo_engine_child_whisper_4.ogg", "", "Voice", "vo_engine_child_4", false, "", 0.0f, 0.0f);
	}
}

