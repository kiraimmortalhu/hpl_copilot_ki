	//ANIMATION STATES//
	{
		PlayPropAnimation("large_fan_3", "on", 0.0f, true, "");
		PlayPropAnimation("Cot", "on", 0.0f, true, "");
		PlayPropAnimation("Cot_1", "on", 0.0f, true, "");
		if (GetLocalVarInt("LeversUsed") == 3)
		{
			PlayPropAnimation("LeverGauge1", "off", 0.0f, true, "");
			PlayPropAnimation("LeverGauge2", "off", 0.0f, true, "");
			PlayPropAnimation("LeverGauge3", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("LeverGauge1", "on", 0.0f, true, "");
			PlayPropAnimation("LeverGauge2", "on", 0.0f, true, "");
			PlayPropAnimation("LeverGauge3", "on", 0.0f, true, "");
		}
	}
	
	//ENTITY STATES//
	{	
		if (GetLocalVarInt("LeversUsed") == 3)
		{
			SetEntityActive("block_box_steam", false);
		}
