//DESTROY FUSE SPARKS//
void DestroyFuseSparks (string &in asTimer)
{
	if (asTimer == "DestroyFuse1SparksTimer")
	{
		DestroyParticleSystem("Fuse1Sparks");
		return;
	}
	else if (asTimer == "DestroyFuse2SparksTimer")
	{
		DestroyParticleSystem("Fuse2Sparks");
		return;
	}
}
//END DESTROY FUSE SPARKS//

//FUSE LEVER HANDLER//
void FuseLeverHandler (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		SetLeverInteractionDisablesStuck("FuseBoxLever", false);
		SetLeverStuckState("FuseBoxLever", -1, false);
		SetEntityActive("block_box_steam", false);
		DestroyParticleSystem("DeadlySteam_1");
		DestroyParticleSystem("DeadlySteam_2");
		DestroyParticleSystem("DeadlySteam_3");
		DestroyParticleSystem("DeadlySteam_4");
		DestroyParticleSystem("DeadlySteam_5");
		DestroyParticleSystem("DeadlySteam_6");
		DestroyParticleSystem("DeadlySteam_7");
		DestroyParticleSystem("MachineSteam_3");
		SetLocalVarInt("BlockingSteamActive", 0);
		StopSound("BlockingSteamSound", 1.0f);
		StopSound("StartMachine2Hum", 0.5f);
		PlaySoundAtEntity("", "afx_factory_quake_base", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_factory_quake_shake", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_factory_quake_creaks", "Player", 0.0f, false);
		AddTimer("QuakeEnd", 2.5f, "QuakeEnd");
		StopSound("EngineRoomUnderDrone", 3.0f);
		StopSound("ControlRoomSource3D", 3.0f);
		StopSound("ControlRoomSource2D", 3.0f);
		AddTimer("VOTimer", 8.0f, "EventTriggeredVO");
		AddTimer("QuakeBuffer", 0.599f, "QuakeBuffer");
		RemoveTimer("SwitchGreenLight");
		SetLampLit("SwitchRedLight", true, false);
		SetLampLit("SwitchGreenLight", false, false);
		RemoveEntityCollideCallback("Player", "SteamCoughingTrigger");
		
		//Final hizz from Steam as pressure shuts down
		CreateParticleSystemAtEntity("burst", "ps_steam_deadly_looping.ps", "FuseBoxLever_PS", false);
		PlaySoundAtEntity("SteamRelease1", "afx_tunnels_steam_burst_pop_03.snt", "FuseBoxLever", 0.0f, false);
		PlaySoundAtEntity("SteamRelease2", "afx_tunnels_steam_burst_stream_02.snt", "FuseBoxLever", 0.0f, false);
		StopSound("ControlRunning_4", 1);
	
		TurnOffHallLights();
		
		AddTimer("flick_passage", 1, "TimerFlickPassageLight");
		
		AddTimer("burst", 2, "TimerTurnOffPS");
	}
}

void QuakeBuffer (string &in asTimer)
{
	StartScreenShake (0.15f, 1.5f, 0.5f, 0.968f);
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerRunSpeedMul(0.0f);
	SetMoveObjectState("Gate1", 0);
	MandusReactionPlayer("Quick", 0.5f);
}

void QuakeEnd (string &in asTimer)
{
	PlaySoundAtEntity("Alarm3D", "amb_engineroom_alarmbell_3D", "AAlarmSource", 1.0f, false);
	PlaySoundAtEntity("Alarm2D", "amb_engineroom_alarmbell_2D", "AAlarmSource", 1.0f, false);
	PlaySoundAtEntity("wheelsound_1", "factory_piston_wheel2_pers_3D_ld", "wheelsound_1", 1.0f, false);
	PlaySoundAtEntity("wheelsound_12D", "factory_piston_wheel2_pers_2D", "wheelsound_1", 1.0f, false);
	PlaySoundAtEntity("wheelsound_2", "factory_piston_wheel2_pers_3D_2_ld", "wheelsound_2", 1.0f, false);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
	MandusReactionPlayer("Breath", 1.0f);
}

void TimerTurnOffPS(string &in asTimer)
{
	DestroyParticleSystem(asTimer);
}

bool bLitHall = true;
void TimerFlickPassageLight(string &in asTimer)
{
	bLitHall = bLitHall == false ? true : false;
	
	SetLampLit("tesla_lamp_1", bLitHall, true);
	AddTimer("flick_passage", 0.9, "TimerFlickPassageLight");
}

///////////////////////
// TURNS OFF LIGHT AND SETS UP LEVEL AMB AFTER FINISHING CONTROL ROOM PUZZLE
void TurnOffHallLights()
{
	for(int i=1;i<=4;i++)FadeLightTo("HallLight_"+i, 0,0,0,0,-1,3);
	
	FadeLightTo("SpotLight_57", 0,0,0,0,-1,3);
	
	RotatePropToSpeed("wheel_1", 1, 4/4, 1,0,0, false, "");
	RotatePropToSpeed("wheel_2", 1, 6/4, -1,0,0, false, "");
	RotatePropToSpeed("wheel_3", 1, 10/4, 1,0,0, false, "");
	RotatePropToSpeed("wheel_4", 1, 16/4, -1,0,0, false, "");
	RotatePropToSpeed("wheel_5", 1, 4/4, 1,0,0, false, "");
	RotatePropToSpeed("wheel_6", 1, 6/4, -1,0,0, false, "");
	RotatePropToSpeed("wheel_7", 1, 10/4, 1,0,0, false, "");
	RotatePropToSpeed("wheel_8", 1, 16/4, -1,0,0, false, "");
}
//END FUSE LEVER HANDLER//

//MASK CORRIDOR HANDLER//
void MaskCorridorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "MaskCorridorTrigger")
	{
		FadeSepiaColorTo(0.75f, 0.7f);
		FadeImageTrailTo(3.0f, 0.7f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		SetJournalDisabled(true);
		SetPlayerJumpDisabled(true);
		SetPlayerCrouchDisabled(true);
		RemoveTimer("ReturnToNormal");
		//PlayMusic("afx_zither_4_louder.ogg", false, 0.85f, 0.0f, 45, false);
		AddDebugMessage("Corridor Active", false);
		
		AddTimer("auto", 10, "TimerAutoContinue");
		return;
	}
	else if (asChild == "MaskCorridorStopTrigger")
	{
		RemoveTimer("auto");
		SetPlayerMoveSpeedMul(0.25f);
		SetPlayerLookSpeedMul(0.25f);
		PlaySoundAtEntity("", "00_intro_hightone.snt", "Player", 0.0f, false);
		AddTimer("WhiteFlash", 8.0f, "WeirdSequence");
		AddTimer("GetUp", 18.5f, "WeirdSequence");
		AddTimer("ReturntoNormal1", 20, "WeirdSequence");
		AddTimer("ReturntoNormal2", 21, "WeirdSequence");
		AddTimer("ReturntoNormal3", 22, "WeirdSequence");
		AddTimer("ReturntoNormal4", 24, "WeirdSequence");

		MandusReactionPlayer("Breath", 4);
		MandusReactionPlayer("Breath", 6);
		MandusReactionPlayer("Breath", 8);
		
		//SET CHECKPOINT #2//
		CheckPoint("CP02_MainRoom", "CheckpointStart_1", "DeathHandler", "", "", true);
		return;
	}
}

void TimerAutoContinue(string &in asTimer)
{
	MaskCorridorHandler ("Player", "MaskCorridorStopTrigger", 1);
}

//END MASK CORRIDOR HANDLER//

//WEIRD FLASHBACK SEQUENCE//
void WeirdSequence (string &in asTimer)
{	
	//DO FLASH AND FALL OVER//
	if (asTimer == "WhiteFlash")
	{
		PlaySoundAtEntity("", "afx_enginerooms_stinger.snt", "Player", 0.0f, false);
		
		//CREATE STEAM SOUND FOR PIPE
		PlaySoundAtEntity("steambigpipe_soundsource2D", "amb_enginerooms_steam_frompipe_2D.snt", "steambigpipe_soundsource", 0.0f, false);
		PlaySoundAtEntity("steambigpipe_soundsource3D", "amb_enginerooms_steam_frompipe_3D.snt", "steambigpipe_soundsource", 0.0f, false);
		AddTimer("WhiteFlashWhoosh", 1.2f, "WeirdSequence");
		return;
	}
	
	//WHITE OUT
	if (asTimer == "WhiteFlashWhoosh")
	{
		AddTimer("FadebackfromBlack", 6.5f, "WeirdSequence");
		SetPlayerLookSpeedMul(0.1f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerCrouching(true);
		SetPlayerActive(false);
		FadePlayerPitchTo(-60.0f, 40.0f, 40.0f);
		FadePlayerRollTo(-50.0f, 40.0f, 40.0f);
		StopSound("horriblesound", 3.0f);
		StartEffectFlash(3.68f, 6.82f, 1.0f);
		FadeGlobalSoundVolume(0, 5);
		return;
	}
	
	//DO FADE IN FROM BLACK//
	else if (asTimer == "FadebackfromBlack")
	{
		SetEntityActive("cot", false);
		SetEntityActive("cot_1", false);
		SetEntityActive("pig_mask_*", false);
		SetEntityActive("medical_lamp_1", false);
		SetEntityActive("CotNote", true); //TODO: CHECK SPAWNING
		TeleportPlayer("PostCotStart");
		SetEntityActive("xengineer_wakeup", true);
		AddEnemyPatrolNode("xengineer_wakeup", "PathNodeArea_27", 0, "", false);
		AddEntityCollideCallback("xengineer_wakeup", "AreaRemoveWakeUpCall", "CollideRemoveEngineerWakeup", true, 1);
		StartPlayerLookAt("LookAtWheel", 4, 4, "");
		AddTimer("StopLook", 1, "WeirdSequence");
		SetMoveObjectState("PostCotGate", 0);
		SetLocalVarInt("MaskCorridorSequenceComplete", 1);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		FadeIn(4.5f);
		StopMusic(5.0f, 45);
		FadeGlobalSoundVolume(1, 5);
		SetPlayerActive(true);
		return;
	}
	
	else if (asTimer == "StopLook")
	{
		StopPlayerLookAt();
	}
	//GET UP FROM FLOOR//
	else if (asTimer == "GetUp")
	{
		FadePlayerPitchTo(0.0f, 3.0f, 7.0f);
		FadePlayerRollTo(0.0f, 3.0f, 7.0f);
		return;
	}
	
	//DO RETURN TO NORMAL VISION//
	else if (asTimer == "ReturntoNormal1")
	{
		FadeImageTrailTo(0.0f, 0.5);
		FadeSepiaColorTo(0.0f, 0.5);
		SetPlayerMoveSpeedMul(0.2f);
		SetPlayerLookSpeedMul(0.2f);
		SetPlayerRunSpeedMul(0.2f);	
	}
	else if (asTimer == "ReturntoNormal2")
	{
		SetPlayerMoveSpeedMul(0.4f);
		SetPlayerLookSpeedMul(0.4f);
		SetPlayerRunSpeedMul(0.4f);	
	}
	else if (asTimer == "ReturntoNormal3")
	{
		SetPlayerMoveSpeedMul(0.6f);
		SetPlayerLookSpeedMul(0.6f);
		SetPlayerRunSpeedMul(0.6f);	
	}
	else if (asTimer == "ReturntoNormal4")
	{
		SetJournalDisabled(false);
		SetPlayerJumpDisabled(false);
		SetPlayerCrouchDisabled(false);
		SetLanternDisabled(false);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);	
		return;
	}
}

void CollideRemoveEngineerWakeup(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("xengineer_wakeup", false);
}
//END FLASHBACK SEQUENCE//

