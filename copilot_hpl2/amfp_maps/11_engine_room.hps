//FUSE REMOVAL HANDLER//
void FuseRemovalHandler (string &in asParent, string &in asChild, int alState)
{
	if (asParent == "Fuse1")
	{
		PlaySoundAtEntity("", "afx_cellar_smallmachine_spark.snt", "Fuse1Collider", 0.0f, false);
		PlaySoundAtEntity("", "afx_cellar_valvepop_slapback", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_cellar_valvepop", "Fuse1Collider", 0.0f, false);
		PlaySoundAtEntity("Boom1", "afx_pigline_explosion_02", "Player", 0.0f, false);
		StartScreenShake(0.075f, 1.0f, 0.01f, 0.3f);
		AddLocalVarInt("FusesRemoved", 1);
		SetParticleSystemActive("Fuse1Sparks", true);
		RemoveEntityCollideCallback("Fuse1", "Fuse1Collider");
		SetLampLit("Fuse1GreenLight", false, false);
		SetLampLit("Fuse1RedLight", true, false);
		AddTimer("DestroyFuse1SparksTimer", 2.5f, "DestroyFuseSparks");
		AddTimer("MoveSpeedNormal", 2.5f, "MoveSpeedNormal");
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.75f);
		SetPlayerRunSpeedMul(0.5f);
		
		DestroyParticleSystem("MachineSteam_1");
		DestroyParticleSystem("PipeSteam_2");
		SetLampFlickerActive("light_2_3_on", true);
		SetLampFlickerActive("light_2_1_on", true);
		SetLampFlickerActive("Light_1_1_on", true);
		
		/**RotatePropToSpeed("wheel_1", 1, 4/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_2", 1, 6/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_3", 1, 10/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_4", 1, 16/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_5", 1, 4/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_6", 1, 6/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_7", 1, 10/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_8", 1, 16/1.25, -1,0,0, false, "");**/
	}
	else if (asParent == "Fuse2")
	{
		PlaySoundAtEntity("", "afx_cellar_smallmachine_spark.snt", "Fuse2Collider", 0.0f, false);
		PlaySoundAtEntity("", "afx_cellar_valvepop_slapback", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_cellar_valvepop", "Fuse1Collider", 0.0f, false);
		PlaySoundAtEntity("Boom1", "afx_pigline_explosion_01", "Player", 0.0f, false);
		StartScreenShake(0.075f, 1.0f, 0.01f, 0.3f);
		AddLocalVarInt("FusesRemoved", 1);
		SetParticleSystemActive("Fuse2Sparks", true);
		RemoveEntityCollideCallback("Fuse2", "Fuse2Collider");
		SetLampLit("Fuse2GreenLight", false, false);
		SetLampLit("Fuse2RedLight", true, false);
		AddTimer("DestroyFuse2SparksTimer", 2.5f, "DestroyFuseSparks");
		AddTimer("MoveSpeedNormal", 2.5f, "MoveSpeedNormal");
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.75f);
		SetPlayerRunSpeedMul(0.5f);
		
		DestroyParticleSystem("MachineSteam_2");
		DestroyParticleSystem("PipeSteam_1");
		DestroyParticleSystem("PipeSteam_3");
		SetLampFlickerActive("light_2_2_on", true);
		SetLampFlickerActive("Light_1_2_on", true);
		SetLampFlickerActive("Bank6_Light_2", true);
		
		/**RotatePropToSpeed("wheel_1", 1, 4/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_2", 1, 6/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_3", 1, 10/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_4", 1, 16/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_5", 1, 4/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_6", 1, 6/1.25, -1,0,0, false, "");
		RotatePropToSpeed("wheel_7", 1, 10/1.25, 1,0,0, false, "");
		RotatePropToSpeed("wheel_8", 1, 16/1.25, -1,0,0, false, "");**/
		
	}
	if (GetLocalVarInt("FusesRemoved") == 1)
	{
		return;
	}
	else if (GetLocalVarInt("FusesRemoved") == 2)
	{
		SetMoveObjectState("FuseBoxGlass", 1);
		SetLeverInteractionDisablesStuck("FuseBoxLever", true);
		PlaySoundAtEntity("StartMachine2Hum", "afx_cellar_hum_loop.snt", "StartMachine2Source", 0.0f, false);
		StopSound("StartMachineLoop", 0.5f);
		
		SetEntityActive("light_1_1_on", false);
		SetEntityActive("light_1_1_off", true);
		SetEntityActive("light_1_2_on", false);
		SetEntityActive("light_1_2_off", true);
		SetEntityActive("light_2_1_on", false);
		SetEntityActive("light_2_1_off", true);
		SetEntityActive("light_2_2_on", false);
		SetEntityActive("light_2_2_off", true);
		SetEntityActive("light_2_3_on", false);
		SetEntityActive("light_2_3_off", true);
		
		StopSound("ControlRunning_1", 0.5);
		StopSound("ControlRunning_2", 0.5);
		StopSound("ControlRunning_3", 0.5);
		
		SetLampLit("Bank6_Light_2" ,false, true);
		SetLampLit("Bank6_Light_1" ,true, true);
		SetLampLit("Bank6_Light_3" ,true, true);
		
		/**RotatePropToSpeed("wheel_1", 1, 4/1.5, 1,0,0, false, "");
		RotatePropToSpeed("wheel_2", 1, 6/1.5, -1,0,0, false, "");
		RotatePropToSpeed("wheel_3", 1, 10/1.5, 1,0,0, false, "");
		RotatePropToSpeed("wheel_4", 1, 16/1.5, -1,0,0, false, "");
		RotatePropToSpeed("wheel_5", 1, 4/1.5, 1,0,0, false, "");
		RotatePropToSpeed("wheel_6", 1, 6/1.5, -1,0,0, false, "");
		RotatePropToSpeed("wheel_7", 1, 10/1.5, 1,0,0, false, "");
		RotatePropToSpeed("wheel_8", 1, 16/1.5, -1,0,0, false, "");**/
		
		AddTimer("SwitchGreenLight", 0, "TimerFlickLastSwitch");
	}
}
bool bLit = true;
void TimerFlickLastSwitch(string &in asTimer)
{
	bLit = bLit == false ? true : false;
	
	SetLampLit("SwitchGreenLight", bLit, false);
	
	if(bLit) PlaySoundAtEntity("beep", "afx_switch_light_on.snt", asTimer, 0, false);
		
	AddTimer("SwitchGreenLight", 0.5, "TimerFlickLastSwitch");
}

