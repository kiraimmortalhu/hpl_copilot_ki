//-----------------------------------

void HandlePlayerOutOfPigReach (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("GlassSmashed") == 0) return;
	
	SetEnemyDisableTriggers("engineer_*", alState==1);
	
	if (alState == 1)
	{
		//If enemies are unaware of the player's presence, skip the next part.
		string sState1 = GetEnemyStateName("engineer_1");
		string sState2 = GetEnemyStateName("engineer_2");
		string sState3 = GetEnemyStateName("engineer_3");
		bool bEnemiesIdle = (sState1 == "Wait" || sState1 == "Patrol") && 
							(sState2 == "Wait" || sState2 == "Patrol") && 
							(sState3 == "Wait" || sState3 == "Patrol");
							
		if (bEnemiesIdle) return;
		//
		
		SetEntityActive("PigTurnToPlayerArea_*", true);
		
		ClearEnemyPatrolNodes("engineer_*");
		ForceEnemyWaitState("engineer_*");
		
		if (GetEntitiesCollide("engineer_1", "PigTurnToPlayerArea_1"))
		{
			TurnPigToPlayer("engineer_1", "", 1);
		}
		else
		{
			AddEnemyPatrolNode("engineer_1", "PathNodeArea_41", 0, "", false);	
		}
		
		if (GetEntitiesCollide("engineer_2", "PigTurnToPlayerArea_2"))
		{
			TurnPigToPlayer("engineer_2", "", 1);
		}
		else
		{
			AddEnemyPatrolNode("engineer_2", "PathNodeArea_151", 0, "", false);
		}
		
		if (GetEntitiesCollide("engineer_3", "PigTurnToPlayerArea_3"))
		{
			TurnPigToPlayer("engineer_3", "", 1);
		}
		else
		{
			AddEnemyPatrolNode("engineer_3", "PathNodeArea_111", 0, "", false);
		}
	}
	else
	{
		SetEntityActive("PigTurnToPlayerArea_*", false);
		
		RemoveTimer("engineer_1");
		RemoveTimer("engineer_2");
		RemoveTimer("engineer_3");
		
		AddEnemyPatrolNode("engineer_1", "PathNodeArea_61", 0, "", false);
		AddEnemyPatrolNode("engineer_1", "PathNodeArea_98", 0, "", false);
		AddEnemyPatrolNode("engineer_1", "PathNodeArea_139", 0, "", false);
		AddEnemyPatrolNode("engineer_1", "PathNodeArea_63", 0, "", false);
		AddEnemyPatrolNode("engineer_1", "PathNodeArea_103", 0, "", false);

		AddEnemyPatrolNode("engineer_2", "PathNodeArea_158", 0, "", false);
		AddEnemyPatrolNode("engineer_2", "PathNodeArea_165", 0, "", false);
		AddEnemyPatrolNode("engineer_2", "PathNodeArea_70", 0, "", false);

		AddEnemyPatrolNode("engineer_3", "PathNodeArea_29", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_109", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_29", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_30", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_90", 0, "", false);
	
		ShowEnemyPlayerPosition("engineer_*");
		
		ChangePlayerStateToNormal();
	}
}

//-----------------------------------

void TurnPigToPlayer (string &in asParent, string &in asChild, int alState)
{
	// Hackish way of making enemies turn towards player.
	ClearEnemyPatrolNodes(asParent);
	SetEnemyDisableTriggers(asParent, false);
	ShowEnemyPlayerPosition(asParent);
	AddTimer(asParent, 0.05f, "TurnPigToPlayerTimer");
}

//-----------------------------------

void TurnPigToPlayerTimer(string &in asTimer)
{
	SetEnemyDisableTriggers(asTimer, true);
	ForceEnemyWaitState(asTimer);
}

//-----------------------------------

void ShowPigPlayer (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Showing pigs player: "+alState, false);
	AddTimer("", 5, "TimerEnableStopChase");
	
//	if(alState == 1)
		AddTimer("ShowPigPlayerLoop", 0, "ShowPigPlayerLoop");
//	else
//		RemoveTimer("ShowPigPlayerLoop");
}

