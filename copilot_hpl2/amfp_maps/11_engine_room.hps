//RANDOMISED SOUND CUE PLAYER//
void RandomMachineSoundTimerEvent (string &in asParent, string &in asChild, int alState)
{
	AddTimer("InitRandomMachineSoundCuePlayer", 1.0f, "RandMachineSoundCues");
	SetLocalVarInt("RandomSoundCuesActive", 1);
	AddDebugMessage("Random Sound Cue Function Timer..BEGIN!", false);
}

void RandMachineSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "amb_engine_rooms_machine_oneshot.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Dron2 Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(60.0f, 90.0f), "RandMachineSoundCues");
}

void RandStartDebrisSoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandSoundDebrisSmall_1", "RandSoundDebrisSmall_2", "RandSoundDebrisSmall_3", "RandSoundDebrisSmall_4", "RandSoundDebrisSmall_5", 
							"RandSoundDebrisSmall_6", "RandSoundDebrisSmall_7", "RandSoundDebrisSmall_8", "RandSoundDebrisSmall_9", "RandSoundDebrisSmall_10"};
	asTimer = sCueSources[RandInt(0, 9)];
	PlaySoundAtEntity(asTimer, "afx_events_tunnels_dust_debris.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Random DUST Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(5.0f, 10.0f), "RandStartDebrisSoundCues");
}

void RandStartArea1SoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandSoundStartArea1_1", "RandSoundStartArea1_2", "RandSoundStartArea1_3", "RandSoundStartArea1_4", "RandSoundStartArea1_5", 
							"RandSoundStartArea1_6", "RandSoundStartArea1_7", "RandSoundStartArea1_8", "RandSoundStartArea1_9"};
	asTimer = sCueSources[RandInt(0, 8)];
	PlaySoundAtEntity(asTimer, "afx_spooky_eerie_monster_type2_louder.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Random Start Area Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 18.0f), "RandStartArea1SoundCues");
}

void RandStartArea2SoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandSoundStartArea2_1", "RandSoundStartArea2_2", "RandSoundStartArea2_3", "RandSoundStartArea2_4", "RandSoundStartArea2_5", 
							"RandSoundStartArea2_6", "RandSoundStartArea2_7"};
	asTimer = sCueSources[RandInt(0, 8)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hifrequencymoan.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Random Start Area Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 18.0f), "RandStartArea2SoundCues");
}
//END RANDOMISED SOUND CUE PLAYER//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("React_Scared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("React_Breath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("React_Quick", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

