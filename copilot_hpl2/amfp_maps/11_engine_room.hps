		{
			SetEntityActive("medical_lamp_1", false);
			SetEntityActive("cot", false);
			SetEntityActive("cot_1", false);
		}
		if (GetLocalVarInt("MaskCorridorSequenceComplete") == 1)
		{
			SetMoveObjectState("PostCotGate", 0);
		}
		else
		{
			SetMoveObjectState("PostCotGate", 1);
		}
		if (GetLocalVarInt("VanishingDoorTransition") == 1)
		{
			SetEntityActive("DoorPiece", false);
			SetEntityActive("VanishingDoor", false);
			SetEntityActive("WallPiece", true);
		}
	}
	
	//ENTITY INTERACTION//
	{
		SetEntityInteractionDisabled("pig_mask_*", true);
	}
	
}

void OnLeave()
{
	SetupLoadScreen("LoadingText", "Streets_", 3, "game_loading_streets.jpg");
}

										//////////////////////////
										//MAP-SPECIFIC FUNCTIONS//
										//////////////////////////
										
//LEVEL LOAD SEQUENCE//
void InitSequence(string &in asTimer)
{
	if (asTimer == "StartFX")
	{
		AddTimer("InitSplitTimer", 0.5f, "InitSequence");
		FadeImageTrailTo(0.75f, 2.0f);
		FadeGlobalSoundVolume(1,0.5);
	}
	else if (asTimer == "InitSplitTimer")
	{
		FadeIn(6.0f);
		SetPlayerActive(true);
		AddEffectVoice("vo_engine_weird.ogg", "", "Voice", "vo_engine_weird", false, "", 0.0f, 0.0f);
		//PlaySoundAtEntity("WeirdLoop", "music_tesla02_reveal_short.snt", "Player", 3.0f, false);		
		StartPlayerLookAt("StartSequenceLookTarget2", 1.0f, 1.0f, "");
		FadePlayerRollTo(-10.0f, 5.0f, 5.0f);
		AddTimer("InitRestoreControlTimer", 5.0f, "InitSequence");
		AddTimer("InitStopLookAtTimer", 3.0f, "InitSequence");
	}
	else if (asTimer == "InitStopLookAtTimer")
	{
		SetLanternDisabled(false);
		StopPlayerLookAt();
	}
	else if (asTimer == "InitRestoreControlTimer")
	{	
		AddDebugMessage("INIT STEP 3", false);
		SetPlayerCrouchDisabled(false);
		ShowPlayerCrossHairIcons(true);
		SetEntityActive("InitStart", false);
		SetLocalVarInt("IntroHasFinished", 1);
		FadeImageTrailTo(1.1f, 0.75f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerLookSpeedMul(0.5f);
		SetLocalVarInt("RandomHeadRoll", 1);
		//RandomHeadRollLoop("VoidTimer");
		FadePlayerRollTo(0, 1.0f, 1.0f);
	}
}
//END LEVEL LOAD SEQUENCE//

//RANDOM HEAD ROLL//
bool gbRoll = true;
void RandomHeadRollLoop(string &in asTimer)
{
	int lLook = RandInt(1, 4);
	int lFOVChange = GetLocalVarInt("CanChangeFOVRandomly");
	AddDebugMessage("Random Head Roll Loop Active", false);
	AddDebugMessage("lLook = "+lLook, false);
	AddDebugMessage("lFOVChange = "+lFOVChange, false);
	
	if (GetLocalVarInt("RandomHeadRoll") == 1)
	{
		
		if (GetLocalVarInt("HeadRollState") == 0)
		{
			SetLocalVarInt("HeadRollState", 1);
			
			if (lFOVChange == 1)
			{
				FadePlayerFOVMulTo(RandFloat(0.7f, 1.3f), RandFloat(0.05f, 0.1f));
			}
			gbRoll = gbRoll == false ? true : false;
			AddDebugMessage("gbRoll = "+gbRoll, false);
			if(gbRoll)
			{
				FadePlayerRollTo(RandFloat(30.0f,65.0f), RandFloat(15.6f, 15.9f), RandFloat(0.9f, 1.15f)); 
			}
			else
			{
				FadePlayerRollTo(RandFloat(-30.0f, -60.0f), RandFloat(19.5f, 19.8f), RandFloat(0.9f, 1.1f)); 
			}
			AddTimer("RandomHeadRollLoopTimer", RandFloat(4.0f, 8.0f), "RandomHeadRollLoop");
			return;
		}
		
		else if(lLook == 1)
		{
			AddTimer("RandomHeadRollLoopTimer", RandFloat(4.0f, 8.0f), "RandomHeadRollLoop");
			return;
		}
		
		else
		{
			SetLocalVarInt("HeadRollState", 0);
			
			FadePlayerRollTo(0, 4.5f, 1); 
			if (lFOVChange == 1)
			{			
				FadePlayerFOVMulTo(1.0f, 1.0f);
			}
			FadeImageTrailTo(0.0f ,1.5f);
			AddTimer("RandomHeadRollLoopTimer", RandFloat(5.0f,7.0f), "RandomHeadRollLoop");
			return;
		}
	}
	if (GetLocalVarInt("RandomHeadRoll") == 0)
	{
		AddDebugMessage("HeadRoll Effect End Block Activated Successfully", false);
		FadePlayerRollTo(0, 0.5f, 1);
		FadeImageTrailTo(0, 1);
		SetPlayerJumpDisabled(false);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
	}
}	

//DOOR VANISH HANDLER//
void DoorVanishHandler (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("VanishOk") == 1)
	{
		SetEntityActive("DoorPiece", false);
		SetEntityActive("VanishingDoor", false);
		SetEntityActive("WallPieced", true);
		SetLocalVarInt("VanishingDoorTransition", 1);
		RemoveEntityCollideCallback("Player", "DoorVanishTrigger");
	}
}

void DoorVanishLookTracker (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("VanishOk", 1);
		return;
	}
	else if (alState == -1)
	{
		SetLocalVarInt("VanishOk", 0);
		return;
	}
}
//END DOOR VANISH HANDLER//

