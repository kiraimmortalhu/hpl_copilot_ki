//PIPE SOUND CONTROLLER
void PipeSoundController(string &in asParent, string &in asChild, int alState)
{
	//Enter Pipes
	if (asChild == "enterpipes_1"|| asChild == "enterpipes_2")
	{
	//STOP SOUNDS
	RemoveTimer("RandQuakes");
	RemoveTimer("NextQuakeTimer");
	RemoveTimer("RandBangSounds");
	StopSound("KlaxonHall", 4.0f);
	PlaySoundAtEntity("KlaxonPipe", "amb_enginerooms_klaxon_pipe.snt", "Player", 3.0f, false);
	
	//START PIPE SOUNDS
	AddTimer("RandPipeQuakes", RandFloat(5.5f, 7.0f), "RandPipeQuakes");
	AddDebugMessage("Enter Pipe Triggered", false);
	
	//TRIGGER CONTROLLER
	AddEntityCollideCallback("Player", "exitpipes_1", "PipeSoundController", true, 0);
	AddEntityCollideCallback("Player", "exitpipes_2", "PipeSoundController", true, 0);
	RemoveEntityCollideCallback("Player", "enterpipes_1");
	RemoveEntityCollideCallback("Player", "enterpipes_2");
	return;
	}
	
	//Exit Pipes
	else if (asChild == "exitpipes_1"||asChild == "exitpipes_2")
	{
	//STOP SOUNDS
	RemoveTimer("RandPipeQuakes");
	
	//START SOUNDS
	AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
	AddDebugMessage("Exit Pipe Triggered", false);
	StopSound("KlaxonPipe", 2.5f);
	PlaySoundAtEntity("KlaxonHall", "amb_enginerooms_klaxon.snt", "Player", 2.5f, false);
	
	//TRIGGER CONTROLLER
	AddEntityCollideCallback("Player", "enterpipes_1", "PipeSoundController", true, 0);
	AddEntityCollideCallback("Player", "enterpipes_2", "PipeSoundController", true, 0);
	RemoveEntityCollideCallback("Player", "exitpipes_1");
	RemoveEntityCollideCallback("Player", "exitpipes_2");
	return;
	}
}
//END PIPE SOUND CONTROLLER
									
//RANDOM QUAKES//
void RandQuakes(string &in asTimer)
{
	AddTimer("PlayerSlowDownQuake", 0.6f, "QuakePlayerSpeedControl");
	RemoveTimer("BangLoop");
	SetLocalVarInt("BangCount", 0);
	int Randomiser = RandInt(1, 3);
	int Randomiser2 = RandInt(1, 4);
	int ParticleRandomiser = RandInt(1, 3);
	switch (Randomiser)
	{
		case 1:
			PlaySoundAtEntity("", "afx_enginerooms_tremor", "Player", 0.0f, false);
			AddDebugMessage("TREMOR 1", false);
			break;
		
		case 2:
			PlaySoundAtEntity("", "afx_enginerooms_tremor", "Player", 0.0f, false);
			AddDebugMessage("TREMOR 2", false);
			break;
		
		case 3:
			PlaySoundAtEntity("", "afx_enginerooms_tremor", "Player", 0.0f, false);
			Randomiser2 = 4;
			AddDebugMessage("TREMOR 3", false);
	}
	if (Randomiser2 != 4)
	{
		SetLocalVarInt("BangCount", RandInt(4, 7));
		AddTimer("InitBangs", 1.2f, "RandBangSounds");
		AddDebugMessage("BANG LOOP INITIALISED", false);
	}
	
	if(GetLocalVarInt("SteamCount") < 12)
	{
		AddLocalVarInt("SteamCount", 1);
		CreateParticleSystemAtEntity("pst_"+GetLocalVarInt("SteamCount"), "ps_steam_deadly_looping_less.ps", "pst_"+GetLocalVarInt("SteamCount"), true);
		AddLocalVarInt("SteamCount", 1);
		CreateParticleSystemAtEntity("pst_"+GetLocalVarInt("SteamCount"), "ps_steam_deadly_looping_less.ps", "pst_"+GetLocalVarInt("SteamCount"), true);
	} 
	
	AddTimer("NextQuakeTimer", RandFloat(GetLocalVarFloat("QuakeMinTime"), GetLocalVarFloat("QuakeMaxTime")), "RandQuakes");
}

void RandBangSounds (string &in asTimer)
{
	SetLocalVarInt("RandomSoundSource", RandInt(1, 8));
	int SoundSelector = RandInt(1, 6);
	if (SoundSelector == 1)
	{
		PlaySoundAtEntity("", "afx_enginerooms_bang.snt", "BangSoundSource_"+GetLocalVarInt("RandomSoundSource"), 0.0f, false);
		AddDebugMessage("SOUND SELECTION = 1", false);
	}
	else if (SoundSelector == 2)
	{
		PlaySoundAtEntity("", "afx_enginerooms_bang.snt", "BangSoundSource_"+GetLocalVarInt("RandomSoundSource"), 0.0f, false);
		AddDebugMessage("SOUND SELECTION = 2", false);
	}
	else if (SoundSelector == 3)
	{
		PlaySoundAtEntity("", "afx_enginerooms_bang.snt", "BangSoundSource_"+GetLocalVarInt("RandomSoundSource"), 0.0f, false);
		AddDebugMessage("SOUND SELECTION = 3", false);
	}
	else if (SoundSelector == 4)
	{
		AddDebugMessage("SOUND SELECTION = 4", false);
	}
	else if (SoundSelector == 5)
	{
		PlaySoundAtEntity("", "afx_enginerooms_bang.snt", "BangSoundSource_"+GetLocalVarInt("RandomSoundSource"), 0.0f, false);
		AddDebugMessage("SOUND SELECTION = 5", false);
	}
	else if (SoundSelector == 6)
	{
		PlaySoundAtEntity("", "afx_enginerooms_bang.snt", "BangSoundSource_"+GetLocalVarInt("RandomSoundSource"), 0.0f, false);
		AddDebugMessage("SOUND SELECTION = 6", false);
	}
	if (GetLocalVarInt("BangCount") > 0)
	{
		AddTimer("BangLoop", RandFloat(0.25f, 1.5f), "RandBangSounds");
		AddLocalVarInt("BangCount", -1);
		AddDebugMessage("BANG LOOP CONTINUED. COUNT IS "+GetLocalVarInt("BangCount"), false);
	}
	else
	{
		AddDebugMessage("BANG COUNT ENDED", false);
	}
}

void RandPipeQuakes(string &in asTimer)
{
	AddTimer("PlayerSlowDownQuakePipe", 0.2f, "QuakePlayerSpeedControl");
	AddTimer("RandPipeQuakes", RandFloat(6.0f, 10.0f), "RandPipeQuakes");
	PlaySoundAtEntity("", "afx_engineroom_pipetremor", "Player", 0.0f, false);
}

void QuakePlayerSpeedControl (string &in asTimer)
{
	//QUAKE PLAYER SLOWDOWN//
	if (asTimer == "PlayerSlowDownQuake")
	{
		SetPlayerMoveSpeedMul(0.85f);
		SetPlayerRunSpeedMul(0.85f);
		SetPlayerLookSpeedMul(0.85f);
		StartScreenShake (0.075f, 5.0f, 0.5f, 1.5f);
		AddTimer("PlayerNormalSpeedPostQuake", 2.0f, "QuakePlayerSpeedControl");
		return;
	}
	
	//PIPE QUAKE PLAYER SLOWDOWN//
	if (asTimer == "PlayerSlowDownQuakePipe")
	{
		SetPlayerMoveSpeedMul(0.85f);
		SetPlayerRunSpeedMul(0.85f);
		SetPlayerLookSpeedMul(0.85f);
		StartScreenShake (0.075f, 2.2f, 0.5f, 1.5f);
		AddTimer("PlayerNormalSpeedPostQuake", 2.0f, "QuakePlayerSpeedControl");
		return;
	}
	
	//QUAKE PLAYER BACK TO NORMAL//
	else if (asTimer == "PlayerNormalSpeedPostQuake")
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		return;
	}
}
//END RANDOM QUAKES//


