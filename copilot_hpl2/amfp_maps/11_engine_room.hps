			SetParticleSystemActive("PipeRemovalSteam", true);
		}
		if (GetLocalVarInt("PipeInserted") == 1)
		{
			SetParticleSystemActive("PipeInsertSteam_1", true);
			SetParticleSystemActive("PipeInsertSteam_2", true);
			SetParticleSystemActive("PipeInsertSteam_3", true);
			SetParticleSystemActive("PipeInsertSteam_4", true);
			SetParticleSystemActive("PipeInsertSteam_5", true);
