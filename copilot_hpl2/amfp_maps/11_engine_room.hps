//FURNACE VALVE HANDLER//
void TurnOffFurnace (string &in asEntity, int alsatet)
{
	FadeLightTo("PointLight_41", 0,0,0,0,-1,2);
	FadeLightTo("FurLight_1", 0,0,0,0,-1,2);
	DestroyParticleSystem("FurFire_1");
	DestroyParticleSystem("FurFire_2");
	DestroyParticleSystem("FurFire_3");
	SetLampLit("bonfire_factory_tank_large_4", false, true);
	PipePieceHandler("", "PipeInsertCollider", 1);
	StopSound("Sound_1", 2);
	StopSound("Sound_4", 2);
	StopSound("Sound_5", 2);
	StopSound("Sound_6", 2);
}
//END GLASS SMASH HANDLER//

//PRESSURE VALVE HANDLER//
void PressureValveHandler (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		//SPECIFIC VALVE HANDLERS//
		if (asEntity == "PressureValve1")
		{
			
			SetWheelInteractionDisablesStuck("PressureValve1", false);
			SetWheelStuckState("PressureValve1", -1, false);
			AddLocalVarInt("ValveActivationTracker", 1);
			SetLampLit("Valve1Light_*", true, false);
			SetLocalVarInt("Valve1Used", 1);
		}
		else if (asEntity == "PressureValve2")
		{
			
			SetWheelInteractionDisablesStuck("PressureValve2", false);
			SetWheelStuckState("PressureValve2", -1, false);
			AddLocalVarInt("ValveActivationTracker", 1);
			SetLampLit("Valve2Light_*", true, false);
			SetLocalVarInt("Valve2Used", 1);
		}
		else if (asEntity == "PressureValve3")
		{
			PlaySoundAtEntity("", "afx_reactor_power_horn_higher.snt", "Player", 0.0f, false);
			SetWheelInteractionDisablesStuck("PressureValve3", false);
			SetWheelStuckState("PressureValve3", -1, false);
			AddLocalVarInt("ValveActivationTracker", 1);
			SetLampLit("Valve3Light_*", true, false);
			SetLocalVarInt("Valve3Used", 1);
		}
		//END SPECIFIC VALVE HANDLERS//
		
		//VALVE STEP SEQUENCE HANDLERS//
		if (GetLocalVarInt("ValveActivationTracker") == 1)
		{
			AddTimer("Engineer1SoundsInit", 3.0f, "Engineer1SoundHandler");
			AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
			AddTimer("VOTimer", 13.0f, "EventTriggeredVO");
		}
		else if (GetLocalVarInt("ValveActivationTracker") == 2)
		{
			RemoveTimer("NextQuakeTimer");
			AddTimer("Engineer2SoundsInit", 5.0f, "Engineer2SoundHandler");
			AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
			SetLocalVarFloat("QuakeMinTime", 10.0f);
			SetLocalVarFloat("QuakeMaxTime", 17.0f);
		}
		else if (GetLocalVarInt("ValveActivationTracker") == 3)
		{
			SetLampLit("HatchLight_*", true, false);
			SetLeverInteractionDisablesStuck("LadderLever", true);
			RemoveTimer("NextQuakeTimer");
			AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
			SetLocalVarFloat("QuakeMinTime", 8.0f);
			SetLocalVarFloat("QuakeMaxTime", 12.0f);
		}
		//END VALVE STEP SEQUENCE HANDLERS//
	}
}

void EventTriggeredVO (string &in asTimer)
{
	VOPlayer("Player", "VO_MandusMachine_2", 1);
}
//END PRESSURE VALVE HANDLER//

/////////////////////////////////////////////////////////////////////
//START ESCAPE IN THE PIPE SYSTEM//
void CollideStartPipeScolding(string &in asParent, string &in asChild, int alState)
{
	if(asChild == "PipeE_4" && alState == -1)
	{
		AddDebugMessage("Gave health!", false);
		
		SetPlayerHealth(100);
		SetEntityActive("PipeE_4", false);
		return;
	}
	
	if(asChild == "PipeE_5")
	{
		CreateParticleSystemAtEntity(asChild+"_P1_2", "ps_steam_deadly_large_static_looping.ps", asChild+"_P1", true);
		PlayMusic("music_cellar_children_walkway.ogg", false, 1, 0.1, 10, false);
	}
	
	StartScreenShake(0.02, 1, 0.2f, 0.5f);
	PlaySoundAtEntity("rumble", "afx_sewer_pipetremor.snt", "Player", 0, false);
	PlayGuiSound("afx_enginerooms_pipesteamburst", RandFloat(0.3,0.9));
	
	AddEntityCollideCallback("Player", asChild+"_Area", "SteamKnockBackEvent", false, 0);
	PlaySoundAtEntity(asChild+"_s", "afx_enginerooms_metalpipe_removesteam_sd.snt", asChild+"_Area", 1, true);
	AddTimer(asChild+"_P1", 0.2f, "TimerCreatePart");
	AddTimer(asChild+"_P2", 0.4f, "TimerCreatePart");
	AddTimer(asChild+"_P3", 0.6f, "TimerCreatePart");
}

void TimerCreatePart(string &in asTimer)
{
	CreateParticleSystemAtEntity(asTimer, "ps_steam_deadly_large_pigline.ps", asTimer, true);
	AddLocalVarInt("SteamEffects", 1);
	
	if(GetLocalVarInt("SteamEffects") == 1)
	{
		SetRadialBlurStartDist(1);
		FadeRadialBlurTo(1,10);
		FadeGlobalSoundSpeed(0.5, 0.2);
	}
	if(GetLocalVarInt("SteamEffects") == 2)
	{
		GivePlayerDamage(0.01, "BloodSplat", true, false);
	}
	if(GetLocalVarInt("SteamEffects") == 3)
	{
		FadeRadialBlurTo(0,10);
		FadeGlobalSoundSpeed(1, 0.2);
		SetLocalVarInt("SteamEffects", 0);
	}
}
//END ESCAPE IN TH EPIPE SYSTEM
