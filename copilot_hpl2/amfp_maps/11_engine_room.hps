//PIPE PIECE HANDLER//
//USED FOR THE PULLING OF PIPE, THE VALVE TURNING & SMASHING GLASS
void PipePieceHandler (string &in asParent, string &in asChild, int alState)
{
	//MAIN EVENTS//
	//PULL OF THE PIPE
	if (asChild == "PipeRemovalTracker")
	{
		RotatePropToSpeed("wheel_5", 0.2, 0, 1,0,0, false, "");
		RotatePropToSpeed("wheel_6", 0.3, 0, -1,0,0, false, "");
		RotatePropToSpeed("wheel_7", 0.5, 0, 1,0,0, false, "");
		RotatePropToSpeed("wheel_8", 0.7, 0, -1,0,0, false, "");
		StopSound("wheelsound_1", 6.0f);
		StopSound("wheelsound_12D", 6.0f);
		StopSound("SmallPipeSteam", 3.0f);
		StopSound("HUM_6", 1.0f);
		
		SetLampLit("oval_wall_lamp_4m_pipe_51", false, true);
		SetLampLit("oval_wall_lamp_4m_pipe_52", false, true);
		FadeLightTo("SpotLight_50", 0,0,0,0,-1,1);
		FadeLightTo("SpotLight_51", 0,0,0,0,-1,1);
		FadeLightTo("PointLight_78", 0,0,0,0,-1,1);
		FadeLightTo("SpotLight_58", 0,0,0,0,-1,1);
		FadeLightTo("PointLight_94", 0,0,0,0,-1,1);
		
		RemoveTimer("PipePiece");
		
		SetPropHealth(asParent, 0);
		SetLocalVarInt("PipeRemoved", 1);
		SetParticleSystemActive("PipeRemovalSteam", true);
		DestroyParticleSystem(asParent+"_PS");
		StopSound(asParent+"_Sound", 0.5);
		StartScreenShake(0.05, 0.5, 0.1, 0.5f);
		PlaySoundAtEntity("pipesteamremovedloop", "afx_enginerooms_metalpipe_removesteam_sd.snt", "PipeRemovalSteamSource", 0.0f, true);
		PlaySoundAtEntity("piperemovedbang", "afx_enginerooms_metalpipe_removebang.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("alarmbell", "afx_enginerooms_alarmbell", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_reactor_power_horn.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("wheelhalt_1", "afx_enginerooms_wheel_to_halt.snt", "wheelsound_1", 0.0f, false);
		AddLocalVarInt("MainRoomEventStepTracker", 1);
	}
	
	//PULL THE SECOND PIPE //USED TO BE FURNACE
	if (asChild == "PipeRemovalTracker_1")
	{
		RotatePropToSpeed("wheel_1", 0.2, 0, 1,0,0, false, "");
		RotatePropToSpeed("wheel_2", 0.3, 0, -1,0,0, false, "");
		RotatePropToSpeed("wheel_3", 0.5, 0, 1,0,0, false, "");
		RotatePropToSpeed("wheel_4", 0.7, 0, -1,0,0, false, "");

		StopSound("wheelsound_2", 6.0f);
		StopSound("SmallPipeSteam_1", 3.0f);
		SetParticleSystemActive("PipeRemovalSteam_1", true);
		PlaySoundAtEntity("pipesteamremovedloop", "afx_enginerooms_metalpipe_removesteam_sd.snt", "PipeRemovalSteamSource_1", 0.0f, true);
		
		DestroyParticleSystem("PipePiece_PS_1");
		
		SetPropHealth(asParent, 0);
		
		SetLampLit("oval_wall_lamp_4m_pipe_49", false, true);
		SetLampLit("oval_wall_lamp_4m_pipe_50", false, true);
		FadeLightTo("SpotLight_48", 0,0,0,0,-1,1);
		FadeLightTo("SpotLight_49", 0,0,0,0,-1,1);
		FadeLightTo("PointLight_77", 0,0,0,0,-1,1);
		FadeLightTo("SpotLight_47", 0,0,0,0,-1,2);
		FadeLightTo("PointLight_45", 0,0,0,0,-1,2);
		FadeLightTo("PointLight_46", 0,0,0,0,-1,2);
		FadeLightTo("PointLight_47", 0,0,0,0,-1,2);
		FadeLightTo("PointLight_48", 0,0,0,0,-1,2);
		
		DestroyParticleSystem("PipeInsertSteam_1");
		DestroyParticleSystem("PipeInsertSteam_2");
		DestroyParticleSystem("PipeInsertSteam_3");
		
		SetLocalVarInt("PipeInserted", 1);
		//SetEntityActive("PipePiece", false);
		//SetEntityActive("StaticPipePiece", true);
		//SetParticleSystemActive("PipeInsertSteam_1", true);
		//PlaySoundAtEntity("", "afx_tunnels_steam_burst_pop_01.snt", "PipeInsertSteamSource_1", 0.0f, false);
		PlaySoundAtEntity("hornhigher", "afx_reactor_power_horn_higher.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("furanceextinguish", "afx_enginerooms_fireextinguish", "furnacesoundsource", 0.0f, false);
		PlaySoundAtEntity("alarmbell", "afx_enginerooms_alarmbell", "Player", 0.0f, false);
		PlaySoundAtEntity("wheelhalt_2", "afx_enginerooms_wheel_to_halt.snt", "wheelsound_2", 0.0f, false);
		
		StopSound("furnace3D", 1.0f);
		StopSound("furnace2D", 1.0f);
		AddLocalVarInt("MainRoomEventStepTracker", 1);
		//AddTimer("TimedPipeInsertSteam1", 1.1f, "TimedPipeSteam");
		//AddTimer("TimedPipeInsertSteam2", 1.8f, "TimedPipeSteam");
		//AddTimer("TimedPipeInsertSteam3", 2.2f, "TimedPipeSteam");
		//AddTimer("TimedPipeInsertSteam4", 2.6f, "TimedPipeSteam");
		
	//	if (GetLocalVarInt("GlassSmashed") == 1)
	//	{
	//	AddLocalVarInt("MainRoomEventStepTracker", 1);
	//	}	
	}

	//SMASHING THE GLASS
	if(asChild == "NewGlassSmash")
	{
		SetLampLit("oval_wall_lamp_4m_pipe_53", false, true);
		SetLampLit("oval_wall_lamp_4m_pipe_54", false, true);
		FadeLightTo("SpotLight_52", 0,0,0,0,-1,1);
		FadeLightTo("SpotLight_53", 0,0,0,0,-1,1);
		FadeLightTo("PointLight_79", 0,0,0,0,-1,1);

		AddLocalVarInt("MainRoomEventStepTracker", 1);	
	}
	
	//STEP EVENTS//
	if (GetLocalVarInt("MainRoomEventStepTracker") == 1)
	{
		StopSound("SteamBlockSound", 0);
		PlaySoundAtEntity("SteamBlockSound", "amb_bilge_steam02_3D.snt", "SteamBlockSound", 0.0f, true);
			
		AddTimer("Engineer1SoundsInit", 3.0f, "Engineer1SoundHandler");
		AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
		
		AddHint("Engine4", "");
		
		DestroyParticleSystem("SteamThing_1");
		DestroyParticleSystem("SteamThing_2");
		DestroyParticleSystem("SteamThing_3");
		DestroyParticleSystem("SteamThing_4");
		DestroyParticleSystem("SteamThing_5");
		
		SetParticleSystemActive("SteamThing_6", true);
		SetParticleSystemActive("SteamThing_7", true);
		SetParticleSystemActive("SteamThing_8", true);
		SetParticleSystemActive("SteamThing_9", true);
		SetParticleSystemActive("SteamThing_10", true);
	}
	else if (GetLocalVarInt("MainRoomEventStepTracker") == 2)
	{
		RemoveTimer("NextQuakeTimer");
		AddTimer("Engineer2SoundsInit", 5.0f, "Engineer2SoundHandler");
		AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
		SetLocalVarFloat("QuakeMinTime", 10.0f);
		SetLocalVarFloat("QuakeMaxTime", 17.0f);
		
		SetEntityActive("SteamCoughingTrigger_2", false);
		SetEntityActive("block_box_steam_2", false);
		StopSound("SteamBlockSound", 1);
		
		DestroyParticleSystem("SteamThing_6");
		DestroyParticleSystem("SteamThing_7");
		DestroyParticleSystem("SteamThing_8");
		DestroyParticleSystem("SteamThing_9");
		DestroyParticleSystem("SteamThing_10");
	}
	else if (GetLocalVarInt("MainRoomEventStepTracker") == 3)
	{
		SetLampLit("oval_wall_lamp_2m_pipe_2", true, true);
		SetLampLit("oval_wall_lamp_2m_pipe_3", true, true);
		SetLampLit("oval_wall_lamp_2m_pipe_4", true, true);
		SetLampLit("oval_wall_lamp_2m_pipe_6", true, true);
		FadeLightTo("PointLight_90", -1,-1,-1,-1,4,1);
		FadeLightTo("PointLight_91", -1,-1,-1,-1,4,1);
		FadeLightTo("SpotLight_42", 0,0,0,0,-1,1);
		
		RemoveTimer("NextQuakeTimer");
		
		StopSound("steambigpipe_soundsource2D", 1.0f);
		StopSound("steambigpipe_soundsource3D", 1.0f);
		
		AddTimer("QuakeStart", RandFloat(5.5f, 7.0f), "RandQuakes");
		SetLocalVarFloat("QuakeMinTime", 8.0f);
		SetLocalVarFloat("QuakeMaxTime", 12.0f);
		//SetEntityActive("LadderUp_2", false);
		//SetEntityActive("LadderDown_*", true);
		//SetEntityActive("LadderAreaHatch", true);
		SetEntityActive("block_box_steam_1", false);
		SetEntityActive("SteamCoughingTrigger_1", false);
		DestroyParticleSystem("SteamLargePipe_1");
		DestroyParticleSystem("SteamLargePipe_2");
		DestroyParticleSystem("SteamLargePipe_3");
		DestroyParticleSystem("SteamLargePipe_4");
	}
}

