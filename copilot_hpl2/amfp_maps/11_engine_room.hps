void PigStart(string &in asTimer)
{
	SetEntityActive("engineer_1", true);
	AddEnemyPatrolNode("engineer_1", "PathNodeArea_61", 0, "", false);
	AddEnemyPatrolNode("engineer_1", "PathNodeArea_98", 0, "", false);
	AddEnemyPatrolNode("engineer_1", "PathNodeArea_139", 0, "", false);
	AddEnemyPatrolNode("engineer_1", "PathNodeArea_63", 0, "", false);
	AddEnemyPatrolNode("engineer_1", "PathNodeArea_103", 0, "", false);
			
	SetEntityActive("engineer_2", true);
	AddEnemyPatrolNode("engineer_2", "PathNodeArea_158", 0, "", false);
	AddEnemyPatrolNode("engineer_2", "PathNodeArea_165", 0, "", false);
	AddEnemyPatrolNode("engineer_2", "PathNodeArea_70", 0, "", false);
	
	SetEntityActive("engineer_3", true);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_29", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_109", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_29", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_30", 0, "", false);
		AddEnemyPatrolNode("engineer_3", "PathNodeArea_90", 0, "", false);
	
	PlaySoundAtEntity("", "engineer_engroom_threatloop_01.snt", "Player", 0.0f, false);
	AddTimer("second", 0.6f, "TimerSecondNoise");
	
	CheckPoint("CheckPoint_Pipes", "CheckPoint_Pipes", "CheckPoint_Pipes", "", "", false);//TODO
	
	AddEntityCollideCallback("Player", "AreaShowPlayer", "ShowPigPlayer", false, 1);
	
	LanternFlicker(4);
}

