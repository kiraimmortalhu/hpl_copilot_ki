	ShowEnemyPlayerPosition("engineer_1");
	ShowEnemyPlayerPosition("engineer_2");
	//ShowEnemyPlayerPosition("engineer_3");
	
	//AddTimer("ShowPigPlayerLoop", 1, "ShowPigPlayerLoop");
}

