										////////////////////////////////
										//MAP INITIALISATION FUNCTIONS//
										////////////////////////////////
										
void OnStart()
{
	//Map Preamble
	{
		StopMusic(5.0f, 8);
		SetMapDisplayNameEntry("Engine");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Setup Initial Object States
	{
		//DISABLE ALL SMALL VALVES
		for(int i=1; i<=12; i++) SetEntityInteractionDisabled("valve_"+i, true);
		
		//WHEELS ROTATING AT FULL SPEED
		RotatePropToSpeed("wheel_1", 1, 4, 1,0,0, false, "");
		RotatePropToSpeed("wheel_2", 1, 6, -1,0,0, false, "");
		RotatePropToSpeed("wheel_3", 1, 10, 1,0,0, false, "");
		RotatePropToSpeed("wheel_4", 1, 16, -1,0,0, false, "");
		RotatePropToSpeed("wheel_5", 1, 4, 1,0,0, false, "");
		RotatePropToSpeed("wheel_6", 1, 6, -1,0,0, false, "");
		RotatePropToSpeed("wheel_7", 1, 10, 1,0,0, false, "");
		RotatePropToSpeed("wheel_8", 1, 16, -1,0,0, false, "");
		
		//Steam behind glass to break
		SetParticleSystemActive("GlassInternalSteam_*", true);
		PlaySoundAtEntity("", "afx_cellar_steam_loop_2.snt", "GlassSmashSource", 0.0f, true);
		
		//Fadeout lights for ladder
		FadeLightTo("PointLight_90", -1,-1,-1,-1,0,1);
		FadeLightTo("PointLight_91", -1,-1,-1,-1,0,1);
		
		SetMoveObjectState("PipeGate", 0.75);
	}
	
	bool bDoIntro = true;
		
	//Setup Local Variables
	{
		SetLocalVarInt("RandomSoundCuesActive", 0);
		SetLocalVarInt("IntroHasFinished", 0);
		SetLocalVarInt("RandomHeadRoll", 0);
		SetLocalVarInt("HeadRollState", 0);
		SetLocalVarInt("FusesRemoved", 0);
		SetLocalVarInt("BlockingSteamActive", 1);
		SetLocalVarInt("MaskCorridorSequenceComplete", 0);
		SetLocalVarInt("VanishOk", 0);
		SetLocalVarInt("VanishingDoorTransition", 0);
		SetLocalVarInt("MainRoomEventStepTracker", 0);
		SetLocalVarFloat("QuakeMinTime", 15.0f);
		SetLocalVarFloat("QuakeMaxTime", 22.0f);
		SetLocalVarInt("PipeRemoved", 0);
		SetLocalVarInt("PipeInserted", 0);
		SetLocalVarInt("GlassSmashed", 0);
	}
	
	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");
		
		bDoIntro = false;
		
		//TurnOffHallLights(); //testing main hall lightning.
		
		//GlassSmashes("", "Break");
		//SetEnemyDisableTriggers("engineer_*", true);
	}
		
	//AutoRun Event Timers
	{		
		//RANDOM SOUNDS
		AddTimer("InitRandomStartArea1SoundCues", 15.0f, "RandStartArea1SoundCues");
		AddTimer("InitRandomStartAreaDebrisSoundCues", 10.0f, "RandStartDebrisSoundCues");
		AddTimer("InitRandomStartArea2SoundCues", 22.0f, "RandStartArea2SoundCues");
		
		SetJournalDisabled(false);
		
		//INTRO SETUP//
		if(bDoIntro)
		{
			FadeOut(0.0f);
			SetPlayerActive(false);
			SetPlayerJumpDisabled(true);
			SetPlayerCrouchDisabled(true);
			SetPlayerLookSpeedMul(0.3);
			SetPlayerMoveSpeedMul(0.1);
			SetLanternDisabled(true);
			ShowPlayerCrossHairIcons(false);
			FadePlayerRollTo(30.0f, 50.0f, 50.0f);
			MovePlayerHeadPos(0, 0, 0, 5, 0.01f);
			ShowPlayerCrossHairIcons(false);
			FadeGlobalSoundVolume(0,0.03);
			AddTimer("StartFX", 0.5, "InitSequence");
		}else
		{
			SetPlayerActive(true);
			SetPlayerJumpDisabled(false);
			SetPlayerCrouchDisabled(false);
			SetPlayerLookSpeedMul(1);
			SetPlayerMoveSpeedMul(1);
			SetLanternDisabled(false);
			ShowPlayerCrossHairIcons(true);
			FadePlayerRollTo(0, 50.0f, 50.0f);
			MovePlayerHeadPos(0, 0, 0, 5, 0);
		}
	}
	
	//Setup Initial Entity Callbacks
	{
		//COLLIDE CALLBACKS//
		AddEntityCollideCallback("Player", "freaky_corridor_trigger", "FreakyCorridorHandler", true, 1);
		AddEntityCollideCallback("Player", "RestoreToNormalTrigger1", "RestoreToNormalTriggered", true, 1);
		AddEntityCollideCallback("Player", "SteamCoughingTrigger", "SteamKnockBackEvent", false, 0);
		AddEntityCollideCallback("Player", "SteamCoughingTrigger_1", "SteamKnockBackEvent", false, 0);
		AddEntityCollideCallback("Player", "SteamCoughingTrigger_2", "SteamKnockBackEvent", false, 0);
		AddEntityCollideCallback("Fuse1", "Fuse1Collider", "FuseRemovalHandler", true, -1);
		AddEntityCollideCallback("Fuse2", "Fuse2Collider", "FuseRemovalHandler", true, -1);
		AddEntityCollideCallback("Player", "RandomMachineSoundTimer", "RandomMachineSoundTimerEvent", true, 1);
		AddEntityCollideCallback("Player", "EngineRoomMusic", "EngineRoomMusic", true, 1);
		AddEntityCollideCallback("PipePiece", "PipeRemovalTracker", "PipePieceHandler", true, -1);
		AddEntityCollideCallback("PipePiece_1", "PipeRemovalTracker_1", "PipePieceHandler", true, -1);
		AddEntityCollideCallback("PipePiece", "PipeInsertCollider", "PipePieceHandler", true, 1);
		AddEntityCollideCallback("Player", "pipe_ambient_music", "PipeMusic", true, 1);
		AddEntityCollideCallback("Player", "speakers_music_trigger", "SpeakerMusic", true, 1);
		AddEntityCollideCallback("Player", "StopPigChaseTrigger", "HandlePlayerOutOfPigReach", false, 0);
		
		AddEntityCollideCallback("Player", "EndOfMainHall_0", "EndOfMainHall", true, 1);
		AddEntityCollideCallback("Player", "EndOfMainHall_1", "EndOfMainHall", true, 1);
		
		AddEntityCollideCallback("Player", "PressureRegulatorHintTrigger", "HandleHintTrigger", true, 1);
		AddEntityCollideCallback("Player", "LadderLookAt_1_Activator", "LadderEscapeHintActivation", true, 1);
		AddEntityCollideCallback("Player", "LadderLookAt_2_Activator", "LadderEscapeHintActivation", true, 1);
		
		AddEntityCollideCallback("Player", "PipeE_1", "CollideStartPipeScolding", true, 1);
		AddEntityCollideCallback("Player", "PipeE_2", "CollideStartPipeScolding", true, 1);
		AddEntityCollideCallback("Player", "PipeE_3", "CollideStartPipeScolding", true, 1);
		AddEntityCollideCallback("Player", "PipeE_4", "CollideStartPipeScolding", false, 0);
		AddEntityCollideCallback("Player", "PipeE_5", "CollideStartPipeScolding", true, 1);
		
		AddEntityCollideCallback("engineer_1", "PigTurnToPlayerArea_1", "TurnPigToPlayer", false, 1);
		AddEntityCollideCallback("engineer_2", "PigTurnToPlayerArea_2", "TurnPigToPlayer", false, 1);
		AddEntityCollideCallback("engineer_3", "PigTurnToPlayerArea_3", "TurnPigToPlayer", false, 1);
		
		
		//CHILD VISION CALLBACKS//
		AddEntityCollideCallback("Player", "child_1_trigger", "ActivateChild1", true, 1);
		AddEntityCollideCallback("Player", "child_2_trigger", "ActivateChild2", true, 1);
		AddEntityCollideCallback("Player", "child_3_trigger", "ActivateChild3", true, 1);
		AddEntityCollideCallback("Player", "child_4_trigger", "ActivateChild4", true, 1);
		AddEntityCollideCallback("Player", "child_5_trigger", "ActivateChild5", true, 1);
		AddEntityCollideCallback("Player", "child_6_trigger", "ActivateChild6", true, 1);
		AddEntityCollideCallback("Player", "child_7_trigger", "ActivateChild7", true, 1);
		AddEntityCollideCallback("Player", "child_8_trigger", "ActivateChild8", true, 1);
		AddEntityCollideCallback("Player", "child_9_trigger", "ActivateChild9", true, 1);
		AddEntityCollideCallback("Player", "child_10_trigger", "ActivateChild10", true, 1);
		AddEntityCollideCallback("Player", "child_11_trigger", "ActivateChild11", true, 1);
		AddEntityCollideCallback("Player", "child_12_trigger", "ActivateChild12", true, 1);
		AddEntityCollideCallback("Player", "HitchcockZoomTrigger", "DoHitchcockZoom", true, 1);
		
		//OTHER CALLBACKS//
		AddEntityCollideCallback("Player", "MaskCorridorTrigger", "MaskCorridorHandler", true, 1);	
		AddEntityCollideCallback("Player", "MaskCorridorStopTrigger", "MaskCorridorHandler", true, 1);
		AddEntityCollideCallback("Player", "DoorVanishTrigger", "DoorVanishHandler", false, 1);
		AddEntityCollideCallback("Player", "ElevatorDoorTrigger", "ElevatorHandler", true, 1);
		AddEntityCollideCallback("Player", "FallingMaskTrigger", "FallingMasks", true, 1);
		
		//LOOKAT CALLBACKS//
		SetEntityPlayerLookAtCallback("DoorVanishLookTracker", "DoorVanishLookTracker", false);
		SetEntityPlayerLookAtCallback("LadderLookAt_1", "LadderLookAtHint", true);
		SetEntityPlayerLookAtCallback("LadderLookAt_2", "LadderLookAtHint", true);
		
		
		//STATE CHANGE CALLBACKS//
		SetEntityConnectionStateChangeCallback("FuseBoxLever", "FuseLeverHandler");
		SetEntityConnectionStateChangeCallback("PressureValve1", "PressureValveHandler");
		SetEntityConnectionStateChangeCallback("PressureValve2", "PressureValveHandler");
		SetEntityConnectionStateChangeCallback("PressureValve3", "PressureValveHandler");
		SetEntityConnectionStateChangeCallback("LadderLever", "LadderLeverHandler");
		
		//MULTISLIDER CALLBACKS//
		SetMultiSliderCallback("ElevatorSwitch", "ElevatorDescent");
		
		//TYPE-DEFINED CALLBACKS//
		SetEntityCallbackFunc("GlassIntact", "GlassSmashes");	
		
	}
				
	//Setup Ambience Callbacks
	{
		AddEntityCollideCallback("Player", "AMBStart_1", "MapAmbienceAreas", false, 0);	
		AddEntityCollideCallback("Player", "AMBMain", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMB_Pipes", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMB_Pipes_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMB_Pipes_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMB_Pipes_3", "MapAmbienceAreas", false, 0);		
	}
		
	//Setup Music Callbacks
	{
		AddEntityCollideCallback("Player", "OpeningMusicTrigger", "OpeningMusicPlayer", true, 1);	
	}
		
	//Setup Initial VO Callbacks
	{
		AddEntityCollideCallback("Player", "VOFlashback_1", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VOFlashback_intro", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_MandusMachine_1", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_MandusMachine_2", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_MandusMachine_3", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_Child_1", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_Child_2", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_Child_3", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "VO_Child_4", "VOPlayer", true, 1);
	}
} 

