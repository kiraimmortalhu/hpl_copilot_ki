//STEAM KNOCK BACK EVENT//
void SteamKnockBackEvent (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		FadeImageTrailTo(2.0f, 0.5f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerJumpDisabled(true);
		MandusReactionPlayer("Cough", 0.0f);
		AddTimer("InSteamLoop", RandFloat(1.75f, 2.25f), "SteamCoughing");
		
		AddHint("Engine2", "");
		return;
	}
	else if (alState == -1)
	{
		RemoveTimer("InSteamLoop");
		FadeImageTrailTo(0.0f, 3.5f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerJumpDisabled(false);
		return;
	}
}

void SteamCoughing (string &in asTimer)
{
	MandusReactionPlayer("Cough", RandFloat(0.15f, 0.3f));
	AddTimer("InSteamLoop", RandFloat(1.75f, 2.25f), "SteamCoughing");
}
//END STEAM KNOCK BACK EVENT//

