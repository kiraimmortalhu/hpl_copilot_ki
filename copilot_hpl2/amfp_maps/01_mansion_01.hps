// --------------------------------------------
// START BILLBOARD FADE
// --------------------------------------------

void CollideFadeBB(string &in asParent, string &in asChild, int alState)
{
	if(alState == 1)
	{
		FadeLightTo("FadeBBLight", 0,0,0,0,-1,1);
	}
	else
	{
		FadeLightTo("FadeBBLight", 0.605,0.452,0.286,1,-1,1);
	}
}

void InteractBoxAndBB(string &in asEntity)
{
	SetEntityActive("AreaFadeBB", false);
	FadeLightTo("FadeBBLight", 0,0,0,0,-1,1);
}
// --------------------------------------------
// END BILLBOARD FADE
// --------------------------------------------

void IntroSequenceHandler (string &in asTimer)
{
	int lSequenceStep = GetLocalVarInt("IntroSequenceStepTracker");
		switch (lSequenceStep)
		{
			case 0:
				AddDebugMessage("Intro Sequence Case: "+lSequenceStep+" Activated", false);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				PlayMusic("IntroMusic", false, 1.0f, 0.0f, 1, false);
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				FadeGlobalSoundVolume(1.0f, 0.01f);
				SetLampLit("PointLight_2", false, false);
				SetLampLit("PointLight_1", false, false);
				SetLightVisible("SpotLight_13", false);
				SetLightVisible("SpotLight_10", false);
				SetLightVisible("SpotLight_12", false);
				SetLightVisible("SpotLight_11", false);
				SetLightVisible("SpotLight_9", false);
				AddTimer("IntroStepTimer"+lSequenceStep, 11.0f, "IntroSequenceHandler");
				
				//VERB DOOR
				SetEntityActive("MandusBedroomDoor_1", false);
				SetEntityActive("MandusBedroomDoor", true);
				break;
			
			case 1:
				SetMessage("MansionScenes", "IntroQuote", 9.0f);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				StartPlayerLookAt("IntroSequenceLookTarget", 0.15f, 0.15f, "");
				FadeIn(12.0f);
				AddTimer("IntroStepTimer"+lSequenceStep, 8.8f, "IntroSequenceHandler");
				break;
				
			case 2:
				AddDebugMessage("Intro Sequence Case: "+lSequenceStep+" Activated", false);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				AddTimer("IntroStepTimer"+lSequenceStep, 12.0f, "IntroSequenceHandler");
				AddTimer("Machine_On_VO", 6.0f, "MachineOnHandler");
				break;
				
			case 3:
				AddDebugMessage("Intro Sequence Case: "+lSequenceStep+" Activated", false);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				SetParticleSystemActive("lightning_1", true);
				SetParticleSystemActive("lightning_2", true);
				AddTimer("Machine_On_1", 12.05f, "MachineOnHandler");
				AddTimer("IntroStepTimer"+lSequenceStep, 12.0f, "IntroSequenceHandler");
				
				break;
				
			case 4:
				AddDebugMessage("Intro Sequence Case: "+lSequenceStep+" Activated", false);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);		
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				AddTimer("IntroStepTimer"+lSequenceStep, 10.0f, "IntroSequenceHandler");
				break;
				
			case 5:
				AddDebugMessage("Intro Sequence Case: "+lSequenceStep+" Activated", false);
				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				StopMusic(8.0f, 1);	
				StartScreenShake(0.10f, 16.0f, 3.0f, 1.7f);
				//PlaySoundAtEntity("IntroQuake", "00_intro_quake.snt", "Player", 0.5f, false);
				//PlaySoundAtEntity("IntroQuakeDetail", "00_intro_quake_detail.snt", "Player", 0.5f, false);
				//PlaySoundAtEntity("fake_engine_loop", "afx_big_gears_distant.snt", "Player", 0.0f, false);
				//PlaySoundAtEntity("weird_shit_1", "afx_tripery_shouts_07.snt", "Player", 0.0f, false);
				AddTimer("Machine_On_Steam", 5.0f, "MachineOnHandler");	//used to be 1.5 and located in case 6, here now as particle fade in.
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				AddTimer("IntroStepTimer"+lSequenceStep, 9.0f, "IntroSequenceHandler");
				break;
			
			case 6:
				FadeImageTrailTo(1.5f, 4.3f);
				FadeOut(7.0f);
				StopSound("RadiationFX", 7.0f);
				StopSound("fake_engine_loop", 7.0f);
				StopSound("fake_engine_groan", 7.0f);
				StopSound("fake_engine_screams", 5.0f);
