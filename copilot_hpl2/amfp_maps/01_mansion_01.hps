//MASK PROXIMITY TRACKER//
void MaskProximityTracker (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		if (asChild == "MaskProximity1")
		{
			SetLocalVarInt("inprox1", 1);
			UpdateMasks();
			return;
		}
		else if (asChild == "MaskProximity2")
		{
			SetLocalVarInt("inprox2", 1);
			if (GetLocalVarInt("masksequencesteptracker") < 2)
			{
				UpdateMasks();
			}
			return;
		}
	}
	else if (alState == -1)
	{
		if (asChild == "MaskProximity1")
		{
			SetLocalVarInt("inprox1", 0);
			return;
		}
	    else if (asChild == "MaskProximity2")
		{
			SetLocalVarInt("inprox2", 0);
			return;
		}
	}
}
//END MASK PROXIMITY TRACKER//

//MASK LOOK TRACKER//
void MaskLookTracker (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		if (asEntity == "LeftWallLookTarget")
		{
			SetLocalVarInt("lookleftwall", 1);
			return;
		}
		else if (asEntity == "WindowWallLookTarget")
		{
			SetLocalVarInt("lookwindowwall", 1);
			return;
		}
		else if (asEntity == "Mask3LookTarget")
		{
			SetLocalVarInt("lookmask3", 1);
			UpdateMasks();
			return;
		}
	}
	else if (alState == -1)
	{
		if (asEntity == "LeftWallLookTarget")
		{
			SetLocalVarInt("lookleftwall", 0);
			return;
		}
		else if (asEntity == "WindowWallLookTarget")
		{
			SetLocalVarInt("lookwindowwall", 0);
			return;
		}
		else if (asEntity == "Mask3LookTarget")
		{
			SetLocalVarInt("lookmask3", 0);
			return;
		}
	}
}
//END MASK LOOK TRACKER//

//UPDATE MASKS IN BEDROOM 2//
void UpdateMasks()
{
	if (GetLocalVarInt("masksequencesteptracker") == 0)
	{
		if (GetLocalVarInt("lookleftwall") == 1)
		{
			SetEntityActive("mask2", true);
			AddLocalVarInt("masksequencesteptracker", 1);
			return;
		}
	}
	else if (GetLocalVarInt("masksequencesteptracker") == 1)
	{
		if (GetLocalVarInt("lookwindowwall") == 1)
		{
			SetEntityActive("mask1", false);
			SetEntityActive("mask3", true);
			AddLocalVarInt("masksequencesteptracker", 1);
			return;
		}
	}
	else if (GetLocalVarInt("masksequencesteptracker") == 2)
	{
		if (GetLocalVarInt("inprox2") == 1)
		{
			SetEntityActive("mask2", false);
			AddLocalVarInt("masksequencesteptracker", 1);
			return;
		}
	}
}
//END UPDATE MASKS//

