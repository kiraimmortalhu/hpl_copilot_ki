void RandPreAtticSoundCues(string &in asTimer)
{
	string[] sCueSources7 = {"Rand_SoundPreAttic_1", "Rand_SoundPreAttic_2", "Rand_SoundPreAttic_3", "Rand_SoundPreAttic_4"};
	asTimer = sCueSources7[RandInt (0, 3)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hallway_hits_smaller", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Pre Attic Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(7.0f, 13.0f), "RandPreAtticSoundCues");
}

void RandDebrisAtticSoundCues(string &in asTimer)
{
	string[] sCueSources7 = {"Rand_DebrisSource_1", "Rand_DebrisSource_2", "Rand_DebrisSource_3", "Rand_DebrisSource_4", "Rand_DebrisSource_5", "Rand_DebrisSource_6", "Rand_DebrisSource_7"};
	asTimer = sCueSources7[RandInt (0, 6)];
	PlaySoundAtEntity(asTimer, "afx_events_tunnels_dust_debris", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Dust Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(7.0f, 13.0f), "RandDebrisAtticSoundCues");
}

void RandLastHallwayCreakSoundCues(string &in asTimer)
