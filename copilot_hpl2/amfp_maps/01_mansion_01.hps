//Intro Sequence Machine on Timer//
void MachineOnHandler (string &in asTimer)
{																															
	if (asTimer == "Machine_On_1")																							
	{
	SetLampLit("on_light_1", true, false);
	SetLampLit("on_light_2", true, false);
	AddTimer("Machine_On_2", 1.95f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_2")																							
	{
	SetLampLit("on_light_4", true, false);
	SetLampLit("on_light_3", true, false);
	//PlaySoundAtEntity("", "afx_bilge_reactor_lights_on.snt", "Player", 0.0f, false);
	AddTimer("Machine_On_3", 2.0f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_3")																							
	{
	SetLampLit("on_light_5", true, false);
	SetLampLit("on_light_6", true, false);
	//PlaySoundAtEntity("", "afx_bilge_reactor_lights_on.snt", "Player", 0.0f, false);
	AddTimer("Machine_On_3a", 2.0f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_3a")																							
	{
	SetLampLit("on_light_7", true, false);
	SetLampLit("on_light_8", true, false);
	//PlaySoundAtEntity("", "afx_bilge_reactor_lights_on.snt", "Player", 0.0f, false);
	AddTimer("Machine_On_4", 2.0f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_4")																							
	{
	//PlaySoundAtEntity("fake_engine", "afx_pigline_explosion_long.snt", "Player", 0.0f, false);
	//PlaySoundAtEntity("fake_engine_groan", "afx_pigline_explosion_groan_medium.snt", "Player", 0.0f, false);
	//PlaySoundAtEntity("weird_shit_2", "afx_tripery_shouts_04.snt", "Player", 0.0f, false);
	SetParticleSystemActive("Introdust_1", true);
	SetParticleSystemActive("Introdust_2", true);
	SetParticleSystemActive("Introdust_3", true);
	AddTimer("Machine_On_5", 3.0f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_5")																							
	{
	SetLightVisible("SpotLight_12", true);
	PlayPropAnimation("factory_pistons_1", "on_special", 0.0f, true, "");
	PlayPropAnimation("factory_pistons_2", "on_special", 0.0f, true, "");
	SetLightVisible("SpotLight_11", true);
	SetLightVisible("SpotLight_9", true);
	
	FadeLightTo("SpotLight_11", 0.7,0.5,0.4,1, -1, 0.1);
	FadeLightTo("SpotLight_9", 0.7,0.5,0.4,1, -1, 0.1);
	
	AddTimer("Machine_On_6", 4.0f, "MachineOnHandler");
	}
	else if (asTimer == "Machine_On_6")																							
	{
	SetLightVisible("SpotLight_13", true);
	SetLightVisible("SpotLight_10", true);
	}
	else if (asTimer == "Machine_On_VO")																							
	{
		//PlaySoundAtEntity("IntroVO", "00_intro_voice_over.snt", "Player", 0.0f, false); //Using effect voice instead for subtitles support.
		AddEffectVoice("00_intro_voice_over", "", "Voice", "vo_temple_orbhit_3", false, "", 0, 0);
		PlaySoundAtEntity("IntroVO", "00_intro_machine.snt", "Player", 0.0f, true);
	}
	else if (asTimer == "Machine_On_Steam")																							
	{
	SetParticleSystemActive("steam_1", true);
	SetParticleSystemActive("steam_2", true);	
	}
}

