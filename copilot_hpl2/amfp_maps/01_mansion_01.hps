void OnStart()
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Mansion01");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
	}
	
	//Setup Game Tracking Globals
	{
		SetGlobalVarInt("PlayerHasALantern", 0);
	}
		
	// Setup Local Variables
	{
		//ALL-MAP VARIABLES//
		SetLocalVarString("CurrentAmbientTrack", "");
		
		//SINGLE-MAP VARIABLES//
		SetLocalVarInt("IntroSequenceStepTracker", 0);					
		SetLocalVarInt("IntroComplete", 0);
		SetLocalVarInt("AmbientSoundBlocker", 1);
		SetLocalVarInt("StartRoomBaseSoundsTriggered", 0);
		SetLocalVarInt("RandomHeadRoll", 0);
		SetLocalVarInt("HeadRollState", 0);
		SetLocalVarInt("bedroom2entered", 0);
		SetLocalVarInt("ServantBedroomLookTracking", 0);
		SetLocalVarInt("BlockPileLookTracking", 0);
		SetLocalVarInt("OfficeDoorOpen", 0);
		SetLocalVarInt("HallDoorOpen", 0);
		SetLocalVarInt("FirstSecretDoorOpen", 0);
		
		//PIG MASK EVENT VARIABLES//
		SetLocalVarInt("inprox1", 0);
		SetLocalVarInt("inprox2", 0);
		SetLocalVarInt("lookwindowwall", 0);
		SetLocalVarInt("lookleftwall", 0);
		SetLocalVarInt("lookmask3", 0);
		SetLocalVarInt("masksequencesteptracker", 0);
	}
		
	// Setup Global Variables
	{
		SetGlobalVarInt("randmasksetindex", RandInt(1,3));
	}
	
		//Debugging
	if(ScriptDebugOn()) 
	{
		SetLocalVarInt("IntroSequenceStepTracker", 1); //Skip intro if not 0
	}
		
		
	//AutoRun Event Timers
	{	
		RandomMaskInit(RandInt(1, 3));								
		if (GetLocalVarInt("IntroSequenceStepTracker") == 0)
		{
			FadeOut(0.0f);
			FadeGlobalSoundVolume(0.0f, 0.01f);
			FadeImageTrailTo(0.02f, 2.0f);
			//FadeRadialBlurTo(0.02f, 2.0f);
			TeleportPlayer("temple_intro_1");
			SetPlayerActive(false);
			ShowPlayerCrossHairIcons(false);
			SetPlayerJumpDisabled(true);
			SetPlayerCrouching(true);
			SetPlayerCrouchDisabled(true);
			SetJournalDisabled(true);
			AddTimer("ItStarts", 6.0f, "IntroSequenceHandler");
		}
		else
		{
			TeleportPlayer("MainStart");
		}
	}
		
	//Setup Initial Entity Callbacks
	{
		//COLLISION CALLBACKS//
		AddEntityCollideCallback("Player", "EndBlurArea", "EndBlur", true, -1);
		AddEntityCollideCallback("Player", "BallTrigger", "BallEvent", true, 1);
		AddEntityCollideCallback("Player", "Sound_ThunderTrigger", "EntranceThunder", true, 1);
		AddEntityCollideCallback("attic_floor_ladderhatch_2", "PhysicsSimulationTrigger", "AtticHatchPhysicsSimulation", true, 1);
		AddEntityCollideCallback("Player", "Bedroom2EntryTracker", "Bedroom2EntryExitEvent", true, 1);
		AddEntityCollideCallback("Player", "MaskProximity1", "MaskProximityTracker", false, 0);
		AddEntityCollideCallback("Player", "MaskProximity2", "MaskProximityTracker", false, 0);
		AddEntityCollideCallback("Player", "Attic_Hatch_Close_Trigger", "AtticHatchChildClose", true, 1);
		AddEntityCollideCallback("Player", "Attic_Hatch_ChildRun_Trigger", "AtticHatchChildRun", true, 1);
		AddEntityCollideCallback("Player", "ServantBedroom_Trigger", "ServantBedroomTrigger", true, 1);
