//TREMOR//
void TremorTrigger (string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("", "afx_events_mansion_tremor_01", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	SetPhysicsAutoDisable("chandelier_nice_17", false);
	SetPhysicsAutoDisable("chandelier_nice_18", false);
	SetPhysicsAutoDisable("chandelier_nice_19", false);
	AddTimer("NewQuake2Slow1", 0.3f, "NewQuake2Slow");
	AddTimer("NewQuake2Slow", 1.25f, "NewQuake2Slow");
	AddTimer("NewQuake2Slow2", 3.25f, "NewQuake2Slow");
	AddTimer("MoveSpeedNormal", 8.0f, "MoveSpeedNormal");
	MandusReactionPlayer("Breath", 2.5f);
	MandusReactionPlayer("Breath", 8.25f);
	AddTimer("ChildVo02", 10.0f, "ChildVo02");
	return;
}

void NewQuake2Slow (string &in asTimer)
{
	if(asTimer == "NewQuake2Slow1")
	{
	AddPropForce("chandelier_nice_17", 50, 50, 50, "World");
		AddPropForce("chandelier_nice_18", 50, 50, 50, "World");
		AddPropForce("chandelier_nice_19", 50, 50, 50, "World");
		return;
	}
	
	if(asTimer == "NewQuake2Slow2")
	{
		AddPropForce("chandelier_nice_17", 150, 150, 150, "World");
		AddPropForce("chandelier_nice_18", 150, 150, 150, "World");
		AddPropForce("chandelier_nice_19", 150, 150, 150, "World");
		return;
	}

		AddPropForce("chandelier_nice_17", -100, 100, -100, "World");
		AddPropForce("chandelier_nice_18", -100, 100, -100, "World");
		AddPropForce("chandelier_nice_19", -100, 100, -100, "World");	
	SetPlayerMoveSpeedMul(0.4f);
	SetPlayerLookSpeedMul(0.4f);
	SetPlayerRunSpeedMul(0.4f);
}

//NORMAL WALK SPEED//
void MoveSpeedNormal (string &in asTimer)
{
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
}
//END NORMAL WALK SPEED//

