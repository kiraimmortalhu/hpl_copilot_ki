//RANDOMISED SOUND CUE PLAYER//
void RandSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Rand_WhisperSource_03", "Rand_WhisperSource_04", "Rand_WhisperSource_05", 
							"Rand_WhisperSource_06", "Rand_WhisperSource_07", "Rand_WhisperSource_08", 
							"Rand_WhisperSource_09", "Rand_WhisperSource_10", "Rand_WhisperSource_11", 
							"Rand_WhisperSource_12", "Rand_WhisperSource_13", "Rand_WhisperSource_14", 
							"Rand_WhisperSource_15"};
	asTimer = sCueSources[RandInt (0, 12)];
	PlaySoundAtEntity(asTimer, "afx_spooky_mansion_whisper.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 25.0f), "RandSoundCues");
}

void RandCreakSoundCues(string &in asTimer)
