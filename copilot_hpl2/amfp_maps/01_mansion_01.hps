void CollidePlaneOn(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("plane_black_1", true);
}

void CollidePlaneOff(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("plane_black_1", false);
}

void CollideGiveCrouchHint(string &in asParent, string &in asChild, int alState)
{
	GiveHint("crouch", "Hints", "EnemyTip02", -1);
}

void TimeUnsyncCot(string &in asTimer)
{
	PlayPropAnimation(asTimer, "on", 0.0f, true, "");
}
		
void OnEnter()
{
	//DEFAULT SWITCH LANTERN TO ON//
	{
		SetLanternFlickerActive(false);
	}
	
	//STARTS ENTRANCE ROOM WIND NOISES//
	if (GetLocalVarInt("StartRoomBaseSoundsTriggered") == 1)
	{
		PlaySoundAtEntity("windowwind1", "amb_mans_window_wind_loop_01.snt", "WindowWindSource1", 0.0f, true);
		PlaySoundAtEntity("windowwind2", "amb_mans_window_wind_loop_02.snt", "WindowWindSource2", 0.0f, true);
	}
	
	//PRELOAD SOUNDS//
	{
		PreloadSound("00_intro_bedfoley");
		PreloadSound("00_intro_child_door");
		PreloadSound("00_intro_child_playing");
