	//DEBUG MESSAGE
	AddDebugMessage("Start Pre Attic Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_preattic_stop_1"|| asChild == "soundopt_preattic_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_preattic_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_preattic_stop_2");
	
