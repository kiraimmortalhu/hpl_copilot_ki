		SetEntityPlayerInteractCallback("LandingDoor", "ServantDoorPush_Event", true);
		SetEntityPlayerInteractCallback("lantern_*", "LanternMusic", true);
		
		//LEVEL TRANSITION MUSIC
		SetEntityPlayerInteractCallback("Level_Transition_Door", "Level_Transition_Door", true);
		
		//LOOKAT CALLBACKS//		
		SetEntityPlayerLookAtCallback("LeftWallLookTarget", "MaskLookTracker", false);	
		SetEntityPlayerLookAtCallback("WindowWallLookTarget", "MaskLookTracker", false);
		SetEntityPlayerLookAtCallback("Mask3LookTarget", "MaskLookTracker", false);
		SetEntityPlayerLookAtCallback("ServantBedroomLookTarget", "ServantBedroomLookTracker", false);
		SetEntityPlayerLookAtCallback("BlockPileLookTarget", "BlockPileLookTracker", false);
		
		//STATE CHANGE CALLBACKS//
		SetEntityConnectionStateChangeCallback("GunLever", "OfficeSecretDoorHandler");
		SetEntityConnectionStateChangeCallback("BackAreaLever1", "OfficeSecretDoorHandler");
		SetEntityConnectionStateChangeCallback("BackAreaLever2", "OfficeSecretDoorHandler");
		
		//TYPE-DEFINED ENTITY CALLBACKS//
		SetEntityCallbackFunc("lantern_1", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_2", "LanternInfoUpdate");

		//SOUND OPTIMISATIONS
			//START AREA
		AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_1", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_2", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_3", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_4", "soundopt", true, 1);
			//PRE ATTIC
		AddEntityCollideCallback("Player", "soundopt_preattic_start_1", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_preattic_start_2", "soundopt", true, 1);
			//ATTIC
		AddEntityCollideCallback("Player", "soundopt_attic_start_1", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_attic_start_2", "soundopt", true, 1);
			//GALLERY AREA
		AddEntityCollideCallback("Player", "soundopt_gallery_start_1", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_gallery_start_2", "soundopt", true, 1);
			//BACK AREA ABSTRACT
		AddEntityCollideCallback("Player", "soundopt_backarea_start_1", "soundopt", true, 1);
		AddEntityCollideCallback("Player", "soundopt_backarea_start_2", "soundopt", true, 1);
			//LAST HALLWAY
		AddEntityCollideCallback("Player", "soundopt_lasthallway_start_1", "soundopt", true, 1);
		
		AddEntityCollideCallback("Player", "ServantDoorPush_Event", "ServantDoorPush_Event", true, 0);
		
		AddEntityCollideCallback("Player", "AreaPlaneOn", "CollidePlaneOn", false, 1);
		AddEntityCollideCallback("Player", "AreaPlaneOff", "CollidePlaneOff", false, 1);
	}
		
	//Setup Initial Object States
	{	
		//INTERACT ICONS//
		//SetEntityCustomFocusCrossHair("work_desk_11", "hud_crosshair_over_phone.tga");

		//DOOR STATES//
		SetSwingDoorDisableAutoClose("bed_cage_light", true);
		
		//ANIMATION STATES//
		PlayPropAnimation("Cot", "on", 0.0f, true, "");
		AddTimer("Cot_1", 1, "TimeUnsyncCot");

		PlayPropAnimation("Phonautograph1", "Stop", 0.0f, true, "");							//Initialises Phonautograph to non-animated.
		PlayPropAnimation("clock_grandfather_*", "on", 0.0f, true, "");
	}
		
	//Setup Ambience Callbacks
	{
		AddEntityCollideCallback("Player", "AMBAreaStartRoom", "MapAmbienceAreas", false, 0);// First Bedroom
		AddEntityCollideCallback("Player", "AMBAreaFirstStairs_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaFirstStairs", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaFirstHallway", "MapAmbienceAreas", false, 0); //First hallway and bathroom and first set of stairs
