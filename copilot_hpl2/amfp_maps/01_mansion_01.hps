void OfficeSecretDoorHandler (string &in asEntity, int alState)
{
	//GUN LEVER//
	if (asEntity == "GunLever" && alState == 1 && GetLocalVarInt("OfficeDoorOpen") == 0)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Unlocked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "GunLever", 0, false);
		SetSwingDoorLocked("OfficeSecretDoor", false, false);
		SetSwingDoorClosed("OfficeSecretDoor", false, false);
		SetSwingDoorDisableAutoClose("OfficeSecretDoor", true);
		AddTimer("OfficeSecretDoor_door_body", 0, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.05, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.1, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.15, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.2, "TimerPushSecret");
		SetEntityInteractionDisabled("OfficeSecretDoor", false);
		SetLeverInteractionDisablesStuck("GunLever", false);
		SetLeverStuckState("GunLever", 1, false);
		SetLocalVarInt("OfficeDoorOpen", 1);
		AddTimer("GunLeverReinitTimer", 0.2f, "LeverReinitialiser");
		if (GetLocalVarInt("FirstSecretDoorOpen") == 0)
		{
			MusicPlayer("Player", "OfficeSecretDoorMusic", 1);
			SetLocalVarInt("FirstSecretDoorOpen", 1);
		}
		return;
	}

	else if (asEntity == "GunLever" && alState == -1 && GetLocalVarInt("OfficeDoorOpen") == 1)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Locked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "GunLever", 0, false);
		SetSwingDoorDisableAutoClose("OfficeSecretDoor", false);
		SetSwingDoorClosed("OfficeSecretDoor", true, false);
		SetSwingDoorLocked("OfficeSecretDoor", true, false);
		//SetEntityInteractionDisabled("OfficeSecretDoor", true);
		SetLeverInteractionDisablesStuck("GunLever", false);
		SetLeverStuckState("GunLever", -1, false);
		SetLocalVarInt("OfficeDoorOpen", 0);
		AddTimer("GunLeverReinitTimer", 0.2f, "LeverReinitialiser");
		return;
	}
	//END GUN LEVER//
	//INTERIOR LEVER//
	else if (asEntity == "BackAreaLever1" && alState == 1 && GetLocalVarInt("OfficeDoorOpen") == 0)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Unlocked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "OfficeSecretDoor", 0, false);
		SetSwingDoorLocked("OfficeSecretDoor", false, false);
		SetSwingDoorClosed("OfficeSecretDoor", false, false);
		SetSwingDoorDisableAutoClose("OfficeSecretDoor", true);
		AddTimer("OfficeSecretDoor_door_body", 0, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.05, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.1, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.15, "TimerPushSecret");
		AddTimer("OfficeSecretDoor_door_body", 0.2, "TimerPushSecret");
		//SetEntityInteractionDisabled("OfficeSecretDoor", false);
		SetLeverInteractionDisablesStuck("BackAreaLever1", false);
		SetLeverStuckState("BackAreaLever1", 1, false);
		SetLocalVarInt("OfficeDoorOpen", 1);
		AddTimer("BackAreaLever1ReinitTimer", 0.2f, "LeverReinitialiser");
		return;
	}
	else if (asEntity == "BackAreaLever1" && alState == -1 && GetLocalVarInt("OfficeDoorOpen") == 1)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Locked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "OfficeSecretDoor", 0, false);
		SetSwingDoorDisableAutoClose("OfficeSecretDoor", false);
		SetSwingDoorClosed("OfficeSecretDoor", true, false);
		SetSwingDoorLocked("OfficeSecretDoor", true, false);
		//SetEntityInteractionDisabled("OfficeSecretDoor", true);
		SetLeverInteractionDisablesStuck("BackAreaLever1", false);
		SetLeverStuckState("BackAreaLever1", -1, false);
		SetLocalVarInt("OfficeDoorOpen", 0);
		AddTimer("BackAreaLever1ReinitTimer", 0.2f, "LeverReinitialiser");
		return;
	}
	//END INTERIOR LEVER//
	
	//INTERIOR 2 LEVER//
	else if (asEntity == "BackAreaLever2" && alState == 1 && GetLocalVarInt("HallDoorOpen") == 0)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Unlocked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "HallSecretDoor", 0, false);
		SetSwingDoorLocked("HallSecretDoor", false, false);
		SetSwingDoorClosed("HallSecretDoor", false, false);
		SetSwingDoorDisableAutoClose("HallSecretDoor", true);
		AddTimer("HallSecretDoor_door_body", 0, "TimerPushSecret02");
		AddTimer("HallSecretDoor_door_body", 0.05, "TimerPushSecret02");
		AddTimer("HallSecretDoor_door_body", 0.1, "TimerPushSecret02");
		AddTimer("HallSecretDoor_door_body", 0.15, "TimerPushSecret02");
		AddTimer("HallSecretDoor_door_body", 0.2, "TimerPushSecret02");
		//SetEntityInteractionDisabled("HallSecretDoor", false);
		SetLeverInteractionDisablesStuck("BackAreaLever2", false);
		SetLeverStuckState("BackAreaLever2", 1, false);
		SetLocalVarInt("HallDoorOpen", 1);
		AddTimer("BackAreaLever2ReinitTimer", 0.2f, "LeverReinitialiser");
		return;
	}
	else if (asEntity == "BackAreaLever2" && alState == -1 && GetLocalVarInt("HallDoorOpen") == 1)
	{
		AddDebugMessage("State: "+alState, false);
		AddDebugMessage("Locked Back Area Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "HallSecretDoor", 0, false);
		SetSwingDoorDisableAutoClose("HallSecretDoor", false);
		SetSwingDoorClosed("HallSecretDoor", true, false);
		SetSwingDoorLocked("HallSecretDoor", true, false);
	//	SetEntityInteractionDisabled("HallSecretDoor", true);
		SetLeverInteractionDisablesStuck("BackAreaLever2", false);
		SetLeverStuckState("BackAreaLever2", -1, false);
		SetLocalVarInt("HallDoorOpen", 0);
		AddTimer("BackAreaLever2ReinitTimer", 0.2f, "LeverReinitialiser");
		return;
	}
	//END INTERIOR 2 LEVER//
}

void LeverReinitialiser (string &in asTimer)
{
	//GUN LEVER REINITIALISER//
	if (asTimer == "GunLeverReinitTimer")
	{
		SetLeverInteractionDisablesStuck("GunLever", true);
		return;
	}
	
	//BACK AREA LEVER 1 REINITIALISER//
	else if (asTimer == "BackAreaLever1ReinitTimer")
	{
		SetLeverInteractionDisablesStuck("BackAreaLever1", true);
		return;
	}
	
	//BACK AREA LEVER 2 REINITIALISER//
	else if (asTimer == "BackAreaLever2ReinitTimer")
	{
		SetLeverInteractionDisablesStuck("BackAreaLever2", true);
		return;
	}
}
//END DOOR HANDLER//

//DESK MASK EVENT//
void DeskMaskHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "DeskMaskSpawnTrigger")
	{
		SetEntityActive("DeskMask", true);
		return;
	}
	else if (asChild == "DeskMaskDespawnTrigger")
	{
		SetEntityActive("DeskMask", false);
		return;
	}
}
//END DESK MASK EVENT//

