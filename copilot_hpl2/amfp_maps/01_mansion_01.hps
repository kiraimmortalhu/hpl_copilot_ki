//BEDROOM 2 ENTRY/EXIT HANDLER//
void Bedroom2EntryExitEvent (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Bedroom2EntryTracker")
	{
		SetLocalVarInt("bedroom2entered", 1);
		return;
	}
	else if (asChild == "PigGruntTrigger" && GetLocalVarInt("bedroom2entered") == 1)
	{
		RemoveEntityCollideCallback("Player", "PigGruntTrigger");
		return;
	}
}
//END BEDROOM 2 HANDLER//

//RANDOM MASK ENTITY SPAWN HANDLER//														
void RandomMaskInit (int SetIndex) //Set 1: 1 3 4 5 7 8 9    Set 2: 2 3 4 6 8 9 10
{
	AddDebugMessage("Random Mask Set Spawned, Using Index #"+SetIndex, false);
	if (SetIndex == 1)
	{
		//MASK ACTIVATION
		SetEntityActive("RandMask1", true);
		SetEntityActive("RandMask3", true);
		SetEntityActive("RandMask5", true);
		SetEntityActive("RandMask7", true);
		SetEntityActive("RandMask8", true);
		//DESPAWN TRIGGER CALLBACK INITIALISATION
		AddEntityCollideCallback("Player", "RandMask1DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask2DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask3&4SwapTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		AddEntityCollideCallback("Player", "RandMask4DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask5DespawnTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		AddEntityCollideCallback("Player", "RandMask6DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask7DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask8SpawnTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		AddEntityCollideCallback("Player", "RandMask8DespawnTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		return;
	}
	else if (SetIndex == 2 || SetIndex == 3)
	{
		SetEntityActive("RandMask2", true);
		SetEntityActive("RandMask3", true);
		SetEntityActive("RandMask6", true);
		SetEntityActive("RandMask8", true);
		//DESPAWN TRIGGER CALLBACK INITIALISATION
		AddEntityCollideCallback("Player", "RandMask2DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask3&4SwapTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		AddEntityCollideCallback("Player", "RandMask4DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask6DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask8SpawnTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		AddEntityCollideCallback("Player", "RandMask8DespawnTrigger", "RandomMaskTriggerCallbackHandler", true, 1);
		return;
	}
	else
	{
		AddDebugMessage("Random Mask Handler - Index Out of Range!", false);
	}
}

void RandomMaskTriggerCallbackHandler (string &in asParent, string &in asChild, int alState)
{
	int lDespawnRandomiser = RandInt(1,2);
	AddDebugMessage("Despawn Randomiser set to: "+lDespawnRandomiser, false); 
	if (asChild == "RandMask1DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask1", false);
		RemoveEntityCollideCallback("Player", "RandMask1DespawnTrigger");
		AddDebugMessage("RandMask1 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask2DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask2", false);
		RemoveEntityCollideCallback("Player", "RandMask2DespawnTrigger");
		AddDebugMessage("RandMask2 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask3&4SwapTrigger")
	{
		SetEntityActive("RandMask3", false);
		SetEntityActive("RandMask4", true);
		RemoveEntityCollideCallback("Player", "RandMask3&4SwapTrigger");
		AddDebugMessage("RandMask3&4 SWAPPED", false);
		return;
	}
	else if (asChild == "RandMask4DespawnTrigger" || asChild == "RandMask4DespawnTrigger2")
	{
		SetEntityActive("RandMask4", false);
		RemoveEntityCollideCallback("Player", "RandMask4DespawnTrigger");
		AddDebugMessage("RandMask4 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask5DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask5", false);
		RemoveEntityCollideCallback("Player", "RandMask5DespawnTrigger");
		AddDebugMessage("RandMask5 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask6DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask6", false);
		RemoveEntityCollideCallback("Player", "RandMask6DespawnTrigger");
		AddDebugMessage("RandMask6 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask7DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask7", false);
		RemoveEntityCollideCallback("Player", "RandMask7DespawnTrigger");
		AddDebugMessage("RandMask7 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask8SpawnTrigger")
	{
		SetEntityActive("RandMask8", true);
		SetEntityActive("RandMask8Nail", true);
		AddEntityCollideCallback("Player", "RandMask8DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddDebugMessage("RandMask8 SPAWNED", false);
		return;
	}
	else if (asChild == "RandMask8DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask8", false);
		RemoveEntityCollideCallback("Player", "RandMask8DespawnTrigger");
		AddDebugMessage("RandMask8 DESPAWNED", false);
		return;
	}
}
//END RANDOM MASK HANDLER//

//SERVANT BEDROOM SOUND TRIGGER//
void ServantBedroomTrigger (string &in asParent, string &in asChild, int alState)
{
	AddTimer("ServantRoomTimer", RandFloat(1.0f, 2.5f), "ServantBedroomTimerCalls");
	if (GetLocalVarInt("ServantBedroomLookTracking") == 1 && RandInt(1, 5) > 2)
	{
		SetEntityActive("LandingWallPiece", true);
		SetEntityActive("LandingDoorPiece", false);
		SetEntityActive("LandingDoorFrame", false);
		SetEntityActive("LandingDoor", false);
	}
	AddDebugMessage("SERVANT TIMER STARTED", false);
}

void ServantBedroomTimerCalls (string &in asTimer)
{
	if (asTimer == "ServantRoomTimer")
	{
		PlaySoundAtEntity ("child_run", "afx_child_run_servant_room.snt", "Player", 0, false);
		PlaySoundAtEntity ("child_run", "afx_child_run_servant_room_child_vo.snt", "Player", 0, false);
		PlaySoundAtEntity ("child_run", "afx_child_run_servant_room_dust.snt", "Player", 0, false);
		AddTimer("ServantRoomTimerParticles", 1.5f, "ServantBedroomTimerCalls");
		MandusReactionPlayer("Scared", 0.75f);
		AddDebugMessage("SERVANT TIMER OVER", false);
		return;
	}
	else if (asTimer == "ServantRoomTimerParticles")
	{
		SetParticleSystemActive("ServantRoomParticle_*", false);
	}
}
//END SERVANT BEDROOM SOUND TRIGGER//

