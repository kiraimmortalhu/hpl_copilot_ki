				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				AddLocalVarInt("IntroSequenceStepTracker", 1);
				AddTimer("IntroStepTimer"+lSequenceStep, 7.0f, "IntroSequenceHandler");
				break;
			
			case 7:
				PlaySoundAtEntity("FSPVO1", "intro_fps_vo1", "Player", 0.1f, false);
