	PlaySoundAtEntity("Dropbox", "afx_events_mansion_attic_childrun_dropbox", "DropBox_Sound", 0, true);
	AddDebugMessage("DropboxSound", false);
}
										//////////////////////////////
										//NON MAP-SPECIFIC FUNCTIONS//
										//////////////////////////////
										
							
//SOUND OPTIMISATIONS//
void soundopt (string &in asParent, string &in asChild, int alState)
{
//START AREA OPT
	if (asChild == "soundopt_mansionfirsthallway_start_1"|| asChild == "soundopt_mansionfirsthallway_start_2"|| asChild == "soundopt_mansionfirsthallway_start_3"|| asChild == "soundopt_mansionfirsthallway_start_4")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_2");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_3");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_4");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_3", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_4", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomStartHallSoundCuePlayer", 5.0f, "RandStartHallSoundCues");
	AddTimer("InitRandomStartHallCreakSoundCuePlayer", 6.0f, "RandStartHallCreakSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Mansion Start Hall Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_mansionfirsthallway_stop_1"|| asChild == "soundopt_mansionfirsthallway_stop_2"|| asChild == "soundopt_mansionfirsthallway_stop_3"|| asChild == "soundopt_mansionfirsthallway_stop_4")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_2");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_3");
	RemoveEntityCollideCallback("Player", "soundopt_mansionfirsthallway_stop_4");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_3", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_mansionfirsthallway_start_4", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("InitRandomStartHallSoundCuePlayer");
	RemoveTimer("RandStartHallSoundCues");
	RemoveTimer("InitRandomStartHallCreakSoundCuePlayer");
	RemoveTimer("RandStartHallCreakSoundCues");
	RemoveTimer("Sound_MansionStart_1");
	RemoveTimer("Sound_MansionStart_2");
	RemoveTimer("Sound_MansionStart_3");
	RemoveTimer("Sound_MansionStart_4");
	RemoveTimer("Sound_MansionStart_5");
	RemoveTimer("Sound_MansionStart_6");
	RemoveTimer("Sound_MansionStart_7");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Mansion Start Hall Sounds", true);
	}
//BREAK
//PRE ATTIC SOUNDS
	if (asChild == "soundopt_preattic_start_1"|| asChild == "soundopt_preattic_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_preattic_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_preattic_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_preattic_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_preattic_stop_2", "soundopt", true, 1);
	
