		AddEntityCollideCallback("Player", "AreaCrouchHint02", "CollideGiveCrouchHint", false, 1);
		
		
		//INTERACTION CALLBACKS//
		SetEntityPlayerInteractCallback("MandusBedroomDoor", "ChildrenRunAway", true);		
