//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Bedroom2MusicStopFailSafe")
	{
		StopMusic(3.5f, 0);
		return;
	}
	else if (asChild == "BackAreaMusicTrigger")
	{
		PlayMusic("music_mans_backarea.ogg", false, 0.75f, 0.4f, 0, true);
		MandusReactionPlayer("Breath", 1.5f);
		StopSound("BackAreaBuildup", 2.0f);
		FadeImageTrailTo(5.0f, 0.5f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		AddTimer("BackAreaTimer", 3.0f, "BackAreaEffectsTrigger");
		AddDebugMessage("BACK AREA VO 5.5 SEC TIMER TRIGGERED", false);
		//StartPlayerLookAt("BackAreaLookArea", 0.1f, 0.1f, "");
		return;
	}
	else if (asChild == "FadeOutKillingRoomMusicTrigger")
	{
		StopMusic(3.5f, 0);
		return;
	}
	else if (asChild == "GalleryEntryTrigger")
	{
		PlayMusic("music_mans_gallery_entry", false, 1.0f, 2.0f, 0, false);
		return;
	}
	else if (asChild == "OfficeSecretDoorMusic")
	{
		PlayMusic("music_mans_office_secret_door_unlock.ogg", false, 1.0f, 0.0f, 0, false);
		PlaySoundAtEntity("BackAreaBuildup", "afx_mansion_tension_riser.snt", "Rand_BackArea_SoundSource_4", 6.0f, true);
		return;
	}
}

void LanternMusic(string &in asEntity)
{
	PlayMusic("music_mansion_lanternpickup", false, 0.4f, 0.0f, 1, false);
	return;
}
//END MUSIC PLAYER//

