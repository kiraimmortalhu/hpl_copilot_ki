				AddDebugMessage("lSequenceStep = "+lSequenceStep, false);
				AddEffectVoice("vo_reactor_child_01.ogg", "", "Voice", "vo_reactor_child_01", false, "", 0.0f, 0.0f);
				PlaySoundAtEntity("bedfoley1", "00_intro_bedfoley.snt", "Player", 0.0f, false);
