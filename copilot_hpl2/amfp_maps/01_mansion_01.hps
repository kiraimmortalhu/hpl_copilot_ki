		AddEntityCollideCallback("Child2", "Child2KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child3", "Child3BlockBox1Trigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child3", "Child3KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child4", "Child4KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child5", "Child5KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "Child4&5KillTrigger", "ChildEventHandler", true, 1);
