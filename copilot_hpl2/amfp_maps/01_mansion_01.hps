//MANSION QUAKE EVENT HANDLER//
void QuakeSequences (string &in asParent, string &in asChild, int alState)
{
	AddTimer("Quake1StartBuffer", 0.599f, "Quake1Start");
	AddTimer("Quake1End", 2.5f, "Quake1End");
	AddTimer("ClockRingTrigger", 5.0f, "PostQuakeClockRing");
	StopSound("DHZ", 2.0f);
	StopSound("Gallery_Piano_Piece_2D", 3.0f);
	StopSound("Gallery_Piano_Piece_3D", 3.0f);
	MandusReactionPlayer("Breath", 5.0f);
	PlaySoundAtEntity("", "amb_mansion_ceiling_fan.snt", "OfficeFanSource", 0.0f, true);
	PlaySoundAtEntity("", "afx_mansion_gallery_quake_items", "Player", 0.0f, false);
	PlaySoundAtEntity("", "afx_mansion_gallery_quake", "Player", 0.0f, true);
	SetParticleSystemActive("FireDustFall_*", true);
	SetPhysicsAutoDisable("chandelier_large_3", false);
	SetPhysicsAutoDisable("chandelier_nice_12", false);
	SetPhysicsAutoDisable("chandelier_nice_16", false);
	AddTimer("AddChandelierForceTimer", 0.6f, "ApplyForceChandeliers");
	AddTimer("PaintingFallTimer1", 1.2f, "PaintingsFall");
	AddTimer("PaintingFallTimer2", 1.4f, "PaintingsFall");
	AddTimer("PaintingFallTimer3", 1.9f, "PaintingsFall");
	AddTimer("PaintingFallTimer4", 2.1f, "PaintingsFall");
	AddTimer("RestorePhysicsSimTimer", 30.0f, "RestoreChandelierPhysicsSim");
	AddTimer("FireplaceDustTimer", 0.6f, "FireplaceParticles");
	AddTimer("FireplaceExtinguishTimer", 1.15f, "FireplaceOutAndPiano");
	AddTimer("ForceLoopTimer1", 1.0f, "ApplyForceLoop");
	AddTimer("ForceLoopTimer2", 1.2f, "ApplyForceLoop");
	AddTimer("ForceLoopTimer3", 1.4f, "ApplyForceLoop");
}

void Quake1Start (string &in asTimer)
{
	StartScreenShake (0.15f, 1.5f, 0.5f, 0.968f);
	SetParticleSystemActive("BedroomDustParticles_*", true);
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerRunSpeedMul(0.0f);
}

void ApplyForceChandeliers (string &in asTimer)
{
	AddPropForce("chandelier_nice_12", 220.0f, 0.0f, -350.0f, "local");
	AddPropForce("chandelier_nice_16", 320.0f, 0.0f, 390.0f, "local");
	AddPropForce("chandelier_large_3", 1400.0f, 0.0f, 950.0f, "local");
}

void FireplaceParticles (string &in asTimer)
{
	SetParticleSystemActive("FireDustMain", true);
}

void PaintingsFall (string &in asTimer)
{
	if (asTimer == "PaintingFallTimer1")
	{
		SetPropStaticPhysics("PaintingFall_1", false);
		return;
	}
	else if (asTimer == "PaintingFallTimer2")
	{
		SetPropStaticPhysics("PaintingFall_2", false);
		return;
	}
	else if (asTimer == "PaintingFallTimer3")
	{
		SetPropStaticPhysics("PaintingFall_3", false);
		return;
	}
	else if (asTimer == "PaintingFallTimer4")
	{
		SetPropStaticPhysics("PaintingFall_4", false);
		return;
	}
}

void FireplaceOutAndPiano (string &in asTimer)
{
	DestroyParticleSystem("FirePlaceFire");
	SetSwingDoorClosed("grand_piano_1", true, false);
	SetSwingDoorLocked("grand_piano_1", true, false);
}

void ApplyForceLoop (string &in asTimer)
{
	AddPropForce("book_fall_*", 0, 100, 100, "world");
}

void RestoreChandelierPhysicsSim (string &in asTimer)
{
	SetPhysicsAutoDisable("chandelier_large_3", true);
	SetPhysicsAutoDisable("chandelier_nice_12", true);
	SetPhysicsAutoDisable("chandelier_nice_16", true);
	SetParticleSystemActive("ChandelierDust", true);
}

void Quake1End (string &in asTimer)
{
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
}

void PostQuakeClockRing (string &in asTimer)
{
	PlaySoundAtEntity("Gallery_Clock_Chime_2D", "afx_mansion_gallery_clock_ring_2D", "HallClockSource", 0, true);
	PlaySoundAtEntity("Gallery_Clock_Chime_3D", "afx_mansion_gallery_clock_ring_3D", "HallClockSource", 0, true);
}
//END QUAKE EVENT HANDLER//

//LANTERN INFO UPDATE//
void LanternInfoUpdate (string &in asEntity, string &in asType)
{
	SetGlobalVarInt("PlayerHasALantern", 1);
	SetEntityActive("lantern_1", false);
	SetEntityActive("lantern_2", false);
}
//END LANTERN INFO UPDATE//

//MAP CHILD EVENT HANDLER//
void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Child2RunTrigger")
	{
		SetEntityActive("Child2", true);
		AddEnemyPatrolNode("Child2", "PathNodeArea_5", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child1RunTrigger")
	{
		SetEntityActive("Child1", true);
		SetEntityActive("Child1a", true);
		PlaySoundAtEntity("Child1Run", "afx_events_mansion_attic_childrun_01", "Player", 0, true);
		SetLightFlickerActive("Lantern", true);
		AddEnemyPatrolNode("Child1", "PathNodeArea_3", 0.0f, "", false);
		AddEnemyPatrolNode("Child1a", "PathNodeArea_3", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child3RunTrigger")
	{
		SetEntityActive("Child3", true);
		PlaySoundAtEntity("Child1Run", "afx_events_mansion_attic_childrun_02", "Player", 0, true);
		AddEffectVoice("mansion_vo_01_area_children.ogg", "", "Voice", "MansionTRGChildren1", false, "", 0.0f, 0.0f);
		AddEnemyPatrolNode("Child3", "PathNodeArea_7", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child4RunTrigger")
	{
		SetEntityActive("Child4", true);
		AddEnemyPatrolNode("Child4", "PathNodeArea_42", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_8", 0.0f, "", false);
		SetEntityActive("Child5", true);
		AddEnemyPatrolNode("Child5", "PathNodeArea_42", 0.0f, "", false);
		AddEnemyPatrolNode("Child5", "PathNodeArea_8", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child6&7RunTrigger")
	{
		SetEntityActive("Child6", true);
		AddDebugMessage("Thunder Triggered", false);
		PlaySoundAtEntity("EntranceThunder", "afx_events_mansion_entrance_thunder.snt", "Player", 0.0f, false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_17", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_18", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_20", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_21", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_28", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_38", 0.0f, "", false);
		AddEnemyPatrolNode("Child6", "PathNodeArea_33", 0.0f, "", false);
		
		SetEntityActive("Child7", true);
		AddEnemyPatrolNode("Child7", "PathNodeArea_15", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_16", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_34", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_35", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_36", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_37", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_38", 0.0f, "", false);
		AddEnemyPatrolNode("Child7", "PathNodeArea_33", 0.0f, "", false);
		return;
	}
	else if (asChild == "IntroChildKillTrigger")
	{
		ClearEnemyPatrolNodes("IntroChild");
		SetEntityActive("IntroChild", false);
		return;
	}
	else if (asChild == "Child1KillTrigger")
	{
		AddDebugMessage("Chld1 Kill", false);
		ClearEnemyPatrolNodes("Child1");
		SetEntityActive("Child1", false);
		ClearEnemyPatrolNodes("Child1a");
		SetEntityActive("Child1a", false);
		return;
	}
	else if (asChild == "Child2KillTrigger")
	{
		ClearEnemyPatrolNodes("Child2");
		SetEntityActive("Child2", false);
		return;
	}
	else if (asChild == "Child3BlockBox1Trigger")
	{
		SetEntityActive("GhostBeamBlockBox1", true);
		return;
	}
	else if (asChild == "Child3KillTrigger")
	{
		ClearEnemyPatrolNodes("Child3");
		SetEntityActive("Child3", false);
		SetEntityActive("ChildDropBox_2", true);
		SetEntityActive("GhostBeamBlockBox2", true);
		return;
	}
	else if (asChild == "Child4KillTrigger")
	{
		ClearEnemyPatrolNodes("Child4");
		SetEntityActive("Child4", false);
		PlaySoundAtEntity("", "afx_spooky_child_laugh_semi_distant.snt", "BackAreaLaughterSource", 0.0f, false);
		return;
	}
	else if (asChild == "Child5KillTrigger")
	{
		ClearEnemyPatrolNodes("Child5");
		SetEntityActive("Child5", false);
		return;
	}
	else if (asChild == "Child4&5KillTrigger")
	{
		if (GetEntityActive("Child4"))
		{
			ClearEnemyPatrolNodes("Child4");
			SetEntityActive("Child4", false);
			PlaySoundAtEntity("", "afx_spooky_child_laugh_semi_distant.snt", "BackAreaLaughterSource", 0.0f, false);
		}
		if (GetEntityActive("Child5"))
		{
			ClearEnemyPatrolNodes("Child5");
			SetEntityActive("Child5", false);
		}
	}
	else if (asChild == "Child6KillTrigger")
	{
		ClearEnemyPatrolNodes("Child6");
		SetEntityActive("Child6", false);
		return;
	}
	else if (asChild == "Child7KillTrigger")
	{
		ClearEnemyPatrolNodes("Child7");
		SetEntityActive("Child7", false);
		return;
	}
	else if (asChild == "CloseDoorTrigger")
	{
		AddLocalVarInt("BothChildrenThroughDoor", 1);
		
		if (GetLocalVarInt("BothChildrenThroughDoor") < 2) return;
		
		SetSwingDoorClosed("wood_panneling_door_9", true, false);
		PlaySoundAtEntity("slam", "afx_mansion_child_attic_hatch_close_2D_wider.snt", "wood_panneling_door_9", 0, false);
		AddDebugMessage("!!CLOSE DOOR!!", false);
		RemoveEntityCollideCallback("Child6", "CloseDoorTrigger");
		RemoveEntityCollideCallback("Child7", "CloseDoorTrigger");
		return;
	}
}
//END MAP CHILD EVENT HANDLER//

