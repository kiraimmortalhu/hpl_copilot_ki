void OnStart()
 
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Tesla02");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	//Debugging
		if(ScriptDebugOn()) 
		{
		//	AddEntityCollideCallback("Player", "TempLevelTrans", "LevelTransitionHandler", true, 1);
			GiveItemFromFile("lantern", "lantern.ent");
		}
				
			//ENEMY SETUP 1  (Below when entering building) DISABLED
			SetLocalVarInt("Tesla1", 5); //Set to 5 and -1 each area, as I reversed the path.
			AddEnemyPatrolNode("tesla_1", "PathNodeArea_45", 0, "", false);
			
			for(int i=1; i<=4; i++)
				AddEntityCollideCallback("tesla_1", "AreaTesla1_Flick_"+i, "CollideTesla1LightFlick", true, 1);
			
			
			//ENEMY SETUP 2 (To the right behind bars)
			AddEntityCollideCallback("Player", "AreaStartTesla2", "CollideTesla2Start", false, 1);
			
			
			//ENEMY SETUP 3 (Bridge) DISABLED
			AddEnemyPatrolNode("tesla_3", "PathNodeArea_57", 0, "", false);
			
			//ENEMY SETUP 4 (Bridge first)
			SetEntityActive("tesla_4", true);
			AddEnemyPatrolNode("tesla_4", "PathNodeArea_73", 0, "", false);
			AddTimer("tesla_4", 5, "TimerRemoveTesla4");
			
			//ENEMY SETUP 5 (By ladder behind glass)
			AddEnemyPatrolNode("tesla_5", "PathNodeArea_83", 0, "", false);
			
			//ENEMY SETUP TESLA IN GLASS LAB
			SetLocalVarString("TeslaPigTeleportTarget", "");
			SetLocalVarInt("TeslaPigKilled", 0);
			AddEntityCollideCallback("Player", "PreTeslaSound", "FinalTesla_Sound", true, 1);
			AddEntityCollideCallback("Player", "ShowPlayer", "FinalTesla_GiveThePoorThingAPointer", false, 1);
			AddEntityCollideCallback("Player", "FinalTesla_Start_1", "FinalTesla_Start", false, 1);
			AddEntityCollideCallback("Player", "FinalTesla_Start_2", "FinalTesla_Start", false, 1);
			AddEntityCollideCallback("Player", "teleporter_1", "TeleportHandler", true, 1);
			AddEntityCollideCallback("Player", "teleporter_2", "TeleportHandler", true, 1);
			AddEntityCollideCallback("Player", "FinalTesla_PreHuntVanish", "FinalTesla_PreHuntVanish", true, 1);
			AddEntityCollideCallback("Player", "FinalTeslaEndCorridor", "FinalTesla_PlayerInEndCorridor", false, 0);
			AddEntityCollideCallback("FinalTesla", "TeslaAtStart", "CheckIfTeslaAtStart", false, 0);
			AddEntityCollideCallback("FinalTesla", "TeslaTooFarBack", "CheckIfTeslaTooFarBack", false, 0);
			AddEntityCollideCallback("FinalTesla", "FinalTeslaKill", "FinalTesla_Kill", true, 1);
			AddEntityCollideCallback("FinalTesla_Hunter", "TeslaAtStart", "CheckIfTeslaAtStart", false, 0);
			AddEntityCollideCallback("FinalTesla_Hunter", "TeslaTooFarBack", "CheckIfTeslaTooFarBack", false, 0);
			AddEntityCollideCallback("FinalTesla_Hunter", "FinalTeslaKill", "FinalTesla_Kill", true, 1);
			AddEntityCollideCallback("TeslaPigKillDoor", "TeslaKillDoorLocker", "FinalTesla_LockEndDoor", true, 1);
			AddEntityCollideCallback("Player", "AreaPlayerRightSideDoor", "CollideCheckSideOfDoor", false, 0);
			
		
	//Setup Ambience Callbacks
		{
			AddEntityCollideCallback("Player", "AMBStart", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBTowerBase", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBBridge01", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "ThunderSound", "RandomSound", true, 0);
			AddEntityCollideCallback("Player", "ThunderSound_1", "RandomSound", true, 0);
			AddEntityCollideCallback("Player", "IntThunderStart", "RandomSound", true, 0);
			AddEntityCollideCallback("Player", "AMBTowerCorridor1", "MapAmbienceAreas", false, 0);
