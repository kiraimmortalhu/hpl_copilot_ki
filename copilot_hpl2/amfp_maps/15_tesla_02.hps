		AddDebugMessage("Pig Triggered", false);
		SetEntityActive("tesla_pig_1", true);
		PlaySoundAtEntity("LightsOut", "afx_tesla_02_lightsout", "Player", 0.0f, false);
		MandusReactionPlayer("Quick", 0.2f);
		AddTimer("PigBreathingHandler", 3.0f, "PigBreathingHandler");
		AddEnemyPatrolNode("tesla_pig_1", "PathNodeArea_34", 0.0f, "", false);
		AddEnemyPatrolNode("tesla_pig_1", "PathNodeArea_36", 0.0f, "", false);
		AddEnemyPatrolNode("tesla_pig_1", "PathNodeArea_37", 0.0f, "", false);
		AddEnemyPatrolNode("tesla_pig_1", "PathNodeArea_39", 0.0f, "", false);
		AddEnemyPatrolNode("tesla_pig_1", "PathNodeArea_41", 0.0f, "", false);
		}

}

