		//SOUND
		PlaySoundAtEntity("Wind1", "amb_tesla02_wind_entrance_loop.snt", "WindSource_1", 0.0f, true);
		PlaySoundAtEntity("Wind2", "amb_tesla02_wind_entrance_loop.snt", "WindSource_2", 0.0f, true);
		
		PlaySoundAtEntity("OrbHi", "tesla_orb_amb_high_loop.snt", "OrbSource", 0.0f, true);
