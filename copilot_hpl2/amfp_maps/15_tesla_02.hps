//TRIGGERED VO PLAYER
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "VO_Machine1")
	{
	AddEffectVoice3("vo_tesla2_machine_1.ogg", "", "Voice", "vo_tesla2_machine_1", 0.0f, "vo_tesla2_machine_1_1", 5.82f, "vo_tesla2_machine_1_2", 16.81f, false, "", 0.0f, 0.0f);
	return;
	}
	else if (asChild == "catwalk_scare_VO")
	{
	AddEffectVoice("vo_engine_child_whisper_1.ogg", "", "Voice", "", false, "", 0.0f, 0.0f);
	return;
	}
	else if (asChild == "VOMandusMonologue_1")
	{
	AddEffectVoice("vo_tesla2_mandus_monologue_1.ogg", "", "Voice", "vo_tesla2_mandus_monologue_1", false, "", 0.0f, 0.0f);
	return;
	}
	else if (asChild == "VOMandusMonologue_2")
	{
	AddEffectVoice("vo_tesla2_mandus_monologue_2.ogg", "", "Voice", "vo_tesla2_mandus_monologue_2", false, "", 0.0f, 0.0f);
	AddTimer("tesla_3", 3, "TimerActivateTesla3");
	return;
	}
	else if (asChild == "VOMandusMonologue_3")
	{
	SetEntityActive("LadderArea_23", true);
	AddEffectVoice("vo_tesla2_mandus_monologue_3.ogg", "", "Voice", "vo_tesla2_mandus_monologue_3", false, "", 0.0f, 0.0f);
	return;
	}
	else if (asChild == "VOMandusMonologue_4")
	{
	AddEffectVoice("vo_tesla2_mandus_monologue_4.ogg", "", "Voice", "vo_tesla2_mandus_monologue_4", false, "", 0.0f, 0.0f);
	return;
	}
	else if (asChild == "VO_Flashback1")
	{
	AddEffectVoice("vo_tesla1_mandus_flashback_1.ogg", "", "Voice", "vo_tesla1_mandus_flashback_1", false, "", 0.0f, 0.0f);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
	PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);	
	FadeImageTrailTo(2.0f, 2.5f);
	SetPlayerMoveSpeedMul(0.35f);
	SetPlayerLookSpeedMul(0.35f);
	AddTimer("ReturnToNormal", 6.0f, "RestoreToNormal");
	return;
	}
}
