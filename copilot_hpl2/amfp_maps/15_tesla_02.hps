// START TESLA 5 PIG

void TimerTesla5LightFlickOff(string &in asTimer)
{
	if(asTimer == "Tesla5_Lamp_1")
		PlaySoundAtEntity("FlickSound", "tesla_pig_light_flicker.snt", "Tesla5_Lamp_2", 0, false);
		
	SetLampLit(asTimer, false, false);
	//FadeLightTo(asTimer+"_spot", 0,0.813,1,1, -1, 0.01);
	FadeLightTo("Tesla_Light_Box_Global", 0.034,0.066,0.051,1, -1, 0.05);
	
	AddLocalVarInt("LampCount", 1);
	
	if(GetLocalVarInt("LampCount") < 42)
		AddTimer(asTimer, RandFloat(0.05,0.5), "TimerTesla5LightFlickOn");
}

void TimerTesla5LightFlickOn(string &in asTimer)
{
	if(asTimer == "Tesla5_Lamp_1")
		PlaySoundAtEntity("FlickSound", "tesla_pig_light_flicker.snt", "Tesla5_Lamp_4", 0, false);
		
	SetLampLit(asTimer, true, true);
	//FadeLightTo(asTimer+"_spot", 0.5,0.25,0.125,1, -1, 0.05);
	FadeLightTo("Tesla_Light_Box_Global", 0.068,0.113,0.103,1, -1, 0.05);
	
	if(GetLocalVarInt("LampCount") < 40)
		AddTimer(asTimer, RandFloat(0.05,0.5), "TimerTesla5LightFlickOff");
}

