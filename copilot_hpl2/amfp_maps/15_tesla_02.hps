										//////////////////////////
										//MAP-SPECIFIC FUNCTIONS//
//RANDOM SOUND TRIGGERS
void RandomSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ThunderSound"|| asChild == "ThunderSound_1")
	{									//////////////////////////
	
	//REMOVE START AREA SOUNDS
	RemoveTimer("StartAreaRandSound_1");
	RemoveTimer("StartAreaRandSound_2");
	RemoveTimer("StartAreaRandSound_3");
	RemoveTimer("InitRandomStartAreaSoundCuePlayer");
	
	//ADD THUNDER TIMER
	AddTimer("InitRandomSoundCuePlayer", 1.0f, "RandSoundCues");
	
	//ADD BRIDGE TIMER
	AddTimer("InitRandomBridgeSoundCuePlayer", 3.0f, "RandBridgeSoundCues");
	AddTimer("InitRandomBridgeArcSoundCuePlayer", 5.0f, "RandBridgeArcSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "ThunderSound");
	RemoveEntityCollideCallback("Player", "ThunderSound_1");
	AddEntityCollideCallback("Player", "ThunderStop", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "ThunderStop_1", "RandomSound", true, 1);
	
	AddDebugMessage("Thunder START!", true);
	return;
	}
	
	else if (asChild == "ThunderStop"|| asChild == "ThunderStop_1")
	{
	//REMOVE OUTSIDE SOUND
	RemoveTimer("Player");
	
	//REMOVE BRIDGE SOUNDS
	RemoveTimer("RandomBridgeSound1");
	RemoveTimer("RandomBridgeSound2");
	RemoveTimer("RandomBridgeSound3");
	RemoveTimer("RandomBridgeSound4");
	RemoveTimer("RandomBridgeSound5");
	RemoveTimer("Sound_ArcBridge_20");
	RemoveTimer("Sound_ArcBridge_1");
	RemoveTimer("Sound_ArcBridge_2");
	RemoveTimer("Sound_ArcBridge_3");
	RemoveTimer("Sound_ArcBridge_4");
	RemoveTimer("Sound_ArcBridge_5");
	RemoveTimer("Sound_ArcBridge_6");
	RemoveTimer("Sound_ArcBridge_7");
	RemoveTimer("Sound_ArcBridge_8");
	RemoveTimer("Sound_ArcBridge_9");
	RemoveTimer("Sound_ArcBridge_10");
	RemoveTimer("Sound_ArcBridge_11");
	RemoveTimer("Sound_ArcBridge_12");
	RemoveTimer("Sound_ArcBridge_13");
	RemoveTimer("Sound_ArcBridge_14");
	RemoveTimer("Sound_ArcBridge_15");
	RemoveTimer("Sound_ArcBridge_16");
	RemoveTimer("Sound_ArcBridge_17");
	RemoveTimer("Sound_ArcBridge_18");
	RemoveTimer("Sound_ArcBridge_19");
	RemoveTimer("Sound_ArcBridge_21");
	RemoveTimer("Sound_ArcBridge_22");
	RemoveTimer("RandBridgeArcSoundCues");
	RemoveTimer("InitRandomBridgeArcSoundCuePlayer");
	
	//TRIGGER SOUNDS
	if (asChild == "ThunderStop")
		AddTimer("InitRandomStartAreaSoundCuePlayer", 3.0f, "RandStartAreaSoundCues");
		
	//AREAS
	RemoveEntityCollideCallback("Player", "ThunderStop");
	RemoveEntityCollideCallback("Player", "ThunderStop_1");
	AddEntityCollideCallback("Player", "ThunderSound", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "ThunderSound_1", "RandomSound", true, 1);
		
			
	AddDebugMessage("Thunder STOP!", true);
	return;
	}
	
	else if (asChild == "IntThunderStart")
	{
	//TRIGGER SOUNDS
	AddTimer("IInitRandInteriorThunderSoundCues", 3.0f, "RandInteriorThunderSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "IntThunderStart");
	AddEntityCollideCallback("Player", "IntThunderStop", "RandomSound", true, 1);
	
	AddDebugMessage("Int Thunder Start", true);
	}
	
	else if (asChild == "IntThunderStop")
	{
	//REMOVE SOUNDS
	RemoveTimer("Player");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "IntThunderStop");
	AddEntityCollideCallback("Player", "IntThunderStart", "RandomSound", true, 1);
	
	AddDebugMessage("Int Thunder Stop", true);
	}
}				

//LEVEL TRANSITION HANDLER
void LevelTransitionHandler (string &in asParent, string &in asChild, int alState)
{
	StopSound("spark_l_end", 0);
	StopSound("spark_2_end", 0);
	StopSound("spark_3_end", 0);
	StopSound("spark_4_end", 0);
	StopSound("heartbeat1", 5);
	StopSound("OrbHi", 4.f); 
	StopSound("OrbLo", 4.f); 
	StopSound("OrbElec", 4.f); 
	StopSound("AMBTowerBase", 4.f);
	StopSound("amb_tesla_armonica_under", 4.f);

	CreateParticleSystemAtEntity("spark", "ps_electro_bolt_tank.ps", "heart_increase_1", false);
	PlaySoundAtEntity("sparks", "afx_pigline_electricity_loop.snt", "heart_increase_1", 0.5, false);
	PlaySoundAtEntity("thunder", "afx_pigline_electrical_arc.snt", "heart_increase_1", 0, false);
	PlaySoundAtEntity("sparksoound", "afx_events_mansion_entrance_thunder.snt", "heart_increase_1", 0, false);
	PlaySoundAtEntity("whoosh", "afx_tesla02_lightup.snt", "Player", 0, false);
	StartScreenShake(0.1, 1, 0.5, 2);
	FadeLightTo("PointLight_1", -1,-1,-1,-1,20,1);
	AddTimer("1", 1, "TimerEndStuff");
	AddTimer("2", 2, "TimerEndStuff");
	AddTimer("2.5", 4, "TimerEndStuff");
	AddTimer("3", 7, "TimerEndStuff");
	SetPlayerMoveSpeedMul(0.5);
	SetPlayerRunSpeedMul(0);
	SetPlayerLookSpeedMul(0.7);
	
	SetLanternActive(false, true);
}
void TimerEndStuff(string &in asTimer)
{
	if(asTimer == "1")
	{
		StartEffectFlash(6.0f, 16.0f, 3.0f);
		StartPlayerLookAt("heart_increase_1", 2, 2, "");
		StopSound("sparks", 4);
	}
	
	if(asTimer == "2")
	{
		//FadeOut(3);
		FadeLightTo("PointLight_1", -1,-1,-1,-1,0,5);
		
		AddTimer("PreLevelChange", 8.0f, "PreLevelLoader");
		AddTimer("LevelChangeStingSound", 4.23f, "LevelSoundSting");
		AddEffectVoice("vo_tesla1_mandus_flashback_1.ogg", "", "Voice", "vo_tesla1_mandus_flashback_1", false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("Whisper", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("HighTone", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
		PlayMusic("music_tesla02_transition_21.ogg", false, 0.55f, 2.0f, 2, false);
	}
	
	if(asTimer == "2.5")
	{
		SetPlayerActive(false);
	}
	
	if (asTimer == "3")
	{
		StopSound("thunder", 3.f);
		StopSound("sparksoound", 3.f);
		StopSound("whoosh", 3.f);
		StopSound("Whisper", 3.f);
		StopSound("HighTone", 3.f);
	}
}
void LevelSoundSting (string &in asTimer)
{
PlaySoundAtEntity("", "afx_tesla_sting.snt", "Player", 0.2f, false);
}

void PreLevelLoader (string &in asTimer)
{
	StopSound("heartbeat3", 1.0f);
	//StartEffectFlash(7.0f, 1.0f, 0.0f);
	AddTimer("LevelTransitionBuffer", 0.0f, "LevelLoader");
}

void LevelLoader (string &in asTimer)
{
	ChangeMap("16_temple.map", "MainStart", "", "");
	SetupLoadScreen("LoadingText", "Temple_", 3, "game_loading_temple.jpg");
}
//END LEVEL TRANSITION HANDLER

//WIND DOOR
	void WindSampleLoop (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Wind Sample 1 on", true);
		PlaySoundAtEntity("WindSample1", "afx_ambience_mansion_wind_spot.snt", "WindDoorSoundSource", 1.0f, false);
		return;
	}
	else if (alState == -1) 
	{
		AddDebugMessage("Wind Stop", false);
		StopSound("WindSample1", 1.0f);
		return;
	}
}

	void WindSampleGush (string &in asParent, string &in asChild, int alState)
{
		if (alState == 1)
	{
		AddDebugMessage("Wind Gush Triggered", true);
		//PlaySoundAtEntity("WindGush", "afx_events_tesla02_windgust.snt", "WindDoorSoundSource", 0.0f, false);
		RemoveEntityCollideCallback("tesla_ents_core_door_19", "WindDoorGushTrigger");
		return;
	}
			else if (alState == -1) 
	{
		AddTimer("WindGushTimer", 3.0f, "WindGushTimer");
		AddDebugMessage("Wind Gush Area Timer Started", false);
		return;
	}
}
	
	void WindGushTimer(string &in asTimer)
	{
		AddEntityCollideCallback("tesla_ents_core_door_19", "WindDoorGushTrigger", "WindSampleGush", false, 0);
		AddDebugMessage("Wind Gush Area Returned", true);
	}
	

//HINT TRIGGER//
//STOLE THIS TO MAKE CLOSE OF DOOR EVENT INSTEAD, HINT ADDED IN NEXT TIMER.
void AddHint (string &in asParent, string &in asChild, int alState)
{
	RemoveEntityCollideCallback("Player", "HintTrigger_1");
	RemoveEntityCollideCallback("Player", "HintTrigger_2");
	
	FadeImageTrailTo(2,2);
	PlayGuiSound("cellar_light_flicker_02.ogg", 0.8f);

	StartScreenShake(0.05, 0.4, 0.1, 0.1);
	AddTimer("lockdoor", 0.6, "TimerLockEntrance");

	//Turn off these as they shine through wall.
	SetLightVisible("SpotLight_87", false);
	SetLightVisible("SpotLight_88", false);
	SetLightVisible("SpotLight_95", false);
	SetLightVisible("SpotLight_94", false);
	
	//SetEntityActive("tesla_1", true);
	AddTimer("tesla1_1",0.2, "TimerFakeTesla1");
	AddTimer("tesla1_2",2, "TimerFakeTesla1");
	AddTimer("tesla1_3",3.8, "TimerFakeTesla1");
	AddTimer("tesla1_4",5, "TimerFakeTesla1");
	AddTimer("tesla1_5", 6, "TimerFakeTesla1");
	SetLanternFlickerActive(true);
	
	PlayMusic("music_bath_spin_sting_24.ogg", false, 0.2f, 0.6f, 8, false);
	
	SetPlayerRunSpeedMul(0);
}

void TimerLockEntrance(string &in asTimer)
{
	AddHint("TeslaTwo1", "");
	
	PlayGuiSound("afx_church_altar_lever_on.ogg", 1);
	
	FadeImageTrailTo(0,0.5f);
	StartScreenShake(0.3, 0.1, 0.0, 0.0);
	SetSwingDoorLocked("tesla_ents_door_01_gate_5", true, true);
}

void TimerFakeTesla1(string &in asTimer)
{
	if(asTimer == "tesla1_5")
	{
		SetEntityActive("AreaStartTesla2", true);
		TeslaRemove("", "");
		return;
	}
	if(asTimer == "tesla1_2")
		PlaySoundAtEntity("tes5enbld", "tesla_amb_idle.snt", "AreaStartTesla2", 3, true);
	
	CollideTesla1LightFlick("tesla_1", asTimer, 1);
}

//END HINT TRIGGER//


/////////////////////////////////////////////////
// START TESLA 1 PIG

void CollideTesla1LightFlick(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Pig in: "+asChild, false);
	AddLocalVarInt("Tesla1", -1);
	
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(0.0,0.2), "TimerTesla1LightFlickOff");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(0.3,0.4), "TimerTesla1LightFlickOn");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(0.45,0.7), "TimerTesla1LightFlickOff");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(0.8,1.0), "TimerTesla1LightFlickOn");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(1.1,1.3), "TimerTesla1LightFlickOff");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(1.35,1.5), "TimerTesla1LightFlickOn");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(1.6,1.75), "TimerTesla1LightFlickOff");
	AddTimer("Tesla1Lamp_"+GetLocalVarInt("Tesla1"), RandFloat(1.8,2), "TimerTesla1LightFlickOn");
}

void TimerTesla1LightFlickOff(string &in asTimer)
{
	PlaySoundAtEntity("FlickSound", "tesla_pig_light_flicker.snt", asTimer, 0, false);
	SetLampLit(asTimer, false, false);
	FadeLightTo(asTimer+"_spot", 0,0.813,1,1, -1, 0.01);
	FadeLightTo("Tesla_Light_Box_Global", 0.034,0.066,0.051,1, -1, 0.05);
}

void TimerTesla1LightFlickOn(string &in asTimer)
{
	//PlaySoundAtEntity("FlickSound", "tesla_pig_light_flicker.snt", asTimer, 0, false);
	SetLampLit(asTimer, true, true);
	FadeLightTo(asTimer+"_spot", 0.5,0.25,0.125,1, -1, 0.05);
	FadeLightTo("Tesla_Light_Box_Global", 0.068,0.113,0.103,1, -1, 0.05);
}

void TeslaRemove(string &in asEntity, string &in asType)
{
	StartScreenShake(0.011, 0.2, 2, 2);
	PlayGuiSound("amb_tesla_granulized_scream_0"+RandInt(1,4)+".ogg", 0.3);
	FadeImageTrailTo(1.5,0.8);
	AddTimer("tes_sound", RandFloat(1,3), "TimerDisableTeslaSound");
	AddTimer("stop_trail", 2, "TimerDisableTeslaSound");
}


void TeslaRemoveSilent(string &in asEntity, string &in asType)
{
	SetLanternFlickerActive(false);
}

void TimerDisableTeslaSound(string &in asTimer)
{
	if(asTimer == "stop_trail")
	{
		FadeImageTrailTo(0,0.7f);
		return;
	}
	
	SetLanternFlickerActive(false);
}

// STOP TESLA 1 PIG
