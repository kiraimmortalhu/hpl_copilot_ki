		AddEntityCollideCallback("Player", "HintTrigger_1", "AddHint", false, 1);
		AddEntityCollideCallback("Player", "HintTrigger_2", "AddHint", false, 1);
		}
	
	
	//AutoRun Events
		{		
			// SOUND
			AddTimer("InitRandomStartAreaSoundCuePlayer", 3.0f, "RandStartAreaSoundCues");
			StopMusic(10.0f, 2);
			StopMusic(10.0f, 3);
			
			SetLightFlickerActive("SpotLight_3", false);
