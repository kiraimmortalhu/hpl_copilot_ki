		PlaySoundAtEntity("Heatsink2D5", "amb_tesla02_heatsink_2D.snt", "CoolantSource_5", 0.0f, true);
		
		//WIND SAMPLES FOR DOOR
		AddEntityCollideCallback("tesla_ents_core_door_19", "WindDoorLoopTrigger", "WindSampleLoop", false, 0);
		AddEntityCollideCallback("tesla_ents_core_door_19", "WindDoorGushTrigger", "WindSampleGush", false, 0);
		
		}

	//MUSIC CALLBACKS
