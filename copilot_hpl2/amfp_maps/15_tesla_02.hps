//Setup Initial VO Callbacks
		{
			AddEntityCollideCallback("Player", "VO_Machine1", "VOPlayer", true, 1);
			AddEntityCollideCallback("Player", "VOMandusMonologue_1", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "VOMandusMonologue_2", "VOPlayer", true, 0);
