//Armonica Handlers
void armonica_on_1(string &in asEntity)
{
AddLocalVarInt("Armonica_Sequence_Complete", 1);
AddDebugMessage("Armonica 1 Fired", false);
PlayPropAnimation("armonica1", "spinning", 1.0f, true, "");
SetParticleSystemActive("armonica_sparks_2", true);
SetParticleSystemActive("armonica_sparks_7", true);
PlaySoundAtEntity("armonica1sound", "afx_armonica_1", "armonica1", 0.75f, true);
SetEntityInteractionDisabled(asEntity, true);
SetLightVisible("BoxLight_1", true);
PlaySoundAtEntity("spark_l_end", "amb_tesla_electricity_loop_verb.snt", "SparkSound_1", 1, true);
armonicacomplete();
}

