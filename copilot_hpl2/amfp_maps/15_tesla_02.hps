//THIS WAY HANDLER//
void ThisWayHandler (string &in asParent, string &in asChild, int alState) 
{
		if (asChild == "thisway_1")
		{
			SetPlayerRunSpeedMul(0.2);
			
			PlaySoundAtEntity("thisway1sound", "tesla_female_voice_1", "CoolantSource_4", 0.0f, false);
		}
		else if (asChild == "thisway_2")
		{
			SetPlayerRunSpeedMul(0.6);
			
			if(!GetEffectVoiceActive())
			{
				//SetLanternFlickerActive(true);
				
				//SetLocalVarInt("LampCount", -20);
				SetEntityActive("tesla_5", true);
				
				PlaySoundAtEntity("tes5enbld", "engineer_amb_idle.snt", "tesla_5", 2, true);
				PlaySoundAtEntity("door", "bulkhead_door_open_2D.snt", "tesla_5", 0, false);
				
			//	for(int i=1;i<=5;i++)
			//		AddTimer("Tesla5_Lamp_"+i, RandFloat(0.1,0.5), "TimerTesla5LightFlickOff");
					
				return;
			}  
			else
				PlaySoundAtEntity("thisway2sound", "tesla_female_voice_3", "oohsource_1", 0.0f, false);
		}
		else if (asChild == "thisway_3")
		{
			if(GetEffectVoiceActive())
			{
				SetPlayerRunSpeedMul(0.4);
				
				SetLanternFlickerActive(true);
			
				//Flicker lights and play tesla pig noise
				for(int i=1;i<=5;i++)
				{
					AddTimer("Tesla5_Lamp_"+i, RandFloat(0.1,0.5), "TimerTesla5LightFlickOff");
				}
			
				AddTimer("tesla1_5", 4, "TimerFakeTesla1");
				
				PlaySoundAtEntity("tes5enbld", "tesla_amb_idle.snt", "Tesla5_Lamp_2", 3, true);
			}
			else
				PlaySoundAtEntity("thisway3sound", "tesla_female_voice_2", "oohsource_2", 0.0f, false);
		}
}
//END THIS WAY HANDLER//

//RESTORE TO NORMAL//
void RestoreToNormal (string &in asTimer)
{
//RETURN TO NORMAL VISION
	if (asTimer == "ReturnToNormalVision")
	{
		FadeRadialBlurTo(0.0f, 4.0f);
		FadeImageTrailTo(0.0f, 4.0f);
		return;
	}

//RETURN TO NORMAL ALL//
	else if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		StopPlayerLookAt();
		return;
	}
	
//END VISUAL EFFECT FOR SCREAM//
	else if (asTimer == "EndVisEffect")
	{
		FadeImageTrailTo(0.0f, 0.5f);
		FadeSepiaColorTo(0.0f, 0.5f);
		return;
	}
}
//END RESTORE TO NORMAL//


