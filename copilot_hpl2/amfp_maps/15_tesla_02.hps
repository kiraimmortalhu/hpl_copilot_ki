//Armonica Completed
void armonicacomplete()
{

	if(GetLocalVarInt("Armonica_Sequence_Complete") == 1) 
	{
		AddTimer("arm_loop", 1, "TimerArmonicLoop");
		SetLightVisible("BoxLight_8", true);
		SetLightVisible("BoxLight_6", true);
	}
	if(GetLocalVarInt("Armonica_Sequence_Complete") == 3){
		SetLightVisible("BoxLight_7", true);
		SetLightVisible("BoxLight_5", true);
	}

	if(GetLocalVarInt("Armonica_Sequence_Complete") == 4)
    {
		AddDebugMessage("Armonica 4 Fired", false);
		SetEntityActive("LightBeam", true);
		SetEntityActive("ghost_2", false);
		SetEntityActive("ghost_1", false);
		AddTimer("LightsOut_Lights", 1.0f, "LightsOutTimer");
		AddTimer("LightsOut_Voice", 5.0f, "LightsOutTimer");
		AddTimer("LightsOut_Music", 16.0f, "LightsOutTimer");
		PlaySoundAtEntity("heartbeat1", "afx_telsa_heartbeat_slow.snt", "heart", 8.0f, true);
		PlaySoundAtEntity("amb_tesla_armonica_under", "amb_tesla_armonica_under.snt", "heart", 12.0f, true);
		AddEntityCollideCallback("Player", "TempLevelTrans", "LevelTransitionHandler", true, 1);
    }
}

void TimerArmonicLoop(string &in asTimer)
{
	if(GetLocalVarInt("Armonica_Sequence_Complete") == 1) 
	{
		PlayGuiSound("afx_sewer_pipetremor_01.ogg", 0.2f);
		FadeImageTrailTo(1,1);
		StartScreenShake(0.01, 3, 3, 1);
	}
	if(GetLocalVarInt("Armonica_Sequence_Complete") == 2) 
	{
		PlayGuiSound("afx_sewer_pipetremor_03.ogg", 0.5f);
		FadeImageTrailTo(1.25,1);
		StartScreenShake(0.02, 1, 4, 1);
	}
	if(GetLocalVarInt("Armonica_Sequence_Complete") == 3) 
	{
		FadeImageTrailTo(1.5,1);
		StartScreenShake(0.03, 2, 3, 1);
		PlayGuiSound("afx_sewer_pipetremor_02.ogg", 0.3f);
	}
	if(GetLocalVarInt("Armonica_Sequence_Complete") == 4) 
	{
		PlaySoundAtEntity("tremor", "afx_sewer_pipetremor.snt", "Player", 12.0f, true);
		FadeImageTrailTo(1.75,1);
		StartScreenShake(0.04, 1, 4, 1);
	}
	
	AddTimer("arm_loop", 7, "TimerArmonicLoop");
	AddTimer("arm_loop_2", 3.5, "TimerArmonicLoopStopFade");
}

void TimerArmonicLoopStopFade(string &in asTimer)
{
	FadeImageTrailTo(0,1);
}

//END ARMONICA SEQUENCE

// HEART INCREASE HANDLER
void HeartHandler (string &in asParent, string &in asChild, int alState) 
{
	AddLocalVarInt("HeartMod", alState);
	
	SetPlayerMoveSpeedMul(1-GetLocalVarInt("HeartMod")*0.1);
	SetPlayerLookSpeedMul(1-GetLocalVarInt("HeartMod")*0.1);
	SetPlayerRunSpeedMul(1-GetLocalVarInt("HeartMod")*0.1);
	
	if(asChild == "heart_increase_3" && alState == 1)
	{
		FadeImageTrailTo(2,2);
	}
	else if(asChild == "heart_increase_3" && alState == -1)
		FadeImageTrailTo(0,1);
		
	if(asChild == "heart_increase_6" && alState == -1)
	{
		StopSound("heartbeat3", 0.5f);
		SetPlayerMoveSpeedMul(1);
		SetPlayerLookSpeedMul(1);
		SetPlayerRunSpeedMul(1);
		SetLocalVarInt("HeartMod", 0);
	}
	else if(asChild == "heart_increase_6" && alState == 1)
		PlaySoundAtEntity("heartbeat3", "afx_telsa_heartbeat_fast.snt", "heart", 2.0f, true);
}

