			AddEntityCollideCallback("Player", "MusicTrigger01", "MusicHandler", true, 0);
			AddEntityCollideCallback("Player", "tesla_ambience_music", "MusicHandler", true, 0);
			AddEntityCollideCallback("Player", "thisway_1", "ThisWayHandler", true, 1);
			AddEntityCollideCallback("Player", "thisway_2", "ThisWayHandler", true, 1);
			AddEntityCollideCallback("Player", "thisway_3", "ThisWayHandler", true, 1);
