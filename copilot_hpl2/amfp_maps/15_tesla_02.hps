		PlaySoundAtEntity("Heatsink2D1", "amb_tesla02_heatsink_2D.snt", "CoolantSource_1", 0.0f, true);
		PlaySoundAtEntity("Heatsink3D2", "amb_tesla02_heatsink_3D.snt", "CoolantSource_2", 0.0f, true);
