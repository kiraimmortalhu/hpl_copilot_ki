//RANDOMISED SOUND CUE PLAYER//
void RandSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "tesla02_thunder.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Thunder Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(6.0f, 12.0f), "RandSoundCues");
}

