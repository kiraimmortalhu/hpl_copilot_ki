//------------------------
// FINAL TESLA ENCOUNTER //
//------------------------

//-------------------------------------------------------------

void FinalTesla_Start(string &in asParent, string &in asChild, int alState)
{	
	RemoveEntityCollideCallback("Player", "FinalTesla_Start_1");
	RemoveEntityCollideCallback("Player", "FinalTesla_Start_2");
	
	SetPlayerRunSpeedMul(0.0f);
	AddTimer("ReturnToNormal", 2.f, "RestoreToNormal");
	
	SetLightFlickerActive("SpotLight_3", true);
	SetLampFlickerActive("Lampy", true);
	SetLampFlickerActive("FinalTesla_Lamp_1_0", false);
	AddTimer("FinalTesla_Blackout4", 0.5f,"FinalTesla_Blackout4");
	AddTimer("FinalTesla_Blackout3", 1.0f,"FinalTesla_Blackout3");
	AddTimer("FinalTesla_Blackout2", 1.5f,"FinalTesla_Blackout2");
	AddTimer("FinalTesla_Blackout1", 2.0f,"FinalTesla_Blackout1");
	AddTimer("FinalTesla_SpawnPig", 2.5f, "FinalTesla_SpawnPig");
	
	SetLocalVarInt("TeslaPigTeleport_1", 0);
	
	PlayMusic("music_church_factory_pig.ogg", true, 0.7f, 6.0f, 3, false);
	
	AddEntityCollideCallback("Player", "FinalTesla_LastHunt", "FinalTesla_LastHunt", true, 1);
	
	CheckPoint("CheckPoint_FinalTesla", "teleport_target_1", "CheckPoint_FinalTesla", "", "", false);
	
	LanternFlicker(4);
}

//-------------------------------------------------------------

void FinalTesla_Start_SecondTry(string &in asParent, string &in asChild, int alState)
{	
	RemoveEntityCollideCallback("Player", "TeleportTrigger_3");
	RemoveEntityCollideCallback("Player", "TeleportTrigger_5");
	SetLampFlickerActive("FinalTesla_Lamp_1_0", false);
	AddTimer("FinalTesla_Blackout4", 0.25f,"FinalTesla_Blackout4");
	AddTimer("FinalTesla_Blackout3", 0.625f,"FinalTesla_Blackout3");
	AddTimer("FinalTesla_Blackout2", 1.0f,"FinalTesla_Blackout2");
	AddTimer("FinalTesla_Blackout1", 1.375f,"FinalTesla_Blackout1");
	
	AddTimer("FinalTesla_SpawnPig", 3.0f, "FinalTesla_SpawnPig");
	TeleportEnemyToNode("FinalTesla", "PathNodeArea_95", true);
	
	SetLocalVarInt("TeslaPigTeleport_1", 0);
	SetLocalVarInt("TeslaTooFarBack", 1);
	SetLocalVarInt("TeslaAtStart", 1);
	
	PlayMusic("music_church_factory_pig.ogg", true, 1.0f, 6.0f, 3, false);
	
	AddEntityCollideCallback("Player", "FinalTesla_LastHunt", "FinalTesla_LastHunt", true, 1);
	
	CheckPoint("CheckPoint_FinalTesla", "teleport_target_1", "CheckPoint_FinalTesla", "", "", false);
	
	LanternFlicker(4);
}

//-------------------------------------------------------------

void FinalTesla_Sound (string &in asParent, string &in asChild, int alState)
{
	//*InsertSoundHere*: Sound that indicates that a tesla pig is nearby
	PlaySoundAtEntity("t1", "afx_tesla_teslapigevent_01.snt", "Player", 1.0f, false);
}

void CheckIfTeslaAtStart(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("TeslaAtStart", alState);
}

void CheckIfTeslaTooFarBack(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("TeslaTooFarBack", alState);
}

void FinalTesla_GiveThePoorThingAPointer(string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("TeslaAtStart") != 1) return;
	
	if (GetLocalVarInt("TeslaPigTeleport_1") == 0)
	{
		RemoveTimer("NoProgressTeleport");
		RemoveTimer("NoProgressTeleport_Triggers");
		AddTimer("NoProgressTeleport", 20, "FinalTesla_NoProgressVanish");
		SetLocalVarInt("TeslaPigTeleport_1", 1);
		FinalTesla_HandlePigTeleport("PathNodeArea_120", 0, 1.f);
	}
	else
	{
		string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
		ShowEnemyPlayerPosition(sActiveTesla);
	}
}

void CheckPoint_FinalTesla(string &in asName, int alCount)
{	
	StopMusic(1.0f, 3);
	
	SetLampFlickerActive("FinalTesla_Lamp_1_0", true);
	SetLampLit("FinalTesla_Lamp_*", true, false);
	
	RemoveTimer("FinalTesla_LastHuntLoop");
	RemoveTimer("NoProgressTeleport");
	RemoveTimer("NoProgressTeleport_Triggers");
	RemoveTimer("Vanish_1");
	RemoveTimer("Vanish_2");
	RemoveTimer("Teleport_1");
	RemoveTimer("Teleport_2");
	SetLocalVarInt("TeslaPigTeleport_1", 0);
	
	for (int i = 1; GetEntityExists("TeleportTrigger_" + i); i++)
	{
		RemoveEntityCollideCallback("Player", "TeleportTrigger_" + i);
	}
	
	RemoveEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_1");
	RemoveEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_2");
	RemoveEntityCollideCallback("Player", "ShowPlayer");
	
	AddEntityCollideCallback("Player", "FinalTesla_LastHunt", "FinalTesla_LastHunt", true, 1);
	
	AddEntityCollideCallback("Player", "FinalTesla_PreHuntVanish", "FinalTesla_PreHuntVanish", true, 1);
	
	// Different encounter
	if (alCount == 1)
	{
		AddEntityCollideCallback("Player", "TeleportTrigger_3", "FinalTesla_Start_SecondTry", false, 1);
		AddEntityCollideCallback("Player", "TeleportTrigger_5", "FinalTesla_Start_SecondTry", false, 1);
	}
	
	// Just the end hunt
	else if(alCount >= 2) 
	{
		RemoveEntityCollideCallback("Player", "FinalTesla_PreHuntVanish");
		AddEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_1", "FinalTesla_PreHuntTeleport", false, 1);
	}
}

//-------------------------------------------------------------

void FinalTesla_Blackout4(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_4_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout3(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_3_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout2(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_2_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout1(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_1_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
	
	SetLightVisible("BoxLight_1", false);
}

//-------------------------------------------------------------

void FinalTesla_SpawnPig( string &in asTimer )
{
	SetLocalVarString("ActiveTeslaPig", "FinalTesla");
	SetEntityActive("FinalTesla", true);
	
	AddTimer("FinalTesla_LastHunt", 5, "FinalTesla_LastHunt");
	AddTimer("NoProgressTeleport", 20, "FinalTesla_NoProgressVanish");
			
	PlaySoundAtEntity("", "afx_tesla01_pigroar.snt", "FinalTesla", 0.0f, false);
	
	//MandusReactionPlayer("Quick", 0.7f);
	//MandusReactionPlayer("Breath", 4.0f);
}

void FinalTesla_NoProgressVanish( string &in asTimer )
{
	if (asTimer == "NoProgressTeleport")
	{
		SetLocalVarInt("TeslaPigTeleport_1", 1);
		FinalTesla_TeleportPigSequence("Vanish_1");
		AddTimer("NoProgressTeleport_Triggers", 4, "FinalTesla_NoProgressVanish");
	}
	else
	{
		for (int i = 1; GetEntityExists("TeleportTrigger_" + i); i++)
		{
			AddEntityCollideCallback("Player", "TeleportTrigger_" + i, "FinalTesla_NoProgressTeleport", true, 1);
		}
	}
}

void FinalTesla_NoProgressTeleport(string &in asParent, string &in asChild, int alState)
{
	string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
	if (GetEntityActive(sActiveTesla)) return;
	
	FinalTesla_TeleportPig(asChild + "_Node");
}

void FinalTesla_PreHuntVanish (string &in asParent, string &in asChild, int alState)
{
	RemoveTimer("NoProgressTeleport");
	RemoveTimer("NoProgressTeleport_Triggers");
	
	string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
	if (GetEntityActive(sActiveTesla))
	{
		if (GetLocalVarInt("TeslaTooFarBack") != 1) return;
		
		FinalTesla_TeleportPigSequence("Vanish_1");
	}
	
	AddEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_1", "FinalTesla_PreHuntTeleport", false, 1);
	AddEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_2", "FinalTesla_PreHuntTeleport", false, 1);
}

void FinalTesla_PreHuntTeleport (string &in asParent, string &in asChild, int alState)
{
	RemoveEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_1");
	RemoveEntityCollideCallback("Player", "FinalTesla_PreHuntTeleport_2");
	
	if (asChild == "FinalTesla_PreHuntTeleport_1")
	{
		SetLocalVarString("ActiveTeslaPig", "FinalTesla_Hunter");
		SetLocalVarInt("TeslaTooFarBack", -1);
		SetLocalVarInt("TeslaAtStart", -1);
		FinalTesla_TeleportPig("PathNodeArea_139");
	}
	else
		FinalTesla_TeleportPig("PathNodeArea_111");
	
}

void FinalTesla_LastHunt(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Final Hunt Start!", false);
	string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
	
	if(GetLocalVarInt("TeslaTooFarBack") == 1) 
		TeleportEnemyToNode(sActiveTesla, "PathNodeArea_116", true);
	
	SetTeslaPigEasyEscapeDisabled(sActiveTesla, true);
	
	LanternFlicker(3);

	FinalTesla_LastHuntLoop("");
}

void FinalTesla_LastHuntLoop(string &in asTimer)
{
	string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
	ShowEnemyPlayerPosition(sActiveTesla);
	
	AddTimer("FinalTesla_LastHuntLoop", 0.5f, "FinalTesla_LastHuntLoop");
}

void FinalTesla_PlayerInEndCorridor (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("FinalTesla_PlayerInEndCorridor", false);
	SetEntityActive("FinalTeslaKill", alState == 1);
	SetEntityActive("TeslaKillDoorLocker", alState == 1);
}

void FinalTesla_LockEndDoor (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("TeslaPigKilled") == 1) return;
	
	AddDebugMessage("FinalTesla_LockEndDoor", false);
	SetSwingDoorLocked("TeslaPigKillDoor", true, true);
		
	SetLocalVarInt("TeslaPigKilled", 1);
	FinalTesla_TeleportPigSequence("Vanish_1");
	PlaySoundAtEntity("t1", "afx_tesla_teslapigevent_01.snt", "Player", 0.5f, false);
	RemoveTimer("FinalTesla_LastHuntLoop");
	StopMusic(1,3);
}

void FinalTesla_Kill (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("TeslaPigKilled") == 1) return;
	
	SetLocalVarInt("TeslaPigKilled", 1);
	FinalTesla_TeleportPigSequence("Vanish_1");
	PlaySoundAtEntity("t1", "afx_tesla_teslapigevent_01.snt", "Player", 0.5f, false);
	if(GetLocalVarInt("PlayerSideDoor") == 1) SetSwingDoorLocked("TeslaPigKillDoor", true, true);
	RemoveTimer("FinalTesla_LastHuntLoop");
	StopMusic(1,3);
}

void FinalTesla_HandlePigTeleport(string &in asTargetNode, float afStartDelay, float afQuietTime)
{
	AddTimer("Vanish_1", afStartDelay, "FinalTesla_TeleportPigSequence");
	AddTimer(asTargetNode, afStartDelay+afQuietTime, "FinalTesla_TeleportPig");
}

void FinalTesla_TeleportPig(string &in asNode)
{
	SetLocalVarString("TeslaPigTeleportTarget", asNode);
	FinalTesla_TeleportPigSequence("Teleport_1");
}

void FinalTesla_TeleportPigSequence (string &in asTimer)
{
	string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
	
	// Disappear
	if (asTimer == "Vanish_1")
	{
		SetTeslaPigFadeDisabled(sActiveTesla, true);
		FadeOut(0.2f);
		AddTimer("Vanish_2", 0.2f, "FinalTesla_TeleportPigSequence");
		
		StartScreenShake(0.05, 0.3, 0.1, 0.1);
	}
	else if (asTimer == "Vanish_2")
	{
		AddDebugMessage("DISAPPEARANCE!", false);
		FadeIn(0.1f);
		PlaySoundAtEntity("", "tesla_teleport.snt", sActiveTesla, 0.0f, false);
		CreateParticleSystemAtEntity("", "tesla_teleport.ps", sActiveTesla, false);
		SetEntityActive(sActiveTesla, false);
		SetTeslaPigFadeDisabled(sActiveTesla, false);
	}
	
	// Reappear
	else if (asTimer == "Teleport_1")
	{
		FadeOut(0.2f);
		AddTimer("Teleport_2", 0.2f, "FinalTesla_TeleportPigSequence");
		
		StartScreenShake(0.05, 0.6, 0.25, 0.25);
	}
	else if (asTimer == "Teleport_2")
	{
		AddDebugMessage("REAPPEARANCE!", false);
		
		FadeIn(0.1f);
		SetEntityActive(sActiveTesla, true);
		SetEnemyDisableTriggers(sActiveTesla, true);
		ForceEnemyWaitState(sActiveTesla);
		ForceTeslaPigSighting(sActiveTesla);
		TeleportEnemyToNode(sActiveTesla, GetLocalVarString("TeslaPigTeleportTarget"), true);
		CreateParticleSystemAtEntity("", "tesla_teleport.ps", sActiveTesla, false);
		PlaySoundAtEntity("", "tesla_teleport.snt", sActiveTesla, 0.0f, false);
		
		AddTimer("Teleport_3", 3.0f, "FinalTesla_TeleportPigSequence");
	}
	else if (asTimer == "Teleport_3")
	{
		SetEnemyDisableTriggers(sActiveTesla, false);
		//ShowEnemyPlayerPosition(sActiveTesla);
	}
}

void CollideCheckSideOfDoor(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("PlayerSideDoor", alState);
}
//-------------------------------------------------------------


//----------------------------
//ENCOUNTER HELPERS//
//----------------------------

//-------------------------------------------

void LanternFlicker(float afTime)
{
	SetLanternFlickerActive(true);
	
	AddTimer("LanternFlickerOff", afTime, "TimerLanternFlickerOff");
}

void TimerLanternFlickerOff(string &in asTimer)
{
	SetLanternFlickerActive(false);
}

//-------------------------------------------

void StartLampFlicker(string &in asLamp)
{
	AddTimer(asLamp, RandFloat(0.0f, 0.3f), "TimerLampFlickerOff");
}

void StopLampFlicker(string &in asLamp)
{
	RemoveTimer(asLamp);
	SetLampLit(asLamp, true, false);
}

void StartLampFlickerBurst(string &in asLamp, float afTime)
{
	StartLampFlicker(asLamp);
	AddTimer(asLamp, afTime, "TimerLampFlickerStop");
}

void TimerLampFlickerOff(string &in asLamp)
{
	SetLampLit(asLamp, false, false);
	AddTimer(asLamp, RandFloat(0.1f, 0.2f), "TimerLampFlickerOn");
}

void TimerLampFlickerOn(string &in asLamp)
{
	SetLampLit(asLamp, true, false);
	AddTimer(asLamp, RandFloat(0.05f, 0.15f), "TimerLampFlickerOff");
	
	//*InsertSoundHere*: Sound that fits with the lamps in this level, make sure there is a pretty good distance to the sound
}

void TimerLampFlickerStop(string &in asLamp)
{
	StopLampFlicker(asLamp);
}

//-------------------------------------------

//----------------------------
//END ENCOUNTER HELPERS//
//----------------------------

//PLAYER TELEPORTERS//
void TeleportHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "teleporter_1")
	{
		SetLocalVarString("TeleportTarget", "teleport_target_1");
		SetSwingDoorLocked("tesla_ents_core_door_18", true, true);
		MandusReactionPlayer("Breath", 5.0f);
		SetLampFlickerActive("FinalTesla_Lamp_1_0", true);
	}
	else if (asChild == "teleporter_2")
	{
		if (GetLocalVarInt("TeslaPigKilled") == 0)
		{
			string sActiveTesla = GetLocalVarString("ActiveTeslaPig");
			SetTeslaPigFadeDisabled(sActiveTesla, true);
			PlaySoundAtEntity("t1", "afx_tesla_teslapigevent_01.snt", "Player", 0.5f, false);
			RemoveTimer("FinalTesla_LastHuntLoop");
			StopMusic(1,3);
		}
		
		FadeOut(0.15f);
		SetLocalVarString("TeleportTarget", "teleport_target_2");
		MandusReactionPlayer("Breath", 2.0f);
		SetPropStaticPhysics("tesla_ents_core_door_14", true);
		
		SetLightFlickerActive("SpotLight_3", false);
		SetLampFlickerActive("Lampy", false);
		
		
		SetEntityActive("ghost_1", true);
		SetEntityActive("ghost_2", true);
		PlaySoundAtEntity("ghost1whispers", "afx_ghost_whispers", "ghost_1", 1.0f, true);
		PlaySoundAtEntity("ghost2whispers", "afx_ghost_whispers", "ghost_2", 1.0f, true);
	}
	
	TeleportSequence("TeleportSequence_1");
}

void TeleportSequence(string &in asTimer)
{
	if (asTimer == "TeleportSequence_1")
	{
		SetPlayerRunSpeedMul(0);
		PlayGuiSound("cellar_light_flicker_02.ogg", 1);
		StartScreenShake(0.2, 0.3, 0.0, 0.0);
		FadePlayerAspectMulTo(0.3f, 4.0f);
		AddTimer("TeleportSequence_2", 0.15f, "TeleportSequence");
	}
	else if (asTimer == "TeleportSequence_2")
	{		
		TeleportPlayer(GetLocalVarString("TeleportTarget"));
		PlayGuiSound("afx_tesla_teleport.ogg", 1);
		
		AddTimer("RestoreAspect", 0.15f, "TeleportSequence");
		AddTimer("RestoreSpeed", 1.5f, "TeleportSequence");
	}
	else if (asTimer == "RestoreAspect")
	{
		if (GetLocalVarString("TeleportTarget") == "teleport_target_2")
		{
			SetEntityActive("FinalTesla", false);
			SetEntityActive("FinalTesla_Hunter", false);
			FadeIn(0.15f);
		}
		
		FadePlayerAspectMulTo(1, 2.2f);
	}
	else if (asTimer == "RestoreSpeed")
	{
		SetPlayerRunSpeedMul(1);
		SetPropStaticPhysics("tesla_ents_core_door_14", false);
	}
}
// END PLAYER TELEPORTERS//
