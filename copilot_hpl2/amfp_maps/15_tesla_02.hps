void CollideTesla2Start(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("tesla_2", true);
	SetLanternFlickerActive(true);
	
	AddTimer("tesla_2", 3, "TimerTesla2Move");
	
	SetEntityActive(asChild, false);
}

void TimerTesla2Move(string &in asTimer)
{
	AddEnemyPatrolNode("tesla_2", "PathNodeArea_47", 0, "", false);
}

