void UpdatePlayerQuad (string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt(asChild + "_PlayerCollision", alState == 1 ? 1 : 0);
}

//-------------------------------------------------------------

void UpdateTeslaPigQuad (string &in asParent, string &in asChild, int alState)
{
	SetLocalVarString("TeslaPigQuad", asChild);
}

//-------------------------------------------------------------

void TeslaRoom_TimeOver(string &in asTimer)
{
	AddDebugMessage("Time Over!", false);

	TeslaRoom_TeslaRemovalCheck("");
}

//-------------------------------------------------------------

void TeslaRoom_TeslaRemovalCheck(string &in asTimer)
{
	if(GetPlayerHealth()<=0) return;

//	if(GetEnemyPlayerDistance("Tesla_Pig_1")>10 && GetPlayerCanSeeEnemy("Tesla_Pig_1")==false)
//	{
		AddTimer("ReturnToNormal1", 0.4, "TesEventKillTimer");
		AddTimer("ReturnToNormal2", 0.8, "TesEventKillTimer");
		AddTimer("ReturnToNormal3", 1.2, "TesEventKillTimer");
		AddTimer("ReturnToNormal4", 1.6, "TesEventKillTimer");
		AddTimer("ReturnToNormal5", 2, "TesEventKillTimer");
		AddTimer("ReturnToNormal6", 2.4, "TesEventKillTimer");
		
		AddTimer("TeslaRoom_ShakeFadeIn", 2.8, "TeslaRoom_ShakeFadeIn");
		AddTimer("TeslaRoom_TeslaGone", 3.6f, "TeslaRoom_TeslaGone");
/*	}
	else
	{
		AddTimer("TeslaRoom_TeslaRemovalCheck", 1.0f, "TeslaRoom_TeslaRemovalCheck");
	}*/
}

//-------------------------------------------------------------

void TeslaRoom_ShakeFadeIn(string &in asTimer)
{
	if (GetPlayerHealth() < 50)
		SetPlayerHealth(50);
		
	FadeIn(0.1);
	SetTeslaPigFadeDisabled("Tesla_Pig_1", true);
	FadeLightTo("PointLight_5", 0.34,0.19,0.045,1, 25, 1);
	PlayGuiSound("afx_events_streets_explosionplayer_interior_boom_05.ogg", 1);
	StartScreenShake(0.05f, 0, 0.1f, 4);
	//StartPlayerLookAt("Tesla_Pig_1", 8, 8, "");
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerLookSpeedMul(0.5f);
}

//-------------------------------------------------------------


void TeslaRoom_TeslaGone(string &in asTimer)
{	
	CreateParticleSystemAtEntity("poof", "tesla_teleport.ps", "Tesla_Pig_1", false);
	FadeLightTo("PointLight_5", 0,0,0,0, 25, 1);
	StopPlayerLookAt();
	SetPlayerMoveSpeedMul(1);
	SetPlayerLookSpeedMul(1);
	StartEffectFlash(0.4, 0.1, 1);
	PlayGuiSound("afx_pigline_explosion_06.ogg", 0.8f);
	
	SetEntityActive("Tesla_Pig_1", false);

	StopMusic(3, 3);
	
	AddTimer("TeslaRoom_OpenExitDoor", 4.4, "TeslaRoom_OpenExitDoor");
	
}

//-------------------------------------------------------------

void TeslaRoom_OpenExitDoor(string &in asTimer)
{
	//if(GetLocalVarInt("TeslaRoomLanterActive")==1) SetLanternActive(true, true);
	//SetLanternDisabled(false);
	
	//*InsertSoundHere*: Want fat sound of door opening! (perhaps do a special ent version of this door and add sounds in ent? It is easy to replace entities in editor.)
	PlaySoundAtEntity("Tesla_Bulkhead_2", "afx_tesla_metalgate_open.snt", "Tesla_Bulkhead_2", 0.0f, false);
	SetMoveObjectStateExt("Tesla_Bulkhead_2", 0.88, 5, 1, 0.12, true);
}

//-------------------------------------------------------------

void TeslaRoomSwitchChangeState(string &in asEntity, int alState)
{
	string sMachine = asEntity == "TeslaRoomMachine1_Switch" ? "TeslaRoomMachine1" : "TeslaRoomMachine2";
	
	if (alState !=1) return;
	
	//Regular changes as player solves problem 
	AddLocalVarInt("TeslaSwitchesActive", 1);
	
	SetLampLit(sMachine + "_LampRed", false, true);
	SetLampLit(sMachine + "_LampGreen", true, true);
	
	PlayPropAnimation(sMachine + "_Gauge", "on", 1.0f, true, "");
	CreateParticleSystemAtEntity(sMachine + "_Sparks_1", "ps_electro_switch_sparks.ps", sMachine + "_PS_1", false);
	CreateParticleSystemAtEntity(sMachine + "_Sparks_2", "ps_electro_switch_sparks.ps", sMachine + "_PS_2", false);
	SetLightVisible(sMachine + "_SwitchLight", true);
	AddTimer(sMachine + "_SwitchLight", 0.75, "TimerSetLightInvisible");
	
	PlaySoundAtEntity("", "afx_pigline_electrical_arc.snt", asEntity, 0.0f, false);
	PlaySoundAtEntity("", "afx_cellar_smallmachine_start.snt", asEntity, 0.0f, false);
	PlaySoundAtEntity(sMachine+"_Sound", "spraylock_engine_loop_tesla.snt", asEntity, 1, true);

	SetLeverStuckState(sMachine + "_Switch", 1, true);
	SetLeverInteractionDisablesStuck(sMachine + "_Switch", false);
	SetEntityInteractionDisabled(sMachine + "_Switch", true);
	
	if (GetLocalVarInt("TeslaSwitchesActive") == 2)
	{
		if (GetPlayerHealth() < 50)
			SetPlayerHealth(50);
		TeslaRoom_TeslaRemovalCheck("");
	}
	else if (GetLocalVarInt("TeslaEasyMode") == 0)
	{
		// Prepare teleportation to other lever
		if (asEntity == "TeslaRoomMachine1_Switch")
		{
			RemoveEntityCollideCallback("Player", "TeslaRoomQuadrant_4");
			AddEntityCollideCallback("Player", "TeslaRoomQuadrant_4", "TeslaRoom_SecondLeverTeleport", false, 0);
		}
		else
		{
			RemoveEntityCollideCallback("Player", "TeslaRoomQuadrant_3");
			AddEntityCollideCallback("Player", "TeslaRoomQuadrant_3", "TeslaRoom_SecondLeverTeleport", false, 0);
		}
		ShowEnemyPlayerPosition("Tesla_Pig_1");
		AddTimer("Vanish_1", 2.f, "TeslaRoom_TeleportPigSequence");
	}
}

//-------------------------------------------------------------

void TeslaRoom_TeleportPig(string &in asNode)
{
	SetLocalVarString("TeslaPigTeleportTarget", asNode);
	TeslaRoom_TeleportPigSequence("Teleport_1");
}

//-------------------------------------------------------------

void TeslaRoom_TeleportPigToRandomQuad(string &in asTimer)
{
	int lSelectedQuad = RandInt(1, 3);
	if ((lSelectedQuad == 1 && GetLocalVarInt("TeslaRoomQuadrant_1_PlayerCollision") == 1) ||
		(lSelectedQuad == 2 && GetLocalVarInt("TeslaRoomQuadrant_2_PlayerCollision") == 1) ||
		(lSelectedQuad == 3 && GetLocalVarInt("TeslaRoomQuadrant_3_PlayerCollision") == 1))
	{
		lSelectedQuad = 4;
	}
	
	TeslaRoom_TeleportPig("TeslaRoomQuadrant_" + lSelectedQuad + "_Node");
	
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_1_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_2_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_3_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_4_LookAt_*", "", false);
}

//-------------------------------------------------------------

void TeslaRoom_TeleportPigSequence (string &in asTimer)
{
	if (GetLocalVarInt("TeslaSwitchesActive") == 2) return;
	
	// Disappear
	if (asTimer == "Vanish_1")
	{
		SetTeslaPigFadeDisabled("Tesla_Pig_1", true);
		FadeOut(0.2f);
		AddTimer("Vanish_2", 0.2f, "TeslaRoom_TeleportPigSequence");
		
		StartScreenShake(0.05, 0.3, 0.1, 0.1);
	}
	else if (asTimer == "Vanish_2")
	{
		AddDebugMessage("DISAPPEARANCE!", false);
		FadeIn(0.1f);
		PlaySoundAtEntity("", "tesla_teleport.snt", "Tesla_Pig_1", 0.0f, false);
		CreateParticleSystemAtEntity("", "tesla_teleport.ps", "Tesla_Pig_1", false);
		SetEntityActive("Tesla_Pig_1", false);
		SetTeslaPigFadeDisabled("Tesla_Pig_1", false);
	}
	
	// Reappear
	else if (asTimer == "Teleport_1")
	{
		FadeOut(0.2f);
		AddTimer("Teleport_2", 0.2f, "TeslaRoom_TeleportPigSequence");
		
		StartScreenShake(0.05, 0.6, 0.25, 0.25);
	}
	else if (asTimer == "Teleport_2")
	{
		AddDebugMessage("REAPPEARANCE!", false);
		
		FadeIn(0.1f);
		SetEntityActive("Tesla_Pig_1", true);
		SetEnemyDisableTriggers("Tesla_Pig_1", true);
		ForceEnemyWaitState("Tesla_Pig_1");
		ForceTeslaPigSighting("Tesla_Pig_1");
		TeleportEnemyToNode("Tesla_Pig_1", GetLocalVarString("TeslaPigTeleportTarget"), true);
		CreateParticleSystemAtEntity("", "tesla_teleport.ps", "Tesla_Pig_1", false);
		PlaySoundAtEntity("", "tesla_teleport.snt", "Tesla_Pig_1", 0.0f, false);
		
		AddTimer("Teleport_3", 3.0f, "TeslaRoom_TeleportPigSequence");
	}
	else if (asTimer == "Teleport_3")
	{
		SetEnemyDisableTriggers("Tesla_Pig_1", false);
		//ShowEnemyPlayerPosition("Tesla_Pig_1");
	}
}

//-------------------------------------------------------------

void TeslaRoom_LookAtVanish(string &in asTimer)
{
	if (asTimer == "TeslaRoom_LookAtVanish")
	{
		if (GetPlayerCanSeeEnemy("Tesla_Pig_1") == false)
		{
			AddTimer("TeslaRoom_LookAtVanish", 1.f, "TeslaRoom_LookAtVanish");
			return;
		}
		
		AddTimer("Vanish_1", 1.f, "TeslaRoom_TeleportPigSequence");
		
		AddTimer("TeslaRoom_LookAtVanish_Step2", 5.0f, "TeslaRoom_LookAtVanish");
	}
	else
	{
		// Prepare reappearance
		SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_1_LookAt_*", "TeslaRoom_LookAtTeleport", false);
		SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_2_LookAt_*", "TeslaRoom_LookAtTeleport", false);
		SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_3_LookAt_*", "TeslaRoom_LookAtTeleport", false);
		SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_4_LookAt_*", "TeslaRoom_LookAtTeleport", false);
		
		// For the gamer that tries to avoid death by staring at the floor
		AddTimer("TeslaRoom_TeleportPigToRandomQuad", 10.0f, "TeslaRoom_TeleportPigToRandomQuad");
	}
}

//-------------------------------------------------------------

void TeslaRoom_LookAtTeleport (string &in asEntity, int alState)
{
	if (alState != 1) return;
	
	string sQuadrant = StringSub(asEntity, 0, 19);
	string sNumber = StringSub(asEntity, 27, 1);
	
	// Don't teleport pig to the same quadrant as the player is in
	if (GetLocalVarInt(sQuadrant + "_PlayerCollision") == 1) return;
	
	TeslaRoom_TeleportPig(sQuadrant + "_Node_" + sNumber);
	
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_1_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_2_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_3_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_4_LookAt_*", "", false);
	
	RemoveTimer("TeslaRoom_TeleportPigToRandomQuad");
}

//-------------------------------------------------------------

void TeslaRoom_SecondLeverTeleport(string &in asParent, string &in asChild, int alState)
{
	// Remove stuff that might interfere
	RemoveTimer("TeslaRoom_LookAtVanish");
	RemoveTimer("TeslaRoom_LookAtVanish_Step2");
	RemoveTimer("TeslaRoom_TeleportPigToRandomQuad");
	RemoveTimer("Vanish_1");
	RemoveTimer("Vanish_2");
	RemoveTimer("Teleport_1");
	RemoveTimer("Teleport_2");
	RemoveTimer("Teleport_3");
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_1_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_2_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_3_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_4_LookAt_*", "", false);
	
	UpdatePlayerQuad(asParent, asChild, alState);
	RemoveEntityCollideCallback("Player", asChild);
	AddEntityCollideCallback("Player", asChild, "UpdatePlayerQuad", false, 0);
	
	if (asChild == "TeslaRoomQuadrant_3")
	{
		TeslaRoom_TeleportPig("PathNodeArea_185");
	}
	else
	{
		TeslaRoom_TeleportPig("PathNodeArea_1");
	}
}

