		SetEntityActive("tfuseroomON_32", true);
		SetEntityActive("tfuseroomOFF_30", false);
		SetEntityActive("tfuseroomOFF_24", false);
		SetEntityActive("tfuseroomOFF_18", false);
		SetEntityActive("tfuseroomOFF_12", false);
		SetEntityActive("tfuseroomOFF_6", false);
		SetEntityActive("tfuseroomOFF_32", false);
		
		SetLightVisible("BoxLight_1", true);
		}
}

