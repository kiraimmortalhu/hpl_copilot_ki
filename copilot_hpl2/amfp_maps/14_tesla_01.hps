//ELECTRICTY DISCHARGE EVENT//
void ElectricitySpinSequence (string &in asEntity, int alState)
{
if (alState == -1)
{
PlaySoundAtEntity("Discharge", "afx_tesla_massive_electricity_discharge.snt", "Player", 0, false);
SetEntityInteractionDisabled("tesla_dressing_handle_2", true);
SetLeverStuckState(asEntity, -1, true);
AddTimer("ScreenShakeElectricityTimer", 4.58f, "TimerEndCalls");
}
}

//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	
	if (asChild == "VO_2")
	{
	AddEffectVoice3("vo_tesla_mandus_machine_1.ogg", "", "Voice", "vo_tesla_mandus_machine_1_mandus_1", 0.0f, "vo_tesla_mandus_machine_1_machine_1", 3.5f, "vo_tesla_mandus_machine_1_mandus_2", 12.5f, false, "", 0.0f, 0.0f);
	return;
	}
	
	else if (asChild == "distant_pig_1")
	{
	PlaySoundAtEntity("t1", "afx_tesla_teslapigevent_01.snt", "Player", 1.0f, false);
	return;
	}
	
	else if (asChild == "distant_pig_2")
	{
	PlaySoundAtEntity("", "afx_tesla_teslapigevent_02.snt", "deadwretch", 1.0f, false);
	return;
	}
	
/*	else if (asChild == "not_so_distant_pig")
	{
	PlaySoundAtEntity("", "afx_tesla01_pigroar_closer.snt", "deadwretch", 1.0f, false);
	return;
	}*/
}


//END TRIGGERED VO PLAYER//

//TIMER END CALLS/////////ALL TIMERS CALL THIS CONTAINER FUNCTION, IF BLOCKS DETERMINE OUTPUT//
void TimerEndCalls (string &in asTimer)
{
	//Electricity//
	if (asTimer == "ScreenShakeElectricityTimer")
	{
		StartScreenShake(0.25f, 0.5f, 0.0f, 1.0f);
		return;
	}
}

