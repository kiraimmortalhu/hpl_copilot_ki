//-------------------------------------------------------------

void TeslaRoom_OpenDoor(string &in asParent, string &in asChild, int alState)
{
	SetMoveObjectStateExt("Tesla_Bulkhead_1", 0.88, 5, 1, 0.12, true);
	PlaySoundAtEntity("Tesla_Bulkhead_1", "afx_tesla_metalgate_open.snt", "Tesla_Bulkhead_1", 0.0f, false);
}

void Tesla_Start(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Tesla Room Start", false);
	
	SetEntityActive("Tesla_Start_*", false);
	
	SetMoveObjectStateExt("Tesla_Bulkhead_1", 0, 17, 20, 0.1, true);
	PlaySoundAtEntity("Tesla_Bulkhead_1Close", "afx_tesla_metalgate_close.snt", "Tesla_Bulkhead_1", 0.0f, false);
	
/*	SetEntityActive("tesla_dressing_light_on_18", false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);*/
	
	SetPlayerMoveSpeedMul(0.5);
	
	RemoveTimer("Lamp_1");
	RemoveTimer("Lamp_2");

	///
	// INTRO EFFECTS ------------------------------------------------------------
	//
	AddTimer("intro1", 0, "TimerNewTeslaStart");
	AddTimer("intro2", 2, "TimerNewTeslaStart");
	AddTimer("intro3", 3, "TimerNewTeslaStart");
	
	// ---------------------------------------------------------------------------
	
	//SetLocalVarInt("TeslaRoomLanterActive", GetLanternActive()?1:0);
	
	LanternFlicker(4);
	
	AddTimer("Delay", 3, "TimerDelayTeslaOldStart");
	
	CheckPoint("CheckPoint_TeslaRoom", "CheckPoint_TeslaRoom", "CheckPoint_TeslaRoom", "", "", false);
}

void TimerNewTeslaStart(string &in asTimer)
{
		if(asTimer == "intro1")
		{
			PlaySoundAtEntity("rumb", "afx_factory_quake_shake.snt", "Player", 2, false);
			PlaySoundAtEntity("rumb2", "afx_spooky_metaldrag_04.snt", "Player", 2, false);
			StartScreenShake(0.01, 0.5, 1, 1.5);
		}
				
		if(asTimer == "intro2")
		{
			SetLampLit("TeslaRoomMachine1_LampGreen", false, true);
			PlayPropAnimation("TeslaRoomMachine1_Gauge", "off", 1.0f, true, "");
			SetLightVisible("TeslaRoomMachine1_SwitchLight", false);
			StopSound("TeslaRoomMachine1_Sound", 1);
			
			SetLampLit("TeslaRoomMachine2_LampGreen", false, true);
			PlayPropAnimation("TeslaRoomMachine2_Gauge", "off", 1.0f, true, "");
			SetLightVisible("TeslaRoomMachine2_SwitchLight", false);
			StopSound("TeslaRoomMachine2_Sound", 1);
			
			SetLeverStuckState("TeslaRoomMachine1_Switch", -1, true);
			SetLeverInteractionDisablesStuck("TeslaRoomMachine1_Switch", true);
			AddPropForce("TeslaRoomMachine1_Switch", 1, 1, 1, "world");
			SetLeverStuckState("TeslaRoomMachine2_Switch", -1, true);
			SetLeverInteractionDisablesStuck("TeslaRoomMachine2_Switch", true);
			AddPropForce("TeslaRoomMachine2_Switch", 1, 1, 1, "world");
			SetLampLit("TeslaRoomMachine1_LampRed", true, true);
			SetLampLit("TeslaRoomMachine2_LampRed", true, true);
			
			SetEntityConnectionStateChangeCallback("TeslaRoomMachine1_Switch", "TeslaRoomSwitchChangeState");
			SetEntityConnectionStateChangeCallback("TeslaRoomMachine2_Switch", "TeslaRoomSwitchChangeState");	

			StartScreenShake(0.05, 0.2, 0.2, 2);
			PlaySoundAtEntity("flash", "tesla_teleport.snt", "Player", 1, false);
			CreateParticleSystemAtEntity("puff1", "tesla_destroy.ps", "TeslaRoomMachine1_PS_1", false);
			CreateParticleSystemAtEntity("puff2", "tesla_destroy.ps", "TeslaRoomMachine2_PS_1", false);
			FadeLightTo("SpotLight_5", 0.284,0.257,0.414,1, 30, 0.3);
			FadeLightTo("SpotLight_17", 0.284,0.257,0.414,1, 30, 0.3);
			
			SetPlayerMoveSpeedMul(1);
		}
		
		if(asTimer == "intro3")
		{
			FadeLightTo("SpotLight_5", 0, 0, 0, 0, 0, 0.7);
			FadeLightTo("SpotLight_17", 0, 0, 0, 0, 0, 0.7);
		}
}

void TimerDelayTeslaOldStart(string &in asTimer)
{
	PlayMusic("music_church_factory_pig.ogg", true, 0.7f, 4.0f, 3, false);
	
	SetLampLit("PointLight_363", false, false);
	//SetLightVisible("SpotLight_5", false);
	SetLightVisible("BoxLight_1", false);
	
	SetEntityActive("tfuseroomON_27", false);
	SetEntityActive("tfuseroomON_21", false);
	SetEntityActive("tfuseroomON_15", false);
	SetEntityActive("tfuseroomON_9", false);
	SetEntityActive("tfuseroomON_3", false);
	SetEntityActive("tfuseroomON_31", false);
	SetEntityActive("tfuseroomOFF_31", true);
	SetEntityActive("tfuseroomOFF_27", true);
	SetEntityActive("tfuseroomOFF_21", true);
	SetEntityActive("tfuseroomOFF_15", true);
	SetEntityActive("tfuseroomOFF_9", true);
	SetEntityActive("tfuseroomOFF_3", true);
	
	AddTimer("TeslaTimer2", 0.4, "TeslaTimer");
	AddTimer("TeslaTimer3", 0.8, "TeslaTimer");
	AddTimer("TeslaTimer4", 1.2, "TeslaTimer");
	AddTimer("TeslaTimer5", 1.6, "TeslaTimer");
	AddTimer("TeslaTimer6", 2.0, "TeslaTimer");
	
	AddTimer("Flash8", 3.8, "Tesla_SpawnPig");
}

void CheckPoint_TeslaRoom(string &in asName, int alCount)
{
	if(alCount>1)
		SetLocalVarInt("TeslaEasyMode",1);
		
	for (int i = 0; i < 45; i++)
	{
		if (GetEntityExists("tfuseroomON_" + i))
		{
			SetEntityActive("tfuseroomOFF_" + i, false);
			SetEntityActive("tfuseroomON_" + i, true);
		}
	}
	SetLightVisible("BoxLight_1", true);
	SetEntityActive("Tesla_Start_*", true);
	
	SetLampLit("TeslaRoomMachine1_LampRed", false, false);
	SetLampLit("TeslaRoomMachine1_LampGreen", false, false);
	SetEntityConnectionStateChangeCallback("TeslaRoomMachine1_Switch", "");
	SetLeverStuckState("TeslaRoomMachine1_Switch", 1, true);
	SetLeverInteractionDisablesStuck("TeslaRoomMachine1_Switch", false);
	SetEntityInteractionDisabled("TeslaRoomMachine1_Switch", false);
	AddPropForce("TeslaRoomMachine1_Switch", 1, 1, 1, "world");
	SetLampLit("TeslaRoomMachine2_LampRed", false, false);
	SetLampLit("TeslaRoomMachine2_LampGreen", false, false);
	SetEntityConnectionStateChangeCallback("TeslaRoomMachine2_Switch", "");
	SetLeverStuckState("TeslaRoomMachine2_Switch", 1, true);
	SetLeverInteractionDisablesStuck("TeslaRoomMachine2_Switch", false);
	SetEntityInteractionDisabled("TeslaRoomMachine2_Switch", false);
	AddPropForce("TeslaRoomMachine2_Switch", 1, 1, 1, "world");
	
	SetLocalVarInt("TeslaSwitchesActive", 0);
	
	AddEntityCollideCallback("Player", "TeslaRoom_OpenDoor", "TeslaRoom_OpenDoor", true, 1);
	
	SetMoveObjectState("Tesla_Bulkhead_2", 0);
	
	SetLanternDisabled(false);
	
	RemoveTimer("TeslaRoom_TimeOver");
	RemoveTimer("TeslaRoom_TeslaRemovalCheck");
	RemoveTimer("TeslaRoom_LookAtVanish");
	RemoveTimer("TeslaRoom_LookAtVanish_Step2");
	RemoveTimer("TeslaRoom_TeleportPigToRandomQuad");
	RemoveTimer("Vanish_1");
	RemoveTimer("Vanish_2");
	RemoveTimer("Teleport_1");
	RemoveTimer("Teleport_2");
	RemoveTimer("Teleport_3");
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_1_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_2_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_3_LookAt_*", "", false);
	SetEntityPlayerLookAtCallback("TeslaRoomQuadrant_4_LookAt_*", "", false);
	
	StopMusic(0.5f, 3);
}

