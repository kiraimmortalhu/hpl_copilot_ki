// CHILD 1 HANDLER

void ActivateChild1 (string &in asParent, string &in asChild, int alState)
	{
	SetEntityActive("child_silent_1", true);
	SetEntityActive("child_2_spawn_trigger", false);
	SetEntityActive("child_4_spawn_trigger", false);
	AddTimer("OnTime", 0.3f, "DeactivateChild1"); //ADJUST TIME AS NEEDED//
	StartScreenShake(0.05, 0.1,0,0);
	PlaySoundAtEntity("flicka", "tesla_light_flicker.snt", "Player", 0, false);
	PlayGuiSound("spooky_wind_whirl.snt", 0.2);
	}

