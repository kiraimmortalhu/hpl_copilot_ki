//-------------------------------------------------------------

void ActivateWindowTesla(string &in asParent, string &in asChild, int alState)
{
	SetEntityPlayerLookAtCallback("WindowTeslaLookAt", "LookAtWindowTeslaStart", false);
	AddEntityCollideCallback("Player", "WindowTeslaStart", "CollideWindowTeslaStart", false, 0);
	AddEntityCollideCallback("WindowTesla", "WindowTeslaKiller", "CollideKillWindowTesla", true, 1);
	AddEntityCollideCallback("WindowTesla", "WindowTeslaForceGlimpse", "CollideWindowTeslaForcedGlimpse", true, 1);
	
	SetEntityActive("WindowTesla", true);
	SetTeslaPigSoundDisabled("WindowTesla", true);
	SetLampFlickerActive("WindowTeslaLamp_*", true);
	SetLightFlickerActive("WindowTeslaLight_1", true);
	SetLightFlickerActive("WindowTeslaLight_2", true);
	SetLanternFlickerActive(true);

	
	AddEntityCollideCallback("Player", "WindowTeslaStopTrigger", "DeactivateWindowTesla", true, 1);
}

//-------------------------------------------------------------

void DeactivateWindowTesla(string &in asParent, string &in asChild, int alState)
{
	SetEntityPlayerLookAtCallback("WindowTeslaLookAt", "", false);
	RemoveEntityCollideCallback("Player", "WindowTeslaStart");
	RemoveEntityCollideCallback("WindowTesla", "WindowTeslaKiller");
	RemoveEntityCollideCallback("WindowTesla", "WindowTeslaForceGlimpse");
	
	SetEntityActive("WindowTesla", false);
	SetLampFlickerActive("WindowTeslaLamp_*", false);
	SetLightFlickerActive("WindowTeslaLight_1", false);
	SetLightFlickerActive("WindowTeslaLight_2", false);
	SetLanternFlickerActive(false);
	
	AddEntityCollideCallback("Player", "WindowTeslaTrigger", "ActivateWindowTesla", true, 1);
}

//-------------------------------------------------------------

void LookAtWindowTeslaStart(string &in asEntity, int alState)
{
	WindowTeslaStart("WindowTeslaSequence_1");
}

void CollideWindowTeslaStart(string &in asParent, string &in asChild, int alState)
{
	WindowTeslaStart("WindowTeslaSequence_1");
}

void WindowTeslaStart(string &in asTimer)
{
	RemoveEntityCollideCallback("Player", "WindowTeslaStopTrigger");
	RemoveEntityCollideCallback("Player", "WindowTeslaStart");
	SetEntityPlayerLookAtCallback("WindowTeslaLookAt", "", false);
	
	AddEnemyPatrolNode("WindowTesla", "PathNodeArea_44", 0, "", false);
	SetTeslaPigFadeDisabled("WindowTesla", true);
	
	PlaySoundAtEntity("", "afx_tesla01_teslapigwindowsighting.snt", "WindowTesla", 0, false);
	
	MandusReactionPlayer("Quick", 0.8f);
}

//-------------------------------------------------------------

void CollideWindowTeslaForcedGlimpse(string &in asParent, string &in asChild, int alState)
{
	ForceTeslaPigSighting("WindowTesla");
	SetTeslaPigFadeDisabled("WindowTesla", false);
}

//-------------------------------------------------------------

void CollideKillWindowTesla(string &in asParent, string &in asChild, int alState)
{
	SetLampFlickerActive("WindowTeslaLamp_*", false);
	SetLightFlickerActive("WindowTeslaLight_1", false);
	SetLightFlickerActive("WindowTeslaLight_2", false);
	SetLanternFlickerActive(false);
		
	SetEntityActive("WindowTesla", false);
}

//-------------------------------------------------------------

void ActivateTeslaKillReveal (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("RevealTesla", true);
	SetTeslaPigSoundDisabled("RevealTesla", true);
	SetTeslaPigFadeDisabled("RevealTesla", true);
	LanternFlicker(10);
	
	SetEntityPlayerLookAtCallback("TeslaReveal_Start", "TeslaReveal_PlayerLookAt", true);
	AddTimer("Vanish_1", 10.0f, "TeslaReveal_Vanish");
}

//-------------------------------------------------------------

void TeslaReveal_PlayerLookAt(string &in asParent, int alState)
{
	if (GetEntityActive("RevealTesla") == false) return;
	
	AddDebugMessage("Tesla Reveal Start", false);

	LanternFlicker(3);
	ForceTeslaPigSighting("RevealTesla");
	SetTeslaPigFadeDisabled("RevealTesla", false);
	
	RemoveTimer("Vanish_1");

	ClearEnemyPatrolNodes("RevealTesla");
	AddEnemyPatrolNode("RevealTesla", "PathNodeArea_178", 0, "", false);
	
	AddEntityCollideCallback("RevealTesla", "TeslaReveal_Kill", "TeslaReveal_Kill", true, 1);
	
	PlaySoundAtEntity("", "afx_tesla01_teslaruntoteleport.snt", "RevealTesla", 0, false);
}

void TeslaReveal_Kill(string &in asParent, string &in asChild, int alState)
{
	TeslaReveal_Vanish("Vanish_1");
}

void TeslaReveal_Vanish(string &in asTimer)
{
	if (asTimer == "Vanish_1")
	{
		ForceTeslaPigSighting("RevealTesla");
		SetTeslaPigFadeDisabled("RevealTesla", true);
		FadeOut(0.2f);
		AddTimer("Vanish_2", 0.2f, "TeslaReveal_Vanish");
		MandusReactionPlayer("Breath", 2.0f);
		StartScreenShake(0.05, 0.3, 0.1, 0.1);
	}
	else if (asTimer == "Vanish_2")
	{
		FadeIn(0.1f);

		CreateParticleSystemAtEntity("", "tesla_teleport.ps", "RevealTesla", false);
		SetEntityActive("RevealTesla", false);
		SetTeslaPigFadeDisabled("RevealTesla", false);
	}
}

//-------------------------------------------------------------

void PreTeslaEncounterFlicker(string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("", "afx_tesla01_hallwaybeforeencounter.snt", "Player", 1, false);
	MandusReactionPlayer("Breath", 3.0f);
	FadeImageTrailTo(1.f, 1.5f);
	AddTimer("ReturnToNormalVision", 1.f, "RestoreToNormal");
	AddTimer("PreTeslaEncounterRoar", 1.5f, "PreTeslaEncounterRoar");
	
	LanternFlicker(4);
	for (int lLampNum = 1; lLampNum <= 8; lLampNum++)
	{
		float fTotalTime = 0;
		for (int i = 0; i < 4; i++)
		{
			fTotalTime += RandFloat(0.1, 1.0f);
			AddTimer("PreTeslaFlickerLamp_" + lLampNum, fTotalTime, "TimerSetLampUnlit");
			AddTimer("PreTeslaFlickerLamp_" + lLampNum + "_Light_1", fTotalTime, "TimerSetLightInvisible");
			AddTimer("PreTeslaFlickerLamp_" + lLampNum + "_Light_2", fTotalTime, "TimerSetLightInvisible");
			fTotalTime += RandFloat(0.05, 0.25);
			AddTimer("PreTeslaFlickerLamp_" + lLampNum, fTotalTime, "TimerSetLampLit");
			AddTimer("PreTeslaFlickerLamp_" + lLampNum + "_Light_1", fTotalTime, "TimerSetLightVisible");
			AddTimer("PreTeslaFlickerLamp_" + lLampNum + "_Light_2", fTotalTime, "TimerSetLightVisible");
		}
	}
}

void PreTeslaEncounterRoar(string &in asTimer)
{
	PlaySoundAtEntity("", "tesla_amb_distant_quieter.snt", "RandSound_Arena_5", 1.0f, false);
}

//-------------------------------------------------------------

void PostTeslaFlicker(string &in asParent, string &in asChild, int alState)
{
	SetLampFlickerActive("PostTeslaFlickerLamp_*", true);
	SetLightFlickerActive("PostTeslaFlickerLight_3", true);
	SetLightFlickerActive("PostTeslaFlickerLight_4", true);
	LanternFlicker(4);
	FadeImageTrailTo(1.5, 1.5f);
	
	PlaySoundAtEntity("PostTeslaFlickerElec", "afx_tesla01_lasthallway.snt", "PostTeslaFlickerLamp_1", 0.5f, true);
	MandusReactionPlayer("Breath", 4.0f);
	AddTimer("ReturnToNormalVision", 3.f, "RestoreToNormal");
	AddTimer("PostTeslaFlickerLamp_1", 0.1f, "PostTeslaFlickerSound");
	AddTimer("PostTeslaFlickerLamp_1", 2.5f, "PostTeslaFlickerSound");
	AddTimer("PostTeslaFlickerLamp_2", 3.0f, "PostTeslaFlickerSound");
	AddTimer("PostTeslaFlickerDone_1", 3.f, "PostTeslaFlickerDone");
	AddTimer("PostTeslaFlickerDone_2", 3.8f, "PostTeslaFlickerDone");
}

void PostTeslaFlickerSound(string &in asTimer)
{
	PlaySoundAtEntity("", "afx_pigline_electrical_arc.snt", asTimer, 0, true);
}

void PostTeslaFlickerDone(string &in asTimer)
{
	if (asTimer == "PostTeslaFlickerDone_1")
	{
		StopSound("PostTeslaFlickerElec", 2.f);
		SetLampFlickerActive("PostTeslaFlickerLamp_*", false);
		SetLampLit("PostTeslaFlickerLamp_2", false, true);
	}
	else
	{
		SetLightFlickerActive("PostTeslaFlickerLight_3", false);
		FadeLightTo("PostTeslaFlickerLight_3", 0.138,0.293,0.294,1, 3.5, 0.1f);
		SetLightFlickerActive("PostTeslaFlickerLight_4", false);
		FadeLightTo("PostTeslaFlickerLight_4", 0.138,0.293,0.294,1, 3.5, 0.1f);
	}
}

