void TimerDelayedHint(string &in asEntity)
{
	AddHint(asEntity, "");
}

//-------------------------------------------------------------

void Tesla_SpawnPig( string &in asTimer )
{
	SetEntityActive("Tesla_Pig_1", true);
	
	ClearEnemyPatrolNodes("Tesla_Pig_1");
	
	if (GetLocalVarInt("TeslaEasyMode") == 0)
		AddTimer("TeslaRoom_LookAtVanish", 1.f, "TeslaRoom_LookAtVanish");
		
	PlaySoundAtEntity("", "afx_tesla01_pigroar.snt", "Player", 0.0f, false);
	
	AddTimer("InitRandSound_Arena", 5.0f, "Sound_Arena");
	
	MandusReactionPlayer("Quick", 0.7f);
	MandusReactionPlayer("Breath", 4.0f);
}
