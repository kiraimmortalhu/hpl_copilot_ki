//-------------------------------------------------------------

void FinalTesla_Start(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Final Tesla Start!", false);

	SetMoveObjectStateExt("FinalTesla_Bulkhead", 0, 17, 20, 0.1, true);
	PlaySoundAtEntity("FinalTesla_BulkheadClose", "afx_tesla_metalgate_close.snt", "FinalTesla_Bulkhead", 0.0f, false);
	
	AddTimer("FinalTesla_Blackout4", 1 ,"FinalTesla_Blackout4");
	AddTimer("FinalTesla_Blackout3", 1.5f ,"FinalTesla_Blackout3");
	AddTimer("FinalTesla_Blackout2", 2 ,"FinalTesla_Blackout2");
	AddTimer("FinalTesla_Blackout1", 2.5f ,"FinalTesla_Blackout1");
	
	AddTimer("FinalTesla_SpawnPig", 3, "FinalTesla_SpawnPig");
	
	PlayMusic("music_church_factory_pig.ogg", true, 1.0f, 4.0f, 3, false);
	
	AddEntityCollideCallback("Player", "FinalTesla_LastHunt", "FinalTesla_LastHunt", true, 1);
	
	CheckPoint("CheckPoint_FinalTesla", "CheckPoint_FinalTesla", "CheckPoint_FinalTesla", "", "", false);
	
	LanternFlicker(4);
}

void CheckPoint_FinalTesla(string &in asName, int alCount)
{
	SetMoveObjectStateExt("FinalTesla_Bulkhead", 0.88, 5, 1, 0.12, true);
	
	AddEntityCollideCallback("Player", "FinalTesla_Start", "FinalTesla_Start", true, 1);
	
	StopMusic(1.0f, 3);
	
	SetLampLit("FinalTesla_Lamp_*", true, false);
}

//-------------------------------------------------------------

void FinalTesla_Blackout4(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_4_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout3(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_3_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout2(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_2_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
}

void FinalTesla_Blackout1(string &in asTimer){
	SetLampLit("FinalTesla_Lamp_1_*", false, false);
	PlaySoundAtEntity("", "afx_tesla01_lightsout.snt", "Player", 0.0f, false);
	
	SetLightVisible("BoxLight_1", false);
}

//-------------------------------------------------------------

void FinalTesla_SpawnPig( string &in asTimer )
{
	SetEntityActive("FinalTesla", true);
	
	AddTimer("FinalTesla_LastHunt", 5, "FinalTesla_LastHunt");
			
	PlaySoundAtEntity("", "afx_tesla01_pigroar.snt", "FinalTesla", 0.0f, false);
	
	//MandusReactionPlayer("Quick", 0.7f);
	//MandusReactionPlayer("Breath", 4.0f);
}

void FinalTesla_StartMove(string &in asTimer)
{
	ClearEnemyPatrolNodes("FinalTesla");
	//AddEnemyPatrolNode("FinalTesla", "PathNodeArea_154", 0, "", false);
	//AddEnemyPatrolNode("FinalTesla", "PathNodeArea_118", 0, "", false);
	//AddEnemyPatrolNode("FinalTesla", "PathNodeArea_103", 0, "", false);
	//AddEnemyPatrolNode("FinalTesla", "PathNodeArea_125", 0, "", false);
	//AddEnemyPatrolNode("FinalTesla", "PathNodeArea_113", 0, "", false);
	
}

void FinalTesla_LastHunt(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Final Hunt Start!", false);
	
	LanternFlicker(3);

	FinalTesla_LastHuntLoop("");
}

void FinalTesla_LastHuntLoop(string &in asTimer)
{
	ShowEnemyPlayerPosition("FinalTesla");
	
	AddTimer("FinalTesla_LastHuntLoop", 0.5f, "FinalTesla_LastHuntLoop");
}

