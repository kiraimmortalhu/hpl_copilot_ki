	RemoveTimer("Sound_LargeHall2_1");
	RemoveTimer("Sound_LargeHall2_2");
	RemoveTimer("Sound_LargeHall2_3");
	RemoveTimer("Sound_LargeHall2_4");
	RemoveTimer("Sound_LargeHall2_5");
	RemoveTimer("Sound_LargeHall2_6");
	RemoveTimer("Sound_LargeHall2_7");
	RemoveTimer("Sound_LargeHall2Hideaway_1");
	RemoveTimer("Sound_LargeHall2Hideaway_3");
	RemoveTimer("Sound_LargeHall2Hideaway_2");
	RemoveTimer("InitRandSound_LargeHall1Env");
	RemoveTimer("InitRandSound_LargeHall1");
	RemoveTimer("InitRandSound_LargeHall1Env");
	RemoveTimer("InitRandSound_LargeHall1");
	RemoveTimer("InitRandSound_LargeHallHideaway");
	RemoveTimer("Sound_LargeHallHideaway");
	RemoveTimer("InitRandSound_LargeHall2Env");
	RemoveTimer("Sound_LargeHall2Env");
	RemoveTimer("InitRandSound_LargeHall2");
	RemoveTimer("Sound_LargeHall2");
	RemoveTimer("InitRandSound_LargeHall2HideawayEnv");
	RemoveTimer("Sound_LargeHall2HideawayEnv");
	RemoveTimer("InitRandSound_LargeHall2Hideaway");
	RemoveTimer("Sound_LargeHall2Hideaway");	
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_LargeArea_Stop_1");
	RemoveEntityCollideCallback("Player", "Sound_LargeArea_Stop_2");
	AddEntityCollideCallback("Player", "Sound_LargeArea_Start_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_LargeArea_Start_2", "SoundOptimiser", true, 1);
			
	AddDebugMessage("Tesla Large Area Sounds STOP!", true);
	return;
	}
	
//Pre AREA
	if (asChild == "Sound_PrePigArea_Start_1"|| asChild == "Sound_PrePigArea_Start_2")
	{	
	
	//PrePig SOUNDS
	AddTimer("InitRandSound_CorridorPrePigEnv", 5.0f, "RandSound_CorridorPrePigEnv");
	AddTimer("InitRandSound_CorridorPrePig", 3.0f, "RandSound_CorridorPrePig");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_PrePigArea_Start_1");
	RemoveEntityCollideCallback("Player", "Sound_PrePigArea_Start_2");
	AddEntityCollideCallback("Player", "Sound_PrePigArea_Stop_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_PrePigArea_Stop_2", "SoundOptimiser", true, 1);
	
	AddDebugMessage("Tesla PrePig Area Sounds START!", true);
	return;
	}
	
	else if (asChild == "Sound_PrePigArea_Stop_1"|| asChild == "Sound_PrePigArea_Stop_2")
	{
	//REMOVE PrePig SOUNDS
	RemoveTimer("RandSound_CorridorPrePig_6");
	RemoveTimer("RandSound_CorridorPrePig_5");
	RemoveTimer("RandSound_CorridorPrePig_4");
	RemoveTimer("RandSound_CorridorPrePig_3");
	RemoveTimer("RandSound_CorridorPrePig_2");
	RemoveTimer("RandSound_CorridorPrePig_1");
	RemoveTimer("RandSound_CorridorPrePig");
	RemoveTimer("InitRandSound_CorridorPrePig");
	RemoveTimer("RandSound_CorridorPrePigEnv");
	RemoveTimer("InitRandSound_CorridorPrePigEnv");	
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_PrePigArea_Stop_1");
	RemoveEntityCollideCallback("Player", "Sound_PrePigArea_Stop_2");
	AddEntityCollideCallback("Player", "Sound_PrePigArea_Start_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_PrePigArea_Start_2", "SoundOptimiser", true, 1);
			
	AddDebugMessage("Tesla PrePig Area Sounds STOP!", true);
	return;
	}			
}
//END RANDOM SOUND OPTIMISATION//								

//RESTORE TO NORMAL//
void RestoreToNormal (string &in asTimer)
{
//RETURN TO NORMAL VISION
	if (asTimer == "ReturnToNormalVision")
	{
		FadeRadialBlurTo(0.0f, 4.0f);
		FadeImageTrailTo(0.0f, 4.0f);
		return;
	}

//RETURN TO NORMAL ALL//
	else if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		StopPlayerLookAt();
		return;
	}
	
//END VISUAL EFFECT FOR SCREAM//
	else if (asTimer == "EndVisEffect")
	{
		FadeImageTrailTo(0.0f, 0.5f);
		FadeSepiaColorTo(0.0f, 0.5f);
		return;
	}
}
//END RESTORE TO NORMAL//

//SPOOK MASK 1 FLASH HANDLER//Mask Flash
void SpookMask1FlashTimer (string &in asTimer)
	{
	if(asTimer == "SpookMask1LightsOn1") //Show Pig Face nr start
		{
		SetLightVisible("PointLight_51", true);
		SetLightVisible("PointLight_52", true);
		SetLightVisible("PointLight_53", true);
		SetLightVisible("PointLight_54", true);
		SetLightVisible("BoxLight_1", true);
		SetEntityActive("SpookMask1", true);
		SetLanternFlickerActive(false);
		SetLampLit("tesla_dressing_light_on_24", false, false);
		AddTimer("SpookMask1LightsOff1", 0.05f, "SpookMask1FlashTimer");
		}

	if(asTimer == "SpookMask1LightsOff1")
		{
		SetLightVisible("PointLight_51", false);
		SetLightVisible("PointLight_52", false);
		SetLightVisible("PointLight_53", false);
		SetLightVisible("PointLight_54", false);
		SetLightVisible("BoxLight_1", false);
		SetEntityActive("SpookMask1", false);
		MandusReactionPlayer("Scared", 0.1f);
		SetLampLit("tesla_dressing_light_on_24", true, true);
		SetLanternFlickerActive(true);
		AddTimer("SpookMask1LightsOn2", 0.2f, "SpookMask1FlashTimer");
		}

	if(asTimer == "SpookMask1LightsOn2") //Return to normal w/ lantern flicker
		{
		SetLightVisible("PointLight_51", true);
		SetLightVisible("PointLight_52", true);
		SetLightVisible("PointLight_53", true);
		SetLightVisible("PointLight_54", true);
		SetLightVisible("BoxLight_1", true);
		SetLampLit("tesla_dressing_light_on_24", false, false);
		SetLanternFlickerActive(false);
		}
	}

void SpookMask1FlashHandler (string &in asParent, string &in asChild, int alState)
{
/*	if (asChild == "SpookMask1FlashTrigger") //Turns lights off. STarts sequence
	{
		AddDebugMessage("Flash Triggered", false);
		SetLightVisible("BoxLight_1", false);
		SetLanternFlickerActive(true);
		AddTimer("SpookMask1LightsOn1", 0.2, "SpookMask1FlashTimer");
		return;
	}*/
}
//END SPOOK MASK 1 FLASH HANDLER//

//SPOOK MASK 2 FLASH HANDLER//
void SpookMask2FlashTimer (string &in asTimer)
{
	if(asTimer == "SpookMask2PreSpawn") //Show Pig Face
	{
		StartScreenShake(0.05, 0.15, 0.05, 0);
		FadePlayerAspectMulTo(0.75f, 3.0f);
		AddTimer("SpookMask2LightsOn1", 0.1, "SpookMask2FlashTimer");
		SetPropActiveAndFade("SpookMask2", true, 0.05f);
	}
	if(asTimer == "SpookMask2LightsOn1") //Show Pig Face
	{
		SetLampLit("oval_wall_lamp_2m_pipe_2", true, false);
		FadeLightTo("PostTeslaFlickerLight_4", 0.138,0.293,0.294,1, -1, 0.1);
		SetLightVisible("BoxLight_1", true);
		AddTimer("SpookMask2LightsOff1", 0.3f, "SpookMask2FlashTimer");
	}

	if(asTimer == "SpookMask2LightsOff1")
	{
		FadePlayerAspectMulTo(1.f, 0.75f);
		SetLampLit("oval_wall_lamp_2m_pipe_2", false, false);
		FadeLightTo("PostTeslaFlickerLight_4", 0, 0, 0, 1, -1, 0.1);
		SetLightVisible("BoxLight_1", false);
		AddTimer("SpookMask2LightsOn2", 0.2f, "SpookMask2FlashTimer");
	}

	if(asTimer == "SpookMask2LightsOn2") //Return to normal w/ lantern flicker
	{
		SetPropActiveAndFade("SpookMask2", false, 0.075f);
		SetLampLit("oval_wall_lamp_2m_pipe_2", true, true);
		FadeLightTo("PostTeslaFlickerLight_4", 0.138,0.293,0.294,1, -1, 1);
		SetEntityActive("SpookMask2", false);
		SetLightVisible("BoxLight_1", true);
		SetLanternFlickerActive(false);
	}
}

void SpookMask2FlashHandler (string &in asParent, string &in asChild, int alState)
{
/*	if (asChild == "SpookMask2FlashTrigger") //Turns lights off. STarts sequence
	{
		SetLightVisible("BoxLight_1", false);
		SetLanternFlickerActive(true);
		SetLampLit("oval_wall_lamp_2m_pipe_2", false, false);
		FadeLightTo("PostTeslaFlickerLight_4", 0, 0, 0, 1, -1, 0.1);
		AddTimer("SpookMask2PreSpawn", 0.2, "SpookMask2FlashTimer");
		return;
	}*/
}
//END SPOOK MASK 2 FLASH HANDLER//

