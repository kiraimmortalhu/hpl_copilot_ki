void TeslaRoom_Exit(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Tesla Room Exit", false);

	SetMoveObjectStateExt("Tesla_Bulkhead_2", 0, 17, 20, 0.1, true);
	
	PlaySoundAtEntity("Tesla_Bulkhead_1", "afx_tesla_metalgate_close.snt", "Tesla_Bulkhead_2", 0.0f, false);
	RemoveTimer("Sound_Arena");
	
	RemoveTimer("InitRandSound_Arena");
	RemoveTimer("RandSound_Arena_1");
	RemoveTimer("RandSound_Arena_2");
	RemoveTimer("RandSound_Arena_3");
	RemoveTimer("RandSound_Arena_4");
	RemoveTimer("RandSound_Arena_5");
	RemoveTimer("RandSound_Arena_6");
	RemoveTimer("RandSound_Arena_7");
	RemoveTimer("RandSound_Arena_8");
	RemoveTimer("RandSound_Arena_9");
	RemoveTimer("RandSound_Arena_10");
}

