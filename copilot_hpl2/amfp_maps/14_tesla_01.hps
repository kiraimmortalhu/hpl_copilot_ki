void OnEnter()
{
	//ENTITY SETUP//
	{
		SetMoveObjectStateExt("FinalTesla_Bulkhead", 0.88, 5, 1, 0.12, true);
	}
	
	//AUTOSAVE//
	{
		AutoSave();
	}


}

void OnLeave()
{
	StopMusic(1.0f, 3);

	SetupLoadScreen("LoadingText", "Tesla02_", 3, "game_loading_tesla_02.jpg");
}

										//////////////////////////
										//MAP-SPECIFIC FUNCTIONS//
										//////////////////////////
										
void CollideStartFlicker (string &in asParent, string &in asChild, int alState)
{
	AddTimer("Lamp_1", RandFloat(0.1,0.5), "TimerFlickerLamps");
	AddTimer("Lamp_2", RandFloat(0.1,0.5), "TimerFlickerLamps");
}

void TimerFlickerLamps(string &in asTimer)
{
	SetLocalVarInt(asTimer, GetLocalVarInt(asTimer) == 1 ? 0 : 1);
	
	if(GetLocalVarInt(asTimer) == 1)
		SetLampLit(asTimer, true, true);
	else
		SetLampLit(asTimer, false, true);

	AddTimer(asTimer, RandFloat(0.1, 0.5), "TimerFlickerLamps");
}


//INITIALISE ELEVATOR//
void InitialiseElevator ()
{
	AddAttachedPropToProp("StartElevator", "ElevatorSwitchStatic", "elevator_switch_static.ent", 0.06f, -1.842f, -0.068f, 0.0f, 0.0f, 0.0f);
	SetMoveObjectState("StartElevator", 1);
	PlaySoundAtEntity("LiftLoop", "reactor_elevator_loop.snt", "Player", 1.0f, true);
	AddEffectVoice5("vo_tesla_machine_1", "", "Voice", "vo_tesla_machine_trigger_01", 0.0f, "vo_tesla_machine_trigger_01_2", 6.0f, "vo_tesla_machine_trigger_01_3", 19.3f, "vo_tesla_machine_trigger_01_3", 19.3f, "vo_tesla_machine_trigger_01_4", 30.59f, false, "", 0.0f, 0.0f);
	AddTimer("LiftTimer", 40.5f, "LiftEnd");
	AddTimer("LiftDoorTimer", 41.8f, "LiftEnd");
}

void LiftEnd (string &in asTimer)
{
	if (asTimer == "LiftTimer")
	{
		AddDebugMessage("LIFT STOP NOW", false);
		PlaySoundAtEntity("", "reactor_elevator_stop.snt", "Player", 0.0f, false);
		StopSound("LiftLoop", 1.5f);
		return;
	}
	else if (asTimer == "LiftDoorTimer")
	{
		ElevatorDoorHandler("Player", "ElevatorBottomOpenTrigger", 1);
		return;
	}
}
//END INITIALISE ELEVATOR//

//ELEVATOR DOOR HANDLER//
void ElevatorDoorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ElevatorBottomOpenTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 1);
		SetMoveObjectState("StartElevatorDoorLeft", 1);
		SetEntityActive("StartElevatorBlockBox", false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	else if (asChild == "CloseStartElevatorDoorTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 0);
		SetMoveObjectState("StartElevatorDoorLeft", 0);
		PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	else if (asChild == "ExitElevatorDoorOpenTrigger")
	{
		SetMoveObjectState("ExitElevatorDoorRight", 1);
		SetMoveObjectState("ExitElevatorDoorLeft", 1);
		PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource2", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource2", 0.0f, false);
	}
}

void CheckSwitchProximity (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Switch CAN Be Interacted With", false);
		SetEntityInteractionDisabled("ExitElevatorSwitch", false);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("Switch CANNOT Be Interacted With", false);
		SetEntityInteractionDisabled("ExitElevatorSwitch", true);
		RemoveTimer("MovementPreventionTimer");
		return;
	}
}

void ElevatorSwitchMovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("ExitElevatorSwitch") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
}
//END ELEVATOR DOOR HANDLER//

//RANDOM SOUND OPTIMISATION//
void SoundOptimiser (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Sound_StartArea_Start_1"|| asChild == "Sound_StartArea_Start_2")
	{	
	
	//START SOUNDS
	AddTimer("InitRandSound_Start", 5.0f, "Sound_Start");
	AddTimer("InitRandSound_StartEnv", 8.0f, "Sound_StartEnv");
	AddTimer("InitRandSound_StartDoor", 6.0f, "Sound_StartDoor");
	AddTimer("InitRandSound_StartDoorEnv", 9.0f, "Sound_StartDoorEnv");
	AddTimer("InitRandSound_StartSmallEnv", 7.0f, "Sound_StartSmallEnv");
	AddTimer("InitRandSound_StartRingEnv", 10.0f, "Sound_StartRingEnv");
	AddTimer("InitRandSound_StartRing", 11.0f, "Sound_StartRing");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_StartArea_Start_1");
	RemoveEntityCollideCallback("Player", "Sound_StartArea_Start_2");
	AddEntityCollideCallback("Player", "Sound_StartArea_Stop_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartArea_Stop_2", "SoundOptimiser", true, 1);
	
	AddDebugMessage("Tesla Start Area Sounds START!", true);
	return;
	}
	
	else if (asChild == "Sound_StartArea_Stop_1"|| asChild == "Sound_StartArea_Stop_2")
	{
	//REMOVE OUTSIDE SOUND
	RemoveTimer("Sound_Start_1");
	RemoveTimer("Sound_Start_2");
	RemoveTimer("Sound_StartDoor_1");
	RemoveTimer("Sound_StartDoor_2");
	RemoveTimer("Sound_StartDoor_3");
	RemoveTimer("Sound_StartDoor_4");
	RemoveTimer("Sound_StartSmall_1");
	RemoveTimer("Sound_StartSmall_2");
	RemoveTimer("Sound_StartSmall_3");
	RemoveTimer("Sound_StartSmall_4");
	RemoveTimer("Sound_StartRing_1");
	RemoveTimer("Sound_StartRing_2");
	RemoveTimer("Sound_StartRing_3");
	RemoveTimer("Sound_StartRing_4");
	RemoveTimer("Sound_StartRing_5");
	RemoveTimer("Sound_StartRing_6");
	RemoveTimer("Sound_StartRing_7");
	RemoveTimer("Sound_StartRing_8");
	RemoveTimer("Sound_StartRing_9");
	RemoveTimer("Sound_StartRing_10");
	RemoveTimer("Sound_StartRing_11");
	RemoveTimer("Sound_StartRing_12");
	RemoveTimer("Sound_EntranceToHall_1");
	RemoveTimer("Sound_EntranceToHall_2");
	RemoveTimer("Sound_EntranceToHall_3");
	RemoveTimer("Sound_EntranceToHall_4");
	RemoveTimer("InitRandSound_Start");
	RemoveTimer("InitRandSound_StartEnv");
	RemoveTimer("InitRandSound_StartDoor");
	RemoveTimer("InitRandSound_StartDoorEnv");
	RemoveTimer("InitRandSound_StartSmallEnv");
	RemoveTimer("InitRandSound_StartRingEnv");
	RemoveTimer("InitRandSound_StartRing");
	RemoveTimer("Sound_Start");
	RemoveTimer("Sound_StartEnv");
	RemoveTimer("Sound_StartDoor");
	RemoveTimer("Sound_StartDoorEnv");
	RemoveTimer("Sound_StartSmallEnv");
	RemoveTimer("Sound_StartRingEnv");
	RemoveTimer("Sound_StartRing");

	
	
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_StartArea_Stop_1");
	RemoveEntityCollideCallback("Player", "Sound_StartArea_Stop_2");
	AddEntityCollideCallback("Player", "Sound_StartArea_Start_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartArea_Start_2", "SoundOptimiser", true, 1);
			
	AddDebugMessage("Tesla Start Area Sounds STOP!", true);
	return;
	}	

//LARGE AREA
	if (asChild == "Sound_LargeArea_Start_1"|| asChild == "Sound_LargeArea_Start_2")
	{	
	
	//LARGE SOUNDS
	AddTimer("InitRandSound_LargeHall1Env", 5.0f, "Sound_LargeHall1Env");
	AddTimer("InitRandSound_LargeHall1", 8.0f, "Sound_LargeHall1");
	AddTimer("InitRandSound_LargeHallHideawayEnv", 6.0f, "Sound_LargeHallHideawayEnv");
	AddTimer("InitRandSound_LargeHallHideaway", 9.0f, "Sound_LargeHallHideaway");
	AddTimer("InitRandSound_LargeHall2Env", 7.0f, "Sound_LargeHall2Env");
	AddTimer("InitRandSound_LargeHall2", 10.0f, "Sound_LargeHall2");
	AddTimer("InitRandSound_LargeHall2HideawayEnv", 8.0f, "Sound_LargeHall2HideawayEnv");
	AddTimer("InitRandSound_LargeHall2Hideaway", 11.0f, "Sound_LargeHall2Hideaway");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_LargeArea_Start_1");
	RemoveEntityCollideCallback("Player", "Sound_LargeArea_Start_2");
	AddEntityCollideCallback("Player", "Sound_LargeArea_Stop_1", "SoundOptimiser", true, 1);
	AddEntityCollideCallback("Player", "Sound_LargeArea_Stop_2", "SoundOptimiser", true, 1);
	
	AddDebugMessage("Tesla Large Area Sounds START!", true);
	return;
	}
	
	else if (asChild == "Sound_LargeArea_Stop_1"|| asChild == "Sound_LargeArea_Stop_2")
	{
	//REMOVE LARGE SOUNDS
	RemoveTimer("Sound_EntranceToHall_1");
	RemoveTimer("Sound_EntranceToHall_2");
	RemoveTimer("Sound_EntranceToHall_3");
	RemoveTimer("Sound_EntranceToHall_4");
	RemoveTimer("Sound_LargeHall1_1");
	RemoveTimer("Sound_LargeHall1_2");
