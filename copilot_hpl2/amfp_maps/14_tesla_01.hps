//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
		if (asChild == "AMB_Area_Start")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_Start", "amb_tesla_basedrone_03_smallcorridor.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_Start", 1.0f);
				return;
			}
		}
				if (asChild == "AMB_Area_01")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_01", "amb_tesla_basedrone_03_smallcorridor.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_01", 1.0f);
				return;
			}
		}
		if (asChild == "AMB_Area_02")
				{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_02", "amb_tesla_basedrone_03_smallcorridor.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_02", 1.0f);
				return;
			}
		}
		if (asChild == "AMB_Area_03")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_03", "amb_tesla_hall.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_03", 1.0f);
				return;
			}
		}
		if (asChild == "AMB_Area_04")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_04", "amb_tesla_basedrone_02.snt", "Player", 1.0f, true);
				PlaySoundAtEntity("AMB_Area_04", "afx_zither_9.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_04", 1.0f);
				return;
			}
		}
		if (asChild == "AMB_Area_05")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_Area_05", "amb_tesla_basedrone_02.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Area_05", 1.0f);
				return;
			}
		}
		if (asChild == "Electric_Drone_Area_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("Electric_Drone_Area_1", "amb_tesla_pulsating_electricity", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("Electric_Drone_Area_1", 1.0f);
				return;
			}
		}
		if (asChild == "Electric_Drone_Area_2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("Electric_Drone_Area_2", "amb_tesla_pulsating_electricity", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("Electric_Drone_Area_2", 1.0f);
				return;
			}
		}
	
}
//END AMBIENT SOUNDTRACK PLAYER//

//SOUND OPTIMISATION//
void soundopt (string &in asParent, string &in asChild, int alState)
{
//FUSE ROOM
	if (asChild == "teslapigroom_fusesounds_start_1"|| asChild == "teslapigroom_fusesounds_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_start_1");
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_2", "soundopt", true, 1);
	
	//START FUSE SOUNDS
	PlaySoundAtEntity("teslafusepipes_1", "amb_tesla_fusepipes.snt", "fuse_soundsource_1", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_2", "amb_tesla_fusepipes.snt", "fuse_soundsource_2", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_3", "amb_tesla_fusepipes.snt", "fuse_soundsource_3", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_4", "amb_tesla_fusepipes.snt", "fuse_soundsource_4", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_5", "amb_tesla_fusepipes.snt", "fuse_soundsource_5", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_6", "amb_tesla_fusepipes.snt", "fuse_soundsource_6", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_7", "amb_tesla_fusepipes.snt", "fuse_soundsource_7", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_8", "amb_tesla_fusepipes.snt", "fuse_soundsource_8", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_9", "amb_tesla_fusepipes.snt", "fuse_soundsource_9", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_10", "amb_tesla_fusepipes.snt", "fuse_soundsource_10", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_11", "amb_tesla_fusepipes.snt", "fuse_soundsource_11", 1.0f, true);
	PlaySoundAtEntity("teslafusepipes_12", "amb_tesla_fusepipes.snt", "fuse_soundsource_12", 1.0f, true);

	//DEBUG MESSAGE
	AddDebugMessage("START FUSE SOUNDS", true);
	}
//BREAK
	if (asChild == "teslapigroom_fusesounds_stop_1"|| asChild == "teslapigroom_fusesounds_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_1");
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "teslapigroom_fusesounds_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "teslapigroom_fusesounds_start_2", "soundopt", true, 1);
	
	//Stop Quieter Drone
	StopSound("teslafusepipes_1", 1.0f);
	StopSound("teslafusepipes_2", 1.0f);
	StopSound("teslafusepipes_3", 1.0f);
	StopSound("teslafusepipes_4", 1.0f);
	StopSound("teslafusepipes_5", 1.0f);
	StopSound("teslafusepipes_6", 1.0f);
	StopSound("teslafusepipes_7", 1.0f);
	StopSound("teslafusepipes_8", 1.0f);
	StopSound("teslafusepipes_9", 1.0f);
	StopSound("teslafusepipes_10", 1.0f);
	StopSound("teslafusepipes_11", 1.0f);
	StopSound("teslafusepipes_12", 1.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("STOP FUSE SOUNDS", true);
	}
//BREAK
//START CUPBOARD SOUNDS
	if (asChild == "soundopt_startcupboards_start_1"|| asChild == "soundopt_startcupboards_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_startcupboards_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_startcupboards_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_startcupboards_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_startcupboards_stop_2", "soundopt", true, 1);

	//START FUSE SOUNDS
	PlaySoundAtEntity("cupboardstartsound_1", "amb_tesla_object_pipes.snt", "cupboardstartsound_1", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_2", "amb_tesla_object_pipes.snt", "cupboardstartsound_2", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_3", "amb_tesla_object_pipes.snt", "cupboardstartsound_3", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_4", "amb_tesla_object_pipes.snt", "cupboardstartsound_4", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_5", "amb_tesla_object_pipes.snt", "cupboardstartsound_5", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_6", "amb_tesla_object_pipes.snt", "cupboardstartsound_6", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_7", "amb_tesla_object_pipes.snt", "cupboardstartsound_7", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_8", "amb_tesla_object_pipes.snt", "cupboardstartsound_8", 1.0f, true);
	PlaySoundAtEntity("cupboardstartsound_9", "amb_tesla_object_pipes.snt", "cupboardstartsound_9", 1.0f, true);

	//DEBUG MESSAGE
	AddDebugMessage("START CUPBOARD SOUNDS", true);
	}
//BREAK
	if (asChild == "soundopt_startcupboards_stop_1"|| asChild == "soundopt_startcupboards_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_1");
	RemoveEntityCollideCallback("Player", "teslapigroom_fusesounds_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_startcupboards_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_startcupboards_start_2", "soundopt", true, 1);
	
	//Stop Quieter Drone
	StopSound("cupboardstartsound_1", 1.0f);
	StopSound("cupboardstartsound_2", 1.0f);
	StopSound("cupboardstartsound_3", 1.0f);
	StopSound("cupboardstartsound_4", 1.0f);
	StopSound("cupboardstartsound_5", 1.0f);
	StopSound("cupboardstartsound_6", 1.0f);
	StopSound("cupboardstartsound_7", 1.0f);
	StopSound("cupboardstartsound_8", 1.0f);
	StopSound("cupboardstartsound_9", 1.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("STOP CUPBOARD SOUNDS", true);
	}
//BREAK
}
//END SOUND OPTIMISATION

