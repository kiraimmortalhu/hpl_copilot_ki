		//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}

//END MANDUS REACTION SOUND PLAYER//

//ZITHER PLAYER//
void ZitherPlayer (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
		if (asChild == "zither_loop_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("ZitherLoop1", "afx_zither_4.snt", "ZitherLoopSource1", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("zither_loop_1", 1.0f);
				return;
			}
		}
		
		if (asChild == "zither_loop_2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("ZitherLoop2", "afx_zither_5.snt", "ZitherLoopSource2", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("zither_loop_2", 1.0f);
				return;
			}
		}
		if (asChild == "zither_loop_3")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("ZitherLoop3", "afx_zither_11.snt", "ZitherLoopSource3", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("zither_loop_3", 1.0f);
				return;
			}
		}
		if (asChild == "zither_loop_4")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("ZitherLoop4", "afx_zither_8.snt", "ZitherLoopSource4", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("zither_loop_4", 1.0f);
				return;
			}
		}
		
}

//END ZITHER PLAYER

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "music_1")
	{
		PlayMusic("afx_tesla_rumble_with_child.ogg", false, 0.65f, 0.0f, 3, false);
		
		return;
	}
	
	else if (asChild == "music_2")
	{
		AddTimer("music_2_timer", 5.0f, "music_2_timer");
		StopMusic(5.0f, 3);
		return;
	}
		else if (asChild == "music_3")
	{
		AddTimer("music_3_timer", 0.0f, "music_2_timer");
		StopMusic(5.0f, 3);
		return;
	}
	else if (asChild == "zither_1")
	{
		PlaySoundAtEntity("zither1", "afx_zither_6.snt", "Player", 1.0f, true);
		return;
	}
	else if (asChild == "zither_2")
	{
		PlaySoundAtEntity("zither2", "afx_zither_2.snt", "ZitherSource2", 1.0f, true);
		return;
	}
		else if (asChild == "zither_3")
	{
		PlaySoundAtEntity("zither3", "afx_zither_3.snt", "ZitherSource3", 1.0f, true);
		return;
	}
		else if (asChild == "zither_4")
	{
		PlaySoundAtEntity("zither4", "afx_zither_12.snt", "ZitherSource4", 1.0f, true);
		PlaySoundAtEntity("zither4", "afx_zither_12.snt", "ZitherSource4", 1.0f, true);
		return;
	}
}

void music_2_timer (string &in asTimer)
	{
		PlayMusic("afx_tesla_long_low_rumble.ogg", false, 0.65f, 0.0f, 3, false);
		AddDebugMessage("Music Triggered", false);
	}
	
void music_3_timer (string &in asTimer)
	{
		PlayMusic("afx_tesla_high_vibration.ogg", false, 0.5f, 0.0f, 3, false);
		return;
	}
//END MUSIC PLAYER//

// RUNNING CHILDREN HANDLER
void RunningChildHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "running_children_trigger")
	{
		PlaySoundAtEntity("Child_1laugh", "afx_tunnels_child_giggle_run_corridor_2D", "Child_1", 0, false);
		SetEntityActive("Child_1", true);
		AddEnemyPatrolNode("Child_1", "runchildrenrun", 0.0f, "", false);
		SetEntityActive("Child_2", true);
		AddEnemyPatrolNode("Child_2", "runchildrenrun", 0.0f, "", false);
		SetPlayerRunSpeedMul(0);
		return;
	}
	
	else if (asChild == "running_children_drop")
	{
		//SetEntityActive("note_3", true);
		SetEntityActive("bear", true);
		return;
	}
	
	else if (asChild == "running_children_kill_trigger")
	{
		SetPlayerRunSpeedMul(1);
		SetEntityActive("Child_1", false);
		SetEntityActive("Child_2", false);
		return;
	}
	
}


