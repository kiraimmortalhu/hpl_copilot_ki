void EnterPig3Flicker(string &in asParent, string &in asChild, int alState)
{
	LanternFlicker(3);
	
	SetSwingDoorLocked("tunnels_door_3", true, true);
}

void EnterPig3Start(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_3", true);
	PlaySoundAtEntity("a_little_warning", "wretch_tunnels_amb_idle.snt", "wretch_3", 0.5, false);
	
	ClearEnemyPatrolNodes("wretch_3");
	if(GetLocalVarInt("Pig3KilledPlayer")==0)
	{
		AddEnemyPatrolNode("wretch_3", "PathNodeArea_111", 0, "", false);
		AddEnemyPatrolNode("wretch_3", "PathNodeArea_126", 0, "", false);
		AddEnemyPatrolNode("wretch_3", "PathNodeArea_117", 0, "", false);
		
		AddEntityCollideCallback("wretch_3", "AreaPig3Disappear_1", "EnterPig3Disappear", true, 1);
		AddEntityCollideCallback("wretch_3", "AreaPig3Disappear_2", "EnterPig3Disappear", true, 1);
		AddEntityCollideCallback("wretch_3", "AreaPig3Disappear_3", "EnterPig3Disappear", true, 1);
		
		CheckPoint("BottomCheckPoint", "CheckPointWaterfalls", "CheckPointWaterfalls", "", "", false);
		AddTimer("TurnOffPig3Light", 4.5f, "TimerTurnOffPig3Light");
		
		StopSound("PigSweeten2_Source", 3.0f);
	}
	else
	{
		for(int i=0; i<2; ++i)
		{
			if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_3", "PathNodeArea_129", 0, "", false);
			else 				AddEnemyPatrolNode("wretch_3", "PathNodeArea_121", 0, "", false);
			if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_3", "PathNodeArea_114", 0, "", false);
			else				AddEnemyPatrolNode("wretch_3", "PathNodeArea_111", 0, "", false);
			if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_3", "PathNodeArea_117", 0, "", false);
			else				AddEnemyPatrolNode("wretch_3", "PathNodeArea_130", 0, "", false);
		}
	}
	
	
}

void TimerTurnOffPig3Light(string &in asTimer)
{
	SetLampLit("cellar_gaslamp01_short_small_point_light_13", false, true);
}

//------------------------------------------------------

void EnterPig3Disappear(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("Pig3InSmoke",1);

	FadeEnemyToSmoke("wretch_3", true);
	
	AddTimer("UnlockTunnelDoor", 3.0f, "TimerUnlockTunnelDoor");
}

void Pig3Disabled(string &in asEnemy, string &in aType)
{
	AddTimer("UnlockTunnelDoor", 3.0f, "TimerUnlockTunnelDoor");
}

void TimerUnlockTunnelDoor(string &in asTimer)
{
	SetSwingDoorLocked("tunnels_door_3", false, true);
}

//------------------------------------------------------

void CheckPointWaterfalls(string &in asName, int alCount)
{
	if(alCount<=2 && GetLocalVarInt("Pig3InSmoke")==0)
	{
		SetLocalVarInt("Pig3KilledPlayer",1);
		AddEntityCollideCallback("Player", "AreaPig3Start", "EnterPig3Start", true, 1);
	}
	else
	{
		AddEntityCollideCallback("Player", "AreaPig3Flicker", "EnterPig3Flicker", true, 1);
	}
}

