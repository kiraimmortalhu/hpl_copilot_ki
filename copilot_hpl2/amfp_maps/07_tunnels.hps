void EnterPig1Start(string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("PigRiseEvent")==1) return;
	
	SetEntityActive("wretch_1", true);
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_66", 0, "", false);
	
	StartLampFlicker("cellar_gaslamp01_short_4");
	StartLampFlicker("cellar_gaslamp01_short_3");
	
	MandusReactionPlayer("Scared", 0.2f);
	MandusReactionPlayer("Breath", 3.2f);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
	PlaySoundAtEntity("sparksloop", "afx_tunnels_lightsparks_loop", "Player", 1.5f, true);
	
	AddEntityCollideCallback("wretch_1", "AreaPig1Disappear", "EnterPig1Disappear", true, 1);
	AddEntityCollideCallback("wretch_1", "AreaPig1Rise", "EnterPig1Rise", true, 1);
	
	SetLocalVarString("RisePig", "wretch_1");
	
	TeleportPigTo("PathNodeArea_43", 1);
	TeleportPigTo("PathNodeArea_233", 2);
	TeleportPigTo("PathNodeArea_79", 4);
	
	PigRiseEffectEndBegin();
	
	SetEntityActive("FlashbackVOTrigger_2_2", true);
}

void EnterPig1Rise(string &in asParent, string &in asChild, int alState)
{
	ChangeEnemyPose("wretch_1", "Biped");
	
	//*InsertSoundHere*: Pig makes triumphant noise
}

void EnterPig1Disappear(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_1", false);
	
	AddTimer("PigRiseEffectEnd", 0.5f, "TimerPigRiseEffectEnd");
	
	StopSound("sparksloop", 3.0f);
	
	StopLampFlicker("cellar_gaslamp01_short_4");
	StopLampFlicker("cellar_gaslamp01_short_3");
	
	SetLampLit("cellar_gaslamp01_short_4", false, true);
	SetLampLit("cellar_gaslamp01_short_3", false, true);

}

//-------------------------------------------


void EnterPig2Start(string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("PigRiseEvent")==1) return;
	
	SetEntityActive("wretch_2", true);
	AddEnemyPatrolNode("wretch_2", "PathNodeArea_109", 0.01, "", false);
	AddEnemyPatrolNode("wretch_2", "PathNodeArea_95", 0.01, "", false);
	
	StartLampFlicker("cellar_gaslamp01_short_10");
	
	AddEntityCollideCallback("wretch_2", "AreaPig2Disappear", "EnterPig2Disappear", true, 1);
	AddEntityCollideCallback("wretch_2", "AreaPig2Rise", "EnterPig2Rise", true, 1);
	
	SetLocalVarString("RisePig", "wretch_2");
	
	TeleportPigTo("PathNodeArea_236", 1);
	TeleportPigTo("PathNodeArea_95", 4);
	
	PigRiseEffectEndBegin();
}

void EnterPig2Rise(string &in asParent, string &in asChild, int alState)
{
	ChangeEnemyPose("wretch_2", "Biped");
	
	//*InsertSoundHere*: Pig makes triumphant noise
}


void EnterPig2Disappear(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_2", false);
		
	AddTimer("PigRiseEffectEnd", 0.5f, "TimerPigRiseEffectEnd");
	
	StopLampFlicker("cellar_gaslamp01_short_10");
	SetLampLit("cellar_gaslamp01_short_10", false, true);
}


//-------------------------------------------

void PigRiseEffectEndBegin()
{
	SetPlayerMoveSpeedMul(0.2f);
	SetPlayerLookSpeedMul(0.45f);
	SetPlayerRunSpeedMul(0);
	
	FadePlayerFOVMulTo(0.3f, 0.25f);
	
	SetLocalVarInt("PigRiseEvent",1);
		
	PlayMusic("Chiller_sting 26", false, 0.75f, 0.0f, 8, false);
	
	AddTimer("PlayScream", 3.0f, "PlayRiseScream");
	
	FadeImageTrailTo(1.5, 1);
	
	SetLocalVarInt("RiseLanternActive", GetLanternActive()?1:0);
	SetLanternActive(false, true);
	SetLanternDisabled(true);
	
	AddTimer("UpdateLookAt", 0.01f, "TimerUpdateLookAt");
}

void TimerPigRiseEffectEnd(string &in asTimer)
{
	StopPlayerLookAt();
	
	FadePlayerFOVMulTo(1.0f, 1.05f);
	
	SetLanternDisabled(false);
	if(GetLocalVarInt("RiseLanternActive")==1) 
		SetLanternActive(true, true);
		
	RemoveTimer("UpdateLookAt");
	
	SetPlayerMoveSpeedMul(1);
	SetPlayerLookSpeedMul(1);
	SetPlayerRunSpeedMul(1);

	FadeImageTrailTo(0, 2);
}

void TimerUpdateLookAt(string &in asTimer)
{
	StartPlayerLookAt(GetLocalVarString("RisePig"), 1, 2,"");
	AddTimer(asTimer, 0.2f, "TimerUpdateLookAt");
}

void PlayRiseScream(string &in asTimer)
{
	PlaySoundAtEntity("", "sound_weird_7", "Player", 0.2f, false);
}

//-------------------------------------------

void TeleportPigTo(string &in asNode, float afTime)
{
	AddTimer(asNode, afTime, "TimerPigTeleport_1");
	AddDebugMessage("Teleport!", false);
}

void TimerPigTeleport_1(string &in asNode)
{
	FadeOut(0.1f);
	AddTimer(asNode, 0.25f, "TimerPigTeleport_2");
}

void TimerPigTeleport_2(string &in asNode)
{
	TeleportEnemyToNode(GetLocalVarString("RisePig"), asNode, false);
	
	AddTimer(asNode, 0.05f, "TimerPigTeleport_3");
}

void TimerPigTeleport_3(string &in asNode)
{
	FadeIn(0.5f);
}

