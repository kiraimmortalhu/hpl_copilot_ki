//PADLOCK EVENT//
void PadlockPlayerTrackingHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("PlayerTrackingPadlock = 1", false);
		SetLocalVarInt("PlayerTrackingPadlock", 1);
		//HANDLES CASE IF SHUTTLE IS COLLIDING ALREADY//
		if (GetLocalVarInt("PadlockCapsulePrepped") == 1 && GetLocalVarInt("PadlockChemicalised") == 0)
		{
			string sShuttleIDToDespawn = GetLocalVarString("PadlockShuttleID");
			SetEntityActive(sShuttleIDToDespawn, false);
			SetLocalVarInt("TubeStoreCapsulePrepped", 0);
			SetLocalVarInt("PadlockChemicalised", 1);
			SetPropActiveAndFade("PadlockChemical", true, 3.75f);
			SetPropActiveAndFade("PadlockInit", false, 3.75f);
			PlaySoundAtEntity("PadlockSquelch", "afx_tunnels_substance_lock_combine.snt", "Player", 0.0f, false);
			if (GetLocalVarInt("LightHittingPadlock") == 1)
			{
				LightBeamSequence("Player", "InstantActivation", 1);
			}
		}
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("PlayerTrackingPadlock = 0", false);
		SetLocalVarInt("PlayerTrackingPadlock", 0);
		return;
	}
}

void PadlockShuttleCollisionHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("PadlockCapsulePrepped", 1);
		SetLocalVarString("PadlockShuttleID", asParent);
		AddDebugMessage("Prepped", false);
	}
	else if (alState == -1)
	{
		SetLocalVarInt("PadlockCapsulePrepped", 0);
		AddDebugMessage("Not Prepped", false);
		return;
	}
	if (GetLocalVarInt("PlayerTrackingPadlock") == 1 && GetLocalVarInt("PadlockChemicalised") == 0)
	{
		//SetEntityActive(asParent, false);
		SetPropHealth(asParent, 0);
		SetLocalVarInt("PadlockCapsulePrepped", 0);
		SetLocalVarInt("PadlockChemicalised", 1);
		SetPropActiveAndFade("PadlockChemical", true, 5.75f);
		SetPropActiveAndFade("PadlockInit", false, 5.75f);
		PlaySoundAtEntity("PadlockSquelch", "afx_tunnels_substance_lock_combine.snt", "Player", 0.0f, false);
		if (GetLocalVarInt("LightHittingPadlock") == 1)
		{
			LightBeamSequence("Player", "InstantActivation", 1);
		}
		return;
	}
}
//END PADLOCK EVENT//

//LIGHT BEAM SEQUENCE//
void LightBeamSequence (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("LightHittingPadlock", 1);
		AddDebugMessage("Light HITTING Padlock", false);
		if (asChild == "InstantActivation" && GetLocalVarInt("PadlockDestroyed") == 0)
		{
			AddDebugMessage("Padlock INSTANT ACTIVATION Triggered", false);
			PlaySoundAtEntity("LockFizz", "afx_tunnels_lock_fizz.snt", "PadlockChemical", 0.0f, true);
			CreateParticleSystemAtEntity("PadlockGlowParticles", "ps_chemical_glow.ps", "PadlockParticleSource", false);
			AddTimer("ExplodeParticleTimer", 4.0f, "LightBurnExplosion");
			AddTimer("LockBurnTimer", 4.0f, "LightBurnPreSequence");
			return;
		}
		if (GetLocalVarInt("PadlockDestroyed") == 0 && GetLocalVarInt("PadlockChemicalised") == 1)
		{
			AddTimer("ExplodeParticleTimer", 4.0f, "LightBurnExplosion");
			AddTimer("LockBurnTimer", 4.0f, "LightBurnPreSequence");
			CreateParticleSystemAtEntity("PadlockGlowParticles", "ps_chemical_glow.ps", "PadlockParticleSource", false);
			PlaySoundAtEntity("LockFizz", "afx_tunnels_lock_fizz.snt", "PadlockChemical", 0.0f, true);
		}
		return;
	}
	else if (alState == -1)
	{
		SetLocalVarInt("LightHittingPadlock", 0);
		RemoveTimer("LockBurnTimer");
		RemoveTimer("ExplodeParticleTimer");
		StopSound("LockFizz", 1.0f);
		DestroyParticleSystem("PadlockGlowParticles");
		AddDebugMessage("Light NOT HITTING Padlock", false);
		return;
	}
}

void LightBurnPreSequence (string &in asTimer)
{
	AddTimer("LightBurnMain", 1.0f, "LightBurnSequence");
}

void LightBurnSequence (string &in asTimer)
{
	StopSound("LockFizz", 0.1f);
	StartEffectFlash(0.8f, 0.06f, 0.07f);
	PlaySoundAtEntity("LockFizzLoop", "afx_tunnels_post_explosion_lock_sizzle_loop.snt", "PadlockBroken", 0.0f, true);
	AddTimer("PadlockDestroyedMusicTimer", 1.0f, "PadlockMusic");
	PlaySoundAtEntity("","afx_tunnels_gate_lock_explode.snt", "PadlockChemical", 0.0f, false);
	SetSwingDoorLocked("prison_section_1", false, true);
	SetEntityPlayerInteractCallback("prison_section_1", "", false);
	SetEntityActive("PadlockChemical", false);
	SetEntityActive("PadlockBroken", true);
	SetLocalVarInt("PadlockDestroyed", 1);
}

void LightBurnExplosion (string &in asTimer)
{
	CreateParticleSystemAtEntity("PadlockBlastParticles", "ps_chemical_blast.ps", "PadlockParticleSource2", false);
}

void PadlockMusic (string &in asTimer)
{
	PlayMusic("music_tunnels_sewer_gate_open.ogg", false, 1.0f, 1.0f, 8, false);
}
//END LIGHT BEAM SEQUENCE//

