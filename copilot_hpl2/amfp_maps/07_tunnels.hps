//------------------------
//START END SHAKE//
//------------------------
void CollideEndShake(string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("strain", "dumb_waiter_strain_loop.snt", "Player", 4, false);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 2, false);
	
	StartScreenShake(0.007, 2, 4, 4);
	FadeImageTrailTo(1, 0.5);
	FadePlayerFOVMulTo(0.5, 0.07);
	FadePlayerAspectMulTo(2, 0.05);
	MandusReactionPlayer("Breath", 2);
	MandusReactionPlayer("Breath", 7);
	AddTimer("", 4, "StopEndShake");
	
}

void StopEndShake(string &in asTimer)
{
	StopSound("strain", 12);
	FadePlayerFOVMulTo(1, 0.1);
	FadePlayerAspectMulTo(1, 0.1);
	FadeImageTrailTo(0,0.1);
}
//------------------------
//END END SHAKE //
//------------------------
