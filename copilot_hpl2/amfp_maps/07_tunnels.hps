			SetEntityConnectionStateChangeCallback("TubeLeverStore", "TubeLeverHandler");
			SetEntityConnectionStateChangeCallback("TubeLeverChiller", "TubeLeverHandler");
			SetEntityConnectionStateChangeCallback("TubeLeverLab", "TubeLeverHandler");
			SetEntityConnectionStateChangeCallback("TubeLeverCentrifuge", "TubeLeverHandler");
			SetEntityConnectionStateChangeCallback("ChillerDispenserSwitch", "ChillerDispenserHandler");
			SetEntityConnectionStateChangeCallback("CentrifugeButton", "CentrifugeSpinSequence");
			SetEntityConnectionStateChangeCallback("FrogSwitch", "FrogHandler");
			
