//PIG 5 ENCOUNTER //
//------------------------

//-------------------------------------------

void EnterPig5Flicker(string &in asParent, string &in asChild, int alState)
{
	LanternFlicker(4);
	StartLampFlickerBurst("cellar_gaslamp01_short_21", 4);
	StartLampFlickerBurst("cellar_gaslamp01_short_23", 4);
}

void EnterPig5Start(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("ChaseSeqFence", true);
	SetEntityActive("ChaseSeqFence_1", false);
	
	SetEntityActive("FlashbackVOTrigger_2", true);	//Flashback when going to other canister.

	AddTimer("piggy_was_sleeping_and_wasnt_on_alert_the_very_first_second_the_player_appear_but_piggy_stil_got_up_and_got_things_done_oh_hello_forum_user!", 0.3, "TimerDelayPig");
	
	PlaySoundAtEntity("fence_down", "afx_event_factory_gate_close", "ChaseSeqFence", 0, false);
	
	StartLampFlickerBurst("cellar_gaslamp01_short_23", 3);
	
	AddTimer("Pig5SeePlayer", 1.75f, "TimerPig5SeePlayer");
	AddTimer("Pig5SeePlayer", 3.04, "TimerLampOn");
	
	AddEntityCollideCallback("Player", "AreaPig5Disable", "EnterPig5Disable", true, 0);
	
	CheckPoint("CoolerCheckPoint", "CheckPointCooler", "CheckPointCooler", "", "", false);
}

void TimerDelayPig(string &in asTimer)
{
	SetEntityActive("wretch_5", true);
}

void TimerLampOn(string &in asTimer)
{
	SetLampLit("cellar_gaslamp01_short_23", true, false);
}

void CheckPointCooler(string &in asName, int alCount)
{
	SetEntityActive("ChaseSeqFence", false);
	SetEntityActive("ChaseSeqFence_1", true);
	SetEntityActive("AreaPig5Disable", false);
}

void TimerPig5SeePlayer(string &in asTimer)
{
	ShowEnemyPlayerPosition("wretch_5");
	
	AddTimer("Pig5SeePlayer", 0.25f, "TimerPig5SeePlayer");
}

void EnterPig5Disable(string &in asParent, string &in asChild, int alState)
{
	FadeEnemyToSmoke("wretch_5", true);
	SetEntityActive("ChaseSeqFence", false);
	SetEntityActive("ChaseSeqFence_1", true);
	SetSwingDoorLocked("CentrifugeDoor", true, false);
	
	AddTimer("w5p1", 0, "TimerW5Slam");
	AddTimer("w5p2", 0.4f, "TimerW5Slam");
	AddTimer("w5p3", 1.0f, "TimerW5Slam");
	AddTimer("w5p4", 1.4f, "TimerW5Slam");
	AddTimer("w5p5", 2.0f, "TimerW5Slam");
	
	RemoveTimer("Pig5SeePlayer");
}

void TimerW5Slam(string &in asTimer)
{
	if(asTimer == "w5p1")
	{
		PlaySoundAtEntity("scream_1", "wretch_tunnels_attack_bipedvo_2.snt", "CentrifugeDoor", 0, false);
	}
	if(asTimer == "w5p2")
	{
		if(GetLocalVarInt("PlayerW5Pos") == 1) TeleportPlayer("PlayerStartArea_1");
		
		AddPropImpulse("CentrifugeDoor", 150,0,150, "World");
		PlaySoundAtEntity("bang_1", "afx_mansion_pig_slam_door_1.snt", "CentrifugeDoor", 0.1, false);
	}
	if(asTimer == "w5p3")
	{
		StopSound("bang_1", 1);
		AddPropImpulse("CentrifugeDoor", -200,0,-200, "World");
		PlaySoundAtEntity("bang_2", "afx_mansion_pig_slam_door_1.snt", "CentrifugeDoor", 0, false);
	}
	if(asTimer == "w5p4")
	{
		StopSound("bang_2", 1);
		AddPropImpulse("CentrifugeDoor", 100,0,100, "World");
		PlaySoundAtEntity("scream_2", "wretch_tunnels_vomitattack.snt", "CentrifugeDoor", 0, false);
		PlaySoundAtEntity("bang_3", "afx_mansion_pig_slam_door_1.snt", "CentrifugeDoor", 0.2, false);
	}
	if(asTimer == "w5p5")
	{
		StopSound("bang_3", 1);
	}
}

void CheckPlayerPos(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("PlayerW5Pos",alState);
}

