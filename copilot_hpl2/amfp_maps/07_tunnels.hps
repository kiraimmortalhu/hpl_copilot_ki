			//MASK TRIGGERS//
			AddEntityCollideCallback("Player", "Mask1SpawnTrigger", "MaskSpawnDespawnHandler", true, 1);
			AddEntityCollideCallback("Player", "Mask1DespawnTrigger", "MaskSpawnDespawnHandler", true, 1);
