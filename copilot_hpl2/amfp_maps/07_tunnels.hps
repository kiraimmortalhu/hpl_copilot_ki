			SetEntityPlayerLookAtCallback("Mask1LookArea", "MaskLookTracker", false);
			SetEntityPlayerLookAtCallback("CorridorChangeNowLookTracker", "CorridorLookTracker", false);
		}
	
		//Setup Triggered VO Callbacks
		{
			//FLASHBACK
			AddEntityCollideCallback("Player", "FlashbackVOTrigger_1", "VOPlayer", true, 1); 	
			AddEntityCollideCallback("Player", "FlashbackVOTrigger_2", "VOPlayer", true, 1); 	
			AddEntityCollideCallback("Player", "FlashbackVOTrigger_2_2", "VOPlayer", true, 1); 
			AddEntityCollideCallback("Player", "childVOtrigger1", "VOPlayer", true, 1); 		
			AddEntityCollideCallback("Player", "childVOtrigger2", "VOPlayer", true, 1);
		}
	
	//Setup Initial Object States
		{
			//ANIMATION STATES//
			PlayPropAnimation("StartLiftShaft", "static_top", 0.0f, true, "");
			PlayPropAnimation("TubeStore", "no_shuttle", 0.0f, true, "");
			PlayPropAnimation("TubeChiller", "no_shuttle", 0.0f, true, "");
