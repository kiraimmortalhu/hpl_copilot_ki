//MUSIC PLAYER//
void MusicHandler (string &in asParent, string &in asChild, int alState)																			//!! REWORK
{
 if (asChild == "MusicTrigger")
	{
		PlayMusic("music_cellar_postpigsmash2.ogg", false, 1.0f, 0.0f, 6, false);
	}
	
	else if (asChild == "MysteryCorridorMusic")
	{
		PlayMusic("music_tunnels_mystery_174.ogg", false, 0.8f, 1.0f, 0, false);
		return;
	}
}

