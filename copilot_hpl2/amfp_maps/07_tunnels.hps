{
	StartLampFlickerBurst("cellar_gaslamp01_short_9", 3);
	AddTimer("Pig4LightOff", 3.25f, "TimerPig4LightOff");
}

void TimerPig4LightOff(string &in asTimer)
{
	SetLampLit("cellar_gaslamp01_short_9", false, true);
	
	//*InsertSoundHere*: The lamp goes out.
}

