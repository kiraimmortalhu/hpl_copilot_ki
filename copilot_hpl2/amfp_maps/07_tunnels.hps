void CentShuttleCollisionHandler (string &in asParent, string &in asChild, int alState)
{
	string sShuttleName = StringSub(asParent, 0, 7);			 //This is required for use in the if statement below, as wildcard comparisons are not supported.
	AddDebugMessage("sShuttleName = "+sShuttleName, false);
	
	string sChemicalTypeInsertionCheckString = StringSub(asParent, 8, 9);
	int lChemicalTypeInsertionCheck = StringToInt(sChemicalTypeInsertionCheckString);
	AddDebugMessage("Chemical Type Prepped = "+lChemicalTypeInsertionCheck, false);
	SetLocalVarInt("CentChemicalTypeInsertionCheck", lChemicalTypeInsertionCheck);
	
	//CENTRIFUGE CAGE A//
	if (asChild == "CentACollider")
	{
		if(GetLocalVarInt("Shutt1NotInA") == 1 && lChemicalTypeInsertionCheck == 1) return;
		if(GetLocalVarInt("Shutt2NotInA") == 1 && lChemicalTypeInsertionCheck == 2) return;
		
		SetLocalVarString("CentAShuttleID", asParent);
	
		if (asChild == "CentACollider" && alState == 1)
		{	
			SetLocalVarInt("CentACapsulePrepped", 1);
			SetLocalVarString("CentAShuttleID", asParent);
			AddDebugMessage("Prepped", false);
		}
		else if (alState == -1)
		{
			SetLocalVarInt("CentACapsulePrepped", 0);
			AddDebugMessage("Not Prepped", false);
		}
		if (GetLocalVarInt("PlayerTrackingCentA") == 1 && GetLocalVarInt("CentAEmpty") == 1 && lChemicalTypeInsertionCheck == 1)
		{
			SetEntityActive(asParent, false);
			PlaySoundAtEntity("", "afx_tunnels_shuttle_cent.snt", "Player", 0.0f, false);
			SetEntityActive("ShuttleAFitted", true);
			SetLocalVarInt("CentACapsulePrepped", 0);
			SetLocalVarInt("CentAEmpty", 0);
			SetLocalVarInt("Shutt1NotInB", 1);
			AddDebugMessage("Chemical Type 1 Inserted in Centrifuge Cage A", false);
			CheckCentrifugeState();
			return;
		}
		else if (GetLocalVarInt("PlayerTrackingCentA") == 1 && GetLocalVarInt("CentAEmpty") == 1 && lChemicalTypeInsertionCheck == 2)
		{
			//AddDebugMessage("This is the Wrong Chemical for this Port", false);
			SetEntityActive(asParent, false);
			PlaySoundAtEntity("", "afx_tunnels_shuttle_cent.snt", "Player", 0.0f, false);
			SetEntityActive("ShuttleBFittedInA", true);
			SetLocalVarInt("CentACapsulePrepped", 0);
			SetLocalVarInt("CentAEmpty", 0);
			SetLocalVarInt("Shutt2NotInB", 1);
			AddDebugMessage("Chemical Type 2 Inserted in Centrifuge Cage A", false);
			CheckCentrifugeState();
			return;
		}
	}
	//CENTRIFUGE CAGE B//
	else if (asChild == "CentBCollider")
	{
		if(GetLocalVarInt("Shutt1NotInB") == 1 && lChemicalTypeInsertionCheck == 1) return;
		if(GetLocalVarInt("Shutt2NotInB") == 1 && lChemicalTypeInsertionCheck == 2) return;
		
		SetLocalVarString("CentBShuttleID", asParent);
		
		if (asChild == "CentBCollider" && alState == 1)
		{	
			SetLocalVarInt("CentBCapsulePrepped", 1);
			SetLocalVarString("CentBShuttleID", asParent);
			AddDebugMessage("Prepped", false);
		}
		else if (alState == -1)
		{
			SetLocalVarInt("CentBCapsulePrepped", 0);
			AddDebugMessage("Not Prepped", false);
		}
		if (GetLocalVarInt("PlayerTrackingCentB") == 1 && GetLocalVarInt("CentBEmpty") == 1 && lChemicalTypeInsertionCheck == 2)
		{
			SetEntityActive(asParent, false);
			PlaySoundAtEntity("", "afx_tunnels_shuttle_cent.snt", "Player", 0.0f, false);
			SetEntityActive("ShuttleBFitted", true);
			SetLocalVarInt("CentBCapsulePrepped", 0);
			SetLocalVarInt("CentBEmpty", 0);
			SetLocalVarInt("Shutt2NotInA", 1);
			AddDebugMessage("Chemical Type 2 Inserted in Centrifuge Cage B", false);
			CheckCentrifugeState();
			return;
		}
		else if (GetLocalVarInt("PlayerTrackingCentB") == 1 && GetLocalVarInt("CentBEmpty") == 1 && lChemicalTypeInsertionCheck == 1)
		{
			//AddDebugMessage("This is the Wrong Chemical for this Port", false);
			SetEntityActive(asParent, false);
			PlaySoundAtEntity("", "afx_tunnels_shuttle_cent.snt", "Player", 0.0f, false);
			SetEntityActive("ShuttleAFittedInB", true);
			SetLocalVarInt("CentBCapsulePrepped", 0);
			SetLocalVarInt("CentBEmpty", 0);
			SetLocalVarInt("Shutt1NotInA", 1);
			AddDebugMessage("Chemical Type 1 Inserted in Centrifuge Cage B", false);
			CheckCentrifugeState();
			return;
		}
	}
}

void CheckCentrifugeState()
{
	if (GetLocalVarInt("CentAEmpty") == 0 && GetLocalVarInt("CentBEmpty") == 0)
	{
		SetLightVisible("CentrifugeSwitchLight", true);
		SetLightFlickerActive("CentrifugeSwitchLight",true);
		SetButtonSwitchedOn("CentrifugeButton", true, true);
		SetButtonCanBeSwitchedOff("CentrifugeButton", true);
	}
}

void CentrifugeSpinSequence (string &in asEntity, int alState)
{
	if (alState == -1 && GetLocalVarInt("CentAEmpty") == 0 && GetLocalVarInt("CentBEmpty") == 0)
	{
		PlaySoundAtEntity("", "afx_mansion_switchboard_switch", "Player", 0.0f, false);
		PlayMusic("music_cellar_children_walkway.ogg", false, 1.0f, 1.0f, 8, false);
		SetLightVisible("CentrifugeSwitchLight", false);
		SetLightFlickerActive("CentrifugeSwitchLight",false);
		SetSwingDoorLocked("CentrifugeDoor", true, false);
		AddTimer("LightFlickerTimer1", 0.4f, "PigChargeEvent");
		AddTimer("LightFlickerTimer2", 0.7f, "PigChargeEvent");
		AddTimer("LightFlickerTimer3", 1.0f, "PigChargeEvent");
		AddTimer("LanternFlickerStart", 0.5f, "PigChargeEvent");
		AddTimer("InitClosing", 0.1f, "PigChargeEvent");
		AddTimer("InitClosing2", 0.1f, "PigChargeEvent");
		AddTimer("PigCharge", 1.7f, "PigChargeEvent");
		AddTimer("SpinCentrifuge", 9.0f, "SpinCentrifuge");
		AddTimer("LanternRestore", 14.0f, "PigChargeEvent");
		return;
	}
	else
	{
		//TODO: ADD VO?
		return;
	}
}

void SpinCentrifuge (string &in asTimer)
{
	PlayPropAnimation("CentrifugeArms", "animated", 0.0f, false, "");
	SetSwingDoorLocked("EngineerSmashDoor", false, true);
	AddTimer("CentrifugePigScreamTimer", 2.5f, "CentrifugePigSetup");
	AddTimer("CentrifugePigSpawnTimer", 2.5f, "CentrifugePigSetup");
	AddTimer("CentrifugeSpinTimerPre", 5.0f, "CentrifugePostSpinSequence");
	AddTimer("CentrifugeSpinTimer", 7.0f, "CentrifugePostSpinSequence");
	SetLocalVarInt("CentrifugeHasSpun", 1);
	AddEntityCollideCallback("Player", "vo_centrifuge_activated_trigger", "VOPlayer", true, 1);
}

void PigChargeEvent (string &in asTimer)
{
	if (asTimer == "LightFlickerTimer1")
	{
		PlaySoundAtEntity("", "afx_cellar_light_flicker.snt", "cellar_gaslamp01_long_small_point_light_8", 0.0f, false);
		SetLampLit("cellar_gaslamp01_long_small_point_light_8", false, false);
		return;
	}
	else if (asTimer == "LightFlickerTimer2")
	{
		PlaySoundAtEntity("", "afx_cellar_light_flicker.snt", "cellar_gaslamp01_long_small_point_light_9", 0.0f, false);
		SetLampLit("cellar_gaslamp01_long_small_point_light_9", false, false);
		return;
	}
	else if (asTimer == "LightFlickerTimer3")
	{
		SetEntityActive("CentrifugeBlockBox_*", true);
		PlaySoundAtEntity("", "afx_cellar_light_flicker.snt", "cellar_gaslamp01_long_small_point_light_4", 0.0f, false);
		SetLampLit("cellar_gaslamp01_long_small_point_light_4", false, false);
		return;
	}
	else if (asTimer == "LanternFlickerStart")
	{
		//SetLanternFlickerActive(true);
	}
	else if (asTimer == "InitClosing")
	{
		SetEntityActive("CentTriggeredBlockBox_*", true);
		SetLocalVarInt("PigChargeEvent", 1);
		PlayPropAnimation("bulkhead_door_1", "anim_close_smooth", 0.0f, false, "");
		SetMoveObjectState("bulkhead_blockbox_1", 0);
		return;
	}
		else if (asTimer == "InitClosing2")
	{
		PlayPropAnimation("bulkhead_door_2", "anim_close_smooth", 0.0f, false, "");
		SetMoveObjectState("bulkhead_blockbox_2", 0);
		SetLocalVarInt("PigChargeEvent", 1);
		return;
	}
	else if (asTimer == "PigCharge")
	{
		SetEntityActive("CentrifugeWretch", true);
		PlaySoundAtEntity("", "afx_church_factory_bigscream.snt", "CentrifugeWretch", 0.0f, false);
		AddEnemyPatrolNode("CentrifugeWretch", "PathNodeArea_12", 0.0f, "", false);
		AddEnemyPatrolNode("CentrifugeWretch", "PathNodeArea_13", 0.0f, "ThreatLoop", false);
		AddTimer("PigRemove", 6.0f, "PigChargeEvent");
		return;
	}
	else if (asTimer == "PigRemove")
	{
		SetEntityActive("CentrifugeWretch", false);
		ClearEnemyPatrolNodes("CentrifugeWretch");
		return;
	}
	else if (asTimer == "LanternRestore")
	{
		//SetLanternFlickerActive(false);
		return;
	}
}

void CentrifugePostSpinSequence (string &in asTimer)
{
	if(asTimer == "CentrifugeSpinTimerPre")
	{
		SetEntityActive("Shuttle_3_1", false);
		SetEntityActive("Shuttle_3_done", true);
		return;
	}
	if(asTimer == "CentrifugeSpinTimer")
	{
		SetEntityActive("Shuttle_3_done", false);
		DetachPropFromBone("Shuttle_3_done");
		SetEntityActive("Shuttle_3_done", true);
	}
	
	//DetachPropFromBone("Shuttle_3_done");
	//SetEntityActive("Shuttle_3_done", false);
//	SetEntityActive("Shuttle_3_done", true);
	SetEntityActive("CentrifugeBlockBox_*", false);
	SetEntityInteractionDisabled("Shuttle_3_done", false);
}

