{
	AddEntityCollideCallback("Player", "AreaPig4Start", "EnterPig4Start", true, 0);
}

//-------------------------------------------

void EnterPig4Start(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_4", true);
	
	ClearEnemyPatrolNodes("wretch_4");
	for(int i=0; i<6; ++i)
	{
		if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_4", "PathNodeArea_37", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1)	AddEnemyPatrolNode("wretch_4", "PathNodeArea_78", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_4", "PathNodeArea_30", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_4", "PathNodeArea_62", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1)	AddEnemyPatrolNode("wretch_4", "PathNodeArea_44", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_4", "PathNodeArea_56", RandFloat(0, 7), "", false);
		if(RandInt(1,2)==1) AddEnemyPatrolNode("wretch_4", "PathNodeArea_79", RandFloat(0, 7), "", false);
	}
	
	if(GetLocalVarInt("Pig4KilledPlayer")==0)
	{
		AddEntityCollideCallback("wretch_4", "AreaPig4Disappear_1", "EnterPig4Disappear", true, 1);
		AddEntityCollideCallback("wretch_4", "AreaPig4Disappear_2", "EnterPig4Disappear", true, 1);
		AddEntityCollideCallback("Player", "AreaPig4Disable", "EnterPig4Disable", true, 1);
		
		CheckPoint("CageCheckPoint", "CheckpointCage", "CheckPointCage", "", "", false);
		
		AddTimer("Pig4LightFlicker", 2.5f, "TimerPig4LightFlicker");
	}
}

