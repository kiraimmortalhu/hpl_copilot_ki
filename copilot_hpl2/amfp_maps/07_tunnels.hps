			AddEntityCollideCallback("Player", "AFX_Creak_07", "CreakAreas", false, 0);
		}
				
	//Setup Ambience Callbacks
		{
			//AddEntityCollideCallback("Player", "AMB_Area_01", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_CentrifugeRoom", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMB_CentrifugeRoom_1", "MapAmbienceAreas", false, 0);
