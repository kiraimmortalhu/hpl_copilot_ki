			SetLocalVarInt("PlayerTrackingCentB", 0);
			SetLocalVarInt("PlayerTrackingCentC", 0);
			SetLocalVarInt("CentAShuttlePrepped", 0);
			SetLocalVarInt("CentBShuttlePrepped", 0);
			SetLocalVarString("CentAShuttleID", "Void");
			SetLocalVarString("CentBShuttleID", "Void");
			SetLocalVarInt("CentAEmpty", 1);
			SetLocalVarInt("CentBEmpty", 1);
			SetLocalVarInt("CentCEmpty", 0);
			SetLocalVarInt("MakeChemicalRemovalNoise", 1);
			SetLocalVarInt("CentrifugeHasSpun", 0);
			SetLocalVarInt("PigChargeEvent", 0);
			//PADLOCK EVENT VARIABLES//
			SetLocalVarInt("PlayerTrackingPadlock", 0);
			SetLocalVarString("PadlockShuttleID", "Void");
			SetLocalVarInt("PadlockCapsulePrepped", 0);
			SetLocalVarInt("LightHittingPadlock", 0);
			//MASK VARIABLES//
			SetLocalVarInt("LookingAtMask1", 0);
			//CORRIDOR VARIABLES//
			SetLocalVarInt("ChangeCorridor", 0);
			SetLocalVarInt("ChangeCorridorLookTracking", 0);
			SetLocalVarInt("ChangeCorridorProximityTracking", 0);
			//OTHER VARIABLES//
			SetLocalVarInt("KillIntroAmbience", 1);
			SetLocalVarInt("LiftSequenceStepTracker", 0); //CHANGE TO ANY OTHER NON-ZERO VALUE TO SKIP INTRO SEQUENCE
			SetLocalVarInt("IntroComplete", 0);
			SetLocalVarInt("StoreTubePigTriggered", 0);
			SetLocalVarInt("ChillerDispenserEmpty", 1);
			SetLocalVarInt("NumberOfShuttlesInDispenserCollider", 0);
			SetLocalVarInt("BlockingSteamActive", 1);
			SetLocalVarInt("OddStinger2Triggered", 0);
		}
	
	//AutoRun Events
		{	
			if (GetLocalVarInt("LiftSequenceStepTracker") == 0)
			{
				FadeOut(0.0f);
				SetPlayerCrouching(true);
				SetPlayerCrouchDisabled(true);
				AddTimer("LiftShaftStartTimer", 0.25f, "LiftShaftSequencer");
				SetPlayerActive(false);
			}
			else
			{
				TeleportPlayer("MainStart");
			}
		}
		
	//Setup Initial Entity Callbacks
		{
			//COLLISION CALLBACKS//
			AddEntityCollideCallback("Player", "PlayerTrackingStore", "TubePlayerTrackingHandler", false, 0);
			AddEntityCollideCallback("Player", "centrifuge_discovery", "CentPlayerTrackingHandler", true, 1);
			AddEntityCollideCallback("Shuttle_*", "TubeColliderStore", "TubeShuttleCollisionHandler", false, 0);
			AddEntityCollideCallback("Player", "PlayerTrackingChiller", "TubePlayerTrackingHandler", false, 0);
			AddEntityCollideCallback("Shuttle_*", "TubeColliderChiller", "TubeShuttleCollisionHandler", false, 0);
			AddEntityCollideCallback("Player", "PlayerTrackingLab", "TubePlayerTrackingHandler", false, 0);
			AddEntityCollideCallback("Shuttle_*", "TubeColliderLab", "TubeShuttleCollisionHandler", false, 0);
			AddEntityCollideCallback("Player", "PlayerTrackingCentrifuge", "TubePlayerTrackingHandler", false, 0);
			AddEntityCollideCallback("Shuttle_*", "TubeColliderCentrifuge", "TubeShuttleCollisionHandler", false, 0);
