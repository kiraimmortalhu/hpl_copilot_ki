//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "childVOtrigger1")
	{
		AddEffectVoice("vo_tunnels_trigger_child_01.ogg", "", "Voice", "vo_tunnels_trigger_child_01", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "childVOtrigger2")
	{
		AddEffectVoice("vo_tunnels_trigger_child_02.ogg", "", "Voice", "vo_tunnels_trigger_child_02", false, "", 0.0f, 0.0f);
		return;
	}
	
//FLASHBACKS
	else if (asChild == "FlashbackVOTrigger_1")
	{
		//AddEffectVoice("vo_tunnels_trigger_mandus_01_flashback.ogg", "", "Voice", "vo_tunnels_trigger_mandus_01_flashback", false, "", 0.0f, 0.0f);
		AddEffectVoice2("vo_tunnels_trigger_mandus_01_flashback.ogg", "", "Voice", "vo_tunnels_trigger_mandus_01_flashback_01", 0.0f, "vo_tunnels_trigger_mandus_01_flashback_02", 9.0f, false, "", 0.0f, 0.0f);
		
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 13.5f, "ReturnToNormal");
		return;
	}
		else if (asChild == "FlashbackVOTrigger_2" || asChild == "FlashbackVOTrigger_2_2")
	{
		RemoveEntityCollideCallback("Player", "FlashbackVOTrigger_2");
		RemoveEntityCollideCallback("Player", "FlashbackVOTrigger_2_2");
		//AddEffectVoice("vo_tunnels_trigger_mandus_02_flashback.ogg", "", "Voice", "vo_tunnels_trigger_mandus_02_flashback", false, "", 0.0f, 0.0f);
		AddEffectVoice4("vo_tunnels_trigger_mandus_02_flashback.ogg", "", "Voice", "vo_tunnels_trigger_mandus_02_flashback_01", 0.0f, "vo_tunnels_trigger_mandus_02_flashback_02", 4.4f, "vo_tunnels_trigger_mandus_02_flashback_03", 7.7f, "vo_tunnels_trigger_mandus_02_flashback_04", 12.07f, false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 17.5f, "ReturnToNormal");
		return;
	}
	
}
//END TRIGGERED VO PLAYER//

//RETURN TO NORMAL//
void ReturnToNormal (string &in asTimer)
{
	FadeImageTrailTo(0.0f, 2.0f);
	FadeRadialBlurTo(0.0f, 2.0f);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	StopPlayerLookAt();
}
///END RETURN TO NORMAL//

//PHONE BOX HANDLER//
void PhoneBoxHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "PistonPhoneTrigger")
	{
		AddTimer("PhoneBox1Timer", RandFloat(0.5f, 2.0f), "PhoneBoxTimers");
		AddHint("Tunnels1", "");
		return;
	}
	else if (asChild == "PistonPhoneStopTrigger")
	{
		StopPhoneRinging("phone_box_1");
		SetEntityPlayerInteractCallback("phone_box_1", "", false);
		SetLampLit("phone_box_1_light", false, true);
		return;
	}
	else if (asChild == "LabPhoneTrigger")
	{
		AddEntityCollideCallback("Player", "LabPhoneStopTrigger1", "PhoneBoxHandler", true, 1);
		AddEntityCollideCallback("Player", "LabPhoneStopTrigger2", "PhoneBoxHandler", true, 1);
		AddTimer("PhoneBox2Timer", RandFloat(0.5f, 2.0f), "PhoneBoxTimers");
		return;
	}
	else if (asChild == "LabPhoneStopTrigger1" || asChild == "LabPhoneStopTrigger2" || asChild == "LabPhoneStopTrigger3")
	{
		if (GetTimerTimeLeft("PhoneBox2Timer") > 0)
		{
			RemoveTimer("PhoneBox2Timer");
			AddEntityCollideCallback("Player", "LabPhoneTrigger", "PhoneBoxHandler", true, 1);
		}
		
		AddDebugMessage("PhoneBoxHandler", false);
		StopPhoneRinging("phone_box_2");
		SetEntityPlayerInteractCallback("phone_box_2", "", false);
		SetLampLit("phone_box_2_light", false, true);
		return;
	}
}

void PhoneBoxTimers (string &in asTimer)
{
	if (asTimer == "PhoneBox2Timer")
	{
		SetLampLit("phone_box_2_light", true, true);
		StartPhoneRinging("phone_box_2");
		SetEntityPlayerInteractCallback("phone_box_2", "InteractPhoneBox", true);
		return;
	}
	else if (asTimer == "PhoneBox1Timer")
	{
		SetLampLit("DumbWaiterLight", false, true);
		StopSound("LiftSparks", 0.5);
		SetLampLit("phone_box_1_light", true, true);
		StartPhoneRinging("phone_box_1");
		SetEntityPlayerInteractCallback("phone_box_1", "InteractPhoneBox", true);
		return;
	}
}

void InteractPhoneBox (string &in asEntity)
{		
	if (asEntity == "phone_box_1")
	{
		AddTimer("phone_box_1", 10.3, "PhoneCallOver");
		StopSound("phone_box_1_AnimEvent", 0.1f);
	}
	
	else if (asEntity == "phone_box_2")
	{
		AddTimer("phone_box_2", 12.8, "PhoneCallOver");
		StopSound("phone_box_2_AnimEvent", 0.1f);
	}
}

void PhoneCallOver (string &in asTimer)
{
	SetLampLit(asTimer + "_light", false, true);
}
//END PHONE BOX HANDLER//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//RESTORE POST EFFECTS//
void RestorePostEffects (string &in asTimer)
{
	FadeImageTrailTo(0.0f, 3.0f);
	FadeRadialBlurTo(0.0f, 3.0f);
	SetPlayerLookSpeedMul(1.0f);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
}
//END RESTORE POST EFFECTS//

