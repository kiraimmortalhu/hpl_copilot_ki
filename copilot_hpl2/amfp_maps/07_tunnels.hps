//CORRIDOR WIND EVENT//
void CorridorWindEvent (string &in asParent, string &in asChild, int alState)
{
	SetParticleSystemActive("CorridorWindParticles", true);
	SetEntityInteractionDisabled("tunnels_door_2", true);
	PlaySoundAtEntity("", "spooky_wind_whirl.snt", "Player", 0.0f, false);
	AddTimer("CorridorWindEventTimer1", 0.2f, "CorridorWindEventTimers");
	AddTimer("CorridorWindEventTimer2", 1.0f, "CorridorWindEventTimers");
	AddTimer("CorridorWindEventTimer3", 1.5f, "CorridorWindEventTimers");
}

void CorridorWindEventTimers (string &in asTimer)
{
	if (asTimer == "CorridorWindEventTimer1")
	{
		AddPropForce("cellar_gaslamp01_short_small_point_light_11", 0.0f, 0.0f, -150.0f, "world");
		return;
	}
	else if (asTimer == "CorridorWindEventTimer2")
	{
		PlaySoundAtEntity("", "joint_factory_door_hinge.snt", "tunnels_door_2", 0.0f, false);
		SetSwingDoorDisableAutoClose("tunnels_door_2", true);
		SetSwingDoorOpenAmount("tunnels_door_2", 0, 1.0f, true);
		AddTimer("LockDoorTimer", 1.0f, "CorridorWindEventTimers");
		return;
	}
	else if (asTimer == "CorridorWindEventTimer3")
	{
		SetSwingDoorDisableAutoClose("tunnels_door_3", true);
		SetSwingDoorClosed("tunnels_door_3", false, false);
		SetSwingDoorLocked("tunnels_door_3", false, false);
		PlaySoundAtEntity("", "joint_factory_door_hinge.snt", "tunnels_door_3", 0.0f, false);
		SetSwingDoorOpenAmount("tunnels_door_3", 0.7, 2.5f, true);
		AddTimer("RestoreAutoCloseTimer", 2.5f, "CorridorWindEventTimers");
		return;
	}
	else if (asTimer == "LockDoorTimer")
	{
		PlaySoundAtEntity("", "joint_factory_door_close.snt", "tunnels_door_2", 0.0f, false);
		SetSwingDoorClosed("tunnels_door_2", true, false);
		SetSwingDoorLocked("tunnels_door_2", true, false);
		SetEntityInteractionDisabled("tunnels_door_2", false);
		return;
	}
	else if (asTimer == "RestoreAutoCloseTimer")
	{
		SetSwingDoorDisableAutoClose("tunnels_door_3", false);
		return;
	}
}
//END CORRIDOR WIND EVENT//

