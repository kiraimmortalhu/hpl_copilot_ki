}

//END CAGES LANTERN HANDLER1//

//CAGES LANTERN HANDLER2// 
void CagesLanternHandler2 (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesLanternTrigger2")
	{
		if (alState == 1)
		{
			SetLanternFlickerActive(true);
			return;
		}
	}
}
//END CAGES LANTERN HANDLER2//

//CAGES LANTERN HANDLER3// Attack-Strobe
void CagesLanternHandler3 (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesLanternTrigger3")
	{
		if (alState == 1)
		{
			SetLanternFlickerActive(true);
			return;
		}
		else if (alState == -1)
		{
			SetLanternFlickerActive(false);
			return;
		}
	}
}
//END CAGES LANTERN HANDLER3//

//CAGES LANTERN HANDLER4// RESUME LANTERN (if player doesn't trigger wretch event)
void CagesLanternHandler4 (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesLanternTrigger4")
	{
			SetLanternFlickerActive(false);
			return;
	}
}
//END CAGES LANTERN HANDLER4//

//POST CAGE EVENT LANTERN HANDLER//
void CagesLanternEnd (string &in asTimer)
	{
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger2");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1b");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1c");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger3");
		SetLanternFlickerActive(false);
	}
//END POST CAGE EVENT//

//PIG HANDLERS//
//CAGES PIG//
void CagesWretchHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesWretchTrigger")
	{
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger2");
		AddEntityCollideCallback("Player", "CagesLanternTrigger3", "CagesLanternHandler3", false, 0);
		SetEntityActive("CagesWretch", true);
		PlaySoundAtEntity("", "afx_tunnels_pigspawn.snt", "Player", 0.0f, false);
		MandusReactionPlayer("Breath", 3.6f);
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_9", 4.0f, "", false);
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_10", 0.0f, "", false);
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_11", 5.0f, "", false);
		AddTimer("CagesLanternEnd", 12.5f, "CagesLanternEnd");
	}
	
	else if (asChild == "CagesWretchKillTrigger")
	{
		ClearEnemyPatrolNodes("CagesWretch");
		SetEntityActive("CagesWretch", false);
		AddEntityCollideCallback("Player", "CagesLanternTrigger2", "CagesLanternHandler2", false, 0);
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1b");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger1c");
		RemoveEntityCollideCallback("Player", "CagesLanternTrigger3");
		AddTimer("CagesLanternEnd", 2.5f, "CagesLanternEnd");
		return;
	}
}
//END CAGES PIG//	
//END LEVEL PIG HANDLERS//

//LEVEL CHILD HANDLERS//
//BACK TUNNEL CHILD HANDLER//
void ActivateChildBackT1(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("BackTunnelChild1", true);
}

void BackTunnelChildHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "BackTunnelChildMoveTrigger")
	{
		AddEnemyPatrolNode("BackTunnelChild1", "PathNodeArea_2", 0.0f, "", false);
		
		PlaySoundAtEntity("", "afx_tunnels_child_giggle_run_corridor_2D", "BackTunnelChild1", 0.0f, false);
		PlaySoundAtEntity("", "afx_tunnels_child_giggle_run_corridor_3D", "BackTunnelChild1", 0.0f, false);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec", "Player", 0.0f, false);
		AddTimer("BackTunnelChildSoundTimer", 1.5f, "BackTunnelChildSound");
		return;
	}
	else if (asChild == "BackTunnelChildKillTrigger")
	{
		ClearEnemyPatrolNodes("BackTunnelChild1");
		SetEntityActive("BackTunnelChild1", false);
	}
	else if (asChild == "BackTunnelChild2SpawnTrigger")
	{
		SetEntityActive("BackTunnelChild2", true);
		AddTimer("BackTunnelSteamTimer1", 0.3f, "BackTunnelSteamTimers");
		AddTimer("BackTunnelSteamTimer2", 0.7f, "BackTunnelSteamTimers");
		AddTimer("BackTunnelSteamTimer3", 0.9f, "BackTunnelSteamTimers");
		AddTimer("BackTunnelSteamTimer4", 1.3f, "BackTunnelSteamTimers");
		PlaySoundAtEntity("", "afx_tunnels_steam_event", "Player", 0.0f, false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_3", 0.0f, "", false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_4", 0.0f, "", false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_5", 0.0f, "", false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_6", 0.0f, "", false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_7", 0.0f, "", false);
		AddEnemyPatrolNode("BackTunnelChild2", "PathNodeArea_8", 0.0f, "", false);
		return;
	}
	else if (asChild == "BackTunnelChild2KillTrigger")
	{
		ClearEnemyPatrolNodes("BackTunnelChild2");
		PlaySoundAtEntity("", "afx_spooky_hightone_whoosh.snt", "Player", 0.0f, false);
		SetEntityActive("BackTunnelChild2", false);
		return;
	}
}

void BackTunnelChildSound (string &in asTimer)
{
	PlaySoundAtEntity("", "afx_spooky_bowed_01.snt", "Player", 0.0f, false);
}

void BackTunnelSteamTimers (string &in asTimer)
{
	if (asTimer == "BackTunnelSteamTimer1")
	{
		SetParticleSystemActive("BackTunnelSteam_1", true);
		StartScreenShake(0.075f, 0.1f, 0.0f, 0.0f);
		AddTimer("Kill_BackSteamSource_1", 2.0f, "BackTunnelSteamKillTimers");
	}
	else if (asTimer == "BackTunnelSteamTimer2")
	{
		SetParticleSystemActive("BackTunnelSteam_2", true);
		StartScreenShake(0.075f, 0.1f, 0.0f, 0.0f);
		AddTimer("Kill_BackSteamSource_2", 2.0f, "BackTunnelSteamKillTimers");
	}
	else if (asTimer == "BackTunnelSteamTimer3")
	{
		SetParticleSystemActive("BackTunnelSteam_3", true);
		StartScreenShake(0.075f, 0.1f, 0.0f, 0.0f);
		AddTimer("Kill_BackSteamSource_3", 2.0f, "BackTunnelSteamKillTimers");
	}
	else if (asTimer == "BackTunnelSteamTimer4")
	{
		SetParticleSystemActive("BackTunnelSteam_4", true);
		StartScreenShake(0.075f, 0.1f, 0.0f, 0.0f);
		MandusReactionPlayer("Breath", RandFloat(0.15f, 0.3f));
		AddTimer("Kill_BackSteamSource_4", 2.4f, "BackTunnelSteamKillTimers");
	}
}

void BackTunnelSteamKillTimers (string &in asTimer)
{
	if (asTimer == "Kill_BackSteamSource_1")
	{
		DestroyParticleSystem("BackTunnelSteam_1");
	}
	
	else if (asTimer == "Kill_BackSteamSource_2")
	{
		DestroyParticleSystem("BackTunnelSteam_2");
	}
	
	else if (asTimer == "Kill_BackSteamSource_3")
	{
		DestroyParticleSystem("BackTunnelSteam_3");
	}
	
	else if (asTimer == "Kill_BackSteamSource_4")
	{
		DestroyParticleSystem("BackTunnelSteam_4");
	}
}
//END BACK TUNNEL CHILD HANDLER//
//END LEVEL CHILD HANDLERS//

//DEATH HANDLER//
void DeathHandler (string &in asName, int alCount)
{
	if (alCount == 0)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		SetPlayerCrouching(true);
		SetPlayerActive(false);
		AddTimer("Death1Timer1", 2.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer2", 5.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer3", 6.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer4", 8.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer5", 9.0f, "DeathTimer1Sequence");
		AddTimer("Death1Timer6", 13.5f, "DeathTimer1Sequence");
		return;
	}
	else if (alCount >=	1)
	{
		AddDebugMessage("Player Has Died. Death Count is "+alCount+".", false);
		SetPlayerCrouching(true);
		SetPlayerActive(false);
		AddTimer("Death2Timer1", 2.0f, "DeathTimer1Sequence");
		AddTimer("Death2Timer2", 5.0f, "DeathTimer1Sequence");
		AddTimer("Death2Timer3", 6.0f, "DeathTimer1Sequence");
		AddTimer("Death2Timer4", 8.0f, "DeathTimer1Sequence");
		AddTimer("Death2Timer5", 9.0f, "DeathTimer1Sequence");
		AddTimer("Death2Timer6", 13.5f, "DeathTimer1Sequence");
		return;
	}
	else
	{
		ReleasePlayerFromLimbo();
		return;
	}
}

void DeathTimer1Sequence (string &in asTimer)
{
	if (asTimer == "Death1Timer1")
	{
		return;
	}
	else if (asTimer == "Death1Timer2" || asTimer == "Death1Timer3" || asTimer == "Death1Timer4")
	{
	}
	else if (asTimer == "Death1Timer5")
	{
		return;
	}
	else if (asTimer == "Death1Timer6")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		SetEntityActive("CagesWretch", true);
		ClearEnemyPatrolNodes("CagesWretch");
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_9", 4.0f, "", false);
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_10", 0.0f, "", false);
		AddEnemyPatrolNode("CagesWretch", "PathNodeArea_11", 5.0f, "", false);
		return;
	}
}

void DeathTimer2Sequence (string &in asTimer)
{
	if (asTimer == "Death2Timer1")
	{
		PlaySoundAtEntity("", "afx_spooky_hifrequencymoan_2D.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "Death2Timer2" || asTimer == "Death2Timer3" || asTimer == "Death2Timer4")
	{
	}
	else if (asTimer == "Death2Timer5")
	{
		return;
	}
	else if (asTimer == "Death2Timer6")
	{
		ReleasePlayerFromLimbo();
		SetPlayerActive(true);
		return;
	}
}
//END DEATH HANDLER//

//LEVEL TRANSITION HANDLER//
void LevelTransitionHandler (string &in asParent, string &in asChild, int alState)
{
	SetPlayerActive(false);
	FadeOut(0.55f);
	PlayMusic("music_transition_07tunnels_08sewers.ogg", true, 1.0f, 1.0f, 8, true);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
	AddTimer("LevelTransitionBuffer", 3.0f, "LevelLoader");
}

void LevelLoader (string &in asTimer)
{
	ChangeMap("08_sewers.map", "MainStart", "", "");
}
//END LEVEL TRANSITION HANDLER//

