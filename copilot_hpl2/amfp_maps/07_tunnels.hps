		if (alState == 1)
		{
			if (GetLocalVarInt("KillIntroAmbience") == 0)
			{
				PlaySoundAtEntity("AMB_Area_01", "amb_streets_warehouse.snt", "Player", 1.0f, true);
			}
			SetLocalVarString("CurrentAmbientTrack", asChild);
