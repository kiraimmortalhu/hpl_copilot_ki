//SWEETENERS
void PigSweetenKill1 (string &in asParent, string &in asChild, int alState)
{
	StopSound("PigTunnelsSweeten1", 4.0f);
	AddDebugMessage("Pig Sweetener Kill 1", false);
}

void PigSweeten2_Stop (string &in asParent, string &in asChild, int alState)
{
	StopSound("PigTunnelsSweeten2", 4.0f);
	AddDebugMessage("Pig Sweetener Kill 2", false);
}

