	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");
		
		///////////////////////////////
		//Skip the start sequyence:
		FadeIn(1.0f);
		SetPlayerCrouching(false);
		SetPlayerCrouchDisabled(false);
		RemoveTimer("LiftShaftStartTimer");
		SetPlayerActive(true);
		///////////////////////////////
		//Test cent
		//AddTimer("CentrifugeSpinTimerTest", 3.0f, "SpinCentrifuge");
		
		///////////////////////////////
		//Chase encounter
		//SetEntityActive("CentrifugeWallPiece", false);
		
		///////////////////////////////
		//Enemy counter when coming back through cage room
		//AddEntityCollideCallback("Player", "AreaPig4Start", "EnterPig4Start", true, 0);
		//RemoveEntityCollideCallback("Player", "AreaPig1Start");
	}
} 

