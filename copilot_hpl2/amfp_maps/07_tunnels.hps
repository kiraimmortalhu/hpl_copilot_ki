//CORRIDOR EVENT HANDLER//
void CorridorStateHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CorridorStayTrigger")
	{
		AddDebugMessage("ChangeCorridor = 0", false);
		if (GetLocalVarInt("InteractedWithBackTunnelDoor") == 0)
		{
			SetSwingDoorLocked("tunnels_door_16", true, false);
		}
		SetEntityActive("StoreDoorPiece", true);
		SetEntityActive("StoreWallPiece", false);
		SetLocalVarInt("ChangeCorridor", 0);
		RemoveEntityCollideCallback("Player", "OddStingerTrigger2");
		return;
	}
	else if (asChild == "CorridorChangeTrigger")
	{
		AddDebugMessage("ChangeCorridor = 1", false);
		SetSwingDoorLocked("tunnels_door_16", false, false);
		SetEntityActive("BackTunnelBlockBox", true);
		SetEntityActive("StoreDoorPiece", false);
		SetEntityActive("StoreWallPiece", true);
		SetLocalVarInt("ChangeCorridor", 1);
		AddEntityCollideCallback("Player", "OddStingerTrigger2", "OddStingers", true, 1);
		return;
	}
}

void InteractWithBackTunnelDoor (string &in asEntity)
{
	SetLocalVarInt("InteractedWithBackTunnelDoor", 1);
}

void CorridorProximityTracker (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("In Corridor Prox = 1", false);
		SetLocalVarInt("ChangeCorridorProximityTracking", 1);
		if (GetLocalVarInt("ChangeCorridorLookTracking") == 1 && GetLocalVarInt("ChangeCorridor") == 1)
		{
			SetEntityActive("StairwellWallPiece", true);
			SetEntityActive("StairwellDoorPiece", false);
			SetEntityActive("tunnels_door_16", false);
			SetEntityActive("Mask3", true);
		}
		if (GetLocalVarInt("ChangeCorridor") == 1)
		{
			StopSound("BackSteamSound1", 0.4f);
			StopSound("BackSteamSound2", 0.4f);
			StopSound("BackSteamSound3", 0.4f);
			StopSound("BackSteamSound4", 0.4f);
			DestroyParticleSystem("DeadlySteam_1");
			DestroyParticleSystem("DeadlySteam_2");
			DestroyParticleSystem("DeadlySteam_3");
			DestroyParticleSystem("DeadlySteam_4");
			DestroyParticleSystem("DeadlySteam_5");
			DestroyParticleSystem("DeadlySteam_6");
			DestroyParticleSystem("DeadlySteam_7");
			StopSound("BlockingSteamSound_1", 1.0f);
			StopSound("BlockingSteamSound_2", 1.0f);
			RemoveEntityCollideCallback("Player", "SteamKnockBackTrigger");
			SetEntityActive("SteamBlockBox", false);
			SetEntityActive("SteamBlockBox_8", false);
			SetLocalVarInt("BlockingSteamActive", 0);
		}
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("In Corridor Prox = 0", false);
		SetLocalVarInt("ChangeCorridorProximityTracking", 0);
	}
}

void CorridorLookTracker (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Corridor Look = 1", false);
		SetLocalVarInt("ChangeCorridorLookTracking", 1);
		if (GetLocalVarInt("ChangeCorridorProximityTracking") == 1 && GetLocalVarInt("ChangeCorridor") == 1)
		{
			SetEntityActive("StairwellWallPiece", true);
			SetEntityActive("StairwellDoorPiece", false);
			SetEntityActive("tunnels_door_16", false);
			SetEntityActive("Mask3", true);
		}
		if (GetLocalVarInt("ChangeCorridor") == 1)
		{
			StopSound("BackSteamSound1", 0.4f);
			StopSound("BackSteamSound2", 0.4f);
			StopSound("BackSteamSound3", 0.4f);
			StopSound("BackSteamSound4", 0.4f);
			DestroyParticleSystem("DeadlySteam_1");
			DestroyParticleSystem("DeadlySteam_2");
			DestroyParticleSystem("DeadlySteam_3");
			DestroyParticleSystem("DeadlySteam_4");
			DestroyParticleSystem("DeadlySteam_5");
			DestroyParticleSystem("DeadlySteam_6");
			DestroyParticleSystem("DeadlySteam_7");
			StopSound("BlockingSteamSound_1", 1.0f);
			StopSound("BlockingSteamSound_2", 1.0f);
			RemoveEntityCollideCallback("Player", "SteamKnockBackTrigger");
			SetEntityActive("SteamBlockBox", false);
			SetEntityActive("SteamBlockBox_8", false);
			SetLocalVarInt("BlockingSteamActive", 0);
		}
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("Corridor Look = 0", false);
		SetLocalVarInt("ChangeCorridorLookTracking", 0);
		return;
	}
}
//END CORRIDOR EVENT HANDLER//
	
//HIDING SPOTS//
void HidingSpotHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetEnemyDisableTriggers("CentrifugeWretch", true);
		SetEnemyDisableTriggers("CagesWretch", true);
		return;
	}
	else if (alState == -1)
	{
		SetEnemyDisableTriggers("CentrifugeWretch", false);
		SetEnemyDisableTriggers("CagesWretch", false);
		return;
	}
}
//END HIDING SPOTS//

//CAGES LANTERN HANDLER1// 
void CagesLanternHandler1 (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesLanternTrigger1")
	{
		if (alState == 1)
		{
			//SetLanternFlickerActive(true);
			
			return;
		}
	}
}
void CagesLanternHandler1b (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CagesLanternTrigger1b")
	{
		if (alState == 1)
		{
			SetLanternFlickerActive(true);
			
