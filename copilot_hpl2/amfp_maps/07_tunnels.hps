		AddTimer("InitRandTunnelSmallSoundCues", 73.0f, "RandTunnelSmallSoundCues");
		AddTimer("InitRandTunnelSmall2SoundCues", 74.0f, "RandTunnelSmall2SoundCues");
		AddTimer("InitRandCentrifugeAreaScarySoundCues", 75.0f, "RandCentrifugeAreaScarySoundCues");
	}
	
	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}
	
	//PRELOAD PARTICLES//
	{
		PreloadParticleSystem("ps_chemical_glow.ps");
		PreloadParticleSystem("ps_chemical_blast.ps");
		PreloadParticleSystem("ps_electro_frog_sparks.ps");
	}
	
	//ATTACHMENTS//
	{
		AttachPropToBone("Shuttle_3_1", "CentrifugeArms", "compound_C_bone", 0.0f , 0.0f, 0.0f, 22.625f, 2.014f, -25.091f);
		AttachPropToBone("Shuttle_3_done", "CentrifugeArms", "compound_C_bone", 0.0f , 0.0f, 0.0f, 22.625f, 2.014f, -25.091f);
		AttachPropToBone("ShuttleBFitted", "CentrifugeArms", "compound_B_bone", 0.0f , 0.0f, 0.0f, -145.0f, -125.0f, 0.0f);
		AttachPropToBone("ShuttleAFitted", "CentrifugeArms", "compound_A_bone", 0.0f , 0.0f, 0.0f, 50.0f, -60.0f, 45.0f);
		AttachPropToBone("ShuttleBFittedInA", "CentrifugeArms", "compound_A_bone", 0.0f , 0.0f, 0.0f, 50.0f, -60.0f, 45.0f);
		AttachPropToBone("ShuttleAFittedInB", "CentrifugeArms", "compound_B_bone", 0.0f , 0.0f, 0.0f, -145.0f, -125.0f, 0.0f);
	}
	
	//OBJECT STATES//
	{
		if (GetLocalVarInt("CentAEmpty") == 0)
		{
			SetEntityActive("ShuttleAFitted", true);
		}
		if (GetLocalVarInt("CentBEmpty") == 0)
		{
			SetEntityActive("ShuttleBFitted", true);
		}
	}
	
	//SOUND STATES//
	{
		if (GetLocalVarInt("BlockingSteamActive") == 1)
		{
			PlaySoundAtEntity("BlockingSteamSound_1", "afx_cellar_big_steam_loop_louder.snt", "BlockingSteamSoundSource_1", 0.0f, true);
		}
	}
	
	//ANIMATION STATES//
	{
		if (GetLocalVarInt("PigChargeEvent") == 0)
		{
			PlayPropAnimation("bulkhead_door_1", "static_open", 0.0f, true, "");
			PlayPropAnimation("bulkhead_door_2", "static_open", 0.0f, true, "");
			SetMoveObjectState("bulkhead_blockbox_1", 1);
			SetMoveObjectState("bulkhead_blockbox_2", 1);
		}
		else
		{
			PlayPropAnimation("bulkhead_door_1", "static_close", 0.0f, true, "");
			PlayPropAnimation("bulkhead_door_2", "static_close", 0.0f, true, "");
			SetMoveObjectState("bulkhead_blockbox_1", 0);
			SetMoveObjectState("bulkhead_blockbox_2", 0);
		}
	}
	
	//PARTICLE STATES//
	{
		if (GetLocalVarInt("BlockingSteamActive") == 0)
		{
			DestroyParticleSystem("DeadlySteam_1");
			DestroyParticleSystem("DeadlySteam_2");
			DestroyParticleSystem("DeadlySteam_3");
			DestroyParticleSystem("DeadlySteam_4");
			DestroyParticleSystem("DeadlySteam_5");
			DestroyParticleSystem("DeadlySteam_6");
			DestroyParticleSystem("DeadlySteam_7");
		}
	}
	
	//LIGHT STATES//
	{
		if (GetLocalVarInt("CentAEmpty") == 0 && GetLocalVarInt("CentBEmpty") == 0 && GetLocalVarInt("CentrifugeHasSpun") == 0)
		{
			SetLightVisible("CentrifugeSwitchLight", true);
			//SetLightFlickerActive("CentrifugeSwitchLight",true);
		}
		else
		{
			SetLightVisible("CentrifugeSwitchLight", false);
			//SetLightFlickerActive("CentrifugeSwitchLight",false);
		}
	}
	//ENTITY STATES//
	{
		if (GetLocalVarInt("BlockingSteamActive") == 0)
		{
			SetEntityActive("SteamBlockBox", false);
			SetEntityActive("SteamBlockBox_8", false);
		}
	}
	
	//ENTITY INTERACTION//
	{
		if (GetLocalVarInt("IntroComplete") == 0)
		{
			SetEntityInteractionDisabled("dumb_waiter_lift_door_1", true);
		}
		if (GetLocalVarInt("CentrifugeHasSpun") == 0)
		{
			SetEntityInteractionDisabled("Shuttle_3_1", true);
		}
		SetEntityInteractionDisabled("Mask1", true);
		SetEntityInteractionDisabled("Mask2", true);
		SetEntityInteractionDisabled("Mask3", true);
		if (GetLocalVarInt("CentAEmpty") == 0 && GetLocalVarInt("CentBEmpty") == 0 && GetLocalVarInt("CentrifugeHasSpun") == 0)
		{
			SetButtonCanBeSwitchedOff("CentrifugeButton", true);
		}
		else
		{
			SetButtonCanBeSwitchedOff("CentrifugeButton", false);
		}
	}

	//AUTOSAVE//
	{
		AutoSave();
	}
}

void OnLeave()
{
	SetupLoadScreen("LoadingText", "Sewers_", 3, "game_loading_sewers.jpg");
}

