void OnStart()
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Tunnels");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}

	
	//Setup Local Variables
		{
			//PNEUMATIC TUBE VARIABLES//
			SetLocalVarInt("PlayerTrackingStore", 0);
			SetLocalVarInt("ShuttleTrackingStore", 0);
			SetLocalVarInt("TubeStoreUseable", 1);
			SetLocalVarString("StoreShuttleID", "Void");
			SetLocalVarInt("TubeStoreCapsulePrepped", 0);
			SetLocalVarInt("PlayerTrackingChiller", 0);
			SetLocalVarInt("ShuttleTrackingChiller", 0);
			SetLocalVarInt("TubeChillerUseable", 1);
			SetLocalVarString("ChillerShuttleID", "Void");
			SetLocalVarInt("TubeChillerCapsulePrepped", 0);
			SetLocalVarInt("PlayerTrackingLab", 0);
			SetLocalVarInt("ShuttleTrackingLab", 0);
			SetLocalVarInt("TubeLabUseable", 1);
			SetLocalVarString("LabShuttleID", "Void");
			SetLocalVarInt("TubeLabCapsulePrepped", 0);
			SetLocalVarInt("PlayerTrackingCentrifuge", 0);
			SetLocalVarInt("ShuttleTrackingCentrifuge", 0);
			SetLocalVarInt("TubeCentrifugeUseable", 1);
			SetLocalVarString("CentrifugeShuttleID", "Void");
			SetLocalVarInt("TubeCentrifugeCapsulePrepped", 0);
			SetLocalVarInt("ShuttleCurrentIndexCount", 8);
			//CENTRIFUGE VARIABLES//
