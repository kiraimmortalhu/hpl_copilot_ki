			AddEntityCollideCallback("Shuttle_*", "ChillerDispenserCollider", "ChillerDispenserCollisionTracker", false, 0);
			AddEntityCollideCallback("Player", "CentrifugeRoomHidingArea", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "MeetingRoomHidingArea", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "CagesHidingArea", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "CagesHidingArea_1", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "CagesHidingArea_2", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Shuttle_3_*", "PadlockChemicalShuttleCollider", "PadlockShuttleCollisionHandler", false, 0);
			AddEntityCollideCallback("Player", "PadlockPlayerTracking", "PadlockPlayerTrackingHandler", false, 0);
			AddEntityCollideCallback("MedicalLamp", "LampLightCollider", "LightBeamSequence", false, 0);
