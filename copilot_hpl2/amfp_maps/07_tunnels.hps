//FREEZER CORRIDOR HANDLER//
void FreezerCorridorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "FreezerCorridorChangeTrigger")
	{
		AddDebugMessage("Corridor Change Trigger Activated", false);
		SetEntityActive("FreezerWallPiece", false);
		SetEntityActive("CentrifugeWallPiece", false);
		SetEntityActive("CentrifugeDoorPiece", true);
		SetEntityActive("CentrifugeDoor", true);
		SetEntityActive("FreezerDoorPiece", true);
		SetEntityActive("FreezerDoor", true);
		SetEntityActive("FreezerWallPieceTemp1", true);
		SetEntityActive("FreezerWallPieceTemp2", true);
		SetEntityActive("FreezerFloorPieceTemp1", true);
		SetEntityActive("FreezerFloorPieceTemp2", true);
		SetEntityActive("FreezerFloorPieceTemp3", true);
		AddEntityCollideCallback("Player", "FreezerCorridorReset1Trigger", "FreezerCorridorHandler", true, 1);
		AddEntityCollideCallback("Player", "OddStingerTrigger1", "OddStingersOddStingers", true, 1);
		AddEntityCollideCallback("Player", "Sound_SmashFreezer", "FreezerSmash", true, 1);
		return;
	}
	else if (asChild == "FreezerCorridorReset1Trigger")
	{
		AddDebugMessage("Corridor Change Trigger Triggered", false);
		SetEntityActive("FreezerWallPiece", true);
		SetEntityActive("CentrifugeWallPiece", true);
		SetEntityActive("CentrifugeDoorPiece", false);
		SetEntityActive("CentrifugeDoor", false);
		SetEntityActive("FreezerDoorPiece", false);
		SetEntityActive("FreezerDoor", false);
		SetEntityActive("FreezerWallPieceTemp1", false);
		SetEntityActive("FreezerWallPieceTemp2", false);
		SetEntityActive("FreezerFloorPieceTemp1", false);
		SetEntityActive("FreezerFloorPieceTemp2", false);
		SetEntityActive("FreezerFloorPieceTemp3", false);
		return;
	}
}
