			//CORRIDOR TRIGGERS//
			AddEntityCollideCallback("Player", "CorridorChangeTrigger", "CorridorStateHandler", false, 1);
			AddEntityCollideCallback("Player", "CorridorStayTrigger", "CorridorStateHandler", false, 1);
			AddEntityCollideCallback("Player", "CorridorChangeNowProximityTracker", "CorridorProximityTracker", false, 0);
			
			//LEVEL TRANSITION TRIGGER
			AddEntityCollideCallback("Player", "LevelTransitionTrigger", "LevelTransitionHandler", false, 1);
			
