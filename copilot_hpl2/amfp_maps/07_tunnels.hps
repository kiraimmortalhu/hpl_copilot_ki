			AddEntityCollideCallback("Player", "AMB_EndLevelRoom", "MapAmbienceAreas", false, 0);
			
			PlaySoundAtEntity("PigTunnelsSweeten1", "afx_tunnels_prepig_sweeten_loop.snt", "PigSweeten_Source", 0.0f, true);
			AddEntityCollideCallback("Player", "PigSweetenKill1", "PigSweetenKill1", false, 0);
