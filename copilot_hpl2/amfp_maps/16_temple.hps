//EFFECT STINGS//
void EffectStingHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "EffectSting1")
	{
		SetLocalVarInt("RandomHeadRoll", 0);
		RemoveTimer("RandomHeadRollLoopTimer");
		FadePlayerAspectMulTo(1.3f, 1.0f);
		AddTimer("RestoreAspectRatio", 5.5f, "TimerEndCalls");
		return;
	}
	else if (asChild == "EffectSting2")
	{
		SetLocalVarInt("RandomHeadRoll", 0);
		RemoveTimer("RandomHeadRollLoopTimer");
		FadePlayerAspectMulTo(1.4f, 1.0f);
		AddTimer("RestoreAspectRatio", 35.5f, "TimerEndCalls");
		return;
	}
}
//EMD EFFECT STINGS//



//STAIR SPEED HANDLER//
void StairSpeedHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
	
		FadePlayerFOVMulTo(1.5f, 0.2f);
		SetLocalVarInt("CanChangeFOVRandomly", 0);
		SetPlayerMoveSpeedMul(0.4f);
		FadeImageTrailTo(0.0f, 1.0f);
		return;
	}
	else if (alState == -1)
	{
		
		FadePlayerFOVMulTo(1.0f, 0.2f);
		SetLocalVarInt("CanChangeFOVRandomly", 1);
		SetPlayerMoveSpeedMul(0.5f);
		return;
	}
}
//END STAIR SPEED HANDLER//

//RANDOM HEAD ROLL//
void RandomHeadRollLoop(string &in asTimer)
{
	int lRollDir = GetLocalVarInt("HeadRollDir");
	int lLook = RandInt(1, 4);
	int lFOVChange = GetLocalVarInt("CanChangeFOVRandomly");
	
	AddDebugMessage("Random Head Roll Loop Active", false);
	
	if (GetLocalVarInt("RandomHeadRoll") == 1)
	{
		
		if (GetLocalVarInt("HeadRollState") == 0)
		{
			SetLocalVarInt("HeadRollState", 1);
			
			if (lFOVChange == 1)
			{
				FadePlayerFOVMulTo(RandFloat(0.85f, 1.15f), RandFloat(0.025f, 0.05f));
			}
			
			FadePlayerRollTo(RandFloat(15.0f,30.0f)*lRollDir, RandFloat(7.8f, 7.95f), RandFloat(0.45f, 0.6f));
			
			SetLocalVarInt("HeadRollDir", -lRollDir);
			AddTimer("RandomHeadRollLoopTimer", RandFloat(4.0f, 8.0f), "RandomHeadRollLoop");
			return;
		}
		
		else if(lLook == 1)
		{
			AddTimer("RandomHeadRollLoopTimer", RandFloat(4.0f, 8.0f), "RandomHeadRollLoop");
			return;
		}
		
		else
		{
			SetLocalVarInt("HeadRollState", 0);
			
			FadePlayerRollTo(0, RandFloat(7.8f, 7.95f), RandFloat(0.45f, 0.6f)); 
			if (lFOVChange == 1)
			{			
				FadePlayerFOVMulTo(1.0f, 1.0f);
			}
			FadeImageTrailTo(0.0f ,1.5f);
			AddTimer("RandomHeadRollLoopTimer", RandFloat(5.0f,7.0f), "RandomHeadRollLoop");
			return;
		}
	}
	else
	{
		FadePlayerRollTo(0, 0.5f, 1);
		FadePlayerFOVMulTo(1.0f, 0.3f);
		FadeImageTrailTo(0.0f, 1.5f);
		AddDebugMessage("Random Head Roll Switched OFF", false);
	}
}	

void TimerEndHeadRoll(string &in asTimer)
{
	SetLocalVarInt("RandomHeadRoll", 0);
}
//END RANDOM HEAD ROLL//	

//CLIMB TO THRONE SEQUENCE//

//SUMMIT WHITEOUT//
void SummitWhiteout (string &in asParent, string &in asChild, int alState)
{
	SetPlayerMoveSpeedMul(0.3f);
	SetPlayerLookSpeedMul(0.1f);
	StartPlayerLookAt("ChairClimbLookTarget3", 0.9f, 0.8f, "");
	PlaySoundAtEntity("madness1", "afx_temple_madness", "Player", 0.0f, false);
	FadeImageTrailTo(0.5f ,6.5f);
	PlaySoundAtEntity("ClimbSound", "afx_temple_into_chair_transition", "Player", 0.0f, false);
	AddTimer("BeginWhiteout", 2.0, "BeginWhiteout");
	AddTimer("Crouch", 4.0, "Crouch");
	AddTimer("StartClimbSequence", 4.3f, "TeleportToClimbPoint"); 
	//AddTimer("StandUp", 4.3f, "StandUp");
	AddTimer("LookUp", 5.3f, "LookUp");
	AddTimer("FadeOut2", 9.9f, "FadeOut2");
	AddTimer("TeleportChairTimer", 11.1f, "TeleportToChair");
	AddTimer("TurnHead", 11.9f, "TurnHead");
	AddTimer("LockLookTarget", 13.9f, "LockLookTarget");
	AddTimer("LockLookTargetSpeed", 19.0f, "LockLookTargetSpeed");
	AddTimer("SpiderLegs", 19.0f, "LegsActivate");
	AddTimer("ConsoleMoves", 22.0f, "ConsoleActivates");
//	AddTimer("VOTimer", 1.0f, "VO2");	
	AddTimer("QuakeSound", 21.5f, "QuakeSound");
	AddTimer("ScreenShake", 21.8f, "ScreenShake");
	AddTimer("SteamBursts", 24.8f, "SteamBursts");
	AddTimer("ActivateFinalButton", 36.0f, "ActivateFinale");
}

void BeginWhiteout (string &in asTimer)
{
