//STEAM HANDLERS//
void SteamTimers (string &in asTimer)
{
	if (asTimer == "SteamTimer1")
	{
		SetParticleSystemActive("Steam_1", true);
		SetParticleSystemActive("Steam_6", true);
	}
	else if (asTimer == "SteamTimer2")
	{
		SetParticleSystemActive("Steam_2", true);
		SetParticleSystemActive("Steam_8", true);
	}
	else if (asTimer == "SteamTimer3")
	{
		SetParticleSystemActive("Steam_3", true);
		SetParticleSystemActive("Steam_7", true);
	}
	else if (asTimer == "SteamTimer4")
	{
		SetParticleSystemActive("Steam_4", true);
		SetParticleSystemActive("Steam_5", true);
		SetParticleSystemActive("End_Smoke", true);
		MandusReactionPlayer("Breath", RandFloat(0.15f, 0.3f));
	}
}
//END STEAM HANDLERS//

//ACTIVATE FINALE//
void ActivateFinale (string &in asTimer)
{
	PlayPropAnimation("Console", "anim_2", 0.0f, false, "");
	PlayPropAnimation("SpiderLegs", "anim_2", 0.0f, false, "");
	SetEntityActive("ConsoleButtonMain", true);
	SetEntityConnectionStateChangeCallback("ConsoleButtonMain", "PressXToNotDie");
	SetLightVisible("ConsoleButtonLight", true);
	ConsoleButtonLightPulse("ConsoleButtonLightPulse_On");
	SetButtonCanBeSwitchedOff("ConsoleButtonMain", true);
	StopSound("WeirdnessChair", 3.0f);
}

void ConsoleButtonLightPulse(string &in asTimer)
{
	if (asTimer == "ConsoleButtonLightPulse_On")
	{
		PlayGuiSound("afx_temple_heartbeat_single.ogg", 0.7);
		FadeLightTo("ConsoleButtonLight", 1, 1, 1, 1, -1, 0.75f);
		AddTimer("ConsoleButtonLightPulse_Off", 0.35f, "ConsoleButtonLightPulse");
	}
	else
	{
		FadeLightTo("ConsoleButtonLight", 0, 0, 0, 1, -1, 0.75f);
		AddTimer("ConsoleButtonLightPulse_On", 0.95f, "ConsoleButtonLightPulse");
	}
}
//END ACTIVATE FINALE//

//END GAME EVENT//
//INITIALISE//
void PressXToNotDie (string &in asEntity, int alState)
{
	RemoveTimer("ConsoleButtonLightPulse_On");
	RemoveTimer("ConsoleButtonLightPulse_Off");
	FadeLightTo("ConsoleButtonLight", 0, 0, 0, 1, -1, 0.3f);
//	AddTimer("DropConsole", 4.5f, "DropConsole");
	AddTimer("VO3", 5.0f, "VO3");
	AddTimer("StabbyStabby", 12.8f, "StabbyStabby");
	StopMusic(8.0f, 8);
	RemoveTimer("AutoEnd");
	//PlaySoundAtEntity("PreStab", "afx_temple_prestabsteam", "Player", 0.0f, false);
	PlayGuiSound("afx_events_streets_explosionplayer_interior_boom_05.ogg", 0.8);
	PlaySoundAtEntity("Stab", "afx_temple_stab", "Player", 0.0f, false);
	FadeImageTrailTo(0.0f ,1.5f);
	PlaySoundAtEntity("Stab", "afx_temple_switch", "Player", 0.0f, false);
	
	//STOPSOUNDS
	StopSound("SteamBurst", 5.0f);
	StopSound("EndingSteamLoop", 5.0f);
	StopSound("AMB_Temple_Base", 5.0f);
	StopSound("AMB_Temple_Base_1", 5.0f);
	StopSound("AMB_Temple_Base_2", 5.0f);
	StopSound("AMBEnd", 5.0f);
	StopSound("AMBEnd_1", 5.0f);
	StopSound("AMBSteps", 5.0f);
	StopSound("WindSpotBulkhead", 5.0f);
	StopSound("AMB_Temple_Base_2", 5.0f);
	StopSound("AMB_bulkhead", 5.0f);
	StopSound("AMBSteps", 5.0f);
	StopSound("AMBEnd", 5.0f);
	StopSound("AMBBridgePart2", 5.0f);
	StopSound("AMB_Bridge", 5.0f);
	StopSound("AMB_SmallChamber", 5.0f);
	StopSound("AMB_Passageway", 5.0f);
	StopSound("AMB_Start_Hall", 5.0f);
	StopSound("AMB3DWind", 5.0f);
	StopSound("CaveWind", 5.0f);		
	StopSound("OrbAmb2D", 5.0f);
	StopSound("OrbAmb3D", 5.0f);
}
