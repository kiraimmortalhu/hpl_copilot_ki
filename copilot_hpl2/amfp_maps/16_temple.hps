//TUNNEL AUDIO ENHANCER PLAYER//
void TunnelAudioEnhancer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "tunnel_audio_enhance_1")
	{
		AddDebugMessage("tunnel extra 1 fired", false);
		PlaySoundAtEntity("tunnelaudio1", "music_cellar_children_walkway_temple.snt", "Player", 1.0f, true);
		return;
	}
	else if (asChild == "tunnel_audio_enhance_2")
	{
		AddDebugMessage("tunnel extra 2 fired", false);
		StopSound("DiesesHerz", 3.5f);
		PlaySoundAtEntity("tunnelaudio2", "music_cellar_children_walkway_temple.snt", "Player", 1.0f, true);
		return;
	}
	else if (asChild == "tunnel_audio_enhance_3")
	{
		AddDebugMessage("tunnel extra 3 fired", false);
		StopSound("tunnelaudio1", 1.5f);
		StopSound("tunnelaudio2", 1.5f);
		PlaySoundAtEntity("tunnelaudio3", "Sewers_74.snt", "Player", 1.0f, true);
		PlaySoundAtEntity("DiesesHerz", "music_temple_dieses_herz_reverb.snt", "Player", 1.0f, true);
		return;
	}
		else if (asChild == "tunnel_audio_enhance_4")
	{
		AddDebugMessage("tunnel extra 4 fired", false);
		PlaySoundAtEntity("AMB_Temple_Base_2", "vo_engine_weird2D.snt", "Player", 1.0f, true);
		
		//AddEffectVoice("vo_engine_weird.ogg", "", "Voice", "vo_engine_weird", false, "", 0.0f, 0.0f);
		return;
	}
}
//END TUNNEL AUDIO ENHANCER PLAYER//


//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "temple_level_start_vo")
	{
		AddEffectVoice("vo_temple_machine_crawlspace_1.ogg", "", "Voice", "vo_temple_trigger_machine_01", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "temple_caves_vo")
	{
		AddEffectVoice("vo_temple_machine_crawlspace_2.ogg", "", "Voice", "vo_temple_trigger_machine_02", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "temple_bridge_vo")
	{
		AddEffectVoice6("vo_temple_machine_mandus_crawlspace_3.ogg", "", "Voice", "vo_temple_trigger_machine_03_machine_01", 0.0f, "vo_temple_trigger_machine_03_mandus_01", 5.5f, "vo_temple_trigger_machine_03_machine_02", 9.0f, "vo_temple_trigger_machine_03_machine_02_1", 17.4f, "vo_temple_trigger_machine_03_machine_02_2", 27.4f, "vo_temple_trigger_machine_03_machine_02_3", 39.8f, false, "", 0.0f, 0.0f);
		SetEntityActive("cot_1", true);
		SetEntityActive("cot_2", true);
		PlayPropAnimation("cot_1", "on", 1.0f, true, "");
		PlayPropAnimation("cot_2", "on", 1.0f, true, "");
		
		return;
	}
	else if (asChild == "temple_summit_vo")
	{
		AddEffectVoice("vo_temple_machine_monolgue_2.ogg", "", "Voice", "vo_temple_trigger_machine_06", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "orb_vo_1")
	{
		AddEffectVoice("vo_temple_orbhit_1.ogg", "", "Voice", "vo_temple_orbhit_1", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "orb_vo_2")
	{
		AddEffectVoice("vo_temple_orbhit_2.ogg", "", "Voice", "vo_temple_orbhit_2", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "orb_vo_3")
	{
		AddEffectVoice("vo_temple_orbhit_3.ogg", "", "Voice", "vo_temple_orbhit_3", false, "", 0.0f, 0.0f);
		return;
	}
}
//END TRIGGERED VO PLAYER//

//TIMER END CALLS//
void TimerEndCalls (string &in asTimer)
{	
	if (asTimer == "OpeningVOTimer")
	{
		VOPlayer("Player", "temple_level_start_vo", 1);
		return;
	}
	else if (asTimer == "RestoreAspectRatio")
	{
		FadePlayerFOVMulTo(1.0f, 0.4f);
		
		AddTimer("PostEffectStingRestoreRandomRollTimer", 6.0f, "TimerEndCalls");
		return;
	}
	else if (asTimer == "PostEffectStingRestoreRandomRollTimer")
	{
		SetLocalVarInt("RandomHeadRoll", 0);
		RandomHeadRollLoop("VoidTimer4");
		return;
	}
	else if (asTimer == "ReactivateRandomHeadRoll")
	{
		SetLocalVarInt("RandomHeadRoll", 1);
		RandomHeadRollLoop("VoidTimer3");
	}
}
//END TIMER CALLS//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//BULKHEAD DOOR HANDLER//
void BulkheadDoorApproach (string &in asParent, string &in asChild, int alState)
{
	//SetEntityPlayerLookAtCallback("BulkheadDoorOpenLookAt", "BulkheadDoorHandler", true);
	SetLanternDisabled(true);
	PlayPropAnimation("bulkhead_door_1", "anim_open", 0.0f, false, "");
	AddTimer("DoorBlock_1", 4, "DoorCollisionMovement");
	AddTimer("DoorBlock_2", 6, "DoorCollisionMovement");
	AddTimer("DoorBlock_3", 8, "DoorCollisionMovement");
	AddTimer("DoorBlock_4", 9, "DoorCollisionMovement");
	AddTimer("Door2Timer", 7.0f, "BulkheadDoor2Handler");
	AddTimer("DoorBlock_6", 11, "DoorCollisionMovement");
	AddTimer("DoorBlock_7", 13, "DoorCollisionMovement");
	AddTimer("DoorBlock_8", 15, "DoorCollisionMovement");
	SetPlayerUsesDragFootsteps(false);	
	AddEffectVoice7(
		"music_temple_reveal_integrated.ogg", "", "Voice",
		"vo_mansion_trigger_child_06", 18.8f, "vo_temple_trigger_machine_05a", 22.5f, "vo_temple_trigger_machine_05a_1", 39.5f, 
		"vo_temple_trigger_machine_05b", 50.0f, "vo_temple_trigger_machine_05b_1", 57.6f, "vo_temple_trigger_machine_05c", 71.5f,
		"vo_temple_trigger_machine_05fake_2", 85.0f,
		false, "", 0.0f, 0.0f
	);
	PlaySoundAtEntity("WindSpotBulkhead", "amb_temple_windspot01.snt", "BulkheadWindSpotSource", 6.0f, false);
	AddTimer("TheDrone", 100.0f, "TheDrone");
	SetPlayerRunSpeedMul(0.0f);
	StopSound("tunnelaudio3", 1.5f);
	StopSound("tunnelaudio4", 1.5f);
	StopSound("DiesesHerz", 5.0f);
}

