////////////////////////////////
//IRON LUNG
////////////////////////////////

//---------------------------------------------------------------------------------------

void IronLungBreaths(string &in asTimer)
{
	if (asTimer == "IronLungBreathBegin")
	{
		PlaySoundAtEntity("IronLungBreath1", "amb_temple_ironlung_2D_oneshot.snt", "IronLungPSArea_1", 0, false);
		PlaySoundAtEntity("IronLungBreath2", "amb_temple_ironlung_3D_oneshot.snt", "IronLungPSArea_1", 0, false);
		CreateParticleSystemAtEntity("IronLungPS_1", "ps_steam_deadly_looping.ps", "IronLungPSArea_1", true);
		CreateParticleSystemAtEntity("IronLungPS_2", "ps_steam_deadly_looping.ps", "IronLungPSArea_2", true);
		AddTimer("IronLungBreathStop", 2.0, "IronLungBreaths");
	}
	else
	{
		DestroyParticleSystem("IronLungPS_1");
		DestroyParticleSystem("IronLungPS_2");
		AddTimer("IronLungBreathBegin", 1.55, "IronLungBreaths");
	}
}

