// REACTOR ROD DESCENT ANIMATION //
void RodHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "rod_trigger")
	{
	SetParticleSystemActive("ParticleSystem_11", true);
	SetParticleSystemActive("ParticleSystem_12", true);
	SetParticleSystemActive("ParticleSystem_13", true);
	SetParticleSystemActive("ParticleSystem_14", true);
	SetParticleSystemActive("ParticleSystem_15", true);
	SetParticleSystemActive("ParticleSystem_16", true);
	SetParticleSystemActive("ParticleSystem_17", true);
	SetParticleSystemActive("ParticleSystem_18", true);
	SetMoveObjectState("reactor_rod_1", 1);
	AddTimer("Rod2Lowers", 0.3f, "RodTimer");
	AddTimer("Rod3Lowers", 0.8f, "RodTimer");
	AddTimer("Rod4Lowers", 1.5f, "RodTimer");
	}
}

void RodTimer (string &in asTimer)
{	
	if (asTimer == "Rod2Lowers")
	{
			SetMoveObjectState("reactor_rod_2", 1);
		return;
	}
	
	else if (asTimer == "Rod3Lowers")
	{
			SetMoveObjectState("reactor_rod_3", 1);
		return;
	}
	
	else if (asTimer == "Rod4Lowers")
	{
			SetMoveObjectState("reactor_rod_4", 1);
		return;
	}
}
// END REACTOR ROD DESCENT ANIMATION

