	AddTimer("SteamTimer2", 0.7f, "SteamTimers");
	AddTimer("SteamTimer3", 0.9f, "SteamTimers");
	AddTimer("SteamTimer4", 1.3f, "SteamTimers");
	PlaySoundAtEntity("SteamBurst", "afx_temple_steam_release", "Player", 0.0f, false);
