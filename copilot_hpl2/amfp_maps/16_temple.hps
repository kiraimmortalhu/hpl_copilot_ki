// CONVEYOR SCENE HANDLER //
void ConveyorSceneHandler (string &in asParent, string &in asChild, int alState)
{		
	// HOUSE SCENE FADE OUT, REACTOR SCENE ACTIVATE
	if (asChild == "house_scene_kill_trigger")
	{
		SetPropActiveAndFade("house_child_1", false, 2);
		SetPropActiveAndFade("house_child_2", false, 2);
		FadeLightTo("PointLight_1", 0,0,0,0,-1,0.5);
		SetLampLit("gas_lamp_wall_1", false, true);
		SetLampLit("gas_lamp_wall_2", false, true);
		SetLampLit("chandelier_nice_1", false, true);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		
		SetEntityActive("reactor_child_1", true);
		SetEntityActive("reactor_child_2", true);
	}
	
	// HOUSE SCENE KILL
	else if (asChild == "house_scene_kill_trigger_1")
	{
		SetEntityActive("cot_1", false);
		SetEntityActive("cot_2", false);
		SetEntityActive("gas_lamp_wall_1", false);
		SetEntityActive("gas_lamp_wall_2", false);
		SetEntityActive("chandelier_nice_1", false);
		SetLightVisible("PointLight_1", false);
	}
	
	// FACTORY/LAB SCENE ACTIVATE
	else if (asChild == "factory_scene_start_trigger")
	{
		PlaySoundAtEntity("Tesla_Bulkhead_2", "afx_tesla_metalgate_open.snt", "IronLungDoor", 0.0f, false);
		SetMoveObjectStateExt("IronLungDoor", 0, 1, 1.3, 0.1, true);
		
		SetPropActiveAndFade("factory_child_1", true, 1);
		SetPropActiveAndFade("factory_child_2", true, 1);
		
		SetEntityActive("factory_pistons_3", true);
		SetEntityActive("factory_pistons_2", true);
		SetEntityActive("factory_pistons_1", true);
		PlayPropAnimation("factory_pistons_3", "on", 0.0f, true, "");
		PlayPropAnimation("factory_pistons_2", "on", 0.0f, true, "");
		PlayPropAnimation("factory_pistons_1", "on", 0.0f, true, "");
		
		SetEntityActive("lab_child_1", true);
		SetEntityActive("lab_child_2", true);
		SetEntityActive("arms_1", true);
		PlayPropAnimation("arms_1", "animated", 0.0f, true, "");
	}
	
	// FACTORY SCENE FADE OUT, PIGLINE SCENE ACTIVATE
	else if (asChild == "factory_scene_kill_trigger")
	{
		SetPropActiveAndFade("factory_child_1", false, 2);
		SetPropActiveAndFade("factory_child_2", false, 2);
		FadeLightTo("PointLight_2", 0,0,0,0,-1,0.5);
		SetLampLit("tube_lamp_tesla_railing_1", false, true);
		SetLampLit("tube_lamp_tesla_railing_2", false, true);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		
		PlayPropAnimation("grinder_blades_1", "animated", 0.0f, true, "");	
		SetEntityActive("grinder_blades_1", true);
	}
	
	// FACTORY SCENE KILL
	else if (asChild == "factory_scene_kill_trigger_1")
	{
		SetEntityActive("factory_pistons_3", false);
		SetEntityActive("factory_pistons_2", false);
		SetEntityActive("factory_pistons_1", false);
		SetEntityActive("tube_lamp_tesla_railing_1", false);
		SetEntityActive("tube_lamp_tesla_railing_2", false);
		
		SetLightVisible("PointLight_2", false);
	}
	
	// LAB SCENE FADE OUT, STREETS SCENE ACTIVATE
	else if (asChild == "lab_scene_kill_trigger")
	{
		SetPropActiveAndFade("lab_child_1", false, 2);
		SetPropActiveAndFade("lab_child_2", false, 2);
		FadeLightTo("PointLight_3", 0,0,0,0,-1,0.5);
		FadeLightTo("SpotLight_97", 0,0,0,0,-1,0.5);
		SetLampLit("medical_lamp_1", false, true);
		SetLampLit("medical_lamp_2", false, true);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
	
		SetEntityActive("streets_child_1", true);
		SetEntityActive("streets_child_2", true);
		SetParticleSystemActive("ParticleSystem_19", true);
		SetParticleSystemActive("ParticleSystem_20", true);
		SetParticleSystemActive("ParticleSystem_21", true);
	}
	
	// LAB SCENE KILL
	else if (asChild == "lab_scene_kill_trigger_1")
	{		
		SetEntityActive("arms_1", false);
		SetEntityActive("medical_lamp_1", false);
		SetEntityActive("medical_lamp_2", false);
		
		SetLightVisible("PointLight_3", false);
		SetLightVisible("SpotLight_97", false);
	}
	
	// REACTOR SCENE FADE OUT, TESLA SCENE ACTIVATE
	else if (asChild == "reactor_scene_kill_trigger")
	{
		SetPropActiveAndFade("reactor_child_1", false, 2);
		SetPropActiveAndFade("reactor_child_2", false, 2);
		FadeLightTo("PointLight_4", 0,0,0,0,-1,0.5);
		FadeLightTo("SpotLight_81", 0,0,0,0,-1,0.5);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		
		SetEntityActive("tesla_child_1", true);
		SetEntityActive("tesla_child_2", true);
		SetParticleSystemActive("ParticleSystem_22", true);
		SetParticleSystemActive("ParticleSystem_23", true);
		SetParticleSystemActive("ParticleSystem_24", true);
		SetParticleSystemActive("ParticleSystem_25", true);
		SetParticleSystemActive("ParticleSystem_26", true);
	}
	
	// REACTOR SCENE KILL
	else if (asChild == "reactor_scene_kill_trigger_1")
	{
		SetLightVisible("PointLight_4", false);
		SetLightVisible("SpotLight_81", false);
	}
	
	// PIGLINE SCENE FADE OUT
	else if (asChild == "pigline_scene_kill_trigger")
	{
		FadeLightTo("PointLight_5", 0, 0, 0, 0, -1, 0.5f);
		FadeLightTo("SpotLight_97", 0, 0, 0, 0, -1, 0.5f);
		SetLampLit("pigline_lamp_1", false, true);
		SetLampLit("pigline_lamp_2", false, true);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		DestroyParticleSystem("ParticleSystem_18");
		DestroyParticleSystem("ParticleSystem_17");
		DestroyParticleSystem("ParticleSystem_16");
		DestroyParticleSystem("ParticleSystem_15");
		DestroyParticleSystem("ParticleSystem_14");
		DestroyParticleSystem("ParticleSystem_13");
		DestroyParticleSystem("ParticleSystem_12");
		DestroyParticleSystem("ParticleSystem_11");
	}
	
	// PIGLINE SCENE KILL
	else if (asChild == "pigline_scene_kill_trigger_1")
	{
		SetEntityActive("grinder_blades_1", false);
		SetEntityActive("pigline_lamp_2", false);
		SetEntityActive("pigline_lamp_1", false);
		SetLightVisible("PointLight_5", false);
		SetLightVisible("SpotLight_97", false);
	}
	
	// STREETS SCENE FADE OUT
	else if (asChild == "streets_scene_kill_trigger")
	{
		AddTimer("streets_child_1", 1, "TimerDelayedChildDeactivate");
		AddTimer("streets_child_2", 1, "TimerDelayedChildDeactivate");
		FadeLightTo("PointLight_6", 0, 0, 0, 0, -1, 0.5f);
		SetLightFlickerActive("PointLight_73", false);
		FadeLightTo("PointLight_73", 0, 0, 0, 0, -1, 1.5f);
		SetLampLit("streetlight_ground_fog_1", false, true);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		DestroyParticleSystem("ParticleSystem_19");
		DestroyParticleSystem("ParticleSystem_20");
		DestroyParticleSystem("ParticleSystem_21");
	}
	
	// STREETS SCENE KILL
	else if (asChild == "streets_scene_kill_trigger_1")
	{
		SetLightVisible("PointLight_6", false);
		SetEntityActive("streetlight_ground_fog_1", false);
	}
	
	// TESLA SCENE FADE OUT
	else if (asChild == "tesla_scene_kill_trigger")
	{
		SetPropActiveAndFade("tesla_child_1", false, 2);
		SetPropActiveAndFade("tesla_child_2", false, 2);
		SetLightFlickerActive("PointLight_30", false);
		FadeLightTo("PointLight_30", 0, 0, 0, 0, -1, 0.5f);
		PlaySoundAtEntity("", "afx_temple_lightsout.snt", "Player", 0.0f, false);
		DestroyParticleSystem("ParticleSystem_22");
		DestroyParticleSystem("ParticleSystem_23");
		DestroyParticleSystem("ParticleSystem_24");
		DestroyParticleSystem("ParticleSystem_25");
		DestroyParticleSystem("ParticleSystem_26");
	}
	
	// TESLA SCENE KILL
	else if (asChild == "tesla_scene_kill_trigger_1")
	{
		SetLightVisible("PointLight_30", false);
	}
	
	// STOP LIFE SUPPORT
	else if (asChild == "stop_life_support")
	{
	StopSound("life_support_machine_1", 1.0f);
	StopSound("life_support_machine_2", 1.0f);
	StopSound("life_support_machine_3", 1.0f);
	AddTimer("LifeSupportKill", 3.0f, "LifeSupportTimer");
	}
	
}

void TimerDelayedChildDeactivate(string &in asTimer)
{
	SetPropActiveAndFade(asTimer, false, 2);
}

// END CONVEYOR SCENE HANDLER //

