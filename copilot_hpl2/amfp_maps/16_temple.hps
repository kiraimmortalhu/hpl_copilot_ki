//THE START OF THE END//
void TheEnd (string &in asTimer)
{
	int lStepCount = GetLocalVarInt("TheEndStepCounter");
	switch (lStepCount)
	{
		case 0:
			SetPlayerActive(false);
			SetLanternActive(false, false);
			SetLanternDisabled(true);
			ShowPlayerCrossHairIcons(false);
			TeleportPlayer("FlooredPlayer");
			StartPlayerLookAt("PullBackLookTarget", 3.0f, 3.0f, "");
			FadePlayerFOVMulTo(1.0f, 1.0f);
			SetPlayerCrouching(true);
			FadePlayerRollTo(-0.0f, 2.1f, 2.1f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 5.0f, "TheEnd");
			

			//KILL AMBIENT AREAS
			RemoveEntityCollideCallback("Player", "AMB_Start_Hall");
			RemoveEntityCollideCallback("Player", "AMB_Passageway");
			RemoveEntityCollideCallback("Player", "AMB_SmallChamber");
			RemoveEntityCollideCallback("Player", "AMB_Bridge");
			RemoveEntityCollideCallback("Player", "AMBBridgePart2");
			RemoveEntityCollideCallback("Player", "AMBEnd");
			RemoveEntityCollideCallback("Player", "AMBSteps");
			break;
			
		case 1:
			SetPlayerActive(false);
			AddEffectVoice7("music_temple_end.ogg", "", "Voice", "vo_endgame_fake1", 0.0f, "vo_endgame_1", 34.1f, "vo_endgame_2", 43.56f, "vo_endgame_3", 52.64f, "vo_endgame_4", 66.72f, "vo_endgame_5", 80.16f, "vo_endgame_6", 88.46f, false, "", 0.0f, 0.0f);
			FadeIn(15.0f);
			FadeImageTrailTo(1.5f, 1.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 7.0f, "TheEnd");
			break;
			
		case 2:
			SetPlayerActive(false);
			MovePlayerHeadPos(0.0f, -30.0f, -60.0f, 0.7f, 0.25f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 8.0f, "TheEnd");
			AddDebugMessage("Teleport, Reset Head, Point At Target", false);
			break;
			
		case 3:
			MovePlayerHeadPos(0.0f, -30.0f, -60.0f, 1.8f, 0.25f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 17.5f, "TheEnd");
			break;
			
		case 4:
			FadeOut(1.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 1.5f, "TheEnd");
			break;
			
		case 5:
			TeleportPlayer("TeslaSection1Start");
			StartPlayerLookAt("TeslaSection1LookTarget", 10.0f, 10.0f, "");
			MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 40.0f, 0.25f);
			FadePlayerRollTo(0.0f, 40.0f, 40.0f);
			SetPlayerCrouching(false);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.0f, "TheEnd");
			break;
		
		case 6:
			FadeIn(2.0f);
			MovePlayerHeadPos(0.0f, 0.0f, -15.0f, 0.7f, 0.25f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("TeslaSection1Lights", 3.5f, "TeslaLightsOut1");
			AddTimer("EndTimer", 9.0f, "TheEnd");
			break;
			
		case 7:
			FadeOut(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;
			
		case 8:
			TeleportPlayer("TeslaSection2Start");
			StartPlayerLookAt("TeslaSection2LookTarget", 10.0f, 10.0f, "");
			MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 40.0f, 0.25f);
			FadePlayerRollTo(0.0f, 40.0f, 40.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.0f, "TheEnd");
			break;
			
		case 9:
			FadeIn(2.0f);
			MovePlayerHeadPos(0.0f, 40.0f, 0.0f, 1.1f, 0.25f);
			FadePlayerRollTo(120.0f, 3.5f, 3.5f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("TeslaSection2Lights", 3.5f, "TeslaLightsOut2");
			AddTimer("EndTimer", 9.0f, "TheEnd");
			break;
		
		case 10:
			FadeOut(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;
		
		case 11:
			TeleportPlayer("TunnelsSectionStart");
			SetPlayerCrouching(true);
			StartPlayerLookAt("TunnelsSectionLookTarget", 10.0f, 10.0f, "");
			MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 40.0f, 0.25f);
			FadePlayerRollTo(0.0f, 40.0f, 40.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 1.0f, "TheEnd");
			break;
		
		case 12:
			MovePlayerHeadPos(0.0f, 0.0f, -15.0f, 0.6f, 0.25f);
			FadePlayerRollTo(-120.0f, 2.5f, 2.5f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 1.5f, "TheEnd");
			break;
		
		case 13:
			FadeIn(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("TunnelsSectionLights", 3.5f, "TunnelsLightsOut");
			AddTimer("EndTimer", 7.0f, "TheEnd");
			break;
			
		case 14:
			FadeOut(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;
			
		case 15:
			TeleportPlayer("ReactorSectionStart");
			SetPlayerCrouching(false);
			StartPlayerLookAt("ReactorSectionLookTarget", 10.0f, 10.0f, "");
			MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 40.0f, 0.25f);
			FadePlayerRollTo(0.0f, 40.0f, 40.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 1.0f, "TheEnd");
			break;
		
		case 16:
			MovePlayerHeadPos(0.0f, 40.0f, -7.0f, 1.1f, 0.25f);
			FadePlayerRollTo(120.0f, 3.5f, 3.5f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 1.5f, "TheEnd");
			//PlaySoundAtEntity("", "endgame_bigben.snt", "Player", 0.0f, false);
			
			break;
		
		case 17:
			FadeIn(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("ReactorSectionLights", 3.5f, "ReactorLightsOut");
			AddTimer("EndTimer", 9.0f, "TheEnd");
			break;
		
		case 18:
			FadeOut(2.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;
			
		case 19:
			TeleportPlayer("StreetsSection1Start");
			MovePlayerHeadPos(0.0f, 0.0f, 0.0f, 40.0f, 0.25f);
			FadePlayerRollTo(0.0f, 40.0f, 40.0f);
			StartPlayerLookAt("StreetsSection1LookTarget", 1.0f, 10.0f, "");
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;
		
		case 20:
			FadeIn(2.0f);
			AddDebugMessage("In Streets Now", false);
			MovePlayerHeadPos(0.0f, 0.0f, -19.0f, 1.0f, 0.25f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 3.0f, "TheEnd");
			break;
			
		case 21:
			SetEntityActive("Child1", true);
			
			AddEnemyPatrolNode("Child1", "PathNodeArea_1", 0.001f, "", false);
			AddEnemyPatrolNode("Child1", "PathNodeArea_3", 0.001f, "", false);
			AddEnemyPatrolNode("Child1", "PathNodeArea_5", 0.001f, "", false);
			AddEnemyPatrolNode("Child1", "PathNodeArea_6", 0.001f, "", false);
			AddEnemyPatrolNode("Child1", "PathNodeArea_14", 0.001f, "", false);
			SetEntityActive("Child2", true);
			AddEnemyPatrolNode("Child2", "PathNodeArea_7", 0.001f, "", false);
			AddEnemyPatrolNode("Child2", "PathNodeArea_9", 0.001f, "", false);
			AddEnemyPatrolNode("Child2", "PathNodeArea_10", 0.001f, "", false);
			AddEnemyPatrolNode("Child2", "PathNodeArea_12", 0.001f, "", false);
			AddEnemyPatrolNode("Child2", "PathNodeArea_13", 0.001f, "", false);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 12.0f, "TheEnd");
			break;	

		case 22:
			SetSwingDoorOpenAmount("double_gate_1", 0.0f, 0.8f, true);
			PlaySoundAtEntity("swoosh", "afx_tesla_sting.snt", "Player", 0.4f, false);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 0.8f, "TheEnd");
			break;	
		
		case 23:
			StopSound("swoosh", 0.2f);
			PlaySoundAtEntity("", "afx_reactor_hearthit.snt", "Player", 0.0f, false);
			StartEffectFlash(1.0f, 3.0f, 1.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 2.5f, "TheEnd");
			break;	
		
		case 24:
			FadeOut(1.0f);
			AddLocalVarInt("TheEndStepCounter", 1);
			AddTimer("EndTimer", 7.0f, "TheEnd");
			break;	
			
		case 25:
			StartCredits("", false, "Ending", "MainCredits", 4);
			PlayMusic("end_credits_song.ogg", false, 1.0f, 1.0f, 8, false);
			AddDebugMessage("WHEN I WAS A LADDY", false);
			AddLocalVarInt("TheEndStepCounter", 1);
			UnlockAchievement("TheHeart");
			break;		
	}
