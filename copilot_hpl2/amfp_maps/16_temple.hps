////////////////////////////////
//BEGIN CONVEYOR BELT
////////////////////////////////

//---------------------------------------------------------------------------------------

/////////////////////////////
//COLLIDE AREA TO CHECK IF PLAYER SHOULD BE PUSHED
void CollidePushPlayer(string &in asParent, string &in asChild, int alState)
{	
	if(alState == 1)
	{
		RemoveTimer("IronLungBreathBegin");
		if (GetTimerTimeLeft("IronLungBreathStop") > 0)
		{
			DestroyParticleSystem("IronLungPS_1");
			DestroyParticleSystem("IronLungPS_2");
			RemoveTimer("IronLungBreathStop");
		}
		
		AddTimer("push_player", 0.05, "TimerPlayerPush");
		AddDebugMessage("On Conveyor!", false);
	}
	else if(alState == -1)
	{
		RemoveTimer("push_player");
		AddDebugMessage("Off Conveyor!", false);
	}
}

void CollideFallVelocityDamper(string &in asParent, string &in asChild, int alState)
{
	if(alState == 1)
	{
		AddDebugMessage("Dampen velocity!", false);
		AddTimer("damp_fall", 0.05, "TimerPlayerDampenFallVelocity");
	}
	else if(alState == -1)
	{
		AddDebugMessage("Stop damping velocity!", false);
		RemoveTimer("damp_fall");
	}
}

void lanterndisabler(string &in asParent, string &in asChild, int alState)
{
	SetLanternDisabled(true);
}

/////////////////////////////
//TIMER LOOP FOR PUSHING
void TimerPlayerPush(string &in asTimer)
{
	//AddDebugMessage("GetPlayerSpeed(): " + GetPlayerSpeed(), false);
	if(GetPlayerSpeed() < 0.56)
	{
		AddPlayerBodyForce(0,-5000,3000, false);
		//AddDebugMessage("Pushing Lots", false);
	} 
	else
	{
		AddPlayerBodyForce(0,-5000,1550, false);
		//AddDebugMessage("Pushing Little", false);
	}

	AddTimer("push_player", 0.05, "TimerPlayerPush");
}

void TimerPlayerDampenFallVelocity(string &in asTimer)
{
	if(GetPlayerSpeed() > 2.0)
	{
		AddPlayerBodyForce(0,-5000,-3000, false);
	}
	AddTimer("damp_fall", 0.05, "TimerPlayerDampenFallVelocity");
}

