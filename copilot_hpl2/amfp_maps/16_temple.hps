//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
		if (asChild == "AMB_Start_Hall")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMB Temple Base is firing", false);
				PlaySoundAtEntity("AMB_Start_Hall", "amb_temple_starthall.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Start_Hall", 1.0f);
				return;
			}
		}
		
		if (asChild == "AMB_Passageway")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMB Temple Base 1 is firing", false);
				PlaySoundAtEntity("AMB_Passageway", "amb_temple_conveyor_room.snt", "Player", 1.0f, true);
			
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Passageway", 1.0f);
				return;
			}
		}
		
			if (asChild == "AMB_SmallChamber")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_SmallChamber", "amb_temple_smallchamber.snt", "Player", 1.0f, true);
			
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_SmallChamber", 1.0f);
				return;
			}
		}
				
		if (asChild == "AMB_Bridge")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMBBridge is firing", false);
				PlaySoundAtEntity("AMB_Bridge", "amb_temple_bridge_part1.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_Bridge", 1.0f);
				return;
			}
		}
				
		if (asChild == "AMBBridgePart2")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMBBridge Part 2 is firing", false);
				PlaySoundAtEntity("AMBBridgePart2", "amb_temple_bridge_part2.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBBridgePart2", 1.0f);
				return;
			}
		}
				if (asChild == "AMBEnd")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMBEnd is firing", false);
				PlaySoundAtEntity("AMBEnd", "amb_temple_base_drone.snt", "Player", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBEnd", 1.0f);
				return;
			}
		}
		if (asChild == "AMBSteps")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMBSteps is firing", false);
				PlaySoundAtEntity("AMBSteps", "amb_temple_base_drone.snt", "AMBSteps", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMBBSteps", 1.0f);
				return;
			}
		}
		if (asChild == "AMB_bulkhead")
		{
			if (alState == 1)
			{
				AddDebugMessage("AMB_bulkhead is firing", false);
				PlaySoundAtEntity("AMB_bulkhead", "afx_ghost_whispers.snt", "AMBSteps", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_bulkhead", 1.0f);
				return;
			}
		}
		
		
}
