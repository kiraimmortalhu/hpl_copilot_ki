// STROBES //
void StrobeShots (string &in asTimer)
{
	if (asTimer == "Strobe_1")
	{
		StartEffectFlash(0.1f, 1.1f, 0.2);
	}
	
	else if (asTimer == "Strobe_2")
	{
		StartEffectFlash(0.1f, 1.1f, 0.2);
	}
	
	else if (asTimer == "Strobe_3")
