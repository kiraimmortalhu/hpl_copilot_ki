void OnEnter()
{
	//PRELOAD SOUNDS//
	{
	}

	//PRELOAD PARTICLES//
	{
		
	}

	//DEFAULT SWITCH LANTERN TO ON//
	{
		SetLanternFlickerActive(false);
	}

	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}
	
	//SOUND INITIALISATION//
	{
		PlaySoundAtEntity("AMB3DWind", "amb_temple_wind_3D.snt", "WindSource", 0.0f, true);
		PlaySoundAtEntity("CaveWind", "amb_tesla02_wind_entrance_loop.snt", "CaveWindSource", 0.0f, true);			
		//PlaySoundAtEntity("OrbAmb2D", "orb_loop_2D", "orb", 0.0f, false);
		//PlaySoundAtEntity("OrbAmb3D", "orb_loop_3D", "orb", 0.0f, false);
	}
	
	//MUSIC INITIALISATION
	{

	}
	
	//ANIMATION STATES//
	{
		PlayPropAnimation("pigline_cog_puzzle_1", "anim", 0.0f, true, "");
		PlayPropAnimation("Console", "static_1", 0.0f, true, "");
		PlayPropAnimation("SpiderLegs", "static_1", 0.0f, true, "");

	}

	//ENTITY STATES//
	{
		if (GetLocalVarInt("BulkheadDoor1Open") == 1)
		{
			PlayPropAnimation("BulkheadDoor1", "static_open", 0.0f, true, "");
			SetMoveObjectState("BulkheadDoor1Collision", 1);
		}
		else
		{
			PlayPropAnimation("BulkheadDoor1", "static_close", 0.0f, true, "");
			SetMoveObjectState("BulkheadDoor1Collision", 0);
		}
	}
	
	//LIGHT STATES//
	{
		SetLightVisible("ConsoleButtonLight", false);
	}
	
	//AUTOSAVE//
	{
		AutoSave();
	}
}

void OnLeave()
{
	SetupLoadScreen("", "", 1, "menu_loading_screen.jpg");
}

