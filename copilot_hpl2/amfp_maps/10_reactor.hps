		AddTimer("ReactorDescentLoudSounds", 18.5f, "ReactorDescentLoudSounds");
		AddTimer("MachineVO_1", 1.0f, "MachineVO_1");
		return;
	}
	else if (asChild == "VOMachine_2")
	{
			//START SOFT SOUNDS
		PlaySoundAtEntity("DescentSoundSteam01Sound2D_quieter", "amb_reactor_descent_steam1_2D_quieter.snt", "DescentSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam01Sound3D_quieter", "amb_reactor_descent_steam1_3D_quieter.snt", "DescentSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam02Sound3D_quieter", "amb_reactor_descent_steam2_2D_quieter.snt", "DescentSoundSteam02Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam02Sound3D_quieter", "amb_reactor_descent_steam2_3D_quieter.snt", "DescentSoundSteam02Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam03Sound3D_quieter", "amb_reactor_descent_steam2_2D_quieter.snt", "DescentSoundSteam03Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam03Sound3D_quieter", "amb_reactor_descent_steam2_3D_quieter.snt", "DescentSoundSteam03Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam04Sound3D_quieter", "amb_reactor_descent_steam3_2D_quieter.snt", "DescentSoundSteam04Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam04Sound3D_quieter", "amb_reactor_descent_steam3_3D_quieter.snt", "DescentSoundSteam04Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterfall01Sound3D_quieter", "amb_reactor_descent_waterfall1_3D_quieter.snt", "WaterfallSoundSteam01Source_1", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterfall01Sound2D_quieter", "amb_reactor_descent_waterfall1_2D_quieter.snt", "WaterfallSoundSteam01Source_1", 1.0f, true);
		PlaySoundAtEntity("DescentSoundStream01Sound2D_quieter", "amb_reactor_descent_stream1_2D_quieter.snt", "StreamSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundStream01Sound3D_quieter", "amb_reactor_descent_stream1_3D_quieter.snt", "StreamSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterPipe012D_quieter", "amb_reactor_descent_waterhittingpipe1_2D_quieter", "DescentSoundWaterPipes01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterPipe013D_quieter", "amb_reactor_descent_waterhittingpipe1_3D_quieter", "DescentSoundWaterPipes01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterSplash013D_quieter", "amb_reactor_descent_watersplash1_3D_quieter", "DescentSoundWaterSplashSource01", 1.0f, true);
		PlaySoundAtEntity("DescentSoundWaterSplash012D_quieter", "amb_reactor_descent_watersplash1_2D_quieter", "DescentSoundWaterSplashSource01", 1.0f, true);
		PlaySoundAtEntity("DescentSoundHitPipes023D_quieter", "amb_reactor_descent_watersplash3_3D_quieter.snt", "DescentSoundWaterPipes02Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundHitPipes022D_quieter", "amb_reactor_descent_watersplash3_2D_quieter", "DescentSoundWaterPipes02Source", 1.0f, true);
		
		//STOP LOUD SOUNDS
		StopSound("DescentSoundSteam01Sound2D", 1.0f);
		StopSound("DescentSoundSteam01Sound3D", 1.0f);
		StopSound("DescentSoundSteam02Sound2D", 1.0f);
		StopSound("DescentSoundSteam02Sound3D", 1.0f);
		StopSound("DescentSoundSteam03Sound2D", 1.0f);
		StopSound("DescentSoundSteam03Sound3D", 1.0f);
		StopSound("DescentSoundSteam04Sound2D", 1.0f);
		StopSound("DescentSoundSteam04Sound3D", 1.0f);
		StopSound("DescentSoundWaterfall01Sound3D", 1.0f);
		StopSound("DescentSoundWaterfall01Sound2D", 1.0f);
		StopSound("DescentSoundStream01Sound2D", 1.0f);
		StopSound("DescentSoundStream01Sound3D", 1.0f);
		StopSound("DescentSoundWaterPipe012D", 1.0f);
		StopSound("DescentSoundWaterPipe013D", 1.0f);
		StopSound("DescentSoundWaterSplash013D", 1.0f);
		StopSound("DescentSoundWaterSplash012D", 1.0f);
		StopSound("DescentSoundHitPipes023D", 1.0f);
		StopSound("DescentSoundHitPipes022D", 1.0f);
		
		AddTimer("MachineVO_2", 1.0f, "MachineVO_2");	
		AddTimer("ReactorDescentLoudSounds_2", 8.0f, "ReactorDescentLoudSounds_2");
		return;
	}
	else if (asChild == "VOMachine_3")
	{
	AddEffectVoice("vo_reactor_machine_speaker_3", "", "Voice", "vo_reactor_machine_speaker_3", false, "", 0.0f, 0.0f);	
	PlaySoundAtEntity("vo_reactor_machine_speaker_3_verb", "vo_reactor_machine_speaker_3_verb.snt", "Player", 1.0f, false);
	}
	
	else if (asChild == "VOConrolRoomFlashback")
	{
	AddDebugMessage("Flashback Activated", false);
	AddEffectVoice2("vo_reactor_mandus_flashback", "", "Voice", "vo_reactor_trigger_mandus_01_flashback", 0.8f, "vo_reactor_trigger_mandus_01_flashback_1", 9.2f, false, "", 0.0f, 0.0f);
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
	PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
	FadeImageTrailTo(2.0f, 2.5f);
	SetPlayerMoveSpeedMul(0.35f);
	SetPlayerLookSpeedMul(0.35f);
	AddTimer("ReturnToNormal", 20.0f, "RestoreToNormal");
	return;
	}
}
//END TRIGGERED VO PLAYER

//RANDOMISED SOUND CUE PLAYER//
void RandTopAreaSoundCues(string &in asTimer)
{
	string[] sCueSources = {"ReactorTopAreaRandSound1_1", "ReactorTopAreaRandSound1_2", "ReactorTopAreaRandSound1_3", "ReactorTopAreaRandSound1_4", "ReactorTopAreaRandSound1_5", "ReactorTopAreaRandSound1_6" "ReactorTopAreaRandSound1_7" "ReactorTopAreaRandSound1_8" "ReactorTopAreaRandSound1_9" "ReactorTopAreaRandSound1_10"};
	asTimer = sCueSources[RandInt (0, 9)];
	PlaySoundAtEntity(asTimer, "afx_spooky_whoosh_bug.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function High Frequency Moan Selected Random Top Area Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(8.0f, 15.0f), "RandTopAreaSoundCues");
}

void RandTopArea2SoundCues(string &in asTimer)
{
	string[] sCueSources = {"ReactorTopAreaRandSound1_1", "ReactorTopAreaRandSound1_2", "ReactorTopAreaRandSound1_3", "ReactorTopAreaRandSound1_4", "ReactorTopAreaRandSound1_5", "ReactorTopAreaRandSound1_6", "ReactorTopAreaRandSound1_7",  "ReactorTopAreaRandSound1_8",  "ReactorTopAreaRandSound1_9",  "ReactorTopAreaRandSound1_10"};
	asTimer = sCueSources[RandInt (0, 9)];
	PlaySoundAtEntity(asTimer, "spooky_childcry_quiet.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Childcry Selected Random Top Area Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 18.0f), "RandTopArea2SoundCues");
}

void RandOfficeSoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandOfficeSound_1", "RandOfficeSound_2", "RandOfficeSound_3", "RandOfficeSound_4"};
	asTimer = sCueSources[RandInt (0, 3)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hifrequencymoan.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function High Frequency Moan Selected Random Top Area Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(15.0f, 25.0f), "RandOfficeSoundCues");
}

