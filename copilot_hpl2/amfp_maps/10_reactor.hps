//AMBIENT AREA SWAP OUT//
/////////////////////////									

//WHEN FUEL RODS INSERTED//
void AmbientPart2AreaSpawn (string &in asTimer)
{
	AddDebugMessage("Ambient Areas Swapped to Part 2", false);
	
	//Reactor Sounds
	PlaySoundAtEntity("ReactorSteamSound1", "amb_reactor_steam_loop_1.snt", "ReactorSteamSource1", 3.5f, true);
	
	//Preparing for AMB Part 2 of Reactor
	RemoveEntityCollideCallback("Player", "AMBReactor");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_1");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_2");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_3");
	RemoveEntityCollideCallback("Player", "AMBFuelRodRoom");
	RemoveEntityCollideCallback("Player", "AMBFuelCrawlspace");
	
	//STOP SOUNDS//
	StopSound("AMBReactor", 2.5f);
	StopSound("AMBFuelRodOffice_1", 2.5f);
	StopSound("AMBFuelRodOffice_2", 2.5f);
	StopSound("AMBFuelRodOffice_3", 2.5f);
	StopSound("AMBFuelRodRoom", 2.5f);
	StopSound("AMBFuelCrawlspace", 2.5f);
	
	//ADD NEW AREAS//
	AddEntityCollideCallback("Player", "AMBReactorPart2", "MapAmbienceAreas", false, 0);// When the Reactor is running
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_1Part2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 1
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_2Part2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 2
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_3Part2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 3
	AddEntityCollideCallback("Player", "AMBFuelRodRoomPart2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Room
	AddEntityCollideCallback("Player", "AMBFuelCrawlspacePart2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Crawlspace
		
}

//WHEN REACTOR START UP//
void AmbientPart3AreaSpawn (string &in asTimer)
{
	AddDebugMessage("Ambient Areas Swapped to Part 3", false);
	
	//Preparing for AMB Part 3 of Reactor
	RemoveEntityCollideCallback("Player", "AMBReactorPart2");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_1Part2");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_2Part2");
	RemoveEntityCollideCallback("Player", "AMBFuelRodOffice_3Part2");
	RemoveEntityCollideCallback("Player", "AMBFuelRodRoomPart2");
	RemoveEntityCollideCallback("Player", "AMBFuelCrawlspacePart2");
	
	//STOP SOUNDS//
	StopSound("AMBReactorPart2", 2.5f);
	StopSound("AMBFuelRodOffice_1Part2", 2.5f);
	StopSound("AMBFuelRodOffice_2Part2", 2.5f);
	StopSound("AMBFuelRodOffice_3Part2", 2.5f);
	StopSound("AMBFuelRodRoomPart2", 2.5f);
	StopSound("AMBFuelCrawlspacePart2", 2.5f);
	
	//ADD NEW AREAS//
	AddEntityCollideCallback("Player", "AMBReactorPart3", "MapAmbienceAreas", false, 0);// When the Reactor is running
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_1Part3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 1
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_2Part3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 2
	AddEntityCollideCallback("Player", "AMBFuelRodOffice_3Part3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 3
	AddEntityCollideCallback("Player", "AMBFuelRodRoomPart3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Room
	AddEntityCollideCallback("Player", "AMBFuelCrawlspacePart3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Crawlspace
}
/////////////////////////////
//END AMBIENT AREA SWAP OUT//
/////////////////////////////

//REACTOR WIND DOOR//
void FuelRodWindSample (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Wind Start", false);
		PlaySoundAtEntity("WindDoor", "amb_reactor_door_wind.snt", "FuelRodOfficeDoor", 1.0f, false);
		return;
	}
	else if (alState == -1) 
	{
		AddDebugMessage("Wind Stop", false);
		StopSound("WindDoor", 1.0f);
		return;
	}
}
//END REACTOR WIND DOOR//

//RESTORE TO NORMAL//
void RestoreToNormal (string &in asTimer)
{
//RETURN TO NORMAL VISION
	if (asTimer == "ReturnToNormalVision")
	{
		FadeRadialBlurTo(0.0f, 4.0f);
		FadeImageTrailTo(0.0f, 4.0f);
		return;
	}

//RETURN TO NORMAL ALL//
	else if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		StopPlayerLookAt();
		return;
	}
	
//END VISUAL EFFECT FOR SCREAM//
	else if (asTimer == "EndVisEffect")
	{
		FadeImageTrailTo(0.0f, 0.5f);
		FadeSepiaColorTo(0.0f, 0.5f);
		return;
	}
}
//END RESTORE TO NORMAL//

//LOUD DESCENT SOUNDS//
void ReactorDescentLoudSounds (string &in asTimer)
{
	AddDebugMessage("Loud Sounds Back", false);

	//START LOUD SOUNDS
		PlaySoundAtEntity("DescentSoundSteam01Sound2D", "amb_reactor_descent_steam1_2D.snt", "DescentSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam01Sound3D", "amb_reactor_descent_steam1_3D.snt", "DescentSoundSteam01Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam02Sound2D", "amb_reactor_descent_steam2_2D.snt", "DescentSoundSteam02Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam02Sound3D", "amb_reactor_descent_steam2_3D.snt", "DescentSoundSteam02Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam03Sound2D", "amb_reactor_descent_steam2_2D.snt", "DescentSoundSteam03Source", 1.0f, true);
		PlaySoundAtEntity("DescentSoundSteam03Sound3D", "amb_reactor_descent_steam2_3D.snt", "DescentSoundSteam03Source", 1.0f, true);
