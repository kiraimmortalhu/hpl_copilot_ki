//INFECTION AREAS//
void InfectionAreas (string &in asParent, string &in asChild, int alState)
{
SetPlayerInfection(100.0f);
AddDebugMessage("U GOT 'FECTED!", true);
}
//END INFECTION AREAS//

//HINT TRIGGERS//
void HintTriggerHandler(string &in asParent, string &in asChild, int alState)
{
	if (asChild == "hint_1_trigger")
	{
		AddHint("Reactor1", "");
	}
	else if (asChild == "hint_3_trigger")
	{
		AddHint("Reactor3", "");
	}
}
//END HINT TRIGGERS//

//DESCENT CREAK SOUNDS//
void DescentCreakSounds (string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("DescentStrain", "afx_tunnels_wood_creak_louder.snt", "Player", 0.0f, true);
	RemoveEntityCollideCallback("Player", "DescentCreak_1");
	RemoveEntityCollideCallback("Player", "DescentCreak_2");
	RemoveEntityCollideCallback("Player", "DescentCreak_3");
	RemoveEntityCollideCallback("Player", "DescentCreak_4");
	RemoveEntityCollideCallback("Player", "DescentCreak_5");
	RemoveEntityCollideCallback("Player", "DescentCreak_6");
	AddTimer("DescentCreakAreaRespawn", 3.0f, "DescentCreakAreaRespawn");
	AddDebugMessage("Descent Strain Triggered and Creak Areas Removed", true);
}

void DescentCreakAreaRespawn (string &in asTimer)
{
	AddEntityCollideCallback("Player", "DescentCreak_1", "DescentCreakSounds", true, 0);
	AddEntityCollideCallback("Player", "DescentCreak_2", "DescentCreakSounds", true, 0);
	AddEntityCollideCallback("Player", "DescentCreak_3", "DescentCreakSounds", true, 0);
	AddEntityCollideCallback("Player", "DescentCreak_4", "DescentCreakSounds", true, 0);
	AddEntityCollideCallback("Player", "DescentCreak_5", "DescentCreakSounds", true, 0);
	AddEntityCollideCallback("Player", "DescentCreak_6", "DescentCreakSounds", true, 0);
	AddDebugMessage("Creak Areas Restored", true);
}
//END DESCENT CREAK SOUNDS//

//ELEVATOR	
void ElevatorDoorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ElevatorTopOpenTrigger")
	{
		if (alState == 1 && GetLocalVarInt("ElevatorTopDoorsOpen") == 0)
		{
			SetMoveObjectState("TopRightDoor", 1);
			SetMoveObjectState("TopLeftDoor", 1);
			PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource", 0.0f, false);
			PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource", 0.0f, false);
			SetLocalVarInt("ElevatorTopDoorsOpen", 1);
			RemoveEntityCollideCallback("Player", "ElevatorTopOpenTrigger");
			AddTimer("RestoreCallbackTimer", 1, "RestoreCallback");
			return;
		}
		else if (alState == -1 && GetLocalVarInt("ElevatorTopDoorsOpen") == 1)
		{
			SetMoveObjectState("TopRightDoor", 0);
			SetMoveObjectState("TopLeftDoor", 0);
			SetLocalVarInt("ElevatorTopDoorsOpen", 0);
			PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource", 0.0f, false);
			PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource", 0.0f, false);
			RemoveEntityCollideCallback("Player", "ElevatorTopOpenTrigger");
			AddTimer("RestoreCallbackTimer", 1, "RestoreCallback");
			return;
		}
	}
	else if (asChild == "ElevatorBottomOpenTrigger")
	{
		if (alState == 1)
		{
			SetMoveObjectState("BottomRightDoor", 1);
			SetMoveObjectState("BottomLeftDoor", 1);
			PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource2", 0.0f, false);
			PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource2", 0.0f, false);
			return;
		}
	}
}	

void RestoreCallback(string &in asTimer)
{
	AddEntityCollideCallback("Player", "ElevatorTopOpenTrigger", "ElevatorDoorHandler", false, 0);
}

void CheckSwitchProximity (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Switch CAN Be Interacted With", false);
		SetEntityInteractionDisabled("ElevatorSwitch", false);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("Switch CANNOT Be Interacted With", false);
		SetEntityInteractionDisabled("ElevatorSwitch", true);
		RemoveTimer("MovementPreventionTimer");
		return;
	}
}

void ElevatorSwitchMovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("ElevatorSwitch") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
}
								
void ElevatorDescent (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Elevator Moving", false);
		SetEntityActive("ElevatorDoorBlocker", true);
		AddAttachedPropToProp("elevator_pod_1", "ElevatorSwitchStatic", "elevator_switch_static.ent", 0.06f, -1.842f, -0.068f, 0.0f, 0.0f, 0.0f);
		PlaySoundAtEntity("", "church_draw_lever_open.snt", "ElevatorSwitchSource", 0.0f, false);
		SetEntityActive("ElevatorSwitch", false);
		SetMoveObjectState("TopRightDoor", 0);
		SetMoveObjectState("TopLeftDoor", 0);
		SetLocalVarInt("ElevatorTopDoorsOpen", 0);
		PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource", 0.0f, false);
		StopMusic(6.1, 6);
		AddTimer("ElevatorMoves", 3.5f, "ElevatorMoves");
		AddTimer("KyrieMusicPlay", 6.0f, "KyrieMusicPlay");
		AddTimer("VOMandusMonologue_1", 48.0f, "VOMandusMonologue_1");
		AddTimer("CreateControlRoomFlashbackArea", 11.5f, "CreateControlRoomFlashbackArea");
		//TRIGGERS QUIETER ELEVATOR SOUND
		StopSound("LiftLoop", 1.5f);
		PlaySoundAtEntity("LiftLoopQuieter", "elevator_loop_quieter", "Player", 1.5f, true);
		AddDebugMessage("Quieter Lift Sound Triggered", false);
//		return;
	}
}

void ElevatorMoves (string &in asTimer)
{
	SetMoveObjectState("elevator_pod_1", 1);
	PlaySoundAtEntity("", "reactor_elevator_start.snt", "Player", 0.0f, false);
	PlaySoundAtEntity("LiftLoop", "reactor_elevator_loop.snt", "Player", 1.0f, true);
	StopMusic(1.5f, 5);
	AddTimer("LiftTimer", 40.5f, "LiftEnd");
	AddTimer("LiftDoorTimer", 41.8f, "LiftEnd");
	SetLocalVarInt("BoardedElevator", 1);
}

void LiftEnd (string &in asTimer)
{
	if (asTimer == "LiftTimer")
	{
		AddDebugMessage("LIFT STOP NOW", false);
		PlaySoundAtEntity("", "reactor_elevator_stop.snt", "Player", 0.0f, false);
		StopSound("LiftLoop", 1.5f);
		StopSound("LiftLoopQuieter", 1.5f);
		return;
	}
	else if (asTimer == "LiftDoorTimer")
	{
		ElevatorDoorHandler("Player", "ElevatorBottomOpenTrigger", 1);
		//SET CHECKPOINT #2//
		CheckPoint("CP02_ReactorMain", "CheckpointStart_1", "", "", "", false);
		return;
	}
}
//END ELEVATOR//

