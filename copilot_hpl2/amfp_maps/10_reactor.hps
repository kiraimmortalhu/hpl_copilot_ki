//COOLING ROD COVER//
void CoolingRodCoverOpened (string &in asParent, string &in asChild, int alState)
{
	SetPropStaticPhysics("reactor_hatch_15", true);
	PlaySoundAtEntity("", "tesla_metaldoor_open.snt", "CoolingRodCoverCollider", 0.0f, false);
	SetParticleSystemActive("CoolingMist_7", true);
	SetLocalVarInt("RodCoverOpened", 1);
}

void InteractRodCover(string &in asEntity)
{
	SetSwingDoorDisableAutoClose(asEntity, true);
	AddTimer(asEntity, 0.3, "TimerPushLid");
}

void TimerPushLid(string &in asTimer)
{
	AddPropForce(asTimer, 0, 2000, 0, "World");
	AddLocalVarInt("PushCount", 1);
	
	if(GetLocalVarInt("PushCount") < 20)
		AddTimer(asTimer, 0.05, "TimerPushLid");
}
//END COOLING ROD COVER//
		
//REACTOR COOLING ROD HANDLER//		
void RodSwitchHandler (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		if (asEntity == "RodSwitch_1")
		{
			SetLampLit("RodLight_1", true, false);
			PlaySoundAtEntity("", "afx_mansion_switchboard_switch.snt", asEntity, 0.0f, false);
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, 1, false);
			SetMoveObjectState("reactor_rod_1", 1);
			AddLocalVarInt("CoolingRodsLowered", 1);
			SetLocalVarInt("Rod1Lowered", 1);
			AddTimer("RodLowerSound", 0.5f, "RodLowerSound");
			SwitchInteractionUpdater("DeactivateSwitches");
			PlaySoundAtEntity("SteamRelease2D", "afx_reactor_fuel_rod_lower_steam_release_2D", "SteamReleaseSource", 0.0f, false);
			PlaySoundAtEntity("SteamRelease3D", "afx_reactor_fuel_rod_lower_steam_release_3D", "SteamReleaseSource", 0.0f, false);
		}
		else if (asEntity == "RodSwitch_6")
		{
			SetLampLit("RodLight_6", true, false);
			PlaySoundAtEntity("", "afx_mansion_switchboard_switch.snt", asEntity, 0.0f, false);
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, 1, false);	
			SetMoveObjectState("reactor_rod_6", 1);	
			AddLocalVarInt("CoolingRodsLowered", 1);
			SetLocalVarInt("Rod6Lowered", 1);			
			AddTimer("RodLowerSound", 0.5f, "RodLowerSound");
			SwitchInteractionUpdater("DeactivateSwitches");
			PlaySoundAtEntity("SteamRelease2D", "afx_reactor_fuel_rod_lower_steam_release_2D", "SteamReleaseSource", 0.0f, false);
			PlaySoundAtEntity("SteamRelease3D", "afx_reactor_fuel_rod_lower_steam_release_3D", "SteamReleaseSource", 0.0f, false);
		}
		else if (asEntity == "RodSwitch_7" && GetLocalVarInt("RodCoverOpened") == 1)
		{
			SetLampLit("RodLight_7", true, false);
			PlaySoundAtEntity("", "afx_mansion_switchboard_switch.snt", asEntity, 0.0f, false);
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, 1, false);			
			SetMoveObjectState("reactor_rod_7", 1);
			AddLocalVarInt("CoolingRodsLowered", 1);
			SetLocalVarInt("Rod7Lowered", 1);
			AddTimer("RodLowerSound", 0.5f, "RodLowerSound");
			SwitchInteractionUpdater("DeactivateSwitches");
			PlaySoundAtEntity("SteamRelease2D", "afx_reactor_fuel_rod_lower_steam_release_2D", "SteamReleaseSource", 0.0f, false);
			PlaySoundAtEntity("SteamRelease3D", "afx_reactor_fuel_rod_lower_steam_release_3D", "SteamReleaseSource", 0.0f, false);
		}
		else if (asEntity == "RodSwitch_7" && GetLocalVarInt("RodCoverOpened") == 0)
		{
			AddDebugMessage("Rod 7 Blocked", false);
			AddTimer("RodBlockLightOff", 0.65f, "RodBlockLightOff");
			SetLightVisible("RodLight", true);
			PlaySoundAtEntity("RodError3D", "afx_reactor_fuel_rod_error_buzz_3D", "BellSource", 0.0f, false);
			PlaySoundAtEntity("RodError2D", "afx_reactor_fuel_rod_error_buzz_2D", "BellSource", 0.0f, false);
			SetLampLit("RodLight", true, false);
			AddHint("Reactor2", "");
		}	
		else if (asEntity == "RodSwitch_8")
		{
			SetLampLit("RodLight_8", true, false);
			PlaySoundAtEntity("", "afx_mansion_switchboard_switch.snt", asEntity, 0.0f, false);	
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, 1, false);
			SetMoveObjectState("reactor_rod_8", 1);
			AddLocalVarInt("CoolingRodsLowered", 1);
			SetLocalVarInt("Rod8Lowered", 1);
			AddTimer("RodLowerSound", 0.5f, "RodLowerSound");
			SwitchInteractionUpdater("DeactivateSwitches");
			PlaySoundAtEntity("SteamRelease2D", "afx_reactor_fuel_rod_lower_steam_release_2D", "SteamReleaseSource", 0.0f, false);
			PlaySoundAtEntity("SteamRelease3D", "afx_reactor_fuel_rod_lower_steam_release_3D", "SteamReleaseSource", 0.0f, false);
		}
		if (GetLocalVarInt("CoolingRodsLowered") == 9)
		{
			AddEntityCollideCallback("Player", "VOMachine_3", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "PhonautographDistanceCheck", "PhonautographDistanceCheck", false, 0);
			AddDebugMessage("Cooling Rods Lowered. A Winner Is You", false);
			SetLeverInteractionDisablesStuck("ReactorStartupLever", true);
			RemoveEntityCollideCallback("Player", "VOConrolRoomFlashback");
			SetEntityActive("LeverInteractionArea", true);
			AddTimer("RodLowerComplete", 5.5f, "RodLowerComplete");
			AddEntityCollideCallback("Player", "hint_3_trigger", "HintTriggerHandler", true, 0);
			SetEntityActive("lever_1_off", false);
			SetEntityActive("lever_1_on", true);
		}
	}
}

