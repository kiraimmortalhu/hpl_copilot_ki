void OnStart()
 
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Reactor");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "level_start", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
		
	// Setup Local Variables
		{
			SetLocalVarInt("BoardedElevator", 0);
			SetLocalVarInt("ElevatorTopDoorsOpen", 0);
			SetLocalVarInt("TopAreaSoundsRemoved", 0);
			SetLocalVarInt("RodCoverOpened", 0);
			SetLocalVarInt("Rod1Lowered", 0);
			SetLocalVarInt("Rod6Lowered", 0);
			SetLocalVarInt("Rod7Lowered", 0);
			SetLocalVarInt("Rod8Lowered", 0);
			SetLocalVarInt("CoolingRodsLowered", 5);
			SetLocalVarInt("ChildSequenceStepTracker", 0);
		}
		
	//AutoRun Event Timers
		{	
			
		}
		
	//Setup Initial Object States
		{
			//DEFAULT REACTOR ROD STATES//
			SetMoveObjectState("reactor_rod_2", 1);
			SetMoveObjectState("reactor_rod_3", 1);
			SetMoveObjectState("reactor_rod_4", 1);
			SetMoveObjectState("reactor_rod_5", 1);
			SetMoveObjectState("reactor_rod_9", 1);
			
			//INTERACTION//
			SetEntityInteractionDisabled("engineroom_door_tesla_2", true);
		}
		
	//Setup Initial Entity Callbacks
		{
			//COLLISION CALLBACKS//
			AddEntityCollideCallback("Player", "ElevatorTopOpenTrigger", "ElevatorDoorHandler", false, 0);		
			AddEntityCollideCallback("Player", "SwitchInteractionArea", "CheckSwitchProximity", false, 0);
			AddEntityCollideCallback("Player", "ReactorEnterTrigger", "ReactorEnterTrigger", true, 0);
			AddEntityCollideCallback("Player", "LiftTrigger", "LiftTest", true, 1);
			AddEntityCollideCallback("Player", "LeverInteractionArea", "LeverInteractionUpdater", false, 0);
			AddEntityCollideCallback("reactor_hatch_15", "CoolingRodCoverCollider", "CoolingRodCoverOpened", true, 1);
			
			//STATE CHANGE CALLBACKS//
			SetEntityConnectionStateChangeCallback("RodSwitch_1", "RodSwitchHandler");
			SetEntityConnectionStateChangeCallback("RodSwitch_6", "RodSwitchHandler");
			SetEntityConnectionStateChangeCallback("RodSwitch_7", "RodSwitchHandler");
			SetEntityConnectionStateChangeCallback("RodSwitch_8", "RodSwitchHandler");
			SetEntityConnectionStateChangeCallback("ReactorStartupLever", "ReactorStartupSequence");
			SetEntityConnectionStateChangeCallback("ReactorMainLever", "ReactorMainSequence");
			
			//MULTISLIDER CALLBACKS//
			SetMultiSliderCallback("ElevatorSwitch", "ElevatorDescent");
		}
		
	//Setup Ambience Callbacks
		{
			AddEntityCollideCallback("Player", "AMBDripArea", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBFuelRodRoom", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Room
			AddEntityCollideCallback("Player", "AMBFuelCrawlspace", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Crawlspace
			AddEntityCollideCallback("Player", "AMBFuelRodOffice_1", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 1
			AddEntityCollideCallback("Player", "AMBFuelRodOffice_2", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 2
			AddEntityCollideCallback("Player", "AMBFuelRodOffice_3", "MapAmbienceAreas", false, 0);// Reactor Fuel Rod Office 3
			AddEntityCollideCallback("Player", "AMBReactor", "MapAmbienceAreas", false, 0);// START THE REACTOR
			AddEntityCollideCallback("Player", "AMBReactorStartArea", "MapAmbienceAreas", false, 0);
			AddEntityCollideCallback("Player", "AMBReactorStartArea2", "MapAmbienceAreas", false, 0);
		
			//FUEL ROD OFFICE DOOR WIND SAMPLE
			AddEntityCollideCallback("FuelRodOfficeDoor", "FuelRodWindSampleCollider", "FuelRodWindSample", false, 0);
		
			//CREAK CALLBACKS
			AddEntityCollideCallback("Player", "DescentCreak_1", "DescentCreakSounds", true, 0);
			AddEntityCollideCallback("Player", "DescentCreak_2", "DescentCreakSounds", true, 0);
			AddEntityCollideCallback("Player", "DescentCreak_3", "DescentCreakSounds", true, 0);
			AddEntityCollideCallback("Player", "DescentCreak_4", "DescentCreakSounds", true, 0);
			AddEntityCollideCallback("Player", "DescentCreak_5", "DescentCreakSounds", true, 0);
			AddEntityCollideCallback("Player", "DescentCreak_6", "DescentCreakSounds", true, 0);
			
			//INFECTION AREAS
			AddEntityCollideCallback("Player", "infection_reactor", "InfectionAreas", false, 0);
			AddEntityCollideCallback("Player", "InfectionWater", "InfectionAreas", false, 0);
		}
		
	//Setup Music Callbacks
		{
			AddEntityCollideCallback("Player", "KyrieMusicTrigger", "MusicPlayer", true, 0);	
			AddEntityCollideCallback("Player", "music_stairs_trigger", "StairsMusicPlayer", true, 0);
		}

	//Setup Sound Sting Callbacks
		{		
			
		}
		
	//Setup Initial VO Callbacks
		{
			AddEntityCollideCallback("Player", "VOMachine_1", "VOPlayer", true, 0);
			AddEntityCollideCallback("Player", "VOMachine_2", "VOPlayer", true, 0);
		}
	//Setup Phonoautograph Callbacks
		{
			SetEntityConnectionStateChangeCallback("Phonautograph1", "PhonautographHandler"); 			//Arguments Required: ("Name of the Phonoautograph entity", "Name of the function to call on interaction" < this will always be the same)
		}
		
	//Setup Hint Callbacks
		{
			AddEntityCollideCallback("Player", "hint_1_trigger", "HintTriggerHandler", true, 0);
		}
		
			
		//Debugging
		if(ScriptDebugOn()) 
		{
			//SetFogProperties(0, 75, 1, false);
			GiveItemFromFile("lantern", "lantern.ent");
			
			//Test end event
			SetEntityInteractionDisabled("ReactorMainLever", false);
			SetLeverInteractionDisablesStuck("ReactorMainLever", true);
			SetLeverInteractionDisablesStuck("ReactorStartupLever", true);
		//	RemoveEntityCollideCallback("Player", "VOConrolRoomFlashback");
			SetEntityActive("LeverInteractionArea", true);
			
			//SetEntityActive("Child2", true);
			//AddEnemyPatrolNode("Child2", "PathNodeArea_2", 2.0f, "RemoveHeart", false);
			//AddEnemyPatrolNode("Child2", "PathNodeArea_1", 0.0f, "RemoveHeart", false);
			//AddTimer("", 2, "TestAnimation");
		}
} 

void TestAnimation(string &in asTimer)
{
	AddDebugMessage("Boo!", false);
	PlayEnemyAnimation("Child2", "RemoveHeart", false, 0.1f);
}

