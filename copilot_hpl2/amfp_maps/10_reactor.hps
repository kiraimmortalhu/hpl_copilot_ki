{
	AddDebugMessage("Rod Light Off", false);
	SetLampLit("RodLight", false, false);
}

void RodLowerSound (string &in asTimer)
{
	AddDebugMessage("Rod Sound Triggered", false);
	PlaySoundAtEntity("RodLowerStart2D", "afx_reactor_fuel_rod_lower_start_2D", "RodSource", 0.0f, false);
	PlaySoundAtEntity("RodLower2D", "afx_reactor_fuel_rod_lower_action_2D.snt", "RodSource", 0.0f, false);
	AddTimer("RodLowerStopSound", 5.1f, "RodLowerStopSound");
}

void RodLowerStopSound (string &in asTimer)
{
	AddDebugMessage("Rod Stop Triggered", false);
	PlaySoundAtEntity("RodLowerstop2D", "afx_reactor_fuel_rod_lower_stop_2D.snt", "RodSource", 0.0f, false);
}
	
void RodLowerComplete (string &in asTimer)
{
	AddDebugMessage("Rod Lower Complete", false);
	PlaySoundAtEntity("RodLowerComplete2D", "afx_reactor_fuel_rod_complete_2D.snt", "BellSource", 0.0f, false);
	PlaySoundAtEntity("RodLowerComplete3D", "afx_reactor_fuel_rod_complete_3D.snt", "BellSource", 0.0f, false);
	PlayMusic("music_reactor_fuel_rods_placed.ogg", false, 0.7f, 0.0f, 6, false);
	//SWAP TO AMBIENT AREAS PART 2//
	AddTimer("AmbientPart2AreaSpawn", 0.25f, "AmbientPart2AreaSpawn");
}

void SwitchInteractionUpdater (string &in asTimer)
{
	if (asTimer == "DeactivateSwitches")
	{
		if (GetLocalVarInt("Rod1Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_1", false);
			SetLeverStuckState("RodSwitch_1", -1, false);
		}
		if (GetLocalVarInt("Rod6Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_6", false);
			SetLeverStuckState("RodSwitch_6", -1, false);
		}
		if (GetLocalVarInt("Rod7Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_7", false);
			SetLeverStuckState("RodSwitch_7", -1, false);
		}
		if (GetLocalVarInt("Rod8Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_8", false);
			SetLeverStuckState("RodSwitch_8", -1, false);
		}
		SetLampLit("RodLight", true, false);
		AddDebugMessage("Switch Interaction Disabled", false);
		AddTimer("ActivateSwitchesTimer", 5.0f, "SwitchInteractionUpdater");
		return;
	}
	else if (asTimer == "ActivateSwitchesTimer")
	{
		if(GetLocalVarInt("Rod1Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_1", true);
		}
		if(GetLocalVarInt("Rod6Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_6", true);
		}
		if(GetLocalVarInt("Rod7Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_7", true);
		}
		if(GetLocalVarInt("Rod8Lowered") == 0)
		{
			SetLeverInteractionDisablesStuck("RodSwitch_8", true);
		}
		SetLampLit("RodLight", false, false);
		AddDebugMessage("Switch Interaction Restored", false);
	}
}
//END REACTOR COOLING ROD HANDLER//

//LEVER INTERACTION UPDATE//
void LeverInteractionUpdater (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetEntityInteractionDisabled("ReactorStartupLever", false);
		SetEntityInteractionDisabled("ReactorMainLever", false);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
	else if (alState == -1)
	{
		SetEntityInteractionDisabled("ReactorStartupLever", true);
		SetEntityInteractionDisabled("ReactorMainLever", true);	
		RemoveTimer("MovementPreventionTimer");
		return;
	}
}
//END LEVER INTERACTION UPDATE//

//REACTOR STARTUP SEQUENCER//
void ReactorStartupSequence (string &in asEntity, int alState)
{
	float fInitialTimerLength = 3.0f;
	float fTimerLength = fInitialTimerLength;
	float fMainLightSequenceStepTime = 0.5f;
	float fMainToCoreStepTime = 1.0f;
	float fSupportToOuterStepTime = 1.5f;
	float fCoreLightSequenceStepTime = 0.3f;
	
	if (alState == 1)
	{
		SetLeverInteractionDisablesStuck("ReactorStartupLever", false);
		SetLeverStuckState("ReactorStartupLever", 1, false);
		SetSwingDoorClosed("FuelRodOfficeDoor", true, false);
		SetSwingDoorLocked("FuelRodOfficeDoor", true, false);
		SetEntityInteractionDisabled("FuelRodOfficeDoor", true);
		PlaySoundAtEntity("ReactorStartup", "afx_event_bilge_reactor_powerup.snt", "Player", 0.0f, false);
		PlayMusic("music_reactor_start.ogg", true, 1.0f, 0.0f, 5, true);
		StopSound("AMBReactorPart2", 10.0f);
		StopSound("ReactorSteamSound1", 13.0f);
		AddTimer("ReactorChildVOTimer", 1.5f, "ReactorChildVO");
		AddTimer("ReactorHornSoundTimer", 12.0, "LightStepHandler");
		AddTimer("ReactorSoundTimer", 12.5, "LightStepHandler");
		AddTimer("ReactorSoundTimerStop", 13.0, "LightStepHandler");
		
		//BEGIN SUPPORT BEAM LIGHTS TURN ON SEQUENCE//
		AddTimer("LightPowerUpTimer8", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer9", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer10", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer11", fTimerLength, "LightStepHandler");
		//END SUPPORT BEAM LIGHTS TURN ON SEQUENCE//
		fTimerLength += fSupportToOuterStepTime;
		//BEGIN OUTER WALL LIGHTS TURN ON SEQUENCE//
		AddTimer("LightPowerUpTimer1", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer2", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer3", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer4", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer5", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer6", fTimerLength, "LightStepHandler");
		fTimerLength += fMainLightSequenceStepTime;
		AddTimer("LightPowerUpTimer7", fTimerLength, "LightStepHandler");
		//END OUTER WALL LIGHTS TURN ON SEQUENCE//
		fTimerLength += fMainToCoreStepTime;
		//BEGIN CORE LIGHTS TURN ON SEQUENCE//
		AddTimer("LightPowerUpTimer12", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer13", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer14", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer15", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer16", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer17", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer18", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer19", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer20", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer21", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer22", fTimerLength, "LightStepHandler");
		fTimerLength += fCoreLightSequenceStepTime;
		AddTimer("LightPowerUpTimer23", fTimerLength, "LightStepHandler");
		//END CORE LIGHTS TURN ON SEQUENCE//
		AddDebugMessage("Core Lights Sequence Initiated. Total Length Will Be: "+fTimerLength+" Seconds.", false);
		AddTimer ("MachineVO_4", 15.0f, "MachineVO_4");
	}
}

