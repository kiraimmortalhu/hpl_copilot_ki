		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer16")
	{
		for (int lval = 17; lval < 21; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer17")
	{
		for (int lval = 21; lval < 25; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer18")
	{
		for (int lval = 25; lval < 29; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer19")
	{
		for (int lval = 29; lval < 33; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer20")
	{
		for (int lval = 33; lval < 37; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer21")
	{
		for (int lval = 37; lval < 41; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer22")
	{
		for (int lval = 41; lval < 45; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "LightPowerUpTimer23")
	{
		for (int lval = 45; lval < 49; lval++)
		{
			SetLampLit("CoreLight_"+lval, true, false);
		}
		PlaySoundAtEntity("", "blank.snt", "Player", 0.0f, false);
		SetLeverInteractionDisablesStuck("ReactorMainLever", true); //ACTIVATE POWER SWITCH HERE
		SetEntityActive("lever_2_off", false);
		SetEntityActive("lever_2_on", true);
		return;
	}
	//END CORE LIGHTS TURN ON SEQUENCE//
	//SOUND CONTROL//
	else if (asTimer == "ReactorHornSoundTimer")
	{
		AddDebugMessage("Horn Triggered", false);
		PlaySoundAtEntity("ReactorHornSound", "afx_reactor_power_horn_higher", "Player", 0.0f, false);
		return;
	}

	else if (asTimer == "ReactorSoundTimer")
	{
		AddDebugMessage("Loop Triggered", false);
		PlaySoundAtEntity("ReactorLoop", "afx_event_bilge_reactor_loop.snt", "Player", 0.5f, true);
		return;
	}
	
	else if (asTimer == "ReactorSoundTimerStop")
	{
		AddDebugMessage("Stop Startup Sound", false);
		StopSound("ReactorStartup", 0.5f);
		return;
	}
	//END SOUND CONTROL//
}
//END REACTOR STARTUP SEQUENCE//

//STOP MOVEMENT ON MAIN LEVER INTERACT//
void MovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("ReactorMainLever") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
}
//END STOP MOVEMENT//	

//REACTOR MAIN SEQUENCE//
void ReactorMainSequence (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		PlaySoundAtEntity("ReactorOff", "afx_event_bilge_reactor_off.snt", "Player", 0.0f, false);
		ShowPlayerCrossHairIcons(false);
		SetEntityInteractionDisabled("ReactorStartupLever", true);
		SetEntityInteractionDisabled("ReactorMainLever", true);
		SetLeverInteractionDisablesStuck("ReactorMainLever", false);
		SetLeverStuckState("ReactorMainLever", 1, false);
		StopSound("ReactorLoop", 2.0f);
		StopMusic(3.0f, 5);
		AddTimer("MainPowerOnTimer", 0.2f, "ReactorChildSequence");
		
	}
}
//END REACTOR MAIN SEQUENCE//

//REACTOR CHILD SEQUENCE//
void ReactorChildSequence (string &in asTimer)
{
	int lSequenceStep = GetLocalVarInt("ChildSequenceStepTracker");
		switch (lSequenceStep)
		{
			case 0:
				RemoveTimer("MovementPreventionTimer");
				SetEntityActive("LeverInteractionArea", false);
				//SetPlayerActive(false);
				SetJournalDisabled(true);
				SetPlayerRunSpeedMul(0);
				SetPlayerJumpDisabled(true);
				SetPlayerCrouchDisabled(true);
				SetPlayerMoveSpeedMul(0.1f);
				SetPlayerLookSpeedMul(0.2f);
				SetPlayerCrouching(false);		
				SetLanternDisabled(true);
				SetLanternActive(false, false);
				StartPlayerLookAt("ReactorLookTarget_1", 1.0f, 2.0f, "");
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.7f, "ReactorChildSequence");
				break;
			
			case 1:
				FadePlayerFOVMulTo(0.9f, 0.15f);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 1.5f, "ReactorChildSequence");
				break;
				
			case 2:
				SetMoveObjectState("reactor_door_1", 1);
				SetMoveObjectState("reactor_door_2", 1);
				AddDebugMessage("Reactor Doors Closing", false);
				//PlaySound
				PlaySoundAtEntity("reactor_door_1_3D", "reactor_door_close_1_3D.snt", "reactor_door_1", 0.0f, false);
				PlaySoundAtEntity("reactor_door_1_2D", "reactor_door_close_1_2D.snt", "reactor_door_1", 0.0f, false);
				PlaySoundAtEntity("reactor_door_2_3D", "reactor_door_close_1_3D.snt", "reactor_door_2", 0.0f, false);
				PlaySoundAtEntity("reactor_door_2_2D", "reactor_door_close_1_2D.snt", "reactor_door_2", 0.0f, false);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.5f, "ReactorChildSequence");
				break;
			
			case 3:
				StartPlayerLookAt("ReactorLookTarget_2", 2.5f, 3.0f, "");
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 2.2f, "ReactorChildSequence");
				break;
				
			case 4:
				StartPlayerLookAt("ReactorLookTarget_3", 1.2f, 1.6f, "");
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 2.9f, "ReactorChildSequence");
				break;
			
			case 5:
				PlaySoundAtEntity("ReactorMainPowerOn", "afx_event_reactor_POWERON.snt", "Player", 0.0f, false); //1.324 timer to effects/throw
				StartScreenShake(0.15f, 2.5f, 0.12f, 0.5f);
				//SWAP TO AMBIENT AREAS PART 3//
				AddTimer("AmbientPart3AreaSpawn", 6.0f, "AmbientPart3AreaSpawn");
				AddTimer("ReactorLoopSound", 0.0f, "ReactorLoopSound");
				AddTimer("ReactorHornSound", 6.0f, "ReactorHornSound");
				AddTimer("TheChildrenMusic", 22.0f, "TheChildrenMusic");
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.15f, "ReactorChildSequence");
				break;
				
			case 6:
				StartPlayerLookAt("ReactorLookTarget_1", 5.5f, 6.5f, "");
				ElectroSequencer("Initialise");
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.25f, "ReactorChildSequence");
				break;
			
			case 7:
				SetParticleSystemActive("ReactorPulse_*", true);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 1.375f, "ReactorChildSequence");
				break;
			
			case 8:
				SetEntityActive("BrokenGlass", true);
				SetParticleSystemActive("Glass_1", true);
				SetParticleSystemActive("Glass_2", true);
				SetParticleSystemActive("Glass_3", true);
				PlaySoundAtEntity("", "afx_reactor_glass_pane_crack.snt", "BreakGlassSource", 0.0f, false);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.25f, "ReactorChildSequence");
				AddDebugMessage("case 8", false);
				break;
				
			case 9:
				FadePlayerFOVMulTo(1.5f, 6.4f);
				MovePlayerHeadPos(0.0f, 0.6f, -3.0f, 5.0f, 0.25f);
				FadePlayerRollTo(75.0f, 37.4f, 37.4f);
				FadeOut(0.5f);
				AddTimer("MachineActiveVO", 5.0f, "MachineActiveVO");
				StopSound("ReactorEngineSound", 5.0f);
				AddTimer("ReactorLoopSound", 70.0f, "ReactorLoopSound");
				PlaySoundAtEntity("ReactorEngineSoundQuieter", "afx_reactor_power_loop_quieter", "Player", 5.0f, true);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 19.0f, "ReactorChildSequence");
				AddDebugMessage("case 9", false);
				
				break;
				
			case 10:
				TeleportPlayer("StartTestEnd");
				SetPlayerMoveSpeedMul(0);
				SetPlayerLookSpeedMul(0.01f);
				SetPlayerCrouching(true);
				FadePlayerFOVMulTo(0.75f, 5.0f);
				MovePlayerHeadPos(0.0f, -0.5f, 0.1f, 15.0f, 0.25f);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				//PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
				AddTimer("ChildStepTimer"+lSequenceStep, 12.0f, "ReactorChildSequence");
				StartPlayerLookAt("ReactorLookTarget_4", 20.0f, 20.0f, "");
				AddDebugMessage("case 10", false);
				break;
			
			case 11:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.5f, "ReactorChildSequence");
				FadeIn(6.0f);
				SetEntityActive("Child1", true);
				SetEntityActive("Child2", true);
				SetLightVisible("ChildrenUplight", true);
				FadePlayerRollTo(10.0f, 4.5f, 4.5f);
				AddDebugMessage("case 11", false);
				StartPlayerLookAt("ReactorLookTarget_7", 0.15f, 0.15f, "");
				break;
				
			case 12:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 2.5f, "ReactorChildSequence");
				
				FadeImageTrailTo(2.0f, 4.0f);
				AddDebugMessage("case 12", false);
				break;

			case 13:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 1.0f, "ReactorChildSequence");
				AddEffectVoice("vo_reactor_mandus_monologue_2", "", "Voice", "vo_reactor_mandus_monologue_2", false, "", 0.0f, 0.0f);
				AddDebugMessage("case 13", false);
				break;
				
			case 14:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 3.5f, "ReactorChildSequence");
				
				FadeOut(4.0f);
				break;
				
			case 15:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 1.0f, "ReactorChildSequence");
				
				MovePlayerHeadPos(0.0f, -0.5f, 0.0f, 15.0f, 0.25f);
				StartPlayerLookAt("ReactorLookTarget_6", 0.15f, 0.1f, "");
				break;
				
			case 16:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 2.5f, "ReactorChildSequence");
				
				FadeIn(3.0f);
				break;
				
			case 17:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 0.5f, "ReactorChildSequence");
				
				FadeOut(2.5f);
				break;
				
			case 18:
				//AddEffectVoice("vo_reactor_child_02.ogg", "", "Voice", "vo_reactor_child_02", false, "", 0.0f, 0.0f);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("Child1", 1.9f, "PlayChildRemoveHeartAnim");
				AddTimer("Child2", 2.15f, "PlayChildRemoveHeartAnim");
				AddTimer("RemoveHeartStingerSound", 0.5f, "RemoveHeartStingerSound");
				AddTimer("ChildStepTimer"+lSequenceStep, 2.25f, "ReactorChildSequence"); //Quicken up the sequence sp child animation does not get weird.
				AddDebugMessage("case 14", false);
				break;
				
			case 19:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 3.25f, "ReactorChildSequence");
				
				FadeIn(2.5f);
				break;
				
			case 20:
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 1.5f, "ReactorChildSequence");
				AddDebugMessage("case 15", false);
				break;
			
			case 21:
				StopSound("AMBFuelRodRoom", 5);
				StopSound("ReactorEngineSound", 5);
				FadeOut(0.1f);
				PlaySoundAtEntity("", "afx_reactor_hearthit.snt", "Player", 0.0f, false);
				MandusReactionPlayer("Scared", 0.5f);
				StopMusic(7.5, 8);
				MandusReactionPlayer("Breath", 1.0f);
				AddLocalVarInt("ChildSequenceStepTracker", 1);
				AddTimer("ChildStepTimer"+lSequenceStep, 4.5f, "ReactorChildSequence");
				AddDebugMessage("case 16", false);
				break;
				
			case 22:
				ShowPlayerCrossHairIcons(true);
				AddTimer("LevelEnd", 6.0f, "LevelTransitionHandler");
				AddDebugMessage("case 17", false);
				break;
		}
}

void PlayChildRemoveHeartAnim (string &in asTimer)
{
	PlayEnemyAnimation(asTimer, "RemoveHeart", false, 0.1f);
}

//LEVEL TRANSITION HANDLER//
void LevelTransitionHandler (string &in asTimer)
{
	AddDebugMessage("FadeSounds", false);
	
	SetPlayerActive(false);
	FadeOut(5.55f);
	StopSound("tube_lamp_factory_railing_small_point_1_hum", 5);
	StopSound("tube_lamp_factory_railing_small_point_3_hum", 5);
	StopSound("tube_lamp_factory_railing_small_point_2_hum", 5);
	StopSound("ReactorMainPowerOn", 5);
	StopSound("ReactorEngineSound", 5);
	StopSound("ReactorEngineSoundQuieter", 5);
	StopSound("ReactorLoop", 5);
	
	AddTimer("LevelTransitionBuffer", 5.55f, "LevelLoader");
}

void LevelLoader (string &in asTimer)
{
	SetLanternDisabled(false);
	ChangeMap("11_engine_room.map", "MainStart", "", "");
}
//END LEVEL TRANSITION HANDLER//

void ElectroSequencer(string &in asTimer)
{
	if (asTimer == "Initialise")
	{
		SetParticleSystemActive("Electro_1", true);
		SetParticleSystemActive("Electro_6", true);
		SetParticleSystemActive("Electro_8", true);
		AddTimer("ElectroTimer1", 0.08f, "ElectroSequencer");
		return;
	}
	else if (asTimer == "ElectroTimer1")
	{
		SetParticleSystemActive("Electro_2", true);
		SetParticleSystemActive("Electro_7", true);
		AddTimer("ElectroTimer2", 0.04f, "ElectroSequencer");
		return;
	}
	else if (asTimer == "ElectroTimer2")
	{
		SetParticleSystemActive("Electro_4", true);
		SetParticleSystemActive("Electro_10", true);
		SetParticleSystemActive("Electro_3", true);
		AddTimer("ElectroTimer3", 0.1f, "ElectroSequencer");
		return;
	}
	else if (asTimer == "ElectroTimer3")
	{
		SetParticleSystemActive("Electro_5", true);
		SetParticleSystemActive("Electro_9", true);
		return;
	}
}
//END REACTOR CHILD SEQUENCE//

