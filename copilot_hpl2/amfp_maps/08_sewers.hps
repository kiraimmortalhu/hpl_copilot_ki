	void music_pipes_trigger_timer (string &in asTimer)
	{
		AddDebugMessage("pipes music triggered", false);
		PlayMusic("music_church_factory_event.ogg", false, 0.8f, 0.0f, 1, false);
	}
//END MUSIC PLAYER//

//STING PLAYER//
void StingPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ChaosThreatTrigger")
	{
		PlaySoundAtEntity("", "chaos_threat.snt", "Player", 0.0f, false);
		return;
	}
	
}
//END STING PLAYER//


//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
//FLASHBACKS
	if (asChild == "VOFlashback_1")
	{
		AddEffectVoice5("vo_sewer_trigger_01_flashback.ogg", "", "Voice", "vo_sewer_trigger_01_flashback_mandus_01", 0.0f, "vo_sewer_trigger_01_flashback_machine_01", 5.5f, "vo_sewer_trigger_01_flashback_machine_01_02", 8.0f, "vo_sewer_trigger_01_flashback_machine_01_03", 11.0f, "vo_sewer_trigger_01_flashback_mandus_02", 15.5f, false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerLookSpeedMul(0.35f);
		AddTimer("ReturnToNormal", 21.0f, "ReturnToNormal");
		AddTimer("Sewers1", 22.0f, "TimerDelayedHint");
		return;
	}
		else if (asChild == "VOSpraylockTrigger")
	{
		AddEffectVoice("vo_sewers_machine_02.ogg", "", "Voice", "vo_sewers_machine_02", false, "", 0.0f, 0.0f);
	}
		else if (asChild == "childVO_1")
	{
		AddEffectVoice("vo_sewers_child_01.ogg", "", "Voice", "vo_sewers_child_01", false, "", 0.0f, 0.0f);
	}
	
}
//END TRIGGERED VO PLAYER//

//RETURN TO NORMAL//
void ReturnToNormal (string &in asTimer)
	{
	FadeImageTrailTo(0.0f, 2.0f);
	FadeRadialBlurTo(0.0f, 2.0f);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	StopPlayerLookAt();
	SetEntityActive("AreaFakeLurkStart_1", true);
	}
///END RETURN TO NORMAL//

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//PHONAUTOGRAPH HANDLER//
void PhonautographHandler (string &in asEntity, int alState)																//This function must be present for all maps containing Phonautograph entities.
{
	if (alState == 1)																										//DO NOT EDIT
	{																														///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////////////////////////////
		if (asEntity == "Phonautograph1")																					
		{
			SetEntityInteractionDisabled(asEntity, true);																	//DO NOT EDIT
			PlayPropAnimation("Phonautograph1", "Play", 1.0f, true, "");													//Starts Animation. The name of the Phonautograph entity will need changing for other instances.
			AddEffectVoice7("vo_sewer_phono.ogg", "", "Voice", "vo_sewer_phono_mandus_1", 0.0f, "vo_sewer_phono_prof_1", 8.0f, "vo_sewer_phono_mandus_2", 11.5f, "vo_sewer_phono_prof_2", 19.0f, "vo_sewer_phono_mandus_3", 24.0f, "vo_sewer_phono_prof_3", 32.0f, "vo_sewer_phono_mandus_4", 35.0f, false, "", 0.0f, 0.0f);	    							//Plays voice. The .ogg file being called, and the entry name from the .lang file will need changing for other instances.
			AddTimer("PhonoPart2", 40.0f, "PhonPart2");
			AddTimer("Phono1Timer", 47.0f, "PhonautographDeactivateHandler");		
			}																													
	}																														//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES///////////////	
}

void PhonautographDeactivateHandler (string &in asTimer)																	//This function must be present for all maps containing Phonautograph entities.
{																															///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////
	if (asTimer == "Phono1Timer")																							//This if statement must be updated for each different phonautograph instance.
	{
		PlayPropAnimation("Phonautograph1", "Stop", 1.0f, true, "");														//Stops Animation. The name of the Phonautograph entity will need changing for other instances.
	}
}		

void PhonPart2 (string &in asTimer)	
{
AddEffectVoice("vo_sewer_phono_2.ogg", "", "Voice", "vo_sewer_phono_mandus_5", false, "", 0.0f, 0.0f);
AddDebugMessage("PHONOPART2", false);
}																											//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES/////////////
//END PHONAUTOGRAPH HANDLER//

