			AddEntityCollideCallback("Player", "PipeEvent_9", "PipeHandler", true, 1);
			
			for(int i=1; i<=5; ++i)
				AddEntityCollideCallback("Player", "AreaCellFlickering_"+i, "EnterLeaveCellFlickering", false, 0);

			
			AddEntityCollideCallback("wretch_meet_start", "nest_meet_actor_trigger", "NestMeetScene", true, 1);
			
			AddEntityCollideCallback("engineer_meet_end", "AreaRemoveEngineer", "CollideRemoveEngineer", true, 1);
			
