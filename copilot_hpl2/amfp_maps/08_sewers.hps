//SPRAYLOCK SWITCH PROXIMITY CHECKER//
void CheckPowerSwitchProximity (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("spraylocksequenced") == 0)
	{
		if (alState == 1)
		{
			AddDebugMessage("Power Switch CAN Be Interacted With", false);
			SetEntityInteractionDisabled("spraylock_power_switch", false);
			AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
			return;
		}
		else if (alState == -1)
		{
			AddDebugMessage("Power Switch CANNOT Be Interacted With", false);
			SetEntityInteractionDisabled("spraylock_power_switch", true);
			RemoveTimer("MovementPreventionTimer");
			return;
		}
	}
}
//END PROXIMITY CHECKER//	

//STOP MOVEMENT ON POWER SWITCH INTERACT//
void MovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("spraylock_power_switch") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "MovementPreventionChecker");
		return;
	}
}
//END STOP MOVEMENT//									

//SPRAYLOCK SEQUENCER//
void SpraylockSequence (string &in asEntity, int alState)
{
	if (asEntity == "spraylock_power_switch" && alState == 1 && GetLocalVarInt("spraylocksequenced") == 0)
	{
		AddDebugMessage("Spraylock Power Switch Activated", false);
		SetEntityActive("waterlurker_amb_3", false);
		PlaySoundAtEntity("", "spraylock_breaker_switch_confirm.snt", "spraylock_power_switch", 0.0f, false);
		//PLAY SPARKS//
		SetParticleSystemActive("spraylock_sparks_1", true);
		SetParticleSystemActive("spraylock_sparks_2", true);
		SetLightVisible("spraylock_spark_light", true);
		AddTimer("SpraylockPowerSwitchSparkLightTimer", 0.4, "SpraylockTimedEvents");
		//STICK POWER SWITCH//
		SetLeverInteractionDisablesStuck("spraylock_power_switch", false);
		SetLeverStuckState("spraylock_power_switch", 1, false);
		//UNSTICK INTERIOR VALVE 1//
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_1", true);
		PlaySoundAtEntity("sl_hiss_2", "spraylock_gauge_hiss_2.snt", "spraylock_hiss_inside_1", 0.0f, false);
		//ACTIVATE CONTAINING RAILS//
		PlayPropAnimation("spraylock_railing", "offtoon", 0.0f, false, "");
		PlaySoundAtEntity("sl_railing_up", "spraylock_railing_up.snt", "spraylock_railing", 0.0f, false);
		SetEntityActive("spraylock_railing_collision", true);
		AddTimer("SpraylockRailingActivationAnimationTimer", 1.5f, "SpraylockTimedEvents");
		//REMOVE PROXIMITY CHECKER//
		RemoveEntityCollideCallback("Player", "spraylock_power_interaction_area");
		SetEntityInteractionDisabled("spraylock_power_switch", false);
		//PLAY SEQUENCE OUT
		PlaySoundAtEntity("sl_turbinestart", "spraylock_turbine_start.snt", "spraylock_center_sound", 0.0f, false);
		PlaySoundAtEntity("sl_enginestart", "spraylock_engine_start.snt", "spraylock_center_sound", 0.0f, false);
		PlaySoundAtEntity("sl_turbinestart_rattle", "spraylock_turbine_start_RATTLE.snt", "spraylock_rattlesound", 0.0f, false);
		SetLampLit("spraylock_red_light", false, false);
		SetLampLit("spraylock_green_light", true, false);
		AddTimer("SpraylockInitLoopTimer", 3.0f, "SpraylockTimedEvents");
		AddTimer("SpraylockEngineOnAnimationBuffer", 1.9f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_engines", "on", 0.0f, false, "");
		AddTimer("SpraylockCabinetGauge1AnimationTimer", 3.2f, "SpraylockTimedEvents");
		AddTimer("SpraylockCabinetGauge2AnimationTimer", 2.0f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_power_gauges", "offtoon", 0.0f, false, "");
		PlayPropAnimation("spraylock_spray_switch_gauges", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_spray_switch_gauges_1", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_1", "on", 0.0f, true, "");
		AddTimer("SpraylockPowerGaugesOffToOnTimer", 0.3, "SpraylockTimedEvents");
		return;
	}
	else if (asEntity == "spraylock_power_switch" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 1)
	{
		//STICK POWER SWITCH//
		SetLeverInteractionDisablesStuck("spraylock_power_switch", false);
		SetLeverStuckState("spraylock_power_switch", -1, false);
		//SWITCH LIGHTS//
		SetLampLit("spraylock_red_light", true, false);
		SetLampLit("spraylock_green_light", false, false);
		//DEACTIVATE CONTAINING RAILS//
		PlayPropAnimation("spraylock_railing", "ontooff", 0.0f, false, "");
		PlaySoundAtEntity("sl_railing_down", "spraylock_railing_down.snt", "spraylock_railing", 0.0f, false);
		SetEntityActive("spraylock_railing_collision", true);
		AddTimer("SpraylockRailingDeactivationAnimationTimer", 1.5f, "SpraylockTimedEvents");		
		//PLAY SEQUENCE OUT//
		PlaySoundAtEntity("sl_turbine_end", "spraylock_turbine_end.snt", "spraylock_center_sound", 1.0f, false);
		PlaySoundAtEntity("sl_turbine_end_rattle", "spraylock_turbine_end_rattle.snt", "spraylock_rattlesound", 1.0f, false);
		PlaySoundAtEntity("sl_engine_end", "spraylock_engine_end.snt", "spraylock_center_sound", 1.0f, false);
		StopSound("sl_turbine_loop", 1.0f);
		StopSound("sl_engine_loop", 1.0f);
		PlayPropAnimation("spraylock_engines", "ontooff", 0.0f, false, "");
		PlayPropAnimation("spraylock_power_gauges", "ontooff", 1.0f, false, "");
		return;
	}
	else if (asEntity == "spraylock_spray_switch" && alState == 1)
	{
		AddDebugMessage("Spraylock Spray Switch Activated", false);
		AddTimer("SpraylockGaugesStartUpPadding", 0.4f, "SpraylockTimedEvents");
		AddTimer("SpraylockSprayGaugesAnimationPadding", 0.6f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_spray_switch_gauges", "ontooff", 7.0f, false, "");
		PlayPropAnimation("spraylock_spray_switch_gauges_1", "ontooff", 7.0f, false, "");
		PlaySoundAtEntity("", "spraylock_switch_confirm.snt", "spraylock_spray_switch", 0, false);
		//STICK SPRAY SWITCH
		SetLeverInteractionDisablesStuck("spraylock_spray_switch", false);
		SetLeverStuckState("spraylock_spray_switch", 1, false);
		AddTimer("SpraylockSprayPadding", 0.3f, "SpraylockTimedEvents");
		AddTimer("SpraylockSprayToEndTimer", 8.0f, "SpraylockTimedEvents");
		return;
	}
}
//END SEQUENCER//

//SPRAYLOCK DOOR SEQUENCER//
void SpraylockDoorHandler (string &in asEntity, int alState)
{
	if (asEntity == "spraylock_valve_outside_1" && alState == -1) //Office Valve Opens Door 1//
	{
		AddDebugMessage("Opening Spraylock Door 1", false);
		StopSound("sl_hiss_1", 0.5f);
		PlayPropAnimation("spraylock_door_1", "opening", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_OUTSIDE.snt", "spraylock_door1source", 0.0f, false);
		PlayPropAnimation("spraylock_gauge_outside_1", "ontooff", 4.0f, false, "");
		AddTimer("SpraylockDoor1AnimationPadding", 2.2f, "SpraylockTimedEvents");
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_outside_1", false);
		SetWheelStuckState("spraylock_valve_outside_1", -1, false);
		return;
	}
	
	else if (asEntity == "spraylock_valve_inside_1" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 0) //Left Interior Valve Closes Door 1//
	{
		AddDebugMessage("Closing Spraylock Door 1", false);
		StopSound("sl_hiss_2", 0.5f);
		AddTimer("SpraylockDoor1ClosingAnimationPadding", 3.0f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_gauge_inside_1", "ontooff", 4.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_close_INSIDE.snt", "spraylock_door2source", 0.0f, false);
		PlaySoundAtEntity("", "spraylock_valve_lock_inside.snt", "spraylock_valve_inside_1", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_1", 0, 3.0f, true);
		//UNSTICK SPRAY SWITCH
		SetLeverInteractionDisablesStuck("spraylock_spray_switch", true);
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_1", false);
		SetWheelStuckState("spraylock_valve_inside_1", -1, false);
		return;
	}
	
	else if (asEntity == "spraylock_valve_outside_2" && alState == -1) //Annex Valve Closes Door 2//
	{
		/*PlayPropAnimation("spraylock_door_1", "door", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_open.snt", "spraylock_door2source", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_2", 0, 3.0f, false);
		return;*/
	}
	
	else if (asEntity == "spraylock_valve_inside_2" && alState == -1 && GetLocalVarInt("spraylocksequenced") == 1) //Right Interior Valve Opens Door 2//
	{
		AddDebugMessage("Opening Spraylock Door 2", false);
		StopSound("sl_hiss_3", 0.5f);
		PlayPropAnimation("spraylock_gauge_inside_2", "ontooff", 4.0f, false, "");
		PlayPropAnimation("spraylock_door_2", "opening", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_INSIDE.snt", "spraylock_door1source", 0.0f, false);
		AddTimer("SpraylockDoor2AnimationPadding", 2.0f, "SpraylockTimedEvents");
		//STICK THIS VALVE
		SetWheelInteractionDisablesStuck("spraylock_valve_inside_2", false);
		SetWheelStuckState("spraylock_valve_inside_2", -1, false);
		//UNSTICK POWER SWITCH FOR SECOND USE
		SetLeverInteractionDisablesStuck("spraylock_power_switch", true);
		return;		
	}
}

void SpraylockTimedEvents (string &in asTimer)
{
	//SPRAYLOCK EVENTS//
	if (asTimer == "SpraylockDoor1AnimationPadding")
	{
		PlayPropAnimation("spraylock_door_1", "open", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_open.snt", "spraylock_door1source", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_1", 1, 3.0f, true);
		return;
	}
	else if (asTimer == "SpraylockDoor1ClosingAnimationPadding")
	{
		PlayPropAnimation("spraylock_door_1", "closing", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_INSIDE.snt", "spraylock_door1source", 0.0f, false);
		return;
	}
	else if (asTimer == "SpraylockPowerGaugesOffToOnTimer")
	{
		PlayPropAnimation("spraylock_power_gauges", "on", 0.2f, true, "");
		return;
	}
	else if (asTimer == "SpraylockDoor2AnimationPadding")
	{
		PlaySoundAtEntity("", "spraylock_door_hinge_open_INSIDE.snt", "spraylock_door2source", 0.0f, false);
		PlaySoundAtEntity("", "spraylock_valve_lock_inside.snt", "spraylock_valve_inside_2", 0.0f, false);
		SetSwingDoorOpenAmount("spraylock_door_2", 1, 3.0f, false);
		return;
	}
	else if (asTimer == "SpraylockGaugesStartUpPadding")
	{
		PlayPropAnimation("spraylock_gauges", "offtoon", 0.0f, false, "");
	}
	else if (asTimer == "SpraylockSprayGaugesAnimationPadding")
	{
		PlayPropAnimation("spraylock_gauges", "on", 0.0f, true, "");
		AddTimer("SpraylockSprayGaugesTimeout", 6.0f, "SpraylockTimedEvents");
		return;
	}
	else if (asTimer == "SpraylockSprayGaugesTimeout")
	{
		PlayPropAnimation("spraylock_gauges", "ontooff", 0.0f, false, "");
		return;
	}
	else if (asTimer == "SpraylockPowerSwitchSparkLightTimer")
	{
		SetLightVisible("spraylock_spark_light", false);
		return;
	}
	else if (asTimer == "SpraylockRailingActivationAnimationTimer")
	{
		PlayPropAnimation("spraylock_railing", "on", 0.0f, true, "");
		return;
	}
	else if (asTimer == "SpraylockRailingDeactivationAnimationTimer")
	{
		PlayPropAnimation("spraylock_railing", "off", 0.0f, true, "");
		SetEntityActive("spraylock_railing_collision", false);
		return;
	}
	else if (asTimer == "SpraylockInitLoopTimer")
	{
		AddDebugMessage("Spraylock Engines Starting Up", false);
		PlaySoundAtEntity("sl_turbine_loop", "spraylock_turbine_loop.snt", "spraylock_center_sound", 0.0f, false);
		PlaySoundAtEntity("sl_engine_loop", "spraylock_engine_loop.snt", "spraylock_center_sound", 0.0f, false);
		return;
	}
	else if (asTimer == "SpraylockSprayPadding")
	{
		AddDebugMessage("Spraylock Particles Activated", false);
		PlaySoundAtEntity("sl_spray", "spraylock_mainspray.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("sl_drips", "amb_spraylock_drips.snt", "spraylock_spray_switch_gauges_1", 0.0f, false);
		SetParticleSystemActive("spraylock_spray1", true);
		SetParticleSystemActive("spraylock_spray2", true);
		SetParticleSystemActive("spraylock_spray3", true);
		SetParticleSystemActive("spraylock_spray4", true);
		SetParticleSystemActive("spraylock_spray5", true);
		SetParticleSystemActive("spraylock_spray6", true);
		SetParticleSystemActive("spraylock_risingmist", true);
		SetPlayerInfection(0.0f);
		return;
	}
	else if (asTimer == "SpraylockSprayToEndTimer")
	{
		AddDebugMessage("Spraylock Engines Spinning Down", false);
		AddTimer("SpraylockInteriorValveAnimationTimer", 1.9f, "SpraylockTimedEvents");
		PlayPropAnimation("spraylock_gauge_inside_2", "offtoon", 2.0f, false, "");
		SetLocalVarInt("spraylocksequenced", 1);
		return;
	}
	else if (asTimer == "SpraylockEngineOnAnimationBuffer")
	{
		PlayPropAnimation("spraylock_engines", "on", 0.25f, true, "");
		return;
	}
	else if (asTimer == "SpraylockInteriorValveAnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_inside_2", "on", 0.25f, true, "");
		//UNSTICK INTERIOR VALVE 2//
		SetWheelStuckState("spraylock_valve_inside_2", 0, false);
		PlaySoundAtEntity("sl_hiss_3", "spraylock_gauge_hiss_3.snt", "spraylock_hiss_inside_2", 0.0f, false);
		return;
	}
	else if (asTimer == "SpraylockCabinetGauge1AnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_power1", "on", 0.25f, true, "");
		return;
	}
	else if (asTimer == "SpraylockCabinetGauge2AnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_power2", "on", 0.25f, true, "");
		return;
	}
}
//END SPRAYLOCK SEQUENCER//



