//Nest Wretch Handler//
void NestWretchHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "NestChainsTrigger")
	{
		AddTimer("ChainReturn", 10.15f, "NestTimers");
		PlayPropAnimation("nest_wretch_chains", "NestChainNotice", 0.0f, false, "");
		PlaySoundAtEntity("chain_attack", "afx_sewer_wretch_chains_run", "nest_wretch_chains", 1.0f, false);
		
		SetEntityActive("NestChainsTrigger", false);
		
		MandusReactionPlayer("Scared", 1.35);
	}
	
	// else if (asChild == "NestWritingTrigger")
	// {
	// AddTimer("WritingStart", 2.00f, "NestTimers");
	// AddTimer("WritingReturn", 11.54f, "NestTimers");
	// }
	
	else if (asChild == "cell_audio_trigger")
	{
		SetEntityActive("nest_wretch_play", true);
		SetEntityActive("pig_blocks_1", true);
		PlaySoundAtEntity("nest_blocks_audio", "afx_sewer_wretch_blocks", "nest_wretch_play", 1.0f, false);
		PlaySoundAtEntity("nest_cry_audio", "afx_sewer_wretch_blocks", "nest_wretch_sob", 1.0f, false);
	}
}

void TimerNestChainsMusicUp(string &in asTimer)
{
	StopMusic(1, 8);
}

//End Nest Wretch Handler//

//Nest Writer Handler//
void NestWritingHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "NestWritingTrigger")
	{
		if (alState == 1)
		{
			SetSwingDoorLocked("Gate2DoorB_4", true, false);
			SetEntityActive("nest_wretch_feeding_1", false);
			SetEntityActive("nest_wretch_feeding_2", false);
			SetEntityActive("wretch_meet_end", false);
			
			SetEntityActive("nest_wretch_writing", true);
			PlayPropAnimation("nest_wretch_writing", "NestWriteIdle", 0.0f, false, "WriterProximityEffect");
			return;
		}
		else if (alState == -1)
		{
			StopSound("write_return", 0.0f);
			StopPropMovement("nest_wretch_writing");

			return;
		}
	}	

}	

void WriterProximityCheck(string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Too Close", false);
		SetLocalVarInt("WritePig_Notices", 1);
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("Safe Distance", false);
		SetLocalVarInt("WritePig_Notices", 0);
		return;
	}
}
		
void WriterProximityEffect (string &in asProp)
{
	if (GetLocalVarInt("WritePig_Notices") == 1)//Unhappy Writing Pig
	{
		AddDebugMessage("Writer Spotted You", false);
		PlayPropAnimation("nest_wretch_writing", "NestWriteNotice", 0.0f, false, "WriterProximityEffect");
		PlaySoundAtEntity("write_notice", "afx_sewer_wretch_write_disturbed", "nest_wretch_writing", 0.0f, false);
		StopSound("write_return", 0.0f);
		return;
	}
	else if (GetLocalVarInt("WritePig_Notices") == 0)//Happy Writing Pig
	{
		AddDebugMessage("Writer HASNT Spotted You", false);
		PlayPropAnimation("nest_wretch_writing", "NestWriteIdle", 0.0f, false, "WriterProximityEffect");
		PlaySoundAtEntity("write_return", "afx_sewer_wretch_write", "nest_wretch_writing", 0.0f, true);
		return;
	}
}
//End Nest Writer Handler//

//Nest Door Handler//
void NestAnimDoor(string &in asEntity)
{
	AddDebugMessage("Door animation: "+asEntity, false);
	PlayPropAnimation(asEntity, "unlock_anim", 0.0f, false, "unlock_anim");
	PlaySoundAtEntity("NestDoorB4Sound", "sewer_pens_door_turn.snt", asEntity, 0.0f, false);

	AddTimer(asEntity, 1.0f, "NestDoorUnlock");
}
void NestDoorUnlock (string &in asTimer)
{
	SetSwingDoorLocked(asTimer, false, true);
	SetSwingDoorDisableAutoClose(asTimer, true);
	SetSwingDoorClosed(asTimer, false, false);
}
	
