	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}

	//PRELOAD PARTICLES//
	{
		PreloadParticleSystem("waterlurker_sewer_walk_splash.ps");
	}
	
	//WATER AREA STATUS UPDATE//	**//UPDATES WATER AREAS AFTER SAVE AND RELOAD//**
	{
		if (GetLocalVarInt("WaterArea1Moved") == 1)
		{
			SetEntityActive("WaterAreaMove1_PostSave", true);
			SetEntityActive("WaterAreaMove1", false);
		}
		if (GetLocalVarInt("WaterArea2Moved") == 1)
		{
			SetEntityActive("WaterAreaMove2_PostSave", true);
			SetEntityActive("WaterAreaMove2", false);
		}
		if (GetLocalVarInt("WaterArea3Inactive") == 1)
		{
			SetEntityActive("WaterAreaMove3", false);
		}
	}
	
	//WATER AREA ATTACHMENTS//		**//DOES INITIAL LINKING OF WATER PLANES AND AREAS//**
	{
		if (GetLocalVarInt("WaterArea1Moved") == 0)
		{
			SetPropStaticPhysics("WaterPlaneMove1", true);
			AttachAreaToProp("WaterAreaMove1", "WaterPlaneMove1", 0);
		}
		if (GetLocalVarInt("WaterArea2Moved") == 0)
		{
			SetPropStaticPhysics("WaterPlaneMove2", true);
			AttachAreaToProp("WaterAreaMove2", "WaterPlaneMove2", 0);
		}
		if (GetLocalVarInt("WaterArea3Inactive") == 0)
		{
			SetPropStaticPhysics("WaterPlaneMove3", true);
			AttachAreaToProp("WaterAreaMove3", "WaterPlaneMove3", 0);
		}
	}
	
	//SOUND STATES//
	{
		PlaySoundAtEntity("WaterLapping_1", "amb_sewer_water_loop_large.snt", "WaterLapping_1", 1.0f, true);
		PlaySoundAtEntity("WaterLapping_2", "amb_sewer_water_loop_large_02.snt", "WaterLapping_2", 1.0f, true);
		PlaySoundAtEntity("WaterLapping_3", "amb_sewer_water_loop_large.snt", "WaterLapping_3", 1.0f, true);
		PlaySoundAtEntity("WaterLapping_4", "amb_sewer_water_loop_large_02.snt", "WaterLapping_4", 1.0f, true);
		PlaySoundAtEntity("WaterLapping_5", "amb_sewer_water_loop_large_02.snt", "WaterLapping_5", 1.0f, true);
		PlaySoundAtEntity("WaterLapping_6", "amb_sewer_water_loop_large.snt", "WaterLapping_6", 1.0f, true);
	}
	
	//LIGHT STATES//
	{
		if (GetLocalVarInt("WaterArea3Inactive") == 1)
		{
			for (int lval = 1; lval < 11; lval++)
			{
				SetLightVisible("last_switch_water_reflections_"+lval, false);
			}
			for (int lval = 1; lval < 9; lval++)
			{
				SetLightVisible("last_switch_caustics_"+lval, false);
			}
		}
	}
	
	//ENEMY SETUP//
	{
		SetManPigType("Child1", "Freddy");
		SetEnemyMoveType("Child1", "RunBiped");
		SetManPigType("Child2", "Freddy");
		SetEnemyMoveType("Child2", "RunBiped");
		SetManPigType("Wretch1", "Freddy");
		SetEnemyMoveType("Wretch1", "WalkBiped");
		SetManPigType("Wretch2", "Freddy");
		SetEnemyMoveType("Wretch2", "WalkBiped");
	}
	
	//ANIMATION STATES
	{
		PlayPropAnimation("Phonautograph1", "Stop", 0.0f, true, "");							//Initialises Phonautograph to non-animated.
	}
	
	//Setup Phonoautograph Callbacks
	{
		SetEntityConnectionStateChangeCallback("Phonautograph1", "PhonautographHandler"); 			//Arguments Required: ("Name of the Phonoautograph entity", "Name of the function to call on interaction" < this will always be the same)
	}
	
	//SPRAYLOCK INITIALISATION//
	{
		//SPRAYLOCK LIGHT STATES//
		SetLampLit("spraylock_green_light", false, false);
		SetLightVisible("spraylock_spark_light", false);
		
		//SPRAYLOCK ENTITY INTERACTION// 
		SetEntityInteractionDisabled("spraylock_engines", true);
		SetEntityInteractionDisabled("spraylock_power_switch", true);
		
		//SOUND INITIALISATION//
		PlaySoundAtEntity("sl_hiss_1", "spraylock_gauge_hiss_1.snt", "spraylock_hiss_outside_1", 0.0f, true);
		
		//SPRAYLOCK PARTICLE SYSTEM STATES//
		SetParticleSystemActive("spraylock_sparks_1", false);
		SetParticleSystemActive("spraylock_sparks_2", false);
		SetParticleSystemActive("spraylock_spray1", false);
		SetParticleSystemActive("spraylock_spray2", false);
		SetParticleSystemActive("spraylock_spray3", false);
		SetParticleSystemActive("spraylock_spray4", false);
		SetParticleSystemActive("spraylock_spray5", false);
		SetParticleSystemActive("spraylock_spray6", false);
		SetParticleSystemActive("spraylock_risingmist", false);
		
		//SPRAYLOCK SPECIFIC STATES//
		PlayPropAnimation("spraylock_gauge_outside_1", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_1", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_2", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_engines", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_railing", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_electric_cabin", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_steam_gauges", "on", 0.0f, true, "");
		SetSwingDoorDisableAutoClose("spraylock_door_1", true);
		SetEntityInteractionDisabled("spraylock_door_1", true);
		SetSwingDoorClosed("spraylock_door_1", false, false);
		SetSwingDoorDisableAutoClose("spraylock_door_2", true);
		SetEntityInteractionDisabled("spraylock_door_2", true);
	}
	
	//AUTOSAVE//
	{
		AutoSave();
	}
}

	
	//END ENEMY STATES//


