void NestTimers (string &in asTimer)
{
	if (asTimer == "ChainReturn")
	{
	
	PlayPropAnimation("nest_wretch_chains", "NestChainIdle", 0.0f, true, "");	
	PlaySoundAtEntity("chain_rest", "afx_sewer_wretch_chains_sit", "nest_wretch_chains", 0.0f, false);
		return;
	}
}
//End Nest Timers//

// HINT HANDLER//
void HintHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "WaterLoweredHintTrigger")
	{
		AddHint("Sewers2", "");
		return;
	}
	else if (asChild == "NestHintTrigger")
	{
		AddHint("Sewers3", "");
	}
}
//END HINT HANDLER//

//DELAYED HINT//
void TimerDelayedHint(string &in asEntity)
{
	AddHint(asEntity, "");
}
