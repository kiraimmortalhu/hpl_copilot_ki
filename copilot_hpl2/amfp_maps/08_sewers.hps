//SLUICE GATE OPEN EVENTS//
void SluiceValveEventHandler (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		switch (GetLocalVarInt("valveactivationtracker"))
		{
			case 0:
				SetEntityActive("waterlurker_amb_1", false);
				SetEntityActive("waterlurker_amb_2", true);
				SetLampLit("Valve1Light1", true, false);
				SetLampLit("Valve2Light1", true, false);
				SetLampLit("Valve3Light1", true, false);
				SetLampLit("Valve4Light1", true, false);
				SetEntityActive("Gate1Open", true);
				SetEntityActive("Gate1Closed", false);
				SetEntityActive("Mask1", false);
				SetWheelInteractionDisablesStuck("SluiceValve1", false);
				SetWheelStuckState("SluiceValve1", -1, false);
				SetMoveObjectState("Gate1DoorA", 1);
				SetMoveObjectState("Gate1DoorB", 1);
				SetLocalVarInt("valveactivationtracker", 1);
				SetPropStaticPhysics("WaterPlaneMove1", false);
				AddTimer("Plane1Timeout", 5.0f, "WaterPlaneDeactivationHandler");
				PlaySoundAtEntity("Pump_1_Ignition", "afx_sewer_pump_engine", "Pump_1_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Heavy_Drain_1", "afx_event_sewer_heavy_drain_2D", "Player", 1.0f, false);
				PlaySoundAtEntity("Drain_1_2D", "afx_event_sewer_drain_tank_2D", "Drain_1_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Drain_1", "afx_event_sewer_drain_tank_3D", "Drain_1_SoundArea", 1.0f, false);
				StopSound("WaterLapping_1", 1.0f);
				StopSound("WaterLapping_2", 1.0f);
				StopSound("WaterLapping_3", 1.0f);
				StopSound("WaterLapping_4", 1.0f);
				StopSound("WaterLapping_5", 1.0f);
				StopSound("WaterLapping_6", 1.0f);
				AddTimer("SewerPhone", 2.0f, "SewerPhone");
				StopMusic(5.0f, 8);
				AddTimer("SmallEngineStopAnimation", 9.0f, "StopBilgeEngines");
				PlayPropAnimation("small_bilge_engine_1", "Active", 0.0f, true, "");
				AddEntityCollideCallback("Player", "SluiceGate1MusicTrigger", "MusicPlayer", true, 0);
				SetLocalVarInt("WaterArea1Moved", 1);
				AddEntityCollideCallback("Player", "gate_1_trigger", "GateHandler", true, 1);
				SetMoveObjectState("gate_2", 1);
				SetMoveObjectState("gate_4", 0);
				SetMoveObjectState("gate_3", 1);
				//SetMoveObjectState("gate_11", 1);
				SetEntityActive("pswe_*", false);
				SetEntityActive("psww_*", false);
				for(int i=1; i<=12; i++) DestroyParticleSystem("psw_"+i);
				StopSound("psws_1", 0);
				StopSound("psws_2", 0);
				StopSound("psws_3", 0);
				StopSound("psws_4", 0);
			break;
			
			case 1:
				SetEntityActive("waterlurker_amb_2", false);
				DestroyParticleSystemInstantly("PS_Water_Mist_1");
				DestroyParticleSystemInstantly("PS_Water_Mist_2");
				SetLampLit("Valve1Light2", true, false);
				SetLampLit("Valve2Light2", true, false);
				SetLampLit("Valve3Light2", true, false);
				SetLampLit("Valve4Light2", true, false);
				SetEntityActive("Gate2Open", true);
				SetEntityActive("Gate2Closed", false);
				SetWheelInteractionDisablesStuck("SluiceValve2", false);
				SetWheelStuckState("SluiceValve2", -1, false);
				SetMoveObjectState("Gate2DoorA", 1);
				SetMoveObjectState("Gate2DoorB", 1);
				SetLocalVarInt("valveactivationtracker", 2);
				SetPropStaticPhysics("WaterPlaneMove2", false);
				AddTimer("Plane2Timeout", 5.0f, "WaterPlaneDeactivationHandler");
				StopSound("WaterLapping2_1", 1.0f);
				StopSound("WaterLapping2_2", 1.0f); 
				AddTimer("SmallEngineStopAnimation", 9.0f, "StopBilgeEngines");
				PlayPropAnimation("small_bilge_engine_2", "Active", 0.0f, true, "");
				PlaySoundAtEntity("Pump_1_Ignition", "afx_sewer_pump_engine", "Pump_2_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Heavy_Drain_1", "afx_event_sewer_heavy_drain_2D", "Player", 1.0f, false);
				PlaySoundAtEntity("Drain_1_2D", "afx_event_sewer_drain_tank_2D", "Drain_2_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Drain_1", "afx_event_sewer_drain_tank_3D", "Drain_2_SoundArea", 1.0f, false);
				SetLocalVarInt("WaterArea2Moved", 1);
				SetMoveObjectState("gate_7", 1);
				SetMoveObjectState("gate_8", 1);
				SetMoveObjectState("gate_9", 1);
				SetMoveObjectState("gate_11", 0);
				AddEntityCollideCallback("Player", "WaterLoweredHintTrigger", "HintHandler", true, 1);
				SetLampLit("torch_static01_NC_cellar_10", false, false);
			break;
			
			case 2:
				SetLampLit("Valve1Light3", true, false);
				SetLampLit("Valve2Light3", true, false);
				SetLampLit("Valve3Light3", true, false);
				SetLampLit("Valve4Light3", true, false);
				SetMoveObjectState("gate_9", 0.0f);
				SetMoveObjectState("gate_10", 1.0f);
				SetEntityActive("Gate3Open", true);
				SetEntityActive("Gate3Closed", false);
				SetWheelInteractionDisablesStuck("SluiceValve3", false);
				SetWheelStuckState("SluiceValve3", -1, false);
				SetSwingDoorLocked("Gate3DoorA", false, false);
				SetSwingDoorLocked("Gate3DoorB", false, false);
				SetLocalVarInt("valveactivationtracker", 3);
				SetEntityActive("WaterPlaneMoveDeactivate", false);
				StopSound("WaterLapping3_1", 1.0f); 
				StopSound("WaterLapping3_2", 1.0f); 
				AddTimer("SmallEngineStopAnimation", 9.0f, "StopBilgeEngines");
				PlayPropAnimation("small_bilge_engine_3", "Active", 0.0f, true, "");
				PlaySoundAtEntity("Pump_1_Ignition", "afx_sewer_pump_engine", "Pump_3_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Heavy_Drain_1", "afx_event_sewer_heavy_drain_2D", "Player", 1.0f, false);
				PlaySoundAtEntity("Drain_1_2D", "afx_event_sewer_drain_tank_2D", "Drain_3_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Drain_1", "afx_event_sewer_drain_tank_3D", "Drain_3_SoundArea", 1.0f, false);
				SetLocalVarInt("WaterArea3Inactive", 1);
				SetMoveObjectState("gate_10", 1);
				SetMoveObjectState("gate_9", 0);
			break;
			
			case 3:
				AddEntityCollideCallback("Player", "VOSpraylockTrigger", "VOPlayer", true, 1);
				SetWheelInteractionDisablesStuck("BilgeValve", false);
				SetWheelStuckState("BilgeValve", -1, false);
				SetLocalVarInt("valveactivationtracker", 4);
				PlayPropAnimation("small_bilge_engine_4", "Active", 0.0f, true, "");
				AddTimer("SmallEngineStopAnimation", 9.0f, "StopBilgeEngines");
				PlaySoundAtEntity("Pump_1_Ignition", "afx_sewer_pump_engine", "Pump_4_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Heavy_Drain_1", "afx_event_sewer_heavy_drain_2D", "Player", 1.0f, false);
				PlaySoundAtEntity("Drain_1_2D", "afx_event_sewer_drain_tank_2D", "Drain_4_SoundArea", 1.0f, false);
				PlaySoundAtEntity("Drain_1", "afx_event_sewer_drain_tank_3D", "Drain_4_SoundArea", 1.0f, false);
				SetPropStaticPhysics("WaterPlaneMove3", false);
				AddTimer("Plane3Timeout", 5.0f, "WaterPlaneDeactivationHandler");
				SetLocalVarInt("WaterArea3Inactive", 1);
				for (int lval = 1; lval < 11; lval++)
				{
					SetLightVisible("last_switch_water_reflections_"+lval, false);
				}
				for (int lval = 1; lval < 9; lval++)
				{
					SetLightVisible("last_switch_caustics_"+lval, false);
				}
				AddTimer("Plane4Timeout", 2.0f, "WaterPlaneDeactivationHandler");
			break;
			
			default:
				AddDebugMessage("Sluice valve activation variable out of range!", true);
				break;
		}
	}
}
//END SLUICE GATE OPEN EVENTS//	

//WATER PLANE DEACTIVATION HANDLER//
void WaterPlaneDeactivationHandler (string &in asTimer)
{
	if (asTimer == "Plane1Timeout")
	{
		SetEntityActive("WaterPlaneMove1", false);
		MusicPlayer("Player", "SluiceAmbientThreatTrigger", 1);
		return;
	}
	else if (asTimer == "Plane2Timeout")
	{
		SetEntityActive("WaterPlaneMove2", false);
		return;
	}
	else if (asTimer == "Plane3Timeout")
	{
		SetEntityActive("WaterPlaneMove3", false);
		SetEntityActive("WaterAreaMove3", false);
		return;
	}
}
//END WATER PLANE DEACTIVATION HANDLER//	

//SMALL BILGE ENGINE STOP ANIMATION//
void StopBilgeEngines (string &in asTimer)
{
	SetLocalVarInt("BilgeEngineAnimationWindow", 0);
	StopPropAnimation("small_bilge_engine_1");
	StopPropAnimation("small_bilge_engine_2");
	StopPropAnimation("small_bilge_engine_3");
	StopPropAnimation("small_bilge_engine_4");
}

//TUNNELS SOUND HANDLER//
void TunnelsSoundHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "BackTunnelWaterStartSound_1" || asChild == "BackTunnelWaterStartSound_2")
	{
		PlaySoundAtEntity("TunnelsWater_1", "amb_sewers_water_particle_tunnel_01_3D.snt", "TunnelsWaterSource_1", 2.0f, true);
		PlaySoundAtEntity("TunnelsWater_2", "amb_sewers_water_particle_tunnel_02_3D.snt", "TunnelsWaterSource_2", 2.0f, true);	
		PlaySoundAtEntity("TunnelsWater_3", "amb_sewers_water_particle_tunnel_03_3D.snt", "TunnelsWaterSource_3", 2.0f, true);	
		PlaySoundAtEntity("TunnelsWater_2D", "amb_sewers_water_particle_tunnel_2D_close.snt", "TunnelsWaterSource_2", 2.0f, true);		
		RemoveEntityCollideCallback("Player", "BackTunnelWaterStartSound_1");
		RemoveEntityCollideCallback("Player", "BackTunnelWaterStartSound_2");
		AddEntityCollideCallback("Player", "BackTunnelWaterStopSound_1", "TunnelsSoundHandler", true, 1);
		AddEntityCollideCallback("Player", "BackTunnelWaterStopSound_2", "TunnelsSoundHandler", true, 1);
		AddDebugMessage("Tunnels Start Sound", false);
		return;
	}
	
	else if (asChild == "BackTunnelWaterStopSound_1" || asChild == "BackTunnelWaterStopSound_2")
	{
		StopSound("TunnelsWater_1", 2.0f);
		StopSound("TunnelsWater_2", 2.0f);
		StopSound("TunnelsWater_3", 2.0f);
		StopSound("TunnelsWater_2D", 2.0f);
		RemoveEntityCollideCallback("Player", "BackTunnelWaterStopSound_1");
		RemoveEntityCollideCallback("Player", "BackTunnelWaterStopSound_2");
		AddEntityCollideCallback("Player", "BackTunnelWaterStartSound_1", "TunnelsSoundHandler", true, 1);
		AddEntityCollideCallback("Player", "BackTunnelWaterStartSound_2", "TunnelsSoundHandler", true, 1);
		SetMoveObjectState("gate_5", 0.0f);
		AddDebugMessage("Tunnels Stop Sound", false);
		return;
	}
}
//END TUNNELS SOUND HANDLER//

//SLUICE DOOR HANDLER//
void SluiceDoorHandler (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		//GET DOOR NAME//
		string sCurrentDoorName = StringSub(asEntity, 0, 10);
		AddDebugMessage("Door Name = "+sCurrentDoorName, false);
		SetLocalVarString ("CurrentDoorName", sCurrentDoorName);
		
		//PERFORM DOOR ACTIONS//
		AddTimer("Gate1DoorAValve1Unlock", 2.5f, "GateDoorUnlocks");
		PlaySoundAtEntity("", "sewer_metal_door_mechanism_animation_3D.snt", sCurrentDoorName, 0.0f, false);
		PlaySoundAtEntity("", "sewer_metal_door_mechanism_animation_2D.snt", sCurrentDoorName, 0.0f, false);
		PlayPropAnimation(sCurrentDoorName, "unlock_anim", 0.0f, false, "");
	}
}

void GateDoorUnlocks (string &in asTimer)
{
	//REASSIGN CURRENT DOOR NAME//
	string sCurrentDoorName = GetLocalVarString("CurrentDoorName");
	AddDebugMessage("Timer Door Name = "+sCurrentDoorName, false);
	
	//PERFORM DOOR ACTIONS//
	SetSwingDoorLocked(sCurrentDoorName, false, false);
	SetEntityInteractionDisabled(sCurrentDoorName, false);
	SetWheelInteractionDisablesStuck(sCurrentDoorName+"Valve1", false);
	SetWheelInteractionDisablesStuck(sCurrentDoorName+"Valve2", false);
	SetLocalVarInt(sCurrentDoorName+"Unlocked", 1);
}
//END DOOR HANDLER//

//HIDING SPOT HANDLERSS//
void HidingSpotHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetEnemyDisableTriggers("Wretch2", true);
		return;
	}
	else if (alState == -1)
	{
		SetEnemyDisableTriggers("Wretch2", false);
		return;
	}
}
//END HIDING SPOTS//

