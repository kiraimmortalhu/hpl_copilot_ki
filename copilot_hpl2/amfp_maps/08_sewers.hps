		SetLampLit("sewer_wall_lamp_23", true, false);
		SetLampLit("sewer_wall_lamp_24", true, false);
	}
	
void WretchWalkOn(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("nest_wretch_feeding_1", true);
	SetEntityActive("nest_wretch_feeding_2", true);
	
	AddDebugMessage("Wretch_Walk_On", false);
	SetEntityActive("wretch_meet_start", true);
	AddEnemyPatrolNode("wretch_meet_start", "PathNodeArea_Meet_7", 0.0f, "", false);
	AddEnemyPatrolNode("wretch_meet_start", "PathNodeArea_Meet_8", 0.0f, "", false);
	AddTimer("EngineerWalkOn", 1.33f, "EngineerWalkOn");
	AddTimer("NestMeetLightFlickOff", 10.01f, "NestMeetLightFlickOff");
	AddTimer("NestMeetLightFlickOff", 11.6f, "NestMeetLightFlickOff");
	AddTimer("NestMeetLightFlickOff", 32.01f, "NestMeetLightFlickOff");
	AddTimer("NestMeetLightFlickOff", 35.31f, "NestMeetLightFlickOff");
	AddTimer("NestMeetLightFlickOff", 41.0f, "NestMeetLightFlickOff");
}

void EngineerWalkOn (string &in asTimer)
	{
	AddDebugMessage("Eng_Walk_On", false);
	SetEntityActive("engineer_meet_start", true);
	//AddEnemyPatrolNode("engineer_meet_start", "PathNodeArea_Meet_1", 0.0f, "", false);
	AddEnemyPatrolNode("engineer_meet_start", "PathNodeArea_Meet_2", 0.0f, "", false);
	AddEnemyPatrolNode("engineer_meet_start", "PathNodeArea_Meet_3", 0.0f, "", false);
	AddEnemyPatrolNode("engineer_meet_start", "PathNodeArea_Meet_4", 0.0f, "", false);
	}

void NestMeetScene(string &in asParent, string &in asChild, int alState)
{
	AddTimer("NestMeetLightFlickOff", 0.01f, "NestMeetLightFlickOff");
	AddDebugMessage("Meet scene", false);
	SetEntityActive("engineer_meet_actor", true);
	SetEntityActive("engineer_meet_start", false);
	SetEntityActive("wretch_meet_start", false);
	SetEntityActive("wretch_meet_actor", true);
	PlayPropAnimation("engineer_meet_actor", "EngineerWretchSlap", 0.01f, false, "EngineerWalkOff");
	PlayPropAnimation("wretch_meet_actor", "EngineerWretchSlap", 0.01f, false, "");
	PlaySoundAtEntity("big_slap", "afx_sewer_wretch_slap", "engineer_meet_actor", 0.0f, false);
}

void EngineerWalkOff(string &in asProp)
{
	AddTimer("NestMeetLightFlickOff", 0.01f, "NestMeetLightFlickOff");
	AddDebugMessage("Eng_Walk_Off", false);
	SetEntityActive("engineer_meet_end", true);
	SetEntityActive("engineer_meet_actor", false);
	SetEntityActive("wretch_meet_end", true);
	SetEntityActive("wretch_meet_actor", false);
	AddEnemyPatrolNode("engineer_meet_end", "PathNodeArea_Meet_5", 0.0f, "", false);
	AddEnemyPatrolNode("engineer_meet_end", "PathNodeArea_Meet_34", 0.0f, "", false);
	AddEnemyPatrolNode("wretch_meet_end", "PathNodeArea_Meet_9", 0.0f, "", false);
	AddEnemyPatrolNode("wretch_meet_end", "PathNodeArea_Meet_10", 0.0f, "", false);
	AddEnemyPatrolNode("wretch_meet_end", "PathNodeArea_Meet_11", 0.0f, "", false);
}

void CollideRemoveEngineer(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("engineer_meet_end", false);
}

//End Nest Meet Handler//


