void OnStart()
{	
	//Map Preamble
	{
		SetMapDisplayNameEntry("Sewers");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	bool bDoIntro = true;
	//Debugging
		if(ScriptDebugOn()) 
		{
			GiveItemFromFile("lantern", "lantern.ent");
			bDoIntro = false;
		}
		
	// Setup Local Variables
		{
			SetLocalVarInt("valveactivationtracker", 0);
			SetLocalVarInt("WaterArea1Moved", 0);
			SetLocalVarInt("WaterArea2Moved", 0);
			SetLocalVarInt("WaterArea3Inactive", 0);
			SetLocalVarString ("CurrentDoorName", "Void");
			SetLocalVarInt("Gate1DoorAUnlocked", 0);
			SetLocalVarInt("Gate1DoorBUnlocked", 0);
			SetLocalVarInt("Gate2DoorAUnlocked", 0);
			SetLocalVarInt("Gate2DoorBUnlocked", 0);
			SetLocalVarInt("Gate3DoorAUnlocked", 0);
			SetLocalVarInt("Gate3DoorBUnlocked", 0);
			SetLocalVarInt("spraylocksequenced", 0);
			SetLocalVarInt("WritePig_Notices", 0); //1=notices you
		}
		
	//AutoRun Event Timers
		if(bDoIntro){	
			FadeOut(0.0f);
			SetPlayerActive(false);
			SetPlayerCrouching(true);
			SetPlayerJumpDisabled(true);
			SetPlayerCrouchDisabled(true);
			SetPlayerLookSpeedMul(0.3);
			SetPlayerMoveSpeedMul(0.2);
			SetLanternDisabled(true);
			ShowPlayerCrossHairIcons(false);
			FadePlayerRollTo(30.0f, 50.0f, 50.0f);
			PlaySoundAtEntity("Sewer_Intro", "afx_sewer_intro.snt", "Player", 0.0f, true);
			PlaySoundAtEntity("Sewer_Intro_VO", "afx_sewer_intro_vo.snt", "Player", 0.0f, true);
			AddTimer("StartFX", 5.6f, "InitSequence");
		}
		
	//Setup Initial Entity Callbacks
		{
			//COLLISION CALLBACKS//
			
			AddEntityCollideCallback("Player", "BackTunnelWaterStartSound_1", "TunnelsSoundHandler", true, 1);
			AddEntityCollideCallback("Player", "BackTunnelWaterStartSound_2", "TunnelsSoundHandler", true, 1);
			AddEntityCollideCallback("Player", "Child1Trigger", "Child1Handler", true, 1);
			AddEntityCollideCallback("Child1", "Child1KillTrigger", "Child1Handler", true, 1);
			AddEntityCollideCallback("Player", "Child2Trigger", "Child2Handler", true, 1);
			AddEntityCollideCallback("Child2", "Child2KillTrigger", "Child2Handler", true, 1);
			AddEntityCollideCallback("Player", "Gate7and8Trigger", "Gate7and8Handler", true, 1);
			AddEntityCollideCallback("Player", "Wretch1Trigger", "Wretch1Handler", true, 1);
			AddEntityCollideCallback("wretch1", "Wretch1KillTrigger", "Wretch1Handler", false, 1);
			AddEntityCollideCallback("Player", "Wretch2Trigger", "Wretch2Handler", true, 1);
			AddEntityCollideCallback("wretch2", "Wretch2KillTrigger", "Wretch2Handler", false, 1);
			AddEntityCollideCallback("Player", "Wretch3StartTrigger", "Wretch3Handler", true, 1);
			AddEntityCollideCallback("wretch3", "Wretch3KillTrigger", "Wretch3Handler", false, 1);
			AddEntityCollideCallback("Player", "Wretch2HideArea", "HidingSpotHandler", false, 0);
			AddEntityCollideCallback("Player", "NestChainsTrigger", "NestWretchHandler", false, 0);
			AddEntityCollideCallback("Player", "NestWritingTrigger", "NestWritingHandler", false, 0);
			AddEntityCollideCallback("Player", "NestWritingViewTrigger", "WriterProximityCheck", false, 0);
