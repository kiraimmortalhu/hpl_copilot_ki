//PIPE EVENTS HANDLER//
//At triggers, a mix of metal groans, shudders and occasional steam vents//
void PipeHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "PipeEvent_1")
	{
		SetSwingDoorLocked("Gate2DoorB_29", true, false);
		SetEntityActive("nest_wretch_sleeping", false);
		SetEntityActive("nest_wretch_sob", false);
		SetEntityActive("nest_wretch_chains", false);
		SetEntityActive("nest_wretch_writing", false);
		SetEntityActive("nest_wretch_play", false);
		SetEntityActive("pig_blocks_1", false);
		SetEntityActive("waterlurker_1", false);
		
	PlaySoundAtEntity("", "afx_sewer_pipetremor_01", "Player", 0.0f, false);
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	}
	else if (asChild == "PipeEvent_2")
	{
	PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	}
	else if (asChild == "PipeEvent_3")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	PlaySoundAtEntity("", "afx_sewer_pipetremor_02", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	}
	else if (asChild == "PipeEvent_4")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	}
	else if (asChild == "PipeEvent_5")
	{
	PlaySoundAtEntity("", "afx_sewer_pipetremor_03", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	}
	else if (asChild == "PipeEvent_6")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	}
	else if (asChild == "PipeEvent_7")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	PlaySoundAtEntity("", "afx_sewer_pipetremor_04", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	}
	else if (asChild == "PipeEvent_8")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	PlaySoundAtEntity("", "afx_sewer_pipetremor_02", "Player", 0.0f, false);
	StartScreenShake(0.025f, 2.5f, 3.0f, 3.0f);
	}
	else if (asChild == "PipeEvent_9")
	{
	//PlaySoundAtEntity("", "afx_spooky_env_metal", "Player", 0.0f, false);	
	}
}

//END PIPE EVENTS HANDLER//

void CollideStartFlicker(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch3", true);
	
	StartLampFlicker("torch_static01_NC_cellar_10");
	
	AddEntityCollideCallback("Player", "AreaFakeLurkStart_4", "EnterFakeLurkStart4", true, 1);
}