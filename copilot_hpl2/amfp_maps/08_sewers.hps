//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState) //Callback function for all ambience areas in map
{
	if (asChild == "AMBAreaTight1")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("tight1", "amb_sewer_tight", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("tight1", 1.0f);
			return;
		}
	}
//BREAK//
	else if (asChild == "AMBAreaStart")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("AMBAreaStart", "amb_sewer_tight", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("AMBAreaStart", 1.0f);
			return;
		}
	}	
//BREAK//
	else if (asChild == "AMBTightFiller_1")
	{
		if (alState == 1)
