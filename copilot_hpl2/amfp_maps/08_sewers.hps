//----------------------------
// WATER LURKER ENCOUNTER
//----------------------------

//-------------------------------------------

void EnterStartWaterLurk(string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("LurkerState")==2) return;
	
	if(GetLocalVarInt("LurkerState")==0)	LanternFlicker(3.5);
	else if(RandInt(1,2)==1)				LanternFlicker(RandFloat(2, 3.5f));
	
	SetLocalVarInt("LurkerState", 2);
		
	SetEntityActive("waterlurker_1", true);
	SetEntityActive("waterlurker_amb_3", false);
	
	StartLampFlickerBurst("cellar_gaslamp01_long_small_point_light_5", RandFloat(2,5));
	StartLampFlickerBurst("cellar_gaslamp01_long_small_point_light_4", RandFloat(2,5));
	
	CheckPoint("CheckPointLurker", "CheckPointLurker", "CheckPointLurker", "", "", false);
}

void EnterStopWaterLurk(string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("LurkerState")!=2) return;
	
	SetLocalVarInt("LurkerState", 1);

	SetEntityActive("waterlurker_1", false);
	TeleportEnemyToNode("waterlurker_1", "PathNodeArea_7"+RandInt(1,9), false);
	
	SetEntityActive("waterlurker_amb_3", true);
}

//-------------------------------------------

void CheckpointBottom(string &in asName, int alCount)
{
	TeleportEnemyToNode("waterlurker_1", "PathNodeArea_7"+RandInt(1,9), false);
	SetEntityActive("waterlurker_1", true);
}
