//END AMBIENT SOUNDTRACK PLAYER//

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "SewerStartMusicTrigger")
	{
		PlayMusic("music_sewer_ambient_threat.ogg", false, 0.75f, 0.0f, 0, false);
		AddTimer("InitRandomMonsterSoundCuePlayer", 10.0f, "RandMonsterSoundCues");
		AddTimer("InitRandomMonster2SoundCuePlayer", 20.0f, "RandMonster2SoundCues");
	}
	else if (asChild == "SluiceGate1MusicTrigger")
	{
		PlayMusic("music_sewers_sluice1.ogg", false, 0.8f, 0.0f, 1, false);
		return;
	}
	else if (asChild == "Ambient2MusicTrigger")
	{
		PlayMusic("music_sewer_ambient_02.ogg", false, 0.9f, 0.0f, 1, false);
		return;
	}
	else if (asChild == "music_nest_area_trigger")
	{
		SetLocalVarInt("PlayerInNest", 1);
		AddDebugMessage("nest music triggered", false);
		PlaySoundAtEntity("nestmusic", "nest_music", "nest_area_music_source", 0.0f, true);
		AddTimer("InitRandSound_PigNestOpen", 2.5f, "RandSound_PigNestOpen");
		AddTimer("InitRandSound_PrisonArea1", 9.0f, "RandSound_PrisonArea1");
		AddTimer("InitRandSound_PrisonArea2", 7.0f, "RandSound_PrisonArea2");
		PlaySoundAtEntity("pigseating", "afx_pigline_pig_eat_body", "nest_pig_noises_2", 1.0f, true);
		//SET CHECKPOINT #2//
		CheckPoint("CP02_Nest", "CheckpointStart_1", "", "", "", false);
		
		//REMOVE RANDOM SOUND TIMERS//
		RemoveTimer("InitRandomMonsterSoundCuePlayer");
		RemoveTimer("InitRandomMonster2SoundCuePlayer");
		RemoveTimer("InitRandomMonsterSoundCuePlayer");
		RemoveTimer("InitRandomMonster2SoundCuePlayer");
		for (int i = 1; i <= 33; i++)
		{
			RemoveTimer("SewerDripArea_" + i);
		}
		RemoveTimer("RandDripSoundCues");
		RemoveTimer("RandDripSound2Cues");
