void Scene_31_Start(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("Scene31_NoEndPiggy", 0);
	AddTimer("Scene31Chase", 2, "Scene_31_Chase");
	SetEnemyDeaf("engineer_1_scene_31", false);
	SetEnemyBlind("engineer_1_scene_31", false);
	PlayEnemyAnimation("engineer_1_scene_31", "ThreatLoopBiped", false, 1);
}

void Scene_31_Chase(string &in asTimer)
{
	ChangeEnemyPose("engineer_1_scene_31", "Quadruped");
	
	ShowEnemyPlayerPosition("engineer_1_scene_31");
	
	AddTimer("Scene31Chase", 0.5f, "Scene_31_Chase");
}

//--------------------------------------------------

void Scene_31_End(string &in asParent, string &in asChild, int alState)
{
	RemoveTimer("Scene31Chase");

	AddDebugMessage("Scene_31 End", false);

	CheckPoint ("Checkpoint_AfterChase", "Checkpoint_AfterChase", "Checkpoint_AfterChase", "", "", false);
	
	SetMoveObjectStateExt("EndGate", 0, 100, 4, 0.1, true);
	PlaySoundAtEntity("slammadamma", "afx_event_factory_gate_close.snt", "EndGate", 0, false);
	
	if(GetLocalVarInt("Scene31_PlayerDied")==0)
	{
		if(GetPlayerHealth()<30) SetPlayerHealth(30);
		Scene_31_Awaken("");
	}
}

void Scene_31_Awaken(string &in asTimer)
{
	AddLocalVarInt("Scene31",1);
	int lX = GetLocalVarInt("Scene31");
	
	AddDebugMessage("Scene 31 Awake Count: "+lX, false);
	
	float fTime = -1;
	
	if(lX==1)
	{
		SetPlayerMoveSpeedMul(0.25);
		SetPlayerRunSpeedMul(0);
		SetPlayerLookSpeedMul(0.1);

		SetPlayerCrouchDisabled(true);
		SetPlayerCrouching(true);
		
		//SetEntityActive("engineer_1_scene_31", false);
		StartScreenShake(0.5, 1, 0.1, 1);
		
		SetLanternActive(false, true);
	
		MovePlayerHeadPos(0,-0.5, 0, 5, 0.05);
		FadePlayerRollTo(30.5f, 50, 80);
		
		AddPlayerBodyForce(0,0,1000, false);
		
		PlaySoundAtEntity("tripup", "afx_streets_tripup.snt", "Player", 0.0f, false);
		
		AddTimer("Streets2", 9.f, "HintTimer");
		
		fTime = 0.5f;
	}
	else if(lX==2)
	{
		FadeGlobalSoundVolume(0.3, 0.75);
		FadeOut(0.5);
		fTime = 0.5f;
	}
	else if(lX==3)
	{
		SetEntityActive("engineer_1_scene_31", false);
		
		SetEntityActive("Engineer_2_Scene_31", true);
		AddEntityCollideCallback("Engineer_2_Scene_31", "Scene_31_KillPig", "Scene_31_KillPig", true, 1);
		
		StartLampFlicker("streetlight_ground_fog_39");
		
		fTime  = 0.5f;
	}
	else if(lX==4)
	{
		FadeImageTrailTo(1.2f, 10);
		
		if (GetLocalVarInt("Scene31_NoEndPiggy") == 0)
		{
			PlaySoundAtEntity("rise", "afx_streets_rise.snt", "Engineer_2_Scene_31", 0.0f, false);
		}
		
		MandusReactionPlayer("Breath", 0.0f);
	
		FadeIn(3);
		MovePlayerHeadPos(0,0, 0, 1, 0.1);
		FadePlayerRollTo(0, 10, 8);
		
		fTime = 1.5f;
	}
	else if(lX==5)
	{
		fTime = 0.5f;
	}
	else if(lX==6)
	{
		SetPlayerLookSpeedMul(0.3);
		SetPlayerMoveSpeedMul(0.35);
		
		FadeGlobalSoundVolume(0.7, 2);
				
		StartPlayerLookAt("Scene_31_LookAt", 1.5, 0.5, "");
		SetPlayerCrouching(false);
		SetPlayerCrouchDisabled(false);
		fTime = 3;
	}
	else if(lX==7)
	{
		FadeGlobalSoundVolume(1.0, 3);
	
		SetPlayerMoveSpeedMul(1);
		SetPlayerRunSpeedMul(1);
		SetPlayerLookSpeedMul(1);
		FadeImageTrailTo(0, 0.3f);
		StopPlayerLookAt();
		
		fTime = 0.25f;
		
		if (GetLocalVarInt("Scene31_NoEndPiggy") == 1) return;
	}
	else if(lX==8)
	{
		ChangeEnemyPose("Engineer_2_Scene_31", "Biped");
		fTime = 1.0f;
	}
	else if(lX==9)
	{
		AddEnemyPatrolNode("Engineer_2_Scene_31", "PathNodeArea_199", 0, "", false);
		fTime = 2;
	}
	else if(lX==10)
	{
		StopLampFlicker("streetlight_ground_fog_39");
	}
		
		
	
	if(fTime>=0) AddTimer("Scene31", fTime, "Scene_31_Awaken");
}

//------------------------------

void Scene_31_KillPig(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("Engineer_2_Scene_31", false);
}

//------------------------------

void Checkpoint_AfterChase(string &in asName, int alCount)
{
	MovePlayerHeadPos(0,-0.5, 0, 50, 0.05);
	FadePlayerRollTo(30.5f, 100, 160);
	SetLanternActive(false, true);
	SetPlayerMoveSpeedMul(0.25);
	SetPlayerRunSpeedMul(0);
	SetPlayerLookSpeedMul(0.1);
	SetPlayerCrouchDisabled(true);
	SetPlayerCrouching(true);
		
	RemoveTimer("Scene31");
	SetLocalVarInt("Scene31", 3);
	SetLocalVarInt("Scene31_NoEndPiggy", 1);
	if(GetLocalVarInt("Scene31_PlayerDied")==0)
	{
		AddTimer("Scene31", 1, "Scene_31_Awaken");
	}
}

