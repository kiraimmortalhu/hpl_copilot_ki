void Scene_20 (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Scene_20", false);
	AddTimer("PigScratchSound", RandFloat(0.1f, 0.7f), "PigScratchSound");
	
	//Activate scene 4, so it does not start too early.
	SetEntityPlayerLookAtCallback("Scene_4_Trigger", "Scene_4_PlayerLookAt", true);
	
	 //Disable the scene behind the fence that should already been seen.
	SetEntityActive("Scene_15_Trigger", false);
	SetEntityActive("wretch_actor_scene_15", false);
	SetEntityActive("gent_actor_scene_15", false);
}

void PigScratchSound (string &in asTimer)
{
	SetEntityPlayerInteractCallback("Scene_20_Door", "Scene_20_SlamEvent", true);	
}

