void Scene_4_Killer(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive(asParent, false);
}

void Scene_4_Timer (string &in asTimer)
	{
		string x = asTimer;
		if (x == "S4_Part2") 
		{
			SetEntityActive("Engineer_1_Scene4", true);
			PlaySoundAtEntity("Scene1PigVoice", "afx_streets_pig_call", "Scene_4_SoundSource", 0.0f, false);
			AddEnemyPatrolNode("Engineer_1_Scene4", "PathNodeArea_395", 0.0f, "", false);
		} 
		else if (x == "S4_Part3") 
		{
			SetEntityActive("Wretch_2_Scene4", true);
			AddEnemyPatrolNode("Wretch_2_Scene4", "PathNodeArea_395", 0.0f, "", false);
		} 
	}
	
//-----------------------------------
	
//This also makes sure that the lplayer does not trigger scene 4 too late!
void Scene_4a_Trigger(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("Scene_4_Trigger", false);
	
	StartLampFlickerBurst("streetlight_ground_8", 4);
	LanternFlicker(3);
	
	SetEntityActive("engineer_actor_scene_4", false);
	SetEntityActive("gent_actor_scene_4", false);
	
	AddEntityCollideCallback("Engineer_2_Scene4", "Scene_4_Killer", "Scene_4_Killer", true, 1);
	
	//SetEntityActive("Scene_4_Door", true); //blocks player path back!
	SetSwingDoorLocked("Scene_4_Door", true, true);
	
	SetEntityActive("Engineer_2_Scene4", true);
	PlaySoundAtEntity("Scene1PigVoice", "afx_streets_pig_call", "Scene_4_SoundSource", 0.0f, false);
