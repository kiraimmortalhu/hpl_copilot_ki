//CAGE MOVE EVENT AND TONGUES//
void CageMoveEvent1 (string &in asParent, string &in asChild, int alState)
{
	float fExtraShakeTime = RandFloat(0.5f,0.75f);
	AddTimer("CageMoveEvent_Timer", 0.5f+fExtraShakeTime, "CageMoveEvent_Timer");
	AddDebugMessage("Cage Shake Timer Begin and Tongues Timer Begin", false);
}

void CageMoveEvent_Timer (string &in asTimer)
{
	AddPropForce("CageScare_1", -1000.0f, 900.0f, 500.0f, "world");
	PlaySoundAtEntity("CageShake", "afx_streets_cage.snt", "CageScare_1", 0.0f, false);
	AddTimer("CageShakeTimer1", 0.5f, "CageShake");
	AddTimer("CageShakeTimer2", 1.1f, "CageShake");
	MandusReactionPlayer("Quick", 0.5f);
	MandusReactionPlayer("Breath", 4.5f);
	AddDebugMessage("aww poor lil guy", false);
}

void CageShake (string &in asTimer)
{
	if (asTimer == "CageShakeTimer1")
	{
		AddPropForce("CageScare_1", 1200, 1100, -200, "world");
		PlaySoundAtEntity("CageShake", "ENTERNAME.snt", "CageScare_1", 0, false);
		return;
	}
	else if (asTimer == "CageShakeTimer2")
	{
		AddPropForce("CageScare_1", -700, 700, -700, "world");
		PlaySoundAtEntity("CageShake", "ENTERNAME.snt", "CageScare_1", 0, false);
		return;
	}
}

