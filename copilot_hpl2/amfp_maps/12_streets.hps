//SCENE_31 - PIG CHASE THROUGH ALLEY//
//-----------------

//--------------------------------------------------

void CollideTrapPlayerInAlley(string &in asParent, string &in asChild, int alState)
{
	SetPlayerRunSpeedMul(0.5);
	SetPropStaticPhysics("wooden_cart_13", false);
	SetPropStaticPhysics("storage_box_wood02_open_coal_3", false);
	PlaySoundAtEntity("racket", "afx_tunnels_wood_creak_street.snt", "wooden_cart_13", 0, false);
	PlaySoundAtEntity("piggy", "engineer_amb_alert_street.snt", "wooden_cart_13", 0, false);
	SetEntityActive("myblock_1", true);
	SetEntityActive("myblock_2", true);
	AddTimer("push", 0, "TmerPushStuffInACoolWayButFunky");
	AddTimer("impact", 1.45, "TmerPushStuffInACoolWayButFunky");
	AddTimer("impact", 2.5, "TmerPushStuffInACoolWayButFunky");
	AddTimer("pushstop", 6, "TmerPushStuffInACoolWayButFunky");	
}

//--------------------------------------------------

void TmerPushStuffInACoolWayButFunky(string &in asTimer)
{
	
	if(asTimer == "impact")
	{
		PlaySoundAtEntity("racket", "afx_tunnels_wood_creak_street.snt", "wooden_cart_13", 1, false);
		PlaySoundAtEntity("racket", "afx_gameplay_break_wood_thick_wide.snt", "wooden_cart_13", RandFloat(0.1,0.2), false);
		AddDebugMessage("Noise Hit!", false);
		return;
	}
	
	if(asTimer == "pushstop")
	{
		AddDebugMessage("Stop!", false);
		
		SetPlayerRunSpeedMul(1);
		SetPropStaticPhysics("wooden_cart_13", true);
		SetPropStaticPhysics("storage_box_wood02_open_coal_3", true);
		RemoveTimer("push");
		return;
	}
	
	AddDebugMessage("PusH!", false);
	
	AddPropForce("wooden_cart_13", 500,300,-1500, "world");
	AddPropForce("storage_box_wood02_open_coal_3", 250,250,-500, "world");
	
	AddTimer("push", 0.1, "TmerPushStuffInACoolWayButFunky");
}

