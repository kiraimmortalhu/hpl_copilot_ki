//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "mandus_VO_1")
	{
		AddEffectVoice("vo_streets_1_mandus.ogg", "", "Voice", "vo_streets_1_mandus", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "machine_mandus_VO_2")
	{
		AddEffectVoice2("vo_streets_2_machine_mandus.ogg", "", "Voice", "vo_streets_2_machine_mandus_machine_1", 0.0f, "vo_streets_2_machine_mandus_mandus_1", 8.0f, false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "machine_VO_3")
	{
		AddEffectVoice5("vo_streets_3_machine.ogg", "", "Voice", "vo_streets_3_machine", 0.0f, "vo_streets_3_machine_1", 7.7f, "vo_streets_3_machine_2", 12.0f, "vo_streets_3_machine_3", 19.65f, "vo_streets_3_machine_4", 26.3f, false, "", 0.0f, 0.0f);
		
		SetEntityActive("Scene_VO3_Corpse", true);
		AddBodyImpulse("SScene_VO3_Corpse_body_head", 0, -5, 0, "World");
		AddBodyImpulse("Scene_VO3_Corpse_body_thigh_R", 0, -15, 0, "World");
		AddBodyImpulse("Scene_VO3_Corpse_body_forearm_R", 0, -17.5f, 0, "World");
		AddBodyImpulse("Scene_VO3_Corpse_body_thigh_L", 0, 5, 0, "World");
		
		AddTimer("Streets1", 40.f, "HintTimer");
		
		return;
	}
	else if (asChild == "machine_VO_4")
	{
		AddEffectVoice("vo_streets_4_machine.ogg", "", "Voice", "vo_streets_4_machine", false, "", 0.0f, 0.0f);
		StopMusic (3.5f, 10);
		return;
	}
	else if (asChild == "machine_VO_5")
	{
		AddEffectVoice("vo_streets_5_machine.ogg", "", "Voice", "vo_streets_5_machine", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "machine_VO_6")
	{
		AddEffectVoice("vo_streets_6_machine.ogg", "", "Voice", "vo_streets_6_machine", false, "", 0.0f, 0.0f);
		return;
	}
		else if (asChild == "mandus_VO_7")
	{
		AddEffectVoice("vo_streets_7_mandus.ogg", "", "Voice", "vo_streets_7_mandus", false, "", 0.0f, 0.0f);
		SetEntityActive("End_Pig", true);
		RemoveTimer("Streets2");
		return;
	}
}
//END TRIGGERED VO PLAYER//

//RANDOM SOUND CUE PLAYER
void RandChaosSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_streets_distantchaos.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Chaos Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(20.0f, 35.0f), "RandChaosSoundCues");
}

void RandExplosionSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_streets_explosionplayer.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Explosion Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(8.0f, 12.0f), "RandExplosionSoundCues");
	AddTimer ("ReturntoNormalMovementSpeed", 0.25f, "ReturntoNormalMovementSpeed");
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerLookSpeedMul(0.5f);
	SetPlayerRunSpeedMul(0.5f);
	StartScreenShake(0.15f, 0.25f, 0.0f, 1.5f);
	DoFlash();
}

void RandExplosionIntSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_streets_explosionplayer_interior.snt", asTimer, 0, false);
	PlaySoundAtEntity(asTimer, "afx_events_streets_explosionplayer_interior_boom.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Explosion Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(8.0f, 12.0f), "RandExplosionIntSoundCues");
	AddTimer ("ReturntoNormalMovementSpeed", 0.25f, "ReturntoNormalMovementSpeed");
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerLookSpeedMul(0.5f);
	SetPlayerRunSpeedMul(0.5f);
	StartScreenShake(0.15f, 0.25f, 0.0f, 1.5f);
}
//END RANDOM SOUND CUE PLAYER//

//RANDOM EXPLOSION HANDLER//
void ExplosionSoundHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ExplosionPlayer_InsideTrigger_1"|| asChild == "ExplosionPlayer_InsideTrigger_2")
	{	
	
	//REMOVE HINT TIMER, PLAYER ISN'T IDLING
	RemoveTimer("Streets1"); AddDebugMessage("NO HINT NEEDED!", false);
	
	//START INSIDE EXPLOSION
	RemoveTimer("RandExplosionSoundCues");
	RemoveTimer("InitRandExplosionSoundCues");
	RemoveTimer("Player");
	AddTimer("InitRandExplosionIntSoundCues", 4.0f, "RandExplosionIntSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_1");
	RemoveEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_2");
	AddEntityCollideCallback("Player", "ExplosionPlayer_OutsideTrigger_1", "ExplosionSoundHandler", true, 0);
	AddEntityCollideCallback("Player", "ExplosionPlayer_OutsideTrigger_2", "ExplosionSoundHandler", true, 0);
	
	AddDebugMessage("EXPLOSION INSIDE START!", true);
	return;
	}
	
	else if (asChild == "ExplosionPlayer_OutsideTrigger_1"|| asChild == "ExplosionPlayer_OutsideTrigger_2")
	{
	//START OUTSIDE EXPLOSION
	RemoveTimer("Player");
	RemoveTimer("RandExplosionIntSoundCues");
	RemoveTimer("InitRandExplosionIntSoundCues");
	AddTimer("InitRandExplosionSoundCues", 4.0f, "RandExplosionSoundCues");
		
	//AREAS
	RemoveEntityCollideCallback("Player", "ExplosionPlayer_OutsideTrigger_1");
	RemoveEntityCollideCallback("Player", "ExplosionPlayer_OutsideTrigger_2");
	AddEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_1", "ExplosionSoundHandler", true, 0);
	AddEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_2", "ExplosionSoundHandler", true, 0);
			
	AddDebugMessage("EXPLOSION OUTSIDE START!", true);
	return;
	}										
}
//END RANDOM EXPLOSION HANDLER

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("React_Scared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("React_Breath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("React_Quick", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//Scream Sweetener//
void screamsweetener (string &in asParent, string &in asChild, int alState)
{
//ScreamSweet
	if (asChild == "ScreamSweet_Start")
	{
	RemoveEntityCollideCallback("Player", "ScreamSweet_Start");
	AddEntityCollideCallback("Player", "ScreamSweet_Stop_1", "screamsweetener", true, 1);
	AddEntityCollideCallback("Player", "ScreamSweet_Stop_2", "screamsweetener", true, 1);
	//Play Sweetener
	PlaySoundAtEntity("ScreamSweetener", "afx_streets_scream_sweetener.snt", "screamsweetsource", 3.0f, false);
	
	//DEBUG MESSAGE
	AddDebugMessage("Scream Starts", true);
	}
//BREAK
	if (asChild == "ScreamSweet_Stop_1"|| asChild == "ScreamSweet_Stop_1")
	{
		
	//REMOVE STOP TRIGGERS
	StopSound("ScreamSweetener", 3.0f);
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "ScreamSweet_Start", "screamsweetener", true, 1);
	RemoveEntityCollideCallback("Player", "ScreamSweet_Stop_1");
	RemoveEntityCollideCallback("Player", "ScreamSweet_Stop_2");
	
	//DEBUG MESSAGE
	AddDebugMessage("Screams stop", true);
	}
}

//HINT TIMERS//
void HintTimer (string &in asTimer)
{
	AddHint(asTimer, "");
}
//END HINT TIMERS//

//-------------------
//DOOR HELPERS//
//-------------------

void OpenPigDoor(const string &in asDoorName, bool abNegForce)
{
	SetSwingDoorDisableAutoClose(asDoorName, true);
	SetSwingDoorClosed(asDoorName, false, false);

	string sFuncNameAdd = abNegForce ? "Neg" : "";
	AddTimer(asDoorName, 0.1f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.2f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.3f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.4f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.5f, "TimerOpenPigDoorEnd");
}

void TimerOpenPigDoor(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_Body_2", 20,0,0, "local");
}

void TimerOpenPigDoorNeg(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_Body_2", -20,0,0, "local");
}

void TimerOpenPigDoorEnd(const string &in asDoorName)
{
	SetSwingDoorDisableAutoClose(asDoorName, false);
}

