}

void CollideScene_Fix(string &in asParent, string &in asChild, int alState)
{
	Scene_3_PlayerLookAt("", 1);
}
		
void DoFlash()
{
	float fTime = 0;
	
	SetLocalVarFloat("FlashStrength", 0);
	
	for(int i=0;i<6;i++)
	{
		float fAdd = i;
		
		fTime = RandFloat(0,0.1)+fAdd/10;
		
	//	AddDebugMessage("time: "+fTime, false);

		AddTimer("BoxLight_1", fTime, "TimerFlash");
	}
	
	fTime += 0.05;
	
//	AddDebugMessage("time reset: "+fTime, false);
	
	AddTimer("reset", fTime, "TimerFlash");
}

void TimerFlash(string &in asTimer)
{
	if(asTimer == "reset")
	{
		FadeLightTo("BoxLight_1", 0.052,0.103,0.181, -1, -1, 0);
		return;
	}
	
	AddLocalVarFloat("FlashStrength", RandFloat(-0.05,0.1));
	
	float fRed = 0.052+GetLocalVarFloat("FlashStrength");
	float fGreen = 0.103+GetLocalVarFloat("FlashStrength");
	float fBlue = 0.181+GetLocalVarFloat("FlashStrength");
	
	if(fRed < 0.052) fRed = 0.07;
	if(fGreen < 0.103) fGreen = 0.12;
	if(fBlue < 0.181) fBlue = 0.23;
	
	if(fRed > 0.35) fRed = 0.35;
	if(fGreen > 0.35) fGreen = 0.35;
	if(fBlue > 0.35) fBlue = 0.35;
	
//	AddDebugMessage("Colors: "+fRed+" "+fGreen+" "+fBlue, false);
	
	FadeLightTo("BoxLight_1", fRed, fGreen, fBlue, -1, -1, 0);
}

//INITIALISE ELEVATOR//
void InitialiseElevator()
{
	AddAttachedPropToProp("StartElevator", "ElevatorSwitchStatic", "elevator_switch_static.ent", 0.06f, -1.842f, -0.068f, 0.0f, 0.0f, 0.0f);
	SetMoveObjectState("StartElevator", 1);
	PlaySoundAtEntity("LiftLoop", "reactor_elevator_loop.snt", "Player", 1.0f, true);
	FadeOut(0);
	AddTimer("", 1.5, "FadeInStart");
	AddTimer("PreStartAfx1", 12.0f, "PreStartSound");
	AddTimer("PreStartAfx2", 16.0f, "PreStartSound");
	AddTimer("LiftTimer", 21.5f, "LiftEnd");
	AddTimer("LiftDoorTimer", 22.8f, "LiftEnd");
}

void PreStartSound (string &in asTimer)
{
	if (asTimer == "PreStartAfx1")
	{
		AddDebugMessage("Pre STart AFX", false);
		PlaySoundAtEntity("LiftChaos", "afx_streets_distantchaos_05.snt", "StartElevator", 0.0f, false);
	}
	else if (asTimer == "PreStartAfx2")
	{
		DoFlash();
		PlaySoundAtEntity("LiftChaos", "afx_streets_opening_explosion", "Player", 0.0f, false);
		StopMusic(1.0f, 45);
		StartScreenShake(0.15f, 0.25f, 0.0f, 2.5f);
		MandusReactionPlayer("Scared", 0.5f);
	}
	
}

void LiftEnd (string &in asTimer)
{
	if (asTimer == "LiftTimer")
	{
		AddDebugMessage("LIFT STOP NOW", false);
		PlaySoundAtEntity("", "reactor_elevator_stop.snt", "Player", 0.0f, false);
		StopSound("LiftLoop", 1.5f);
		return;
	}
	else if (asTimer == "LiftDoorTimer")
	{
		ElevatorDoorHandler("Player", "ElevatorBottomOpenTrigger", 1);
		return;
	}
}
//END INITIALISE ELEVATOR//	

//START EXPLOSION//
	void ExplosionStartLevel_Activate (string &in asTimer)
	{
		DoFlash();
		PlaySoundAtEntity("OpeningArea", "afx_streets_opening_explosion_2", "Player", 0.0f, false);
		PlaySoundAtEntity("Siren", "amb_streets_siren", "Player", 0.0f, false);
		StartScreenShake(0.15f, 0.25f, 0.0f, 2.5f);
		MandusReactionPlayer("Scared", 0.5f);
		AddTimer ("ReturntoNormalMovementSpeed", 1.0f, "ReturntoNormalMovementSpeed");
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.5f);
		AddTimer("InitRandExplosionSoundCues", 10.0f, "RandExplosionSoundCues");
		AddEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_1", "ExplosionSoundHandler", true, 0);
		AddEntityCollideCallback("Player", "ExplosionPlayer_InsideTrigger_2", "ExplosionSoundHandler", true, 0);
	}
//END START EXPLOSION//

//ELEVATOR DOOR HANDLER//
void ElevatorDoorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ElevatorBottomOpenTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 1);
		SetMoveObjectState("StartElevatorDoorLeft", 1);
		SetEntityActive("StartElevatorBlockBox", false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	else if (asChild == "CloseStartElevatorDoorTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 0);
		SetMoveObjectState("StartElevatorDoorLeft", 0);
		PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	if (asChild == "ElevatorTopOpenTrigger")
	{
		if (alState == 1 && GetLocalVarInt("ElevatorTopDoorsOpen") == 0)
		{
			AddLocalVarInt("BlaFix", 1);
			
			SetLocalVarInt("ElevatorTopDoorsOpen", 1);
			RemoveEntityCollideCallback("Player", "ElevatorTopOpenTrigger");
			AddTimer("RestoreCallbackTimer", 1.5f, "RestoreCallback");
			
			if(GetLocalVarInt("BlaFix") == 2) return;
			SetMoveObjectState("elevator_door_right_8", 1);
			SetMoveObjectState("elevator_door_right_7", 1);
			PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource", 0.0f, false);
			PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource", 0.0f, false);

			return;
		}
		else if (alState == -1 && GetLocalVarInt("ElevatorTopDoorsOpen") == 1)
		{
			SetMoveObjectState("elevator_door_right_8", 0);
			SetMoveObjectState("elevator_door_right_7", 0);
			SetLocalVarInt("ElevatorTopDoorsOpen", 0);
			PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource", 0.0f, false);
			PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource", 0.0f, false);
			RemoveEntityCollideCallback("Player", "ElevatorTopOpenTrigger");
			AddTimer("RestoreCallbackTimer", 1.5f, "RestoreCallback");
			return;
		}
	}
}	

//END ELEVATOR DOOR HANDLER//

//TOPPLE EVENT HANDLER//
