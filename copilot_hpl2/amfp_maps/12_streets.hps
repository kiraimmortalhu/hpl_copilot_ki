//-----------------
//SCENE 1 - INTRO PIGS//
//-----------------
void Scene_1(string &in asParent, string &in asChild, int alState)
	{
		AddDebugMessage("Scene_1_Started", false);
		AddTimer("S1_Part1", 0.0f, "Scene_1_Timer");	
		AddTimer("S1_Part2", 0.3f, "Scene_1_Timer");	
		AddTimer("S1_Part3", 1.1f, "Scene_1_Timer");	
		AddTimer("S1_Part_jens", 2, "Scene_1_Timer");
		
		AddEntityCollideCallback("Engineer_1_Scene1a","Scene_1_PigKill", "Scene_1_PigKill", true, 1);
		AddEntityCollideCallback("Wretch_1_Scene1a","Scene_1_PigKill", "Scene_1_PigKill", true, 1);
		AddEntityCollideCallback("Wretch_2_Scene1a","Scene_1_PigKill", "Scene_1_PigKill", true, 1);
	}
	
void Scene_1_PigKill(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive(asParent, false);
}

void Scene_1_Timer (string &in asTimer)
	{
		string x = asTimer;
		if (x == "S1_Part1")
		{
			StartLampFlickerBurst("streetlight_ground_4", 4);
		
			AddDebugMessage("Intro Pigs Triggered", false);
			AddPropForce("Scene_1_Barrel", -32000.0f, 0.0f, 0.0f, "world");
			SetEntityActive("Engineer_1_Scene1a", true);
			PlaySoundAtEntity("Scene_1a", "afx_streets_pigsintro.snt", "Engineer_1_Scene1a", 0.0f, false);
			PlaySoundAtEntity("Scene_1a_Chaos", "afx_streets_distantchaos_06", "IntroPigSoundSource", 0.0f, false);
			AddTimer("ExplosionStartLevel", 4.0f, "ExplosionStartLevel_Activate");
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_1", 0.0f, "", false);
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_2", 0.0f, "", false);
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_3", 0.0f, "", false);
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_4", 0.0f, "", false);
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_5", 0.0f, "", false);
			AddEnemyPatrolNode("Engineer_1_Scene1a", "PathNodeArea_6", 0.0f, "", false);
		}
		else if (x == "S1_Part2")
		{
			LanternFlicker(5);
			SetEntityActive("Wretch_1_Scene1a", true);
			PlaySoundAtEntity("Scene1PigVoice", "afx_streets_pig_call", "Wretch_1_Scene1a", 0.0f, false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_7", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_8", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_9", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_10", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_11", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_1_Scene1a", "PathNodeArea_12", 0.0f, "", false);
		} 
		else if (x == "S1_Part3") 
		{
			SetEntityActive("Wretch_2_Scene1a", true);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_14", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_15", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_17", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_18", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_19", 0.0f, "", false);
			AddEnemyPatrolNode("Wretch_2_Scene1a", "PathNodeArea_20", 0.0f, "", false);
		}
		
		else if (x == "S1_Part_jens") //what do you mean jens?
		{
			StartLampFlickerBurst("streetlight_ground_fog_54", 4);
			StartLampFlickerBurst("streetlight_ground_fog_55", 3);
		
			SetEntityActive("scene1_block_1", true);
		}
	}	
//-----------------
//END SCENE 1 - INTRO PIGS//
