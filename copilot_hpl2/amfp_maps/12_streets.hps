{
	AddTimer("", 0.1, "TimerDelayScene_20");

	AddTimer("PigDoorSlamTimer", 4.5f, "Scene_20_DoorSlam");
}

void TimerDelayScene_20 (string &in asTimer)
{
	PlaySoundAtEntity("", "afx_mansion_pig_slam_door_1.snt", "Scene_20_Door", 0, false);
	StopSound("doorscratching", 0);
	MandusReactionPlayer("Scared", 0.1f);
	AddPropForce("Scene_20_Door", 0.0f, 0.0f, 6000.0f, "world");
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "Scene_20_Door_PS_Emit", false);	
}

void Scene_20_DoorSlam (string &in asTimer)
{
	PlaySoundAtEntity("", "afx_mansion_pig_slam_door_2.snt", "Scene_20_Door", 0, false);
