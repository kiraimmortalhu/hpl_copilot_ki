//-----------------
//SCENE 6 - MAID GRABBED SCENE//
//-----------------

//-----------------------------------------------

void Scene_6(string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Scene_6_Started", false);
		
	AddPropForce("Scene_6_Barrel", 12000.0f, 0.0f, 0.0f, "world");
	
	AddEntityCollideCallback("Player", "Scene_6_ShowMaid", "Scene_6_ShowMaid", true, 1);
}


void Scene_6_ShowMaid(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("maid_actor_scene_6", true);
	SetEntityActive("wretch_actor_scene_6", true);
	PlayPropAnimation("wretch_actor_scene_6", "StreetsScene6", 0.0f, false, "");
	PlayPropAnimation("maid_actor_scene_6", "StreetsScene6", 0.0f, false, "");
	
	//*InsertSoundHere*: Need to retime this scene!!
	PlaySoundAtEntity("Scene6", "afx_streets_scene_06.snt", "Scene_6_Door", 0.0f, false);
	
	SetPropAnimationPosition("wretch_actor_scene_6", 2);
	SetPropAnimationPosition("maid_actor_scene_6", 2);
	
	//StartPlayerLookAt("Scene_6_LookAt", 3, 2, "");
	//FadePlayerFOVMulTo(0.3f, 0.25f);
	
	AddTimer("Scene6_1", 1.5f, "Scene_6_Flicker");	
	AddTimer("Scene6_3", 3.0f, "Scene_6_CloseDoor");
	AddTimer("Scene6_4", 4.0f, "Scene_6_Disable");	
	
	OpenPigDoor("Scene_6_Door", true);
	
	//Light up some stuff so exit gets more visible!
	FadeLightTo("PointLight_23", 239.0f / 255.0f, 197.0f / 255.0f, 120.0f / 255.0f, 1.0f, -1.0f, 2.0f);
	FadeLightTo("SpotLight_5", 250.0f / 255.0f, 221 / 255.0f, 171 / 255.0f, 1.0f,-1.0f, 2.0f);
}

void Scene_6_Flicker(string &in asTimer)
{
	LanternFlicker(3);
	StartLampFlickerBurst("streetlight_wall_fog_3", 3);
	
	SetPlayerRunSpeedMul(0.5);
}


void Scene_6_CloseDoor(string &in asTimer)
{
	SetSwingDoorDisableAutoClose("Scene_6_Door", false);
	AddPropForce("Scene_6_Door", 0.0f, 0.0f, -9000.0f, "world");
	SetSwingDoorLocked("Scene_6_Door", true, true);
	
	SetPlayerMoveSpeedMul(1);
	SetPlayerRunSpeedMul(1);
	
	SetEntityActive("Scene_7_Trigger", true);
}

void Scene_6_Disable(string &in asTimer)
{
	SetEntityActive("wretch_actor_scene_6", false);
	SetEntityActive("maid_actor_scene_6", false);
	StopPropAnimation("maid_actor_scene_6");
	StopPropAnimation("wretch_actor_scene_6");
}

//-----------------------------------------------


//-----------------
//END SCENE 6 - MAID GRABBED SCENE//
//-----------------

//-----------------
//SCENE 7 - 2 PIGS ATTACKING SCENE//
//-----------------
void Scene_7(string &in asParent, string &in asChild, int alState)
	{
		AddDebugMessage("Scene_7_Started", false);
		AddTimer("S7_Part1", 0.0f, "Scene_7_Timer");	
		AddTimer("S7_Part3", 12.0f, "Scene_7_Timer");	
		AddTimer("S7_Part4", 11.0f, "Scene_7_Timer");	
		AddTimer("S7_Part5", 14.0f, "Scene_7_Timer");	
		AddTimer("S7_Part7", 18.0f, "Scene_7_Timer");	
	}
	
void Scene_7_Timer (string &in asTimer)
	{
		string x = asTimer;
		if (x == "S7_Part1")
		{
			PlaySoundAtEntity("Scene7", "afx_maid_scream_01.snt", "Scene_7_SoundSource", 0.0f, false);
			SetEntityActive("maid_actor_scene_7", true);
			SetEntityActive("engineer_actor_scene_7", true);
			PlayPropAnimation("engineer_actor_scene_7", "StreetsScene7", 0.0f, false, "");
			PlayPropAnimation("maid_actor_scene_7", "StreetsScene7", 0.0f, false, "");
			PlaySoundAtEntity("Scene7Drag", "afx_streets_drag_scene.snt", "Scene_7_SoundSource", 0.0f, false);	
			
			SetEntityActive("Wretch_1_Scene7", true);
			AddEnemyPatrolNode("Wretch_1_Scene7", "PathNodeArea_137", 0.0f, "", false);
			
			SetEntityActive("Engineer_1_Scene7", true);
			PlaySoundAtEntity("Scene1PigVoice", "afx_streets_pig_call", "Scene_4_SoundSource", 0.0f, false);
			AddEnemyPatrolNode("Engineer_1_Scene7", "PathNodeArea_136", 0.0f, "", false);
			
			LanternFlicker(5);
			StartLampFlickerBurst("streetlight_wall_fog_1", 6);
			StartLampFlickerBurst("streetlight_wall_fog_2", 3);
		} 
		else if (x == "S7_Part3") 
		{
			StopPropAnimation("engineer_actor_scene_7");
			StopPropAnimation("maid_actor_scene_7");
			SetEntityActive("engineer_actor_scene_7", false);
			SetEntityActive("maid_actor_scene_7", false);
		}
		else if (x == "S7_Part4")
		{
			PlaySoundAtEntity("Scene7_PostSplat", "afx_streets_scene_7_guts_hit_door.snt", "Scene_3_Post_SoundSource", 0.0f, false);
		}
		else if (x == "S7_Part5")
		{
			PlaySoundAtEntity("Scene7Munch", "afx_pigline_pig_eat_body", "Scene_7_SoundSource", 0.0f, true);		
		}
		else if (x == "S7_Part8")
		{
			StopSound("Scene7Munch", 2.5f);
		}
	}	
//-----------------
//END SCENE 7 - MAID DRAGGED SCENE//
//-----------------

