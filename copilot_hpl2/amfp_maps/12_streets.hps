		AddPropForce("male_corpse_1", 0.0f, 350.0f, -250.0f, "world");
		AddPropForce("pig_corpse_2", 0.0f, 750.0f, -250.0f, "world");
		AddPropForce("pig_corpse_1", 0.0f, 500.0f, -250.0f, "world");
		AddPropForce("pig_corpse_3", 0.0f, 150.0f, -750.0f, "world");
		AddPropForce("pig_corpse_4", 0.0f, 550.0f, -550.0f, "world");
		AddPropForce("pig_corpse_5", 0.0f, 350.0f, -650.0f, "world");
