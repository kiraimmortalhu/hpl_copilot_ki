//-----------------
//SCENE_21 - CHILDREN DOOR EVENT//
//-----------------

void Scene_21 (string &in asParent, string &in asChild, int alState)
{
	RemoveTimer("keepsync");
	
	AddDebugMessage("Scene_21_Started", false);
	
	AddTimer("S21_Move", 0.0f, "Scene_21_MovePlayerBack");	
	
	AddTimer("S21_Part1", 0.3f, "Scene_21_Timer");	
	AddTimer("S21_Part2", 0.1f, "Scene_21_Timer");	
	AddTimer("S21_Part3", 0.7f, "Scene_21_Timer");	
	AddTimer("S21_Part4", 1.2f, "Scene_21_Timer");	
	AddTimer("S21_Part5", 4.0f, "Scene_21_Timer");	
	AddTimer("S21_Part6", 2.3f, "Scene_21_Timer");	
	AddTimer("S21_Part7", 2.8f, "Scene_21_Timer");	
	AddTimer("S21_Part8", 6.0f, "Scene_21_Timer");	
}

void Scene_21_MovePlayerBack(string &in asTimer)
{
	AddLocalVarInt("Scene_21_Move", 1);
	if(GetLocalVarInt("Scene_21_Move")>60) return;
	
	AddPlayerBodyForce(0,0,1250, false);
	
	AddTimer("S21_Move", 0.01f, "Scene_21_MovePlayerBack");
}

void Scene_21_Timer (string &in asTimer)
{
	string x = asTimer;
	if (x == "S21_Part1")
	{
	AddPropForce("Scene_21_Door", 0.0f, 0.0f, -5000.0f, "world");
	SetPlayerCrouching(true);
	FadeImageTrailTo(2.3f, 2.5f);
	SetPlayerMoveSpeedMul(0.3f);
	SetPlayerLookSpeedMul(0.5f);
	} 
	else if (x == "S21_Part2") 
	{
	MandusReactionPlayer("Quick", 0.3f);
	SetEntityActive("Scene_21_Child*", true);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_84", 0.0f, "", false);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_85", 0.0f, "", false);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_86", 0.0f, "", false);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_87", 0.0f, "", false);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_88", 0.0f, "", false);
	AddEnemyPatrolNode("Scene_21_Child*", "PathNodeArea_89", 0.0f, "", false);
	} 
	else if (x == "S21_Part3") 
	{
	PlaySoundAtEntity("slam", "afx_mansion_pig_slam_door_1.snt", "Scene_21_Door", 0.4, false);
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "Scene_21_Door_PS_Emit", false);
	StartScreenShake (0.05f, 3.0f, 0.5f, 1.5f);
	}
	else if (x == "S21_Part4") 
	{
	StopSound("slam",0.3);
	PlaySoundAtEntity("S21_Child1_", "afx_tunnels_child_giggle_run_corridor_3D.snt", "Scene_21_Child1", 0.0f, false);
	}
	else if (x == "S21_Part5") 
	{
	MandusReactionPlayer("Scared", 0.0f);
	FadeImageTrailTo(1.0f, 5.5f);
	SetPlayerMoveSpeedMul(0.6f);
	SetPlayerLookSpeedMul(0.8f);
	SetPlayerRunSpeedMul(0.6f);	
	SetPlayerActive(true);
	}
	else if (x == "S21_Part6") 
	{
	AddPropForce("Scene_21_Door", 0.0f, 0.0f, 5000.0f, "world");
	}
	else if (x == "S21_Part7") 
	{
	SetSwingDoorLocked("Scene_21_Door", true, true);
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "Scene_21_Door_PS_Emit2", false);
	PlaySoundAtEntity("slam", "afx_mansion_pig_slam_door_1.snt", "Scene_21_Door", 0, false);
	}
	else if (x == "S21_Part8") 
	{
	SetEntityActive("Scene_21_Child*", false);
	SetPlayerCrouching(false);
	PlaySoundAtEntity("", "00_intro_foley_standup.snt", "Player", 0.0f, false);
	FadeImageTrailTo(0.0f, 12.5f);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);	
	SetPlayerActive(true);
	StopSound("slam", 0.5);
	}
}

