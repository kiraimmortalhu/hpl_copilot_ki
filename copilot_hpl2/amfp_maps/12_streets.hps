void FadeInStart(string &in asTimer)
{
	FadeIn(3);
}

void OnStart()
{	
	bool bStartWithElevator=true;
	ElevatorDoorHandler("Player", "ElevatorTopOpenTrigger", 1);
	//Map Preamble
	{
		SetMapDisplayNameEntry("Streets");
		//SET CHECKPOINT #1//
		CheckPoint ("CP01_Start", "MainStart", "", "", "", false); 
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");

		bStartWithElevator = false;
	}
	
	//Initialise Start Elevator
	{
		if(bStartWithElevator)
			InitialiseElevator();
			
		
		//START STEAM SOUNDS
		PlaySoundAtEntity("steam_1", "afx_cellar_steam_loop.snt", "steamsourcesfx_1", 5.0f, true);
		PlaySoundAtEntity("steam_2", "afx_cellar_steam_loop_2.snt", "steamsourcesfx_2", 5.0f, true);
