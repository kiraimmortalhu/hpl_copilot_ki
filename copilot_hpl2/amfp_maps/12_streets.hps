//-----------------
//SCENE 3 - MAN SLAMS DOOR//
//-----------------
void Scene_3_PlayerLookAt(string &in asEntity, int alState)
{
	if(alState!=1) return;

	AddDebugMessage("Scene_3_Started", false);
	PlayPropAnimation("gent_actor_scene_3", "StreetsScene3", 0.0f, false, "");
	AddTimer("Door3Slam", 3.0f, "SlamDoor3");
	AddTimer("Scene_3_Postevent", 3.7f, "Scene_3_Postevent");
	AddTimer("Scene_3a", 3.4f, "Scene_3a");
	
	SetPlayerRunSpeedMul(0.8);
}

void Scene_3a (string &in asTimer)
{
	AddLocalVarInt("Scene_15a_count",1);
	if(GetLocalVarInt("Scene_15a_count")==6) return;
	
	AddPropForce("hanging_lantern_wall_6", 140.0f, 0.0f, 0.0f, "world");
	AddTimer("Scene_3a", 2.0f, "Scene_3a");
}

void SlamDoor3 (string &in asTimer)
{
	AddPropForce("Scene_3_Door", 0.0f, 0.0f, -4000.0f, "world");
	SetSwingDoorLocked("Scene_3_Door", true, true);
	PlaySoundAtEntity("Scene3", "afx_streets_scene_3_door.snt", "Scene_3_Door", 0.0f, false);
	PlaySoundAtEntity("Scene3_Post", "afx_streets_crazy_pig_seq_02.snt", "Scene_3_Post_SoundSource", 1.0f, false);
	
	SetPlayerRunSpeedMul(1);
}

void Scene_3_Postevent (string &in asTimer)
{
	AddPropImpulse("Scene_3_Door", -50, 0.0f, 0, "world");
	PlaySoundAtEntity("Scene_3_Door", "afx_streets_scene_3_door.snt", "Scene_3_Door", 0.3f, false);
	PlaySoundAtEntity("Scene3_PostSplat", "afx_gent_scream_02.snt", "Scene_3_Post_SoundSource", 0.0f, false);
	RemoveTimer("Scene_3a");

}

