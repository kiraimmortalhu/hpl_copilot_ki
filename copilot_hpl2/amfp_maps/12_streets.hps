void PlayerLookAtScene15(string &in asEntity, int alState)
{
	if(alState!=1) return;
	
	AddDebugMessage("Scene_15_Started", false);
	
	StartLampFlickerBurst("streetlight_ground_7", 8);
	StartLampFlickerBurst("streetlight_ground_6", 4);
	
	SetEntityActive("wretch_actor_scene_15", true);
	SetEntityActive("gent_actor_scene_15", true);
	
	PlayPropAnimation("wretch_actor_scene_15", "StreetsScene7", 0.0f, false, "");
	PlayPropAnimation("gent_actor_scene_15", "StreetsScene7", 0.0f, false, "");
	PlaySoundAtEntity("Scene7", "afx_streets_scene7_fight_unoccluded.snt", "gent_actor_scene_15", 0.0f, false);
	
	AddTimer("Scene_15a", 0.5f, "Scene_15a");
	AddTimer("Scene_15_Kill", 9.5f, "Scene_15_Kill");
	
	SetEntityActive(asEntity, false);
}

void Scene_15a (string &in asTimer)
{
	AddLocalVarInt("Scene_15a_count",1);
	if(GetLocalVarInt("Scene_15a_count")==6) return;

	AddPropForce("hanging_lantern_wall_4", 0.0f, 0.0f, 140.0f, "world");
	AddTimer("Scene_15a", 2.0f, "Scene_15a");

}
void Scene_15_Kill (string &in asTimer)
{
	SetEntityActive("wretch_actor_scene_15", false);
	SetEntityActive("gent_actor_scene_15", false);
	RemoveTimer("Scene_15a");
}	
