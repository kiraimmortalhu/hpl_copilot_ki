void Scene_4_PlayerLookAt(string &in asParent, int alState)
{
	if(alState!=1) return;

	LanternFlicker(4);
	
	AddDebugMessage("Scene_4_Started "+alState, false);
	SetEntityActive("gent_actor_scene_4", true);
	SetEntityActive("engineer_actor_scene_4", true);
	PlayPropAnimation("engineer_actor_scene_4", "StreetsScene4", 0.0f, false, "");
	PlayPropAnimation("gent_actor_scene_4", "StreetsScene4", 0.0f, false, "");
	
	AddEntityCollideCallback("Engineer_1_Scene4", "Scene_4_Killer", "Scene_4_Killer", true, 1);
	AddEntityCollideCallback("Wretch_1_Scene4", "Scene_4_Killer", "Scene_4_Killer", true, 1);
	AddEntityCollideCallback("Wretch_2_Scene4", "Scene_4_Killer", "Scene_4_Killer", true, 1);
		
	SetEntityActive("Wretch_1_Scene4", true);
	PlaySoundAtEntity("Scene1PigVoice", "afx_streets_pig_call", "Scene_4_SoundSource", 0.0f, false);
	AddEnemyPatrolNode("Wretch_1_Scene4", "PathNodeArea_395", 0.0f, "", false);
		
	AddTimer("S4_Part2", 0.5f, "Scene_4_Timer");	
	AddTimer("S4_Part3", 0.7f, "Scene_4_Timer");	
}

