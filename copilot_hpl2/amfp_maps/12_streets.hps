//MUSIC HANDLER//
void PickNoteMusicCheck(string &in asEntity)
{
	if(GetLocalVarInt("MusicChanged") == 1) return;
	
	RemoveTimer("StartMorsLoop");
	AddTimer("StartMorsLoop", 20, "StartMorsLoop");
}

void MusicHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Music_Trigger_1")
	{
		AddDebugMessage("Music_1_Start", false);
		PlayMusic("Mors_Praematura_Unprocessed", false, 1.0, 0.0, 6, false);
		AddTimer("StartMorsLoop", 92, "StartMorsLoop");
		return;
	}
	else if (asChild == "Music_Kill_Trigger_1")
	{
		RemoveTimer("StartMorsLoop");
		StopMusic (2.5f, 6);
		PlaySoundAtEntity("", "afx_streets_enter_cellar.snt", "Player", 0.0f, false);
		StopSound("Siren", 5.5f);
		PlayMusic("mors_underdrone", false, 0.5, 3.0, 10, false);
		SetLocalVarInt("MusicChanged", 1);
		return;
	}
//	else if (asChild == "Music_Trigger_2")
//	{
//		AddDebugMessage("Music_2_Start", false);
//		PlayMusic("music_streets_pacey_chasey", true, 1.0, 0.0, 6, false);
//		RemoveTimer("Streets1");
//		return;
//	}

	
	else if (asChild == "Music_Kill_Trigger_2")
	{
		StopMusic (2.5f, 6);
		return;
	}
}

void StartMorsLoop(string &in asTimer)
{
	SetLocalVarInt("MusicChanged", 1);
	PlayMusic("afx_events_streets_mors_loop", true, 1.0, 5.0, 6, false);
}

//PIG MASK HANDLER//  NOTE!! Using wildcard so any pig mask is added automatically
void PigMaskHandler (string &in asParent, string &in asChild, int alState)
	{
		AddTimer("PigMask_Part1", 0.0f, "PigMask_Timer");	
		AddTimer("PigMask_Part2", 0.3f, "PigMask_Timer");	
		AddTimer("PigMask_Part3", 0.7f, "PigMask_Timer");	
		AddTimer("PigMask_Part4", 0.9f, "PigMask_Timer");	
		AddTimer("PigMask_Part5", 3.0f, "PigMask_Timer");	
		AddTimer("PigMask_Part6", 3.6f, "PigMask_Timer");	
	
	}

void PigMask_Timer (string &in asTimer)
	{
		string x = asTimer;
		if (x == "PigMask_Part1")
		{
		PlaySoundAtEntity("", "afx_streets_end_crates_whoosh_1.snt", "Player", 0.0f, false);
		} 
		else if (x == "PigMask_Part2") 
		{
		SetEntityActive("PigMask_*", true);
		}
		else if (x == "PigMask_Part3") 
		{
		FadeOut(0.1f);
		} 
		else if (x == "PigMask_Part4") 
		{
		SetEntityActive("PigMask_*", false);
		} 
		else if (x == "PigMask_Part5") 
		{
		FadeIn(2.0f);
		} 
		else if (x == "PigMask_Part6") 
		{
		MandusReactionPlayer("Scared", 0.1f);
		} 
	}
//END PIG MASK HANDLER//

//SPOOK PIG HANDLER//  NOTE!! Using wildcard so any pig mask is added automatically
void SpookPigHandler (string &in asParent, string &in asChild, int alState)
	{
		AddDebugMessage("SpookPig Says Hi", false);
		AddTimer("SpookPig_Show", 1.4f, "SpookPig_Timer");	
		AddTimer("SpookPig_Hide", 2.5f, "SpookPig_Timer");	
		AddTimer("SpookPig_FOut", 2.9f, "SpookPig_Timer");	
		AddTimer("SpookPig_FIn", 3.4f, "SpookPig_Timer");	
	}

void SpookPig_Timer (string &in asTimer)
	{
		string x = asTimer;
		if (x == "SpookPig_Show")
		{
		SetEntityActive("SpookPig_*", true);
		AddEnemyPatrolNode("SpookPig_1", "engineer_engroom_amb_hunt_01.ogg", 0.0f, "", false);
		PlaySoundAtEntity("SpookPigSound", "react_scared1.ogg", "SpookPig_1", 0.0f, false);
		} 
		else if (x == "SpookPig_Hide") 
		{
		SetEntityActive("SpookPig_1", false);
		}
		else if (x == "SpookPig_FOut") 
		{
		FadeOut(0.0f);
		PlaySoundAtEntity("SpookPigPostSound", "react_scared1.ogg", "Player", 0.0f, false);
		} 
		else if (x == "SpookPig_FIn") 
		{
		FadeIn(0.8f);
		} 
	}
