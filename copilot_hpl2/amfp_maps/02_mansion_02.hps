//------------------------
//FLICKERING LAMP//
//------------------------

void StartLampFlicker(string &in asLamp)
{
	AddTimer(asLamp, RandFloat(0.0f, 0.3f), "TimerLampFlickerOff");
}

void StopLampFlicker(string &in asLamp)
{
	RemoveTimer(asLamp);
	SetLampLit(asLamp, true, false);
}

void TimerLampFlickerOff(string &in asLamp)
{
	SetLampLit(asLamp, false, false);
	AddTimer(asLamp, RandFloat(0.1f, 0.2f), "TimerLampFlickerOn");
}

void TimerLampFlickerOn(string &in asLamp)
{
	AddLocalVarInt("RandFlickSound", 1);
	
	if(GetLocalVarInt("RandFlickSound") % 3 == 1 && 
		(asLamp == "corridor01_wall_lamp_24" || asLamp == "corridor01_wall_lamp_32")
	) 
		PlaySoundAtEntity("flick", "cellar_light_flicker_louder.snt", asLamp, 0, false);
	
	SetLampLit(asLamp, true, false);
	AddTimer(asLamp, RandFloat(0.05f, 0.15f), "TimerLampFlickerOff");
}


//------------------------
//END FLICKERING LAMP//
//------------------------

//------------------------
//SLEEPING PIGIE LOGIC//
//------------------------
void OpenPigDoor(const string &in asDoorName, bool abNegForce)
{
	SetSwingDoorDisableAutoClose(asDoorName, true);
	SetSwingDoorClosed(asDoorName, false, false);

	string sFuncNameAdd = abNegForce ? "Neg" : "";
	AddTimer(asDoorName, 0.1f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.2f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.3f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.4f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.5f, "TimerOpenPigDoorEnd");
	AddTimer(asDoorName, 0.55f, "TimerOpenPigDoorEnd02");
}

void TimerOpenPigDoor(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_door_body", 10,0,0, "local");
}

void TimerOpenPigDoorNeg(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_door_body", -10,0,0, "local");
}

void TimerOpenPigDoorEnd(const string &in asDoorName)
{
	SetSwingDoorDisableAutoClose(asDoorName, false);
	SetPropStaticPhysics(asDoorName, true);
}

void TimerOpenPigDoorEnd02(const string &in asDoorName)
{
	SetPropStaticPhysics(asDoorName, false);
}

void SleepingPigRunsOff(string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("Piggeh", "afx_mansion02_pigsighting_3D.snt", "wretch_1", 0.0f, true);
	PlaySoundAtEntity("Piggeh2D", "afx_mansion02_pigsighting_2D.snt", "wretch_1", 0.0f, true);
	MandusReactionPlayer("Scared", 0.1f);
	MandusReactionPlayer("Scared", 2.0f);
	SetLanternFlickerActive(true);
	AddTimer("justincase", 6, "JustInCase");
	
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_19", 0, "", false);
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_21", 0, "", false);
}

void SleepingPigDisappear(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_1", false);
	RemoveTimer("justincase");
	AddTimer("flickeroff", 2.5f, "TimerSleepingPigFlickerOff");
}

void TimerSleepingPigFlickerOff(string &in asTimer)
{
	StopLampFlicker("corridor01_wall_lamp_28");
	StopLampFlicker("corridor01_wall_lamp_23");
	StopLampFlicker("corridor01_wall_lamp_20");
	StopLampFlicker("corridor01_wall_lamp_21");
	StopLampFlicker("corridor01_wall_lamp_32");
	StopLampFlicker("corridor01_wall_lamp_24");
	
	SetLanternFlickerActive(false);
}

//------------------------
//END SLEEPING PIGIE LOGIC//
//------------------------


//QUAKE EVENT HANDLER//
void QuakeSequences (string &in asParent, string &in asChild, int alState)
{
	AddTimer("PreQuakeShake", 0.1f, "QuakeEventSegments");
	AddTimer("PreQuake", 0.6f, "QuakeEventSegments");
	
	PlaySoundAtEntity("short", "afx_events_mansion_tremor_01.snt", "Player", 0, false);
}

void QuakeEventSegments (string &in asTimer)
{
		//QUAKE//
	if (asTimer == "PreQuakeShake")
	{
		StartScreenShake (0.03f, 0.8, 0.8, 0);
	}
	if (asTimer == "PreQuake")
	{
		AddTimer("QuakeStartBuffer", 0.655f, "QuakeEventSegments");
		AddTimer("AmbientTensionMusicTimer", 5.0f, "QuakeEventSegments");
		AddTimer("PaintingFall", 1.2f, "QuakeEventSegments");
		PlaySoundAtEntity("", "afx_mans_hallquake_highend.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_hall_quake.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_hall_quake_debris.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_mans_hallquake_postdetail.snt", "Player", 0.0f, false);
		MandusReactionPlayer("Breath", 3.4f);
		AddTimer("PlayerSlowDownQuake", 0.6f, "QuakePlayerSpeedControl");
		SetParticleSystemActive("GreatHallDustParticles_*", true);
		SetParticleSystemActive("GreatHallDustCloudParticles_*", true);
		SetParticleSystemActive("ChandelierDustParticles_*", true);
	}
	//QUAKE//
	if (asTimer == "QuakeStartBuffer")
	{
		StopSound("short", 1);
		StartScreenShake (0.04f, 1.5f, 0.5f, 0.5f);
		SetPhysicsAutoDisable("chandelier_large_1", false);
		SetPhysicsAutoDisable("chandelier_large_2", false);
		SetPhysicsAutoDisable("chandelier_nice_20", false);
		AddTimer("", 20, "TimerResetPhysics");
		AddPropForce("chandelier_large_1", 1400.0f, 0.0f, 950.0f, "local");
		AddPropForce("chandelier_large_2", -800.0f, 0.0f, -1250.0f, "local");
		AddPropForce("chandelier_nice_20", 380.0f, 0.0f, 420.0f, "local");
		SetPlayerMoveSpeedMul(0.65f);
		return;
	}
	
	else if (asTimer == "PaintingFall")
	{
		SetPropStaticPhysics("PaintingFall_1", false);
		return;;
	}
	
	//TRIGGER AMBIENT SOUNDTRACK
	else if (asTimer == "AmbientTensionMusicTimer")
	{
		PlayMusic("music_mans_grand_hall.ogg", false, 1.0f, 0.0f, 1, false);
		AddHint("MansionTwo1", "");
		AddDebugMessage("Music Triggered", false);
		return;
	}
}
void TimerResetPhysics(string &in asTimer)
{
	SetPhysicsAutoDisable("chandelier_large_1", true);
	SetPhysicsAutoDisable("chandelier_large_2", true);
	SetPhysicsAutoDisable("chandelier_nice_20", true);
}

void QuakePlayerSpeedControl (string &in asTimer)
{
	//QUAKE PLAYER SLOWDOWN//
	if (asTimer == "PlayerSlowDownQuake")
	{
		SetPlayerMoveSpeedMul(0.25f);
		SetPlayerRunSpeedMul(0.0f);
		StartScreenShake (0.15f, 1.5f, 0.01f, 0.5f);
		AddTimer("PlayerNormalSpeedPostQuake", 2.0f, "QuakePlayerSpeedControl");
		return;
	}
	
	//QUAKE PLAYER BACK TO NORMAL//
	else if (asTimer == "PlayerNormalSpeedPostQuake")
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		return;
	}
}
//END QUAKE EVENT HANDLER//

//BACK AREA VALVE HANDLER//
void BackAreaValveHandler (string &in asEntity, int alState)
{
	if (alState == -1)
	{
		if (asEntity == "RightValve")
		{
			SetWheelInteractionDisablesStuck("RightValve", false);
			SetWheelStuckState("RightValve", -1, false);
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "RightValve", 0.0f, false);
			AddEntityCollideCallback("Player", "PigDoorScratchTrigger", "PigDoorScratchRattleEvent", true, 1); //TRIGGERS PIG DOOR SCRATCH EVENT FOR WHEN PLAYERS BACKTRACK
			AddTimer("RightValveLightSequenceTimer1", 0.2f, "RightValveLightSequencer");
			AddTimer("RightValveLightSequenceTimer2", 1.0f, "RightValveLightSequencer");
			AddTimer("RightValveLightSequenceTimer3", 1.6f, "RightValveLightSequencer");
			AddTimer("RightValveLightSequenceTimer4", 2.3f, "RightValveLightSequencer");
			AddTimer("RightValveLightSequenceTimer5", 2.6f, "RightValveLightSequencer");
			PlayPropAnimation("RightValveGauge", "ontooff", 0.0f, false, "");
			DestroyParticleSystem("RightValveSteam_1");
			DestroyParticleSystem("RightValveSteam_2");
			DestroyParticleSystem("RightValveSteam_3");
			DestroyParticleSystem("RightValveSteam_4");
			DestroyParticleSystem("RightValveSteam_5");
			DestroyParticleSystem("RightValveSteam_6");
			DestroyParticleSystem("RightValveSteam_7");
			DestroyParticleSystem("RightValveSteam_8");
			StopSound("RVS1", 0.5f);
			StopSound("RVS2", 0.5f);
			StopSound("RVS3", 0.5f);
			StopSound("RVS4", 0.5f);
			SetEntityActive("EagleInit", false);
			SetEntityActive("Eagle2", true);
			SetLocalVarInt("RightValveOn", 1);
			//SET CHECKPOINT #3//
			CheckPoint("CP03_RightValve", "CheckpointStart_2", "", "", "", false);
		}
		else if (asEntity == "LeftValve")
		{
			SetWheelInteractionDisablesStuck("LeftValve", false);
			SetWheelStuckState("LeftValve", -1, false);
			SetLampLit("CentralGreenLight1", true, false);
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "LeftValve", 0.0f, false);
			AddTimer("LeftValveLightSequenceTimer1", 0.2f, "LeftValveLightSequencer");
			AddTimer("LeftValveLightSequenceTimer2", 1.2f, "LeftValveLightSequencer");
			AddTimer("LeftValveLightSequenceTimer3", 2.0f, "LeftValveLightSequencer");
			AddTimer("LeftValveLightSequenceTimer4", 2.7f, "LeftValveLightSequencer");
			AddTimer("LeftValveLightSequenceTimer5", 2.9f, "LeftValveLightSequencer");
			PlayPropAnimation("LeftValveGauge", "ontooff", 0.0f, false, "");
			DestroyParticleSystem("LeftValveSteam_1");
			DestroyParticleSystem("LeftValveSteam_2");
			DestroyParticleSystem("LeftValveSteam_3");
			DestroyParticleSystem("LeftValveSteam_4");
			DestroyParticleSystem("LeftValveSteam_5");
			DestroyParticleSystem("LeftValveSteam_6");
			DestroyParticleSystem("LeftValveSteam_7");
			StopSound("LVS1", 0.5f);
			StopSound("LVS2", 0.5f);
			StopSound("LVS3", 0.5f);
			StopSound("LVS4", 0.5f);
			UpdateNutcase();
			SetLocalVarInt("LeftValveOn", 1);
			//SET CHECKPOINT #2//
			CheckPoint("CP02_LeftValve", "CheckpointStart_1", "", "", "", false);
		}
		else if (asEntity == "BackCorridorValve")
		{
			SetWheelInteractionDisablesStuck("BackCorridorValve", false);
			SetWheelStuckState("BackCorridorValve", -1, false);
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "BackCorridorValve", 0.0f, false);
			PlayPropAnimation("BackCorridorValveGauge", "ontooff", 0.0f, false, "");
			SetSwingDoorLocked("SecretExitDoor", false, false);
			SetSwingDoorClosed("SecretExitDoor", false, false);
			SetEntityInteractionDisabled("SecretExitDoor", true);
			SetSwingDoorDisableAutoClose("SecretExitDoor", true);
			SetLocalVarInt("SecretExitDoorOpen", 1);
			AddBodyForce("SecretExitDoor_Body_door", -5000.0f, 0.0f, 0.0f, "world");
			DestroyParticleSystem("BackCorridorSteam_1");
			DestroyParticleSystem("BackCorridorSteam_2");
			DestroyParticleSystem("BackCorridorSteam_3");
			DestroyParticleSystem("BackCorridorSteam_4");
			DestroyParticleSystem("BackCorridorSteam_5");
			DestroyParticleSystem("BackCorridorSteam_6");
			DestroyParticleSystem("BackCorridorSteam_7");
			DestroyParticleSystem("BackCorridorSteam_8");
			StopSound("BCS1", 0.5f);
			StopSound("BCS2", 0.5f);
			StopSound("BCS3", 0.5f);
		}
		//CHECK VALVE ACTIVATION STATE//
		if (GetLocalVarInt("RightValveOn") == 1 && GetLocalVarInt("LeftValveOn") == 1 && GetLocalVarInt("BackAreaOpened") == 0)
		{
			SetEntityActive("ChildYard_1", false);
			SetEntityActive("ChildYard_2", false);
			SetEntityActive("GateSet1_1", false);
			SetEntityActive("GateSet1_2", false);
			SetEntityActive("GateSet2_1", true);
			SetEntityActive("GateSet2_2", true);
			AddEntityCollideCallback("Player", "Catwalk_VO", "VOPlayer", true, 1);
			SetParticleSystemActive("BackCorridorSteam_*", true);
			PlaySoundAtEntity("BCS1", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_1", 0.5f, true);
			PlaySoundAtEntity("BCS2", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_2", 0.5f, true);
			PlaySoundAtEntity("BCS3", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_3", 0.5f, true);
			SetLocalVarInt("BackAreaOpened", 1);
		}
	}
}
//END BACK AREA VALVE HANDLER//

//BACK AREA LIGHT SEQUENCERS//
void RightValveLightSequencer (string &in asTimer)
{
	if (asTimer == "RightValveLightSequenceTimer1")
	{
		SetLampLit("RightLamp_4", true, false);
		SetLightVisible("RightSpot_6", true);
		SetLightVisible("FanRightLight", true);
		SetLightVisible("FanRightLight2", true);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton", "RightLamp_4", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton_2D", "RightLamp_4", 0.0f, false);
		return;
	}
	else if (asTimer == "RightValveLightSequenceTimer2")
	{
		SetLampLit("RightLamp_1", true, false);
		SetLightVisible("RightSpot_1", true);
		SetLightVisible("RightSpot_2", true);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton_2D", "RightLamp_1", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton", "RightLamp_1", 0.0f, false);
		return;
	}
	else if (asTimer == "RightValveLightSequenceTimer3")
	{
		SetLampLit("RightLamp_3", true, false);
		SetLightVisible("RightSpot_5", true);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton_2D", "RightLamp_3", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton", "RightLamp_3", 0.0f, false);
		return;
	}
	else if (asTimer == "RightValveLightSequenceTimer4")
	{
		SetLampLit("RightLamp_2", true, false);
		SetLightVisible("RightSpot_3", true);
		SetLightVisible("RightSpot_4", true);
		SetLightVisible("RightPoint_1", true);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton_2D", "RightLamp_2", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_backarea_lighton", "RightLamp_3", 0.0f, false);
		return;
	}
	else if (asTimer == "RightValveLightSequenceTimer5")
	{
		PlaySoundAtEntity("", "afx_mansion_backarea_gate_open3D.snt", "CentralGate2", 0.0f, false);
		PlaySoundAtEntity("", "afx_mansion_backarea_gate_open2D.snt", "CentralGate2", 0.0f, false);
		SetMoveObjectState("CentralGate2", 1);
		return;
	}
}

