//RANDOM WIND//
void RandomSound (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Sound_StartWind_1"|| asChild == "Sound_StartWind_2"|| asChild == "Sound_StartWind_3"|| asChild == "Sound_StartWind_4"|| asChild == "Sound_StartWind_5"|| asChild == "Sound_StartWind_6")
	{	
	
	//START WIND
	AddTimer("InitRandomWindSoundCuePlayer", 3.0f, "RandWindSoundCues");
	
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_StartWind_1");
	RemoveEntityCollideCallback("Player", "Sound_StartWind_2");
	RemoveEntityCollideCallback("Player", "Sound_StartWind_3");
	RemoveEntityCollideCallback("Player", "Sound_StartWind_4");
	RemoveEntityCollideCallback("Player", "Sound_StartWind_5");
	RemoveEntityCollideCallback("Player", "Sound_StartWind_6");
	AddEntityCollideCallback("Player", "Sound_StopWind_1", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StopWind_2", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StopWind_3", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StopWind_4", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StopWind_5", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StopWind_6", "RandomSound", true, 1);
	
	AddDebugMessage("Wind Sounds START!", true);
	return;
	}
	
	else if (asChild == "Sound_StopWind_1"|| asChild == "Sound_StopWind_2"|| asChild == "Sound_StopWind_3"|| asChild == "Sound_StopWind_4"|| asChild == "Sound_StopWind_5"|| asChild == "Sound_StopWind_6")
	{
	//REMOVE OUTSIDE SOUND
	RemoveTimer("Player");
	RemoveTimer("RandWindSoundCues");
		
	//AREAS
	RemoveEntityCollideCallback("Player", "Sound_StopWind_1");
	RemoveEntityCollideCallback("Player", "Sound_StopWind_2");
	RemoveEntityCollideCallback("Player", "Sound_StopWind_3");
	RemoveEntityCollideCallback("Player", "Sound_StopWind_4");
	RemoveEntityCollideCallback("Player", "Sound_StopWind_5");
	RemoveEntityCollideCallback("Player", "Sound_StopWind_6");
	AddEntityCollideCallback("Player", "Sound_StartWind_1", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartWind_2", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartWind_3", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartWind_4", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartWind_5", "RandomSound", true, 1);
	AddEntityCollideCallback("Player", "Sound_StartWind_6", "RandomSound", true, 1);
			
	AddDebugMessage("Wind Sounds STOP!", true);
	return;
	}										
}
//END RANDOM WIND//

//RANDOM MASK ENTITY SPAWN HANDLER//
void RandomMaskInit (int lSetIndex) //Set 1: 9 10 12 14 16   Set 2: 9 10 11 13 15
{
	AddDebugMessage("Random Mask Set Spawned, Using Index #"+lSetIndex, false);
	if (lSetIndex == 1)
	{
		//MASK ACTIVATION
		SetEntityActive("RandMask9", true);
		SetEntityActive("RandMask10", true);
		SetEntityActive("RandMask12", true);
		SetEntityActive("RandMask14", true);
		SetEntityActive("RandMask16", true);
		//DESPAWN TRIGGER CALLBACK INITIALISATION
		AddEntityCollideCallback("Player", "RandMask9DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask10DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask12DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask14DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask16DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		return;
	}
	else if (lSetIndex == 2 || lSetIndex == 3)
	{
		SetEntityActive("RandMask9", true);
		SetEntityActive("RandMask10", true);
		SetEntityActive("RandMask11", true);
		SetEntityActive("RandMask13", true);
		SetEntityActive("RandMask15", true);
		//DESPAWN TRIGGER CALLBACK INITIALISATION
		AddEntityCollideCallback("Player", "RandMask9DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask10DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask11DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask13DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		AddEntityCollideCallback("Player", "RandMask15DespawnTrigger", "RandomMaskTriggerCallbackHandler", false, 1);
		return;
	}
	else
	{
		AddDebugMessage("Random Mask Handler - Index Out of Range!", false);
	}
}

void RandomMaskTriggerCallbackHandler (string &in asParent, string &in asChild, int alState)
{
	int lDespawnRandomiser = RandInt(1,2);
	AddDebugMessage("Despawn Randomiser set to: "+lDespawnRandomiser, false); 
	if (asChild == "RandMask9DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask9", false);
		RemoveEntityCollideCallback("Player", "RandMask9DespawnTrigger");
		AddDebugMessage("RandMask9 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask10DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask10", false);
		RemoveEntityCollideCallback("Player", "RandMask10DespawnTrigger");
		AddDebugMessage("RandMask10 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask11DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask11", false);
		RemoveEntityCollideCallback("Player", "RandMask11DespawnTrigger");
		AddDebugMessage("RandMask11 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask12DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask12", false);
		RemoveEntityCollideCallback("Player", "RandMask12DespawnTrigger");
		AddDebugMessage("RandMask12 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask13DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask13", false);
		RemoveEntityCollideCallback("Player", "RandMask13DespawnTrigger");
		AddDebugMessage("RandMask13 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask14DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask14", false);
		RemoveEntityCollideCallback("Player", "RandMask14DespawnTrigger");
		AddDebugMessage("RandMask14 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask15DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask15", false);
		RemoveEntityCollideCallback("Player", "RandMask15DespawnTrigger");
		AddDebugMessage("RandMask15 DESPAWNED", false);
		return;
	}
	else if (asChild == "RandMask16DespawnTrigger" && lDespawnRandomiser == 2)
	{
		SetEntityActive("RandMask16", false);
		RemoveEntityCollideCallback("Player", "RandMask16DespawnTrigger");
		AddDebugMessage("RandMask16 DESPAWNED", false);
		return;
	}
}
//END RANDOM MASK HANDLER//

