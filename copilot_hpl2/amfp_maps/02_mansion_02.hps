//SERVANT HALLWAY DOOR SLAM//
void PigDoorCollideWithPig(string &in asParent, string &in asChild, int alState)
{
	SetSwingDoorLocked("PigSlamDoor", true, true);
	SlamEvent("PigSlamDoor");
}

void SlamEvent (string &in asEntity)
{
	PlaySoundAtEntity("", "afx_mansion_pig_slam_door_1.snt", "PigSlamDoor", 0, false);
	PlaySoundAtEntity("", "afx_mans_short_threat.snt", "Player", 0, false);
	StopSound("doorscratching", 0);
	MandusReactionPlayer("Scared", 0.1f);
	AddPropForce("PigSlamDoor", 0.0f, 0.0f, 6000.0f, "world");
	CreateParticleSystemAtEntity("", "ps_dust_impact_vert.ps", "PigSlamParticleSource", false);
}
//END SERVANT HALLWAY DOOR SLAM//


//ENTRANCE DOOR EVENT//
void EntranceDoorInteractTracker (string &in asEntity)
{
	SetLocalVarInt("interactedwithentrancedoorbool", 1);
}

void EntranceDoorLookTracker (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("lookentrancedoor", 1);
		AddDebugMessage("lookentrancedoor = 1", false);
	}
	else
	{
		SetLocalVarInt("lookentrancedoor", 0);
		AddDebugMessage("lookentrancedoor = 0", false);
	}
	EntranceDoorEventUpdater();
}

void EntranceDoorProximityTracker (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("inentranceprox", 1);
		AddDebugMessage("Entrance Prox = 1", false);
	}
	else
	{
		SetLocalVarInt("inentranceprox", 0);
		AddDebugMessage("Entrance Prox = 0", false);
	}
	EntranceDoorEventUpdater();
}

void EntranceDoorEventUpdater()
{
	if (GetLocalVarInt("interactedwithentrancedoorbool") == 1 && GetLocalVarInt("inentranceprox") == 0 && GetLocalVarInt("lookentrancedoor") == 0 && GetLocalVarInt("entrancedooreventcompleted") == 0)
	{
		PlaySoundAtEntity("", "mansion_bigdoor_locked.snt", "EntranceDoorSource", 2, false);
		PlaySoundAtEntity("", "afx_spooky_whoosh_bug.snt", "EntranceDoorSource", 0, false);
		PlaySoundAtEntity("", "afx_spooky_metal_creak.snt", "EntranceDoorSource", 4, false);
		SetLocalVarInt("entrancedooreventcompleted", 1);
		AddDebugMessage("Entrance Door Event: COMPLETED!", false);
	}
}
//END ENTRANCE DOOR EVENT//

//TROPHY ROOM SECRET DOOR SEQUENCE//
void TrophyRoomSecretDoorEvent (string &in asParent, string &in asChild, int alState)
{
	if(GetLocalVarInt("PlayerInBearArea") == 1) return;
	
	if (alState == 1)
	{
		AddDebugMessage("Bear Moved = true", false);
		if (GetLocalVarInt("BearHasMovedOnce") == 0)
		{
			SetEntityPlayerInteractCallback("Bear", "", false);
			PlayMusic("music_mans_backroom.ogg", false, 1.0f, 2.0f, 0, false);
			RemoveEntityCollideCallback("Player", "MuffledGateTrigger");
		}
		AddDebugMessage("Unlocked Secret Door", false);
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "TrophyRoomSecretDoor", 0, false);
		SetSwingDoorDisableAutoClose("TrophyRoomSecretDoor", true);
		SetSwingDoorClosed("TrophyRoomSecretDoor", false, false);
		SetSwingDoorLocked("TrophyRoomSecretDoor", false, false);
		AddBodyForce("TrophyRoomSecretDoor_Body_door", -20000.0f, 0.0f, 0.0f, "world");
		SetLocalVarInt("BearHasMovedOnce", 1);
		return;
	}
	else if (alState == -1)
	{
		PlaySoundAtEntity("", "afx_mans_killroom_unlock", "TrophyRoomSecretDoor", 0, false);
		SetSwingDoorClosed("TrophyRoomSecretDoor", true, false);
		SetSwingDoorLocked("TrophyRoomSecretDoor", true, false);
		return;
	}
}
//END SECRET DOOR SEQUENCE//

//MAN PIG HOWLS (TIMER TRIGGERS)//
void ManpigHowls (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ManpigHowlTrigger")
	{
		AddTimer("ManPigHowl", 3.0f, "ManpigHowlsMainCalls");
		GiveHint("run", "Hints", "RunHint", -1);
		return;
	}
	else if (asChild == "ManpigHowlOutsideTrigger")
	{
		CollideBeginWretchRoad("", "", 1);
		AddTimer("ManPigHowlOutside", 2.0f, "ManpigHowlsMainCalls");
		return;
	}
}
//END MAN PIG HOWLS (END TIMER TRIGGERS)//

//MAN PIG HOWLS (MAIN CALLS)//
void ManpigHowlsMainCalls (string &in asTimer)
{
	//MAN PIG HOWL//
	if (asTimer == "ManPigHowl")
	{
		AddDebugMessage("Pig Howl AROOO!", false);
		PlaySoundAtEntity("Pig_Howl", "afx_mansion_manpig_howl", "Player", 0, false);
		FadeImageTrailTo(2.5f, 0.5f);
		FadeRadialBlurTo(2.0f, 0.5f);
		AddTimer("Slowdown", 0.5f, "ManpigHowlsMainCalls");
		AddTimer("ReturnToNormalHowl", 4.4f, "ManpigHowlsMainCalls");
		return;
	}
	//END MAN PIG HOWL//
	
	//MAN PIG HOWL OUTSIDE//
	else if (asTimer == "ManPigHowlOutside")
	{
		AddDebugMessage("Pig Howl AROOO!", false);
		PlaySoundAtEntity("Pig_Howl", "afx_mansion_manpig_howl_outside", "wretch_road", 0, false);
		FadeImageTrailTo(2.5f, 0.5f);
		FadeRadialBlurTo(2.0f, 0.5f);
		AddTimer("ReturnToNormalHowl", 4.4f, "ManpigHowlsMainCalls");
		return;
	}
	//END MAN PIG HOWL OUTSIDE//
	
	//SLOWDOWN TIMER//
	else if (asTimer == "Slowdown")
	{
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		return;
	}
	//END SLOWNDOWN TIMER//
	
	//RETURN TO NORMAL//
	else if (asTimer == "ReturnToNormalHowl")
	{
		FadeImageTrailTo(0.0f, 2.0f);
		FadeRadialBlurTo(0.0f, 2.0f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		StopPlayerLookAt();
		MandusReactionPlayer("Breath", 0.25f);
	}
	//END RETURN TO NORMAL//
}
//END MAN PIG HOWLS (MAIN CALLS)//

//MUFFLED GATE//
void MuffledGateSound (string &in asParent, string &in asChild, int alState)
{
	AddTimer("MuffledGate", 3.0f, "MuffledGateMainCall");
}

void MuffledGateMainCall (string &in asTimer)
{	
	AddDebugMessage("Muffled Gate Sound Triggered baby", false);
	PlaySoundAtEntity("Gate2D", "afx_mansion_backarea_gate_muffled_2D", "CentralGate1", 0, false);
	PlaySoundAtEntity("Gate3D", "afx_mansion_backarea_gate_muffled", "CentralGate1", 0, false);
}
//END MUFFLED GATE//

//EERIE CORRIDOR//
void CorridorLookTracker (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("LookingDownCorridor", 1);
		AddDebugMessage("LookingDownCorridor = 1", false);
	}
	else
	{
		SetLocalVarInt("LookingDownCorridor", 0);
		AddDebugMessage("LookingDownCorridor = 0", false);
	}
}
void EerieCorridorEvent (string &in asParent, string &in asChild, int alState)
{
	if (GetLocalVarInt("LookingDownCorridor") == 0)
	{
		AddDebugMessage("Eerie Corridor Event", false);
		PlaySoundAtEntity("", "afx_spooky_stereo_whisper.snt", "Player", 0.0f, false);
		SetParticleSystemActive("CorridorWind_*", true);
		AddTimer("EerieCorridorTimer1", 0.5f, "EerieCorridorTimedEvents");
		AddTimer("EerieCorridorTimer2", 0.6f, "EerieCorridorTimedEvents");
		AddTimer("EerieCorridorTimer3", 0.7f, "EerieCorridorTimedEvents");
		AddTimer("EerieCorridorTimer4", 0.8f, "EerieCorridorTimedEvents");
		AddTimer("EerieCorridorTimer5", 0.9f, "EerieCorridorTimedEvents");
		AddTimer("EerieCorridorRestorePhysics", 12.0f, "EerieCorridorTimedEvents");
	}
}

void EerieCorridorTimedEvents (string &in asTimer)
{
	if (asTimer == "EerieCorridorTimer1")
	{
		SetSwingDoorClosed("wood_panneling_door_4", true, false);
		return;
	}
	else if (asTimer == "EerieCorridorTimer2")
	{
		SetPhysicsAutoDisable("chandelier_nice_16", false);
		AddPropForce("chandelier_nice_16", 100.0f, 0.0f, 520.0f, "world");
		return;
	}
	else if (asTimer == "EerieCorridorTimer3")
	{
		SetPhysicsAutoDisable("chandelier_nice_18", false);
		AddPropForce("chandelier_nice_18", 50.0f, 0.0f, 480.0f, "world");
		return;
	}
	else if (asTimer == "EerieCorridorTimer4")
	{
		SetPhysicsAutoDisable("chandelier_nice_17", false);
		AddPropForce("chandelier_nice_17", -50.0f, 0.0f, 440.0f, "world");
		return;
	}
	else if (asTimer == "EerieCorridorTimer5")
	{
		SetPhysicsAutoDisable("chandelier_nice_15", false);
		AddPropForce("chandelier_nice_15", 90.0f, 0.0f, 400.0f, "world");
		return;
	}
	else if (asTimer == "EerieCorridorRestorePhysics")
	{
		SetPhysicsAutoDisable("chandelier_nice_16", true);
		SetPhysicsAutoDisable("chandelier_nice_18", true);
		SetPhysicsAutoDisable("chandelier_nice_17", true);
		SetPhysicsAutoDisable("chandelier_nice_15", true);
		return;
	}
}
//END EERIE CORRIDOR//

//ROTATING BATH//
void RotatingBathHandler (string &in asEntity, int alState)
{
	if (alState == -1 && GetLocalVarInt("BathState") == 0)
	{
		SetMoveObjectState("RotatingBath", 1);
		PlaySoundAtEntity("", "afx_event_mansion_bathturn_fwd_2D", "RotatingBath", 0, false);
		PlaySoundAtEntity("", "afx_event_mansion_bathturn_fwd_3D", "RotatingBath", 0, false);
		PlayMusic("music_bath_spin_sting_24.ogg", false, 0.6f, 0.0f, 6, false);
		SetLeverInteractionDisablesStuck("BathLever", false);
		SetLeverStuckState("BathLever", -1, false);
		AddTimer("ReinitialiseBathLeverTimer", 5.0f, "ReinitialiseBathLever");
		SetEntityActive("BathTempBlockBox", false);
		RemoveEntityCollideCallback("Player", "MuffledGateTrigger");
		SetLocalVarInt("BathState", 1);
		return;
	}
	else if (alState == 1 && GetLocalVarInt("BathState") == 1)
	{
		SetMoveObjectState("RotatingBath", 0);
		SetLeverInteractionDisablesStuck("BathLever", false);
		PlaySoundAtEntity("", "afx_event_mansion_bathturn_back_2D", "RotatingBath", 0, false);
		PlaySoundAtEntity("", "afx_event_mansion_bathturn_back_3D", "RotatingBath", 0, false);
		SetLeverStuckState("BathLever", 1, false);
		AddTimer("ReinitialiseBathLeverTimer", 5.0f, "ReinitialiseBathLever");
		SetEntityActive("BathTempBlockBox", true);
		SetLocalVarInt("BathState", 0);
		return;
	}
}

void ReinitialiseBathLever (string &in asTimer)
{
	AddDebugMessage("Bath Lever Reinitialised", false);
	SetLeverInteractionDisablesStuck("BathLever", true);
}
//END ROTATING BATH//

//SLIDING BEAR//
void BearHandler (string &in asEntity, int alState)
{
	if (alState == -1 && GetLocalVarInt("BearState") == 0)
	{
		AddDebugMessage("Bear State = 1", false);
		SetMoveObjectState("Bear", 1);
		PlaySoundAtEntity("", "SAMBIENCE", "Bear", 0, false);
		SetLeverInteractionDisablesStuck("BearLever", false);
		SetLeverStuckState("BearLever", -1, false);
		AddTimer("ReinitialiseBearLeverTimer", 5.0f, "ReinitialiseBearLever");
		SetLocalVarInt("BearState", 1);
		PlaySoundAtEntity("", "afx_mansion_bear_slide_3D", "Bear", 0, false);
		PlaySoundAtEntity("", "afx_mansion_bear_slide_2D", "Bear", 0, false);
		return;
	}
	else if (alState == 1 && GetLocalVarInt("BearState") == 1)
	{
		AddDebugMessage("Bear State = 0", false);
		SetMoveObjectState("Bear", 0);
		SetLeverInteractionDisablesStuck("BearLever", false);
		PlaySoundAtEntity("", "SAMBIENCE", "Bear", 0, false);
		SetLeverStuckState("BearLever", 1, false);
		AddTimer("ReinitialiseBearLeverTimer", 5.0f, "ReinitialiseBearLever");
		PlaySoundAtEntity("", "afx_mansion_bear_slide_3D", "Bear", 0, false);
		PlaySoundAtEntity("", "afx_mansion_bear_slide_2D", "Bear", 0, false);
		SetLocalVarInt("BearState", 0);
		return;
	}
}

void ReinitialiseBearLever (string &in asTimer)
{
	AddDebugMessage("Bear Lever Reinitialised", false);
	SetLeverInteractionDisablesStuck("BearLever", true);
}
//END SLIDING BEAR//

