void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Child1&2Trigger_1" || asChild == "Child1&2Trigger_2")
	{
		SetEntityActive("Child1", true);
		AddEnemyPatrolNode("Child1", "PathNodeArea_1", 0.0f, "", false);
		AddEnemyPatrolNode("Child1", "PathNodeArea_5", 0.0f, "", false);
		SetEntityActive("Child1a", true);
		AddEnemyPatrolNode("Child1a", "PathNodeArea_1", 0.0f, "", false);
		AddEnemyPatrolNode("Child1a", "PathNodeArea_5", 0.0f, "", false);
		AddTimer("DelayChild2", 0.1, "TimerDelayChild02");
		RemoveEntityCollideCallback("Player", "Child1&2Trigger_1");
		RemoveEntityCollideCallback("Player", "Child1&2Trigger_2");
		
		if (asChild == "Child1&2Trigger_1")
		{
			PlaySoundAtEntity("ChildLaugh", "afx_event_mansion_mans02_child_laugh_hall.snt", "LaughterSource1", 0.0f, false);
		}
		else
		{
			PlaySoundAtEntity("ChildLaugh", "afx_event_mansion_mans02_child_laugh_hall.snt", "LaughterSource2", 0.0f, false);
		}
		return;
	}
	else if (asChild == "BackCorridorChild1Trigger")
	{
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);		
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		AddTimer("ReturnToNormalHowl", 5.0f, "ManpigHowlsMainCalls");
		AddDebugMessage("Child1", false);
		AddTimer("MansionTwo3", 1.5f, "TimerDelayedHint");
		SetEntityActive("BackCorridorChild1", true);
		AddEnemyPatrolNode("BackCorridorChild1", "PathNodeArea_11", 0.0f, "", false);
		return;
	}
	else if (asChild == "BackCorridorChild2Trigger")
	{
		AddDebugMessage("Child2", false);
		SetEntityActive("BackCorridorChild2", true);
		AddEnemyPatrolNode("BackCorridorChild2", "PathNodeArea_10", 0.0f, "", false);
		return;
	}
	else if (asChild == "ChildLastTrigger")
	{
		SetEntityActive("Child_Last", true);
		AddEnemyPatrolNode("Child_Last", "PathNodeArea_12", 0.0f, "", false);
		AddEnemyPatrolNode("Child_Last", "PathNodeArea_13", 0.0f, "", false);
		AddEnemyPatrolNode("Child_Last", "PathNodeArea_14", 0.0f, "", false);
		return;
	}
	else if (asChild == "Child1KillTrigger")
	{
		ClearEnemyPatrolNodes("Child1");
		SetEntityActive("Child1", false);
		ClearEnemyPatrolNodes("Child1a");
		SetEntityActive("Child1a", false);
		return;
	}
	else if (asChild == "Child2KillTrigger")
	{
		ClearEnemyPatrolNodes("Child2");
		//FadeEnemyToSmoke("Child2", false);
		ClearEnemyPatrolNodes("Child2a");
		//FadeEnemyToSmoke("Child2a", false);
		SetEntityActive("Child2", false);
		SetEntityActive("Child2a", false);
		return;
	}
	else if (asChild == "BackCorridorChild1KillTrigger")
	{
		ClearEnemyPatrolNodes("BackCorridorChild1");
		SetEntityActive("BackCorridorChild1", false);
		return;
	}
	else if (asChild == "BackCorridorChild2KillTrigger")
	{
		ClearEnemyPatrolNodes("BackCorridorChild2");
		SetEntityActive("BackCorridorChild2", false);
		return;
	}
	else if (asChild == "ChildLastKillTrigger")
	{
		ClearEnemyPatrolNodes("Child_Last");
		SetEntityActive("Child_Last", false);
		return;
	}
}
//END CHILD EVENT HANDLER//

