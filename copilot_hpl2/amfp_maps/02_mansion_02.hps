// ---------------------------------------------------
// START CHILDREN IN YARD
// -----------------------------------------------------

void CollideChildYard(string &in asParent, string &in asChild, int alState)
{
	PlayGuiSound("afx_cellar_child_laughter.wav", 0.6f);
	
	MandusReactionPlayer("Scared", 0.5f);
	MandusReactionPlayer("Breath", 2.5f);
	MandusReactionPlayer("Breath", 4.5f);
	
	FadeImageTrailTo(2.0f, 1.0f);
	SetPlayerMoveSpeedMul(0.6f);
	SetPlayerLookSpeedMul(0.6f);
	
	AddTimer("extra_voice", 1, "TimerResetPlayerYard");
	AddTimer("reset_1", 2, "TimerResetPlayerYard");
	AddTimer("reset_2", 4, "TimerResetPlayerYard");
	AddTimer("reset_3", 6, "TimerResetPlayerYard");
	AddTimer("reset_4", 8, "TimerResetPlayerYard");
	
	SetEntityActive(asChild+"_1", true);
	SetEntityActive(asChild+"_2", true);
	AddEnemyPatrolNode(asChild+"_1", "PathNodeArea_47", 0.0f, "", false);
	AddEnemyPatrolNode(asChild+"_2", "PathNodeArea_47", 0.0f, "", false);
	
	SetEntityActive("ChildYard_1", false);
	SetEntityActive("ChildYard_2", false);
}

void CollideChildYardGate(string &in asParent, string &in asChild, int alState)
{
	SetSwingDoorClosed("GateSet1_1", true, false);
	SetSwingDoorLocked("GateSet1_1", true, false);
	
	StartScreenShake(0.2, .1, 0, 0);
	StartLampFlicker("streetlight_ground_34");
	StartLampFlicker("streetlight_ground_35");
	PlayGuiSound("cellar_light_flicker_louder", 0.7f);
	PlaySoundAtEntity("slam", "cagedbed_close", "GateSet1_1", 0.15, false);
}

void CollideChildYardDoor(string &in asParent, string &in asChild, int alState)
{
	StopLampFlicker("streetlight_ground_34");
	StopLampFlicker("streetlight_ground_35");
	
	SetSwingDoorClosed("tunnels_door_1", true, false);
	SetEntityActive("ChildYard_1_1", false);
	SetEntityActive("ChildYard_1_2", false);
	SetEntityActive("ChildYard_2_1", false);
	SetEntityActive("ChildYard_2_2", false);
}

void TimerResetPlayerYard(string &in asTimer)
{
	if(asTimer == "extra_voice")
		PlayGuiSound("afx_cellar_child_laughter.wav", 0.2);
		
	if(asTimer == "reset_1")
	{
		SetPlayerMoveSpeedMul(0.4f);
		SetPlayerLookSpeedMul(0.4f);	
	}
	
	if(asTimer == "reset_2")
	{
		SetPlayerMoveSpeedMul(0.6f);
		SetPlayerLookSpeedMul(0.6f);	
	}
	
	if(asTimer == "reset_3")
	{
		SetPlayerMoveSpeedMul(0.8f);
		SetPlayerLookSpeedMul(0.8f);	
	}
	
	if(asTimer == "reset_4")
	{
		FadeImageTrailTo(0, 0.5f);
		SetPlayerMoveSpeedMul(1);
		SetPlayerLookSpeedMul(1);
	}
}

// ---------------------------------------------------
// END CHILDREN IN YARD
// -----------------------------------------------------


