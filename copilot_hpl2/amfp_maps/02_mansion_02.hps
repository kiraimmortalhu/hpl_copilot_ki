	//INITIALISE RANDOM SOUND CUE PLAYER//
	{
		AddTimer("InitRandomCreakSoundCuePlayer", 1.0f, "RandCreakSoundCues");
		AddTimer("InitRandomHitSoundCuePlayer", 2.0f, "RandHitSoundCues");
		AddTimer("InitRandomDiningSoundCuePlayer", 3.0f, "RandDiningSoundCues");
		AddTimer("InitRandomTrophySoundCuePlayer", 4.0f, "RandTrophySoundCues");
		AddTimer("InitRandomBackroomMetalSoundCuePlayer", 5.0f, "RandBackroomMetalSoundCues");
		AddTimer("InitRandomCourtyard1SoundCuePlayer", 6.0f, "RandCourtyard1SoundCues");
		AddTimer("InitRandomCourtyard2SoundCuePlayer", 7.0f, "RandCourtyard2SoundCues");
		AddTimer("InitRandomMuseum2SoundCuePlayer", 8.0f, "RandMuseum2SoundCues");
		AddTimer("InitRandomMuseumSoundCuePlayer", 9.0f, "RandMuseumSoundCues");
	}
	
	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}
	
	//PRELOAD PARTICLES//
	{
		PreloadParticleSystem("ps_dust_impact_vert.ps");
	}
	
	//LIGHT STATES//
	{
		if (GetLocalVarInt("RightValveOn") == 0)
		{
			SetLampLit("RightLamp_1", false, false);
			SetLampLit("RightLamp_2", false, false);
			SetLampLit("RightLamp_3", false, false);
			SetLampLit("RightLamp_4", false, false);
			SetLightVisible("RightSpot_1", false);
			SetLightVisible("RightSpot_2", false);
			SetLightVisible("RightSpot_3", false);
			SetLightVisible("RightSpot_4", false);
			SetLightVisible("RightSpot_5", false);
			SetLightVisible("RightSpot_6", false);
			SetLightVisible("RightPoint_1", false);
			SetLightVisible("FanRightLight", false);
			SetLightVisible("FanRightLight2", true);
		}
		else
		{
			SetLampLit("RightLamp_1", true, false);
			SetLampLit("RightLamp_2", true, false);
			SetLampLit("RightLamp_3", true, false);
			SetLampLit("RightLamp_4", true, false);
			SetLightVisible("RightSpot_1", true);
			SetLightVisible("RightSpot_2", true);
			SetLightVisible("RightSpot_3", true);
			SetLightVisible("RightSpot_4", true);
			SetLightVisible("RightSpot_5", true);
			SetLightVisible("RightSpot_6", true);
			SetLightVisible("RightPoint_1", true);
			SetLightVisible("FanRightLight", true);
			SetLightVisible("FanRightLight2", true);
		}
		if (GetLocalVarInt("LeftValveOn") == 0)
		
		{
			SetLampLit("LeftLamp_1", false, false);
			SetLampLit("LeftLamp_2", false, false);
			SetLampLit("LeftLamp_3", false, false);
			SetLampLit("LeftLamp_4", false, false);
			SetLightVisible("LeftSpot_1", false);
			SetLightVisible("LeftSpot_2", false);
			SetLightVisible("LeftSpot_3", false);
			SetLightVisible("LeftSpot_4", false);
			SetLightVisible("LeftSpot_5", false);
			SetLightVisible("LeftSpot_6", false);
			SetLightVisible("LeftSpot_7", false);
			SetLightVisible("LeftSpot_8", false);
			SetLightVisible("LeftPoint_1", false);
			SetLightVisible("FanLeftLight", false);
			SetLightVisible("FanLeftLight2", false);
		}
		else
		{
			SetLampLit("LeftLamp_1", true, false);
			SetLampLit("LeftLamp_2", true, false);
			SetLampLit("LeftLamp_3", true, false);
			SetLampLit("LeftLamp_4", true, false);
			SetLightVisible("LeftSpot_1", true);
			SetLightVisible("LeftSpot_2", true);
			SetLightVisible("LeftSpot_3", true);
			SetLightVisible("LeftSpot_4", true);
			SetLightVisible("LeftSpot_5", true);
			SetLightVisible("LeftSpot_6", true);
			SetLightVisible("LeftSpot_7", true);
			SetLightVisible("LeftSpot_8", true);
			SetLightVisible("LeftPoint_1", true);
			SetLightVisible("FanLeftLight", true);
			SetLightVisible("FanLeftLight2", false);
		}
	}
	
	//PARTICLE SYSTEM STATES//
	{
		/*SetParticleSystemActive("TransSteam1", false);
		SetParticleSystemActive("TransSteam2", false);
		SetParticleSystemActive("TransDust", false);
		SetParticleSystemActive("GreatHallDustParticles_*", false);
		SetParticleSystemActive("GreatHallDustCloudParticles_*", false);   
		SetParticleSystemActive("CorridorWind_*", false);
		SetParticleSystemActive("TransRoomCreakDust_1", false);
		SetParticleSystemActive("TransRoomCreakDust_2", false);
		SetParticleSystemActive("TransRoomCreakDust_3", false);
		SetParticleSystemActive("TransRoomStairDust", false);*/
		if (GetLocalVarInt("RightValveOn") == 1)
		{
			SetParticleSystemActive("RightValveSteam_*", false);
		}
		if (GetLocalVarInt("LeftValveOn") == 1)
		{
			SetParticleSystemActive("LeftValveSteam_*", false);
		}
		if(GetLocalVarInt("SecretExitDoorOpen") == 1)
		{
			SetParticleSystemActive("BackCorridorSteam_*", false);
		}
	}
	
	//SOUND CUES//
	{
		if (GetLocalVarInt("RightValveOn") == 0)
		{
			PlaySoundAtEntity("RVS1", "afx_cellar_steam_loop.snt", "RightValveSteamSource_1", 0.5f, true);
			PlaySoundAtEntity("RVS2", "afx_cellar_steam_loop.snt", "RightValveSteamSource_2", 0.5f, true);
			PlaySoundAtEntity("RVS3", "afx_cellar_steam_loop.snt", "RightValveSteamSource_3", 0.5f, true);
			PlaySoundAtEntity("RVS4", "afx_cellar_steam_loop.snt", "RightValveSteamSource_4", 0.5f, true);
		}
		if (GetLocalVarInt("LeftValveOn") == 0)
		{
			PlaySoundAtEntity("LVS1", "afx_cellar_steam_loop.snt", "LeftValveSteamSource_1", 0.5f, true);
			PlaySoundAtEntity("LVS2", "afx_cellar_steam_loop.snt", "LeftValveSteamSource_2", 0.5f, true);
			PlaySoundAtEntity("LVS3", "afx_cellar_steam_loop.snt", "LeftValveSteamSource_3", 0.5f, true);
			PlaySoundAtEntity("LVS4", "afx_cellar_steam_loop.snt", "LeftValveSteamSource_4", 0.5f, true);
		}
		if(GetLocalVarInt("SecretExitDoorOpen") == 0 && GetLocalVarInt("BackAreaOpened") == 1)
		{
			PlaySoundAtEntity("BCS1", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_1", 0.5f, true);
			PlaySoundAtEntity("BCS2", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_2", 0.5f, true);
			PlaySoundAtEntity("BCS3", "afx_cellar_steam_loop.snt", "BackCorridorSteamSource_3", 0.5f, true);
		}
	}
	
	//ANIMATION STATES//
	{
		if (GetLocalVarInt("RightValveOn") == 0)
		{
			PlayPropAnimation("RightValveGauge", "on", 1.0f, true, "");
		}
		else
		{
			PlayPropAnimation("RightValveGauge", "off", 1.0f, true, "");
		}
		if (GetLocalVarInt("LeftValveOn") == 0)
		{
			PlayPropAnimation("LeftValveGauge", "on", 1.0f, true, "");
		}
		else
		{
			PlayPropAnimation("LeftValveGauge", "off", 1.0f, true, "");
		}
		if (GetLocalVarInt("SecretExitDoorOpen") == 0)
		{
			PlayPropAnimation("BackCorridorValveGauge", "on", 1.0f, true, "");
		}
		else
		{
			PlayPropAnimation("BackCorridorValveGauge", "off", 1.0f, true, "");
		}
	}
	
	//ENTITY STATES//
	{
		if (GetGlobalVarInt("PlayerHasALantern") == 1)
		{
			SetEntityActive("lantern_*", false);
		}
	}
	
	//ENTITY INTERACTION// 
	{
		SetEntityInteractionDisabled("RandMask9", true);
		SetEntityInteractionDisabled("RandMask10", true);
		SetEntityInteractionDisabled("RandMask11", true);
		SetEntityInteractionDisabled("RandMask12", true);
		SetEntityInteractionDisabled("RandMask13", true);
		SetEntityInteractionDisabled("RandMask14", true);
		SetEntityInteractionDisabled("RandMask15", true);
		SetEntityInteractionDisabled("RandMask16", true);
		SetEntityInteractionDisabled("GateSet1_1", true);
		SetEntityInteractionDisabled("GateSet1_2", true);
		SetEntityInteractionDisabled("GateSet2_1", true);
		SetEntityInteractionDisabled("GateSet2_2", true);
		SetEntityInteractionDisabled("CorridorChairInit", true);
		SetEntityInteractionDisabled("PictureFrameInit", true);
	}
	
	//ENEMY STATES//
	{
		SetEnemyMoveType("Child1", "RunBiped");
		SetEnemyDisableTriggers("Child1", true);
		SetEnemyMoveType("Child2", "RunBiped");
		SetEnemyDisableTriggers("Child2", true);
		SetEnemyMoveType("BackCorridorChild1", "WalkBiped");
		SetEnemyDisableTriggers("BackCorridorChild1", true);
		SetEnemyMoveType("BackCorridorChild2", "WalkBiped");
		SetEnemyDisableTriggers("BackCorridorChild2", true);
		SetEnemyMoveType("Child_Last", "RunBiped");
		SetEnemyDisableTriggers("Child_Last", true);
		
		SetEnemyMoveType("ChildYard_1_1", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_1_1", true);
		SetEnemyMoveType("ChildYard_1_2", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_1_2", true);
		SetEnemyMoveType("ChildYard_2_1", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_2_1", true);
		SetEnemyMoveType("ChildYard_2_2", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_2_2", true);
		SetEnemyMoveType("ChildYard_3_1", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_3_1", true);
		SetEnemyMoveType("ChildYard_3_2", "RunBiped");
		SetEnemyDisableTriggers("ChildYard_3_2", true);
	}
	
	//AUTOSAVE//
	{
		AutoSave();
	}
}

void OnLeave()
{
	SetPlayerMoveSpeedMul(1);
	SetPlayerRunSpeedMul(1);
	
	SetLanternDisabled(false);

	SetupLoadScreen("LoadingText", "Cellar_", 3, "game_loading_cellar.jpg");
}

