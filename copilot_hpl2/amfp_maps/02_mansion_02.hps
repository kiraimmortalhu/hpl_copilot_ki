void InteractBear(string &in asEntity)
{
	AddTimer(asEntity, 0.2, "TimerPushBear");
}

void TimerPushBear(string &in asEntity)
{
	AddPropForce(asEntity, 0,0,-300, "World");
	AddDebugMessage("Push", false);
	SetEntityPlayerInteractCallback(asEntity, "InteractBear", true);
}

void ColliderNoBearInteract(string &in asParent, string &in asChild, int alState)
{
	SetLocalVarInt("PlayerInBearArea", alState);
}
