//RANDOMISED SOUND CUE PLAYER//
void RandCreakSoundCues(string &in asTimer)
{
	string[] sCueSources = {"SpookyCreak_1", "SpookyCreak_2", "SpookyCreak_3", "SpookyCreak_4" };
	asTimer = sCueSources[RandInt (0, 3)];
	PlaySoundAtEntity(asTimer, "afx_spooky_door_creaky.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Footstep Hall Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(7.0f, 15.0f), "RandCreakSoundCues");
}

