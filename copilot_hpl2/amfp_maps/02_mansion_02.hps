//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "MusicRoomMusicTrigger")
	{
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_2D.snt", "PianoSource", 10, true);
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_3D.snt", "PianoSource", 10, true);
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger_1");
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger_2");
		return;
	}
	else if (asChild == "MusicRoomMusicTrigger_1")
	{
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_2D.snt", "PianoSource", 10, true);
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_3D.snt", "PianoSource", 10, true);
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger");
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger_2");
		return;
	}
	else if (asChild == "MusicRoomMusicTrigger_2")
	{
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_2D.snt", "PianoSource", 10, true);
		PlaySoundAtEntity("", "amb_mansion_mansion02_diningroom_music_3D.snt", "PianoSource", 10, true);
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger");
		RemoveEntityCollideCallback("Player", "MusicRoomMusicTrigger_1");
		return;
	}
	else if (asChild == "GoingOutsideMusicTrigger")
	{
		PlayMusic("music_mans_going_outside.ogg", false, 1.0f, 0.0f, 5, false);
		PlaySoundAtEntity("hauntingbells", "amb_mans_hauntingbells.snt", "Player", 10, true);
		StopSound("doorscratching", 0);
		return;
	}
	else if (asChild == "EnterCellarMusic")
	{
		PlayMusic("Enter_cellar_118.ogg", false, 1.0f, 0.0f, 6, false);
		StopSound("hauntingbells", 5.0f);
		return;
	}
	
	else if (asChild == "FreakRoomSting")
	{
		PlayMusic("Freak_room_110.ogg", false, 1.0f, 0.0f, 6, false);
		return;
	}
}
//END MUSIC PLAYER//

//TRIGGERED VO PLAYER//
void VOPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "main_hall_2_VO")
	{
		AddEffectVoice("vo_mansion2_trigger_child_01.ogg", "", "Voice", "vo_mansion2_trigger_child_01", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "Switchboard_gate_opens_VO")
	{
		AddEffectVoice("v0_mansion2_trigger_child_03.ogg", "", "Voice", "v0_mansion2_trigger_child_03", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "yard_VO")
	{
		AddEffectVoice("v0_mansion2_trigger_child_05.ogg", "", "Voice", "v0_mansion2_trigger_child_05", false, "", 0.0f, 0.0f);
		return;
	}
	else if (asChild == "Catwalk_VO")
	{
		AddEffectVoice("vo_mansion02_catwalk_flashback_mandus_01", "", "Voice", "vo_mansion02_catwalk_flashback_mandus_01", false, "", 0.0f, 0.0f);
		AddTimer("vo_mansion02_catwalk_flashback_mandus_02", 5.65f, "TimerExtraVoiceEffects");
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);		
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerLookSpeedMul(0.5f);
		AddTimer("ReturnToNormalHowl", 12.5f, "ManpigHowlsMainCalls");
		//StartPlayerLookAt("Catwalk_VO_Lookat", 0.25f, 0.5f, "");
		return;
	}
	else if (asChild == "BedroomFlashback_VO")
	{
		RemoveTimer("ReturnToNormal");
		AddTimer("ReturnToNormal", 0, "PostSeeBloodEvent");
		AddTimer("VoiceThing", 0.05, "PostPoneVoice");
		//StartPlayerLookAt("BedroomFlashbackLookat", 0.25f, 0.5f, "");
		return;
	}
}

void PostPoneVoice(string &in asTimer)
{
	AddEffectVoice("vo_mansion02_bedroom_flashback_mandus_01", "", "Voice", "vo_mansion02_bedroom_flashback_mandus_01", false, "", 0.0f, 0.0f);
	AddTimer("vo_mansion02_bedroom_flashback_mandus_02", 6.85f, "TimerExtraVoiceEffects");
	PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 1.0f, false);
	PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);		
	FadeImageTrailTo(2.0f, 2.5f);
	SetPlayerMoveSpeedMul(0.5f);
	SetPlayerLookSpeedMul(0.5f);
	AddTimer("ReturnToNormalHowl", 16.0f, "ManpigHowlsMainCalls");
}
//END TRIGGERED VO PLAYER//

//VOICE TIMERS//
void TimerExtraVoiceEffects(string &in asTimer)
{
	//FLASHBACK 1
	if(asTimer == "vo_mansion02_bedroom_flashback_mandus_02")
	{
	AddEffectVoice("vo_mansion02_bedroom_flashback_mandus_02", "", "Voice", "vo_mansion02_bedroom_flashback_mandus_02", false, "", 0.0f, 0.0f);
	}
	if(asTimer == "vo_mansion02_catwalk_flashback_mandus_02")
	{
	AddEffectVoice("vo_mansion02_catwalk_flashback_mandus_02", "", "Voice", "vo_mansion02_catwalk_flashback_mandus_02", false, "", 0.0f, 0.0f);
	}
	//END FLASHBACK 1
}

//MANDUS REACTION SOUND PLAYER//
void MandusReactionPlayer (string asReactType, float afWaitTime)
{
	SetLocalVarString("CurrentReactType", asReactType);
	AddTimer("MandusReactionInternalTimer", afWaitTime, "MandusReactionPlayerTimerEnd");
}

void MandusReactionPlayerTimerEnd (string &in asTimer)
{
	if (GetLocalVarString("CurrentReactType") == "Scared")
	{
		AddDebugMessage("SCARED REACTION", false);
		PlaySoundAtEntity("React_Scared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Breath")
	{
		AddDebugMessage("BREATH REACTION", false);
		PlaySoundAtEntity("React_Breath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Quick")
	{
		AddDebugMessage("QUICK SCARE REACTION", false);
		PlaySoundAtEntity("React_Quick", "react_quickscare.snt", "Player", 0.0f, false);
		return;
	}
	else if (GetLocalVarString("CurrentReactType") == "Cough")
	{
		AddDebugMessage("COUGH REACTION", false);
		PlaySoundAtEntity("", "react_cough.snt", "Player", 0.0f, false);
		return;
	}
}
//END MANDUS REACTION SOUND PLAYER//

//PHONAUTOGRAPH HANDLER//
void PhonautographHandler (string &in asEntity, int alState)																//This function must be present for all maps containing Phonautograph entities.
{
	if (alState == 1)																										//DO NOT EDIT
	{																														///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////////////////////////////
		if (asEntity == "Phonautograph1")																					
		{
			SetEntityInteractionDisabled(asEntity, true);																	//DO NOT EDIT
			PlayPropAnimation("Phonautograph1", "Play", 1.0f, true, "");													//Starts Animation. The name of the Phonautograph entity will need changing for other instances.
			AddEffectVoice4("vo_mansion2_phono_01.ogg", "", "Voice", "vo_mansion2_phono_prof_01", 0.0f, "vo_mansion2_phono_mandus_01", 3.0f, "vo_mansion2_phono_prof_02", 7.5f, "vo_mansion2_phono_mandus_02", 18.0f, false, "", 0.0f, 0.0f);			
			AddTimer("Phono1Timer", 24.3f, "PhonautographDeactivateHandler");
					//Times the stopping of the animation. "Phono1Timer" will need to be changed for other instances. The time must be half a second longer than the .ogg being played.
		}																													
	}																														//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES///////////////	
}

void PhonautographDeactivateHandler (string &in asTimer)																	//This function must be present for all maps containing Phonautograph entities.
{																															///////////////////////////START OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES////////////
	if (asTimer == "Phono1Timer")																							//This if statement must be updated for each different phonautograph instance.
	{
		PlayPropAnimation("Phonautograph1", "Stop", 1.0f, true, "");														//Stops Animation. The name of the Phonautograph entity will need changing for other instances.
	}
}																															//////////////////////////END OF IF CASE FOR DUPLICATING TO OTHER PHONAUTOGRAPH INSTANCES/////////////
//END PHONAUTOGRAPH HANDLER//

//FIX FOR BROKEN DOORS//
void FixBrokenDoors (string &in asTimer)
{
	SetSwingDoorDisableAutoClose("TrophyRoomSecretDoor", false);
	AddBodyForce("TrophyRoomSecretDoor_Body_door", 0.0f, 0.0f, 8000.0f, "world");
	SetSwingDoorLocked("TrophyRoomSecretDoor", true, false);
	SetSwingDoorClosed("TrophyRoomSecretDoor", true, false);
}


//END FIX FOR BROKEN DOORS//

// HINT HANDLER//
void HintHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "BathroomHintTrigger" || asChild == "TrophyRoomHintTrigger")
	{
		AddTimer("MansionTwo2", 4.0f, "TimerDelayedHint");
		return;
	}
}
//END HINT HANDLER//

//DELAYED HINT//
void TimerDelayedHint(string &in asEntity)
{
	AddHint(asEntity, "");
}
//END DELAYED HINT//