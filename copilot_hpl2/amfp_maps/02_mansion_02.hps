//TRANSITION ROOM STAIR COLLAPSE EVENT//
void StairBreakEvent (string &in asParent, string &in asChild, int alState) //Transition Room Stair Sequence
{
	PlaySoundAtEntity("", "afx_mans_stairsmash_quake.snt", "Player", 0.0f, false);
	PlaySoundAtEntity("", "afx_mans_stairsmash_detail.snt", "Player", 0.0f, false);
	PlaySoundAtEntity("", "mans_afx_stairsmash.snt", "Player", 0.0f, false);
	PlaySoundAtEntity("", "stairsmash_break.snt", "Player", 0.0f, false);
	StartScreenShake (0.06f, 1.2f, 0.5f, 0.5f);
	SetPlayerRunSpeedMul(0.0f);
	SetPlayerMoveSpeedMul(0.35f);
	AddTimer("TransitionRoomAnimStartBuffer", 0.5f, "StairBreakEventTimerCalls");
	AddTimer("TransitionRoomSoundBuffer", 1.5f, "StairBreakEventTimerCalls");
	AddTimer("TransitionRoomAvSequence", 1.65f, "StairBreakEventTimerCalls");
	AddTimer("TransitionRoomAnimTimer", 6.5f, "StairBreakEventTimerCalls");
	
	SetEntityActive("EndBlocker", true);

	//THIS DEACTIVATES THE UPPER PIPE RIGHT BEFORE THE COLLAPSE//
	SetEntityActive("transition_room_intact_1", false);
}

void StairBreakEventTimerCalls (string &in asTimer)
{
	//PLAY ANIMATION//
	if (asTimer == "TransitionRoomAnimStartBuffer")
	{
		PlayPropAnimation("transition_room_1", "stairs_break", 0.0f, false, "");
		PlayPropAnimation("transition_room_2", "stairs_break", 0.0f, false, "");
		return;
	}
	
	//DEACTIVATE INTACT MODELS, TURN ON PARTICLES//
	else if (asTimer == "TransitionRoomSoundBuffer")
	{
		StartScreenShake (0.3, 0.5, 0.1f, 0.5f);
		SetEntityActive("transition_room_intact_2", false);
		SetLanternDisabled(true);
		SetLanternActive(false, false);
		SetParticleSystemActive("TransSteam1", true);
		SetParticleSystemActive("TransSteam2", true);
		SetParticleSystemActive("TransRoomStairDust", true);
		PlaySoundAtEntity("transition_room_steam_1", "mans_afx_trans_steam_loop_1.snt", "TransitionSteamSource1", 0, true);
		PlaySoundAtEntity("transition_room_steam_2", "mans_afx_trans_steam_loop_2.snt", "TransitionSteamSource2", 0, true);
		return;
	}

	//ACTIVATE DESTROYED STATICS//
	else if (asTimer == "TransitionRoomAnimTimer")
	{
		SetEntityActive("transition_room_destroyed_1", true);
		SetEntityActive("stairs_high_destroyed", true);			
		SetEntityActive("transition_room_1", false);
		SetEntityActive("transition_room_2", false);
		StopSound("transition_room_steam_1", 4.5);
		StopSound("transition_room_steam_2", 4.5);
		return;
	}
}
//END STAIR COLLAPSE EVENT//

//DESK SOUND EVENT//
void DeskSoundTrigger (string &in asParent, string &in asChild, int alState) //Transition Room Stair Sequence
{
	PlaySoundAtEntity("", "amb_cellar_pen_scratch.snt", "DeskSoundSource", 0.0f, true);
	AddDebugMessage("Pen Scratch START!", true);
}
//END DESK SOUND EVENT EVENT//

//MAP SOUND TRIGGERS//
void MapSoundTriggers (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "FanTrigger")
	{
		PlaySoundAtEntity("FanSoundSource", "amb_mans_backroom_fan.snt", "FanSoundSource", 1.0f, true);
		return;
	}
	else if (asChild == "TransRoomCreak01")
	{
		PlaySoundAtEntity("TransRoom_Creak_01", "afx_mansion_transroom_creak_01.snt", "Player", 0.0f, false);
		SetParticleSystemActive("TransRoomCreakDust_1", true);
		SetParticleSystemActive("TransRoomCreakDust_2", true);
		SetParticleSystemActive("TransRoomCreakDust_3", true);
		return;
	}
	else if (asChild == "ChimeTrigger")
	{
		PlaySoundAtEntity("Chime", "afx_mans_chime_2d.snt", "HallClockSource", 0.0f, false);
		PlaySoundAtEntity("Chime_Thunder", "afx_mans_chime_3d.snt", "HallClockSource", 0.0f, false);
		return;
	}
	else if (asChild == "DiningRoomFlashBackTrigger_1" || asChild == "DiningRoomFlashBackTrigger_2" || asChild == "DiningRoomFlashBackTrigger_3")
	{
		PlaySoundAtEntity("KillFlashback", "afx_mansion_dining_room_kill_flashback", "Player", 0.0f, false);
		FadeImageTrailTo(2.0f, 0.5f);
		AddTimer("SepiaFlashback", 1.5f, "DiningRoomFlashbackSequence");
		StopMusic(1.5f, 1);
		MandusReactionPlayer("Breath", 1.0f);
		SetPlayerLookSpeedMul(0.3f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerMoveSpeedMul(0.3f);
		AddTimer("WhiteFlash", 9.0f, "DiningRoomFlashbackSequence");
		AddTimer("StopMovement", 10.5f, "DiningRoomFlashbackSequence");
		AddTimer("GetUp", 11.5f, "DiningRoomFlashbackSequence");
		AddTimer("ReturntoNormal", 11.5f, "DiningRoomFlashbackSequence");
		RemoveEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_1");
		RemoveEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_2");
		RemoveEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_3");
		return;
	}
}
//END MAP SOUND TRIGGERS//

//DINING ROOM FLASHBACK SEQUENCE//
void DiningRoomFlashbackSequence (string &in asTimer)
{
	//DO SEPIA//
	if (asTimer == "SepiaFlashback")
	{
		FadeSepiaColorTo(0.5f, 0.5f);
		return;
	}
	
	//DO FLASH AND FALL OVER//
	else if (asTimer == "WhiteFlash")
	{
		AddTimer("FadebackfromBlack", 6.5f, "DiningRoomFlashbackSequence");
		//SetPlayerCrouching(true);
		//SetPlayerActive(false);
		//FadePlayerPitchTo(-60.0f, 40.0f, 40.0f);
		//FadePlayerRollTo(-50.0f, 40.0f, 40.0f);
		MandusReactionPlayer("Quick", 0.2f);
		//FadeOut(2.5f);
		StartEffectFlash(1.5f, 1.0f, 1.5f);
		return;
	}
	else if (asTimer == "StopMovement")
	{
		SetPlayerLookSpeedMul(0.1f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerMoveSpeedMul(0.0f);
	}
	//DO FADE IN FROM BLACK//
	else if (asTimer == "FadebackfromBlack")
	{
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.2f, false);
		PlaySoundAtEntity("", "afx_flashback_whisper.snt", "Player", 1.0f, false);
		//FadeIn(3.5f);
		return;
	}
	
	//GET UP FROM FLOOR//
	else if (asTimer == "GetUp")
	{
		FadePlayerPitchTo(0.0f, 3.0f, 7.0f);
		FadePlayerRollTo(0.0f, 3.0f, 7.0f);
		return;
	}
	
	//DO RETURN TO NORMAL VISION//
	else if (asTimer == "ReturntoNormal")
	{
		SetPlayerCrouching(false);
		//PlaySoundAtEntity("", "00_intro_foley_standup.snt", "Player", 0.0f, false);
		FadeImageTrailTo(0.0f, 8.5f);
		FadeSepiaColorTo(0.0f, 8.5f);
		MandusReactionPlayer("Scared", 0.0f);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);	
		SetPlayerActive(true);
		return;
	}
}
//END DINING ROOM FLASHBACK SEQUENCE//

//BACK ROOM SOUND TRIGGERS//
void BackRoomTrigger (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "StartBackRoomSound"|| asChild == "BackAreaSoundsStart_Exit")
	{
		PlaySoundAtEntity("BackRoomSoundSwishFan_1", "amb_mansion_backarea_largefan_swish_loop_01.snt", "BackRoomLargeFan_1", 1.0f, true);
		PlaySoundAtEntity("BackRoomSoundSwishFan_2", "amb_mansion_backarea_largefan_swish_loop_02.snt", "BackRoomLargeFan_2", 1.0f, true);
		PlaySoundAtEntity("BackRoomSoundFan_1", "amb_mansion_backarea_largefan_loop_01.snt", "BackRoomLargeFan_1", 1.0f, true);
		PlaySoundAtEntity("BackRoomSoundFan_1_2D", "amb_mansion_backarea_largefan_loop_01_2D.snt", "BackRoomLargeFan_1", 1.0f, true);
		PlaySoundAtEntity("BackRoomSoundFan_2", "amb_mansion_backarea_largefan_loop_02.snt", "BackRoomLargeFan_2", 1.0f, true);
		PlaySoundAtEntity("BackRoomSoundFan_2_2D", "amb_mansion_backarea_largefan_loop_02_2D.snt", "BackRoomLargeFan_2", 1.0f, true);
		AddEntityCollideCallback("Player", "StopBackRoomSound", "BackRoomTrigger", true, 1);
		AddEntityCollideCallback("Player", "BackAreaSoundsStop_Exit", "BackRoomTrigger", true, 1);
		RemoveEntityCollideCallback("Player", "StartBackRoomSound");
		RemoveEntityCollideCallback("Player", "BackAreaSoundsStart_Exit");
		AddDebugMessage("Back Area Sounds START!", true);
		
		return;
	}
	else if (asChild == "StopBackRoomSound"|| asChild == "BackAreaSoundsStop_Exit")
	{
		AddEntityCollideCallback("Player", "StartBackRoomSound", "BackRoomTrigger", true, 1);
		AddEntityCollideCallback("Player", "BackAreaSoundsStart_Exit", "BackRoomTrigger", true, 1);
		RemoveEntityCollideCallback("Player", "StopBackRoomSound");
		RemoveEntityCollideCallback("Player", "BackAreaSoundsStop_Exit");
		StopSound("BackRoomSoundSwishFan_1", 1.0f);
		StopSound("BackRoomSoundSwishFan_2", 1.0f);
		StopSound("BackRoomSoundFan_1", 1.0f);
		StopSound("BackRoomSoundFan_1_2D", 1.0f);
		StopSound("BackRoomSoundFan_2", 1.0f);
		StopSound("BackRoomSoundFan_2_2D", 1.0f);
		AddDebugMessage("Back Area Sounds STOP!", true);
		return;
	}
}
//END BACK ROOM SOUND TRIGGERS//

