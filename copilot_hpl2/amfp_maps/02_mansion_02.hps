										////////////////////////////////
										//MAP INITIALISATION FUNCTIONS//
										////////////////////////////////
										
void OnStart()

{
	//Make sure player is normal
	SetPlayerMoveSpeedMul(1);
	SetPlayerRunSpeedMul(1);
	SetPlayerLookSpeedMul(1);
	
	//Map Preamble
	{
		SetMapDisplayNameEntry("Mansion02");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");
		
		//UpdateNutcase();
	}
		
	// Setup Local Variables
	{
		//ALL-MAP VARIABLES//
		SetLocalVarString("CurrentAmbientTrack", "");
		
		//SINGLE-MAP VARIABLES//
		SetLocalVarInt("RightValveOn", 0);
		SetLocalVarInt("LeftValveOn", 0);
		SetLocalVarInt("BackAreaOpened", 0);
		SetLocalVarInt("BathState", 0);
		SetLocalVarInt("BearState", 0);
		SetLocalVarInt("BearHasMovedOnce", 0);
		SetLocalVarInt("SecretExitDoorOpen", 0);
		SetLocalVarInt("LookingDownCorridor", 0);
		
		//PIG MASK EVENT VARIABLES//
		SetLocalVarInt("randmask9looktarget", 0);
		
		//ENTRANCE DOOR VARIABLES//
		SetLocalVarInt("lookentrancedoor", 0);
		SetLocalVarInt("inentranceprox", 0);
		SetLocalVarInt("interactedwithentrancedoorbool", 0);
		SetLocalVarInt("entrancedooreventcompleted", 0);
	}
		
	//AutoRun Event Timers
	{	
	
	}
	
	//AutoRun Function Calls
	{
		RandomMaskInit(GetGlobalVarInt("randmasksetindex")); //Carries over entity activation from mansion_01.map
		StopMusic(5.5f, 2);
	}
		
	//Setup Initial Entity Callbacks
	{
		//COLLISION CALLBACKS//
		AddEntityCollideCallback("Player", "Child1&2Trigger_1", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "Child1&2Trigger_2", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child1", "Child1KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child2", "Child2KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child_Last", "ChildLastKillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "EntranceDoorProximityTracker", "EntranceDoorProximityTracker", false, 0);
		AddEntityCollideCallback("Bear", "BearCollider", "TrophyRoomSecretDoorEvent", false, 0);
		AddEntityCollideCallback("Player", "GreatHallQuakeTrigger", "QuakeSequences", true, 1);
		AddEntityCollideCallback("Player", "EerieCorridorTrigger", "EerieCorridorEvent", true, 1);
		AddEntityCollideCallback("Player", "StairBreakTrigger", "StairBreakEvent", true, 1);
		AddEntityCollideCallback("Player", "FanTrigger", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "TransRoomCreak01", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "ChimeTrigger", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_1", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_2", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "DiningRoomFlashBackTrigger_3", "MapSoundTriggers", true, 1);
		AddEntityCollideCallback("Player", "StartBackRoomSound", "BackRoomTrigger", true, 1);
		AddEntityCollideCallback("Player", "BackAreaSoundsStart_Exit", "BackRoomTrigger", true, 1);
		AddEntityCollideCallback("Player", "DeskSoundTrigger", "DeskSoundTrigger", true, 1);
		AddEntityCollideCallback("Player", "FadeOutToLevelTrigger", "LevelTransitionHandler", true, 1);
		AddEntityCollideCallback("Player", "ManpigHowlTrigger", "ManpigHowls", true, 1);
		AddEntityCollideCallback("Player", "ManpigHowlOutsideTrigger", "ManpigHowls", true, 1);
		AddEntityCollideCallback("Player", "MuffledGateTrigger", "MuffledGateSound", true, 1);
		AddEntityCollideCallback("Player", "SideGatesOpenTrigger", "SideGatesOpenHandler", true, 1);
		AddEntityCollideCallback("Player", "BackCorridorChild1Trigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "BackCorridorChild2Trigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "ChildLastTriggerStart", "ChildLastTrigger", true, 1);
		AddEntityCollideCallback("BackCorridorChild1", "BackCorridorChild1KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("BackCorridorChild2", "BackCorridorChild2KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "PhoneTrigger", "HallPhone", true, 1);
		AddEntityCollideCallback("Player", "Sound_ThunderOutside", "Sound_ThunderOutside", true, 1);
		AddEntityCollideCallback("Player", "BathroomHintTrigger", "HintHandler", true, 1);
		AddEntityCollideCallback("Player", "TrophyRoomHintTrigger", "HintHandler", true, 1);
		AddEntityCollideCallback("PigSlamDoor", "AreaPig", "PigDoorCollideWithPig", true, 1);
		AddEntityCollideCallback("Player", "AreaNoBearInteract", "ColliderNoBearInteract", false, 0);
		
		//INTERACTION CALLBACKS//
		SetEntityPlayerInteractCallback("EntranceDoor", "EntranceDoorInteractTracker", true);
		
		//LOOKAT CALLBACKS//		
		SetEntityPlayerLookAtCallback("EntranceDoorLookTarget", "EntranceDoorLookTracker", false);
		SetEntityPlayerLookAtCallback("CorridorLookTarget", "CorridorLookTracker", false);
		
		//STATE CHANGE CALLBACKS//
		SetEntityConnectionStateChangeCallback("BathLever", "RotatingBathHandler");
		SetEntityConnectionStateChangeCallback("BearLever", "BearHandler");
		SetEntityConnectionStateChangeCallback("RightValve", "BackAreaValveHandler");
		SetEntityConnectionStateChangeCallback("LeftValve", "BackAreaValveHandler");
		SetEntityConnectionStateChangeCallback("BackCorridorValve", "BackAreaValveHandler");
		
		//TYPE-DEFINED ENTITY CALLBACKS//
		SetEntityCallbackFunc("lantern_1", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_2", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_3", "LanternInfoUpdate");	
	}
		
	//Setup Initial Object States
	{	
		//ANIMATION STATES//
		PlayPropAnimation("Phonautograph1", "Stop", 0.0f, true, "");							//Initialises Phonautograph to non-animated.
		PlayPropAnimation("clock_grandfather_*", "on", 0.0f, true, "");
		StopPropAnimation("transition_room_1");
		StopPropAnimation("transition_room_2");
		PlayPropAnimation("nest_wretch_sleeping", "NestSleep", 0.0f, true, "");
		PlayPropAnimation("large_fan_4", "on", 0.0f, true, "");
		PlayPropAnimation("large_fan_5", "on", 0.0f, true, "");
		PlayPropAnimation("Nutcase", "NestSleep", 0.0f, true, "");
		
		//INTERACTION//
		SetEntityInteractionDisabled("wood_panneling_door_15", true);
	}
	
	//Setup Ambience Callbacks
	{
		AddEntityCollideCallback("Player", "AMBCorridorEntry", "MapAmbienceAreas", false, 0);	//Start corridor
		AddEntityCollideCallback("Player", "AMBAreaGreatHall", "MapAmbienceAreas", false, 0);	//Great Hall Ambience
		AddEntityCollideCallback("Player", "AMBAreaGreatHall_1", "MapAmbienceAreas", false, 0);	//Great Hall Ambience
		AddEntityCollideCallback("Player", "AMBAreaGreatHall1", "MapAmbienceAreas", false, 0);	//TOP LEFT(Furthest from start area)
		AddEntityCollideCallback("Player", "AMBAreaGreatHall2", "MapAmbienceAreas", false, 0); //TOP RIGHT (Nearest spawn area)
		AddEntityCollideCallback("Player", "AMBAreaDiningRoom", "MapAmbienceAreas", false, 0); // dining area
		AddEntityCollideCallback("Player", "AMBAreaTrophyArea", "MapAmbienceAreas", false, 0); // trophy area
		AddEntityCollideCallback("Player", "AMBBilliardsRoom", "MapAmbienceAreas", false, 0); // Billiards room
		AddEntityCollideCallback("Player", "AMBCorridorBathroom", "MapAmbienceAreas", false, 0); // corridor bathroom
		AddEntityCollideCallback("Player", "AMBBathroom", "MapAmbienceAreas", false, 0); // bathroom area
		AddEntityCollideCallback("Player", "AMBBathroom_1", "MapAmbienceAreas", false, 0); 
		AddEntityCollideCallback("Player", "AMBBackCorridor", "MapAmbienceAreas", false, 0); // corridor behind great hall
		AddEntityCollideCallback("Player", "AMBCourtyard1", "MapAmbienceAreas", false, 0); //courtyard area 1
		AddEntityCollideCallback("Player", "AMBCourtyard1_1", "MapAmbienceAreas", false, 0); //courtyard area 1
		AddEntityCollideCallback("Player", "AMBCourtyard1_2", "MapAmbienceAreas", false, 0); //courtyard area 1
		AddEntityCollideCallback("Player", "AMBBackAreaMain", "MapAmbienceAreas", false, 0); //hidden back area
		AddEntityCollideCallback("Player", "AMBBackAreaMain_1", "MapAmbienceAreas", false, 0); //hidden back area
		AddEntityCollideCallback("Player", "AMBBackAreaMain_2", "MapAmbienceAreas", false, 0); //hidden back area
		AddEntityCollideCallback("Player", "AMBBackAreaMain_3", "MapAmbienceAreas", false, 0); //hidden back area
		AddEntityCollideCallback("Player", "AMBBackroom_4", "MapAmbienceAreas", false, 0); //hidden back area
		AddEntityCollideCallback("Player", "AMBCourtyard2_1", "MapAmbienceAreas", false, 0); //courtyard 2
		AddEntityCollideCallback("Player", "AMBAreaCourtyard2_2", "MapAmbienceAreas", false, 0); //courtyard 2
		AddEntityCollideCallback("Player", "AMBAreaTransRoom", "MapAmbienceAreas", false, 0); //trans room
		AddEntityCollideCallback("Player", "Sound_StartWind_1", "RandomSound", true, 1);
		AddEntityCollideCallback("Player", "Sound_StartWind_2", "RandomSound", true, 1);
		AddEntityCollideCallback("Player", "Sound_StartWind_3", "RandomSound", true, 1);
		AddEntityCollideCallback("Player", "Sound_StartWind_4", "RandomSound", true, 1);
		AddEntityCollideCallback("Player", "Sound_StartWind_5", "RandomSound", true, 1);
		AddEntityCollideCallback("Player", "Sound_StartWind_6", "RandomSound", true, 1);
		//WIND SAMPLES FOR DOOR
		AddEntityCollideCallback("wood_panneling_door_2", "WindSampleSpot1", "WindSampleSpot1", false, 0);
		AddEntityCollideCallback("mansion_6", "WindSampleSpot2", "WindSampleSpot2", false, 0);
		AddEntityCollideCallback("tunnels_door_1", "WindSampleSpot3", "WindSampleSpot3", false, 0);
		AddEntityCollideCallback("mansion_9", "WindSampleSpot4", "WindSampleSpot4", false, 0);
		AddEntityCollideCallback("SecretExitDoor", "WindSampleSpot5", "WindSampleSpot5", false, 0);
		AddEntityCollideCallback("tunnels_door_2", "WindSampleSpot6", "WindSampleSpot6", false, 0);
		
		AddEntityCollideCallback("Player", "ChildYard_1", "CollideChildYard", true, 1);
		AddEntityCollideCallback("Player", "ChildYard_2", "CollideChildYard", true, 1);
		
		for(int i=1;i<=2;i++)
		{
			for(int j=1;j<=2;j++)
			{
				AddEntityCollideCallback("ChildYard_"+i+"_"+j, "ChildYard_CloseGate", "CollideChildYardGate", true, 1);
				AddEntityCollideCallback("ChildYard_"+i+"_"+j, "ChildYard_CloseDoor", "CollideChildYardDoor", true, 1);
			}
		}
		
		AddEntityCollideCallback("wretch_road", "AreaRemoveWretchRoad", "CollideRemoveWretchRoad", true, 1);
		//AddEntityCollideCallback("Player", "AreaBeginWretchRoad", "CollideBeginWretchRoad", true, 1);
		
	}
		
	//Setup Music Callbacks
	{
		AddEntityCollideCallback("Player", "MusicRoomMusicTrigger", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "EnterCellarMusic", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "MusicRoomMusicTrigger_1", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "MusicRoomMusicTrigger_2", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "GoingOutsideMusicTrigger", "MusicPlayer", true, 1);
	}
	
	//Setup Triggered VO Callbacks
	{
		AddEntityCollideCallback("Player", "main_hall_2_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Switchboard_gate_opens_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "grate_room_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "yard_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "BedroomFlashback_VO", "VOPlayer", true, 1);
	}
	
	//Setup Phonoautograph Callbacks
	{
		SetEntityConnectionStateChangeCallback("Phonautograph1", "PhonautographHandler"); 			//Arguments Required: ("Name of the Phonoautograph entity", "Name of the function to call on interaction" < this will always be the same)
	}
	
	//Fix for Broken Door Entities
	{
		SetSwingDoorLocked("TrophyRoomSecretDoor", false, false);
		SetSwingDoorClosed("TrophyRoomSecretDoor", false, false);
		SetSwingDoorDisableAutoClose("TrophyRoomSecretDoor", true);
		AddBodyForce("TrophyRoomSecretDoor_Body_door", -20000.0f, 0.0f, 0.0f, "world");
		AddTimer("DoorFixTimer", 0.5f, "FixBrokenDoors");
	}
}	

