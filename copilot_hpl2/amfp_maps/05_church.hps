void EnterLanternFlicker_2(string &in asParent, string &in asChild, int alState)
{
	LanternFlicker(4);
	
	AddTimer("Piggie2PreSounds", 0.5f, "TimerPiggie2PreSounds");
	
	AddTimer("Pig2Start", 0.5f, "TimerPig2Start");
}

void TimerPiggie2PreSounds(string &in asTimer)
{
	PlaySoundAtEntity("PensPigSource_1", "wretch_tunnels_vomitattack.snt", "PensPigSource_1", 2, false);
}

void TimerPig2Start(string &in asTimer)
{
	ClearEnemyPatrolNodes("wretch_2");

	//AddEnemyPatrolNode("wretch_2", "PathNodeArea_2", 0, "", false);
	
	AddEnemyPatrolNode("wretch_2", "PathNodeArea_88", 0, "", false);
	AddEnemyPatrolNode("wretch_2", "PathNodeArea_90", 0, "", false);
	
	SetEntityActive("wretch_2", true);
}

