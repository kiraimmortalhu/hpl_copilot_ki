//VO HANDLER//  //VO SYSTEM USES OVERLOADED FUNCTION CALLS, ALL CONTAINED WITHIN THIS BLOCK//
void VOPlayer (string &in asParent, string &in asChild, int alState) //COLLISION CALLBACK VO HANDLER//
{
	 if (asChild == "vo_child_2")
	{
		AddEffectVoice("vo_church_trigger_child_02.ogg", "", "Voice", "vo_church_trigger_child_02", false, "", 0.0f, 0.0f);
		PlaySoundAtEntity("s1", "afx_gameplay_hightone_10sec.snt", "Player", 3.0f, false);
		PlaySoundAtEntity("s2", "afx_flashback_whisper.snt", "Player", 3.0f, false);	
		FadeImageTrailTo(2.0f, 2.5f);
		SetPlayerMoveSpeedMul(0.45f);
		SetPlayerLookSpeedMul(0.45f);
		AddTimer("ReturnToNormal", 5.0f, "RestoreToNormal");
	}
}

void RestoreToNormal (string &in asTimer)
{
	StopSound("s1", 1);
	StopSound("s2", 1);
	FadeImageTrailTo(0.0f, 1.0f);
	SetPlayerLookSpeedMul(1.0f);
	SetPlayerMoveSpeedMul(1.0f);
}
	
void VOHandler (int Index)
{
}
//END VO HANDLER//

//RANDOM SOUND CUE PLAYER//
void RandStartOfficeCues(string &in asTimer)
{
	string[] sCueSources = {"RandSound_StartOffice_2", "RandSound_StartOffice_1"};
	asTimer = sCueSources[RandInt (0, 1)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hifrequencymoan_mansion.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Start Office Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(15.0f, 25.0f), "RandStartOfficeCues");
}

