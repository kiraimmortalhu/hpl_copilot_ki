void OnStart()
 
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Church");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");
	}
		
	// Setup Local Variables
	{
		SetLocalVarInt("candleactivationtracker", 0);
		SetLocalVarInt("FurnaceLit", 0);
		SetLocalVarInt("CheckpointActive", 0);
		SetLocalVarInt("WretchRemovedPermanently", 0);
		SetLocalVarInt("Mask1Active", 0);
		SetLocalVarInt("Mask2Active", 1);
	}
	
	//AutoRun Event Timers
	{
		AddTimer("FirstHint", 1.5f, "GiveFirstHint");
	}

	//AutoRun Function Calls
	{
		StopMusic(5.5f, 2);
	}
		
	//Setup Initial Entity Callbacks
	{
		//COLLISION CALLBACKS//
		AddEntityCollideCallback("Player", "OrganMusicTrigger", "OrganMusicEvent", true, 1); //ORGAN MUSIC TRIGGER//
		AddEntityCollideCallback("Player", "CandleProximityChecker", "CandleFittingHandler", false, 0);
		AddEntityCollideCallback("CandleStickItem_*", "CandleFittingCollider", "CandleFittingHandler", false, 1);
		AddEntityCollideCallback("RightAltarCandle", "RightAltarCandleCollider", "ChurchAltarEvent", true, 1);
		AddEntityCollideCallback("LeftAltarCandle", "LeftAltarCandleCollider", "ChurchAltarEvent", true, 1);
		AddEntityCollideCallback("Player", "AltarCloseTrigger", "ChurchAltarEvent", true, 1);
		AddEntityCollideCallback("Player", "PensVOTrigger1", "PensTriggeredVOAndSFX", true, 1);
		AddEntityCollideCallback("Player", "PensSFXTrigger1", "PensTriggeredVOAndSFX", true, 1);
		AddEntityCollideCallback("Player", "CageMoveTrigger", "CageMoveEvent", true, 1);
		AddEntityCollideCallback("Player", "PenWretchActivationTrigger", "PenWretchSequenceHandler", true, 1);
		AddEntityCollideCallback("Player", "PenWretch2ActivationTrigger", "PenWretchSequenceHandler", true, 1);
		AddEntityCollideCallback("Player", "PenWretch3ActivationTrigger", "PenWretchSequenceHandler", true, 1);
		AddEntityCollideCallback("Player", "Barrel_Trigger", "Barrel_Handler", true, 1);
		AddEntityCollideCallback("Player", "penscare", "PenScareEvent", true, 1);
		AddEntityCollideCallback("Player", "Mask1SpawnTrigger", "Mask1Spawner", true, 1);
		AddEntityCollideCallback("Player", "Mask2DespawnTrigger1", "Mask2Despawner", true, 1);
		AddEntityCollideCallback("Player", "Mask2DespawnTrigger2", "Mask2Despawner", true, 1);
		AddEntityCollideCallback("Player", "AreaStartPig", "EnterStartPig", true, 1);
		AddEntityCollideCallback("Player", "AreaLanternFlicker_1", "EnterLanternFlicker_1", true, 1);
		AddEntityCollideCallback("Player", "AreaLanternFlicker_3", "EnterLanternFlicker_3", true, 1);
		AddEntityCollideCallback("Player", "ChurchOfficeHintTrigger", "HintHandler", true, 1);
		
		//CHURCH TRIGGERS - NOT ALL ARE INCLUDED SO DO NOT DELETE ABOVE//
		AddEntityCollideCallback("Player", "ChurchEntry_1", "ChurchEntryTriggers", true, 1);
		AddEntityCollideCallback("Player", "ChurchEntry_2", "ChurchEntryTriggers", true, 1);
		AddEntityCollideCallback("Player", "StoreroomEntry", "StoreroomEvents", true, 1);
		AddEntityCollideCallback("Player", "PlayerEnterAltarArea", "PlayerEnterAltarArea", true, 1);
		AddEntityCollideCallback("AltarLever", "AltarSwitchCollider_Organ", "AltarSwitchCollider_Organ", true, 1);
		
		//LEVEL TRANSITION MUSIC
		SetEntityPlayerInteractCallback("Level_Transition_Door", "Level_Transition_Music", false);	
		
		//STATE CHANGE CALLBACKS//
		SetEntityConnectionStateChangeCallback("AltarLever", "AltarLeverHandler");
		
		//LANTERN FLICKER TRIGGERS//
		AddEntityCollideCallback("Player", "Lantern1Trigger", "Lantern1Handler", false, 0);
		AddEntityCollideCallback("Player", "Lantern2Trigger", "Lantern2Handler", false, 0);
		AddEntityCollideCallback("Player", "Lantern3Trigger", "Lantern3Handler", false, 0);
		AddEntityCollideCallback("Player", "Lantern4Trigger", "Lantern4Handler", false, 0);
		AddEntityCollideCallback("Player", "Lantern5Trigger", "Lantern5Handler", false, 0);
		AddEntityCollideCallback("Player", "Lantern6Trigger", "Lantern6Handler", false, 0);
	}
		
	//Setup Initial Object States
	{
		//COLLISION MESH STATES//
		SetEntityActive("altar02", false);
		
		//ANIMATIONS
		PlayPropAnimation("clock_grandfather_1", "on", 0.0f, true, "");
		
		PlayPropAnimation("Phonautograph1", "Stop", 1.0f, true, "");
	}
		
	//Setup Ambience Callbacks
	{
		AddEntityCollideCallback("Player", "AMBAreaChurch", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurch_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBChurchStart_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBChurchStart_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAnnexStairs_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAnnexStairs_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurch_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurchAnnex", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurchAnnex_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurchAnnex_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurchPensEntrance", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBAreaChurchPens", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBArea_Cupboard", "MapAmbienceAreas", false, 0);
		SetEntityInteractionDisabled("MusicPhono", true);
	}
		
	//Setup Music Callbacks
	{
		AddEntityCollideCallback("Player", "PigsAmbient3MusicTrigger", "MusicPlayer", true, 1);
	}
		
	//Setup Random Sound Callbacks
	{
		AddTimer("InitRandomStartOfficeSoundPlayer", 5.0f, "RandStartOfficeCues");
		AddTimer("InitRandomStartOffice2SoundPlayer", 5.0f, "RandStartOffice2Cues");
	}
	
	//Setup Initial VO Callbacks
	{
		AddEntityCollideCallback("Player", "vo_child_1", "VOPlayer", true, 0);
		AddEntityCollideCallback("Player", "vo_child_2", "VOPlayer", true, 0);
	}
} 

