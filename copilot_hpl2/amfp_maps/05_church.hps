//CHURCH ALTAR COLLIDE EVENTS//
void ChurchAltarEvent (string &in asParent, string &in asChild, int alState)
{
	if (asParent == "RightAltarCandle")
	{
		SetEntityInteractionDisabled("RightAltarCandle", true);
		SetPropStaticPhysics("RightAltarCandle", true);
		AddLocalVarInt("candleactivationtracker", 1);
		PlaySoundAtEntity("", "candle_church_close.snt", "RightAltarCandle", 0.0f, false);
		
		if (!GetEntityActive("LeftAltarCandle"))
			AddHint("Church2", "");
	}
	else if (asParent == "LeftAltarCandle")
	{
		SetEntityInteractionDisabled("LeftAltarCandle", true);
		SetPropStaticPhysics("LeftAltarCandle", true);
		AddLocalVarInt("candleactivationtracker", 1);
		PlaySoundAtEntity("", "candle_church_close.snt", "LeftAltarCandle", 0.0f, false);
		//PlaySoundAtEntity("altar_confirm", "afx_church_candle_altar_confirm_altar", "AltarSoundSource", 0.0f, false);
	}
	else if (asChild == "AltarCloseTrigger")
	{
		FadeLightTo("SpotLight_25", 0,0,0,0,-1,5);
		SetLampLit("FurnaceLamp", false, false);
		
		SetParticleSystemActive("DoorSlamParticles", true);
		SetEntityActive("altar_door", true);
		PlaySoundAtEntity("altarclose", "afx_event_church_altar_door_close.snt", "AltarDoorSource", 0.0f, false);
		PlaySoundAtEntity("altarclose", "afx_event_church_altar_door_close_lowend.snt", "AltarDoorSource", 0.0f, false);
		PlaySoundAtEntity("altarclose", "afx_event_church_altar_door_close_stones.snt", "AltarDoorSource", 0.0f, false);
		StopSound("Organ_2D", 1.0f);
		StopSound("Organ_3D", 1.0f);
		StopSound("Under_Organ", 1.0f);
		
		MandusReactionPlayer("Breath", 3.0f);
		AddTimer("PensMusicTrigger", 9.5f, "AltarStairDeactivations");
		AddTimer("WretchSoundTrigger", 7.5f, "WretchEnterSoundTrigger");
		//SET CHECKPOINT #2//
		CheckPoint("CP02_PensStart", "CheckpointStart_1", "", "", "", false);
		
	}
	if (GetLocalVarInt("candleactivationtracker") == 2 && GetLocalVarInt("FurnaceLit") == 0)
	{
		PlaySoundAtEntity("office_confirm", "afx_church_candle_altar_confirm_office", "OfficeAltarSoundSource", 0.0f, false);
		SetParticleSystemActive("FurnaceFire1", true);
		SetParticleSystemActive("FurnaceFire2", true);
		SetParticleSystemActive("FurnaceFire3", true);
		SetParticleSystemActive("FurnaceEmbers", true);
		PlaySoundAtEntity("FactoryFire3D_2", "amb_factory_machine_fire_3D.snt", "FurnaceSoundSource", 2.0f, true);
		PlaySoundAtEntity("FactoryFire2D_2", "amb_factory_machine_fire_2D.snt", "FurnaceSoundSource", 2.0f, true);
		SetLampFlickerActive("FurnaceLamp", true);
		SetLampLit("FurnaceLamp", true, false);
		SetLeverInteractionDisablesStuck("AltarLever", true);
		SetLocalVarInt("FurnaceLit", 1);
		SetEntityActive("ChurchOfficeHintTrigger", true);
	}
}
//END CHURCH ALTAR COLLIDE EVENTS//

//CHURCH ALTAR LEVER EVENT//
void AltarLeverHandler (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		SetPlayerMoveSpeedMul(0.7f);
		SetEntityActive("altar01", false);
		SetEntityActive("altar02", true);
		PlayPropAnimation("altar_1", "altar_move", 0.0f, false, "");
		PlaySoundAtEntity("altar_3D", "afx_event_church_altar_3D", "AltarSoundSource", 0.0f, false);
		PlaySoundAtEntity("altar_2D", "afx_event_church_altar_2D", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_church_altar_lever_on.snt", "AltarSwitch", 0.0f, false);
		PlaySoundAtEntity("", "amb_church_pens_steam_loop.snt", "PensSteamSource", 0.0f, true);
		SetMoveObjectState("altar_blockbox", -1);
		StartScreenShake (0.05f, 0.75f, 0.2f, 0.5f);
		AddTimer("StepCollisionDeactivate1", 6.0f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate2", 6.5f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate3", 7.0f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate4", 7.5f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate5", 8.0f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate6", 8.5f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate7", 9.0f, "AltarStairDeactivations");
		AddTimer("StepCollisionDeactivate8", 9.5f, "AltarStairDeactivations");
		AddTimer("AltarTimer", 10.0f, "AltarStairDeactivations");
		SetLeverInteractionDisablesStuck("AltarLever", false);
		SetLeverStuckState("AltarLever", 1, false);
	}
}
//END CHURCH ALTAR LEVER EVENT//

//ALTAR STEP DEACTIVATIONS//
void AltarStairDeactivations (string &in asTimer)
{
	if (asTimer == "StepCollisionDeactivate1")
	{
		SetPlayerMoveSpeedMul(1);
		SetEntityActive("stair01", false);
		AddDebugMessage("ACTIVATING: STAIR 01", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate2")
	{
		SetEntityActive("stair02", false);
		AddDebugMessage("ACTIVATING: STAIR 02", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate3")
	{
		SetEntityActive("stair03", false);
		AddDebugMessage("ACTIVATING: STAIR 03", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate4")
	{
		SetEntityActive("stair04", false);
		AddDebugMessage("ACTIVATING: STAIR 04", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate5")
	{
		SetEntityActive("stair05", false);
		AddDebugMessage("ACTIVATING: STAIR 05", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate6")
	{
		SetEntityActive("stair06", false);
		AddDebugMessage("ACTIVATING: STAIR 06", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate7")
	{
		SetEntityActive("stair07", false);
		AddDebugMessage("ACTIVATING: STAIR 07", false);
		return;
	}
	else if (asTimer == "StepCollisionDeactivate8")
	{
		SetEntityActive("stair08", false);
		AddDebugMessage("ACTIVATING: STAIR 08", false);
		
		AddHint("Church4", "");
		return;
	}
	else if (asTimer == "AltarTimer")
	{
		StartScreenShake (0.01, 0.75, 0.1, 0.5);
		return;
	}
	else if (asTimer == "PensMusicTrigger")
	{
		PlayMusic("music_church_pens_ambient.ogg", false, 1.0, 0.0, 0, true);
		return;
	}
}
//END STEP DEACTIVATIONS//
	
