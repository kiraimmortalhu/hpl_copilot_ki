//DEATH HANDLER//
//----------------------------

//-------------------------------------------

void DeathHandler (string &in asName, int alCount)
{
	SetPlayerCrouching(true);
			
	if (alCount == 1)
	{
		AddTimer("Pig3StartPatrol", 2, "TimerPig3StartPatrol");
	}
}

void TimerPig3StartPatrol(string &in asTimer)
{
	SetEntityActive("wretch_3", true);
	SetEnemyDisabled("wretch_3", false);
	ClearEnemyPatrolNodes("wretch_3");
		
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_19", 0, "", false);
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_83", 0, "", false);
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_56", 0, "", false);
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_93", 0, "", false);
}

