//CAGE MOVE EVENT AND TONGUES//
void CageMoveEvent (string &in asParent, string &in asChild, int alState)
{
	float fExtraShakeTime = RandFloat(0.5f,0.75f);
	AddTimer("CageMoveEvent_Timer", 0.5f+fExtraShakeTime, "CageMoveEvent_Timer");
	AddTimer("Tongues_Timer", 6.5f+fExtraShakeTime, "Tongues_Timer");
	AddDebugMessage("Cage Shake Timer Begin and Tongues Timer Begin", false);
}

void CageMoveEvent_Timer (string &in asTimer)
{
	AddPropForce("cage_04_grab_1", -1000.0f, 900.0f, 500.0f, "world");
	PlaySoundAtEntity("CageShake", "afx_church_pens_vo_shake_1.snt", "cage_04_grab_1", 0.0f, false);
	PlaySoundAtEntity("CageShake_2D", "afx_church_pens_vo_shake_1_2D", "cage_04_grab_1", 0.0f, false);
	PlaySoundAtEntity("CageShake", "afx_church_pens_vo_shake_1_loop.snt", "cage_04_grab_1", 0.0f, true);
	PlaySoundAtEntity("CageShake", "afx_church_pens_vo_shake_1_vo.snt", "cage_04_grab_1", 0.0f, false);
	AddTimer("CageShakeTimer1", 0.5f, "CageShake");
	AddTimer("CageShakeTimer2", 1.1f, "CageShake");
	MandusReactionPlayer("Quick", 0.5f);
	MandusReactionPlayer("Breath", 4.5f);
	AddDebugMessage("aww poor lil guy", false);
}

void CageShake (string &in asTimer)
{
	if (asTimer == "CageShakeTimer1")
	{
		AddPropForce("cage_04_grab_1", 1200, 1100, -200, "world");
		PlaySoundAtEntity("CageShake", "ENTERNAME.snt", "cage_04_grab_1", 0, false);
		return;
	}
	else if (asTimer == "CageShakeTimer2")
	{
		AddPropForce("cage_04_grab_1", -700, 700, -700, "world");
		PlaySoundAtEntity("CageShake", "ENTERNAME.snt", "cage_04_grab_1", 0, false);
		return;
	}
}

void Tongues_Timer (string &in asTimer)
{
	PlaySoundAtEntity("Tongues_3D", "afx_church_pens_vo_tongues_3D.snt", "TonguesSource", 0.0f, false);
	PlaySoundAtEntity("Tongues_2D", "afx_church_pens_vo_tongues_2D.snt", "TonguesSource", 0.0f, false);
	AddDebugMessage("Speaking in Tongues Begin", false);
}
//END CAGE MOVE EVENT//


