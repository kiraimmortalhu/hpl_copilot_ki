//-------------------------------------------

void LanternFlicker(float afTime)
{
	SetLanternFlickerActive(true);
	
	AddTimer("LanternFlickerOff", afTime, "TimerLanternFlickerOff");
}

void TimerLanternFlickerOff(string &in asTimer)
{
	SetLanternFlickerActive(false);
}

//-------------------------------------------

//-------------------------------------------

//----------------------------
//END ENCOUNTER HELPERS//
//----------------------------

//----------------------------
//PIG 1 ENCOUNTER//
//----------------------------

//-------------------------------------------

void EnterLanternFlicker_1(string &in asParent, string &in asChild, int alState)
{
	LanternFlicker(6);
	
	AddTimer("LanternFlicker1Late", 12, "TimerLanternFlicker1Late");
	
	//SET CHECKPOINT//
	CheckPoint("CP03_PensCage", "CheckpointStart_1", "DeathHandler", "", "", false);
	
	//*InsertSoundHere* Pig poking around a bit down stairs (short sound)
}

void TimerLanternFlicker1Late(string &in asTimer)
{
	LanternFlicker(7);
}

//-------------------------------------------

void EnterStartPig(string &in asParent, string &in asChild, int alState)
{
	ClearEnemyPatrolNodes("wretch_1");
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_9", 0, "", false);
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_95", 0, "", false);
	
	SetEntityActive("wretch_1", true);
	
	AddEntityCollideCallback("Player", "AreaLanternFlicker_2", "EnterLanternFlicker_2", true, 1);
	AddEntityCollideCallback("wretch_1", "AreaPig1Disappear", "EnterPig1Disappear", true, 1);
	
	PlaySoundAtEntity("wretch_1_howl", "wretch_tunnels_amb_alert.snt", "wretch_1", 0.5, false);
	PlayMusic("music_bilge_dynamo.ogg", false, 0.3, 0.2, 10, false);
	AddTimer("Secondsound", 1.5, "TimerWretchNoise");
	
	SetPlayerMoveSpeedMul(0.6);
	SetPlayerRunSpeedMul(0.6);
}

void TimerWretchNoise(string &in asTimer)
{
	PlaySoundAtEntity("wretch_1_whimp", "wretch_tunnels_amb_notice.snt", "wretch_1", 0.1, false);
	StopMusic(3, 10);
	PlayMusic("music_church_pens_ambient.ogg", false, 1.0, 6, 0, true);
	SetPlayerMoveSpeedMul(1);
	SetPlayerRunSpeedMul(1);
}

void EnterPig1Disappear(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_1", false);
}

//-------------------------------------------

void PigIsDisabled(string &in asEntity, string &in asType)
{
}

