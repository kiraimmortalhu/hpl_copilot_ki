										//////////////////////////
										//MAP-SPECIFIC FUNCTIONS//
										/////////////////////////

//FIRST HINT//
void GiveFirstHint (string &in asTimer)
{
	AddHint("Church1", "");
	return;
}
//END FIRST HINT//
										
//MASK HANDLERS//
void Mask1Spawner (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("Mask1", true);
	SetLocalVarInt("Mask1Active", 1);
}

void Mask2Despawner (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("Mask2", false);
	SetLocalVarInt("Mask2Active", 0);
	RemoveEntityCollideCallback("Player", "Mask2DespawnTrigger1");
	RemoveEntityCollideCallback("Player", "Mask2DespawnTrigger2");
}
//END MASK HANDLERS//
										
//CANDLE FITTING HANDLER//
void CandleFittingHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "CandleFittingCollider" && alState == 1 && GetPropIsInteractedWith(asParent) == true)
	{
		AddDebugMessage("Candle Lever Fitted", false);
		SetEntityActive(asParent, false);
		SetEntityActive("LeftAltarCandle", true);
		PlaySoundAtEntity("", "afx_church_candle_insert.snt", "CandleFittingCollider", 0.0f, false);
		return;
	}
}
//END CANDLE FITTING HANDLER//

//MARY PIG STATUE EVENT//
void StatueEvent (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "StatueEvent_1" || asChild == "StatueEvent_2")
	{
		AddDebugMessage("Statue Trigger Hit", false);
		float fStatueTimer = RandFloat(1.0f,2.0f);
		AddTimer("StatuePigTimer", 1.0f+fStatueTimer, "StatuePigTimer");
		RemoveEntityCollideCallback("Player", "StatueEvent_1");
		RemoveEntityCollideCallback("Player", "StatueEvent_2");
		return;
	}
}

void StatuePigTimer (string &in asTimer)
{
	AddDebugMessage("Statue Event", false);
	PlaySoundAtEntity("PigSuckling", "afx_church_statue_sound.snt", "Player", 0.0f, true);
	return;
}
//END MARY STATUE PIG EVENT//

//CHURCH OFFICE EVENTS//
void ChurchOfficeEvents (string &in asParent, string &in asChild, int alState)
{
	//ENTER OFFICE//
	if (asChild == "ChurchOfficeEntry")
	{
		AddDebugMessage("Church Office Entered", false);
		float fOfficeSound = RandFloat(1.0f, 2.5f);
		AddTimer("OfficeSoundTimer", 4.0f+fOfficeSound, "OfficeSoundTimer");
	}
	
	//LAUGHTER TIMER TRIGGER//
	if (asChild == "LaughterSoundTrigger")
	{
		float fExtraLaugh = RandFloat(1.0f,2.5f);
		AddTimer("LaughterTimer", 1.0f+fExtraLaugh, "ChurchLaughterTimer");
		AddDebugMessage("Laughter Timer Begin", false);
		return;
	}
}

void OfficeSoundTimer (string &in asTimer)
{
	PlaySoundAtEntity("MonsterSound", "afx_spooky_eerie_monster_type2_louder.snt", "OfficeSoundSource", 0.0f, true);
	AddDebugMessage("Office Sound Triggered", false);
	return;
}	

void ChurchLaughterTimer (string &in asTimer)
{
	PlaySoundAtEntity("Laugh", "afx_church_chuckle", "Player", 0.0f, true);
	AddDebugMessage("TeeHee", false);
	return;
}
//END OFFICE EVENTS

//STOREROOM EVENTS//
void StoreroomEvents (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "StoreroomEntry")
	{
		AddEntityCollideCallback("Player", "ChurchOfficeEntry", "ChurchOfficeEvents", true, 1);
		AddEntityCollideCallback("Player", "StatueEvent_1", "StatueEvent", true, 1);
		AddEntityCollideCallback("Player", "StatueEvent_2", "StatueEvent", true, 1);
		AddEntityCollideCallback("Player", "LaughterSoundTrigger", "ChurchOfficeEvents", true, 1);
		float fStoreroomSound = RandFloat(3.0f, 5.5f);
		AddTimer("StoreroomSoundTimer", 0.5f+fStoreroomSound, "StoreroomSoundTimer");
		AddDebugMessage("Storeroom Entered - Timer Started", false);
	}
}

void StoreroomSoundTimer (string &in asTimer)
{
	AddDebugMessage("Storeroom Sound Triggered", false);
	PlaySoundAtEntity("Scream", "afx_church_female_scream_muffled", "StoreroomSource", 0.0f, true);
	MandusReactionPlayer("Breath", 1.5f);
	return;
}	
//END STOREROOM EVENTS//

//ALTAR EVENT AREA//
void PlayerEnterAltarArea (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Altar Area Entered - Front Area spawned", false);
	AddEntityCollideCallback("Player", "FrontAreaTrigger", "FrontAreaTrigger", true, 1);
}

void FrontAreaTrigger (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Front Area Timer Start", false);
	float fExtraFront = RandFloat(1.0f, 2.5f);
	AddTimer("FrontAreaTimer", 4.0f+fExtraFront, "FrontAreaTimer");
}

void FrontAreaTimer (string &in asTimer)
{
	PlaySoundAtEntity("Scream", "afx_spooky_pig_scream", "FrontAreaSoundSource", 0.0f, true);
	AddDebugMessage("Front Area Events", false);
	return;
}

//END ALTAR AREA EVENTS//
	
//RANDOM SOUND CUE PLAYER CHURCH AREA//
void ChurchEntryTriggers (string &in asParent, string &in asChild, int alState)
{
	//CHURCH ENTRY//
	if (asChild == "ChurchEntry_1" || asChild == "ChurchEntry_2")
	{
		//REMOVE ENTRY AREAS//
		RemoveEntityCollideCallback("Player", "ChurchEntry_1");
		RemoveEntityCollideCallback("Player", "ChurchEntry_2");
		
		//ADD EXIT AREAS//
		AddEntityCollideCallback("Player", "ChurchExit_1", "ChurchEntryTriggers", true, 1);
		AddEntityCollideCallback("Player", "ChurchExit_2", "ChurchEntryTriggers", true, 1);
		AddEntityCollideCallback("Player", "ChurchExit_3", "ChurchEntryTriggers", true, 1);
		
		//START SOUND TIMERS//
		AddTimer("InitRandomChurchBenchCreakPlayer", 10.0f, "RandChurchBenchCreakCues");
		AddTimer("InitRandomWhisperPlayer", 5.0f, "RandWhisperCues");
		AddDebugMessage("Church Entered - Sound Timers Begin", false);
	}

	
	//CHURCH EXIT//
	if (asChild == "ChurchExit_1" || asChild == "ChurchExit_2" || asChild == "ChurchExit_3")
	{
		//RECREATE ENTRY TRIGGERS//
		AddEntityCollideCallback("Player", "ChurchEntry_1", "ChurchEntryTriggers", true, 1);
		AddEntityCollideCallback("Player", "ChurchEntry_2", "ChurchEntryTriggers", true, 1);
		
		//REMOVE EXIT AREAS//
		RemoveEntityCollideCallback("Player", "ChurchExit_1");
		RemoveEntityCollideCallback("Player", "ChurchExit_2");
		RemoveEntityCollideCallback("Player", "ChurchExit_3");
		
		//TIMER REMOVAL//
		RemoveTimer("RandChurchBenchCreakCues");
		RemoveTimer("RandWhisperCues");
		RemoveTimer("RandBugCues");
		RemoveTimer("InitRandomChurchBenchCreakPlayer");
		RemoveTimer("InitRandomWhisperPlayer");
		RemoveTimer("InitRandomBugPlayer");
		
		RemoveTimer("RandBenchSource_1");
		RemoveTimer("RandBenchSource_2");
		RemoveTimer("RandBenchSource_3");
		RemoveTimer("RandBenchSource_4");
		RemoveTimer("RandBenchSource_5");
		RemoveTimer("RandBenchSource_6");
		RemoveTimer("Player");
		
		//DEBUG MESSAGE//
		AddDebugMessage("Church Exited - Sound Timers Removed", false);
	}
}


//ORGAN MUSIC AND MUSICIAN//
void OrganMusicEvent (string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("Under_Organ", "Cue_under_organ_145", "Player", 0.0f, true);
	PlaySoundAtEntity("Organ_2D", "afx_church_organ_music_2D", "Player", 0.0f, true);
	PlaySoundAtEntity("Organ_3D", "afx_church_organ_music_3D", "OrganSource", 0.0f, true);
	AddTimer("OrganTimeOut", 96.0f, "OrganTimeOut");
	AddDebugMessage("Organ On", false);	
		
	//PlayGuiSound("wretch_tunnels_amb_alert_03.ogg",0.1f);
	//AddTimer("close", 0.4f, "TimerDelayMusic");
	//AddTimer("music", 0.6, "TimerDelayMusic");
}

void TimerDelayMusic(string &in asTimer)
{
	if(asTimer == "close")
	{
		SetSwingDoorLocked("NC_door_6", true, true);
		SetSwingDoorLocked("NC_door_2", true, true);
		SetSwingDoorLocked("NC_door_3", true, true);
	}
	else
	{
		PlaySoundAtEntity("Under_Organ", "Cue_under_organ_145", "Player", 0.0f, true);
		PlaySoundAtEntity("Organ_2D", "afx_church_organ_music_2D", "Player", 0.0f, true);
		PlaySoundAtEntity("Organ_3D", "afx_church_organ_music_3D", "OrganSource", 0.0f, true);
		AddTimer("OrganTimeOut", 96.0f, "OrganTimeOut");
		AddDebugMessage("Organ On", false);	
	}
}

void OrganTimeOut (string &in asTimer)
{
	RemoveEntityCollideCallback("AltarLever", "AltarSwitchCollider_Organ");
	AddDebugMessage("Organ Timed Out", false);
}

void AltarSwitchCollider_Organ (string &in asParent, string &in asChild, int alState)
{
