		else if (asChild == "AMBAreaDoorRattle")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("doorrattle", "amb_church_loadingarea_door_rattle.snt", "AMBDoorRattle_Source", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("doorrattle", 1.0f);
				return;
			}
		}
//BREAK//
		else if (asChild == "AMBAreaDoorRattle2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("doorrattle2", "amb_church_loadingarea_door_rattle.snt", "AMBDoorRattle_Source", 1.0f, true);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("doorrattle2", 1.0f);
				return;
			}
		}
//BREAK//			
		else if (asChild == "WindowCollisionArea" && GetLocalVarInt("corridorwindareabool") == 1)
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("windowwind", "amb_loadingarea_windowopen_wind.snt", "WindowWind_Source", 1.0f, true);
				return;
			}
			else if (alState == -1 || GetLocalVarInt("corridorwindareabool") == 0) 
			{
				StopSound("windowwind", 1.0);
				return;
			}
		}
}
//END AMBIENT SOUNDTRACK PLAYER//

