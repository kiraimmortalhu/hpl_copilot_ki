//DEACTIVATE LEVEL LIGHTS//
void DeactivateLevelLights()
{
	//POINT LIGHTS//
	for (int lval = 33; lval < 47; lval++)
	{
		SetLightVisible("PointLight_"+lval, false);
	}
	SetLightVisible("PointLight_20", false);
	SetLightVisible("PointLight_21", false);
	SetLightVisible("PointLight_50", false);
	SetLightVisible("PointLight_52", false);
	SetLightVisible("PointLight_55", false);
	SetLightVisible("PointLight_56", false);
	SetLightVisible("PointLight_57", false);
	SetLightVisible("PointLight_58", false);
	SetLightVisible("PointLight_59", false);
	SetLightVisible("PointLight_61", false);
	SetLightVisible("PointLight_62", false);
	SetLightVisible("PointLight_66", false);
	SetLightVisible("PointLight_67", false);
	//LAMPS//
	for (int lval = 1; lval < 14; lval++)
	{
		SetLampLit("FloorLamp_"+lval, false, false);
	}
	SetLampLit("tube_lamp_factory_ceiling_short_8", false, false);
	SetLampLit("tube_lamp_factory_ceiling_short_9", false, false);
	for (int lval = 6; lval < 12; lval++)
	{
		SetLampLit("engineroom_lamp_"+lval, false, false);
	}
	//CAUSTIC ADJUSTMENT//
	for (int lval = 1; lval < 17; lval++)
	{
		FadeLightTo("caustics_"+lval, 0.051f, 0.051f, 0.034f, 1.0f, -1, 0.1f);
	}
}
//END DEACTIVATE LEVEL LIGHTS//

//WATER DAMAGE HANDLER//
void WaterDamageHandler (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("PlayerInElectricWater", 1);
		
		// Start electrocution effects
		if (GetTimerTimeLeft("ElectroCuteTimer") == 0)
		{
			ElectroCute("");
			//AddTimer("ElectroKillTimer", 2.0f, "ElectroKill");
		}
	}
	else if (alState == -1)
	{
		SetLocalVarInt("PlayerInElectricWater", 0);
		FadeImageTrailTo(0, 0.2f);
		return;
	}
}

void ElectroCute (string &in asTimer)
{
	if (GetLocalVarInt("PlayerInElectricWater") == 0) return;
	
	if (GetPlayerHealth() > 20)
		AddPlayerHealth(-20);
	else
		SetPlayerHealth(1);
	
	PlaySoundAtEntity("", "react_electrocute", "Player", 0.0f, false);
	StartEffectFlash(0.8f, 0.06f, 0.07f);
	FadeImageTrailTo(1.2f, 10.0f);
	AddTimer("ElectroCuteTimer", 1.5f, "ElectroCute");
}

void ElectroKill (string &in asTimer)
{
	//DO ELECTRO KILL SEQUENCE
	AddDebugMessage("Shock Therapy", false);
}
//END WATER DAMAGE HANDLER//

//TRIPERY TELEPORT EVENT HANDLER//
void TriperyHandler (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("HeartRemoval", false);
	PlayPropAnimation("child_1", "RemoveHeart", 0.0f, false, "");
	PlayPropAnimation("child_2", "RemoveHeart", 0.0f, false, "");
	FadeImageTrailTo(2.f, 6.5f);
	SetPlayerMoveSpeedMul(0.25f);
	SetPlayerRunSpeedMul(0.25f);
	SetPlayerLookSpeedMul(0.25f);
	AddTimer("ChildLaughter", 0.25f, "TriperyTimer");
	AddTimer("ReverbSound", 0.2f, "TriperyTimer");
	AddTimer("FadeOut", 4.7f, "TriperyTimer");
	AddTimer("HoldPlayer", 5.6f, "TriperyTimer");
	AddTimer("Teleport", 8.2, "TriperyTimer");
	AddTimer("FadeInRestore", 9.0, "TriperyTimer");
}

void TriperyTimer (string &in asTimer)
{
	if (asTimer == "ChildLaughter")
	{
		PlaySoundAtEntity("ChildLaugh", "afx_spooky_child_laugh_semi_distant.snt", "LaughterSource", 0.0f, false);
		return;
	}
	else if (asTimer == "ReverbSound")
	{
		PlaySoundAtEntity("Reverb", "afx_nursery_reverb.snt", "Player", 0.0f, false);
		return;
	}
	else if (asTimer == "FadeOut")
	{
		StartScreenShake(0.5, 0.1, 0, 0);
		FadeOut(0.1f);
		StopSound("PigDinner", 0.1f);
		StopSound("DiesesHerz", 0.1f);
		PlaySoundAtEntity("triperya", "afx_tripery_shouts_08.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyb", "afx_tripery_shouts_04.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyc", "afx_tripery_shouts_02.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyd", "afx_tripery_shouts_01.snt", "Player", 1.0f, false);
		FadeGlobalSoundSpeed(0.5, 1);
		FadeGlobalSoundVolume(0,3.5);
		return;
	}
	else if (asTimer == "HoldPlayer")
	{
		SetPlayerActive(false);
		PlaySoundAtEntity("triperye", "afx_tripery_shouts_07.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyf", "afx_tripery_shouts_05.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyg", "afx_tripery_shouts_06.snt", "Player", 1.0f, false);
		PlaySoundAtEntity("triperyh", "afx_tripery_shouts_03.snt", "Player", 1.0f, false);
		
		SetEntityActive("child_1", false);
		SetEntityActive("child_2", false);
		SetEntityActive("male_corpse_torso_2", true);
		SetEntityActive("male_corpse_torso_3", true);
		
		//By kids
SetParticleSystemActive("ParticleSystem_1", false); SetParticleSystemActive("ParticleSystem_2", false); SetParticleSystemActive("ParticleSystem_3", false);
SetParticleSystemActive("ParticleSystem_5", false); SetParticleSystemActive("ParticleSystem_6", false); SetParticleSystemActive("ParticleSystem_7", false);
SetParticleSystemActive("ParticleSystem_8", false); SetParticleSystemActive("ParticleSystem_9", false); SetParticleSystemActive("ParticleSystem_10", false);
SetParticleSystemActive("ParticleSystem_11", false); SetParticleSystemActive("ParticleSystem_49", false); SetParticleSystemActive("ParticleSystem_50", false);
SetParticleSystemActive("ParticleSystem_51", false);

//At end
SetParticleSystemActive("ParticleSystem_66", true); SetParticleSystemActive("ParticleSystem_67", true); SetParticleSystemActive("ParticleSystem_70", true);
SetParticleSystemActive("ParticleSystem_71", true); SetParticleSystemActive("ParticleSystem_73", true); SetParticleSystemActive("ParticleSystem_74", true);
SetParticleSystemActive("ParticleSystem_76", true); SetParticleSystemActive("ParticleSystem_77", true); SetParticleSystemActive("ParticleSystem_79", true);
SetParticleSystemActive("ParticleSystem_80", true); SetParticleSystemActive("ParticleSystem_81", true); SetParticleSystemActive("ParticleSystem_82", true);
SetParticleSystemActive("ParticleSystem_83", true); SetParticleSystemActive("ParticleSystem_98", true); SetParticleSystemActive("ParticleSystem_99", true);
		return;
	}
	else if (asTimer == "Teleport")
	{
		AddTimer("SoundOpt_FinalSplatter_StartSound", 0.2f, "SoundOpt_FinalSplatter_StartSound");
		FadeImageTrailTo(1.2f, 1.0f);
		TeleportPlayer("TriperyFloor");
		SetPlayerMoveSpeedMul(0.75f);
		SetPlayerRunSpeedMul(0.25f);
		SetPlayerLookSpeedMul(0.5f);
		FadeGlobalSoundSpeed(1, 8);
		FadeGlobalSoundVolume(1,6);
	}
	else if (asTimer == "FadeInRestore")
	{
		MandusReactionPlayer("Breath", 0);
		FadeIn(4.0f);
		SetPlayerActive(true);
		FadeGlobalSoundVolume(1.0f, 4.0f);
		return;
	}
}
//END TRIPERY EVENT HANDLER//

//TRIPERY END ROOM PLAYER MOVEMENT//
void TriperyPlayerSpeedHandler(string &in asParent, string &in asChild, int alState)
{
	if (asChild == "SlowArea_1")
	{
		AddDebugMessage("SLOW", false);
		SetPlayerMoveSpeedMul(0.75f);
		SetPlayerRunSpeedMul(0.25f);
		SetPlayerLookSpeedMul(0.5f);
		return;
	}
	else if (asChild == "SlowArea_2A" || asChild == "SlowArea_2B" || asChild == "SlowArea_2C")
	{
		AddDebugMessage("SLOWER", false);
		SetPlayerMoveSpeedMul(0.55f);
		SetPlayerRunSpeedMul(0.20f);
		SetPlayerLookSpeedMul(0.5f);
		return;
	}
	else if (asChild == "SlowArea_3A" || asChild == "SlowArea_3B" || asChild == "SlowArea_3C")
	{
		AddDebugMessage("SLOWEST...", false);
		SetPlayerMoveSpeedMul(0.35f);
		SetPlayerRunSpeedMul(0.15f);
		SetPlayerLookSpeedMul(0.4f);
		return;
	}
	else if (asChild == "SlowArea_4A" || asChild == "SlowArea_4B" || asChild == "SlowArea_4C")
	{
		AddDebugMessage("SERIOUSLY, NOT THIS WAY...", false);
		SetPlayerMoveSpeedMul(0.15f);
		SetPlayerRunSpeedMul(0.10f);
		SetPlayerLookSpeedMul(0.3f);
		return;
	}
}	
//END TRIPERY PLAYER MOVEMENT//

//LEVEL TRANSITION HANDLER//
void LevelTransitionStart (string &in asTimer)
{
	FadeOut(5.0f);
	StopSound("LiftLoop", 7);
	AddTimer("DoTransition", 8.0f, "DoTransition");
	PlayMusic("236_Level_music_to_tesla", false, 1.0f, 2.0f, 6, false);
}

void DoTransition (string &in asTimer)
{
	ChangeMap("14_tesla_01.map", "MainStart", "", "");
}
//END LEVEL TRANSITION HANDLER//

//RETURN TO NORMAL ALL//
void ReturntoNormalTimer (string &in asTimer)
{
	if (asTimer == "ReturnToNormal")
	{
		FadeImageTrailTo(0.0f, 3.0f);
		SetPlayerLookSpeedMul(1.0f);
		SetPlayerMoveSpeedMul(1.0f);
		return;
	}
	else if (asTimer == "SoundVolume")
	{
		FadeGlobalSoundVolume(1, 1);
	}
}
//END RETURN TO NORMAL//

