//SOUND OPTIMISATIONS//
	//SOUND OPTIMISATIONS//
void soundopt (string &in asParent, string &in asChild, int alState)
{
//BLOOD PUMPS
	if (asChild == "soundopt_bloodpump_start_1"|| asChild == "soundopt_bloodpump_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_bloodpump_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_bloodpump_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_bloodpump_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_bloodpump_stop_2", "soundopt", true, 1);
	
	//START SOUNDS
	PlaySoundAtEntity("soundopt_bloodpumpsource_1", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_1", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpumpsource_2", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_2", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpumpsource_3", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_3", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpumpsource_4", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_4", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpumpsource_5", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_5", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpumpsource_6", "amb_pigline_bloodpump_loop", "soundopt_bloodpumpsource_6", 1.5f, true);
	
	PlaySoundAtEntity("soundopt_bloodsplattersource_1", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_1", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplattersource_2", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_2", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplattersource_3", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_3", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplattersource_4", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_4", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplattersource_5", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_5", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplattersource_6", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplattersource_6", 1.5f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Blood Pump Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_bloodpump_stop_1"|| asChild == "soundopt_bloodpump_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_bloodpump_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_bloodpump_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_bloodpump_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_bloodpump_start_2", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	StopSound("soundopt_bloodpumpsource_1", 2.0f);
	StopSound("soundopt_bloodpumpsource_2", 2.0f);
	StopSound("soundopt_bloodpumpsource_3", 2.0f);
	StopSound("soundopt_bloodpumpsource_4", 2.0f);
	StopSound("soundopt_bloodpumpsource_5", 2.0f);
	StopSound("soundopt_bloodpumpsource_6", 2.0f);
	
	StopSound("soundopt_bloodsplattersource_1", 2.0f);
	StopSound("soundopt_bloodsplattersource_2", 2.0f);
	StopSound("soundopt_bloodsplattersource_3", 2.0f);
	StopSound("soundopt_bloodsplattersource_4", 2.0f);
	StopSound("soundopt_bloodsplattersource_5", 2.0f);
	StopSound("soundopt_bloodsplattersource_6", 2.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Blood Pump Sounds", true);
	}
//BREAK
//SECOND BLOOD PUMPS
	if (asChild == "soundopt_bloodpump2_triggerstart_1"|| asChild == "soundopt_bloodpump2_triggerstart_2")
	{
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_bloodpump2_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_bloodpump2_stop_2", "soundopt", true, 1);
	
	//START SOUNDS
	PlaySoundAtEntity("soundopt_bloodpump2_start_1", "amb_pigline_bloodpump_loop", "soundopt_bloodpump2_start_1", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpump2_start_2", "amb_pigline_bloodpump_loop", "soundopt_bloodpump2_start_2", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpump2_start_3", "amb_pigline_bloodpump_loop", "soundopt_bloodpump2_start_3", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodpump2_start_4", "amb_pigline_bloodpump_loop", "soundopt_bloodpump2_start_4", 1.5f, true);
	
	PlaySoundAtEntity("soundopt_bloodsplatter2_start_1", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplatter2_start_1", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplatter2_start_2", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplatter2_start_2", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplatter2_start_3", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplatter2_start_3", 1.5f, true);
	PlaySoundAtEntity("soundopt_bloodsplatter2_start_4", "amb_pigline_bloodsplatter_loop", "soundopt_bloodsplatter2_start_4", 1.5f, true);
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Blood Pump 2 Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_bloodpump2_stop_1"|| asChild == "soundopt_bloodpump2_stop_1")
	{	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_bloodpump2_triggerstart_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_bloodpump2_triggerstart_2", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	StopSound("soundopt_bloodpump2_start_1", 2.0f);
	StopSound("soundopt_bloodpump2_start_2", 2.0f);
	StopSound("soundopt_bloodpump2_start_3", 2.0f);
	StopSound("soundopt_bloodpump2_start_4", 2.0f);
	
	StopSound("soundopt_bloodsplatter2_start_1", 2.0f);
	StopSound("soundopt_bloodsplatter2_start_2", 2.0f);
	StopSound("soundopt_bloodsplatter2_start_3", 2.0f);
	StopSound("soundopt_bloodsplatter2_start_4", 2.0f);
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Blood Pump 2 Sounds", true);
	}
//BREAK
}

//Final Splatter
void SoundOpt_FinalSplatter_StartSound(string &in asTimer)
{
	//START SOUNDS
	PlaySoundAtEntity("soundopt_finalsplatter_source_1", "amb_pigline_bloodpump_waterfall", "soundopt_finalsplatter_source_1", 2.5f, true);
	PlaySoundAtEntity("soundopt_finalsplatter_source_2", "amb_pigline_bloodpump_waterfall", "soundopt_finalsplatter_source_2", 2.5f, true);
