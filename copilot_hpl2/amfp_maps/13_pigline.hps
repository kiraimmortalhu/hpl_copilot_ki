//COG OBSTRUCTION VISUAL HINT//

void TankCogShakeSequence (string &in asTimer)
{
	if (asTimer == "ShakeSequenceStep_StartQuake")
	{
		StartScreenShake (0.07f, 1.f, 1.5f, 2.5f);
		AddTimer("ShakeSequenceStep_2", 0.8f, "TankCogShakeSequence");
		AddTimer("ShakeSequenceStep_3", 1.5f, "TankCogShakeSequence");
		AddTimer("ShakeSequenceStep_4", 2.25f, "TankCogShakeSequence");
		AddTimer("ShakeSequenceStep_5", 3.5f, "TankCogShakeSequence");
	}
	else if (asTimer == "ShakeSequenceStep_2")
	{
		AddPropImpulse("OrgoneTank_1", 0.5f, 0, 0, "world");
	}
	else if (asTimer == "ShakeSequenceStep_3")
	{
		AddPropImpulse("OrgoneTank_1", -0.5f, 0, 0, "world");
	}
	else if (asTimer == "ShakeSequenceStep_4")
	{
		AddPropImpulse("OrgoneTank_1", -0.8f, 0, 0, "world");
	}
	else if (asTimer == "ShakeSequenceStep_5")
	{
		AddPropImpulse("OrgoneTank_1", 0.3f, 0, 0, "world");
	}
}
//END COG OBSTRUCTION VISUAL HINT//

// -------------------------------------------------------
//PLAYER COG DEATH//
void DeathOfTheDumb(string &in asParent, string &in asChild, int alState)
{
	CheckPoint("AtCanisters", "AtCanisters", "ResetCheckPoint", "", "", false);
	
	AddTimer("cogd1", 0, "TimerYouGotCogged");
	
	if(GetLocalVarInt("CogInDaPit") == 1) return;
	
	AddTimer("cogd2", 0.2, "TimerYouGotCogged");
	AddTimer("cogd3", 0.3, "TimerYouGotCogged");
	AddTimer("cogd4", 0.5, "TimerYouGotCogged");
}

void ResetCheckPoint(string &in asName, int alCount)
{
	FadeIn(0.5);
	SetPlayerActive(true);
	CheckPoint("CP02_Ladder", "CheckpointStart_2", "DeathHandler", "", "", false);
}

void TimerYouGotCogged(string &in asTimer)
{
		if(asTimer == "cogd1")
		{
			FadeOut(0.5f);
			PlayGuiSound("react_hurt_hit.snt", 1);
			PlayGuiSound("infection_stinger_4.ogg", 1);
			SetPlayerHealth(0);
			SetPlayerActive(false);
		}
		
		if(asTimer == "cogd2")
		{
			PlayGuiSound("player_falldamage_high1.ogg", 0.8);
			PlayGuiSound("afx_spooky_metal_grind_all.snt", 1);
		}
		
		if(asTimer == "cogd3")
		{
			PlayGuiSound("player_falldamage_low2.ogg", 0.6);
		}
		
		if(asTimer == "cogd4")
		{
			PlayGuiSound("player_falldamage_low1.ogg", 0.3);
			PlayGuiSound("afx_spooky_metal_grind_all.snt", 0.7);
			
			SetEntityActive("blood_smear_2", true);
			SetEntityActive("blood_smear_1", true);
		}
}

//PLAYER COG DEATH END//
// -------------------------------------------------------

//COG OBSTRUCTION SEQUENCE//
void CogObstructionHandler (string &in asParent, string &in asChild, int alState)
{
	AddDebugMessage("Throwing a spanner in the works...", false);

	for (int lval = 1; lval < 76; lval++)
	{
		if (GetEntityExists("OrgoneTank_"+lval) == false) continue;
		
		RemoveEntityCollideCallback("OrgoneTank_"+lval, "CogCollider");
	}
	SetLocalVarInt("CogInDaPit", 1);
	SetLocalVarString("OrgoneTankInCogs", asParent);
	CreateParticleSystemAtEntity("TankImpact1", "ps_dust_impact.ps", asParent, false);
	CogSequenceResults("");
	SetPlayerMoveSpeedMul(0.5);
	SetPlayerRunSpeedMul(0.5);
	
	SetEntityActive("grinder_blades_1", false);
	SetEntityActive("Conveyor_Body_*", false);

	SetSwingDoorLocked("factory_corridor_01_door_2", true, false);
	SetLampLit("tube_lamp_factory_ceiling_short_4", false, false);
	SetLampLit("oval_wall_lamp_2m_pipe_35", false, false);
	//SetEntityActive("oval_wall_lamp_2m_pipe_35", false);
	SetLightVisible("PointLight_68", false);
	SetLightVisible("PointLight_45", false);
	SetLampLit("tube_lamp_factory_ceiling_short_1", false, false);
	
	//start
SetParticleSystemActive("ParticleSystem_15", false); SetParticleSystemActive("ParticleSystem_16", false); SetParticleSystemActive("ParticleSystem_21", false);
SetParticleSystemActive("ParticleSystem_24", false); SetParticleSystemActive("ParticleSystem_100", false); SetParticleSystemActive("ParticleSystem_26", false);
SetParticleSystemActive("ParticleSystem_25", false); SetParticleSystemActive("ParticleSystem_22", false); SetParticleSystemActive("ParticleSystem_23", false);
SetParticleSystemActive("ParticleSystem_27", false); SetParticleSystemActive("ParticleSystem_91", false); SetParticleSystemActive("ParticleSystem_92", false);
SetParticleSystemActive("ParticleSystem_93", false); SetParticleSystemActive("ParticleSystem_94", false); SetParticleSystemActive("ParticleSystem_95", false);
SetParticleSystemActive("ParticleSystem_84", false); SetParticleSystemActive("ParticleSystem_85", false); SetParticleSystemActive("ParticleSystem_86", false);
SetParticleSystemActive("ParticleSystem_87", false); SetParticleSystemActive("ParticleSystem_88", false); SetParticleSystemActive("ParticleSystem_89", false);
}

void CogSequenceResults (string &in asTimer)
{
	StartScreenShake (0.15f, 1.5f, 0.01f, 0.5f);
	PlaySoundAtEntity("", "afx_big_gears_breakdown", "Player", 0.0f, false);
	PlaySoundAtEntity("Flood_Ambience", "amb_pigline_after_flood.snt", "AMB_area_base", 5.0f, true);
	AddTimer("piglinefloodsound", 2.0f, "piglinefloodsoundcall");
	PlaySoundAtEntity("water_lap", "amb_sewer_water_loop_med_3D.snt", "ElectroSmallSource_9", 0.0f, true);
	PlaySoundAtEntity("Flood_Stream_1", "amb_pigline_bloodpump_waterfall_lr.snt", "FloodSoundSource_1", 0, true);
	PlaySoundAtEntity("Flood_Stream_2", "amb_pigline_bloodpump_waterfall_lr.snt", "FloodSoundSource_2", 0, true);
	PlaySoundAtEntity("Flood_Stream_3", "amb_pigline_bloodpump_waterfall_lr.snt", "FloodSoundSource_3", 0, true);
	
	
	//SPLASHES
	PlaySoundAtEntity("splashsource_1", "amb_sewers_water_particle_tunnel_01_3D.snt", "splashsource_1", 0, true);
	PlaySoundAtEntity("splashsource_12D", "amb_sewers_water_particle_tunnel_01_2D.snt", "splashsource_1", 0, true);
	PlaySoundAtEntity("splashsource_2", "amb_sewers_water_particle_tunnel_02_3D.snt", "splashsource_2", 0, true);
	PlaySoundAtEntity("splashsource_22D", "amb_sewers_water_particle_tunnel_02_2D.snt", "splashsource_2", 0, true);
	PlaySoundAtEntity("splashsource_3", "amb_reactor_descent_watersplash1_3D.snt", "splashsource_3", 0, true);
	PlaySoundAtEntity("splashsource_32D", "amb_reactor_descent_watersplash1_2D.snt", "splashsource_3", 0, true);
	PlaySoundAtEntity("splashsource_4", "amb_reactor_descent_watersplash2_3D.snt", "splashsource_4", 0, true);
	PlaySoundAtEntity("splashsource_42D", "amb_reactor_descent_watersplash2_2D.snt", "splashsource_4", 0, true);
	PlaySoundAtEntity("splashsource_5", "amb_reactor_descent_watersplash3_3D.snt", "splashsource_5", 0, true);
	PlaySoundAtEntity("splashsource_52D", "amb_reactor_descent_watersplash3_2D.snt", "splashsource_5", 0, true);
	PlaySoundAtEntity("splashsource_6", "amb_sewers_water_particle_tunnel_01_3D.snt", "splashsource_6", 0, true);
	PlaySoundAtEntity("splashsource_62D", "amb_sewers_water_particle_tunnel_01_2D.snt", "splashsource_6", 0, true);
	PlaySoundAtEntity("splashsource_7", "amb_bilge_waterwood_01_3D_lr.snt", "splashsource_7", 0, true);
	PlaySoundAtEntity("splashsource_72D", "amb_bilge_waterwood_01_2D_lr.snt", "splashsource_7", 0, true);
	
	SetEntityActive("BurstTankAmbArea", true);
	for (int lval = 6; lval > 0; lval--)
	{
		StopSound("TanksLeak_"+lval, 0);
	}
	StopSound("Base_Ambience", 2.0f);
	StopSound("CogAudio", 0.5f);
	StopSound("CogAudio_Distant", 0.5f);
	for (int lval = 76; lval > 0; lval--)
	{
		SetParticleSystemActive("burst_tank_"+lval, true);
	}
	FadeImageTrailTo(1.6f, 0.3f);
	AddTimer("CogSequenceResultsStep2", 0.45f, "CogSequenceResultsStep2");
	
	SetLeverStuckState("Spotlight", -1, false);
	SetLeverInteractionDisablesStuck("Spotlight", false);
	AddPropImpulse("Spotlight", 0.f, -5.0f, 0.0f, "world");
	
	//RANDOM SOUND CUE PLAYER
	AddTimer("InitRandomGroanSoundCues", 3.0f, "GroanSoundCues");
	AddTimer("InitRandomEerieSoundCues", 4.0f, "EerieSoundCues");
	AddTimer("InitRandomGroan2SoundCues", 6.0f, "Groan2SoundCues");

	SetLightVisible("PointLight_160", true);
	PlaySoundAtEntity("Water", "amb_sewers_water_particle_tunnel_03_3D_piglinehint.snt", "ElectrifiedWaterSource_3", 0.0f, true);
}

void piglinefloodsoundcall(string &in asTimer)
{
	PlaySoundAtEntity("flood", "afx_flooding.snt", "Player", 0.0f, false);
}

void CogSequenceResultsStep2 (string &in asTimer)
{
	string sTank = GetLocalVarString("OrgoneTankInCogs");
	SetEntityActive("PiglineWaterPlane", true);
	SetEntityActive("PiglineWaterPlaneSmall", true);
	SetEntityActive("PiglineWaterArea", true);
	SetEntityActive("PiglineWaterAreaSmall", true);
	SetEntityActive("StaticBrokenTank", true);
	SetParticleSystemActive("CogSparks_1", true);
	SetParticleSystemActive("CogSparks_2", true);
	SetParticleSystemActive("CogSparks_3", true);
	SetParticleSystemActive("CogBigSmoke", true);
	PlayPropAnimation("CogRoomCogs", "static", 0.0f, true, "");
	StartPlayerLookAt("QuakeLookTarget", 10.0f, 10.0f, "");
	CreateParticleSystemAtEntity("TankImpact1", "ps_dust_impact.ps", sTank, false);
	SetEntityActive(sTank, false);
	for (int lval = 1; lval < 17; lval++)
	{
		SetLightVisible("caustics_"+lval, true);
	}
	AddTimer("LookAt2", 0.35f, "LookAt2");
	AddTimer("EndLookAt", 1.0f, "EndLookAt");

	SetLocalVarInt("CogPuzzleSolved", 1);
	SetLeverInteractionDisablesStuck("Spotlight", true);
}

void LookAt2 (string &in asTimer)
{
	StartPlayerLookAt("QuakeLookTarget2", 10.0f, 10.0f, "");
}
void EndLookAt (string &in asTimer)
{
	StopPlayerLookAt();
	FadeImageTrailTo(0.0f, 5.0f);
	SetPlayerMoveSpeedMul(1);
	SetPlayerRunSpeedMul(1);
	AddEntityCollideCallback("Player", "PostFloodVO", "VOPlayer", true, 1);
}

