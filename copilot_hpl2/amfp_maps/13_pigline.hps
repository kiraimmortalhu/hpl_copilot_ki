	//DEBUG MESSAGE
	AddDebugMessage("Start Blood Splatter Final Sounds", true);
}

//END SOUND OPTIMISATIONS

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "TriperyMusic")
	{
		PlayMusic("intro_part2.ogg", false, 1.0f, 6.0f, 0, false);
		SetEntityActive("tripery_wretch_1", true);
		PlayPropAnimation("tripery_wretch_1", "NestPlayPigline", 0.0f, true, "");
		SetEntityActive("tripery_wretch_2", true);
		PlayPropAnimation("tripery_wretch_2", "NestSleep", 0.0f, true, "");
		SetEntityActive("pig_blocks_1", true);
		PlayPropAnimation("pig_blocks_1", "animated", 0.0f, true, "");
		//PlaySoundAtEntity("BlockPigSounds", "afx_sewer_wretch_blocks_pigline", "BlockPigSoundsArea", 0, true);
		SetEntityActive("child_1", true);
		PlayPropAnimation("child_1", "IdleBipedExtra2", 0.0f, true, "");
		SetEntityActive("child_2", true);
		PlayPropAnimation("child_2", "IdleBipedExtra3", 0.0f, true, "");
		PlaySoundAtEntity("Tripery_Music_Ambience", "music_cellar_post_pigsmash1.snt", "AMB_Tripery", 0.0f, true);
		//SET CHECKPOINT #3//
		CheckPoint("CP03_Tripery", "CheckpointStart_3", "", "", "", false);
		return;
	}
	
	else if (asChild == "NurseryTrigger")
	{
		PlaySoundAtEntity("DiesesHerz", "amb_mans_nursery_diesesherz_musicbox.snt", "DiesesHerzSource", 0.0f, true);
		SetEntityActive("child_1", true);
		SetEntityActive("child_2", true);
		return;
	}
	
		
	else if (asChild == "TriperyFadeOut")
	{
		AddDebugMessage("Fade Out Fired", false);
		StopSound("Tripery_Music_Ambience", 2.0f);
		StopSound("TriperyAmbience", 2.0f);
		PlaySoundAtEntity("TriperyBottomAmbience", "music_temple_ambient.snt", "AMB_Tripery", 0.0f, true);
		return;
	}
}
	//AMBIENT SOUND PLAYER
	void MapAmbienceAreas (string &in asParent, string &in asChild, int alState)

{		
		if (asChild == "GrinderAmbArea")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("GrinderAmbArea", "afx_grinding_machine_amb.snt", "Player", 0.5f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("GrinderAmbArea", 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "BurstTankAmbArea")
		{
			AddDebugMessage("BurstTankAmbArea " + alState, false);
			if (alState == 1)
			{
				PlaySoundAtEntity(asChild, "amb_sewers_water_particle_tunnel_2D_close.snt", "Player", 2.5f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound(asChild, 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "AMB_BloodRiver_1")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_BloodRiver_1", "amb_pigline_bloodriver.snt", "Player", 0.5f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_BloodRiver_1", 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "AMB_BloodRiver_2")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_BloodRiver_2", "amb_pigline_bloodriver_quieter.snt", "Player", 2.5f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_BloodRiver_2", 1.0f);
				return;
			}
		}
//BREAK//
		if (asChild == "AMB_EndRoom")
		{
			if (alState == 1)
			{
				PlaySoundAtEntity("AMB_EndRoom", "amb_pigline_bloodriver_quieter.snt", "Player", 2.5f, true);
				SetLocalVarString("CurrentAmbientTrack", asChild);
				return;
			}
			else if (alState == -1) 
			{
				StopSound("AMB_EndRoom", 1.0f);
				return;
			}
		}
//BREAK//
}
//END AMBIENT SOUND PLAYER//

//DELAYED HINT//
void TimerDelayedHint(string &in asTimer)
{
	AddHint(asTimer, "");
}
