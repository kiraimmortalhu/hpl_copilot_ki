//INITIALISE ELEVATOR//
void InitialiseElevator ()
{
	AddAttachedPropToProp("StartElevator", "ElevatorSwitchStatic", "elevator_switch_static.ent", 0.06f, -1.842f, -0.068f, 0.0f, 0.0f, 0.0f);
	SetMoveObjectState("StartElevator", 1);
	PlaySoundAtEntity("LiftLoop", "reactor_elevator_loop.snt", "Player", 1.0f, true);
	AddTimer("LiftTimer", 21.5f, "LiftEnd");
	AddTimer("LiftDoorTimer", 22.8f, "LiftEnd");
	AddTimer("AddHint", 23.8f, "LiftEnd");
}

void LiftEnd (string &in asTimer)
{
	if (asTimer == "LiftTimer")
	{
		AddDebugMessage("LIFT STOP NOW", false);
		PlaySoundAtEntity("", "reactor_elevator_stop.snt", "Player", 0.0f, false);
		StopSound("LiftLoop", 1.5f);
		return;
	}
	else if (asTimer == "LiftDoorTimer")
	{
		ElevatorDoorHandler("Player", "ElevatorBottomOpenTrigger", 1);
		return;
	}
	else if (asTimer == "AddHint")
	{
		AddHint("Pigline1", "");
	}
}
//END INITIALISE ELEVATOR//


//ELEVATOR DOOR HANDLER//
void ElevatorDoorHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "ElevatorBottomOpenTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 1);
		SetMoveObjectState("StartElevatorDoorLeft", 1);
		SetEntityActive("StartElevatorBlockBox", false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	else if (asChild == "CloseStartElevatorDoorTrigger")
	{
		SetMoveObjectState("StartElevatorDoorRight", 0);
		SetMoveObjectState("StartElevatorDoorLeft", 0);
		PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource1", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource1", 0.0f, false);
		return;
	}
	else if (asChild == "ExitElevatorDoorOpenTrigger")
	{
		SetMoveObjectState("ExitElevatorDoorRight", 1);
		SetMoveObjectState("ExitElevatorDoorLeft", 1);
		PlaySoundAtEntity("", "reactor_elevator_door_open_3D.snt", "ElevatorDoorSource2", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_open_2D.snt", "ElevatorDoorSource2", 0.0f, false);
	}
}

void CheckSwitchProximity (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Switch CAN Be Interacted With", false);
		SetEntityInteractionDisabled("ExitElevatorSwitch", false);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else if (alState == -1)
	{
		AddDebugMessage("Switch CANNOT Be Interacted With", false);
		SetEntityInteractionDisabled("ExitElevatorSwitch", true);
		RemoveTimer("MovementPreventionTimer");
		return;
	}
}

void ElevatorSwitchMovementPreventionChecker (string &in asTimer)
{
	if (GetPropIsInteractedWith("ExitElevatorSwitch") == true)
	{
		SetPlayerMoveSpeedMul(0.0f);
		SetPlayerRunSpeedMul(0.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
	else
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		AddTimer("MovementPreventionTimer", 0.1f, "ElevatorSwitchMovementPreventionChecker");
		return;
	}
}
//END ELEVATOR DOOR HANDLER//

//EXIT ELEVATOR DESCENT//
void ElevatorDescent (string &in asEntity, int alState)
{
	if (alState == 1)
	{
		AddDebugMessage("Elevator Moving", false);
		SetEntityActive("ExitElevatorDoorBlocker", true);
		AddAttachedPropToProp("ExitElevator", "ElevatorSwitchStatic", "elevator_switch_static.ent", 0.06f, -1.842f, -0.068f, 0.0f, 0.0f, 0.0f);
		PlaySoundAtEntity("", "church_draw_lever_open.snt", "ElevatorSwitchSource", 0.0f, false);
		SetEntityActive("ExitElevatorSwitch", false);
		SetMoveObjectState("ExitElevatorDoorRight", 0);
		SetMoveObjectState("ExitElevatorDoorLeft", 0);
		PlaySoundAtEntity("", "reactor_elevator_door_close_3D.snt", "ElevatorDoorSource2", 0.0f, false);
		PlaySoundAtEntity("", "reactor_elevator_door_close_2D.snt", "ElevatorDoorSource2", 0.0f, false);
		SetPlayerMoveSpeedMul(1);
		SetPlayerLookSpeedMul(1);
		SetPlayerRunSpeedMul(1);
		AddTimer("ElevatorMoves", 3.5f, "ElevatorMoves");
		RemoveTimer("bend");
	}
}

void ElevatorMoves (string &in asTimer)
{
	SetMoveObjectState("ExitElevator", 1);
	PlaySoundAtEntity("", "reactor_elevator_start.snt", "Player", 0.0f, false);
	PlaySoundAtEntity("LiftLoop", "reactor_elevator_loop.snt", "Player", 1.0f, true);
	AddTimer("LevelTransitionStart", 4.5f, "LevelTransitionStart");
	PlayMusic("236_Level_music_to_tesla.ogg", false, 1.0f, 6.0f, 6, false);
	SetLocalVarInt("BoardedElevator", 1);
}
//END EXIT ELEVATOR DESCENT//

//CONVEYOR BODY LOOP//
void ConveyorLoop (string &in asTimer)
{
	string x = asTimer;
	if (x == "T1")
	{
	PlayPropAnimation("Conveyor_Body_1", "hook_anim", 0.0f, true, "");
	} 
	else if (x == "T2") 
	{
	PlayPropAnimation("Conveyor_Body_2", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T3")
	{
	PlayPropAnimation("Conveyor_Body_3", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T4") 
	{
	PlayPropAnimation("Conveyor_Body_4", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T5")
	{
	PlayPropAnimation("Conveyor_Body_5", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T6")
	{
	PlayPropAnimation("Conveyor_Body_6", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T7")
	{
	PlayPropAnimation("Conveyor_Body_7", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T8")
	{
	PlayPropAnimation("Conveyor_Body_8", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T9")
	{
	PlayPropAnimation("Conveyor_Body_9", "hook_anim", 0.0f, true, "");
	}
	else if (x == "T10")
	{
	AddTimer("ConveyorLoop", 0.01f, "ConveyorLoop");
	}
}
//END CONVEYOR BODY LOOP//

//PIGLINE SOUND TRAVELLING//
void PiglineSoundTravelling (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		PlaySoundAtEntity("SoundTravel2", "afx_grinding_machine_leak.snt", "PiglineDoorCollider", 1.0f, true);
		return;
	}
	else if (alState == -1)
	{
		StopSound("SoundTravel1", 1.0f);
		StopSound("SoundTravel2", 1.0f);
		return;
	}
}

void PiglineSoundTravelling_1 (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		PlaySoundAtEntity("SoundTravelNew4", "afx_grinding_machine_leak.snt", "DistantSource_2", 1.0f, true);
		return;
	}
	else if (alState == -1)
	{
		StopSound("SoundTravelNew3", 1.0f);
		StopSound("SoundTravelNew4", 1.0f);
		return;
	}
}
//END PIGLINE SOUND TRAVELLING//

//BULKHEAD DOOR HANDLER//
void BulkheadDoorHandler (string &in asEntity, int alState)
{
	PlaySoundAtEntity("klickaljudetumfp", "afx_cellar_valvepop.snt", asEntity, 0.5, false);
	PlaySoundAtEntity("klickaljudet", "afx_church_altar_lever_on.snt", asEntity, 0, false);
	
	if (alState == 1)
	{
		if (asEntity == "BulkheadDoor1Switch" || asEntity == "BulkheadDoor1Switch_2")
		{
			SetButtonSwitchedOn("BulkheadDoor1Switch", true, false);
			SetButtonSwitchedOn("BulkheadDoor1Switch_2", true, false);
			SetButtonCanBeSwitchedOn("BulkheadDoor1Switch", false);
			SetButtonCanBeSwitchedOn("BulkheadDoor1Switch_2", false);
			PlayPropAnimation("BulkheadDoor1", "anim_open", 0.0f, false, "");
			AddTimer("Door1Timer", 5.5f, "DoorCollisionMovement");
		}
		else if (asEntity == "BulkheadDoor2Switch")
		{
			SetButtonCanBeSwitchedOn("BulkheadDoor2Switch", false);
			PlayPropAnimation("BulkheadDoor2", "anim_open", 0.0f, false, "");
			AddTimer("Door2Timer", 5.5f, "DoorCollisionMovement");
		}
	}
}

void DoorCollisionMovement (string &in asTimer)
{
	if (asTimer == "Door1Timer")
	{
		SetMoveObjectState("BulkheadDoor1Collision", 1);
		SetLocalVarInt("BulkheadDoor1Open", 1);
	}
	else if (asTimer == "Door2Timer")
	{
		SetMoveObjectState("BulkheadDoor2Collision", 1);
		SetLocalVarInt("BulkheadDoor2Open", 1);
	}
}
//END BULKHEAD DOOR HANDLER//

