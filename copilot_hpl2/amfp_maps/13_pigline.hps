//AUDIO PLAYER//
void AudioPlayer (string &in asParent, string &in asChild, int alState) 
{
	if (asChild == "CogTrigger")
	{
		AddDebugMessage("cog audio started", false);
		PlaySoundAtEntity("CogAudio", "afx_big_gears.snt", "CogAudio", 2.0f, true);
		PlaySoundAtEntity("CogAudio_Distant", "afx_big_gears_distant.snt", "CogAudio", 2.0f, true);
		return;
	}
	else if (asChild == "Spotlight_hum_on")
	{
		AddDebugMessage("spotlight started", false);
		PlaySoundAtEntity("SpotlightAudio", "afx_spotlight_hum.snt", "Spotlight", 0.0f, true);
		return;
	}
}
//END AUDIO PLAYER//

