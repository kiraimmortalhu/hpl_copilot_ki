void OnStart()
{	
	StopMusic(6, 8);
	//Map Preamble
	{
		SetMapDisplayNameEntry("Pigline");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "CheckpointStart_1", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	//Debugging
	if(ScriptDebugOn()) 
	{
		GiveItemFromFile("lantern", "lantern.ent");

		// Start with water rise
		//AddTimer("AllowLightMovement", 2.0f, "CogSequenceResults");
	}
	
	//Initialise Start Elevator
	{
		InitialiseElevator();
	}
		
	//Setup LocaL Variables
	{
		SetLocalVarInt("FirstLoad", 1);
		SetLocalVarInt("BulkheadDoor1Open", 0);
		SetLocalVarInt("BulkheadDoor2Open", 0);
