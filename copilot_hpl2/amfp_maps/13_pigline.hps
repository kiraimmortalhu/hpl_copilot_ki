}

void QuakePlayerSpeedControl (string &in asTimer)
{
	string sTimerBase = StringSub(asTimer, 0, 19);
	string sTimerCallNumber = StringSub(asTimer, 19, 1);
	AddDebugMessage("sTimerBase = "+sTimerBase, false);
	AddDebugMessage("sTimerCallNumber = "+sTimerCallNumber, false);
	//QUAKE PLAYER SLOWDOWN//
	if (sTimerBase == "PlayerSlowDownQuake")
	{
		SetPlayerMoveSpeedMul(0.5f);
		SetPlayerRunSpeedMul(0.0f);
		SetPlayerLookSpeedMul(0.8f);
		AddTimer("PlayerNormalSpeedPostQuake", 2.0f, "QuakePlayerSpeedControl");
	}
	
	//QUAKE PLAYER BACK TO NORMAL//
	else if (asTimer == "PlayerNormalSpeedPostQuake")
	{
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		return;
	}
	
	//STEPPED QUAKE EVENTS//
	if (sTimerCallNumber == "1")
	{
		StartScreenShake (0.03f, 1.5f, 0.01f, 0.5f);
		SetLampLit("RedWarningLamp_1", true, false);
		SetLampFlickerActive("RedWarningLamp_1", true);
		SetParticleSystemActive("ControlDust_5", true);
		SetParticleSystemActive("ControlDust_8", true);
		SetParticleSystemActive("ControlDust_3", true);
		SetLocalVarInt("MainStep1", 1);
		return;
	}
	else if (sTimerCallNumber == "2")
	{
		StartScreenShake (0.05f, 1.5f, 0.01f, 0.5f);
		SetLampLit("ControlRoomLight", false, false);
		AddTimer("engineroom_lamp_14", 0.5f, "TimerSetLampUnlit");
		AddTimer("engineroom_lamp_13", 0.7f, "TimerSetLampUnlit");
		AddTimer("engineroom_lamp_12", 0.8f, "TimerSetLampUnlit");
		AddTimer("engineroom_lamp_2", 1.1f, "TimerSetLampUnlit");
		AddTimer("tube_lamp_factory_ceiling_short_6", 1.2f, "TimerSetLampUnlit");
		SetLocalVarInt("MainStep2", 1);
		SetParticleSystemActive("ControlDust_4", true);
		SetParticleSystemActive("ControlDust_6", true);
		SetParticleSystemActive("ControlDust_7", true);
		return;
	}
	else if (sTimerCallNumber == "3")
	{
		StartScreenShake (0.10f, 1.5f, 0.01f, 0.5f);
		SetLampLit("RedWarningLamp_3", true, false);
		SetLampLit("tesla_lamp_17", false, false);
		SetLightVisible("PointLight_85", false);
		SetLightVisible("PointLight_86", false);
		SetParticleSystemActive("ControlDust_1", true);
		SetParticleSystemActive("ControlDust_2", true);
		SetParticleSystemActive("ControlDust_9", true);
		SetParticleSystemActive("ControlDust_10", true);
		SetLocalVarInt("MainStep3", 1);
		return;
	}
	else if (sTimerCallNumber == "4")
	{
		StartScreenShake (0.15f, 1.5f, 0.01f, 0.5f);
		SetLightVisible("BigRedLight", true);
		SetLightVisible("BigRedSpotlight", true);
		SetLampLit("Bank6_Light_1", true, false);
		SetLampLit("Bank6_Light_2", false, false);
		SetLampLit("Bank6_Light_3", true, false);
		SetParticleSystemActive("PostExplosionFog_1", true);
		SetParticleSystemActive("PostExplosionFog_2", true);
		return;
	}
}

