//LIGHT COLLIDER SEQUENCE//
void LightCollideSequence (string &in asParent, string &in asChild, int alState)
{
	if (alState == 1)
	{
		SetLocalVarInt("LightHittingTank", 1);
		AddDebugMessage("Light HITTING Tank", false);
		StopSound("can_idle", 2.0f);
		PlaySoundAtEntity("can_light", "afx_pigline_electricity_loop.snt", "ElectroSmallSource_9", 1.0f, true);
		AddTimer("ElectroChargeTimer1", 0.2f, "ElectroChargeSteps");
		AddTimer("ElectroChargeTimer2", 1.5f, "ElectroChargeSteps");
		AddTimer("ElectroChargeTimer3", 4.0f, "ElectroChargeSteps");
		AddTimer("ElectroChargeTimer4", 5.5f, "ElectroChargeSteps");
		AddTimer("ElectroChargeTimerMain", 6.0f, "ElectroDischarge");
		return;
	}
	else if (alState == -1)
	{
		SetLocalVarInt("LightHittingTank", 0);
		PlaySoundAtEntity("can_idle", "afx_volatile_coolant_can.snt", "ElectroSmallSource_9", 1.0f, true);
		StopSound("can_light", 2.0f);
		StopSound("Electrics_Ambience", 2.0f);
		
		RemoveTimer("ElectroChargeTimer1");
		RemoveTimer("ElectroChargeTimer2");
		RemoveTimer("ElectroChargeTimer3");
		RemoveTimer("ElectroChargeTimer4");
		RemoveTimer("ElectroChargeTimerMain");
		DestroyParticleSystem("ElectroBoltTank_1");
		DestroyParticleSystem("ElectroBoltTank_2");
		DestroyParticleSystem("ElectroBoltTank_3");
		DestroyParticleSystem("ElectroBoltTank_4");
		DestroyParticleSystem("ElectroBoltTank_5");
		DestroyParticleSystem("ElectroBoltTank_6");
		DestroyParticleSystem("ElectroBoltTank_7");
		DestroyParticleSystem("ElectroBoltTank_8");
		DestroyParticleSystem("ElectroBoltTank_9");
		DestroyParticleSystem("ElectroBoltJump_1");
		DestroyParticleSystem("ElectroBoltJump_2");
		DestroyParticleSystem("ElectroBoltLooping");
		DestroyParticleSystem("ElectrifiedWater_1");
		DestroyParticleSystem("ElectrifiedWater_2");
		DestroyParticleSystem("ElectrifiedWater_3");
		DestroyParticleSystem("ElectrifiedWater_4");
		DestroyParticleSystem("ElectrifiedWater_5");
		DestroyParticleSystem("ElectrifiedWater_6");
		DestroyParticleSystem("ElectrifiedWater_7");
		DestroyParticleSystem("ElectrifiedWater_8");
		DestroyParticleSystem("ElectrifiedWater_9");
		DestroyParticleSystem("ElectrifiedWater_10");
		DestroyParticleSystem("ElectrifiedWater_11");
		DestroyParticleSystem("ElectrifiedWater_12");
		AddTimer("LightFadeTimer", 1.0f, "LightFade");
		SetLightVisible("ElectroLightEnd", false);
		RemoveEntityCollideCallback("Player", "PiglineWaterDamageArea");
		RemoveTimer("ElectroKillTimer");
		SetLocalVarInt("ElectricityOn", 0);
		AddDebugMessage("Light NOT HITTING Tank", false);
		return;
	}
}

void LightFade (string &in asTimer)
{
	SetLightVisible("ElectroLightStart", false);
}

void ElectroChargeSteps (string &in asTimer)
{
	if (asTimer == "ElectroChargeTimer1")
	{
		CreateParticleSystemAtEntity("ElectroBoltTank_1", "ps_electro_bolt_tank.ps", "ElectroSmallSource_1", false);
		CreateParticleSystemAtEntity("ElectroBoltTank_7", "ps_electro_bolt_tank.ps", "ElectroSmallSource_7", false);
		PlaySoundAtEntity("arc_zap", "afx_pigline_electrical_arc.snt", "Player", 1.0f, false);
	}
	else if (asTimer == "ElectroChargeTimer2")
	{
		CreateParticleSystemAtEntity("ElectroBoltTank_3", "ps_electro_bolt_tank.ps", "ElectroSmallSource_3", false);
		CreateParticleSystemAtEntity("ElectroBoltTank_6", "ps_electro_bolt_tank.ps", "ElectroSmallSource_6", false);
		CreateParticleSystemAtEntity("ElectroBoltTank_9", "ps_electro_bolt_tank.ps", "ElectroSmallSource_9", false);
		SetLightVisible("ElectroLightStart", true);
		SetLightFlickerActive("ElectroLightStart", true);
		PlaySoundAtEntity("arc_zap", "afx_pigline_electrical_arc.snt", "Player", 1.0f, false);
	}
	else if (asTimer == "ElectroChargeTimer3")
	{
		CreateParticleSystemAtEntity("ElectroBoltTank_2", "ps_electro_bolt_tank.ps", "ElectroSmallSource_2", false);
		CreateParticleSystemAtEntity("ElectroBoltTank_4", "ps_electro_bolt_tank.ps", "ElectroSmallSource_4", false);
		CreateParticleSystemAtEntity("ElectroBoltTank_5", "ps_electro_bolt_tank.ps", "ElectroSmallSource_5", false);
		SetLightVisible("ElectroLightEnd", true);
		SetLightFlickerActive("ElectroLightEnd", true);
		SetLightVisible("ElectroLightStart", false);
		PlaySoundAtEntity("arc_zap", "afx_pigline_electrical_arc.snt", "Player", 1.0f, false);
	}
	else if (asTimer == "ElectroChargeTimer4")
	{
		CreateParticleSystemAtEntity("ElectroBoltTank_8", "ps_electro_bolt_tank.ps", "ElectroSmallSource_8", false);
		PlaySoundAtEntity("arc_zap", "afx_pigline_electrical_arc.snt", "Player", 1.0f, false);
	}
}

void ElectroDischarge (string &in asTimer)
{
	if (GetLocalVarInt("CogPuzzleSolved") == 0)
	{
		CreateParticleSystemAtEntity("ElectroBoltJump_1", "ps_electro_bolt_jump_tank_2.ps", "ElectroJumpSource_1", false);
		PlaySoundAtEntity("", "afx_electric_arc_fail.snt", "ElectroSmallSource_9", 0.0f, false);
		AddTimer("RecheckElectro", RandFloat(2.0f, 4.7f), "RecheckElectro");
		AddHint("Pigline4", "");
		return;
	}
	else if (GetLocalVarInt("CogPuzzleSolved") == 1)
	{
		CreateParticleSystemAtEntity("ElectroBoltJump_2", "ps_electro_bolt_jump_tank.ps", "ElectroJumpSource_1", false);
		CreateParticleSystemAtEntity("ElectroBoltLooping", "ps_electro_bolt_looping.ps", "ElectroBoltLoopingSource", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_1", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_1", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_2", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_2", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_3", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_3", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_4", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_4", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_5", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_5", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_6", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_6", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_7", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_7", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_8", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_8", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_9", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_9", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_10", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_10", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_11", "ps_electro_bolt_weakened_2.ps", "ElectrifiedWaterSource_11", false);
		CreateParticleSystemAtEntity("ElectrifiedWater_12", "ps_electro_bolt_weakened.ps", "ElectrifiedWaterSource_12", false);
		StopSound("can_light", 2.0f);
		StopSound("can_idle", 2.0f);
		PlaySoundAtEntity("Electrics_Ambience", "amb_pigline_electrics.snt", "AMB_area_base", 0.0f, true);
		AddEntityCollideCallback("Player", "PiglineWaterDamageArea", "WaterDamageHandler", false, 0);
		SetLocalVarInt("ElectricityOn", 1);
		
		if (GetLocalVarInt("LightPuzzleSolved") == 0)
		{
			PlaySoundAtEntity("canister_ignite", "afx_pigline_canister_ignite.snt", "ElectroSmallSource_9", 0.0f, false);
			//PlaySoundAtEntity("Drag", "afx_bilge_gate_close", "control_room_gate", 0.0f, false);
			AddTimer("PigDeathSound", 1.5f, "PigDeathSound");
			AddTimer("endflash", 2, "PigDeathSound");
			SetEntityActive("ControlWretch", false);
			SetEntityActive("CrispyFriedWretch", true);
			SetEntityActive("FallToWretchArea", false);
			//SetEntityActive("control_room_gate", false);
			SetLocalVarInt("LightPuzzleSolved", 1);
			SetPlayerMoveSpeedMul(0.5);
			SetPlayerRunSpeedMul(0.5);
			SetLightVisible("SpotLight_2", true);
			AddDebugMessage("Did someone say crackling?", false); 
		}
	}
}

void PigDeathSound (string &in asTimer)
{
	if(asTimer == "endflash")
	{
		SetPlayerMoveSpeedMul(1);
		SetPlayerRunSpeedMul(1);
		SetLightVisible("SpotLight_2", false);
		return;
	}

	PlaySoundAtEntity("PigDeath", "afx_bilge_pig_howl.snt", "Player", 0.0f, false);
}

void RecheckElectro (string &in asTimer)
{
	if (GetLocalVarInt("LightHittingTank") == 1)
	{
		ElectroDischarge("ElectroLoop");
	}
}

void InstaFryPig (string &in asParent, string &in asChild, int alState)
{
	// Only for emergencies, trigger electrocution instantly so the player doesn't see the pig dying
	if (GetLocalVarInt("LightHittingTank") == 1 && 
		GetLocalVarInt("CogPuzzleSolved") == 1 &&
		GetLocalVarInt("LightPuzzleSolved") == 0)
	{
		RemoveTimer("ElectroChargeTimerMain");
		ElectroDischarge("");
	}
}
//END LIGHT COLLIDER SEQUENCE//

//HANDLE WRETCH ACTIVATION//
void ActivateControlWretch (string &in asParent, string &in asChild, int alState)
{
	//SET CHECKPOINT #2//
	CheckPoint("CP02_Ladder", "CheckpointStart_2", "DeathHandler", "", "", false);
	if (GetLocalVarInt("LightPuzzleSolved") == 0)
	{
		SetEntityActive("ControlWretch", true);
	}
}

void DeactivateControlWretch (string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("ControlWretch", false);
}
//END HANDLE WRETCH ACTIVATION//

//DEATH BY WRETCH HANDLER//

void StartDeathByWretch (string &in asParent, string &in asChild, int alState)
{
	FadeOut(0.25);
	if (GetLocalVarInt("CogPuzzleSolved") == 0)
		AddTimer("DeathByWretchFadeInFall", 1.f, "DeathByWretchSequence");
	else
		AddTimer("DeathByWretchSplash", 0.9f, "DeathByWretchSequence");
	PlaySoundAtEntity("WretchDeathDamage", "react_hurt_hit.snt", "Player", 0, false);
	PlaySoundAtEntity("WretchDeathDamage", "afx_church_first_person_wretch_hit.snt", "Player", 0, false);
}

void DeathByWretchSequence(string &in asTimer)
{
	if (asTimer == "DeathByWretchSplash")
	{
		AddDebugMessage("SPLASH!", false);
		PlaySoundAtEntity("WretchDeathDamage", "impact_water_high.snt", "Player", 0, false);
		AddTimer("DeathByWretchFadeInFall", 0.1f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchFadeInFall")
	{
		SetEntityActive("ControlWretch", false);
		ResetProp("ControlWretch_Kill");
		SetEntityActive("ControlWretch_Kill", true);
		SetEnemyDisableTriggers("ControlWretch_Kill", true);
		TeleportPlayer("AfterWretchFall");
		FadeImageTrailTo(1.25, 10);
		SetPlayerCrouching(true);
		SetPlayerCrouchDisabled(true);
		SetPlayerMoveSpeedMul(0.1);
		SetPlayerLookSpeedMul(0.25);
		SetLanternActive(false, false);
		//FadePlayerRollTo(70, 5, 100);
		FadeIn(4);
		AddTimer("DeathByWretchScream", 1.f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchScream")
	{
		PlayScriptedAnimation("ControlWretch_Kill", "ThreatLoopBiped", false);
		PlaySoundAtEntity("WretchScream", "wretch_tunnels_ThreatLoop_Highend_02.snt", "ControlWretch", 0, false);
		AddTimer("DeathByWretchFadeOutGroggy", 1.f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchFadeOutGroggy")
	{
		FadeOut(2);
		PlaySoundAtEntity("", "react_scare.snt", "Player", 0.0f, false);
		AddTimer("DeathByWretchFadeInGroggy", 1.f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchFadeInGroggy")
	{
		FadeIn(3);
		MandusReactionPlayer("Scared", 1.7);
		AddEnemyPatrolNode("ControlWretch_Kill", "PathNodeArea_4", 10, "", false);
		AddTimer("DeathByWretchAttack", 2.0f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchAttack")
	{
		PlaySoundAtEntity("WretchScream", "wretch_tunnels_attack_bipedvo_1.snt", "ControlWretch", 0, false);

		PlayScriptedAnimation("ControlWretch_Kill", "AttackBiped1", false);
		AddTimer("DeathByWretchDie", 0.5f, "DeathByWretchSequence");
	}
	else if (asTimer == "DeathByWretchDie")
	{
		ClearEnemyPatrolNodes("ControlWretch_Kill");
		PlaySoundAtEntity("PlayerHit", "react_hurt_hit.snt", "Player", 0, false);
		FadeOut(0.25);
		GivePlayerDamage(100, "Claws", false, true);
		
		AddTimer("DeathByWretchRestore", 3.f, "DeathByWretchSequence");
	}
}

//END DEATH BY WRETCH HANDLER//

//BUTTON PUZZLE HANDLERS//
void ButtonPuzzleInputHandler (string &in asEntity, int alState)
{
	//SETUP VARIABLES//
	string sMoveType = StringSub(asEntity, 7, 1);
	string sObjType = StringSub (asEntity, 8, 1);
	string sBankNumber = StringSub(asEntity, 4, 1);
	string sButtonNumber = StringSub(asEntity, 6, 1);
	int lDoUpdates = 0;
	AddDebugMessage("sMoveType = "+sMoveType, false);
	AddDebugMessage("sBankNumber = "+sBankNumber, false);
	AddDebugMessage("sButtonNumber = "+sButtonNumber, false);
	
	//DEAL WITH INPUT//
	if (sMoveType == "x" && alState == 1)
	{
		//WHEELS//
		if (sObjType == "w")
		{
			SetWheelInteractionDisablesStuck(asEntity, false);
			SetWheelStuckState(asEntity, 1, false);
			AddDebugMessage(asEntity+" is a wheel, and is now stuck at STATE 1", false);
			lDoUpdates = 1;
		}
		//LEVERS//
		else if (sObjType == "l")
		{
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, 1, false);
			AddDebugMessage(asEntity+" is a lever, and is now stuck at STATE 1", false);
			lDoUpdates = 1;
		}
	}
	else if (sMoveType == "n" && alState == -1)
	{
		//WHEELS//
		if (sObjType == "w")
		{
			SetWheelInteractionDisablesStuck(asEntity, false);
			SetWheelStuckState(asEntity, -1, false);
			AddDebugMessage(asEntity+" is a wheel, and is now stuck at STATE -1", false);	
			lDoUpdates = 1;			
		}
		//LEVERS//
		else if (sObjType == "l")
		{
			SetLeverInteractionDisablesStuck(asEntity, false);
			SetLeverStuckState(asEntity, -1, false);
			AddDebugMessage(asEntity+" is a lever, and is now stuck at STATE -1", false);
			lDoUpdates = 1;
		}
	}
	//END INPUT//
	
	//UPDATE VARIABLES AND EVENTS//
	if (lDoUpdates == 1)
	{
		if (sBankNumber == "A")
			AddLocalVarInt("ButtonPressBank2Total", 1);
		else
			AddLocalVarInt("ButtonPressBank"+sBankNumber+"Total", 1);
			
		AddLocalVarInt("ButtonPressGlobalTotal", 1);
		AddDebugMessage("ButtonPressBank"+sBankNumber+"Total = "+GetLocalVarInt("ButtonPressBank"+sBankNumber+"Total"), false);
	
		//UPDATE CUMULATIVE BANK EVENTS//
		//BANK 1//
		if (GetLocalVarInt("ButtonPressBank1Total") == 2)
		{
			SetLampLit("Bank1_Light_1", true, false);
			SetLocalVarInt("Bank1_Light_1On", 1);
		}
		//BANK A//
		if (sBankNumber == "A")
		{
			if (GetLocalVarInt("ButtonPressBank2Total") == 3)
			{
				DisablePiglineControls(2);
			}
		}
		//BANK 2//
		if (sBankNumber == "2")
		{
			if (sButtonNumber == "1")
			{
				SetParticleSystemActive("Bank2_Particles_5", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst_stream_01.snt", "Bank2_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank2_1Used", 1);
			}
			else if (sButtonNumber == "3")
			{
				SetParticleSystemActive("Bank2_Particles_3", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst_stream_02.snt", "Bank2_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank2_3Used", 1);
			}
			else if (sButtonNumber == "4")
			{
				SetParticleSystemActive("Bank2_Particles_4", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst_stream_01.snt", "Bank2_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank2_4Used", 1);
			}
			else if (sButtonNumber == "5")
			{
				SetParticleSystemActive("Bank2_Particles_2", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst_stream_01.snt", "Bank2_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank2_5Used", 1);
			}
			if (GetLocalVarInt("ButtonPressBank2Total") == 3)
			{
				SetParticleSystemActive("Bank2_Particles_1", true);
				SetLocalVarInt("Bank2_BigSmokeOn", 1);
				DisablePiglineControls(2);
			}
			if (GetLocalVarInt("Bank2_SteamOn") == 0)
			{
				PlaySoundAtEntity("", "afx_cellar_steam_loop.snt", "Bank2_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank2_SteamOn", 1);
			}
		}
		//BANK 4//
		if (GetLocalVarInt("ButtonPressBank4Total") == 1 && GetLocalVarInt("Bank4_Light_2On") == 0)
		{
			SetLampLit("Bank4_Light_2", true, false);
			SetLocalVarInt("Bank4_Light_2On", 1);
		}
		else if (GetLocalVarInt("ButtonPressBank4Total") == 3 && GetLocalVarInt("Bank4_Light_3On") == 0)
		{
			SetLampLit("Bank4_Light_3", true, false);
			SetLocalVarInt("Bank4_Light_3On", 1);
		}
		else if (GetLocalVarInt("ButtonPressBank4Total") == 4 && GetLocalVarInt("Bank3EventOn") == 0)
		{
			AddTimer("Bank3SteamTimer1", RandFloat(1.3f, 2.8f), "Bank3TimedEvents");
			AddTimer("Bank3SteamTimer2", RandFloat(2.9f, 3.4f), "Bank3TimedEvents");
			AddTimer("Bank3SteamTimer3", RandFloat(3.5f, 4.2f), "Bank3TimedEvents");
			SetLocalVarInt("Bank3EventOn", 1);
			
			DisablePiglineControls(4);
		}
		//BANK 7//
		if (GetLocalVarInt("ButtonPressBank7Total") == 1 && GetLocalVarInt("Bank7_Light_1On") == 0)
		{
			SetLampLit("Bank7_Light_1", true, false);
			SetLocalVarInt("Bank7_Light_1On", 1);
		}
		else if (GetLocalVarInt("ButtonPressBank7Total") == 2 && GetLocalVarInt("Bank7_Light_2On") == 0)
		{
			SetLampLit("Bank7_Light_2", true, false);
			SetLocalVarInt("Bank7_Light_2On", 1);
		}
		else if (GetLocalVarInt("ButtonPressBank7Total") == 3 && GetLocalVarInt("Bank7_Light_6On") == 0)
		{
			SetLampLit("Bank7_Light_6", true, false);
			SetLocalVarInt("Bank7_Light_6On", 1);
						
			PlayPropAnimation("Bank8_"+sButtonNumber+"_Gauge", "ontooff", 0.0f, false, "");
			SetLocalVarInt("Bank8_"+sButtonNumber+"_GaugeOn", 0);
			AddDebugMessage("Bank8_"+sButtonNumber+"_GaugeOn = "+GetLocalVarInt("Bank8_"+sButtonNumber+"_GaugeOn"), false);
			
			DisablePiglineControls(7);
		}
		//BANK 9//
		if (sBankNumber == "9")
		{
			if (sButtonNumber == "3")
			{
				SetParticleSystemActive("Bank9_Particles_1", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst.snt", "Bank9_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank9_1Used", 1);
			}
			else if (sButtonNumber == "1")
			{
				SetParticleSystemActive("Bank9_Particles_2", true);
				PlaySoundAtEntity("", "afx_tunnels_steam_burst.snt", "Bank9_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank9_3Used", 1);
			}
			if (GetLocalVarInt("Bank9_SteamOn") == 0)
			{
				PlaySoundAtEntity("", "afx_cellar_steam_loop.snt", "Bank9_SteamSource", 0.0f, true);
				SetLocalVarInt("Bank9_SteamOn", 1);
			}
		}
		//UPDATE ONE-SHOT EVENTS//
		//BANK 4//
		if (sBankNumber == "4")
		{
			PlayPropAnimation("Bank3_"+sButtonNumber+"_Gauge", "ontooff", 0.0f, false, "");
			SetLocalVarInt("Bank3_"+sButtonNumber+"_GaugeOn", 0);
			AddDebugMessage("Bank3_"+sButtonNumber+"_GaugeOn = "+GetLocalVarInt("Bank3_"+sButtonNumber+"_GaugeOn"), false);
		}	
		//BANK 6//
		else if (sBankNumber == "6" && sButtonNumber == "1")
		{
			PlayPropAnimation("Bank6_"+sButtonNumber+"_Gauge", "ontooff", 0.0f, false, "");
			SetLocalVarInt("Bank6_"+sButtonNumber+"_GaugeOn", 0);
			AddDebugMessage("Bank6_"+sButtonNumber+"_GaugeOn = "+GetLocalVarInt("Bank6_"+sButtonNumber+"_GaugeOn"), false);
			SetLampLit("Bank6_Light_1", true, false);
			SetLampLit("Bank6_Light_2", false, false);
			SetLampLit("Bank6_Light_3", true, false);
			
			PlayPropAnimation("Bank5_"+sButtonNumber+"_Gauge", "ontooff", 0.0f, false, "");
			SetLocalVarInt("Bank5_"+sButtonNumber+"_GaugeOn", 0);
			AddDebugMessage("Bank5_"+sButtonNumber+"_GaugeOn = "+GetLocalVarInt("Bank5_"+sButtonNumber+"_GaugeOn"), false);
		}
		//BANK A//
		else if (sBankNumber == "A")
		{
			if (sButtonNumber == "1")
			{
				SetLampLit("BankA_Light_1", false, false);
				SetLocalVarInt("BankA_Light_1On", 0);
			}
			else if (sButtonNumber == "2")
			{
				SetLampLit("BankA_Light_2", true, false);
				SetLocalVarInt("BankA_Light_2On", 1);
			}
			else if (sButtonNumber == "3")
			{
				SetLampLit("BankA_Light_3", false, false);
				SetLocalVarInt("BankA_Light_3On", 0);
			}
		}
	}
	//END UPDATES//
	
	//CHECK GLOBAL BUTTON INTERACTION COUNT//
	int lGlobalTotal = GetLocalVarInt("ButtonPressGlobalTotal");
	if(lDoUpdates == 1)
	{
		//DO ONE-SHOT SOUND STEPS//
		if (lGlobalTotal == 1)
		{
			PlaySoundAtEntity("", "afx_pigline_explosion_01.snt", "ControlRoomSpeakerSource", 0.0f, false);
			PlaySoundAtEntity("GroanLight", "afx_pigline_explosion_groan_light", "Player", 1.0f, false);
			StartScreenShake (0.05f, 1.0f, 0.02f, 1.0f);
			SetParticleSystemActive("ParticleSystem_102", true);
			SetParticleSystemActive("ParticleSystem_103", true);
			SetParticleSystemActive("ParticleSystem_105", true);
		}
		else if (lGlobalTotal == 3)
		{
			PlaySoundAtEntity("", "afx_pigline_explosion_02.snt", "ControlRoomSpeakerSource", 0.0f, false);
			StartScreenShake (0.08f, 1.0f, 0.02f, 1.0f);
			SetParticleSystemActive("ParticleSystem_63", true);
			SetParticleSystemActive("ParticleSystem_64", true);
		}
		else if (lGlobalTotal == 5)
		{
			PlaySoundAtEntity("", "afx_pigline_explosion_03.snt", "ControlRoomSpeakerSource", 0.0f, false);
			StartScreenShake (0.10f, 1.25f, 0.02f, 1.0f);
			AddTimer("PiglineWindow_2", 0.5, "GlassBreakTimer");
			AddTimer("Alarm2", 1.0f, "Alarm2");
		}
		else if (lGlobalTotal == 6)
		{
			PlaySoundAtEntity("", "afx_pigline_explosion_04.snt", "ControlRoomWindowSource", 0.0f, false);
			PlaySoundAtEntity("GroanHeavy", "afx_pigline_explosion_groan_heavy", "Player", 1.0f, false);
			StartScreenShake (0.12f, 1.25f, 0.02f, 1.0f);
			StopSound("GroanMed", 1.0f);
			SetParticleSystemActive("ParticleSystem_104", true);
			SetParticleSystemActive("ParticleSystem_61", true);
		}
		//DO FULL SEQUENCE STEPS//
		else if (lGlobalTotal == 2)
		{
			SetParticleSystemActive("ParticleSystem_62", true);
			AddTimer("PlayerSlowDownQuake1", 0.6f, "QuakePlayerSpeedControl");
			PlaySoundAtEntity("", "afx_pigline_explosion_02", "Player", 0.0f, false);
			StartScreenShake (0.12f, 1.0f, 0.02f, 1.0f);
			PlaySoundAtEntity("Alarm2D", "afx_reactor_fuel_rod_error_buzz_2D", "ControlRoomSpeakerSource", 0.0f, false);
			PlaySoundAtEntity("Alarm3D", "afx_reactor_fuel_rod_error_buzz_3D", "ControlRoomSpeakerSource", 0.0f, false);
			AddTimer("Alarm", 2.0f, "Alarm");
		}
		else if (lGlobalTotal == 4)
		{
			AddTimer("PlayerSlowDownQuake2", 0.6f, "QuakePlayerSpeedControl");
			PlaySoundAtEntity("", "afx_pigline_explosion_03.snt", "Player", 0.0f, false);
			StartScreenShake (0.15f, 1.25f, 0.02f, 1.0f);
			SetParticleSystemActive("Bank2_Particles_8", true);
			SetParticleSystemActive("Bank2_Particles_9", true);
			PlaySoundAtEntity("GroanMed", "afx_pigline_explosion_groan_medium", "Player", 1.0f, false);
			StopSound("GroanLight", 1.0f);
			AddTimer("PiglineWindow_4", 0.4, "GlassBreakTimer");
		}
	
		//END SEQUENCE STEP UPDATES//
		
		//CHECK FOR SEQUENCE COMPLETION//
		if (lGlobalTotal == 7)
		{
			DisablePiglineControls(1);
			DisablePiglineControls(2);
			DisablePiglineControls(4);
			DisablePiglineControls(6);
			DisablePiglineControls(7);
			DisablePiglineControls(9);
			
			AddTimer("ExplodeTimer1", 0.2f, "TimedExplosions");
			AddTimer("ExplodeTimer2", 1.5f, "TimedExplosions");
			AddTimer("ExplodeTimer3", 1.6f, "TimedExplosions");
			StopSound("GroanHeavy", 5.0f);
			AddTimer("VO3", 11.0f, "VOPlayer3");
			AddTimer("PlayerSlowDownQuake4", 2.1f, "QuakePlayerSpeedControl");
			AddDebugMessage("What happens if I press this?", false);
			SetLocalVarInt("BulkheadFailsafesActive", 1);
			SetEntityActive("BulkheadStaticClosed_1", false);
			SetEntityActive("BulkheadStaticClosed_2", false);
			SetEntityActive("BulkheadStaticClosedCollision_1", false);
			SetEntityActive("BulkheadStaticClosedCollision_2", false);
			SetEntityActive("BulkheadStaticOpen_1", true);
			SetEntityActive("BulkheadStaticOpen_2", true);
			SetEntityActive("BulkheadStaticOpenCollision_1", true);
			SetEntityActive("BulkheadStaticOpenCollision_2", true);
			SetEntityActive("CompoundRoomDoor*", true);
			PlayPropAnimation("BulkheadDoor1", "anim_close_smooth", 0.0f, false, "");
			SetMoveObjectState("BulkheadDoor1Collision", 0);
			PlayPropAnimation("BulkheadDoor2", "static_open", 0.0f, true, "");
			SetMoveObjectState("BulkheadDoor2Collision", 1);
			RemoveEntityCollideCallback("Player", "PiglineWaterDamageArea");
			StopSound("Electrics_Ambience", 0.5f);		
			RemoveTimer("ElectroKillTimer");
			SetLocalVarInt("BulkheadDoor1Open", 0);
			SetLocalVarInt("ButtonPuzzleSolved", 1);
			DestroyParticleSystem("ParticleSystem_21");
			DestroyParticleSystem("ParticleSystem_22");
			DestroyParticleSystem("ParticleSystem_23");
			DestroyParticleSystem("ParticleSystem_24");
			DeactivateLevelLights();
		}
	}
	AddDebugMessage("lGlobalTotal = "+lGlobalTotal, false);
	//END SEQUENCE COMPLETION CHECK//
}

void DisablePiglineControls(int alBank)
{		
	if (alBank == 1)
	{
		SetEntityConnectionStateChangeCallback("Bank1_*", "");
		SetWheelInteractionDisablesStuck("Bank1_*", false);
		SetWheelStuckState("Bank1_*", 1, false);
		SetEntityInteractionDisabled("Bank1_*", true);
	}
	else if (alBank == 2)
	{
		SetEntityConnectionStateChangeCallback("Bank2_*", "");
		SetEntityConnectionStateChangeCallback("BankA_*", "");
		SetLeverInteractionDisablesStuck("Bank2_*", false);
		SetLeverInteractionDisablesStuck("BankA_*", false);
		DisablePiglineLever("Bank2_1xl");
		DisablePiglineLever("Bank2_2nl");
		DisablePiglineLever("Bank2_3nl");
		DisablePiglineLever("Bank2_4xl");
		DisablePiglineLever("Bank2_5xl");
		DisablePiglineLever("Bank2_6nl");
		DisablePiglineLever("BankA_1xl");
		DisablePiglineLever("BankA_2nl");
		DisablePiglineLever("BankA_3xl");
		
		SetEntityActive("Bank2_Broken_Area", true);
		AddTimer("BankA_Light_3", 0.2f, "TimerSetLampUnlit");
		AddTimer("BankA_Light_1", 0.4f, "TimerSetLampUnlit");
		AddTimer("BankA_Light_2", 0.5f, "TimerSetLampUnlit");
		SetParticleSystemActive("Bank2_BrokenPS", true);
		SetLightVisible("Bank2_Broken_Light", true);
		PlaySoundAtEntity("Bank2_Broken_Sound", "afx_cellar_spark_loop.snt", "Bank2_5xl", 0.5f, true);
	}
	else if (alBank == 4)
	{
		SetEntityConnectionStateChangeCallback("Bank4_*", "");
		SetLeverInteractionDisablesStuck("Bank4_*", false);
		DisablePiglineLever("Bank4_1xl");
		DisablePiglineLever("Bank4_2xl");
		DisablePiglineLever("Bank4_3nl");
		DisablePiglineLever("Bank4_4nl");
		DisablePiglineLever("Bank4_5xl");
		DisablePiglineLever("Bank4_6nl");
		DisablePiglineLever("Bank4_7nl");
		DisablePiglineLever("Bank4_8xl");
		DisablePiglineLever("Bank4_9xl");
		
		SetEntityActive("Bank4_Broken_Area", true);
		AddTimer("Bank4_Light_3", 0.15f, "TimerSetLampUnlit");
		AddTimer("Bank4_Light_1", 0.3f, "TimerSetLampUnlit");
		AddTimer("Bank4_Light_2", 0.4f, "TimerSetLampUnlit");
		SetParticleSystemActive("Bank4_BrokenPS", true);
		SetLightVisible("Bank4_Broken_Light", true);
		PlaySoundAtEntity("Bank4_Broken_Sound", "afx_cellar_spark_loop.snt", "Bank4_5xl", 0.5f, true);
	}
	else if (alBank == 6)
	{
		SetEntityConnectionStateChangeCallback("Bank6_*", "");
		SetWheelInteractionDisablesStuck("Bank6_*", false);
		SetWheelStuckState("Bank6_1xw", 1, false);
		SetEntityInteractionDisabled("Bank6_*", true);
	}
	else if (alBank == 7)
	{
		SetEntityConnectionStateChangeCallback("Bank7_*", "");
		SetLeverInteractionDisablesStuck("Bank7_*", false);
		DisablePiglineLever("Bank7_1nl");
		DisablePiglineLever("Bank7_2nl");
		DisablePiglineLever("Bank7_3nl");
		DisablePiglineLever("Bank7_4nl");
		DisablePiglineLever("Bank7_5xl");
		DisablePiglineLever("Bank7_6xl");
		DisablePiglineLever("Bank7_7xl");
		DisablePiglineLever("Bank7_8nl");
		DisablePiglineLever("Bank7_9xl");
		
		SetEntityActive("Bank7_Broken_Area", true);
		AddTimer("Bank7_Light_6", 0.25f, "TimerSetLampUnlit");
		AddTimer("Bank7_Light_2", 0.35f, "TimerSetLampUnlit");
		AddTimer("Bank7_Light_1", 0.5f, "TimerSetLampUnlit");
		AddTimer("Bank7_Light_3", 0.6f, "TimerSetLampUnlit");
		AddTimer("Bank7_Light_4", 0.75f, "TimerSetLampUnlit");
		SetParticleSystemActive("Bank7_BrokenPS", true);
		SetLightVisible("Bank7_Broken_Light", true);
		PlaySoundAtEntity("Bank7_Broken_Sound", "afx_cellar_spark_loop.snt", "Bank7_5xl", 0.5f, true);
	}
	else if (alBank == 9)
	{
		SetEntityConnectionStateChangeCallback("Bank9_*", "");
		SetWheelInteractionDisablesStuck("Bank9_*", false);
		SetWheelStuckState("Bank9_*", 1, false);
		SetEntityInteractionDisabled("Bank9_*", true);
	}
}

void DisablePiglineLever(string &in asTimer)
{
	SetLeverStuckState(asTimer, GetLeverState(asTimer), false);
	SetEntityInteractionDisabled(asTimer, true);
}

