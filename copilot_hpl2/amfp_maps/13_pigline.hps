void TimedExplosions (string &in asTimer)
{
	if (asTimer == "ExplodeTimer1")
	{
		PlaySoundAtEntity("", "afx_pigline_explosion_02.snt", "ControlRoomWindowSource", 0.0f, false);
		StartScreenShake (0.07f, 1.25f, 0.02f, 1.0f);
		return;
	}
	else if (asTimer == "ExplodeTimer2")
	{
		PlaySoundAtEntity("", "afx_pigline_explosion_01.snt", "ControlRoomWindowSource", 0.0f, false);
		StartScreenShake (0.09f, 1.25f, 0.02f, 1.0f);
		SetParticleSystemActive("Fire_1", true);
		SetParticleSystemActive("Fire_2", true);
		SetParticleSystemActive("Fire_3", true);
		
		for (int i = 1; i <= 5; i++)
		{
			//SetLightVisible("FireLight_"+i, true);
			FadeLightTo("FireLight_"+i, 0.648,0.372,0.263,0, -1, 2.f);
		}
		AddTimer("ExplodeTimer2_Lights", 2.f, "TimedExplosions");
		return;
	}
	else if (asTimer == "ExplodeTimer2_Lights")
	{
		for (int i = 1; i <= 5; i++)
		{
			SetLightFlickerActive("FireLight_"+i, true);
		}
	}
	else if (asTimer == "ExplodeTimer3")
	{
		PlaySoundAtEntity("", "afx_pigline_explosion_long.snt", "ControlRoomWindowSource", 0.0f, false);
		StartScreenShake (0.15f, 2.0f, 0.02f, 4.0f);
		RemoveTimer("Alarm");
		RemoveTimer("Alarm2");
		StopSound("Alarm22D", 0.25f);
		PlaySoundAtEntity("afterfire", "afx_pigline_fire.snt", "ControlRoomWindowSource", 6.0f, false);
		PlaySoundAtEntity("ExpAmbience", "amb_pigline_after_explosion.snt", "AMB_area_base", 2.5f, false);
		StopSound("Flood_Ambience", 2.5f);	
		StopSound("Electrics_Ambience", 0.5f);		
		StopSound("Grinder1", 0.5f);	
		StopSound("Grinder2", 0.5f);	
		StopSound("Burner1", 0.5f);	
		StopSound("Burner2", 0.5f);	
		StopSound("PigLineMusic", 0.5f);	
		StopSound("Pigline2Audio1", 0.5f);	
		StopSound("Pigline2Audio2", 0.5f);
		StopSound("SoundTravel1", 0.5f);
		StopSound("SoundTravel2", 0.5f);
		StopSound("GrinderControlRoomLeak", 0.5f);
		
		//SAM ADDED
		StopSound("SoundTravelling", 0.5f);
		StopSound("grinder_distant_1", 0.5f);
		StopSound("GrinderControlRoomLeak", 0.5f);
		StopSound("PigLineMusic", 0.5f);
		StopSound("conveyor", 0.5f);
		StopSound("Burner1", 0.5f);
		StopSound("Burner2", 0.5f);
		StopSound("Pigline2Audio2", 0.5f);
		
		DestroyParticleSystem("ElectroBoltLooping");
		DestroyParticleSystem("ElectrifiedWater_1");
		DestroyParticleSystem("ElectrifiedWater_2");
		DestroyParticleSystem("ElectrifiedWater_3");
		DestroyParticleSystem("ElectrifiedWater_4");
		DestroyParticleSystem("ElectrifiedWater_5");
		DestroyParticleSystem("ElectrifiedWater_6");
		DestroyParticleSystem("ElectrifiedWater_7");
		DestroyParticleSystem("ElectrifiedWater_8");
		DestroyParticleSystem("ElectrifiedWater_9");
		DestroyParticleSystem("ElectrifiedWater_10");
		DestroyParticleSystem("ElectrifiedWater_11");
		DestroyParticleSystem("ElectrifiedWater_12");
		SetLampLit("RedWarningLamp_1", false, false);
		SetLampLit("RedWarningLamp_2", false, false);
		SetLampLit("RedWarningLamp_3", false, false);
		AddTimer("PiglineWindow_1", 0.75, "GlassBreakTimer");
		AddTimer("PiglineWindow_3", 1.75, "GlassBreakTimer");
		//PlaySoundAtEntity("TriperyAmbience", "afx_the_pigline.snt", "AMB_Tripery", 0.0f, false);
		return;
	}
}

void GlassBreakTimer(string &in asTimer)
{
	PlaySoundAtEntity("", "afx_pigline_panesmash.snt", asTimer+"_SoundSource", 0.0f, false);
	SetEntityActive(asTimer, false);
	SetEntityActive(asTimer + "_Broken", true);
	SetPropEffectActive(asTimer + "_Broken", true, true);
	
	SetParticleSystemActive(asTimer + "_Particles_1", true);
}

void ButtonElectricalShock(string &in asEntity)
{	
	if (GetTimerTimeLeft("ButtonElectricalShock") > 0) return;
	AddTimer("ButtonElectricalShock", 1.0f, "");
	
	PlaySoundAtEntity("", "afx_pigline_electrical_arc.snt", asEntity, 0.0f, false);
	//StartScreenShake(0.01, 0, 0.1, 0.3);
	GivePlayerDamage(1, "BloodSplat", true, false);	
}

