//DEATH HANDLER//
void DeathHandler (string &in asName, int alCount)
{		
	SetPlayerCrouching(false);
	SetPlayerCrouchDisabled(false);
	SetPlayerMoveSpeedMul(1);
	SetPlayerLookSpeedMul(1);
	FadeImageTrailTo(0, 1);
	SetEntityActive("ControlWretch", false);
	SetEntityActive("ControlWretch_Kill", false);
}
//END DEATH HANDLER//

//GENERIC TIMERS//

void TimerActivatePS(string &in asTimer)
{
	SetParticleSystemActive(asTimer, true);
}

void TimerSetLightInvisible(string &in asTimer)
{
	SetLightVisible(asTimer, false);
}

void TimerSetLampUnlit(string &in asTimer)
{
	SetLampLit(asTimer, false, true);
}

void TimerReturnLookSpeedToNormal(string &in asTimer)
{
	SetPlayerLookSpeedMul(1.0f);
}

//END GENERIC TIMERS//

void CollideFlickerLamp(string &in asParent, string &in asChild, int alState)
{
	if(alState == 1)
	{
		SetLanternFlickerActive(true);
	}
	else
	{
		SetLanternFlickerActive(false);
	}
}

void CollideStopAllSounds(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("block_box_1", true);
	
	return;
	StopSound("Flood_Ambience", 12);
	StopSound("Base_Ambience", 12);
	StopSound("bloodriver3d_end_1", 12);
	StopSound("bloodriver3d_end", 12);
	StopSound("TanksLeak_3", 12);
	StopSound("ExpAmbience", 12);
	StopSound("Tripery_Music_Ambience", 12);
	
	AddTimer("bend", 4.2, "TimerBreath");
}

void TimerBreath(string &in asTimer)
{
	PlayGuiSound("react_breath3.ogg", 0.3);
	AddTimer("bend", 4.2, "TimerBreath");
}