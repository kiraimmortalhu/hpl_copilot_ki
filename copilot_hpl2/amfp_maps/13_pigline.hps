	//Effects
	{
		
		for (int i = 1; i <= 5; i++)
		{
			//SetLightVisible("FireLight_"+i, false);
			FadeLightTo("FireLight_"+i, 0,0,0,0, -1, 0.f);
		}
		
		SetLightVisible("Bank2_Broken_Light", false);
