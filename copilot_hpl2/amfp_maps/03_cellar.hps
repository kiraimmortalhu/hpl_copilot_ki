		AddTimer("MoveSpeedNormal", 6.5f, "TimerEndCalls");
		AddEntityCollideCallback("Player", "PigNoiseTrigger_PostSmash", "PigNoise_PostSmash", true, 1);
		AddTimer("PostQuakeMusic", 8.5f, "TimerEndCalls");
		AddTimer("postsmash2music", 37.5f, "TimerEndCalls");
		AddTimer("PigExplosionBuffer", 4.9f, "PigSequencerTimedEnd");
		AddTimer("ReactBreath", 8.0f, "TimerEndCalls");
		AddTimer("ReactBreath", 13.0f, "TimerEndCalls");
		StartScreenShake(0.02f, 0.5f, 1.0f, 2.5f);
		return;
	}
	//END EVENT 2//
}

void PigSequencerTimedEnd (string &in asTimer)
{
	StartScreenShake(0.5f, 0.2f, 0.0f, 1.5f);
	StopMusic(0.5f, 2);
	AddTimer("endflickercellarlamps", 3.0f, "TimerEndCalls");
	SetLampLit("cellar01_lamp_17", true, false);
	SetLampFlickerActive("cellar01_lamp_17", true);
	SetLampLit("cellar01_lamp_15", true, false);
	SetLampFlickerActive("cellar01_lamp_15", true);	
	SetLampLit("cellar01_lamp_12", true, false);
	SetLampFlickerActive("cellar01_lamp_12", true);	
	
	//SetEntityActive("InfectArea", true);
	SetLightVisible("Cellar2DoorwaySpot", false);
	SetParticleSystemActive("PigExplosion2Particles", true);
	//COLLAPSE EVENT//
	SetEntityActive("AreaTriggerVOWithoutInfection", true);
	SetEntityActive("collapse_barrels", false);
	SetEntityActive("collapse_barrels_01", true);
	SetEntityActive("collapse_vents", false);
	SetEntityActive("collapse_vents_01", true);
	SetEntityActive("collapse_railings", false);
	SetEntityActive("collapse_railings_01", true);
	SetEntityActive("collapse_beams", false);
	SetEntityActive("collapse_beams_01", true);
	SetEntityActive("collapse_gratings", false);
	SetEntityActive("collapse_gratings_01", true);
	SetEntityActive("PipeValveFull2", false);
	SetEntityActive("Gate6Valve", false);
	SetEntityActive("Gate6ValveGauge", false);
	SetEntityActive("PipeValveTJoint_1", true);
	SetEntityActive("ExplodingValveBroken_1", true);
	SetEntityActive("InfectionLiquid", true);
	SetParticleSystemActive("CollapseOneShotParticles_*", true);
	SetParticleSystemActive("CollapsePipeParticles_*", true);
	SetParticleSystemActive("CollapseAreaParticles_*", true);
	SetParticleSystemActive("PipeBreakValveSmallSteam_*", true);
	SetParticleSystemActive("PipeBreakValveSteam", true);
	PlaySoundAtEntity("", "afx_cellar_post_collapse_steam_1.snt", "collapse_steam_01", 0.0f, true);
	PlaySoundAtEntity("", "afx_cellar_post_collapse_steam_2.snt", "collapse_Steam_02", 0.0f, true);
	PlaySoundAtEntity("", "afx_cellar_post_collapse_dust.snt", "collapse_dust", 0.0f, false);
	SetMoveObjectState("Gate1", 0); //PREVENT BACKTRACKING AND SEQUENCE BREAKING//
	//END COLLAPSE EVENT//
	AddTimer("tinkertimer2", 0.1f, "TimerEndCalls");
	AddTimer("ReactBreath", 7.5f, "TimerEndCalls");
	AddTimer("3_screenshake2", 2.65f, "TimerEndCalls");
}
