//FUSE MACHINE EVENT HANDLER//
void FuseMachineHandler (string &in asParent, string &in asChild, int alState)
{
	//CONVERT asParent TO Literal String//
	string sFuseName = StringSub(asParent, 0, 4);			 //This is required for use in the if statement below, as wildcard comparisons are not supported.
	AddDebugMessage("sFuseName = "+sFuseName, false);

	//BROKEN FUSE REMOVAL CASES//
	if (asChild == "SideRoomBrokenFuseRemovalTracker")
	{
		DestroyParticleSystem("SideRoomBlackSmoke");
		SetLightVisible("SideRoomBrokenFuseLight", false);
		SetLightVisible("SideRoomBrokenFuseLight_Intense", false);
		StopSound("BrokenSparks1", 0.4f);
		SetLocalVarInt("Sparks1SoundActive", 0);
		PlayGuiSound("cellar_light_flicker_05.ogg", 0.8);
		PlayGuiSound("fuse_insert.snt", 0.1);
		return;
	}
	else if (asChild == "CatwalkBrokenFuseRemovalTracker")
	{
		DestroyParticleSystem("CatwalkBlackSmoke");
		SetLightVisible("CatwalkBrokenFuseLight", false);
		SetLightVisible("CatwalkBrokenFuseLight_Intense", false);
		StopSound("BrokenSparks2", 0.4f);
		SetLocalVarInt("Sparks2SoundActive", 0);
		PlayGuiSound("cellar_light_flicker_05.ogg", 0.8);
		PlayGuiSound("fuse_insert.snt", 0.1);
		return;
	}
	
	//FUSE CASES//
	else if (sFuseName == "Fuse")
	{
		if (asChild == "SideRoomFuseCollider" && GetPropIsInteractedWith(asParent) == true && GetEntitiesCollide("SideRoomBrokenFuseRemovalTracker", "SideRoomBrokenFuse") == false && GetEntitiesCollide("SideRoomBrokenFuseRemovalTracker", "CatwalkBrokenFuse") == false)
		{
			AddDebugMessage(asParent+" was fitted to SIDEROOM MACHINE", false);
			RemoveEntityCollideCallback("Fuse_*", "SideRoomFuseCollider");
			SetEntityActive(asParent, false);
			SetEntityActive("SideRoomFittedFuse", true);
			PlaySoundAtEntity("FuseInsert", "fuse_insert.snt", "SideRoomBrokenFuseRemovalTracker", 0.0f, false);
			PlaySoundAtEntity("FuseHum1", "afx_cellar_hum_loop.snt", "SideRoomSwitch", 0.0f, true);
			PlayPropAnimation("SideRoomBlackGauge", "on", 1.0f, true, "");
			//SetLeverInteractionDisablesStuck("SideRoomSwitch", true);
			SetLocalVarInt("SideRoomMachineOn", 1);
			return;
		}
		else if (asChild == "CatwalkFuseCollider" && GetPropIsInteractedWith(asParent) == true && GetEntitiesCollide("CatwalkBrokenFuseRemovalTracker", "CatwalkBrokenFuse") == false && GetEntitiesCollide("CatwalkBrokenFuseRemovalTracker", "SideRoomBrokenFuse") == false)
		{
			AddDebugMessage(asParent+" was fitted to CATWALK MACHINE", false);
			VOPlayer("Player", "Second_fuse_replace_VO", 1);
			RemoveEntityCollideCallback("Fuse_*", "CatwalkFuseCollider");
			SetEntityActive(asParent, false);
			SetEntityActive("CatwalkFittedFuse", true);
			PlaySoundAtEntity("FuseInsert", "fuse_insert.snt", "CatwalkBrokenFuseRemovalTracker", 0.0f, false);
			PlaySoundAtEntity("FuseHum2", "afx_cellar_hum_loop.snt", "CatwalkSwitch", 0.0f, true);
			PlayPropAnimation("CatwalkBlackGauge", "on", 1.0f, true, "");
			SetLeverInteractionDisablesStuck("CatwalkSwitch", true);
			SetLocalVarInt("CatwalkMachineOn", 1);
			AddHint("Cellar5", "");
			return;
		}
	}
}

void FuseMachineSwitchHandler (string &in asEntity, int alState)
{
	if (alState ==1)
	{
		if (asEntity == "SideRoomSwitch")
		{
			if  (GetLocalVarInt("SideRoomMachineOn") == 0)
			{				
				StartBrokenFuseFeedback("SideRoom");
				
				AddTimer("Cellar2", 1.f, "TimerDelayedHint");
				return;
			}
			PlaySoundAtEntity("", "afx_cellar_smallmachine_spark.snt", "SideRoomSwitch", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_smallmachine_start.snt", "SideRoomSwitch", 0.0f, false);
			PlaySoundAtEntity("", "amb_cellar_smallmachine.snt", "SideRoomSwitch", 0.0f, true);
			StopSound("FuseHum1", 0.5f);
			SetParticleSystemActive("Pipeline1Steam_1", true);
			PlaySoundAtEntity("P1S1", "afx_cellar_steam_loop.snt", "Pipeline1Steam1Source", 0.5f, true);
			SetParticleSystemActive("SideRoomSwitchSparks_*", true);
			PlayPropAnimation("SideRoomBrassGauge", "on", 1.0f, true, "");
			SetLampLit("SideRoomLamp_Green", true, false);
			SetLampLit("SideRoomLamp_Red", false, false);
			SetLeverInteractionDisablesStuck("SideRoomSwitch", false);
			SetEntityInteractionDisabled("SideRoomSwitch", true);
			SetLeverStuckState("SideRoomSwitch", 1, false);
			AddTimer("Pipeline1ParticleTimerA", 0.25f, "TimerEndCalls");
			AddTimer("Pipeline1ParticleTimerB", 0.5f, "TimerEndCalls");
			SetLocalVarInt("SideRoomLeverPulled", 1);
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "Gate1Valve", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_open_midpers.snt", "Gate1", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_reverb", "Gate1", 0.0f, false);
			SetMoveObjectState("Gate1", 1);
			AddEntityCollideCallback("Player", "soundopt_tremor2_preload", "soundopt", true, 1);
			DestroyParticleSystem("Pipeline1Steam_1");
			DestroyParticleSystem("Pipeline1Steam_2");
			DestroyParticleSystem("Pipeline1Steam_3");
			DestroyParticleSystem("Pipeline1Steam_4");
			DestroyParticleSystem("Pipeline1Steam_5");
			DestroyParticleSystem("Pipeline1Steam_6");
			StopSound("P1S1", 0.5f);
			StopSound("P1S2", 0.5f);
			StopSound("P1S3", 0.5f);
			StopSound("P1S4", 0.5f);
			StopSound("P1S5", 0.5f);
			StopSound("P1S6", 0.5f);
			return;
		}
		else if (asEntity == "BarrelRoomSwitch")
		{
			PlaySoundAtEntity("", "afx_cellar_smallmachine_spark.snt", "BarrelRoomSwitch", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_smallmachine_start.snt", "BarrelRoomSwitch", 0.0f, false);
			PlaySoundAtEntity("", "amb_cellar_smallmachine.snt", "BarrelRoomSwitch", 0.0f, true);
			StopSound("FuseHum3", 0.5f);
			SetParticleSystemActive("Pipeline2Steam_1", true);
			PlaySoundAtEntity("P2S1", "afx_cellar_steam_loop.snt", "Pipeline2Steam1Source", 0.5f, true);
			SetParticleSystemActive("Pipeline2Steam_2", true);
			PlaySoundAtEntity("P2S2", "afx_cellar_steam_loop_2.snt", "Pipeline2Steam2Source", 0.5f, true);
			SetParticleSystemActive("Pipeline2Steam_3", true);
			PlaySoundAtEntity("P2S3", "afx_cellar_steam_loop_2.snt", "Pipeline2Steam3Source", 0.5f, true);
			SetParticleSystemActive("Pipeline2Steam_4", true);
			PlaySoundAtEntity("P2S4", "afx_cellar_steam_loop.snt", "Pipeline2Steam4Source", 0.5f, true);
			SetParticleSystemActive("BarrelRoomSwitchSparks_*", true);
			PlayPropAnimation("BarrelRoomBrassGauge", "on", 1.0f, true, "");
			SetLampLit("barrelroom_machine_1", true, false);
			SetLampLit("barrelroom_machine_2", false, false);
			SetLeverInteractionDisablesStuck("BarrelRoomSwitch", false);
			SetEntityInteractionDisabled("BarrelRoomSwitch", true);
			SetLeverStuckState("BarrelRoomSwitch", 1, false);
			SetLocalVarInt("BarrelRoomLeverPulled", 1);
			AddEntityCollideCallback("Player", "Child2Trigger", "ChildEventHandler", true, 1); //Setup Catwalk Child
			//SetEntityActive("Child2", true); //Setup Catwalk Child
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "Gate2Valve", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_open_midpers.snt", "Gate2", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_reverb", "Gate2", 0.0f, false);
			SetMoveObjectState("Gate2", 1);
			AddEntityCollideCallback("Player", "Sound_ThunderTrigger", "Sound_ThunderTrigger", true, 1);
			//ADD QUAKE PRELOAD TRIGGER
			AddEntityCollideCallback("Player", "soundopt_machinequake_preload", "soundopt", true, 1);
			DestroyParticleSystem("Pipeline2Steam_1");
			DestroyParticleSystem("Pipeline2Steam_2");
			DestroyParticleSystem("Pipeline2Steam_3");
			DestroyParticleSystem("Pipeline2Steam_4");
			DestroyParticleSystem("Pipeline2Steam_5");
			StopSound("P2S1", 0.5f);
			StopSound("P2S2", 0.5f);
			StopSound("P2S3", 0.5f);
			StopSound("P2S4", 0.5f);
			StopSound("P2S5", 0.5f);

		}
		else if (asEntity == "CatwalkSwitch")
		{
			if  (GetLocalVarInt("CatwalkMachineOn") == 0)
			{
				StartBrokenFuseFeedback("Catwalk");
				return;
			}
			PlaySoundAtEntity("", "afx_cellar_smallmachine_spark.snt", "CatwalkSwitch", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_smallmachine_start.snt", "CatwalkSwitch", 0.0f, false);
			PlaySoundAtEntity("", "amb_cellar_smallmachine.snt", "CatwalkSwitch", 0.0f, true);
			StopSound("FuseHum2", 0.5f);
			SetParticleSystemActive("Pipeline3Steam_1", true);
			PlaySoundAtEntity("P3S1", "afx_cellar_steam_loop.snt", "Pipeline3Steam1Source", 0.5f, true);
			SetParticleSystemActive("CatwalkSwitchSparks_*", true);
			PlayPropAnimation("CatwalkBrassGauge", "on", 1.0f, true, "");
			SetLampLit("CatwalkLamp_Green", true, false);
			SetLampLit("CatwalkLamp_Red", false, false);
			SetLeverInteractionDisablesStuck("CatwalkSwitch", false);
			SetEntityInteractionDisabled("CatwalkSwitch", true);
			SetLeverStuckState("CatwalkSwitch", 1, false);
			AddTimer("Pipeline3ParticleTimerA", 0.25f, "TimerEndCalls");
			AddTimer("Pipeline3ParticleTimerB", 0.5f, "TimerEndCalls");
			SetLocalVarInt("CatwalkLeverPulled", 1);
			AddEntityCollideCallback("Player", "TwinTrigger", "ChildEventHandler", true, 1);
			AddEntityCollideCallback("Player", "Double_sighting_1_VO", "VOPlayer", true, 1);
			//SetEntityActive("Child3", true);
			SetEntityActive("Child4", true);
			PlaySoundAtEntity("", "afx_steam_pipe_sting.snt", "Gate5Valve", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_open_closepers.snt", "Gate5", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_open_farpers.snt", "Gate3", 0.0f, false);
			PlaySoundAtEntity("", "afx_cellar_gate_reverb", "Gate3", 0.0f, false);
			SetMoveObjectState("Gate2", 0);
			SetMoveObjectState("Gate3", 1);
			SetMoveObjectState("Gate5", 1);
			DestroyParticleSystem("Pipeline3Steam_1");
			DestroyParticleSystem("Pipeline3Steam_2");
			DestroyParticleSystem("Pipeline3Steam_3");
			DestroyParticleSystem("Pipeline3Steam_4");
			DestroyParticleSystem("Pipeline3Steam_5");
			StopSound("P3S1", 0.5f);
			StopSound("P3S2", 0.5f);
			StopSound("P3S5", 0.5f);
			//SET CHECKPOINT #3//
			CheckPoint("CP03_Catwalk", "CheckpointStart_2", "", "", "", false);
		}
	}
}

void StartBrokenFuseFeedback(string &in asMachine)
{
	PlaySoundAtEntity("", "joint_lever_tesla_pull_stuck.snt", asMachine + "Switch", 0.0f, false);
	SetLeverStuckState(asMachine + "Switch", -1, true);
		
	if (GetEntitiesCollide(asMachine+"BrokenFuseRemovalTracker", asMachine+"BrokenFuse"))
		AddTimer("StartSparks", 0.2f, "BrokenFuseFeedbackSequence");
		
	if (GetLocalVarString("CurrentErrorMachine") == "")
	{
		
		SetLocalVarString("CurrentErrorMachine", asMachine);
		AddTimer("RedLightOff", 1.0f, "BrokenFuseFeedbackSequence");		
		AddTimer("StopFeedback", 4.625f, "BrokenFuseFeedbackSequence");
	}
}

void BrokenFuseFeedbackSequence (string &in asTimer)
{
	string sMachine = GetLocalVarString("CurrentErrorMachine");
	
	if (asTimer == "ErrorSound")
	{
		//Sound here
		PlaySoundAtEntity("", "afx_reactor_fuel_rod_error_buzz_3D.snt", sMachine+"Switch", 0.0f, false);
		
		AddTimer("RedLightOff", 0.25f, "BrokenFuseFeedbackSequence");
		AddTimer("StopBlink", 4.125f, "BrokenFuseFeedbackSequence");
	}
	else if (asTimer == "RedLightOff")
	{
		SetLampLit(sMachine+"Lamp_Red", false, true);
		AddTimer("RedLightOn", 0.6f, "BrokenFuseFeedbackSequence");
	}
	else if (asTimer == "RedLightOn" && GetLocalVarInt(sMachine + "LeverPulled") == 0)
	{			
		SetLampLit(sMachine+"Lamp_Red", true, true);
		AddTimer("RedLightOff", 0.6f, "BrokenFuseFeedbackSequence");
	}
	else if (asTimer == "StartSparks")
	{
		PlaySoundAtEntity("BrokenShortSpark", "frog_board_twitch_spark.snt", sMachine+"BrokenFuse", 0.0f, false);
		SetLightVisible(sMachine + "BrokenFuseLight_Intense", true);
		SetLightFlickerActive(sMachine + "BrokenFuseLight_Intense", true);
		RemoveTimer("StopSparks");
		AddTimer("StopSparks", 0.5f, "BrokenFuseFeedbackSequence");
	}
	else if (asTimer == "StopSparks")
	{
		SetLightVisible(sMachine + "BrokenFuseLight_Intense", false);
	}
	else if (asTimer == "StopFeedback")
	{
		SetLocalVarString("CurrentErrorMachine", "");
		
		if (GetLocalVarInt(sMachine + "LeverPulled") == 0)
			SetLampLit(sMachine+"Lamp_Red", true, true);
			
		RemoveTimer("RedLightOn");
		RemoveTimer("RedLightOff");
		
		RemoveTimer("StartSparks");
		RemoveTimer("StopSparks");
		SetLightVisible(sMachine + "BrokenFuseLight_Intense", false);
	}
}

void InteractFuseMachineHints (string &in asEntity)
{
	AddTimer("Cellar2", 1.5f, "TimerDelayedHint");
}

//END FUSE MACHINE HANDLER//

//BARRICADE INTERACTION HANDLER//
void BarricadeInteractionStateHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "EnableInteractWithBarricade")
	{
		SetEntityInteractionDisabled("DoorBarricade", false);
		SetLocalVarInt("DoorBarricadeInteractionStatus", 1);
		return;
	}
	else if (asChild == "DisableInteractWithBarricade" && GetLocalVarInt("HasInteractedWithBarricade") == 0)
	{
		SetEntityInteractionDisabled("DoorBarricade", true);
		SetLocalVarInt("DoorBarricadeInteractionStatus", 0);
		return;
	}
}

void DoorBarricadeInteractionHandler (string &in asEntity)
{
	SetLocalVarInt("HasInteractedWithBarricade", 1);
	RemoveEntityCollideCallback("Player", "EnableInteractWithBarricade");
	RemoveEntityCollideCallback("Player", "DisableInteractWithBarricade");
}
//END BARRICADE INTERACTION HANDLER//

