	if (asChild == "PigSqueal1") 
	{
		AddDebugMessage("Piq Squeal 1 Triggered", false);
	//	PlaySoundAtEntity("", "afx_cellar_event_machinehall_pig_1_2D.snt", "pigsource", 0.0f, false);
	//	PlaySoundAtEntity("", "afx_cellar_event_machinehall_pig_1_3D.snt", "pigsource", 0.0f, false);
	//	DestroyParticleSystem("FlatFog_1");
	//	DestroyParticleSystem("FlatFog_2");
