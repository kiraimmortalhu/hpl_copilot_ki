										////////////////////////////////
										//MAP INITIALISATION FUNCTIONS//
										////////////////////////////////
										
void OnStart()
{
	//Map Preamble
	{
		SetMapDisplayNameEntry("Cellar");
		//SET CHECKPOINT #1//
		CheckPoint("CP01_Start", "MainStart", "", "", "", false);
		//CLEAR OLD HINTS//
		//RemoveAllHints();
	}
	
	// Setup Local Variables
	{
		SetLocalVarInt("DoIntro", 1);
		SetLocalVarInt("IntroHasFinished", 0);
		SetLocalVarInt("spraylocksequenced", 0);
		SetLocalVarInt("HasInteractedWithBarricade", 0);
		SetLocalVarInt("SideRoomMachineOn", 0);
		SetLocalVarInt("SideRoomLeverPulled", 0);
		SetLocalVarInt("BarrelRoomLeverPulled", 0);
		SetLocalVarInt("CatwalkMachineOn", 0);
		SetLocalVarInt("CatwalkLeverPulled", 0);
		SetLocalVarInt("Sparks1SoundActive", 1);
		SetLocalVarInt("Sparks2SoundActive", 1);
		SetLocalVarInt("Gate1ValveOn", 0);
		SetLocalVarInt("Gate2ValveOn", 0);
		SetLocalVarInt("Gate5ValveOn", 0);
		SetLocalVarInt("DoorBarricadeInteractionStatus", 0);
		SetLocalVarString("CurrentErrorMachine", "");
	}
	
	//Debugging
	if(ScriptDebugOn()) 
	{	
		SetLocalVarInt("DoIntro", 0);	//Skip intro if 0
		GiveItemFromFile("lantern", "lantern.ent");
	}
	
	//AutoRun Events
	if(GetLocalVarInt("DoIntro") == 1)
	{	
		SetPlayerCrouching(true);
		SetPlayerJumpDisabled(true);
		SetPlayerCrouchDisabled(true);
		SetPlayerLookSpeedMul(0.3);
		SetPlayerMoveSpeedMul(0.2);
		SetLanternDisabled(true);
		FadePlayerRollTo(30.0f, 50.0f, 50.0f);
		ShowPlayerCrossHairIcons(false);
		AddTimer("StartFX", 0.1f, "InitSequence");
	}

	//Setup Initial Entity Callbacks
	{
		//COLLISION CALLBACKS//
		AddEntityCollideCallback("Player", "CreakTrigger_1", "EntranceHallCreaks", true, 1);
		AddEntityCollideCallback("Player", "CreakTrigger_2", "EntranceHallCreaks", true, 1);
		AddEntityCollideCallback("Player", "CreakTrigger_3", "EntranceHallCreaks", true, 1);
		AddEntityCollideCallback("Player", "KillEntranceHallLights", "EntranceHallLightEvent", true, 1);
		AddEntityCollideCallback("Player", "Child1Trigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Player", "PigSqueal1", "PigPursuitSequence", true, 1);
		AddEntityCollideCallback("Player", "PigBreakTrigger", "PigPursuitSequence", true, 1);
		AddEntityCollideCallback("Player", "PigBreakTrigger_1", "PigPursuitSequence", true, 1);
		AddEntityCollideCallback("Player", "PigRepairSounds", "PigPursuitSequence", true, 1);
		AddEntityCollideCallback("Player", "BarrelRollTrigger", "BarrelEvent", true, 1);
		AddEntityCollideCallback("BarrelBeamLower_1", "BarrelBarricadeCollider", "UnblockRampBarrels", true, -1);
		AddEntityCollideCallback("BarrelBeamLower", "AreaPulledThing", "CollideBarrelSliderPulled", true, 1);
		AddEntityCollideCallback("Player", "BarrelBlockSlopeRemove", "RemoveBarrelRampCollision", true, 1);
		AddEntityCollideCallback("Player", "RampCreakTrigger_1", "RampCreaks", true, 1);
		AddEntityCollideCallback("Player", "RampCreakTrigger_2", "RampCreaks", true, 1);
		AddEntityCollideCallback("Fuse_*", "SideRoomFuseCollider", "FuseMachineHandler", false, 1);
		AddEntityCollideCallback("Fuse_*", "CatwalkFuseCollider", "FuseMachineHandler", false, 1);
		AddEntityCollideCallback("SideRoomBrokenFuse", "SideRoomBrokenFuseRemovalTracker", "FuseMachineHandler", true, -1);
		AddEntityCollideCallback("CatwalkBrokenFuse", "CatwalkBrokenFuseRemovalTracker", "FuseMachineHandler", true, -1);
		AddEntityCollideCallback("Player", "EnableInteractWithBarricade", "BarricadeInteractionStateHandler", false, 1);
		AddEntityCollideCallback("Player", "DisableInteractWithBarricade", "BarricadeInteractionStateHandler", false, 1);
		AddEntityCollideCallback("Player", "MachineHallQuakeTrigger", "QuakeEvent", true, 1);
		AddEntityCollideCallback("Player", "SpraylockStopMusic", "SpraylockStopMusic", true, 1);
		AddEntityCollideCallback("Player", "NewQuakeTrigger1", "NewQuakeTrigger1", true, 1);
		AddEntityCollideCallback("Player", "NewQuakeTrigger2", "NewQuakeTrigger2", true, 1);
		AddEntityCollideCallback("Player", "AreaBehindBeamDoor", "EnterBehindBeamDoor", true, 1);
		AddEntityCollideCallback("Player", "BarrelRampHintTrigger", "HintHandler", true, 1);
		AddEntityCollideCallback("Player", "SecondFuseHintTrigger", "HintHandler", true, 1);
		AddEntityCollideCallback("Player", "AreaTriggerVOWithoutInfection", "Infection_Event", true, 1);
		
		//Spraylock Callbacks
		SetEntityConnectionStateChangeCallback("spraylock_valve_outside_1", "SpraylockDoorHandler");
		SetEntityConnectionStateChangeCallback("spraylock_valve_inside_1", "SpraylockDoorHandler");
		SetEntityConnectionStateChangeCallback("spraylock_valve_outside_2", "SpraylockDoorHandler");
		SetEntityConnectionStateChangeCallback("spraylock_valve_inside_2", "SpraylockDoorHandler");
		SetEntityConnectionStateChangeCallback("spraylock_power_switch", "SpraylockSequence");
		SetEntityConnectionStateChangeCallback("spraylock_spray_switch", "SpraylockSequence");
		AddEntityCollideCallback("Player", "spraylock_power_interaction_area", "CheckPowerSwitchProximity", false, 0);
		
		//STATE CHANGE CALLBACKS//
		SetEntityConnectionStateChangeCallback("SideRoomSwitch", "FuseMachineSwitchHandler");	
		SetEntityConnectionStateChangeCallback("BarrelRoomSwitch", "FuseMachineSwitchHandler");	
		SetEntityConnectionStateChangeCallback("CatwalkSwitch", "FuseMachineSwitchHandler");
		SetEntityConnectionStateChangeCallback("Gate1Valve", "ValveGateHandler");
		SetEntityConnectionStateChangeCallback("Gate2Valve", "ValveGateHandler");
		SetEntityConnectionStateChangeCallback("Gate5Valve", "ValveGateHandler");
		
		//INTERACT CALLBACKS//
		SetEntityPlayerInteractCallback("DoorBarricade", "DoorBarricadeInteractionHandler", true);
		SetEntityPlayerInteractCallback("SideRoomBrokenFuse", "InteractFuseMachineHints", true);
		//SetEntityPlayerInteractCallback("SideRoomSwitch", "InteractFuseMachineHints", true);
		SetEntityPlayerInteractCallback("CrankWheel", "DisableBarrelHint", true);
		
		//TYPE-DEFINED ENTITY CALLBACKS//
		SetEntityCallbackFunc("lantern_1", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_2", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_3", "LanternInfoUpdate");
		SetEntityCallbackFunc("lantern_4", "LanternInfoUpdate");	
		SetEntityCallbackFunc("lantern_5", "LanternInfoUpdate");			
		
		//CHILD EVENT CALLBACKS
		AddEntityCollideCallback("Child1", "Child1KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child1a", "Child1aKillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child2", "Child2KillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child3", "TwinKillTrigger", "ChildEventHandler", true, 1);
		AddEntityCollideCallback("Child4", "TwinKillTrigger", "ChildEventHandler", true, 1);
		
		//Setup Creak Callbacks		
		AddEntityCollideCallback("Player", "AFX_Creak_01", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_02", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_03", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_04", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_05", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_06", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_07", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_08", "CreakAreas", false, 0);
		AddEntityCollideCallback("Player", "AFX_Creak_09", "CreakAreas", false, 0);
	}

	//Setup Initial Object States
	{	
		//SETUP CONNECTIONS//
		InteractConnectPropWithMoveObject("barrelcranktoslope", "CrankWheel", "BarrelRamp", false, false, 0);
		InteractConnectPropWithMoveObject("barrelcranktopulley", "CrankWheel", "CrankPulley", false, true, 0);
		InteractConnectPropWithMoveObject("barrelcranktoropes1", "CrankWheel", "slope_ropes", false, true, 0);
		InteractConnectPropWithMoveObject("barrelcranktoropes2", "CrankWheel", "slope_ropes_1", false, false, 0);
		InteractConnectPropWithMoveObject("barrelcranktowheel1", "CrankWheel", "slope_wheel_1", false, true, 0);
		InteractConnectPropWithMoveObject("barrelcranktowheel2", "CrankWheel", "slope_wheel_2", false, false, 0);
		InteractConnectPropWithMoveObject("barrelcranktowheel3", "CrankWheel", "slope_wheel_3", false, false, 0);
	
		//DOOR STATES//
		SetMoveObjectState("Gate4", 1);
	}
		
	//Setup Ambience Callbacks
	{
		AddEntityCollideCallback("Player", "AMBStartHall", "MapAmbienceAreas", false, 0);															
		AddEntityCollideCallback("Player", "AMBMachineRoom", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBCellarApproach_1", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBCellarApproach_2", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBOffices", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "AMBTransRoom", "MapAmbienceAreas", false, 0);
		AddEntityCollideCallback("Player", "Sound_StartEnvRand_2", "RandomSound", true, 0);
		AddEntityCollideCallback("Player", "Sound_StartEnvRand_1", "RandomSound", true, 0);
	}
		
	//Setup Music Callbacks
	{
		AddEntityCollideCallback("Player", "BarrelRampMusicTrigger", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "EntranceMusicTrigger", "MusicPlayer", true, 1);
		AddEntityCollideCallback("Player", "OfficeMusicTrigger", "MusicPlayer", true, 1);
	}

	//Setup Initial VO Callbacks
	{
		AddEntityCollideCallback("Player", "Entry_corridor_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "first_fuse_box_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Entry_into_main_cellar_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Broken_valve_VO", "VOPchild2ayer", true, 1);
		AddEntityCollideCallback("Player", "Child_above_main_cellar_2_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Stairs_to_pig_smash_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Post-pig_smash_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Second_need_fuse_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Double_sighting_2_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "Final_fusebox_VO", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "BarrelVOTrigger", "VOPlayer", true, 1);
		AddEntityCollideCallback("Player", "PhoneTrigger", "CellarPhone", true, 1);
	}
	
	//Setup Phonoautograph Callbacks
	{
		SetEntityConnectionStateChangeCallback("Phonautograph1", "PhonautographHandler"); 			//Arguments Required: ("Name of the Phonoautograph entity", "Name of the function to call on interaction" < this will always be the same)
	}
	
	//SOUND OPTIMISATIONS
	{
	//FIRST HALLWAY
	AddEntityCollideCallback("Player", "soundopt_firsthallway_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_firsthallway_start_2", "soundopt", true, 1);
	//CELLAR HALL
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_3", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_4", "soundopt", true, 1);
	//OFFICE
	AddEntityCollideCallback("Player", "soundopt_office_start_1", "soundopt", true, 1);
	//PRELOADS
	//TREMOR 1 PRELOAD TRIGGER
	AddEntityCollideCallback("Player", "soundopt_tremor1_preload", "soundopt", true, 1);
	//TREMOR 3 PRELOAD TRIGGER
	AddEntityCollideCallback("Player", "soundopt_tremor3_preload", "soundopt", true, 1);
	//SMALL MACHINE SOUNDS PRELOAD TRIGGER
	AddEntityCollideCallback("Player", "soundopt_smallmachine_preload", "soundopt", true, 1);
	}
	
	//Lights
	{
		SetLightVisible("SideRoomBrokenFuseLight_Intense", false);
		SetLightVisible("CatwalkBrokenFuseLight_Intense", false);
	}
	
	StopSound("steam_loop_hallway_3", 0);
	StopSound("steam_loop_hallway_5", 0);
	
	FadeInSound("steam_loop_hallway_3", 2, false);
	FadeInSound("steam_loop_hallway_5", 2, false);
} 

void OnEnter()
{
	//DEFAULT SWITCH LANTERN TO ON//
	{
		SetLanternFlickerActive(false);
	}
	
	//INITIALISE RANDOM SOUND CUE PLAYER//
	{
		

	}
	
	//INITIALISE LAST PLAYING AMBIENCE//
	{
		string sAmbienceToRestart = GetLocalVarString("CurrentAmbientTrack");
		MapAmbienceAreas("Player", sAmbienceToRestart, 1);
	}
	
	//ENTITY STATES//
	{
		if (GetGlobalVarInt("PlayerHasALantern") == 1)
		{
			SetEntityActive("lantern_*", false);
		}
	}
	
	//PERMANENT ENTITY INTERACTION
	{
		SetEntityInteractionDisabled("barrel_1", true);
		SetEntityInteractionDisabled("barrel_3", true);
		SetEntityInteractionDisabled("barrel_4", true);
		SetEntityInteractionDisabled("barrel_move2", true);
	}
	
	//NON-PERMANENT ENTITY INTERACTION//
	{
		if (GetLocalVarInt("DoorBarricadeInteractionStatus") == 0)
		{
			SetEntityInteractionDisabled("DoorBarricade", true);
		}
		else
		{
			SetEntityInteractionDisabled("DoorBarricade", false);
		}
		SetEntityInteractionDisabled("spraylock_power_switch", true);
	}
	
	//SOUND INITIALISATION//
	{
		if (GetLocalVarInt("Sparks1SoundActive") == 1)
		{
			PlaySoundAtEntity("BrokenSparks1", "afx_cellar_spark_loop.snt", "SideRoomBrokenFuse", 0.0f, true);
		}
		if (GetLocalVarInt("Sparks2SoundActive") == 1)
		{
			PlaySoundAtEntity("BrokenSparks2", "afx_cellar_spark_loop.snt", "CatwalkBrokenFuse", 0.0f, true);
		}
		if (GetLocalVarInt("BarrelRoomLeverPulled") == 1)
		{
			PlaySoundAtEntity("FuseHum3", "afx_cellar_hum_loop.snt", "BarrelRoomSwitch", 0.0f, true);
		}
	}
	
	//ANIMATION STATES//
	{
		if (GetLocalVarInt("SideRoomMachineOn") == 0)
		{
			PlayPropAnimation("SideRoomBlackGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("SideRoomBlackGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("SideRoomLeverPulled") == 0)
		{
			PlayPropAnimation("SideRoomBrassGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("SideRoomBrassGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("BarrelRoomLeverPulled") == 0)
		{
			PlayPropAnimation("BarrelRoomBrassGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("BarrelRoomBrassGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("CatwalkMachineOn") == 0)
		{
			PlayPropAnimation("CatwalkBlackGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("CatwalkBlackGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("CatwalkLeverPulled") == 0)
		{
			PlayPropAnimation("CatwalkBrassGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("CatwalkBrassGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("Gate1ValveOn") == 0)
		{
			PlayPropAnimation("Gate1ValveGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("Gate1ValveGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("Gate2ValveOn") == 0)
		{
			PlayPropAnimation("Gate2ValveGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("Gate2ValveGauge", "on", 0.0f, true, "");
		}
		if (GetLocalVarInt("Gate5ValveOn") == 0)
		{
			PlayPropAnimation("Gate5ValveGauge", "off", 0.0f, true, "");
		}
		else
		{
			PlayPropAnimation("Gate5ValveGauge", "on", 0.0f, true, "");
		}		
		PlayPropAnimation("BarrelRoomBlackGauge", "on", 0.0f, true, "");
		PlayPropAnimation("Gate6ValveGauge", "off", 0.0f, true, "");
		PlayPropAnimation("Phonautograph1", "Stop", 0.0f, true, "");							//Initialises Phonautograph to non-animated.
	}
	
	//PARTICLE SYSTEM STATES//
	{
		//QUAKE EVENT//
		SetParticleSystemActive("QuakeDust_*", false);
		
		//COLLAPSE EVENT//
		SetParticleSystemActive("CollapseOneShotParticles_*", false);
		SetParticleSystemActive("CollapsePipeParticles_*", false);
		SetParticleSystemActive("CollapseAreaParticles_*", false);
		
		//FUSE MACHINE 1 SEQUENCE//
		if (GetLocalVarInt("Gate1ValveOn") == 0)
		{
			SetParticleSystemActive("Pipeline1Steam_*", false);
		}
		else
		{
			SetParticleSystemActive("Pipeline1Steam_*", true);
		}
		
		//FUSE MACHINE 2 SEQUENCE//
		if (GetLocalVarInt("Gate2ValveOn") == 0)
		{
			SetParticleSystemActive("Pipeline2Steam_*", false);
		}
		else
		{
			SetParticleSystemActive("Pipeline2Steam_*", true);
		}
		
		//FUSE MACHINE 3 SEQUENCE//
		SetParticleSystemActive("CatwalkSwitchSparks_*", false);
		if (GetLocalVarInt("Gate5ValveOn") == 0)
		{
			SetParticleSystemActive("Pipeline3Steam_*", false);
		}
		else
		{
			SetParticleSystemActive("Pipeline3Steam_*", true);
		}
		
		//PIG EXPLOSION//
		SetParticleSystemActive("PigExplosion2Particles", false);
		SetParticleSystemActive("PipeBreakValveSmallSteam_*", false);
		SetParticleSystemActive("PipeBreakValveSteam", false);
	}
	
	//CHECK LANTERN INFO//
	{
		if (GetGlobalVarInt("PlayerHasALantern") == 1)
		{
			SetEntityActive("Lantern_1", false);
			SetEntityActive("Lantern_2", false);
			SetEntityActive("Lantern_3", false);
			SetEntityActive("Lantern_4", false);
			SetEntityActive("Lantern_5", false);
		}
	}
	
	//CHILD STATES//
	{
		SetManPigType("Child1", "Freddy");
		SetEnemyMoveType("Child1", "RunBiped");
		SetManPigType("Child2", "Freddy");
		SetEnemyMoveType("Child2", "RunBiped");
		SetManPigType("Child3", "Freddy");
		SetEnemyMoveType("Child3", "RunBiped");
		SetManPigType("Child4", "Freddy");
		SetEnemyMoveType("Child4", "RunBiped");
	}
	
	//SPRAYLOCK PARTICLE SYSTEM STATES//
	{
		SetParticleSystemActive("spraylock_sparks_1", false);
		SetParticleSystemActive("spraylock_sparks_2", false);
		SetParticleSystemActive("spraylock_spray1", false);
		SetParticleSystemActive("spraylock_spray2", false);
		SetParticleSystemActive("spraylock_spray3", false);
		SetParticleSystemActive("spraylock_spray4", false);
		SetParticleSystemActive("spraylock_spray5", false);
		SetParticleSystemActive("spraylock_spray6", false);
		SetParticleSystemActive("spraylock_risingmist", false);
	}
		
	//SPRAYLOCK SPECIFIC STATES//
	{
		PlayPropAnimation("spraylock_gauge_outside_1", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_1", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_gauge_inside_2", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_engines", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_railing", "off", 0.0f, true, "");
		PlayPropAnimation("spraylock_electric_cabin", "on", 0.0f, true, "");
		PlayPropAnimation("spraylock_steam_gauges", "on", 0.0f, true, "");
		SetSwingDoorDisableAutoClose("spraylock_door_1", true);
		SetEntityInteractionDisabled("spraylock_door_1", true);
		SetSwingDoorClosed("spraylock_door_1", false, false);
		SetSwingDoorDisableAutoClose("spraylock_door_2", true);
		SetEntityInteractionDisabled("spraylock_door_2", true);
	}
	
	//SPRAYLOCK LIGHT STATES//
	{
		SetLampLit("spraylock_green_light", false, false);
		SetLightVisible("spraylock_spark_light", false);
	}
		
	//SPRAYLOCK ENTITY INTERACTION// 
	{
		SetEntityInteractionDisabled("spraylock_engines", true);
	}
		
	//SOUND INITIALISATION//
	{
		PlaySoundAtEntity("sl_hiss_1", "spraylock_gauge_hiss_1.snt", "spraylock_hiss_outside_1", 0.0f, true);
	}
	
	//AUTOSAVE//
	{
		//AutoSave();
	}
	
	//PRELOAD SOUNDS//
	{
		PreloadSound("afx_cellar_spark_loop");
		PreloadSound("afx_cellar_hum_loop");
		PreloadSound("spraylock_gauge_hiss_1");
		PreloadSound("afx_gameplay_hightone_10sec");
		PreloadSound("afx_events_cellar_intro");
		PreloadSound("afx_cellar_debris_fine");
		PreloadSound("impact_wood_med");
		PreloadSound("afx_events_cellar_newquake_01");
		PreloadSound("afx_events_cellar_newquake_02");
		PreloadSound("afx_cellar_infection_stinger");
		PreloadSound("afx_flashback_whisper");
		PreloadSound("afx_cellar_event_machinehall_pig_1_2D");
		PreloadSound("afx_cellar_event_machinehall_pig_1_3D");
		PreloadSound("afx_events_cellar_newquake_03");
		PreloadSound("afx_events_cellar_newquake_03_debris");
		PreloadSound("afx_cellar_post_collapse_steam_1");
		PreloadSound("afx_cellar_post_collapse_steam_2");
		PreloadSound("afx_cellar_post_collapse_dust");
		PreloadSound("afx_tunnels_wood_creak");
		PreloadSound("afx_cellar_climbupramp_creak_01");
		PreloadSound("afx_cellar_climbupramp_creak_02");
		PreloadSound("impact_wood_beam_high");
		PreloadSound("fuse_insert");
		PreloadSound("afx_cellar_smallmachine_spark");
		PreloadSound("afx_cellar_smallmachine_start");
		PreloadSound("amb_cellar_smallmachine");
		PreloadSound("afx_cellar_steam_loop");
		PreloadSound("afx_steam_pipe_sting");
		PreloadSound("afx_cellar_gate_open_midpers");
		PreloadSound("afx_cellar_gate_reverb");
		PreloadSound("afx_cellar_steam_loop_2");
		PreloadSound("afx_cellar_gate_open_closepers");
		PreloadSound("afx_cellar_gate_open_farpers");
		PreloadSound("joint_lever_tesla_pull_stuck");
		PreloadSound("afx_reactor_fuel_rod_error_buzz_3D");
		PreloadSound("frog_board_twitch_spark");
