//LEVEL LOAD SEQUENCE//
void InitSequence(string &in asTimer)
{
	if (asTimer == "StartFX")
	{
		FadeOut(0.0f);
		AddTimer("InitSplitTimer", 1.5f, "InitSequence");
		PlaySoundAtEntity("", "afx_gameplay_hightone_10sec.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("", "afx_events_cellar_intro", "Player", 0.0f, false);
		FadeImageTrailTo(1.0f, 0.5f);
	}
	else if (asTimer == "InitSplitTimer")
	{
		FadeIn(3.0f);
		StartPlayerLookAt("StartSequenceLookTarget2", 1.0f, 1.0f, "");
		FadePlayerRollTo(-10.0f, 5.0f, 5.0f);
		AddTimer("LookAtTarget3Timer", 2.2f, "InitSequence");
		AddTimer("LookAtTarget4Timer", 3.5f, "InitSequence");
		AddTimer("InitRestoreControlTimer", 5.0f, "InitSequence");
	}
	else if (asTimer == "LookAtTarget3Timer")
	{
		AddDebugMessage("INIT STEP 1", false);
		AddTimer("ReactBreath", 0.0f, "TimerEndCalls");
		StartPlayerLookAt("StartSequenceLookTarget3", 5.5f, 5.5f, "");
		FadePlayerRollTo(10.0f, 2.0f, 2.0f);
	}
	else if (asTimer == "LookAtTarget4Timer")
	{
		AddDebugMessage("INIT STEP 2", false);
		StartPlayerLookAt("StartSequenceLookTarget4", 3.5f, 3.5f, "");
		FadePlayerRollTo(0.0f, 7.0f, 7.0f);
	}
	else if (asTimer == "InitRestoreControlTimer")
	{
		AddDebugMessage("INIT STEP 3", false);
		SetPlayerCrouching(false);
		SetLanternDisabled(false);
		SetPlayerJumpDisabled(false);
		SetPlayerCrouchDisabled(false);
		SetPlayerMoveSpeedMul(1.0f);
		SetPlayerRunSpeedMul(1.0f);
		SetPlayerLookSpeedMul(1.0f);
		
		ShowPlayerCrossHairIcons(true);
		StopPlayerLookAt();
		SetEntityActive("InitStart", false);
		SetLocalVarInt("IntroHasFinished", 1);
		FadeImageTrailTo(0.0f, 5.5f);
	}
}
//END LEVEL LOAD SEQUENCE//

//PHONE
void CellarPhone (string &in asParent, string &in asChild, int alState)
{
	AddTimer("CellarPhoneRinging", RandFloat(1.8f, 3.2f), "CellarPhoneTimerCall");
}

void CellarPhoneTimerCall (string &in asTimer)
{
	AddDebugMessage("Phone Ringing - Timer Begin", false);
	StartPhoneRinging("phone_box_1");
	SetLampLit("phone_box_2", true, true);
	AddTimer ("phonetimeout", 30.0f,  "phonetimeout");
	
	SetEntityPlayerInteractCallback("phone_box_1", "InteractPhoneBox", true);
}

void phonetimeout (string &in asTimer)
{
	AddDebugMessage("Phone Stopped Ringing", false);
	StopPhoneRinging("phone_box_1");
	SetLampLit("phone_box_2", false, true);
	
	SetEntityPlayerInteractCallback("phone_box_1", "", false);
}

void InteractPhoneBox (string &in asEntity)
{
	RemoveTimer("phonetimeout");
	
	AddTimer("PhoneCallTimer", 28.5, "PhoneCallOver");
	StopSound("phone_box_1_AnimEvent", 0.1f);
}

void PhoneCallOver (string &in asTimer)
{
	SetLampLit("phone_box_2", false, true);
}
//END PHONE RINGING//
										
