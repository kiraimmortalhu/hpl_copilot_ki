//CHILD EVENT HANDLER//
void ChildEventHandler (string &in asParent, string &in asChild, int alState)
{
	if (asChild == "Child1Trigger")
	{
		AddDebugMessage("Child 1 Triggered", false);
		SetManPigType("Child1*", "Freddy");
		SetEnemyMoveType("Child1*", "RunBiped");
		SetEntityActive("Child1*", true);
		AddEnemyPatrolNode("Child1*", "PathNodeArea_1", 0.0f, "", false);
		AddEnemyPatrolNode("Child1*", "PathNodeArea_4", 0.0f, "", false);
		AddTimer("ReactBreath", 1.5f, "TimerEndCalls");
		AddTimer("MachineHall1EventMusicTimer", 4.0f, "TimerEndCalls");
		return;
	}
	else if (asChild == "Child1KillTrigger")
	{
		FadeEnemyToSmoke("Child1", false);
		return;
	}
	else if (asChild == "Child1aKillTrigger")
	{
		FadeEnemyToSmoke("Child1a", false);
		return;
	}
	else if (asChild == "Child2Trigger")
	{
		AddDebugMessage("Child 2 Triggered", false);
		SetEntityActive("Child2", true);
		SetEntityActive("Child2a", true);
		VOPlayer("Player", "Child_above_main_cellar_VO", 1);
		AddEnemyPatrolNode("Child2", "PathNodeArea_7", 0.0f, "", false);
		AddEnemyPatrolNode("Child2", "PathNodeArea_9", 0.0f, "", false);
		AddEnemyPatrolNode("Child2a", "PathNodeArea_7", 0.0f, "", false);
		AddEnemyPatrolNode("Child2a", "PathNodeArea_9", 0.0f, "", false);

		return;
	}
	else if (asChild == "Child2KillTrigger")
	{
		FadeEnemyToSmoke("Child2", false);
		FadeEnemyToSmoke("Child2a", false);
		return;
	}
		else if (asChild == "TwinTrigger")
	{
		AddDebugMessage("Twins Triggered", false);
		AddEnemyPatrolNode("Child3", "PathNodeArea_14", 0.0f, "", false);
		AddEnemyPatrolNode("Child4", "PathNodeArea_14", 0.0f, "", false);
		PlayMusic("music_cellar_children_walkway.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "TwinKillTrigger" && asParent == "Child3")
	{
		FadeEnemyToSmoke("Child3", false);
		return;
	}
	else if (asChild == "TwinKillTrigger" && asParent == "Child4")
	{
		FadeEnemyToSmoke("Child4", false);
		return;
	}
}
//END CHILD EVENT HANDLER//

