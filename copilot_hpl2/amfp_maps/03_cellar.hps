//RANDOMISED SOUND CUE PLAYER//
void RandSoundCues(string &in asTimer)
{
	string[] sCueSources = {"RandCryingSource_1", "RandCryingSource_2", "RandCryingSource_3", "RandCryingSource_4", "RandCryingSource_5", "RandCryingSource_6", "RandCryingSource_7", 
						   "RandCryingSource_8", "RandCryingSource_9", "RandCryingSource_10", "RandCryingSource_11", "RandCryingSource_12"};
	asTimer = sCueSources[RandInt (0, 11)];
	PlaySoundAtEntity(asTimer, "spooky_childcry.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(15.0f, 20.0f), "RandSoundCues");
}

void RandDustSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Sound_DustSource_1", "Sound_DustSource_2", "Sound_DustSource_3", "Sound_DustSource_4", "Sound_DustSource_5", "Sound_DustSource_6"};
	asTimer = sCueSources[RandInt (0, 5)];
	PlaySoundAtEntity(asTimer, "afx_events_tunnels_dust_debris.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Dust Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(6.0f, 10.0f), "RandDustSoundCues");
}

void RandOfficeSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Sound_OfficeRand_1", "Sound_OfficeRand_2", "Sound_OfficeRand_3"};
	asTimer = sCueSources[RandInt (0, 2)];
	PlaySoundAtEntity(asTimer, "afx_events_mansion_hallwaycreak.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Office Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandOfficeSoundCues");
}

void RandOffice2SoundCues(string &in asTimer)
{
	string[] sCueSources = {"Sound_OfficeRand_1", "Sound_OfficeRand_2", "Sound_OfficeRand_3"};
	asTimer = sCueSources[RandInt (0, 2)];
	PlaySoundAtEntity(asTimer, "afx_spooky_hifrequencymoan_mansion.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Office Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(15.0f, 20.0f), "RandOffice2SoundCues");
}

void RandEnvSoundCues(string &in asTimer)
{
	string[] sCueSources = {"Player"};
	asTimer = sCueSources[0];
	PlaySoundAtEntity(asTimer, "afx_events_cellar_rand_env.snt", asTimer, 0, false);
	AddDebugMessage("Random Sound Cue Function Selected Environmental Sound Source: "+asTimer, false);
	AddTimer(asTimer, RandFloat(10.0f, 15.0f), "RandEnvSoundCues");
}
//END RANDOMISED SOUND CUE PLAYER//

//SOUND OPTIMISATIONS//
void soundopt (string &in asParent, string &in asChild, int alState)
{
//FIRST HALLWAY DUST
	if (asChild == "soundopt_firsthallway_start_1"|| asChild == "soundopt_firsthallway_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_firsthallway_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_firsthallway_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_firsthallway_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_firsthallway_stop_2", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomDustSoundCuePlayer", 3.0f, "RandDustSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Hallway Dust Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_firsthallway_stop_1"|| asChild == "soundopt_firsthallway_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_firsthallway_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_firsthallway_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_firsthallway_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_firsthallway_start_2", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("Sound_DustSource_1");
	RemoveTimer("Sound_DustSource_2");
	RemoveTimer("Sound_DustSource_3");
	RemoveTimer("Sound_DustSource_4");
	RemoveTimer("Sound_DustSource_5");
	RemoveTimer("RandDustSoundCues");
	RemoveTimer("InitRandomDustSoundCuePlayer");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Hallway Dust Sounds", true);
	}
//BREAK
//CELLAR HALL OPT
	if (asChild == "soundopt_cellarhall_start_1"|| asChild == "soundopt_cellarhall_start_2"|| asChild == "soundopt_cellarhall_start_3"|| asChild == "soundopt_cellarhall_start_4")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_start_2");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_start_3");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_start_4");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_cellarhall_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_stop_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_stop_3", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_stop_4", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomEnvSoundCuePlayer", 3.0f, "RandEnvSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Cellar Hall Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_cellarhall_stop_1"|| asChild == "soundopt_cellarhall_stop_2"|| asChild == "soundopt_cellarhall_stop_3"|| asChild == "soundopt_cellarhall_stop_4")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_stop_2");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_stop_3");
	RemoveEntityCollideCallback("Player", "soundopt_cellarhall_stop_4");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_2", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_3", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_cellarhall_start_4", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("Player");
	RemoveTimer("RandEnvSoundCues");
	RemoveTimer("InitRandomEnvSoundCuePlayer");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Cellar Hall Sounds", true);
	}
//BREAK
//OFFICE SOUNDS
	if (asChild == "soundopt_office_start_1")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_office_start_1");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_office_stop_1", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomOfficeSoundCuePlayer", 4.0f, "RandOfficeSoundCues");
	AddTimer("InitRandomOffice2SoundCuePlayer", 6.0f, "RandOffice2SoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Office Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_office_stop_1")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_office_stop_1");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_office_start_1", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("Sound_OfficeRand_1");
	RemoveTimer("Sound_OfficeRand_2");
	RemoveTimer("Sound_OfficeRand_3");
	RemoveTimer("InitRandomOfficeSoundCuePlayer");
	RemoveTimer("RandOfficeSoundCues");
	RemoveTimer("InitRandomOffice2SoundCuePlayer");
	RemoveTimer("RandOffice2SoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Office Sounds", true);
	}
//BREAK
//CRYING OPT
	if (asChild == "soundopt_crying_start_1"|| asChild == "soundopt_crying_start_2")
	{
	//REMOVE START TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_crying_start_1");
	RemoveEntityCollideCallback("Player", "soundopt_crying_start_2");
	
	//ADD STOP TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_crying_stop_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_crying_stop_2", "soundopt", true, 1);
	
	//START SOUND TIMER
	AddTimer("InitRandomSoundCuePlayer", 4.0f, "RandSoundCues");
	
	//DEBUG MESSAGE
	AddDebugMessage("Start Crying Sounds", true);
	}
//BREAK
	if (asChild == "soundopt_crying_stop_1"|| asChild == "soundopt_crying_stop_2")
	{
	//REMOVE STOP TRIGGERS
	RemoveEntityCollideCallback("Player", "soundopt_crying_stop_1");
	RemoveEntityCollideCallback("Player", "soundopt_crying_stop_2");
	
	//ADD START TRIGGERS
	AddEntityCollideCallback("Player", "soundopt_crying_start_1", "soundopt", true, 1);
	AddEntityCollideCallback("Player", "soundopt_crying_start_2", "soundopt", true, 1);
	
	//REMOVE SOUNDS
	RemoveTimer("RandSoundCues");
	RemoveTimer("InitRandomSoundCuePlayer");
	RemoveTimer("RandCryingSource_1");
	RemoveTimer("RandCryingSource_2");
	RemoveTimer("RandCryingSource_3");
	RemoveTimer("RandCryingSource_4");
	RemoveTimer("RandCryingSource_5");
	RemoveTimer("RandCryingSource_6");
	RemoveTimer("RandCryingSource_7");
	RemoveTimer("RandCryingSource_8");
	RemoveTimer("RandCryingSource_9");
	RemoveTimer("RandCryingSource_10");
	RemoveTimer("RandCryingSource_11");
	RemoveTimer("RandCryingSource_12");
	
	//DEBUG MESSAGE
	AddDebugMessage("Stop Crying Sounds", true);
	}
//BREAK

//SOUND PRELOADS
//TREMOR 1
	if (asChild == "soundopt_tremor1_preload")
	{
	
	//DEBUG MESSAGE
	AddDebugMessage("TREMOR 1 PRELOADED", true);
	}
	
//TREMOR 2
	if (asChild == "soundopt_tremor2_preload")
	{
	
	//DEBUG MESSAGE
	AddDebugMessage("TREMOR 2 PRELOADED", true);
	}
	
//MACHINE QUAKE
	if (asChild == "soundopt_machinequake_preload")
	{
	
	//DEBUG MESSAGE
	AddDebugMessage("MACHINE QUAKE PRELOADED", true);
	}
	
//TREMOR 3
	if (asChild == "soundopt_tremor3_preload")
	{
	
	//DEBUG MESSAGE
	AddDebugMessage("TREMOR 3 PRELOADED", true);
	}

//SMALL MACHINE SOUND PRELOAD
	if (asChild == "soundopt_smallmachine_preload")
	{

	//DEBUG MESSAGE
	AddDebugMessage("SMALL MACHINE SOUNDS PRELOADED", true);
	}
}
//END SOUND OPTIMISATIONS

//MUSIC PLAYER//
void MusicPlayer (string &in asParent, string &in asChild, int alState)																			//!! REWORK
{
	if (asChild == "BarrelRampMusicTrigger")
	{
		//StopMusic(1.0f, 2);
		//SET CHECKPOINT #2//
		CheckPoint("CP02_RampRoom", "CheckpointStart_1", "", "", "", false);
		AddTimer("RampPuzzleMusic", 0.5f, "TimerEndCalls");
	return;
	}
	else if (asChild == "EntranceMusicTrigger")
	{
		PlayMusic("music_cellar_entrance.ogg", false, 1.0f, 0.0f, 0, false);
	}
	else if (asChild == "EntranceDoorSting")
	{
		PlayMusic("ambient_threat.ogg", false, 1.0f, 0.0f, 0, false);
	}
	else if (asChild == "CellarPianoTrigger")
	{
		PlayMusic("cellar_climb.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "SewerPigAmbienceTrigger")
	{
		PlayMusic("scary_pig_ambience.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "KillingRoomMusicTrigger")
	{
		PlayMusic("Killing_room.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "SpraylockOpeningMusic")
	{
		PlayMusic("ghostly_theme.ogg", false, 1.0f, 0.0f, 0, false);
		return;
	}
	else if (asChild == "OfficeMusicTrigger")
	{
		StopMusic(1.0f, 2);
		PlayMusic("music_cellar_offices.ogg", true, 1.0f, 1.0f, 1, false);
		return;
	}
}
//END MUSIC PLAYER//

