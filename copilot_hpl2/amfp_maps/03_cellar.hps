//AMBIENT SOUNDTRACK PLAYER//
void MapAmbienceAreas (string &in asParent, string &in asChild, int alState)																					//!! ADD NEW AMBIENCE
{
	if (asChild == "AMBStartHall")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("generaldroneA", "amb_cellar_general_drone.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("generaldroneA", 1.0f);
			return;
		}
	}
//BREAK//
	else if (asChild == "AMBMachineRoom")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("machinedrone", "amb_cellar_machine_room_drone.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("machinedrone", 1.0f);
			return;
		}
	}
//BREAK//	
	else if (asChild == "AMBCellarApproach_1")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("generaldroneB", "amb_cellar_general_drone.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("generaldroneB", 1.0f);
			return;
		}
	}
//BREAK//	
	else if (asChild == "AMBCellarApproach_2")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("generaldroneC", "amb_cellar_general_drone.snt", "Player", 1.0f, true);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("generaldroneC", 1.0f);
			return;
		}
	}
//BREAK//	
	else if (asChild == "AMBTransRoom")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("TransRoom", "amb_mans_transition_room.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("TransRoom", 1.0f);
			return;
		}
	}
	//BREAK//	
	else if (asChild == "AMBOffices")
	{
		if (alState == 1)
		{
			PlaySoundAtEntity("Offices1", "amb_factory_office_tight.snt", "Player", 1.0f, true);
			SetLocalVarString("CurrentAmbientTrack", asChild);
			return;
		}
		else if (alState == -1) 
		{
			StopSound("Offices1", 1.0f);
			return;
		}
	}
}
