// GENERIC TIMERS //

void TimerSetLightVisible(string &in asTimer)
{
	SetLightVisible(asTimer, true);
}

void TimerSetLightInvisible(string &in asTimer)
{
	SetLightVisible(asTimer, false);
}

// END GENERIC TIMERS //

void TimerSprayLockDoorOpen(string &in asTimer)
{
	if(asTimer == "Door2Open" )
	{
		int lNum = GetGlobalVarInt("SprayLock2OpenNum");
		
		float fMul = 4.0f;
		if(lNum < 3) fMul = 0.5f;

		AddPropForce("spraylock_door_2", 0.0f, 0.0f, -50.0f * fMul, "local");

		if(lNum < 60)
		{
			SetGlobalVarInt("SprayLock2OpenNum", lNum+1);
			AddTimer("Door2Open", 1.5f / 60.0f, "TimerSprayLockDoorOpen");
		}
	}
}

//TIMER END CALLS/////////ALL TIMERS CALL THIS CONTAINER FUNCTION, IF BLOCKS DETERMINE OUTPUT//
void TimerEndCalls(string &in asTimer)
{	
	//SPRAYLOCK EVENTS//
	if (asTimer == "SpraylockDoor1AnimationPadding")
	{
		PlayPropAnimation("spraylock_door_1", "open", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_hinge_open.snt", "spraylock_door1source", 0.0f, false);
		
		SetSwingDoorOpenAmount("spraylock_door_1", 1.0f, 3.0f, true);
		return;
	}
	else if (asTimer == "SpraylockDoor1ClosingAnimationPadding")
	{
		PlayPropAnimation("spraylock_door_1", "closing", 0.0f, false, "");
		PlaySoundAtEntity("", "spraylock_door_mech_unlock_INSIDE.snt", "spraylock_door1source", 0.0f, false);
		return;
	}
	else if (asTimer == "SpraylockPowerGaugesOffToOnTimer")
	{
		PlayPropAnimation("spraylock_power_gauges", "on", 0.2f, true, "");
		return;
	}
	else if (asTimer == "SpraylockDoor2AnimationPadding")
	{
		PlaySoundAtEntity("", "spraylock_door_hinge_open_INSIDE.snt", "spraylock_door2source", 0.0f, false);
		PlaySoundAtEntity("", "spraylock_valve_lock_inside.snt", "spraylock_valve_inside_2", 0.0f, false);
		
		//SetSwingDoorOpenAmount("spraylock_door_2", 1.0f, 3.0f, true);
		SetGlobalVarInt("SprayLock2OpenNum", 0);
		AddTimer("Door2Open", 1.5f / 60.0f, "TimerSprayLockDoorOpen");

		return;
	}
	else if (asTimer == "SpraylockGaugesStartUpPadding")
	{
		PlayPropAnimation("spraylock_gauges", "offtoon", 0.0f, false, "");
	}
	else if (asTimer == "SpraylockSprayGaugesAnimationPadding")
	{
		PlayPropAnimation("spraylock_gauges", "on", 0.0f, true, "");
		AddTimer("SpraylockSprayGaugesTimeout", 6.0f, "TimerEndCalls");
		return;
	}
	else if (asTimer == "SpraylockSprayGaugesTimeout")
	{
		PlayPropAnimation("spraylock_gauges", "ontooff", 0.0f, false, "");
		return;
	}
	else if (asTimer == "SpraylockPowerSwitchSparkLightTimer")
	{
		SetLightVisible("spraylock_spark_light", false);
		return;
	}
	else if (asTimer == "SpraylockRailingActivationAnimationTimer")
	{
		PlayPropAnimation("spraylock_railing", "on", 0.0f, true, "");
		return;
	}
	else if (asTimer == "SpraylockRailingDeactivationAnimationTimer")
	{
		PlayPropAnimation("spraylock_railing", "off", 0.0f, true, "");
		SetEntityActive("spraylock_railing_collision", false);
		return;
	}
	else if (asTimer == "SpraylockInitLoopTimer")
	{
		AddDebugMessage("Spraylock Engines Starting Up", false);
		PlaySoundAtEntity("sl_turbine_loop", "spraylock_turbine_loop.snt", "spraylock_center_sound", 0.0f, true);
		PlaySoundAtEntity("sl_engine_loop", "spraylock_engine_loop.snt", "spraylock_center_sound", 0.0f, true);
		return;
	}
	else if (asTimer == "SpraylockSprayPadding")
	{
		AddDebugMessage("Spraylock Particles Activated", false);
		PlaySoundAtEntity("sl_spray", "spraylock_mainspray.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("sl_drips", "amb_spraylock_drips.snt", "spraylock_spray_switch_gauges_1", 0.0f, false);
		SetParticleSystemActive("spraylock_spray1", true);
		SetParticleSystemActive("spraylock_spray2", true);
		SetParticleSystemActive("spraylock_spray3", true);
		SetParticleSystemActive("spraylock_spray4", true);
		SetParticleSystemActive("spraylock_spray5", true);
		SetParticleSystemActive("spraylock_spray6", true);
		SetParticleSystemActive("spraylock_risingmist", true);
		SetPlayerInfection(0.0f);
		return;
	}
	else if (asTimer == "SpraylockSprayToEndTimer")
	{
		AddDebugMessage("Spraylock Engines Spinning Down", false);
		AddTimer("SpraylockInteriorValveAnimationTimer", 1.9f, "TimerEndCalls");
		PlayPropAnimation("spraylock_gauge_inside_2", "offtoon", 2.0f, false, "");
		SetLocalVarInt("spraylocksequenced", 1);
		return;
	}
	else if (asTimer == "SpraylockEngineOnAnimationBuffer")
	{
		PlayPropAnimation("spraylock_engines", "on", 0.25f, true, "");
		return;
	}
	else if (asTimer == "SpraylockInteriorValveAnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_inside_2", "on", 0.25f, true, "");
		//UNSTICK INTERIOR VALVE 2//
		SetWheelStuckState("spraylock_valve_inside_2", 0, false);
		PlaySoundAtEntity("sl_hiss_3", "spraylock_gauge_hiss_3.snt", "spraylock_hiss_inside_2", 0.0f, false);
		return;
	}
	else if (asTimer == "SpraylockCabinetGauge1AnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_power1", "on", 0.25f, true, "");
		return;
	}
	else if (asTimer == "SpraylockCabinetGauge2AnimationTimer")
	{
		PlayPropAnimation("spraylock_gauge_power2", "on", 0.25f, true, "");
		return;
	}
	//END SPRAYLOCK EVENTS//
	
	//RETURN TO NORMAL//
	else if (asTimer == "ReturnToNormal")
	{
	FadeImageTrailTo(0.0f, 2.0f);
	FadeRadialBlurTo(0.0f, 2.0f);
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	StopPlayerLookAt();
	//MandusReactionPlayer("Breath", 0.25f);
	}
	///END RETURN TO NORMAL//
	
	//INFECTION//
	else if (asTimer == "Infection_Timer")
	{
		//move to place that triggers infection_timer
	}
	//END INFECTION//
	
	//NORMAL WALK SPEED//
	else if (asTimer == "MoveSpeedNormal")
	{
	SetPlayerMoveSpeedMul(1.0f);
	SetPlayerLookSpeedMul(1.0f);
	SetPlayerRunSpeedMul(1.0f);
	}
	//END NORMAL WALK SPEED//
	
	//React Sounds//
	if (asTimer == "ReactBreathSlow")
	{
		PlaySoundAtEntity("ReactBreathSlow", "react_breath_slow.snt", "Player", 0.0f, false);
		return;
	}
	
	if (asTimer == "ReactBreath")
	{
		PlaySoundAtEntity("ReactBreath", "react_breath.snt", "Player", 0.0f, false);
		return;
	}
	
	if (asTimer == "ReactScared")
	{
		PlaySoundAtEntity("ReactScared", "react_scare.snt", "Player", 0.0f, false);
		return;
	}
	//END React Sounds//
	
	//PIG NOISE POST SMASH
	if (asTimer == "PigNoise_PostSmash")
	{
		PlaySoundAtEntity("PigNoise", "afx_spooky_monster_noises_tight.snt", "PigNoiseSource", 0.0f, false);
		return;
	}
	//END PIG NOISE POST SMASH//
	
	//PIG NOISE PART 2//
		if (asTimer == "PigNoise_Part2")
	{
		PlaySoundAtEntity("PigNoise2", "afx_spooky_monster_noises_tight.snt", "PigNoiseSource_1", 0.0f, false);
		return;
	}
	//END PIG NOISE PART 2//
	
	//Voiceover Timer//
	if (asTimer == "InfectionVO")
	{
		AddEffectVoice2("vo_cellar_01_trigger_mandus_07.ogg","","Voice", "vo_cellar_01_trigger_mandus_07_01", 1.5, "vo_cellar_01_trigger_mandus_07_02", 8.5, false, "", 0, 0);
		return;
	}
	
	//Infection Music//
	if (asTimer == "InfectionMusic")
	{
		PlayMusic("music_cellar_infection_event", false, 1.0f, 0.1f, 7, true);
		return;
	}
	
	//ENTRANCE HALL FINAL LIGHT//
	if (asTimer == "KillFinalEntranceLight")
	{
		SetLampLit("corridor01_lamp_3", false, false);
		SetLampLit("corridor01_lamp_4", false, false);
		return;
	}
	//END ENTRANCE HALL FINAL LIGHT//
	
	//CELLAR 1 EVENT 1 TIMER//
	else if (asTimer == "steamburst1")
	{
		SetParticleSystemActive("ExplodingValveSmallSteam1", true);
		return;
	}
	else if (asTimer == "steamburst2")
	{
		SetParticleSystemActive("ExplodingValveSmallSteam2", true);
		return;
	}
	else if (asTimer == "tinkertimer")
	{
		SetPropStaticPhysics("ExplodingValveBroken", false);
		SetPropStaticPhysics("ExplodingValve", false);
		SetEntityActive("ExplodingValveBroken", true);
		SetEntityActive("ExplodingValve", false);
		SetEntityActive("PipeValveTJoint", true);
		SetEntityActive("PipeValveFull", false);
		AddPropForce("ExplodingValveBroken", 7000.0f, 600.0f, 0.0f, "local");
		SetParticleSystemActive("ExplodingValveSteam", true);
		PlaySoundAtEntity("exploding_valve_steam_sound", "afx_cellar_steam_loop_2.snt", "ExplodingValveSteamSource", 0.0f, true);
		PlaySoundAtEntity("exploding_valve_sound", "afx_cellar_valvepop.snt", "ExplodingValveSteamSource", 0.0f, false);
		PlaySoundAtEntity("exploding_valve_slapback_sound", "afx_cellar_valvepop_slapback.snt", "Player", 0.0f, false);
		PlaySoundAtEntity("exploding_valve_steam_loop", "afx_cellar_valvepop_steamloop.snt", "ExplodingValveSteamSource", 0.0f, true);
		AddPropImpulse("cellar01_lamp_*", 0.2f, 0.0f, 0.4f, "local");
		AddTimer("ReactBreath", 4.0f, "TimerEndCalls");
		//AddPropImpulse("cellar02_lamp_off_*", 0.2f, 0.0f, 0.4f, "local");
		AddPropForce("shovel_2", 0.0f, 0.0f, 1000.0f, "world");
		return;
	}
	else if (asTimer == "pigsmash1fx")	
	{
	StartScreenShake(0.03f, 0.905f, 0.0f, 0.75f);
	AddTimer("flickerreturntonorm_1", 4.0f, "TimerEndCalls");
	}	
	else if (asTimer == "MachineHall1EventMusicTimer")
	{
	PlayMusic("music_cellar_post_pigsmash1.ogg", true, 0.5f, 0.65f, 2, false);
	}
	//END CELLAR 1 EVENT 1//
	
	//RAMP PUZZLE MUSIC//
	//else if (asTimer == "RampPuzzleMusic")
	//{
	//PlayMusic("music_cellar_ramp_puzzle.ogg", false, 1.0f, 0.5f, 2, false);
	//}
	//END RAMP PUZZLE MUSIC//

	//RETURN CELLAR 1 LIGHTS TO NORMAL A & B//
	else if (asTimer == "flickerreturntonorm_1")
	{
		SetLampLit("cellar01_lamp_17", false, false);
		SetLampFlickerActive("cellar01_lamp_17", false);
		AddTimer("flickerreturntonorm_2", 4.0f, "TimerEndCalls");
		return;
	}
	else if (asTimer == "flickerreturntonorm_2")
	{
		SetLampLit("cellar01_lamp_15", false, false);
		SetLampFlickerActive("cellar01_lamp_15", false);	
		SetLampLit("cellar01_lamp_12", false, false);
		SetLampFlickerActive("cellar01_lamp_12", false);	
		return;
	}
	//END LIGHT RETURNS//

	//TINKER EXPLOSION//
	else if (asTimer == "tinkertimer2")
	{
		CreateParticleSystemAtEntity("Cellar2Puff", "ps_dust_pig_machine_damage.ps", "Cellar2ParticleSource", false);
		AddPropForce("bag01_10", 0.0f, 800.0f, 0.0f, "world");
		AddPropForce("bag02_24", 0.0f, 1000.0f, 0.0f, "world");
		AddPropForce("bag_small_29", -500.0f, 300.0f, 500.0f, "world");
		AddPropForce("bag_small_30", -1000.0f, 0.0f, 0.0f, "world");
		AddPropForce("bag_small_31", -800.0f, 500.0f, 500.0f, "world");
		AddPropImpulse("cellar01_lamp_*", 3.0f, 0.0f, 5.0f, "local");
		return;
	}
	//END TINKER EXPLOSION//
	
	//PIG SMASH 3 SECOND SCREENSHAKE//
	else if (asTimer == "pigsmash3_screenshake2")
	{
	StartScreenShake (0.1f, 2.0f, 0.0f, 0.5f);
	StopMusic(1.5f, 5);
	}
	//END PIG SMASH 3 SECOND SCREENSHAKE//
	
	//STOP CELLAR LIGHT FLICKERING//
	else if (asTimer == "endflickercellarlamps")
	{
		AddDebugMessage("Lamps Should Stop Flickering and Turn Off Now!", false);
		SetLampFlickerActive("cellar01_lamp_*", false);	
		SetLampLit("cellar01_lamp_*", true, false);
		SetLampLit("cellar01_lamp_*", false, false);
		return;
	}
	//END STOP FLICKERING//
		
	//SIDE ROOM FUSE MACHINE PARTICLE CHAIN//
	else if (asTimer == "Pipeline1ParticleTimerA")
	{
		AddDebugMessage("Particle Timer A Activated", false);
		SetParticleSystemActive("Pipeline1Steam_2", true);
		PlaySoundAtEntity("P1S2", "afx_cellar_steam_loop_2.snt", "Pipeline1Steam2Source", 0.5f, true);
		return;
	}
	else if (asTimer == "Pipeline1ParticleTimerB")
	{
		AddDebugMessage("Particle Timer B Activated", false);
		SetParticleSystemActive("Pipeline1Steam_3", true);
		PlaySoundAtEntity("P1S3", "afx_cellar_steam_loop_2.snt", "Pipeline1Steam3Source", 0.5f, true);
		SetParticleSystemActive("Pipeline1Steam_4", true);
		PlaySoundAtEntity("P1S4", "afx_cellar_steam_loop_2.snt", "Pipeline1Steam4Source", 0.5f, true);
		SetParticleSystemActive("Pipeline1Steam_5", true);
		PlaySoundAtEntity("P1S5", "afx_cellar_steam_loop_2.snt", "Pipeline1Steam5Source", 0.5f, true);
		PlaySoundAtEntity("P1S6", "afx_cellar_steam_loop.snt", "Pipeline1Steam6Source", 0.5f, true);
		return;
	}
	//END SIDE ROOM FUSE MACHINE PARTICLE CHAIN//
	
	//CATWALK FUSE MACHINE PARTICLE CHAIN//
	else if (asTimer == "Pipeline3ParticleTimerA")
	{
		AddDebugMessage("Particle Timer A Activated", false);
		SetParticleSystemActive("Pipeline3Steam_2", true);
		PlaySoundAtEntity("P3S2", "afx_cellar_steam_loop_2.snt", "Pipeline3Steam2Source", 0.5f, true);
		SetParticleSystemActive("Pipeline3Steam_5", true);
		PlaySoundAtEntity("P3S5", "afx_cellar_steam_loop_2.snt", "Pipeline3Steam5Source", 0.5f, true);
		return;
	}
	else if (asTimer == "Pipeline3ParticleTimerB")
	{
		AddDebugMessage("Particle Timer B Activated", false);
		SetParticleSystemActive("Pipeline3Steam_3", true);
		PlaySoundAtEntity("P3S3", "afx_cellar_steam_loop_2.snt", "Pipeline3Steam3Source", 0.5f, true);
		SetParticleSystemActive("Pipeline3Steam_4", true);
		PlaySoundAtEntity("P3S4", "afx_cellar_steam_loop.snt", "Pipeline3Steam4Source", 0.5f, true);
		return;
	}
	
	else if (asTimer == "postsmash2music")
	{
		PlayMusic("music_cellar_postpigsmash2", true, 1.0f, 0.0f, 2, false);
		return;
	}
	//END CATWALK FUSE MACHINE PARTICLE CHAIN//
	
	//QUAKE EVENT TIMERS//
	else if (asTimer == "QuakeStartBuffer")
	{
		AddDebugMessage("Quake Started", false);
		StartScreenShake (0.1f, 2.2f, 0.0f, 0.968f);
		AddTimer("ReactBreath", 3.25f, "TimerEndCalls");
		AddTimer("endflickercellarlamps", 2.0f, "TimerEndCalls");
		SetLampLit("cellar01_lamp_*", true, false);
		SetLampFlickerActive("cellar01_lamp_*", true);
		FadeLightTo("SpotLight_30", 0,0,0,0,-1, 1);
		FadeLightTo("SpotLight_31", 0,0,0,0,-1, 1);
		SetPlayerMoveSpeedMul(0.5f);
		return;
	}
	else if (asTimer == "QuakeEnd")
	{
		SetPlayerMoveSpeedMul(1.0f);
		return;
	}
	else if (asTimer == "PostQuakeMusic")
	{
		StopMusic(0.5f, 5);
		PlayMusic("music_cellar_post_quake.ogg", false, 1.0f, 0.0f, 2, false);
		return;
	}
	
	//END QUAKE EVENT TIMERS//
}

//----------------------------
//BARRLES AND PULLING THE BLOCK THING//
//----------------------------

//-------------------------------------------
void CollideBarrelSliderPulled(string &in asParent, string &in asChild, int alState)
{
	PlaySoundAtEntity("slide", "afx_cellar_climbupramp_creak_02.snt", asParent, 0, false);
	SetPropStaticPhysics(asParent, true);
	
	TimerPushBeam("Wiggle_Beam_Fwd");
}

void TimerPushBeam(string &in asTimer)
{
	AddDebugMessage("Pulled!!", false);
	
	int lDir = asTimer == "Wiggle_Beam_Fwd" ? 1 : -1;
	string sNextTimer = asTimer == "Wiggle_Beam_Fwd" ? "Wiggle_Beam_Bwd" : "Wiggle_Beam_Fwd";
	
	AddPropImpulse("BarrelBeamLower_1", 0, -1, lDir, "World");
	AddTimer(sNextTimer, 0.1, "TimerPushBeam");
}

//-------------------------------------------

//----------------------------
//ENCOUNTER HELPERS//
//----------------------------

//-------------------------------------------

void LanternFlicker(float afTime)
{
	SetLanternFlickerActive(true);
	
	AddTimer("LanternFlickerOff", afTime, "TimerLanternFlickerOff");
}

void TimerLanternFlickerOff(string &in asTimer)
{
	SetLanternFlickerActive(false);
}

//-------------------------------------------

void StartLampFlicker(string &in asLamp)
{
	AddTimer(asLamp, RandFloat(0.0f, 0.3f), "TimerLampFlickerOff");
}

void StopLampFlicker(string &in asLamp)
{
	RemoveTimer(asLamp);
	SetLampLit(asLamp, true, false);
}

void TimerLampFlickerOff(string &in asLamp)
{
	SetLampLit(asLamp, false, false);
	AddTimer(asLamp, RandFloat(0.1f, 0.2f), "TimerLampFlickerOn");
}

void TimerLampFlickerOn(string &in asLamp)
{
	SetLampLit(asLamp, true, false);
	AddTimer(asLamp, RandFloat(0.05f, 0.15f), "TimerLampFlickerOff");
}

//-------------------------------------------

//----------------------------
//END ENCOUNTER HELPERS//
//----------------------------

//--------------------------------------------
//PIG ENCOUNTER
//--------------------------------------------
void EnterBehindBeamDoor(string &in asParent, string &in asChild, int alState)
{
	OpenPigDoor("cellar_wood01_4", false);
	SetEntityInteractionDisabled("DoorBarricade", false);
	
	AddEntityCollideCallback("Player", "AreaStartPigEncounter", "EnterStartPigEncounter", true, 1);
	AddEntityCollideCallback("Player", "AreaStartPigEncounter2", "EnterStartPigEncounter2", true, 1);
	AddEntityCollideCallback("Player", "AreaEndLoweFloorPigEncounter", "EnterEndLoweFloorPigEncounter", true, 1);
	
	PlaySoundAtEntity("noise", "afx_wretch_run_subroom_1.snt", "AreaStartPigEncounter2", 0, false);
	
	LanternFlicker(3);
}

//--------------------------------------------

void EnterStartPigEncounter(string &in asParent, string &in asChild, int alState)
{
	AddEntityCollideCallback("wretch_1", "AreaPigDisappear", "EnterPigDisappear", true, 1);
	
	SetEntityActive("wretch_1", true);
	AddEnemyPatrolNode("wretch_1", "PathNodeArea_27", 0.1, "", false);
	
	//Subtle Piggie Run Off Noises
	PlaySoundAtEntity("PiggieRun", "afx_cellar_thomaspig_01", "Player", 0.0f, false);
}

//--------------------------------------------

void EnterStartPigEncounter2(string &in asParent, string &in asChild, int alState)
{
	AddEntityCollideCallback("wretch_2", "AreaPigDisappear2", "EnterPigDisappear", true, 1);
	
	SetEntityActive("wretch_2", true);
	AddEnemyPatrolNode("wretch_2", "PathNodeArea_32", 0.1, "", false);
	
	StartLampFlicker("cellar01_lamp_12");
	StartLampFlicker("cellar01_lamp_3");
	StartLampFlicker("cellar01_lamp_1");
	
	//Subtle Piggie Noises
	PlaySoundAtEntity("PiggieFumble", "afx_cellar_thomaspig_02", "Player", 0.0f, false);
}

//--------------------------------------------

///////////////////////////////////
//These makes sure the events are only triggered the right way.
//Also sets up final encounter on the way back.
void EnterEndLoweFloorPigEncounter(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive("wretch_1", false);
	SetEntityActive("wretch_2", false);
	
	RemoveEntityCollideCallback("Player", "AreaStartPigEncounter");
	RemoveEntityCollideCallback("Player", "AreaStartPigEncounter2");

	AddEntityCollideCallback("Player", "AreaStartPigEncounter3", "EnterStartPigEncounter3", true, 1);
	AddEntityCollideCallback("Player", "AreaStartPigEncounter3StartMove", "EnterStartPigEncounter3StartMove", true, 1);
	AddEntityCollideCallback("Player", "AreaStartPigEncounter3StartMove2", "EnterStartPigEncounter3StartMove", true, 1);
}

//--------------------------------------------

void EnterStartPigEncounter3(string &in asParent, string &in asChild, int alState)
{
	AddEntityCollideCallback("wretch_3", "AreaPigDisappear3", "EnterPigDisappear", true, 1);
	
	SetEntityActive("wretch_3", true);
	
	AddTimer("Pig3RunsOff", 8, "TimerPig3RunsOff");
	
	StartLampFlicker("cellar_gaslamp01_1");
	StartLampFlicker("cellar01_lamp_17");
	
	LanternFlicker(4);
}

void EnterStartPigEncounter3StartMove(string &in asParent, string &in asChild, int alState)
{
	ClearEnemyPatrolNodes("wretch_3");
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_35", 0.1, "", false);
	PlaySoundAtEntity("PiggieRun_2", "afx_cellar_thomaspig_03", "Player", 0.0f, false);
	RemoveTimer("Pig3RunsOff");
}

void TimerPig3RunsOff(const string &in asTimer)
{
	ClearEnemyPatrolNodes("wretch_3");
	AddEnemyPatrolNode("wretch_3", "PathNodeArea_35", 0.1, "", false);
	
	RemoveEntityCollideCallback("Player", "AreaStartPigEncounter3StartMove");
	RemoveEntityCollideCallback("Player", "AreaStartPigEncounter3StartMove2");
}


//--------------------------------------------

void EnterPigDisappear(string &in asParent, string &in asChild, int alState)
{
	SetEntityActive(asParent, false);
	
	if(asParent == "wretch_2")
	{
		AddTimer("Pig2Flicker0ff", 3, "TimerPig2Flicker0ff");
		AddTimer("SlamDoor", 2, "TimerPig2OutTheDoor");
	}
	if(asParent == "wretch_3")
	{
		AddTimer("Pig3Flicker0ff", 1.5f, "TimerPig3Flicker0ff");
	}
}

void TimerPig2Flicker0ff(string &in asTimer)
{
	StopLampFlicker("cellar01_lamp_12");
	StopLampFlicker("cellar01_lamp_3");
	StopLampFlicker("cellar01_lamp_1");
}

void TimerPig3Flicker0ff(string &in asTimer)
{
	StopLampFlicker("cellar_gaslamp01_1");
	StopLampFlicker("cellar01_lamp_17");
}

//--------------------------------------------

void OpenPigDoor(const string &in asDoorName, bool abNegForce)
{
	SetSwingDoorDisableAutoClose(asDoorName, true);
	SetSwingDoorClosed(asDoorName, false, false);

	string sFuncNameAdd = abNegForce ? "Neg" : "";
	AddTimer(asDoorName, 0.1f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.3f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.5f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.7f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 0.9f, "TimerOpenPigDoor"+sFuncNameAdd);
	AddTimer(asDoorName, 1.0f, "TimerOpenPigDoorEnd");
}

void TimerOpenPigDoor(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_Body_1", 0,0,3, "local");
}

void TimerOpenPigDoorNeg(const string &in asDoorName)
{
	AddBodyImpulse(asDoorName+"_Body_1", -3,0,0, "local");
}

void TimerOpenPigDoorEnd(const string &in asDoorName)
{
	SetSwingDoorDisableAutoClose(asDoorName, false);
}

void TimerPig2OutTheDoor(const string &in asTimer)
{
	SetSwingDoorLocked("cellar_wood01_3", true, true);
	PlaySoundAtEntity("grunt", "wretch_tunnels_amb_alert.snt", "cellar_wood01_3", 0, false);
	PlaySoundAtEntity("slam", "afx_mansion_child_attic_hatch_close", "cellar_wood01_3", 0, false);
}


//--------------------------------------------
//END PIG ENCOUNTER
//--------------------------------------------

void InteractExitDoor(string &in asEntity)
{
	StopMusic(1, 1);
	PlayMusic("music_transition_03cellar_04alley.ogg", true, 1.0f, 0.2f, 0, false);
	FadeOut(1);
	AddTimer("", 1.0, "TimerSwitchLevel");
}

void TimerSwitchLevel(string &in asTimer)
{
	ChangeMap("04_alley.map", "MainStart", "afx_events_leveltransition_cellar_enter.snt", "afx_events_leveltransition_cellar_exit.snt");
}
